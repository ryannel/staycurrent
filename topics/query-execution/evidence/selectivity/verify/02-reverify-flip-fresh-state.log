# Spot-verify, part 2: verify/01 ran against the END state of the lab database
# (2.5M rows incl. 500k 'returned', covering index, post-VACUUM), so the rare-value
# plan appeared as Bitmap Heap Scan. This log recreates the exact driver-01/02 state
# in a separate database (verifydb) in the same container and re-runs the flip pair.
# Command: docker exec -i pilot-sel psql -U postgres -X -e -d verifydb -f -
# Run at (host, UTC): 2026-07-29 02:08:17 UTC

CREATE DATABASE
CREATE TABLE orders (
  id          bigserial PRIMARY KEY,
  status      text        NOT NULL,
  customer_id int         NOT NULL,
  total       numeric     NOT NULL,
  created_at  timestamptz NOT NULL
);
CREATE TABLE
INSERT INTO orders (status, customer_id, total, created_at)
SELECT CASE
         WHEN r < 0.95 THEN 'shipped'
         WHEN r < 0.99 THEN 'pending'
         ELSE 'cancelled'
       END,
       1 + (random() * 99999)::int,
       round((random() * 499 + 1)::numeric, 2),
       now() - random() * interval '365 days'
FROM (SELECT random() AS r FROM generate_series(1, 2000000)) g;
INSERT 0 2000000
CREATE INDEX orders_status_idx ON orders (status);
CREATE INDEX
