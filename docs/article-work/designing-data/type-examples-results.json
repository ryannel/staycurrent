[
  {
    "name": "integer order",
    "sql": "SELECT array_agg(v ORDER BY v) AS value FROM (VALUES (2),(10),(100)) t(v)",
    "actual": [
      2,
      10,
      100
    ]
  },
  {
    "name": "C text order",
    "sql": "SELECT array_agg(v ORDER BY v COLLATE \"C\") AS value FROM (VALUES ('2'),('10'),('100')) t(v)",
    "actual": [
      "10",
      "100",
      "2"
    ]
  },
  {
    "name": "decimal rounding",
    "sql": "SELECT 18.005::numeric(12,2)::text AS value",
    "actual": "18.01"
  },
  {
    "name": "leading zeroes",
    "sql": "SELECT '00123'::integer AS value",
    "actual": 123
  },
  {
    "name": "same instant",
    "sql": "SELECT '2026-10-04 09:00+00'::timestamptz = '2026-10-04 11:00+02'::timestamptz AS value",
    "actual": true
  },
  {
    "name": "negative whole value",
    "sql": "SELECT (-2)::integer AS value",
    "actual": -2
  }
