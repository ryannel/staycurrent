ALTER ROLE app_old NOLOGIN;
-- Inventory candidates; review session identity, database and workload.
SELECT pid, usename, datname, application_name, client_addr,
       backend_start, state, xact_start
FROM pg_stat_activity WHERE usename = 'app_old';

-- The drill supplies the selected old session's PID, never a blanket kill.
SELECT pg_terminate_backend(:selected_pid, 2000);
-- Re-query pg_stat_activity, then test new and old connections separately.`;
