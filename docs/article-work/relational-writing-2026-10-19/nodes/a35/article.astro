CREATE ROLE shop_owner NOLOGIN;
CREATE ROLE order_work NOLOGIN;
-- app_old and migrator are separately provisioned LOGIN roles.
GRANT order_work TO app_old WITH INHERIT TRUE, SET FALSE;
GRANT shop_owner TO migrator WITH INHERIT FALSE, SET TRUE;

-- Provisioner creates the schema; deployment deliberately becomes owner.
CREATE SCHEMA orders AUTHORIZATION shop_owner;
