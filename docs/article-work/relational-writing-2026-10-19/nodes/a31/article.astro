const sections=[
 ['choose-the-simplest-move-that-fits-the-write-pause','Choose the simplest move that fits the write pause'],
 ['prove-that-the-destination-preserves-the-workload-s-meaning','Prove that the destination preserves the workload’s meaning'],
 ['join-the-starting-copy-to-every-later-change','Join the starting copy to every later change'],
 ['rehearse-the-destination-and-reconcile-the-copied-state','Rehearse the destination and reconcile the copied state'],
 ['fence-writers-and-prove-the-final-boundary-has-arrived','Fence writers and prove the final boundary has arrived'],
 ['admit-destination-traffic-with-a-defined-way-to-stop','Admit destination traffic with a defined way to stop'],
 ['close-the-move-with-evidence','Close the move with evidence'],
