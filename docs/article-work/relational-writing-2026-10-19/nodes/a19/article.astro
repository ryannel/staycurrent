RETURNING remaining;`;
const setup=`CREATE TABLE places (
  place_id integer PRIMARY KEY,
  capacity integer NOT NULL,
  remaining integer NOT NULL CHECK (remaining BETWEEN 0 AND capacity)
);
CREATE TABLE reservations (
  request_id text PRIMARY KEY,
  place_id integer NOT NULL REFERENCES places,
  owner_id integer NOT NULL,
  UNIQUE (place_id, owner_id)
);
CREATE TABLE staff (person text PRIMARY KEY, available boolean NOT NULL);
INSERT INTO places VALUES (21, 1, 1);
INSERT INTO staff VALUES ('Mina', true), ('Tariq', true);`;
const session=`-- Run separately in A and B, in a disposable exercise database.
SET statement_timeout = '12s';
SET lock_timeout = '5s';
SET idle_in_transaction_session_timeout = '45s';
BEGIN ISOLATION LEVEL SERIALIZABLE READ WRITE;
SHOW transaction_isolation;
SELECT count(*) FROM staff WHERE available;
-- Wait for BOTH sessions to return 2 before either updates.`;
const check=`SELECT person, available FROM staff ORDER BY person;
SELECT count(*) AS available FROM staff WHERE available;

SELECT p.place_id, p.remaining, count(r.request_id) AS reserved,
       p.remaining + count(r.request_id) = p.capacity AS agrees
FROM places AS p LEFT JOIN reservations AS r USING (place_id)
GROUP BY p.place_id ORDER BY p.place_id;`;
