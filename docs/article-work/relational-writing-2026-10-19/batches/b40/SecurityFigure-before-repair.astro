---
interface Props { scene:'admission'|'authority'|'tls'|'rotation'|'incident'; number:number }
const {scene,number}=Astro.props;
const definitions={
 admission:{title:'Follow the connection, then the statement',label:'Connection attempt',options:['Reporting client, allowed route','Reporting client, wrong password','Reporting client, forbidden route'],steps:['Start','Reach listener','Authenticate','Check SQL'],caption:'Illustrative gates. A reporting client has the projection grant, never the raw-address grant.'},
 authority:{title:'The same grant, with a different owner',label:'New object',options:['Table with owner defaults','Table without owner defaults','Routine with default PUBLIC execute'],steps:['Before deployment','Create as owner','Application uses object','Application attempts DDL'],caption:'Illustrative PostgreSQL 18 model. Both logins can connect; only the deployment login may SET ROLE shop_owner.'},
 tls:{title:'Which server does the client accept?',label:'Certificate presented',options:['Expected name and trusted issuer','Wrong name, trusted issuer','Expected name, untrusted issuer'],steps:['Start','Negotiate encryption','Verify peer','Send SQL'],caption:'Illustrative TLS comparison. The strict path checks the chain and expected hostname; the permissive path here deliberately disables peer verification.'},
 rotation:{title:'Retiring a login is two changes',label:'Retirement action',options:['Change password','Set NOLOGIN','Set NOLOGIN and end selected sessions'],steps:['Old pool connected','Replacement verified','Retire old access','Attempt old work'],caption:'Illustrative password-authenticated sessions, with committed role changes and a subsequent statement. Killing a backend can interrupt in-flight work.'},
 incident:{title:'Contain access without claiming to undo it',label:'What evidence survives?',options:['Connections and DDL only','Connections, DDL and verified read audit'],steps:['Suspected theft','Preserve and restrict','Revoke and close','Inspect and validate','Return decision'],caption:'Illustrative response inside the parent’s incident method. A record of a read can support scope; it cannot recall a disclosed address.'},
};
const d=definitions[scene];
---
<figure class="security-figure" data-security-figure data-scene={scene}>
 <figcaption><strong>Figure {number}. {d.title}</strong><span>{d.caption}</span></figcaption>
 <label>{d.label}<select data-choice>{d.options.map((x,i)=><option value={i}>{x}</option>)}</select></label>
 <div class="security-controls"><button type="button" data-action="back" aria-label={`Previous step in figure ${number}`}>Previous</button><button type="button" data-action="play">Play</button><button type="button" data-action="next" aria-label={`Next step in figure ${number}`}>Next</button><button type="button" data-action="reset">Reset</button><span data-counter></span></div>
 <ol class="security-progress">{d.steps.map((s,i)=><li data-step={i}>{s}</li>)}</ol>
 <div data-state class="security-state"></div>
 <p data-explanation class="security-explanation" aria-live="polite"></p>
</figure>
<script>
 const make=(tag:string,text:string,cls='')=>{const e=document.createElement(tag);e.textContent=text;e.className=cls;return e;};
 document.querySelectorAll<HTMLElement>('[data-security-figure]').forEach(root=>{
  if(root.dataset.ready)return;root.dataset.ready='true';
  const scene=root.dataset.scene!;const select=root.querySelector<HTMLSelectElement>('select')!;const panel=root.querySelector<HTMLElement>('[data-state]')!;
  const explanation=root.querySelector<HTMLElement>('[data-explanation]')!;const counter=root.querySelector<HTMLElement>('[data-counter]')!;
  const play=root.querySelector<HTMLButtonElement>('[data-action="play"]')!;const steps=[...root.querySelectorAll<HTMLElement>('[data-step]')];let step=0;let timer:ReturnType<typeof setTimeout>|undefined;let playing=false;
  function stop(){playing=false;clearTimeout(timer);play.textContent='Play';play.setAttribute('aria-pressed','false');}
  function column(title:string,rows:[string,string][],result:string){const col=make('div','','security-column');col.append(make('p',title,'security-title'));const dl=make('dl','','security-path');rows.forEach(([name,value])=>{const group=make('div','','security-node');group.append(make('dt',name),make('dd',value));dl.append(group);});col.append(dl,make('p',result,'security-result'));panel.append(col);}
  function render(){const choice=Number(select.value);panel.replaceChildren();counter.textContent=`${step+1} / ${steps.length}`;steps.forEach((el,i)=>{el.dataset.current=String(i===step);el.setAttribute('aria-current',i===step?'step':'false');});
   // aria-disabled leaves controls focusable at either endpoint.
   root.querySelector('[data-action="back"]')!.setAttribute('aria-disabled',String(step===0));root.querySelector('[data-action="next"]')!.setAttribute('aria-disabled',String(step===steps.length-1));
   if(scene==='admission'){
    const reached=step>=1&&choice!==2,authenticated=step>=2&&reached&&choice!==1;
    column('One reporting connection',[['Network route',step<1?'Not attempted':reached?'Listener reached':'Blocked before listener'],['Identity',step<2?'Not checked':!reached?'Not reached':authenticated?'reporter authenticated':'Password rejected'],['Projection query',step<3?'Not attempted':authenticated?'id and status returned':'No SQL session']],step<3?'Next gate still matters':authenticated?'Allowed projection succeeds':'Connection rejected');
    column('Same client, raw address query',[['Network route',step<1?'Not attempted':reached?'Listener reached':'Blocked before listener'],['Identity',step<2?'Not checked':!reached?'Not reached':authenticated?'reporter authenticated':'Password rejected'],['Raw-address query',step<3?'Not attempted':authenticated?'Permission denied':'No SQL session']],step<3?'Reachability is not a data grant':authenticated?'Forbidden read fails after login':'Connection rejected');
    explanation.textContent=['The client needs a route, a login and object authority.','A blocked route prevents authentication from being attempted.','Authentication establishes reporter; it grants no additional table authority.','A successful login permits the approved view, while the separate raw-table request remains denied.'][step];
   }else if(scene==='authority'){
    const routine=choice===2,exists=step>=1,allowed=exists&&(choice===0||routine);
    column('Application is a table user',[['Creation identity',exists?'shop_owner':'No object yet'],['Authority path',routine?'PUBLIC → EXECUTE':choice===0?'order_work → table grants':'No table grant'],['Application operation',step<2?'Not attempted':allowed?'Succeeds':'Permission denied']],step<3?'Owner remains separate':'ALTER / DROP denied: app is not owner');
    column('Application is also the owner',[['Creation identity',exists?'application login':'No object yet'],['Authority path','Ownership includes control of object'],['Application operation',step<2?'Not attempted':exists?'Succeeds':'No object']],step<3?'A revoked data grant is insufficient':'ALTER / DROP succeeds through ownership');
    explanation.textContent=['Connecting as an application login need not give it deployment powers.','The role that actually creates the object determines ownership and which default privileges apply.','A missing table grant breaks useful work; an unexpected PUBLIC routine grant can open a new path.','The least-privilege design needs the application to lack ownership as well as administrative memberships.'][step];
   }else if(scene==='tls'){
    const valid=choice===0;
    column('Verify chain and expected name',[['Transport',step<1?'Not established':'TLS negotiated'],['Peer identity',step<2?'Not accepted':valid?'Expected server verified':choice===1?'Wrong name: reject':'Untrusted issuer: reject'],['SQL',step<3?'Not sent':valid?'Sent to verified server':'Not sent']],step<2?'Encryption alone has not accepted identity':valid?'Connection accepted':'Connection rejected');
    column('Peer verification disabled',[['Transport',step<1?'Not established':'TLS negotiated'],['Peer identity',step<2?'Not checked':'No chain or name guarantee'],['SQL',step<3?'Not sent':'Sent to presented server']],step<3?'Traffic can be encrypted to the wrong peer':'Encrypted does not establish the intended server');
    explanation.textContent=['Choose a certificate case, then follow the client decision.','The encrypted channel comes before the application accepts its peer.','The strict client rejects either an untrusted issuer or a name mismatch.','Only the verified peer should receive credentials and SQL. The permissive comparison is an unsafe configuration, not a second recommended mode.'][step];
   }else if(scene==='rotation'){
    const terminated=choice===2&&step>=2;
    column('New connection with old material',[['Old login',step<2?'Enabled':choice===0?'Password replaced':'NOLOGIN'],['Authentication',step<3?'Not attempted':'Rejected'],['Result',step<3?'Pending test':'Cannot open a new session']],step<2?'Old login still available':'Future access stopped');
    column('Already authenticated pool connection',[['Session',terminated?'Backend ended':'Still connected'],['Credential recheck','No new login handshake'],['Next permitted query',step<3?'Not attempted':terminated?'Cannot use ended session':'Succeeds']],step<2?'Old pool still has authority':terminated?'Existing access stopped':'Existing access remains');
    explanation.textContent=['The pool authenticated before rotation began.','Verify the replacement login through fresh client connections before planned retirement.','Password replacement and NOLOGIN act at new login; explicit termination addresses selected existing backends.','Inspect actual sessions and their work. Neither credential replacement nor a successful new login proves the old pool is gone.'][step];
   }else{
    column('Access boundary',[['Old identity',step<2?'Suspected compromised':'Disabled; affected sessions ended'],['Replacement',step<3?'Excluded pending checks':'Fresh connection and boundary tests pass'],['Service admission',step<4?'Held for validation':'Conditional on data acceptance']],step<2?'Continuing exposure must be contained':'Old access no longer usable in the tested path');
    column('Knowledge of prior damage',[['Available records',choice===0?'Connections and DDL':'Also verified sensitive-read records'],['Addresses already copied',step<1?'Unknown':'Cannot be recalled'],['Data integrity',step<3?'Unestablished':'Requires facts and repair-owner checks']],step<4?'Preserve evidence outside affected authority':choice===0?'Read scope remains unknown':'Recorded reads inform scope; omissions still matter');
    explanation.textContent=['The suspect credential has the application’s actual grants, not every administrator power.','Preserve available evidence while restricting continuing exposure; record the intervention.','Disable compromised authentication paths and deliberately end affected sessions.','Inspect authority changes and facts; send possible data repair to the restoration owner.','Passing access tests proves a boundary now. It does not prove that no data was read or changed earlier.'][step];
   }
  }
  function schedule(){if(!playing)return;const words=(root.innerText.match(/\S+/g)||[]).length;const delay=Math.max(6000,Math.ceil(words/180*60000));root.dataset.holdMs=String(delay);timer=setTimeout(()=>{if(step<steps.length-1){step++;render();schedule();}else stop();},delay);}
  root.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(button=>button.addEventListener('click',()=>{const action=button.dataset.action;if(action==='play'){if(playing){stop();return;}if(step===steps.length-1)step=0;playing=true;play.textContent='Pause';play.setAttribute('aria-pressed','true');render();schedule();return;}stop();if(action==='next')step=Math.min(steps.length-1,step+1);if(action==='back')step=Math.max(0,step-1);if(action==='reset')step=0;render();}));
  select.addEventListener('change',()=>{stop();render();});document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});render();
 });
</script>
<style>
 .security-figure{margin:2rem 0;padding:1.1rem;border:1px solid var(--color-rule);border-radius:.6rem;background:var(--color-surface-alt);}
 figcaption strong{display:block;color:var(--color-text);}figcaption span{display:block;font-size:.85rem;margin-top:.4rem;color:var(--color-text-secondary);}
 label{display:grid;gap:.35rem;margin:1rem 0;font-size:.85rem;}select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.5rem;}select{width:100%;}button{cursor:pointer;}button[aria-disabled="true"]{opacity:.5;}button:focus-visible,select:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px;}
 .security-controls{display:flex;align-items:center;flex-wrap:wrap;gap:.45rem;font-size:.8rem;}.security-controls span{margin-left:auto;font-variant-numeric:tabular-nums;}
 .security-progress{display:flex;flex-wrap:wrap;gap:.4rem;list-style:none;padding:0;font-size:.72rem;}.security-progress li{padding:.3rem .45rem;border-bottom:2px solid var(--color-rule);}.security-progress li[data-current="true"]{border-color:var(--color-accent);font-weight:700;}
 .security-state{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;}.security-explanation{font-size:.9rem;min-height:4.5em;margin-bottom:0;}
 .security-state :global(.security-column){min-width:0;border:1px solid var(--color-rule);border-radius:.4rem;padding:.8rem;background:var(--color-surface);}
 .security-state :global(.security-title){font-weight:700;font-size:.9rem;margin:0 0 .7rem;}
 .security-state :global(dl){margin:0;display:grid;gap:.8rem;}.security-state :global(.security-node){border-left:3px solid var(--color-accent);padding-left:.6rem;}
 .security-state :global(dt){font-size:.72rem;color:var(--color-text-secondary);}.security-state :global(dd){font-size:.82rem;margin:.2rem 0 0;overflow-wrap:anywhere;}
 .security-state :global(.security-result){border-top:1px solid var(--color-rule);padding-top:.6rem;margin:.8rem 0 0;font-size:.83rem;font-weight:650;}
 @media(max-width:600px){.security-figure{padding:.8rem;}.security-state{grid-template-columns:1fr;}.security-state :global(dl){grid-template-columns:repeat(3,minmax(0,1fr));gap:.4rem;}.security-state :global(.security-node){padding-left:.35rem;}.security-progress{gap:.2rem;}.security-progress li{padding:.25rem;}.security-explanation{min-height:6em;}}
</style>
