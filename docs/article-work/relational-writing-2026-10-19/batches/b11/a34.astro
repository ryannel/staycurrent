const topology = `-- Proposed configuration on nodes already labelled with these regions.
CREATE DATABASE shop PRIMARY REGION "eu-west-1";
ALTER DATABASE shop ADD REGION "eu-central-1";
ALTER DATABASE shop ADD REGION "eu-west-3";
ALTER DATABASE shop SURVIVE REGION FAILURE;
SHOW REGIONS FROM DATABASE shop;`;
const schema = `-- Connected to shop. Candidate schema; not an executed result.
CREATE TABLE inventory (
  home crdb_internal_region NOT NULL,
  sku STRING NOT NULL,
  available INT NOT NULL CHECK (available >= 0),
  PRIMARY KEY (home, sku)
) LOCALITY REGIONAL BY ROW AS home;

CREATE TABLE reservations (
  home crdb_internal_region NOT NULL,
  request_id UUID NOT NULL,
  stock_home crdb_internal_region NOT NULL,
  sku STRING NOT NULL,
  amount DECIMAL(12,2) NOT NULL CHECK (amount > 0),
  PRIMARY KEY (home, request_id),
  FOREIGN KEY (stock_home, sku) REFERENCES inventory (home, sku)
) LOCALITY REGIONAL BY ROW AS home;`;
const inspect = `SELECT version();                 -- engine identity, not server_version
SHOW default_transaction_isolation;
SHOW LOCALITY;                    -- SQL gateway's locality only
SHOW CREATE TABLE reservations;
SHOW RANGES FROM TABLE reservations WITH DETAILS;
SHOW RANGES FROM TABLE inventory WITH DETAILS;`;
const claim = `-- Parameters: stock home, SKU, fixed request home, request UUID, amount.
BEGIN ISOLATION LEVEL SERIALIZABLE;
WITH claimed AS (
  UPDATE inventory SET available = available - 1
  WHERE home = $1 AND sku = $2 AND available > 0
  RETURNING home, sku
)
INSERT INTO reservations (home, request_id, stock_home, sku, amount)
SELECT $3, $4, home, sku, $5 FROM claimed
RETURNING home, request_id;
COMMIT;`;
