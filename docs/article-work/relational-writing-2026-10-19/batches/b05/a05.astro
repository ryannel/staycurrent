const lookup = `SELECT order_id, placed_at, total
FROM orders
WHERE customer_id = 42
  AND placed_at >= date '2026-01-01'
ORDER BY placed_at DESC, order_id DESC
LIMIT 10;`;
const report = `SELECT c.customer_id, sum(o.total) AS spent
FROM customers AS c
JOIN orders AS o USING (customer_id)
WHERE c.region = 'north'
  AND o.placed_at >= date '2026-01-01'
GROUP BY c.customer_id
ORDER BY spent DESC, c.customer_id
LIMIT 10;`;
const plan = `Limit                         estimated rows=10  actual rows=10 loops=1
  Sort: sum(total) DESC, customer_id; top-N heapsort
    GroupAggregate            estimated rows=18  actual rows=8000 loops=1
      Sort: customer_id; external merge, Disk: 1496kB
        Nested Loop           estimated rows=101 actual rows=80000 loops=1
          Seq Scan customers  estimated rows=18  actual rows=8000 loops=1
            Filter: region = 'north'; rows removed: 2000
          Bitmap Heap Scan orders
                              estimated rows=10  actual rows=10 loops=8000
            Filter: placed_at >= '2026-01-01'
            Bitmap Index Scan orders_customer
                              actual rows=10 loops=8000`;
---
<p>A database can return ten rows quickly while small and slowly after a year of growth. The answer is still ten rows. The work needed to find them, combine them and decide which ten to return has changed.</p>
<p>Improving performance means explaining that work, predicting what a change will remove, and checking the effect on the people using the application. This article follows a shop’s customer history, regional spending report and concurrent order changes through that loop. Finish it through <a href="#change-one-explanation-into-a-measured-improvement">the concluding comparison method</a> before following the optional investigations. They deepen a question your evidence raises; they are not a required sequence.</p>
