const defaults=`-- Run each of these as a separate rolled-back exercise.
INSERT INTO change_orders (tenant_id, order_id, status)
VALUES (1,107,DEFAULT) RETURNING status; -- open
INSERT INTO change_orders (tenant_id, order_id, status)
VALUES (1,107,NULL); -- rejected: NOT NULL, not replaced by open`;
const conditional=`BEGIN;
INSERT INTO stock (tenant_id, sku, available) VALUES (1,'P7',5)
ON CONFLICT (tenant_id, sku) DO UPDATE
 SET available = EXCLUDED.available
 WHERE stock.available IS DISTINCT FROM EXCLUDED.available
RETURNING tenant_id, sku, available;
-- No row: existing and incoming quantities are both 5.
ROLLBACK;`;
const gap=`BEGIN;
INSERT INTO receipts (tenant_id, order_id, external_ref, amount)
VALUES (1,101,'rolled-back',1) RETURNING receipt_id;
-- 2, immediately after a fresh setup.
ROLLBACK;
INSERT INTO receipts (tenant_id, order_id, external_ref, amount)
VALUES (1,101,'kept',1) RETURNING receipt_id;
-- 3. Identity 2 is not reclaimed.`;
const inspect=`SELECT tenant_id, sku, available FROM stock ORDER BY tenant_id, sku;
-- Before: (1,P7,5), (1,P8,2), (2,P7,9).
-- Inside the delivery exercise:
-- (1,P7,10), (1,P8,2), (1,P9,4), (2,P7,9).
-- After ROLLBACK: the original three rows again.`;
