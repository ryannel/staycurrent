const reservation=`WITH claimed AS (
  UPDATE inventory
  SET available = available - 1
  WHERE sku = 'P7' AND available > 0
  RETURNING sku
)
INSERT INTO reservations (request_id, sku, amount)
SELECT 'request-42', sku, 20.00 FROM claimed
RETURNING request_id;`;
