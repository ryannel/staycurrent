---
import { scenes } from './scenes';
interface Props { scene:string; number:number }
const {scene,number}=Astro.props;
const data=scenes[scene];
const first=data.variants[0].frames[0];
---
<figure class="work-boundary" data-work-boundary>
 <figcaption><strong>Figure {number}. {data.title}</strong><span>{data.caption}</span></figcaption>
 <label class="scenario">Compare <select aria-label={`Figure ${number} scenario`}>{data.variants.map((v,i)=><option value={i}>{v.label}</option>)}</select></label>
 <div class="cards">{data.labels.map((label,i)=><div class="card"><span class="card-label">{label}</span><strong data-card={i}>{first.cards[i]}</strong></div>)}</div>
 <ol class="steps" aria-label="Steps in the selected scenario">{data.variants[0].frames.slice(1).map((frame,i)=><li data-row={i+1}><span>{i+1}</span><span data-step-label>{frame.label}</span></li>)}</ol>
 <div class="explanation" aria-live="polite" aria-atomic="true"><p class="narration">{first.narration}</p><p class="result">{first.result}</p></div>
 <div class="controls"><button type="button" data-action="play">Play</button><button type="button" data-action="back" disabled>Back</button><button type="button" data-action="next">Next</button><button type="button" data-action="end">End</button><button type="button" data-action="reset">Reset</button><output>Start · 0 / 5</output></div>
 <p class="model-label">Illustrative model · each step holds for 6.5 seconds · comparisons keep your step</p>
 <script is:inline type="application/json" data-scenes set:html={JSON.stringify(data).replace(/</g,'\\u003c')} />
</figure>
<script>
 import type { Scene } from './scenes';
 function initialise(){
  document.querySelectorAll<HTMLElement>('[data-work-boundary]').forEach(root=>{
   if(root.dataset.ready)return;root.dataset.ready='true';
   const data=JSON.parse(root.querySelector('[data-scenes]')!.textContent!) as Scene;
   const select=root.querySelector('select')!;
   const buttons=Object.fromEntries(Array.from(root.querySelectorAll<HTMLButtonElement>('[data-action]')).map(b=>[b.dataset.action!,b]));
   const rows=Array.from(root.querySelectorAll<HTMLElement>('[data-row]'));
   let variant=0,index=0,timer:ReturnType<typeof setTimeout>|undefined;
   const frames=()=>data.variants[variant].frames;
   function pause(){clearTimeout(timer);timer=undefined;buttons.play.textContent='Play';buttons.play.setAttribute('aria-pressed','false')}
   function render(){
    const frame=frames()[index];
    root.querySelectorAll<HTMLElement>('[data-card]').forEach((el,i)=>{el.textContent=frame.cards[i]});
    rows.forEach((row,i)=>{row.dataset.status=i+1===index?'current':i+1<index?'done':'waiting';row.querySelector('[data-step-label]')!.textContent=frames()[i+1].label;if(i+1===index)row.setAttribute('aria-current','step');else row.removeAttribute('aria-current')});
    root.querySelector('.narration')!.textContent=frame.narration;
    root.querySelector('.result')!.textContent=frame.result;
    root.querySelector('output')!.textContent=`${index===0?'Start':frame.label} · ${index} / ${frames().length-1}`;
    buttons.back.disabled=index===0;buttons.next.disabled=index===frames().length-1;
    if(index===frames().length-1)pause();
   }
   function visible(){const r=root.getBoundingClientRect();return r.top>=0&&r.bottom<=innerHeight&&r.left>=0&&r.right<=innerWidth}
   function advance(){timer=setTimeout(()=>{if(document.hidden||!visible()){pause();return}index=Math.min(index+1,frames().length-1);render();if(index<frames().length-1)advance()},6500)}
   buttons.play.setAttribute('aria-pressed','false');
   buttons.play.addEventListener('click',()=>{
    if(timer){pause();return}
    if(index===frames().length-1)index=0;
    render();root.scrollIntoView({block:'center',behavior:'instant'});
    buttons.play.textContent='Pause';buttons.play.setAttribute('aria-pressed','true');advance();
   });
   buttons.back.addEventListener('click',()=>{pause();index=Math.max(0,index-1);render()});
   buttons.next.addEventListener('click',()=>{pause();index=Math.min(frames().length-1,index+1);render()});
   buttons.end.addEventListener('click',()=>{pause();index=frames().length-1;render()});
   buttons.reset.addEventListener('click',()=>{pause();index=0;render()});
   select.addEventListener('change',()=>{pause();variant=Number(select.value);render()});
   document.addEventListener('visibilitychange',()=>{if(document.hidden)pause()});
   new IntersectionObserver(entries=>{if(entries.some(e=>e.intersectionRatio<0.98))pause()},{threshold:[0,0.98,1]}).observe(root);
   render();
  });
 }
 initialise();document.addEventListener('astro:page-load',initialise);
</script>
<style>
 .work-boundary{margin:1.5rem 0;padding:1rem;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);font-size:.9rem;line-height:1.4;max-width:100%;overflow:hidden;}
 .work-boundary figcaption{margin:0 0 .8rem;font-size:.88rem;line-height:1.45;}
 .work-boundary figcaption strong,.work-boundary figcaption span{display:block;}
 .work-boundary figcaption span{margin-top:.35rem;color:var(--color-text-secondary);font-size:.8rem;}
 .scenario{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;font-weight:600;margin:0 0 .8rem;}
 .scenario select{font:inherit;max-width:100%;min-height:2.5rem;padding:.35rem;background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-rule);border-radius:.25rem;}
 .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin:0 0 .8rem;}
 .card{border:1px solid var(--color-rule);padding:.65rem;border-radius:.3rem;background:var(--color-surface);min-height:5rem;overflow-wrap:anywhere;}
 .card-label{display:block;font-size:.7rem;color:var(--color-text-secondary);margin:0 0 .25rem;}
 .card strong{font-size:.85rem;font-weight:600;display:block;}
 .work-boundary .steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.35rem;padding:0;margin:0 0 .8rem;list-style:none;}
 .work-boundary .steps li{margin:0;padding:.45rem;border:1px solid var(--color-rule);border-radius:.25rem;font-size:.75rem;line-height:1.35;display:flex;align-items:center;gap:.35rem;}
 .steps li>span:first-child{font-weight:700;}
 .steps li[data-status="current"]{border-color:var(--color-text);background:var(--color-surface);font-weight:700;}
 .steps li[data-status="done"]{border-style:dashed;}
 .work-boundary .explanation{margin:0 0 .8rem;padding:.7rem;background:var(--color-surface);border-left:3px solid var(--color-rule);min-height:6.7rem;}
 .work-boundary .narration,.work-boundary .result{margin:0;font-size:.85rem;line-height:1.45;}
 .work-boundary .result{margin-top:.4rem;font-weight:600;}
 .controls{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem;}
 .controls button{font:inherit;font-size:.8rem;min-height:2.5rem;padding:.35rem .65rem;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.25rem;cursor:pointer;}
 .controls button:disabled{opacity:.5;cursor:default;}
 .controls output{font-size:.75rem;flex-basis:100%;margin-top:.2rem;}
 .work-boundary .model-label{margin:.6rem 0 0;font-size:.7rem;color:var(--color-text-secondary);}
 .work-boundary :focus-visible{outline:2px solid var(--color-text);outline-offset:3px;}
 @media(max-width:600px){
  .work-boundary{padding:.65rem;}
  .cards{grid-template-columns:1fr;gap:.3rem;}
  .card{min-height:0;padding:.4rem .5rem;display:grid;grid-template-columns:6.1rem minmax(0,1fr);gap:.3rem;align-items:center;}
  .card-label{margin:0;line-height:1.3;}.card strong{font-size:.8rem;line-height:1.35;}
  .work-boundary .steps{grid-template-columns:1fr;gap:.2rem;}
  .work-boundary .steps li{padding:.22rem .4rem;min-height:1.5rem;}
  .work-boundary .explanation{min-height:7rem;padding:.5rem;}
  .scenario{font-size:.8rem;gap:.35rem;}.controls button{padding:.3rem .55rem;}
 }
</style>
