---
interface Props { number: number; title: string; caption: string; text: string }
const {number,title,caption,text}=Astro.props;
---
<figure class="coordinate-figure">
  <figcaption><strong>Figure {number}. {title}</strong><span>{caption}</span></figcaption>
  <slot />
  <details><summary>Read this figure as text</summary><p><slot name="text">{text}</slot></p></details>
</figure>
<style>
  .coordinate-figure {margin:1.7rem 0 2rem;padding:1rem;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);min-width:0;}
  figcaption{font-size:.9rem;line-height:1.55;margin-bottom:1rem;color:var(--color-text);}
  figcaption strong,figcaption span{display:block;} figcaption span{margin-top:.35rem;}
  details{margin-top:.8rem;font-size:.85rem;}summary{cursor:pointer;}details p{margin:.6rem 0 0;}
  .coordinate-figure :global(svg){display:block;max-width:100%;height:auto;color:var(--color-text);}
  .coordinate-figure :global(.ink){stroke:var(--color-text);fill:none;stroke-width:1.5;}
  .coordinate-figure :global(.paper){fill:var(--color-surface);stroke:var(--color-text);stroke-width:1.4;}
  .coordinate-figure :global(.mark){fill:var(--color-text);stroke:var(--color-surface);stroke-width:1;}
  .coordinate-figure :global(text){fill:var(--color-text);font-family:var(--font-mono);font-size:13px;}
  .coordinate-figure :global(.panels){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;}
  .coordinate-figure :global(.panel){min-width:0;border:1px solid var(--color-rule);border-radius:.3rem;padding:.7rem;background:var(--color-surface);}
  .coordinate-figure :global(.panel .panel-label){display:block;font-size:.9rem;font-weight:700;line-height:1.4;margin:0 0 .5rem;}
  .coordinate-figure :global(.panel p){font-size:.83rem;margin:.5rem 0 0;}
  .coordinate-figure :global(.controls){display:flex;align-items:end;flex-wrap:wrap;gap:.7rem;margin:.8rem 0;}
  .coordinate-figure :global(label){font-size:.85rem;display:grid;gap:.3rem;max-width:100%;}
  .coordinate-figure :global(button),.coordinate-figure :global(select),.coordinate-figure :global(input[type=number]){font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.25rem;padding:.35rem .55rem;max-width:100%;}
  .coordinate-figure :global(button){cursor:pointer;} .coordinate-figure :global(output){display:block;font-size:.85rem;line-height:1.6;margin-top:.7rem;overflow-wrap:anywhere;}
  @media(max-width:600px){.coordinate-figure{padding:.75rem;}.coordinate-figure :global(.panels){grid-template-columns:1fr;}}
</style>
