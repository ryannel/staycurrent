---
import Figure from './Figure.astro';
---
<Figure number={8} title="Ask the browser for the current mapping" caption="A live SVG implementation. Zoom changes the scale about W’s origin; pan is measured in V. The centre-turn button resets, then turns the view about V (400, 300). The pointer readout uses this rendered card’s current getScreenCTM, so its client coordinates depend on this page’s layout." text="Use the zoom, angle and pan controls to change the view. Move or tap within the diagram to read actual client coordinates and recovered local card coordinates. Half width changes the browser bridge while preserving the viewBox; the same local card test continues to work. Zoom at the mark keeps the marked spot fixed in the view.">
 <div data-coordinate-editor>
  <div class="controls">
   <label>Zoom<input data-editor-zoom type="number" min="0.25" max="4" step="0.25" value="2" /></label>
   <label>View angle (degrees)<input data-editor-angle type="number" min="-180" max="180" step="15" value="0" /></label>
   <label>Pan x in V<input data-editor-panX type="number" step="10" value="60" /></label>
   <label>Pan y in V<input data-editor-panY type="number" step="10" value="40" /></label>
  </div>
  <div class="controls"><button data-editor-turn type="button">Turn view about centre</button><button data-editor-anchor type="button">Zoom at the mark ×1.5</button><label class="size-control"><input data-editor-size type="checkbox" /> Half width on this page</label><button data-editor-reset type="button">Reset</button></div>
  <output data-editor-status aria-live="polite">View: zoom 2, angle 0°, pan (60, 40).</output>
  <div class="editor-surface"><svg data-editor-svg viewBox="0 0 800 600" role="img" aria-label="Review card in the turned Review lane, with live coordinate conversion"><path class="ink" d="M0 100V0H100"/><text x="110" y="20">xV →</text><text x="10" y="120">yV ↓</text><g data-editor-world transform="matrix(2 0 0 2 60 40)"><g data-editor-group transform="matrix(0 1 -1 0 160 100)"><rect x="0" y="0" width="140" height="90" class="ink" stroke-dasharray="4 3"/><g data-editor-card transform="matrix(1 0 0 1 30 20)"><rect width="80" height="40" class="paper"/><text x="17" y="27">Review</text><circle cx="10" cy="10" r="3" class="mark"/></g></g></g></svg></div>
  <output data-editor-readout aria-live="polite">Move or tap within the SVG to test the card.</output>
  <div class="controls"><button data-editor-check type="button">Check current mapping</button></div>
  <output data-editor-mapping aria-live="polite">Compare the composed route with the browser after a change.</output>
 </div>
</Figure>
<script>
 import {installEditor} from './browser.mjs';
 document.querySelectorAll('[data-coordinate-editor]').forEach(host=>installEditor(host));
</script>
<style>input[type=number]{width:7rem}.size-control{display:flex!important;align-items:center;gap:.4rem}.editor-surface{margin:.8rem 0;border:1px solid var(--color-rule);background:var(--color-surface);min-height:100px;}svg{width:100%;display:block;touch-action:pan-y;}svg text{font-size:13px;}</style>
