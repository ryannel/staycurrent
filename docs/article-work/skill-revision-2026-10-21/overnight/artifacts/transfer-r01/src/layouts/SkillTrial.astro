---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import '../styles/explorables.css';

interface Props { title: string; description: string; type?: string }
const { title, description, type = 'Guide' } = Astro.props;
---
<Base title={title} description={description}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <article class="visual-essay" data-pagefind-ignore>
    <header class="essay-header">
      <p class="eyebrow">Skill experiment · Draft for review</p>
      <h1>{title}</h1>
      <TitleLine type={type} />
    </header>
    <ArticleBody><slot /></ArticleBody>
  </article>
</Base>
