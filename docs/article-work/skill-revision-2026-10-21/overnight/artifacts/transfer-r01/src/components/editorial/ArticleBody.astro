---
// An article's body with its contents list placed after the opening, so a
// reader meets the subject before its section names. The list is built from
// the rendered headings, so it can't fall out of step with them. End matter
// (sources, onward reading) stays out of the list, as in the hand-written
// lists this replaced. Articles with fewer than three sections get no list.
// depth={3} nests each section's <h3>s under it, for long articles.
interface Props { minSections?: number; depth?: 2 | 3 }
const { minSections = 3, depth = 2 } = Astro.props;

const html = await Astro.slots.render('default');
const plain = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const slug = (s: string) => plain(s).toLowerCase().replace(/&[a-z]+;|&#\d+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const END_MATTER = /^(sources\b|model notes|further reading|continue exploring)/i;

type Entry = { id: string; text: string; children: Entry[] };
const sections: Entry[] = [];
const used = new Set<string>();
const heading = depth === 3 ? /<(h[23])(\s[^>]*)?>([\s\S]*?)<\/\1>/g : /<(h2)(\s[^>]*)?>([\s\S]*?)<\/\1>/g;

// Each heading links to its own id, or to the section that opens just before it.
const body = html.replace(heading, (match, tag, attrs = '', inner, offset) => {
  let id = attrs.match(/\sid="([^"]+)"/)?.[1];
  if (!id) {
    const before = html.slice(0, offset);
    const open = [...before.matchAll(/<section\b[^>]*\sid="([^"]+)"[^>]*>/g)].at(-1);
    if (open && !before.slice(open.index).includes('</section>') && !used.has(open[1])) id = open[1];
  }
  let added = '';
  if (!id) {
    id = slug(inner) || `section-${used.size + 1}`;
    while (used.has(id)) id += '-2';
    added = ` id="${id}"`;
  }
  used.add(id);
  const text = plain(inner);
  if (tag === 'h2') { if (!END_MATTER.test(text)) sections.push({ id, text, children: [] }); }
  else sections.at(-1)?.children.push({ id, text, children: [] });
  return `<${tag}${attrs}${added}>${inner}</${tag}>`;
});

// The opening ends where the first section starts: its <section>, or the h2 itself.
let split = body.search(/<h2[\s>]/);
if (split >= 0) {
  const before = body.slice(0, split);
  const open = [...before.matchAll(/<section\b[^>]*>/g)].at(-1);
  if (open && !before.slice(open.index).includes('</section>')) split = open.index!;
}
const showContents = split >= 0 && sections.length >= minSections;
const opening = showContents ? body.slice(0, split) : body;
const rest = showContents ? body.slice(split) : '';
---
<Fragment set:html={opening} />
{showContents && (
  <nav class="article-contents" data-pagefind-ignore aria-label="In this article">
    <ol>{sections.map((s) => (
      <li><a href={`#${s.id}`}>{s.text}</a>{s.children.length > 0 && <ul>{s.children.map((c) => <li><a href={`#${c.id}`}>{c.text}</a></li>)}</ul>}</li>
    ))}</ol>
  </nav>
)}
<Fragment set:html={rest} />
