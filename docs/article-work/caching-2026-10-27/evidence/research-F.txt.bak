## E2 keyspace_hits / keyspace_misses: which commands count (each line: RESETSTAT, run command, read counters)
setup: a=1 exists, h is a hash with field f, all other keys absent
GET a => keyspace_hits:1 keyspace_misses:0
GET absent0 => keyspace_hits:0 keyspace_misses:1
MGET a absent1 absent2 => keyspace_hits:1 keyspace_misses:2
EXISTS a absent3 => keyspace_hits:1 keyspace_misses:1
TTL a => keyspace_hits:1 keyspace_misses:0
TTL absent4 => keyspace_hits:0 keyspace_misses:1
TYPE absent5 => keyspace_hits:0 keyspace_misses:1
STRLEN absent6 => keyspace_hits:0 keyspace_misses:1
GETEX absent7 => keyspace_hits:0 keyspace_misses:1
GETDEL absent8 => keyspace_hits:0 keyspace_misses:1
SET a 9 GET => keyspace_hits:1 keyspace_misses:0
SET absent9 1 GET => keyspace_hits:0 keyspace_misses:1
HGET h f => keyspace_hits:1 keyspace_misses:0
HGET h g => keyspace_hits:1 keyspace_misses:0
HGET absent10 f => keyspace_hits:0 keyspace_misses:1
HGETALL absent11 => keyspace_hits:0 keyspace_misses:1
SISMEMBER absent12 x => keyspace_hits:0 keyspace_misses:1
LRANGE absent13 0 -1 => keyspace_hits:0 keyspace_misses:1
SET a 1 => keyspace_hits:0 keyspace_misses:0
SET a 1 NX => keyspace_hits:0 keyspace_misses:0
SET a 1 XX => keyspace_hits:0 keyspace_misses:0
SET absent14 1 NX => keyspace_hits:0 keyspace_misses:0
INCR a => keyspace_hits:0 keyspace_misses:0
INCR absent15 => keyspace_hits:0 keyspace_misses:0
APPEND a x => keyspace_hits:0 keyspace_misses:0
DEL a => keyspace_hits:0 keyspace_misses:0
EXPIRE absent16 10 => keyspace_hits:0 keyspace_misses:0
UNLINK absent17 => keyspace_hits:0 keyspace_misses:0
SCAN 0 => keyspace_hits:0 keyspace_misses:0
$ redis-cli -p 7206 SET a 1
OK
EVAL GET a; EVAL GET absent18 => keyspace_hits:1 keyspace_misses:1

