$ redis-cli -p 7206 CONFIG SET maxmemory 0
OK
$ redis-cli -p 7206 CONFIG SET maxmemory-policy noeviction
OK
$ redis-cli -p 7206 INFO memory | grep -E '^(used_memory|used_memory_rss|used_memory_dataset|used_memory_overhead|mem_fragmentation_ratio|used_memory_peak):'
