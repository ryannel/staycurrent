used_memory_peak:2325344
used_memory_overhead:939768
used_memory_dataset:217304
mem_fragmentation_ratio:2.92
$ redis-cli -p 7206 DBSIZE
100000
$ redis-cli -p 7206 INFO memory | grep -E '^(used_memory|used_memory_rss|used_memory_dataset|used_memory_overhead|mem_fragmentation_ratio|used_memory_peak):'
used_memory:28284336
used_memory_rss:33161216
