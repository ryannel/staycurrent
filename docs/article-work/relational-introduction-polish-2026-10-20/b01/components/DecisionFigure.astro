---
const { scene, number } = Astro.props;
const cases = {
  outcome: {
    title: 'The same missing reply, two possible outcomes',
    label: 'Connection breaks',
    options: [['before', 'Before COMMIT arrives'], ['after', 'After COMMIT, before its reply']],
    stages: ['Write', 'Send COMMIT', 'Lose connection', 'Inspect stored state'],
    caption: 'Two illustrative paths for one order attempt. No payment is sent. The application receives no commit confirmation in either path; the last step shows an independent inspection of the database.',
    alternative: 'Before the commit request arrives, connection loss leaves the open transaction to roll back. After commit but before its reply, the order remains. The application sees a broken connection in both cases, so that error alone cannot establish whether repeating the order is safe.',
  },
  lookup: {
    title: 'The same order, with two routes to find it',
    label: 'Find order 9 by',
    options: [['scan', 'Scanning the table'], ['index', 'Searching an index']],
    stages: ['Start', 'Find candidates', 'Read table pages', 'Return order 9'],
    caption: 'Twelve invented orders, four per page. Accent borders mark table pages examined; a ring marks the answer. The index search is shown as one operation, without drawing or counting its own pages. These are work counts, not timings or a captured plan.',
    alternative: 'The model scan examines all twelve rows on three pages. The index route searches the index, then visits only the page containing order 9. Both return the same order. The index has its own storage and search cost and must be maintained when its indexed facts change.',
  },
  change: {
    title: 'A new required value meets an old writer',
    label: 'Require the instruction',
    options: [['early', 'As soon as the column is added'], ['staged', 'After writers and old rows are ready']],
    stages: ['Before the change', 'Add the column', 'Old writer submits', 'Complete the transition'],
    caption: 'An illustrative rollout, with one old order and one old application writer. Existing orders have confirmed instructions available for conversion in this example. If a valid historical value cannot be established, the final rule needs to allow that history explicitly.',
    alternative: 'Requiring a value immediately blocks the change on existing missing values and leaves the old writer incompatible. Adding it as optional lets the old writer continue while a compatible release and honest conversion are prepared. Strengthen the rule only after all writers supply it and the affected rows meet it.',
  },
  recovery: {
    title: 'A current copy and an earlier copy answer different failures',
    label: 'What failed?',
    options: [['host', 'Writer and its storage are lost'], ['delete', 'Order 101 was deleted by mistake']],
    stages: ['Order exists', 'Failure', 'Look at the current replica', 'Choose the recovery input'],
    caption: 'Illustrative copies, with order 101 already applied on the replica before the failure. In the deletion case, the deletion also reaches it. The retained earlier copy is assumed usable and independently accessible. No failover or restore is executed.',
    alternative: 'After writer loss, the replica still has order 101 and may support recovery if it meets the deployment’s loss and promotion requirements. After a committed deletion reaches the replica, neither current copy has 101. Retained state from before the deletion is needed; restore separately and account for valid later work before repairing the live service.',
  },
};
const c = cases[scene];
---
<figure class="decision-figure" data-a00-decision={scene} aria-labelledby={`a00-${scene}-title`}>
  <figcaption><span class="eyebrow">Figure {number} · illustrative model</span><strong id={`a00-${scene}-title`}>{c.title}</strong></figcaption>
  <div class="controls"><label>{c.label} <select data-choice>{c.options.map(([value, label]) => <option value={value}>{label}</option>)}</select></label></div>
  <ol class="stages">{c.stages.map((title, i) => <li data-stage={i} aria-current={i === 0 ? 'step' : 'false'}>{title}</li>)}</ol>
  <div data-picture class="picture"></div>
  <p data-explanation aria-live="polite" class="explanation"></p>
  <div class="controls"><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 4</span></div>
  <p class="caption">{c.caption}</p>
  <details><summary>Read the comparison as text</summary><p>{c.alternative}</p></details>
  <noscript><p>{c.alternative}</p></noscript>
</figure>
<script>
document.querySelectorAll<HTMLElement>('[data-a00-decision]').forEach(root => {
  const scene = root.dataset.a00Decision;
  const get = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
  let step = 0;
  let timer: ReturnType<typeof setTimeout> | undefined;
  const stop = () => { clearTimeout(timer); timer = undefined; get('[data-play]').textContent = 'Play'; };
  const card = (title: string, value: string, note = '') => `<div class="state-card"><strong>${title}</strong><span>${value}</span>${note ? `<small>${note}</small>` : ''}</div>`;
  const draw = () => {
    const choice = get<HTMLSelectElement>('[data-choice]').value;
    let picture = '';
    let message = '';
    if (scene === 'outcome') {
      const committed = choice === 'after' && step >= 2;
      picture = card('Order 103 in database', step < 2 ? 'Not committed' : committed ? 'Committed' : 'Absent after rollback') +
        card('What the application knows', step < 2 ? 'Waiting to finish' : 'No commit confirmation', step >= 2 ? 'Connection lost' : 'Order attempt R103');
      message = [
        'The application has written order 103 inside an open transaction. It has not committed yet.',
        'The application sends COMMIT. Sending the request does not establish that the database received it.',
        choice === 'after' ? 'The database commits, but its reply is lost. Order 103 exists; the application has only a connection error.' : 'The connection fails before COMMIT reaches the database. The open transaction rolls back. The application has only a connection error.',
        choice === 'after' ? 'A separate inspection finds committed order 103. Repeating it with a fresh identity could create a second order.' : 'A separate inspection finds no order from this attempt. The connection error alone could not tell us that.',
      ][step];
    } else if (scene === 'lookup') {
      const indexed = choice === 'index';
      picture = `<div class="access">${indexed ? 'Search index for 9 → table page 3' : 'Read table pages 1 → 2 → 3'}</div><div class="pages">${[0,1,2].map(page => `<div class="page ${step >= 2 && (!indexed || page === 2) ? 'examined' : ''}"><strong>Page ${page + 1}</strong><div>${[1,2,3,4].map(n => { const id = page * 4 + n; return `<span class="row ${step >= 2 && id === 9 ? 'answer' : ''}">${id}</span>`; }).join('')}</div></div>`).join('')}</div>` +
        card('Table work', step < 2 ? 'Not counted yet' : indexed ? '1 page visited' : '3 pages · 12 rows checked', indexed ? 'Plus the index search' : 'All rows tested') + card('Result', step < 3 ? 'Not returned yet' : 'Order 9');
      message = [
        'Both routes start with the same twelve orders and the same question: return order 9.',
        indexed ? 'The index stores order identifiers with locations. Searching for 9 gives the location on page 3.' : 'This scan tests each stored order identifier. It has no route that jumps directly to 9.',
        indexed ? 'The engine visits page 3 for the matching row. Pages 1 and 2 are not needed by this lookup.' : 'The scan examines all three table pages. Only one of the twelve rows matches.',
        indexed ? 'The result is still order 9. Less table work came from an additional structure with its own search and maintenance costs.' : 'The result contains one order, but finding it examined twelve. A small answer does not imply a small read.',
      ][step];
    } else if (scene === 'change') {
      const staged = choice === 'staged';
      picture = card('Column rule', step === 0 ? 'No instruction column' : !staged ? 'Required rule blocked' : step === 3 ? 'Instruction required' : 'Instruction optional') +
        card('Existing order 101', step === 0 ? 'No instruction stored' : staged && step === 3 ? 'Confirmed instruction stored' : 'Instruction missing') +
        card('Old application writer', step < 2 ? 'Omits the instruction' : staged && step === 3 ? 'Replaced; old work drained' : staged ? 'Still accepted' : 'Cannot satisfy new rule');
      message = [
        'Order 101 predates the new instruction. The old application writes orders without that field.',
        staged ? 'Add an optional field first. Existing orders may lack it while compatible code is prepared.' : 'A required field without a valid value cannot cover the existing order. The change is blocked already.',
        staged ? 'The old writer still omits the field and can continue. Keep that compatibility while replacing every writer.' : 'Even if existing rows were filled, the old writer would still omit the required value. A database edit cannot upgrade the application.',
        staged ? 'Compatible writers now supply the instruction; old work has drained; existing rows have honest values. Verify those conditions, then require it.' : 'Pause and design a compatible transition. Inventing an empty value to make the rule pass would hide the missing information.',
      ][step];
    } else {
      const deleted = choice === 'delete';
      picture = card('Writer', step === 0 ? 'Order 101 present' : deleted ? 'Order 101 deleted' : 'Unavailable; storage lost') +
        card('Current replica', step < 2 ? 'Order 101 present' : deleted ? 'Order 101 deleted too' : 'Order 101 present') +
        card('Retained earlier state', 'Order 101 present', 'From before this failure');
      message = [
        'Order 101 exists on the writer, its current replica and a retained earlier copy.',
        deleted ? 'An authorised statement commits a mistaken deletion. Durability keeps that deletion; it does not recognise the mistake.' : 'The writer and its storage are lost. The application can no longer use that copy.',
        deleted ? 'Replication carries the deletion to the replica. Promoting that current copy cannot recover order 101.' : 'This replica already had order 101 before the failure. Check its complete progress and the loss requirement before choosing it.',
        deleted ? 'Use retained state from before the deletion for an isolated restore. Validate the missing facts against valid later work before repairing service.' : 'A suitable surviving replica may supply the new writer. Safe promotion, client reconnection and data checks still have to complete.',
      ][step];
    }
    get('[data-picture]').innerHTML = picture;
    get('[data-explanation]').textContent = message;
    root.querySelectorAll('[data-stage]').forEach((el, i) => el.setAttribute('aria-current', i === step ? 'step' : 'false'));
    get('[data-back]').setAttribute('aria-disabled', String(step === 0));
    get('[data-next]').setAttribute('aria-disabled', String(step === 3));
    get('[data-step]').textContent = `${step + 1} / 4`;
    if (step === 3) stop();
  };
  get('[data-next]').addEventListener('click', () => { stop(); step = Math.min(3, step + 1); draw(); });
  get('[data-back]').addEventListener('click', () => { stop(); step = Math.max(0, step - 1); draw(); });
  get('[data-reset]').addEventListener('click', () => { stop(); step = 0; draw(); });
  get('[data-choice]').addEventListener('change', () => { stop(); draw(); });
  const play = () => {
    draw();
    if (step === 3) return;
    get('[data-play]').textContent = 'Pause';
    const words = root.innerText.trim().split(/\s+/).length;
    timer = setTimeout(() => { step++; play(); }, Math.max(6000, words * 60000 / 180 + 1500));
  };
  get('[data-play]').addEventListener('click', () => { if (timer) { stop(); return; } if (step === 3) step = 0; play(); });
  document.addEventListener('astro:before-swap', stop, { once: true });
  draw();
});
</script>
<style>
  figure{margin:2rem 0;padding:1.2rem;border:1px solid var(--color-rule);background:var(--color-surface-alt)}figcaption span,figcaption strong{display:block}figcaption strong{font-size:1.1rem}.controls{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin:1rem 0}label{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-size:.85rem}button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .7rem;cursor:pointer;max-width:100%}button[aria-disabled="true"]{opacity:.5;cursor:default}button:focus-visible,select:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}.stages{display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem;list-style:none;padding:0;margin:1.2rem 0}.stages li{border-top:3px solid var(--color-rule);padding:.4rem;font-size:.75rem}.stages [aria-current="step"]{border-color:var(--color-accent);font-weight:700}.picture{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;min-height:12rem}.picture :global(.state-card){border:1px solid var(--color-rule);padding:.8rem;background:var(--color-surface);display:flex;flex-direction:column;gap:.5rem}.picture :global(.state-card strong){font-size:.8rem}.picture :global(.state-card span){font:600 .85rem/1.5 var(--font-mono);overflow-wrap:anywhere}.picture :global(small){font-size:.75rem;color:var(--color-text-secondary)}.picture :global(.access),.picture :global(.pages){grid-column:1/-1}.picture :global(.access){font:600 .8rem/1.5 var(--font-mono)}.picture :global(.pages){display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}.picture :global(.page){border:2px solid var(--color-rule);padding:.5rem;background:var(--color-surface)}.picture :global(.page strong){font-size:.75rem}.picture :global(.page.examined){border-color:var(--color-accent)}.picture :global(.page>div){display:grid;grid-template-columns:repeat(2,1fr);gap:.3rem;margin-top:.5rem}.picture :global(.row){border:1px solid var(--color-rule);padding:.25rem;text-align:center;font:.8rem var(--font-mono)}.picture :global(.answer){outline:2px solid var(--color-accent);font-weight:700}.explanation{min-height:5rem;font-size:.9rem}.caption,details{font-size:.8rem;color:var(--color-text-secondary)}summary{cursor:pointer}@media(max-width:600px){figure{padding:.8rem}.stages{grid-template-columns:repeat(2,1fr)}.picture{grid-template-columns:1fr;min-height:0}.picture :global(.page){padding:.3rem}.explanation{min-height:0}select{font-size:.8rem}}
</style>
