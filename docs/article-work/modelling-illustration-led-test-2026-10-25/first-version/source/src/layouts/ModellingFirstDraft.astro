---
import ArticleBody from '../components/editorial/ArticleBody.astro';
import ThemeSwitcher from '../components/editorial/ThemeSwitcher.astro';
import themeScript from '../scripts/theme.js?raw';
import '../styles/global.css';
import '../styles/explorables.css';
import '../styles/relational-design.css';

const { title, description, type = 'Guide' } = Astro.props;
const html = await Astro.slots.render('default');
const sources = html.match(/<h2\b[^>]*>Sources and further reading<\/h2>/i);
const body = sources ? html.slice(0, sources.index) : html;
const sourceContent = sources ? html.slice(sources.index + sources[0].length) : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={themeScript} />
    <title>{title} — Stay Current</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="inner">
      <a class="wordmark" href="https://staycurrent.dev/">Stay Current</a>
      <ThemeSwitcher />
    </div></header>
    <main id="main">
      <article class="visual-essay relational-design" data-pagefind-ignore>
        <header class="essay-header">
          <p class="eyebrow">First version · Unpublished</p>
          <h1>{title}</h1>
          <div class="essay-meta"><span>{type}</span><span data-reading-time></span><a href="https://staycurrent.dev/how-this-is-made/">AI-generated</a></div>
        </header>
        <ArticleBody><Fragment set:html={body} /></ArticleBody>
      </article>
      {sources && <details class="draft-sources">
        <summary><Fragment set:html={sources[0]} /></summary>
        <div><Fragment set:html={sourceContent} /></div>
      </details>}
    </main>
  </body>
</html>

<style>
  .draft-sources { margin-top: 2rem; border-top: 1px solid var(--color-rule); color: var(--color-text-secondary); font: .85rem/1.7 var(--font-sans); }
  summary { padding: 1rem 0; cursor: pointer; }
  summary :global(h2) { display: inline; margin: 0; font: 500 1rem/1.5 var(--font-sans); }
  summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .draft-sources > div { max-width: 62ch; padding-bottom: 1rem; overflow-wrap: anywhere; }
</style>
