---
import './figures.css';
import Controls from './Controls.astro';
import { lines, products, receipt, money } from './shop.mjs';
const result = receipt(103);
const explanations = [
 'The inputs are order_items and products. The order lines carry product IDs; the products carry the corresponding names.',
 'Keep the two lines whose order_id is 103. The other three lines belong to other orders and contribute nothing to this receipt.',
 'Line 1 carries P7. Pair it with the product row whose product_id is P7: Blue mug. One mug at 20.00 gives line_total 20.00.',
 'Line 2 carries P3. Pair it with Green tea, 50 g. Two at 4.50 give line_total 9.00.',
 'Return the chosen columns, in line_no order. The result has two rows, one per order line. Neither input table has changed.',
];
---
<div class="rf-figure rf-query" data-rf-query>
 <figure aria-labelledby="rf-query-title">
  <div class="rf-head"><span class="rf-number">Figure 2</span><p class="rf-name" id="rf-query-title">Putting names on order 103’s lines</p></div>
  <div class="rf-board">
   <div class="rf-tables">
    <div class="rf-table"><table><caption>order_items</caption><thead><tr><th scope="col">Order · line</th><th scope="col">Product ID</th><th scope="col">Qty</th><th scope="col">Unit price</th></tr></thead><tbody>
     {lines.map(l => <tr data-query-line={`${l.order}-${l.line}`} data-order={l.order}><td>{l.order} · {l.line}</td><td>{l.product}</td><td>{l.quantity}</td><td>{money(l.unitPrice)}</td></tr>)}
    </tbody></table></div>
    <div class="rf-table"><table><caption>products <span class="rf-state-note">(prices and stock omitted)</span></caption><thead><tr><th scope="col">product_id</th><th scope="col">name</th></tr></thead><tbody>
     {products.map(p => <tr data-query-product={p.id}><td>{p.id}</td><td>{p.name}</td></tr>)}
    </tbody></table></div>
   </div>
   <p class="rf-connection">Keep <code>order_id = 103</code>. Match <code>i.product_id = p.product_id</code>.</p>
   <div class="rf-table rf-result"><table><caption>Query result <span class="rf-state-note" data-query-count data-live>· 2 rows</span></caption><thead><tr><th scope="col">name</th><th scope="col">quantity</th><th scope="col">unit_price</th><th scope="col">line_total</th></tr></thead><tbody>
    <tr data-query-empty hidden><td colspan="4" class="rf-empty">No result row drawn yet.</td></tr>
    {result.map(l => <tr data-query-result={l.line}><td>{l.name}</td><td>{l.quantity}</td><td>{money(l.unitPrice)}</td><td>{money(l.total)}</td></tr>)}
   </tbody></table></div>
   <p class="rf-explanation" data-explanation data-live aria-live="polite">{explanations[4]}</p>
  </div>
  <div class="rf-controls rf-js-controls"><Controls label="Playback for figure 2" /></div>
  <figcaption>A drawing of which rows contribute to the answer, not an execution trace. The database may find and combine the rows in a different order. Prices come from the order lines; names come from products.</figcaption>
  <details><summary>All steps, as text</summary><ol>{explanations.map(e => <li>{e}</li>)}</ol></details>
 </figure>
</div>
<script>
 import { stepper } from '../figures/stepper.mjs';
 const explanations = [
  'The inputs are order_items and products. The order lines carry product IDs; the products carry the corresponding names.',
  'Keep the two lines whose order_id is 103. The other three lines belong to other orders and contribute nothing to this receipt.',
  'Line 1 carries P7. Pair it with the product row whose product_id is P7: Blue mug. One mug at 20.00 gives line_total 20.00.',
  'Line 2 carries P3. Pair it with Green tea, 50 g. Two at 4.50 give line_total 9.00.',
  'Return the chosen columns, in line_no order. The result has two rows, one per order line. Neither input table has changed.',
 ];
 document.querySelectorAll<HTMLElement>('[data-rf-query]').forEach(root => {
  stepper(root, { steps: () => explanations.length, draw: (step: number) => {
   root.querySelectorAll<HTMLElement>('[data-query-line]').forEach(row => {
    row.dataset.muted = String(step > 0 && row.dataset.order !== '103');
    row.dataset.match = String(step > 0 && row.dataset.order === '103');
    row.dataset.current = String((step === 2 && row.dataset.queryLine === '103-1') || (step === 3 && row.dataset.queryLine === '103-2'));
   });
   root.querySelectorAll<HTMLElement>('[data-query-product]').forEach(row => row.dataset.current = String((step === 2 && row.dataset.queryProduct === 'P7') || (step === 3 && row.dataset.queryProduct === 'P3')));
   root.querySelectorAll<HTMLElement>('[data-query-result]').forEach(row => row.hidden = step < Number(row.dataset.queryResult) + 1);
   (root.querySelector('[data-query-empty]') as HTMLElement).hidden = step >= 2;
   root.querySelector('[data-query-count]')!.textContent = `· ${step < 2 ? 0 : step === 2 ? 1 : 2} rows drawn`;
   root.querySelector('[data-explanation]')!.textContent = explanations[step];
  }});
  root.dataset.ready = 'true';
 });
</script>
