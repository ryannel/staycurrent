---
const customers = [
  { id: 1, name: 'Mina Shah' },
  { id: 2, name: 'Tariq Aziz' },
  { id: 3, name: 'Edda Berg' },
];
const orders = [
  { id: 101, customer: 1 },
  { id: 102, customer: 2 },
  { id: 103, customer: 1 },
];
---

<figure class="oc-figure" aria-labelledby="oc-title">
  <div class="oc-heading"><span>Figure 1</span><p id="oc-title">From an order to its customer</p></div>
  <div class="oc-player" data-order-customer>
    <div class="oc-board">
      <div class="oc-tables">
        <table class="oc-orders">
          <caption>orders <span>one row per order</span></caption>
          <thead><tr><th scope="col">order_id</th><th scope="col">customer_id</th></tr></thead>
          <tbody>{orders.map(order => <tr data-order={order.id} data-customer={order.customer}><td>{order.id}</td><td data-link-from>{order.customer}</td></tr>)}</tbody>
        </table>
        <table class="oc-customers">
          <caption>customers <span>one row per customer</span></caption>
          <thead><tr><th scope="col">customer_id</th><th scope="col">name</th></tr></thead>
          <tbody>{customers.map(customer => <tr data-person={customer.id}><td data-link-to>{customer.id}</td><td>{customer.name}</td></tr>)}</tbody>
        </table>
        <svg class="oc-connection" aria-hidden="true"><defs><marker id="oc-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 L7 3.5 L0 7" /></marker></defs><path data-connection marker-end="url(#oc-arrow)" /></svg>
      </div>
      <p class="oc-explanation" data-live data-explanation aria-live="polite">The orders table holds three orders. The customers table holds three customers.</p>
    </div>
    <div class="oc-controls" hidden>
      <label class="oc-choice">Follow order <select data-order-choice><option value="103">103</option><option value="102">102</option><option value="101">101</option></select></label>
      <div class="oc-transport" role="group" aria-label="Playback for figure 1">
        <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span class="oc-count" data-step aria-label="Step">1 / 4</span>
      </div>
      <div class="oc-hold" data-hold aria-hidden="true"><span></span></div>
    </div>
  </div>
  <figcaption>Two small tables from the invented tea shop. The arrow follows equal <code>customer_id</code> values; it illustrates how to read the connection, rather than the steps a database takes to execute a query.</figcaption>
  <details><summary>The connection, as text</summary><p>Order 103 has customer_id 1. Customer 1 is Mina Shah. Order 102 has customer_id 2, Tariq Aziz. Order 101 also has customer_id 1, Mina Shah. Edda Berg is customer 3 and has no orders in this example.</p></details>
</figure>

<script>
  import { stepper } from '../figures/stepper.mjs';

  document.querySelectorAll<HTMLElement>('[data-order-customer]').forEach(root => {
    const choice = root.querySelector<HTMLSelectElement>('[data-order-choice]')!;
    const explanation = root.querySelector<HTMLElement>('[data-explanation]')!;
    const tables = root.querySelector<HTMLElement>('.oc-tables')!;
    const arrow = root.querySelector<SVGPathElement>('[data-connection]')!;
    let currentStep = 0;

    const drawConnection = () => {
      if (currentStep !== 3) { arrow.setAttribute('d', ''); return; }
      const order = root.querySelector<HTMLElement>(`[data-order="${choice.value}"]`)!;
      const person = root.querySelector<HTMLElement>(`[data-person="${order.dataset.customer}"]`)!;
      const from = order.querySelector<HTMLElement>('[data-link-from]')!.getBoundingClientRect();
      const to = person.querySelector<HTMLElement>('[data-link-to]')!.getBoundingClientRect();
      const box = tables.getBoundingClientRect();
      const stacked = to.top > from.bottom + 30;
      if (stacked) {
        const x = box.width - 5;
        arrow.setAttribute('d', `M ${from.right - box.left + 3} ${from.top - box.top + from.height / 2} H ${x} V ${to.top - box.top + to.height / 2} H ${to.right - box.left + 7}`);
      } else {
        const x1 = from.right - box.left + 3;
        const x2 = to.left - box.left - 7;
        const middle = (x1 + x2) / 2;
        arrow.setAttribute('d', `M ${x1} ${from.top - box.top + from.height / 2} H ${middle} V ${to.top - box.top + to.height / 2} H ${x2}`);
      }
    };
    const player = stepper(root, {
      steps: () => 4,
      draw: (step: number) => {
        currentStep = step;
        const order = root.querySelector<HTMLElement>(`[data-order="${choice.value}"]`)!;
        const customer = order.dataset.customer!;
        const person = root.querySelector<HTMLElement>(`[data-person="${customer}"]`)!;
        const name = person.lastElementChild!.textContent;
        root.querySelectorAll('[data-order], [data-person]').forEach(row => row.removeAttribute('data-state'));
        if (step > 0) order.dataset.state = step === 1 ? 'row' : 'link';
        if (step === 3) person.dataset.state = 'match';
        explanation.textContent = [
          'The orders table holds three orders. The customers table holds three customers.',
          `Read across order ${choice.value}’s row: its order_id is ${choice.value}, and its customer_id is ${customer}.`,
          `The ${customer} under customer_id means customer ${customer} placed order ${choice.value}. Look for that value in customers.`,
          `The customer_id values match: ${customer} in orders, ${customer} in customers. Order ${choice.value} belongs to ${name}.`,
        ][step];
        drawConnection();
      },
    });
    choice.addEventListener('change', () => player.render());
    root.querySelector<HTMLElement>('.oc-controls')!.hidden = false;
    new ResizeObserver(drawConnection).observe(tables);
  });
</script>

<style>
  .oc-figure { margin: 2rem 0; }
  .oc-heading { display: flex; align-items: baseline; gap: .7rem; margin-bottom: .6rem; }
  .oc-heading > span { font: .65rem var(--font-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--color-text-secondary); }
  .oc-heading > p { font: 1.15rem/1.3 var(--font-serif); margin: 0; }
  .oc-player { border: 1px solid var(--color-rule-strong); }
  .oc-board { padding: 1.25rem 1rem 1rem; background: var(--color-surface-alt); }
  .oc-tables { position: relative; display: grid; grid-template-columns: 1fr 1.08fr; gap: 3rem; }
  .oc-tables table { display: table; table-layout: fixed; margin: 0; width: 100%; overflow: visible; color: var(--color-text); font: .82rem/1.5 var(--font-sans); }
  caption { text-align: left; font: 500 .88rem/1.5 var(--font-mono); padding-bottom: .65rem; color: var(--color-text); }
  caption span { display: block; font: .7rem/1.5 var(--font-sans); color: var(--color-text-secondary); }
  th, td { padding: .6rem .3rem; text-align: left; border-bottom: 1px solid var(--color-rule-strong); }
  th { font: 500 .69rem/1.5 var(--font-mono); color: var(--color-text-secondary); background: none; }
  td { background: var(--color-surface); height: 2.6rem; }
  td:first-child { font-family: var(--font-mono); }
  .oc-orders td { font-family: var(--font-mono); }
  tr[data-state='row'] td { box-shadow: inset 0 2px var(--color-accent), inset 0 -2px var(--color-accent); }
  tr[data-state='link'] td:last-child, tr[data-state='match'] td:first-child { outline: 2px solid var(--color-accent); outline-offset: -2px; color: var(--color-accent-strong); font-weight: 700; }
  tr[data-state='match'] td:last-child { font-weight: 700; }
  .oc-connection { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .oc-connection > path { stroke: var(--color-accent); stroke-width: 2; fill: none; }
  marker path { fill: var(--color-accent); }
  .oc-explanation { font: .8rem/1.55 var(--font-sans); border-left: 3px solid var(--color-accent); padding: .4rem 0 .4rem .7rem; margin: 1.2rem 0 0; min-height: 4.55rem; }
  .oc-controls { padding: .8rem; border-top: 1px solid var(--color-rule-strong); background: var(--color-surface); color: var(--color-text); font: .75rem/1.5 var(--font-sans); }
  .oc-controls[hidden] { display: none; }
  .oc-choice { display: flex; align-items: center; gap: .6rem; margin-bottom: .65rem; }
  .oc-controls select, .oc-controls button { font: inherit; border: 1px solid var(--color-text-secondary); border-radius: 4px; color: var(--color-text); background: var(--color-surface); padding: .45rem .65rem; min-height: 2.4rem; cursor: pointer; }
  .oc-controls button:hover { background: var(--color-surface-alt); }
  .oc-controls :focus-visible, summary:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  .oc-transport { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
  .oc-controls button[aria-disabled='true'] { border-style: dashed; }
  .oc-count { margin-left: auto; font-family: var(--font-mono); }
  .oc-hold { height: 2px; margin-top: .7rem; }
  .oc-hold span { display: block; height: 100%; width: 0; background: var(--color-accent); }
  figcaption, details { font: .75rem/1.55 var(--font-sans); color: var(--color-text-secondary); }
  figcaption { margin-top: .7rem; }
  details { margin-top: .65rem; }
  details p { margin-top: .65rem; }
  summary { cursor: pointer; text-decoration: underline; text-underline-offset: .15em; }
  @media (max-width: 600px) {
    .oc-board { padding: 1rem .8rem; }
    .oc-tables { grid-template-columns: 1fr; gap: 1.8rem; padding-right: 1.3rem; }
    .oc-tables table { font-size: .85rem; }
    th { font-size: .72rem; }
    .oc-explanation { min-height: 6.15rem; }
  }
</style>
