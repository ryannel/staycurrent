---
import Figure from './Figure.astro';
import { offers, inventedOffer, pairSets } from './model.mjs';
const candidates = [...offers, inventedOffer];
const headings = ['Supplier–product', 'Supplier–location', 'Product–location'];
---
<Figure number="4" title="Three true pairs can make a false offer" id="offer-figure-title">
  <div data-offers>
    <div class="model-scene">
      <div class="model-table"><p class="table-title"><strong>Actual offers</strong><span>One row is one complete offer</span></p><table><thead><tr><th scope="col">supplier</th><th scope="col">product</th><th scope="col">location</th></tr></thead><tbody>{offers.map(r=><tr>{r.map(v=><td>{v}</td>)}</tr>)}</tbody></table></div>
      <p class="pair-arrow">Split into three lists of pairs ↓</p>
      <div class="pair-tables">{pairSets.map((pairs,i)=><div class="pair-table"><strong>{headings[i]}</strong>{pairs.map(pair=><p>{pair.join(' · ')}</p>)}</div>)}</div>
    </div>
    <div class="model-controls"><label for="offer-candidate">Try to reconstruct an offer</label><select id="offer-candidate">{candidates.map((r,i)=><option value={i} selected={i===3}>{r.join(' / ')}{i===3 ? ' — never offered' : ''}</option>)}</select></div>
    <div class="offer-result" aria-live="polite"><p class="offer-triple" data-triple>S1 / P3 / L2</p><ul data-pair-checks><li>✓ S1 · P3 is listed</li><li>✓ S1 · L2 is listed</li><li>✓ P3 · L2 is listed</li></ul><p class="figure-explanation" data-offer-explanation>All three pairs exist, so their join includes S1 / P3 / L2. That offer is absent from the original table. The split has invented an association.</p></div>
  </div>
  <p class="figure-note">A hypothetical extension. S1 is North, S2 Harbour; L1 is Town, L2 Station. The pairs retain every ID but lose which three occurred together. The original offers are listed above as the text alternative.</p>
</Figure>
<script>
  import { offers, inventedOffer, pairEvidence, isOffer } from './model.mjs';
  const root = document.querySelector('[data-offers]');
  if (root) {
    const candidates = [...offers, inventedOffer];
    const picker = root.querySelector('select');
    const draw = () => {
      const triple = candidates[Number(picker.value)];
      root.querySelector('[data-triple]').textContent = triple.join(' / ');
      const evidence = pairEvidence(triple);
      root.querySelector('[data-pair-checks]').replaceChildren(...[[0,1],[0,2],[1,2]].map((indices,i) => {
        const li = document.createElement('li'); li.textContent = `${evidence[i] ? '✓' : '✗'} ${indices.map(j=>triple[j]).join(' · ')} is ${evidence[i] ? '' : 'not '}listed`; return li;
      }));
      root.querySelector('[data-offer-explanation]').textContent = isOffer(triple)
        ? `All three pairs exist, so their join includes ${triple.join(' / ')}. This offer was in the original table. Recovering this row does not show that the split is safe: try the offer that was never made.`
        : `All three pairs exist, so their join includes ${triple.join(' / ')}. That offer is absent from the original table. The split has invented an association.`;
    };
    picker.addEventListener('change', draw); draw();
  }
</script>
