---
import Figure from './Figure.astro';
import { normalisationStages } from './model.mjs';
const stage = normalisationStages[0];
---
<Figure number="3" title="Giving each fact a home" id="normalisation-figure-title">
  <div data-normalisation>
    <div class="model-scene" data-tables data-table-count="1" data-live>
      {stage.tables.map(t => <div class="model-table"><p class="table-title"><strong>{t.name}</strong><span>{t.key}</span></p><div class="table-scroll" role="region" aria-label={t.name} tabindex="0"><table><thead><tr>{t.columns.map(c=><th scope="col">{c}</th>)}</tr></thead><tbody>{t.rows.map(r=><tr>{r.map(v=><td>{v}</td>)}</tr>)}</tbody></table></div></div>)}
    </div>
    <p class="figure-explanation" data-explanation aria-live="polite" data-live>{stage.explanation}</p>
    <div class="model-controls" aria-label="Normalisation steps">
      <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 4</span><span class="hold" data-hold aria-hidden="true"><span></span></span>
    </div>
  </div>
  <p class="figure-note">A structural illustration of the five shop lines. Tables scroll sideways on narrow screens. ¹ Dates are in October 2026, UTC. Status, catalogue price and stock are omitted. Column labels are shortened for space.</p>
  <details class="figure-text"><summary>The split, as text</summary><ol>{normalisationStages.map(s=><li>{s.explanation}</li>)}</ol></details>
</Figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  import { normalisationStages } from './model.mjs';
  const root = document.querySelector('[data-normalisation]');
  if (root) stepper(root, { steps: () => normalisationStages.length, draw: (step) => {
    const stage = normalisationStages[step];
    const scene = root.querySelector('[data-tables]');
    const pieces = stage.tables.map(t => {
      const box = document.createElement('div'); box.className = 'model-table';
      const title = document.createElement('p'); title.className = 'table-title';
      const name = document.createElement('strong'); name.textContent = t.name;
      const key = document.createElement('span'); key.textContent = t.key;
      title.append(name, key); box.append(title);
      const scroll = document.createElement('div'); scroll.className = 'table-scroll'; scroll.setAttribute('role', 'region'); scroll.setAttribute('aria-label', t.name); scroll.tabIndex = 0;
      const table = document.createElement('table');
      const head = table.createTHead().insertRow();
      t.columns.forEach(c => { const th = document.createElement('th'); th.scope = 'col'; th.textContent = c; head.append(th); });
      const body = table.createTBody();
      t.rows.forEach(r => { const row = body.insertRow(); r.forEach(v => { row.insertCell().textContent = String(v); }); });
      scroll.append(table); box.append(scroll); return box;
    });
    scene.replaceChildren(...pieces);
    scene.setAttribute('data-table-count', String(pieces.length));
    root.querySelector('[data-explanation]').textContent = stage.explanation;
  }});
</script>
