---
import { race, raceEvents } from './data.mjs';
---
<figure class="purchase-race" data-race aria-labelledby="race-title">
 <figcaption id="race-title"><span>Figure 2</span> Two buyers, one mug</figcaption>
 <div class="race-paper">
  <div class="race-state"><div><small>Stock · P7</small><strong data-stock data-live>1</strong></div><div><small>Committed new orders</small><strong data-orders data-live>Neither</strong></div></div>
  <p class="time-direction">Read down for event order ↓</p>
  <div class="lanes" aria-hidden="true"><span>Mina · order 103</span><span></span><span>Tariq · order 104</span></div>
  <div class="race-trace" aria-label="Purchase events in order">{raceEvents.unsafe.map(([actor,label],index)=><div class="event-row" data-event-row={index}><span class:list={{event:actor===0}} data-event-left data-live>{actor===0?label:''}</span><b aria-hidden="true">{index+1}</b><span class:list={{event:actor===1}} data-event-right data-live>{actor===1?label:''}</span></div>)}</div>
  <div class="buyers"><div><h3>Mina · order 103</h3><p data-mina data-live>Not started</p></div><div><h3>Tariq · order 104</h3><p data-tariq data-live>Not started</p></div></div>
  <p data-explanation data-live aria-live="polite">{race.unsafe[0][4]}</p>
 </div>
 <div class="race-controls">
  <label>Purchase protocol <select data-protocol><option value="unsafe">Read, calculate, write 0</option><option value="protected">Conditional UPDATE</option></select></label>
  <div class="buttons" role="group" aria-label="Controls for figure 2"><button type="button" data-play data-live>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step data-live>1 / 5</span></div>
  <div data-hold aria-hidden="true"><span></span></div>
 </div>
 <p class="figure-note">A stepped illustration of the two protocols at PostgreSQL 18 Read Committed isolation, with Mina reaching the update first. It runs no database in this page. Stock and orders change together at commit. The supporting native check reproduced both outcomes.</p>
 <details><summary>Both histories as text</summary>{Object.entries(race).map(([name,steps])=><div><h3>{name==='unsafe'?'Read, calculate, write 0':'Conditional UPDATE'}</h3><ol>{steps.map(step=><li>{step[4]}</li>)}</ol></div>)}</details>
</figure>
<script>
 import { stepper } from '../figures/stepper.mjs';
 import { race, raceEvents } from './data.mjs';
 function initRace(){document.querySelectorAll<HTMLElement>('[data-race]').forEach(root=>{
  if(root.dataset.ready)return;root.dataset.ready='true';
  const protocol=root.querySelector<HTMLSelectElement>('[data-protocol]')!;
  const player=stepper(root,{steps:()=>5,draw:(step:number)=>{
   const mode=protocol.value as keyof typeof race;
   const state=race[mode][step];
   root.querySelectorAll<HTMLElement>('[data-event-row]').forEach((row,index)=>{
    const [actor,label]=raceEvents[mode][index];
    row.dataset.reached=String(index<step);row.dataset.current=String(index===step-1);
    ['left','right'].forEach((side,sideIndex)=>{const cell=row.querySelector<HTMLElement>(`[data-event-${side}]`)!;cell.textContent=actor===sideIndex?String(label):'';cell.classList.toggle('event',actor===sideIndex);});
   });
   ['mina','tariq','stock','orders','explanation'].forEach((name,index)=>{root.querySelector(`[data-${name}]`)!.textContent=state[index];});
  }});
  protocol.addEventListener('change',()=>{(root.querySelector('[data-reset]') as HTMLButtonElement).click();player.render();});
 });}
 initRace();document.addEventListener('astro:page-load',initRace);
</script>
<style>
 .purchase-race{margin:2.5rem 0;font: .85rem/1.6 var(--font-sans)}figcaption{font:1.1rem var(--font-serif);margin-bottom:1rem}figcaption span{font:.7rem var(--font-mono);text-transform:uppercase;margin-right:.7rem;color:var(--color-text-secondary)}
 .race-paper{border:1px solid var(--color-rule-strong);padding:1.15rem;background:var(--color-surface-alt)}.race-state{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding-bottom:1rem;border-bottom:1px solid var(--color-rule-strong)}small{display:block;font-size:.73rem;color:var(--color-text-secondary)}strong{display:block;font:1.35rem/1.5 var(--font-mono)}.buyers{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.buyers>div{border-top:3px solid var(--teal);padding:.5rem;background:var(--color-surface)}.buyers>div+div{border-color:var(--gold)}h3{font:600 .82rem/1.5 var(--font-sans);margin:.2rem 0}.buyers p{font:.82rem/1.6 var(--font-mono);min-height:3.2em;margin:.5rem 0}[data-explanation]{border-left:3px solid var(--teal);padding-left:.8rem;min-height:5em;margin:1rem 0 0}
 .time-direction{font:.72rem var(--font-sans);color:var(--color-text-secondary);margin:1rem 0 .7rem}.lanes{display:grid;grid-template-columns:minmax(0,1fr) 1.8rem minmax(0,1fr);gap:.4rem;font:600 .74rem/1.5 var(--font-sans);padding:.5rem 0}.race-trace{position:relative}.event-row{display:grid;grid-template-columns:minmax(0,1fr) 1.8rem minmax(0,1fr);gap:.4rem;align-items:center;min-height:2.8rem}.event-row b{font:.7rem var(--font-mono);text-align:center;color:var(--color-text-secondary);border-left:1px solid var(--color-rule-strong);border-right:1px solid var(--color-rule-strong);height:100%;display:grid;place-items:center}.event-row span{padding:.35rem .5rem;font:.74rem/1.5 var(--font-mono)}.event-row[data-reached="false"] span{visibility:hidden}.event-row .event{border-bottom:1px solid var(--teal);background:color-mix(in srgb,var(--teal) 10%,var(--color-surface))}.event-row .event:last-child{border-color:var(--gold);background:color-mix(in srgb,var(--gold) 10%,var(--color-surface))}.event-row[data-current="true"] .event{outline:2px solid var(--color-text);outline-offset:-2px}
 .race-controls{padding:.85rem;background:var(--control-tint);border:1px solid var(--control);border-top:0}label{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;font-size:.78rem}.buttons{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-top:.8rem}button,select{font:.78rem var(--font-sans);min-height:42px;border:1px solid var(--control);background:var(--color-surface);color:var(--control);padding:.5rem .7rem;border-radius:4px}button{cursor:pointer}button[aria-disabled="true"]{opacity:.55}button:focus-visible,select:focus-visible{outline:3px solid var(--control);outline-offset:3px}[data-step]{margin-left:auto;font:.72rem var(--font-mono);color:var(--color-text-secondary)}[data-hold]{height:3px;margin-top:.7rem;background:var(--color-rule)}[data-hold] span{display:block;width:0;height:100%;background:var(--control)}.figure-note,details{font:.77rem/1.65 var(--font-sans);color:var(--color-text-secondary)}summary{cursor:pointer;color:var(--control);text-decoration:underline;text-underline-offset:.2em}details h3{margin-top:1rem}li{margin:.45rem 0}
 @media(max-width:450px){.race-paper{padding:.75rem}.buyers{grid-template-columns:1fr;gap:.6rem}.buyers p{min-height:0}.race-state{gap:.6rem}strong{font-size:1.05rem}[data-explanation]{min-height:8em}select{max-width:100%}}
</style>
