---
import SkillTrial from '../../../layouts/SkillTrial.astro';

export function getStaticPaths() {
  if (process.env.RELATIONAL_DRAFT_PREVIEW !== '1') return [];
  const fragments = import.meta.glob('../../../articles/relational-full-reference/*.astro', {
    eager: true,
    import: 'default',
  });
  const Component = fragments['../../../articles/relational-full-reference/introduction.astro'];
  return Component ? [
    { params: { slug: undefined }, props: { Component, isolated: false } },
    { params: { slug: 'figures' }, props: { Component, isolated: true } },
  ] : [];
}
const { Component, isolated } = Astro.props;
---
<SkillTrial title={isolated ? 'Relational databases — figures' : 'Relational databases'} description="A fresh complete introduction to relational databases, from tables and queries to transactions, operation and choosing a system.">
  {isolated ? <div class="isolated-figures"><Component /></div> : <Component />}
</SkillTrial>

<style is:global>
  .isolated-figures :is(p, h2, h3, h4, nav, aside):not(figure *) { display: none; }
  .isolated-figures .essay-sources { display: none; }
</style>
