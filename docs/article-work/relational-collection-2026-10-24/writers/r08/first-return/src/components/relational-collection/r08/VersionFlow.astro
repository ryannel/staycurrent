---
import core from '../../../lib/relational-collection/core.json';
import feed from './downloads/feed.json';
const initial=core.products.find(p=>p.product_id==='P7').price;
---
<figure data-version-flow data-initial={initial} data-events={JSON.stringify(feed.events)} class="version-flow" aria-labelledby="r08-version-title">
<figcaption id="r08-version-title"><span>Figure 1</span> A delayed version reaches the same key</figcaption>
<div class="options" role="group" aria-label="Import policy"><button type="button" data-policy="arrival" aria-pressed="true">Arrival wins</button><button type="button" data-policy="version" aria-pressed="false">Source versions</button></div>
<div class="version-scene">
<ol aria-label="Incoming P7 records">{feed.events.map((event,i)=><li data-event={i}><strong>{event.label}</strong><span>v{event.version} · {event.price}</span><small data-status data-live>Waiting</small></li>)}</ol>
<div class="current"><span>↓ apply to P7</span><div><strong>Current catalogue</strong><b data-price data-live>{initial}</b><span data-version data-live>Source version 1</span></div><p data-ledger data-live>Known: v1 = 20.00</p></div>
</div>
<p data-explanation data-live aria-live="polite">The import starts with P7 at 20.00 and source version 1.</p>
<div class="controls" role="group" aria-label="Import steps"><button data-play type="button">Play</button><button data-back type="button">Back</button><button data-next type="button">Next</button><button data-reset type="button">Reset</button><span data-step>1 / 5</span><div data-hold><span></span></div></div>
<p class="caption">A logical replay of separate incoming records, not network timing. The corrected price is version 3; a later delivery of version 2 cannot make it newer. The seen-version record additionally catches a contradictory old payload.</p>
<details><summary>Read both policies as text</summary><p>Arrival wins displays 20.00, 25.00, 24.00, 25.00, 26.00. Source versions displays 20.00, 25.00, 24.00, 24.00, 24.00: identical old version 2 is stale, and version 2 with 26.00 conflicts with the recorded 25.00 and is refused. Order 103’s agreed mug price stays 20.00 under both policies.</p></details>
</figure>
<script>
import {stepper} from '../../figures/stepper.mjs';
document.querySelectorAll('[data-version-flow]').forEach(root=>{
let policy='arrival';const events=JSON.parse(root.getAttribute('data-events'));const initial=root.getAttribute('data-initial');
const player=stepper(root,{steps:()=>events.length+1,draw:step=>{
let version=1,price=initial;const seen=new Map([[1,initial]]);let explanation='The import starts with P7 at 20.00 and source version 1.';
root.querySelectorAll('[data-event]').forEach((el,i)=>{
let status='Waiting';if(i<step){const e=events[i];if(policy==='arrival'){version=e.version;price=e.price;status='Applied';explanation=`The incoming version ${e.version} writes ${e.price}, because this policy treats the last arrival as authoritative.`;}else if(seen.has(e.version)&&seen.get(e.version)!==e.price){status='Conflict: refused';explanation=`Version ${e.version} was already recorded at ${seen.get(e.version)}. Its contradictory ${e.price} is refused; the current catalogue remains ${price}.`;}else{seen.set(e.version,e.price);if(e.version>version){version=e.version;price=e.price;status='Newer: applied';explanation=`Source version ${version} advances the catalogue to ${price}.`;}else{status='Older: unchanged';explanation=`Version ${e.version} repeats its known ${e.price}, but current version ${version} is newer. The catalogue remains ${price}.`;}}}
el.querySelector('[data-status]').textContent=status;el.classList.toggle('arrived',i<step);el.classList.toggle('latest',i===step-1);
});
root.querySelector('[data-price]').textContent=price;root.querySelector('[data-version]').textContent=`Source version ${version}`;root.querySelector('[data-ledger]').textContent=policy==='version'?'Known: '+[...seen].map(([v,p])=>`v${v} = ${p}`).join('; '):'No seen-version comparison';root.querySelector('[data-explanation]').textContent=explanation;
}});root.querySelectorAll('[data-policy]').forEach(button=>button.addEventListener('click',()=>{policy=button.getAttribute('data-policy');root.querySelectorAll('[data-policy]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));player.render();}));
});
</script>
<style>
.version-flow{margin:2rem 0;font:.9rem/1.5 var(--font-sans)}figcaption{font:1.2rem/1.4 var(--font-serif);margin-bottom:.8rem}figcaption>span{font:.75rem var(--font-sans);text-transform:uppercase;margin-right:.7rem;color:var(--color-text-secondary)}button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-text-secondary);border-radius:.2rem;padding:.45rem .65rem;cursor:pointer}button:focus-visible{outline:3px solid var(--color-accent);outline-offset:3px}button[aria-pressed=true]{background:var(--color-accent);color:var(--color-surface)}.options,.controls{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;background:var(--color-surface-alt);padding:1rem}.version-scene{display:grid;grid-template-columns:1.2fr 1fr;gap:1rem;padding:1rem;border:1px solid var(--color-rule-strong)}ol{list-style:none;padding:0;margin:0;display:grid;gap:.6rem}li{border:1px solid var(--color-rule-strong);padding:.65rem;display:grid;gap:.2rem}li span{font-family:var(--font-mono)}small{font-size:.8rem;color:var(--color-text-secondary)}li.arrived{border-color:var(--color-text-secondary)}li.latest{outline:2px solid var(--color-accent)}.current{align-self:center;display:grid;gap:.8rem}.current>span{text-align:center;color:var(--color-text-secondary)}.current>div{border:2px solid var(--color-accent);padding:1rem;display:grid;gap:.4rem}.current b{font:2rem var(--font-serif)}.current p{font-size:.8rem;overflow-wrap:anywhere}[data-explanation]{padding:1rem;border-left:3px solid var(--color-accent);margin:0;min-height:6rem}.caption,details{font-size:.85rem;color:var(--color-text-secondary)}summary{cursor:pointer}[data-hold]{flex-basis:100%;height:3px;background:var(--color-rule)}[data-hold] span{display:block;width:0;height:100%;background:var(--color-accent)}@media(max-width:550px){.version-scene{grid-template-columns:1fr}.current{grid-template-columns:1fr}.current>div{grid-template-columns:1fr auto}.current>div span{grid-column:1/-1}}
</style>
