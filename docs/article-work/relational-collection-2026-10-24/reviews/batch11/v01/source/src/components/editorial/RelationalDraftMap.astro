---
import SwitcherLink from './SwitcherLink.astro';
import { relationalDraftGroups, relationalDraftHref, type RelationalDraftState } from '../../lib/relational-draft-20261024';
interface Props { entry: RelationalDraftState; entries: RelationalDraftState[] }
const { entry, entries } = Astro.props;
const introduction = entries.find(item => item.key === 'r00');
const path = relationalDraftHref(entry.slug);
const count = (items: RelationalDraftState[]) => {
  const available = items.filter(item => item.status === 'draft').length;
  return `${available} ${available === 1 ? 'draft' : 'drafts'}${available < items.length ? ` · ${items.length - available} planned` : ''}`;
};
---
<nav class="draft-map" id="collection" aria-labelledby="collection-title" data-pagefind-ignore>
  <h2 id="collection-title">The relational database collection</h2>
  <p>Drafts for review. Browse by subject; planned articles will become available here as they are written.</p>
  {introduction && <p class="collection-position">{introduction.status === 'draft'
    ? <SwitcherLink href={relationalDraftHref('')} path={path}>{introduction.title}</SwitcherLink>
    : <span>{introduction.title} <span class="status">Planned</span></span>}</p>}
  {relationalDraftGroups.map(group => {
    const articles = entries.filter(item => item.group === group.id);
    return <details id={`reading-${group.id}`}>
      <summary><span>{group.title}</span><span class="subject-count">{count(articles)}</span></summary>
      <ul>{articles.map(item => <li>
        {item.status === 'draft'
          ? <SwitcherLink href={relationalDraftHref(item.slug)} path={path}>{item.title}</SwitcherLink>
          : <span class="planned">{item.title}<span class="status">Planned</span></span>}
        <p>{item.description}</p>
      </li>)}</ul>
    </details>;
  })}
</nav>
<style>
  .draft-map { margin:2.75rem 0 0; border-top:1px solid var(--color-rule-strong); padding-top:1.5rem; }
  .draft-map > h2 { margin-top:0; padding-top:0; }
  .draft-map > p { max-width:62ch; font:.85rem/1.7 var(--font-sans); color:var(--color-text-secondary); }
  .collection-position :global(.switcher-link) { display:flex; align-items:center; flex-wrap:wrap; gap:.4rem .65rem; color:var(--color-text); }
  details { border-bottom:1px solid var(--color-rule); }
  summary { display:grid; grid-template-columns:minmax(0,1fr) auto .45rem; align-items:center; gap:.8rem; padding:.85rem 0; list-style:none; cursor:pointer; font:500 .9rem/1.5 var(--font-sans); }
  summary::-webkit-details-marker { display:none; }
  summary::after { content:''; grid-column:3; width:.4rem; height:.4rem; border-right:1.5px solid var(--color-text-secondary); border-bottom:1.5px solid var(--color-text-secondary); transform:rotate(-45deg); }
  details[open] > summary::after { transform:rotate(45deg); }
  .subject-count, .status { font:.7rem/1.5 var(--font-sans); color:var(--color-text-secondary); white-space:nowrap; }
  .status { display:inline-block; margin-left:.5rem; }
  ul { list-style:none; padding:0; margin:.15rem 0 1.1rem .15rem; }
  li { margin:0 0 1rem; }
  li :global(.switcher-link), .planned { font:500 .95rem/1.5 var(--font-sans); text-underline-offset:.2em; }
  :global(.draft-map .current-marker) { display:inline-block; padding:.08rem .45rem; border-radius:1rem; background:color-mix(in srgb,var(--color-accent) 10%,transparent); color:var(--color-accent); font:500 .65rem/1.5 var(--font-sans); white-space:nowrap; }
  li p { margin:.3rem 0 0; font:.85rem/1.6 var(--font-sans); color:var(--color-text-secondary); }
  summary:focus-visible, .draft-map :global(a:focus-visible) { outline:2px solid var(--color-accent); outline-offset:4px; }
  @media(max-width:480px) { summary { gap:.5rem; font-size:.85rem; } .subject-count { font-size:.65rem; } }
</style>
