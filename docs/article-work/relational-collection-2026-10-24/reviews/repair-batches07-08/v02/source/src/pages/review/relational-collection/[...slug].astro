---
import RelationalCollectionDraft from '../../../layouts/RelationalCollectionDraft.astro';
import { relationalDraftStates, relationalDraftGroups } from '../../../lib/relational-draft-20261024';

export function getStaticPaths() {
  if (process.env.RELATIONAL_COLLECTION_PREVIEW !== '1') return [];
  const fragments = import.meta.glob('../../../articles/relational-collection/*.astro', {
    eager: true,
    import: 'default',
  });
  const metadata = import.meta.glob('../../../articles/relational-collection/*.meta.json', {
    eager: true,
    import: 'default',
  }) as Record<string, { title?: string; description?: string }>;
  const keyFor = (key: string) => `../../../articles/relational-collection/${key}.astro`;
  const entries = relationalDraftStates(Object.keys(fragments).flatMap(path => path.match(/\/(r\d{2})\.astro$/)?.[1] ?? [])).map(entry => {
    const authored = metadata[`../../../articles/relational-collection/${entry.key}.meta.json`];
    return { ...entry,
      title: authored?.title?.trim() || entry.title,
      description: authored?.description?.trim() || entry.description,
    };
  });
  return entries.filter(entry => entry.status === 'draft').flatMap(entry => {
    const Component = fragments[keyFor(entry.key)];
    return [
      { params: { slug: entry.slug || undefined }, props: { Component, entry, entries, collection: relationalDraftGroups, isolated: false } },
      { params: { slug: `figures/${entry.key}` }, props: { Component, entry, entries, collection: relationalDraftGroups, isolated: true } },
    ];
  });
}
const { Component, entry, entries, collection, isolated } = Astro.props;
---
<RelationalCollectionDraft entry={entry} entries={entries} isolated={isolated}>
  <Component entry={entry} entries={entries} collection={collection} />
</RelationalCollectionDraft>
