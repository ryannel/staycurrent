---
import { reading } from '../../lib/reading';
import '../../styles/search.css';
const { id = 'page-search', modal = false } = Astro.props;
const filters = [['', 'All content'], ['Article', 'Articles'], ['Guide', 'Guides'], ['Playground', 'Playgrounds']];
---
<search-panel data-modal={modal ? 'true' : undefined}>
  <form role="search" action="/search/" method="get">
    <div class="search-input-wrap">
      <svg class="search-magnifier" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
      <label class="search-sr-only" for={`${id}-query`}>Search Stay Current</label>
      <input id={`${id}-query`} data-query name="q" type="search" placeholder="Search ideas, technologies, questions…" autocomplete="off" enterkeyhint="search" spellcheck="false" aria-describedby={`${id}-help`} />
      <button class="search-icon-button" data-clear type="button" aria-label="Clear search" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
      {modal && <button class="search-close" type="button" data-close aria-label="Close search"><kbd>Esc</kbd></button>}
      <button class="search-sr-only" type="submit" tabindex="-1">Search</button>
    </div>
    <div class="search-filter-bar" role="group" aria-label="Content type">
      {filters.map(([value, label]) => <button type="button" data-kind={value} aria-pressed={value === '' ? 'true' : 'false'}>{label}</button>)}
    </div>
  </form>
  <div class="search-content">
    <div data-start>
      <section class="search-recents" data-recents hidden>
        <div class="search-section-label"><h2>Recent searches</h2><button type="button" data-forget>Clear history</button></div>
        <div data-recent-list class="search-topic-list"></div>
      </section>
      <section class="search-topics">
        <div class="search-section-label"><h2>Try a topic</h2><span>{reading.length} articles, guides & playgrounds</span></div>
        <div class="search-topic-list">
          {['Indexes', 'Transactions', 'Recovery', 'Amazon S3', 'Query performance'].map(topic => <a data-suggestion={topic} href={`/search/?q=${encodeURIComponent(topic)}`}>{topic}<span aria-hidden="true">↗</span></a>)}
        </div>
      </section>
      <section class="search-collections">
        <div class="search-section-label"><h2>Explore a collection</h2></div>
        <div class="search-collection-grid">
          <a href="/learn/databases/relational/" class="search-collection-card">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 10h18M9 10v10M15 10v10M3 15h18"/></svg>
            <strong>Relational databases</strong><span>Tables, queries and reliable changes.</span><span class="collection-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="/learn/databases/object-storage/" class="search-collection-card">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m12 3 9 5v9l-9 5-9-5V8l9-5Zm0 10 9-5M12 13 3 8m9 5v9"/></svg>
            <strong>Object storage</strong><span>Objects, requests and application design.</span><span class="collection-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </div>
    <div class="search-results-heading" data-results-heading hidden><p data-status role="status" aria-live="polite" aria-atomic="true"></p><span data-ranking>Best matches</span></div>
    <div data-output aria-busy="false">
      <ol class="search-results" data-results></ol>
      <div class="search-empty" data-empty hidden>
        <span class="empty-search-icon" aria-hidden="true">↗</span><h2>No matches found</h2><p>Try fewer words, another spelling or a different content type.</p><button type="button" data-reset-filters hidden>Search all content</button>
      </div>
      <button class="search-load-more" data-more type="button" hidden>Show more results <span aria-hidden="true">↓</span></button>
    </div>
  </div>
  <div class="search-panel-footer" id={`${id}-help`}><span class="search-keyboard-help"><kbd>↑</kbd><kbd>↓</kbd> navigate <kbd>↵</kbd> open{modal && <><kbd>esc</kbd> close</>}</span><a data-full-search={modal ? true : undefined} href={modal ? "/search/" : "/articles/"}>{modal ? "Open full search" : "Browse the library"} <span aria-hidden="true">↗</span></a></div>
  <noscript><p class="search-noscript">Search needs JavaScript. <a href="/articles/">Browse all articles</a> instead.</p></noscript>
</search-panel>
<script>
  import '../../scripts/site-search';
</script>
