---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import RelationalDraftNavigation from '../components/editorial/RelationalDraftNavigation.astro';
import RelationalDraftMap from '../components/editorial/RelationalDraftMap.astro';
import { relationalDraftHref, relationalDraftLinks, type RelationalDraftState } from '../lib/relational-draft-20261024';
import '../styles/explorables.css';

interface Props { entry: RelationalDraftState; entries: RelationalDraftState[]; isolated?: boolean }
const { entry, entries, isolated = false } = Astro.props;
const linked = relationalDraftLinks(await Astro.slots.render('default'), entries);
// Astro's development routes use trailing slashes; built endpoints are plain files.
const html = linked.replace(/href="(\/review\/relational-collection\/evidence\/[^"?#]+?)\/?"/g,
  (_, path) => `href="${path}${import.meta.env.DEV ? '/' : ''}"`);
const sources = [...html.matchAll(/<h2\b[^>]*>\s*Sources and further reading\s*<\/h2>/gi)].at(-1);
const beforeSources = sources ? html.slice(0, sources.index) : html;
const afterSources = sources ? html.slice(sources.index! + sources[0].length) : '';
// Keep a dedicated sources section balanced when moving it into the disclosure.
const sourceSection = beforeSources.match(/<section\b[^>]*>\s*$/i);
const sourceSectionEnd = afterSources.match(/<\/section>\s*$/i);
const wrappedSources = sources && sourceSection && sourceSectionEnd;
const body = wrappedSources ? beforeSources.slice(0, sourceSection.index) : beforeSources;
const sourceContent = wrappedSources ? afterSources.slice(0, sourceSectionEnd.index) : afterSources;
const available = entries.filter(item => item.status === 'draft');
const index = available.findIndex(item => item.key === entry.key);
const previous = index > 0 ? available[index - 1] : undefined;
const next = index >= 0 ? available[index + 1] : undefined;
const title = isolated ? `${entry.title} — figures` : entry.title;
---
<Base title={title} description={entry.description} readingPath="/">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="relational-draft" data-pagefind-ignore="all">
    <RelationalDraftNavigation entry={entry} entries={entries} />
    <article class="visual-essay">
      <header class="essay-header">
        <p class="eyebrow">Relational collection · Draft for review</p>
        <h1>{title}</h1>
        <TitleLine type={entry.slug ? 'Deep dive' : 'Introduction'} />
        {isolated && <p><a href={relationalDraftHref(entry.slug)}>Read the article →</a></p>}
      </header>
      {isolated
        ? <div class="isolated-figures"><Fragment set:html={body} /></div>
        : <ArticleBody><Fragment set:html={body} /></ArticleBody>}
      {!isolated && <RelationalDraftMap entry={entry} entries={entries} />}
    </article>
    {!isolated && (previous || next) && <nav class:list={['collection-pager', { single: !previous || !next }]} aria-label="Previous and next in this draft collection">
      {previous && <a class="previous" href={relationalDraftHref(previous.slug)}><span class="pager-label">Previous</span><span class="pager-title">{previous.title}</span></a>}
      {next && <a class="next" href={relationalDraftHref(next.slug)}><span class="pager-label">Next</span><span class="pager-title">{next.title}</span></a>}
    </nav>}
    {!isolated && sources && <details class="article-sources">
      <summary><Fragment set:html={sources[0]} /></summary>
      <div class="source-content"><Fragment set:html={sourceContent} /></div>
    </details>}
  </div>
</Base>
<style>
  .visual-essay .essay-header { margin:1.75rem 0 2rem; }
  .essay-header .eyebrow { font-size:.625rem; letter-spacing:.1em; }
  .collection-pager { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:1rem; margin:1.25rem 0 0; font:.9rem/1.5 var(--font-sans); }
  .collection-pager a { display:grid; gap:.2rem; padding:.85rem 1rem; border-radius:.35rem; background:var(--color-surface-alt); text-decoration:none; }
  .collection-pager a:hover .pager-title { text-decoration:underline; }
  .pager-label { font-size:.65rem; letter-spacing:.06em; text-transform:uppercase; color:var(--color-text-secondary); }
  .pager-title { overflow-wrap:anywhere; }
  .previous .pager-label::before { content:'← '; }
  .next { text-align:right; }
  .next .pager-label::after { content:' →'; }
  .single { grid-template-columns:minmax(0,1fr); }
  .single a { grid-template-columns:auto minmax(0,1fr); align-items:baseline; gap:1rem; text-align:left; }
  .article-sources { margin-top:1.25rem; border-top:1px solid var(--color-rule); color:var(--color-text-secondary); font:.85rem/1.7 var(--font-sans); }
  .article-sources summary { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.85rem 0; list-style:none; cursor:pointer; }
  summary::-webkit-details-marker { display:none; }
  .article-sources summary::after { content:''; flex:none; width:.4rem; height:.4rem; margin-right:.15rem; border-right:1.5px solid var(--color-text-secondary); border-bottom:1.5px solid var(--color-text-secondary); transform:rotate(-45deg); }
  details[open] > summary::after { transform:rotate(45deg); }
  summary :global(h2) { display:inline; margin:0; padding:0; color:var(--color-text-secondary); font:500 .85rem/1.5 var(--font-sans); }
  summary:focus-visible, .collection-pager a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  .source-content { max-width:62ch; padding:.5rem 0 .25rem; overflow-wrap:anywhere; }
  .source-content :global(p) { margin:0 0 1.25rem; }
  .source-content :global(ul) { padding-left:1.1rem; }
  .source-content :global(li) { margin-bottom:.85rem; padding-left:.15rem; }
  .isolated-figures :global(:is(p,h2,h3,h4,nav,aside):not(figure *)), .isolated-figures :global(.essay-sources) { display:none; }
  @media(max-width:540px) { .collection-pager { grid-template-columns:minmax(0,1fr); } .next { text-align:left; } .single a { grid-template-columns:minmax(0,1fr); gap:.2rem; } }
  @media print { .collection-pager { display:none; } }
</style>
