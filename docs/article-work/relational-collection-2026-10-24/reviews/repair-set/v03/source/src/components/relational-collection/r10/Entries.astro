---
import core from '../../../lib/relational-collection/core.json';
const entries = core.orders.map((o,i)=>({...o,location:`page ${i}, item 1`}));
---
<figure class="entry-figure" data-entry-figure aria-labelledby="r10-entry-title">
 <figcaption id="r10-entry-title"><span>Figure 1</span> Values in order, rows wherever they fit</figcaption>
 <div class="entry-layout">
  <div><p class="panel-label">Orders table · illustrative pages</p>{entries.map(o=><div class="entry-row" data-order={o.order_id}><strong>{o.order_id}</strong><span>customer {o.customer_id}</span><small>{o.location}</small></div>)}</div>
  <div><p class="panel-label">Index · customer_id → row location</p><div class="index-rows">{entries.map(o=><div class="entry-row" data-index={o.order_id}><strong>{o.customer_id}</strong><span>→ {o.location}</span></div>)}</div></div>
 </div>
 <p data-explanation data-live aria-live="polite">The table has no customer order. Its three rows stay where they are.</p>
 <div class="controls" role="group" aria-label="Figure 1 controls"><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step></span><div data-hold><span></span></div></div>
 <p class="caption">The shop’s three core orders, with invented page locations. This drawing makes each row a separate page so the references stay visible; it is not a PostgreSQL page measurement. Each index entry contains a customer ID and a row location. The order ID is read from the table row at that location.</p>
</figure>
<script>
 import { stepper } from '../../figures/stepper.mjs';
 document.querySelectorAll<HTMLElement>('[data-entry-figure]').forEach(root=>{
 const explanations=['The table has no customer order. Its three rows stay where they are.','Copy each customer ID with a location that leads back to its order row.','Sort the entries by customer ID. Mina’s two entries sit together, although her rows remain apart.','Find customer 1 in the index, then fetch the rows at both locations to read orders 101 and 103.'];
 stepper(root,{steps:()=>4,draw:(s:number)=>{
 const nodes=[...root.querySelectorAll<HTMLElement>('[data-index]')];nodes.sort((a,b)=>s>=2?(({101:0,103:1,102:2}[Number(a.dataset.index)]??0)-({101:0,103:1,102:2}[Number(b.dataset.index)]??0)):Number(a.dataset.index)-Number(b.dataset.index));root.querySelector('.index-rows')!.append(...nodes);
 root.querySelectorAll<HTMLElement>('[data-index]').forEach(x=>{x.style.visibility=s===0?'hidden':'visible';x.classList.toggle('chosen',s===3&&x.dataset.index!=='102');});
 root.querySelectorAll<HTMLElement>('[data-order]').forEach(x=>x.classList.toggle('chosen',s===3&&x.dataset.order!=='102'));
 root.querySelector<HTMLElement>('[data-explanation]')!.textContent=explanations[s];
 }});
 });
</script>
<style>
 .entry-figure{margin:2rem 0;padding:1rem;border:1px solid var(--color-rule-strong);background:var(--color-surface-alt);font: .9rem/1.5 var(--font-sans)}
 figcaption{font-family:var(--font-serif);font-size:1.2rem;margin-bottom:1rem}figcaption span{font: .75rem var(--font-sans);text-transform:uppercase;margin-right:.7rem;color:var(--color-text-secondary)}
 .index-rows{display:flex;flex-direction:column}.entry-layout{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}.panel-label{font-weight:600;margin:0 0 .7rem}.entry-row{display:grid;grid-template-columns:3rem 1fr;gap:.3rem;padding:.65rem;border:1px solid var(--color-rule-strong);margin:.5rem 0;background:var(--color-surface)}.entry-row small{grid-column:2;color:var(--color-text-secondary)}.chosen{outline:2px solid var(--color-accent);outline-offset:-2px}.controls{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center}button{font:inherit;padding:.45rem .65rem;border:1px solid var(--color-text-secondary);border-radius:.25rem;background:var(--color-surface);color:var(--color-text);cursor:pointer}button:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}button[aria-disabled=true]{opacity:.5}.caption{color:var(--color-text-secondary);font-size:.82rem}[data-explanation]{border-left:3px solid var(--color-accent);padding-left:.8rem;min-height:4.5em}[data-hold]{width:100%;height:3px;background:var(--color-rule)}[data-hold] span{display:block;height:100%;background:var(--color-accent);width:0}@media(max-width:520px){.entry-layout{grid-template-columns:1fr;gap:.8rem}.entry-row{grid-template-columns:3rem 1fr}}
</style>
