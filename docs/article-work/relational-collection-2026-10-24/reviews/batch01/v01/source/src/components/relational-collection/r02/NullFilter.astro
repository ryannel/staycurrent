---
import variant from '../../../lib/relational-collection/values.json';
import { choices, evaluate, truthLabel } from './predicates.mjs';
const first = choices[0];
---
<figure class="value-filter" aria-labelledby="notes-title" data-null-filter>
  <figcaption id="notes-title"><span>Figure 2</span> Which notes pass the condition?</figcaption>
  <div class="filter-body">
    <p class="variant">Illustrative delivery-note variant · the same three orders</p>
    <fieldset><legend>Choose the condition (<code>note</code> means <code>delivery_note</code>)</legend>
      <div class="conditions">{choices.map((choice, i) => <label><input type="radio" name="note-predicate" value={choice.id} checked={i === 0} /><code>{choice.label}</code></label>)}</div>
    </fieldset>
    <pre class="query"><code>SELECT order_id FROM delivery_notes<br />WHERE <span data-predicate>{first.sql}</span>;</code></pre>
    <div class="filter-rows" role="table" aria-label="Each stored value, its predicate result and whether WHERE keeps the row">
      <div class="filter-head" role="row"><span role="columnheader">Order / stored note</span><span role="columnheader">Condition</span><span role="columnheader">WHERE</span></div>
      {variant.orders.map(row => {
        const result = evaluate(first.id, row.delivery_note);
        return <div class="filter-row" role="row" data-row data-value={JSON.stringify(row.delivery_note)} data-order={row.order_id} data-result={truthLabel(result)}>
          <span role="cell"><b>{row.order_id}</b><code>{row.delivery_note === null ? 'NULL' : row.delivery_note === '' ? "''" : `'${row.delivery_note}'`}</code><small>{row.delivery_note === null ? 'No text value' : row.delivery_note === '' ? 'Empty text' : 'Known non-empty text'}</small></span>
          <span role="cell" class="truth" data-truth>{truthLabel(result)}</span>
          <span role="cell" class="verdict" data-verdict>{result === true ? '✓ keep' : '× discard'}</span>
        </div>;
      })}
    </div>
    <p class="result" aria-live="polite" aria-atomic="true"><b data-answer>Result: order 102.</b> <span data-explanation>{first.explain}</span></p>
  </div>
  <p class="caption">Every row stays visible so you can compare false with unknown. Both are discarded by <code>WHERE</code>; only true passes. The controls illustrate PostgreSQL’s documented logic and do not send a query to a database.</p>
  <details><summary>All conditions, as text</summary><ul>{choices.map(choice => <li><code>{choice.sql}</code>: {variant.orders.filter(row => evaluate(choice.id, row.delivery_note) === true).length === 1 ? 'order' : 'orders'} {variant.orders.filter(row => evaluate(choice.id, row.delivery_note) === true).map(row => row.order_id).join(' and ')}. {choice.explain}</li>)}</ul></details>
</figure>
<script>
  import { choices, evaluate, truthLabel } from './predicates.mjs';
  document.querySelectorAll<HTMLElement>('[data-null-filter]').forEach(root => {
    root.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(input => input.addEventListener('change', () => {
      const choice = choices.find(item => item.id === input.value)!;
      root.querySelector('[data-predicate]')!.textContent = choice.sql;
      const selected: string[] = [];
      root.querySelectorAll<HTMLElement>('[data-row]').forEach(row => {
        const result = evaluate(choice.id, JSON.parse(row.dataset.value!));
        row.dataset.result = truthLabel(result);
        row.querySelector('[data-truth]')!.textContent = truthLabel(result);
        row.querySelector('[data-verdict]')!.textContent = result === true ? '✓ keep' : '× discard';
        if (result === true) selected.push(row.dataset.order!);
      });
      root.querySelector('[data-answer]')!.textContent = `Result: ${selected.length === 1 ? 'order' : 'orders'} ${selected.join(' and ')}.`;
      root.querySelector('[data-explanation]')!.textContent = choice.explain;
    }));
  });
</script>
<style>
  .value-filter{margin:2.5rem 0;color:var(--color-text);font-family:var(--font-sans)}
  figcaption{font:1.2rem/1.4 var(--font-serif);margin-bottom:.75rem}figcaption>span{font:.72rem/1.4 var(--font-sans);text-transform:uppercase;letter-spacing:.08em;margin-right:.5rem;color:var(--color-text-secondary)}
  .filter-body{border:1px solid var(--color-text-secondary);padding:1rem;background:var(--color-surface-alt)}
  .variant{font:.76rem/1.5 var(--font-sans);color:var(--color-text-secondary);margin:0 0 1rem}
  fieldset{border:0;padding:0;margin:0 0 1rem;min-width:0}legend{font:.82rem/1.6 var(--font-sans);margin-bottom:.5rem}
  .conditions{display:flex;gap:.45rem;flex-wrap:wrap}.conditions label{display:flex;align-items:center;gap:.4rem;border:1px solid var(--color-text-secondary);padding:.5rem .65rem;cursor:pointer;font-size:.83rem;border-radius:3px;min-height:2.5rem}.conditions label:has(input:checked){outline:2px solid var(--color-accent);outline-offset:1px;background:var(--color-surface)}
  input{accent-color:var(--color-accent);flex-shrink:0}.conditions label:focus-within{outline:3px solid var(--color-accent);outline-offset:2px}code{background:transparent;padding:0;font-size:.85em}.conditions code{font-size:1em;overflow-wrap:anywhere}
  .query{white-space:pre-wrap;overflow-wrap:anywhere;margin:.5rem 0 1.25rem;background:var(--color-surface)!important;border-left:3px solid var(--color-accent);border-radius:0;padding:.8rem;font:.85rem/1.7 var(--font-mono)}
  .filter-head,.filter-row{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(0,.8fr) minmax(0,.8fr);gap:.7rem;align-items:center;padding:.8rem 0;border-bottom:1px solid var(--color-text-secondary)}.filter-head{font-size:.75rem;color:var(--color-text-secondary);padding:.5rem 0}.filter-row{font-size:.85rem}.filter-row b{display:block;font-size:.85rem}.filter-row code{display:block;margin:.25rem 0;overflow-wrap:anywhere;font-size:.85rem}.filter-row small{display:block;font-size:.72rem;color:var(--color-text-secondary)}.truth{font:600 .8rem/1.5 var(--font-mono)}.verdict{font-size:.8rem}
  [data-result=true] .truth,[data-result=true] .verdict{color:var(--color-accent-strong);font-weight:700}.result{border-left:3px solid var(--color-accent);padding:.4rem 0 .4rem .75rem;margin:1.2rem 0 0;font:.86rem/1.7 var(--font-sans);min-height:6rem}.result b{display:block}.caption,details{font:.8rem/1.7 var(--font-sans);color:var(--color-text-secondary);margin:.75rem 0}.caption code,details code{font-size:.9em}summary{cursor:pointer;color:var(--color-accent)}
  @media(max-width:450px){.filter-body{padding:.75rem}.filter-head,.filter-row{grid-template-columns:minmax(0,1.5fr) minmax(0,.85fr) minmax(0,.8fr);gap:.4rem}.truth,.verdict{font-size:.73rem}.filter-row code{font-size:.76rem}.conditions label{width:100%;box-sizing:border-box}.result{min-height:8rem}}
</style>
