---
interface Props { inline?: boolean }
const { inline = false } = Astro.props;
const Tag = inline ? 'span' : 'p';
---

<Tag class:list={['ai-text-disclosure', { inline }]} data-pagefind-ignore>
  <a href="/how-this-is-made/">AI-generated</a>
</Tag>

<style>
  .ai-text-disclosure { margin: .4rem 0 1rem; font: .8rem/1.5 var(--font-sans); }
  .ai-text-disclosure.inline { margin: 0; font: inherit; }
  .ai-text-disclosure a { color: var(--color-text-secondary); text-underline-offset: .18em; }
  .ai-text-disclosure a:hover { color: var(--color-accent); }
</style>
