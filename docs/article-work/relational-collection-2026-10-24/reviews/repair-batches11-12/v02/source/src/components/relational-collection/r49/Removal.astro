<figure class="removal" aria-labelledby="removal-title">
 <figcaption id="removal-title"><span>Figure 1</span> Remove a replica only after its replacement can vote</figcaption>
 <div class="board paper-surface">
  <p class="budget" data-live data-budget></p>
  <div class="nodes" role="img" aria-label="One range across four illustrative nodes; each card identifies its current voting state">
   {['A','B','C','D'].map(n=><div class="node"><strong>Node {n}</strong><p data-live data-node={n}></p></div>)}
  </div>
  <p data-live data-explanation aria-live="polite"></p>
 </div>
 <div class="controls" role="group" aria-label="Replica removal controls"><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step></span></div>
 <div data-hold aria-hidden="true"><span></span></div>
 <details><summary>Drawing as text</summary><ol><li>A, B and C vote; D is an eligible destination.</li><li>Copy the range to D while A remains available.</li><li>D catches up and joins the voting configuration; the drawing omits intermediate membership configurations.</li><li>Remove A after the handover. B, C and D provide three voters.</li><li>If B now fails, C and D can still form a majority; no further voter can fail before repair.</li></ol></details>
 <p class="caption">A conceptual handover for one three-voter range. Actual CockroachDB placement, membership transitions and headroom must be inspected for every affected range. Four local processes do not establish four independent failure domains.</p>
</figure>
<script>
 import {stepper} from '../../figures/stepper.mjs';
 const root=document.querySelector('.removal');
 const states=[
  {nodes:['Voter','Voter','Voter','Eligible; no copy'],budget:'3 available voters · majority 2 · one voter may fail',text:'A is still serving a replica. D needs eligible capacity before A can leave.'},
  {nodes:['Voter','Voter','Voter','Copying; not a voter'],budget:'3 available voters · copying is extra work',text:'A remains available while D receives data. An unfinished copy contributes no vote.'},
  {nodes:['Handover','Voter','Voter','Caught up'],budget:'Membership change · verify completion',text:'The range changes membership through its protocol. This drawing does not count a copying replica as a completed replacement.'},
  {nodes:['Removed','Voter','Voter','Voter'],budget:'3 available voters · majority 2 · one voter may fail',text:'A has left the replica set. B, C and D supply the intended three voters; inspect actual placement before stopping A.'},
  {nodes:['Removed','Unavailable','Voter','Voter'],budget:'2 available of 3 voters · majority 2 · no further voter may fail',text:'The range remains available through C and D, but it has spent its next-failure budget. Repair before another planned stop.'}
 ];
 if(root)stepper(root,{steps:()=>states.length,draw:i=>{const s=states[i];root.querySelector('[data-budget]').textContent=s.budget;root.querySelector('[data-explanation]').textContent=s.text;root.querySelectorAll('[data-node]').forEach((e,j)=>{e.textContent=s.nodes[j];e.parentElement.dataset.state=s.nodes[j]});}});
</script>
<style>
 .removal{margin:2.5rem 0}.removal figcaption{font-size:1.15rem;margin-bottom:.65rem}.removal figcaption span{font: .75rem var(--font-mono,monospace);text-transform:uppercase;margin-right:.6rem}.board{border:1px solid var(--color-border);padding:1rem}.nodes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;margin:1.2rem 0}.node{border:1px solid var(--color-text);padding:.7rem .4rem;min-width:0}.node strong{font-size:.95rem}.node p{font-size:.85rem;margin:.5rem 0;min-height:3.6em}.node[data-state="Voter"]{border-color:var(--teal);background:var(--paper-match)}.budget{font-weight:600}.controls{display:flex;gap:.45rem;flex-wrap:wrap;padding:.8rem 0;align-items:center}.controls button{font:inherit;padding:.5rem .75rem;border:1px solid var(--color-text);background:var(--color-bg);color:var(--color-text);border-radius:.25rem;cursor:pointer}.controls button:focus-visible{outline:3px solid var(--teal);outline-offset:2px}.controls [aria-disabled="true"]{opacity:.55}[data-hold]{height:3px;background:var(--color-border)}[data-hold] span{display:block;height:100%;background:var(--teal);width:0}.caption{font-size:.9rem}.removal details{margin:.7rem 0}@media(max-width:500px){.nodes{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
