---
import './figures.css';
import { customers, orders } from './shop.mjs';
---
<div class="rf-figure" data-rf-customers>
 <figure aria-labelledby="rf-customers-title">
  <div class="rf-head"><span class="rf-number">Figure 1</span><p class="rf-name" id="rf-customers-title">One customer, several orders</p></div>
  <div class="rf-board">
   <div class="rf-tables">
    <div class="rf-table"><table><caption>customers</caption><thead><tr><th scope="col">customer_id</th><th scope="col">name</th></tr></thead><tbody>
     {customers.map(c => <tr data-customer={c.id} data-match={c.id === 1 ? 'true' : undefined}><td><strong>{c.id}</strong></td><td>{c.name}</td></tr>)}
    </tbody></table></div>
    <div class="rf-table"><table><caption>orders <span class="rf-state-note">(date omitted)</span></caption><thead><tr><th scope="col">order_id</th><th scope="col">customer_id</th><th scope="col">status</th></tr></thead><tbody>
     {orders.map(o => <tr data-order-customer={o.customer} data-match={o.customer === 1 ? 'true' : undefined}><td><strong>{o.id}</strong></td><td>{o.customer}</td><td>{o.status}</td></tr>)}
    </tbody></table></div>
   </div>
   <p class="rf-connection"><code>orders.customer_id → customers.customer_id</code><br />The value on each order identifies its customer.</p>
   <p class="rf-explanation" data-customer-explanation aria-live="polite">Customer 1 is Mina Shah. Both order 101 and order 103 carry customer_id 1, so both belong to her. Her name is stored once.</p>
  </div>
  <div class="rf-controls rf-js-controls"><fieldset class="rf-options"><legend>Follow a customer</legend>
   {customers.map(c => <button type="button" data-pick-customer={c.id} aria-pressed={c.id === 1 ? 'true' : 'false'}>{c.name.split(' ')[0]}</button>)}
  </fieldset></div>
  <figcaption>Three customers and three orders. Matching ID values connect the rows; their positions on the page do not. Choose Edda to see that a customer can exist without an order.</figcaption>
 </figure>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-rf-customers]').forEach(root => {
  const messages = {
   1: 'Customer 1 is Mina Shah. Both order 101 and order 103 carry customer_id 1, so both belong to her. Her name is stored once.',
   2: 'Customer 2 is Tariq Aziz. Order 102 carries customer_id 2, so it belongs to him. Mina’s orders carry a different value.',
   3: 'Customer 3 is Edda Berg. No order carries customer_id 3. Her customer row still exists; the relationship permits zero orders.',
  };
  root.querySelectorAll<HTMLButtonElement>('[data-pick-customer]').forEach(button => button.addEventListener('click', () => {
   const id = Number(button.dataset.pickCustomer);
   root.querySelectorAll<HTMLElement>('[data-customer]').forEach(row => row.dataset.match = String(Number(row.dataset.customer) === id));
   root.querySelectorAll<HTMLElement>('[data-order-customer]').forEach(row => row.dataset.match = String(Number(row.dataset.orderCustomer) === id));
   root.querySelectorAll<HTMLButtonElement>('[data-pick-customer]').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
   root.querySelector('[data-customer-explanation]')!.textContent = messages[id];
  }));
  root.dataset.ready = 'true';
 });
</script>
