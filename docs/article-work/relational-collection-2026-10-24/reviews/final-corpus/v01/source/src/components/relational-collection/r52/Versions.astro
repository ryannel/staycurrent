<figure class="versions" aria-labelledby="versions-title"><figcaption id="versions-title">Figure 1 · A new binary is not a finalised cluster</figcaption><div class="paper-surface version-board"><div class="binaries">{['A','B','C'].map(n=><div><strong>Node {n}</strong><p data-live data-build></p></div>)}</div><p data-live data-cluster></p><p class="return" data-live data-return></p><p data-live data-explanation aria-live="polite"></p></div><div class="transport" role="group" aria-label="Upgrade illustration controls"><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step></span></div><div data-hold aria-hidden="true"><span></span></div><details><summary>Upgrade states as text</summary><ol><li>All binaries 25.3; cluster version 25.3. Automatic finalisation disabled before rollout.</li><li>C uses 25.4; A and B use 25.3. Cluster version remains 25.3.</li><li>C returns to 25.3 before finalisation, using the supported rollback path.</li><li>All binaries 25.4; cluster version still 25.3. Application acceptance precedes finalisation.</li><li>Begin finalisation to 25.4. Returning to 25.3 binaries is no longer a supported rollback.</li><li>Finalisation completes. Verify cluster version 25.4 and migration jobs, then accept the service.</li></ol></details><p class="caption">Conceptual major-version transition based on the documented procedure. Labels omit patch numbers so the two kinds of version remain visible. Native capability and licence checks are reported separately; this player does not execute an upgrade.</p></figure>
<script>
import {stepper} from '../../figures/stepper.mjs';const root=document.querySelector('.versions');const states=[
[['25.3','25.3','25.3'],'Cluster version 25.3','Return: original binaries','Disable automatic finalisation and verify its setting before any node receives a new binary.'],
[['25.3','25.3','25.4'],'Cluster version 25.3','Return: supported pre-finalisation binary rollback','C has rejoined using the new binary. Keep testing the actual mixed population and check replica health before another restart.'],
[['25.3','25.3','25.3'],'Cluster version 25.3','Return rehearsed before finalisation','The new node has been drained and restarted with the earlier supported binary. This is a rehearsal of the return path.'],
[['25.4','25.4','25.4'],'Cluster version 25.3','Return still depends on preserving this boundary','Every node runs the new binary, but the compatibility version has not advanced. Complete application and operational acceptance now.'],
[['25.4','25.4','25.4'],'Cluster version: finalising to 25.4','Return: prior-major binary rollback unavailable','Finalisation runs irreversible migrations. The return boundary is crossed when finalisation begins, not only when its final status appears.'],
[['25.4','25.4','25.4'],'Cluster version 25.4','Recovery: forward repair or a tested restore/reconciliation route','Verify the version and migration jobs, then the application. A saved old executable cannot read its way back through the completed transition.']];if(root)stepper(root,{steps:()=>states.length,draw:i=>{let s=states[i];root.querySelectorAll('[data-build]').forEach((e,j)=>e.textContent=s[0][j]);root.querySelector('[data-cluster]').textContent=s[1].replace(/version(?=\d)/,'version ').replace('to 25.4','to 25.4');root.querySelector('[data-return]').textContent=s[2];root.querySelector('[data-explanation]').textContent=s[3];}});
</script>
<style>
.versions{margin:2.5rem 0}.versions figcaption{font-size:1.15rem;margin-bottom:.7rem}.version-board{padding:1rem}.binaries{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.binaries>div{border:1px solid var(--color-text);padding:.7rem}.binaries p{font:1.2rem var(--font-mono,monospace);margin:.7rem 0}.return{border-left:3px solid var(--teal);padding-left:.7rem}.transport{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin:.8rem 0}.transport button{font:inherit;color:var(--color-text);background:transparent;border:1px solid currentColor;border-radius:.25rem;padding:.5rem .75rem;cursor:pointer}.transport button:focus-visible{outline:3px solid var(--teal);outline-offset:2px}.transport [aria-disabled="true"]{opacity:.55}[data-hold]{height:3px}[data-hold] span{height:100%;display:block;width:0;background:var(--teal)}.caption{font-size:.9rem}.versions details{margin:.8rem 0}@media(max-width:500px){.binaries{gap:.4rem}.binaries>div{padding:.5rem}.binaries strong{font-size:.85rem}}
</style>
