<figure class="guard" data-r14-guard aria-labelledby="r14-guard-title">
  <figcaption id="r14-guard-title"><span>Figure 1</span> A turn at the guard, and a view of the bookings</figcaption>
  <div class="choice"><label for="r14-protocol">Protocol</label><select id="r14-protocol"><option value="rc">Lock guard · Read Committed</option><option value="rr">Lock guard · Repeatable Read</option><option value="update">Update guard · Repeatable Read</option></select></div>
  <div class="scene">
    <div class="authority"><small>Session S501 · capacity 1</small><strong data-live data-guard>Guard is free</strong><span data-live data-bookings>Committed bookings: none</span></div>
    <div class="buyers"><div><p class="person">Mina · B201</p><strong data-live data-mina>Ready to book</strong><span data-live data-minaview>Will count after acquiring the guard</span></div><div><p class="person">Tariq · B202</p><strong data-live data-tariq>Ready to book</strong><span data-live data-view>Each count gets a new snapshot</span></div></div>
    <p class="explanation" data-live data-explanation aria-live="polite">Both buyers need the same guard. The committed booking set starts empty.</p>
  </div>
  <div class="controls"><button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><output data-step>1 / 5</output><div data-hold aria-hidden="true"><span></span></div></div>
  <p class="caption">A chosen schedule, not a database running in your browser. In the Repeatable Read cases Tariq establishes his snapshot before Mina commits. Both writers use the selected guard protocol.</p>
  <details><summary>The schedules as text</summary><p>Read Committed: Mina locks S501 and counts zero. Tariq waits for S501. Mina inserts B201 and commits. Tariq acquires S501, then starts a separate count statement; it sees B201 and refuses B202.</p><p>Repeatable Read with a lock only: Tariq first establishes an empty snapshot. Mina locks S501 and Tariq waits. Mina inserts B201 and commits without updating S501. Tariq acquires S501, but his count still sees zero. Inserting B202 overbooks the class.</p><p>Repeatable Read with an update: Tariq first establishes an empty snapshot. Mina updates S501's guard_epoch; Tariq's conflicting update waits. Mina inserts B201 and commits. Tariq receives 40001, rolls back and starts the whole operation again. The new attempt counts B201 and refuses B202.</p></details>
</figure>
<script>
import {stepper} from '../../figures/stepper.mjs';
for (const root of document.querySelectorAll('[data-r14-guard]')) {
 const select=root.querySelector('select');
 const common=[['Mina holds S501','none','Has the guard','Ready to count under guard','Waiting for S501'],['Mina holds S501','none','B201 inserted, uncommitted','Counts 0','Waiting for S501']];
 const player=stepper(root,{steps:()=>5,draw(step){
  const mode=select.value;
  let guard='Guard is free', bookings='none', mina='Ready to book', mv='Will count after acquiring the guard', tariq='Ready to book', view=mode==='rc'?'Each count gets a new snapshot':'Snapshot established: no bookings', note='Both buyers need the same guard. The committed booking set starts empty.';
  if(step===1||step===2){[guard,bookings,mina,mv,tariq]=common[step-1]; if(mode==='update')guard='Mina updated S501'; note=step===1?'Mina acquires S501. Tariq asks for the same guard and waits. The empty booking set is not the lockable authority.':'Mina counts zero and inserts B201. The booking remains uncommitted, and she keeps the guard.';}
  if(step>=3){mina='B201 committed';mv='One booking admitted';bookings='B201';guard=mode==='update'?'Guard is free':'Tariq holds S501';tariq=mode==='update'?'40001 · attempt aborted':'Acquires the guard';view=mode==='rc'?'Next statement can see B201':'Old snapshot still has no bookings';note=mode==='update'?'Mina changed the guard row. Tariq cannot update that newer row through his old Repeatable Read snapshot; this attempt must roll back.':'Mina commits and releases S501. Tariq can now take his turn. Acquiring a lock and refreshing a snapshot are separate things.';}
  if(step===4){guard='Guard is free';if(mode==='rc'){tariq='Counts 1 · refuses B202';view='Fresh count includes B201';note='The separate count starts after Tariq acquires S501. Read Committed gives it a new snapshot containing Mina’s booking.';}else if(mode==='rr'){tariq='Counts 0 · commits B202';view='Old count excludes B201';bookings='B201 + B202 · exceeds capacity';note='Waiting did not refresh Tariq’s snapshot. The lock-only protocol let him admit a second booking against capacity 1.';}else{tariq='Retries · counts 1 · refuses B202';view='New transaction includes B201';note='Tariq rolls back and restarts the complete protocol. Its new snapshot includes B201, so B202 is refused.';}}
  for(const [key,val] of Object.entries({guard,bookings:'Committed bookings: '+bookings,mina,minaview:mv,tariq,view,explanation:note}))root.querySelector('[data-'+key+']').textContent=val;
 }});
 select.addEventListener('change',()=>player.render());
}
</script>
<style>
.guard{margin:2rem 0;font:.95rem/1.5 var(--font-sans)}figcaption{font:1.2rem/1.4 var(--font-serif);margin-bottom:1rem}figcaption>span{font:.75rem var(--font-sans);text-transform:uppercase;color:var(--color-text-secondary);margin-right:.6rem}.choice{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;padding:.8rem;border:1px solid var(--color-text-secondary)}select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-accent);border-radius:4px;padding:.5rem .65rem}select{max-width:100%}.scene{padding:1rem;border:1px solid var(--color-text-secondary);border-top:0}.authority{border:2px solid var(--color-accent);padding:.8rem;display:grid;gap:.35rem}.authority small{color:var(--color-text-secondary)}.buyers{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.buyers>div{border-left:3px solid var(--color-text-secondary);padding-left:.8rem;display:grid;align-content:start;gap:.4rem;min-height:9rem}.person{font:600 1rem var(--font-sans);margin:0}.buyers span{color:var(--color-text-secondary)}.explanation{border-left:3px solid var(--color-accent);padding-left:.8rem;min-height:5.5rem;margin:1.1rem 0 0}.controls{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;padding:.8rem;border:1px solid var(--color-text-secondary);border-top:0}button{cursor:pointer}button[aria-disabled=true]{opacity:.55}output{margin-left:auto}[data-hold]{width:100%;height:3px;background:var(--color-surface-alt)}[data-hold] span{display:block;height:100%;background:var(--color-accent);width:0}.caption{font-size:.85rem;color:var(--color-text-secondary)}details{font-size:.9rem}summary{cursor:pointer;color:var(--color-accent)}@media(max-width:500px){.buyers{grid-template-columns:1fr}.buyers>div{min-height:0}.explanation{min-height:0}select{font-size:.85rem}.scene{padding:.75rem}}
</style>
