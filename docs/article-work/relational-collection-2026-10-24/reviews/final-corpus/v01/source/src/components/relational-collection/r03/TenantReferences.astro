---
import core from '../../../lib/relational-collection/core.json';
const order = core.orders.find(row => row.order_id === 103)!;
const product = core.products.find(row => row.product_id === 'P7')!;
const facts = {
  order: { shop_id: 10, order_id: order.order_id },
  products: [
    { shop_id: 10, product_id: product.product_id, name: product.name, price: product.price },
    { shop_id: 20, product_id: 'P7', name: 'Copper mug', price: '18.00' },
  ],
};
---
<figure class="tenant-references" data-tenant-references aria-labelledby="r03-reference-title">
  <header><span>Figure 1</span><strong id="r03-reference-title">One shop ID, two references</strong></header>
  <div class="scene">
    <p class="scene-label">Order line · <span data-line-kind data-live>stored line</span></p>
    <div class="line-record" aria-label="The line's reference values">
      <div><span>shop_id</span><b data-shop data-live>10</b></div>
      <div><span>order_id</span><b>{order.order_id}</b></div>
      <div><span>line_no</span><b>1</b></div>
      <div><span>product_id</span><b>{product.product_id}</b></div>
    </div>
    <div class="parent-grid">
      <section class="parent" data-order-parent aria-labelledby="r03-orders-parent">
        <p class="reference" data-order-reference data-live>↓ (10, 103)</p>
        <p class="parent-title" id="r03-orders-parent">Orders</p>
        <div class="parent-row" data-order-row>
          <code>(10, {order.order_id})</code><span>Mina’s order</span>
        </div>
        <p class="match-state" data-order-state data-live>Order reference not yet followed</p>
      </section>
      <section class="parent" data-product-parent aria-labelledby="r03-products-parent">
        <p class="reference" data-product-reference data-live>↓ (10, P7)</p>
        <p class="parent-title" id="r03-products-parent">Products</p>
        {facts.products.map(p => <div class="parent-row" data-product-shop={p.shop_id}>
          <code>({p.shop_id}, {p.product_id})</code><span>{p.name}</span>
        </div>)}
        <p class="match-state" data-product-state data-live>Product reference not yet followed</p>
      </section>
    </div>
    <p class="outcome" data-outcome data-live>Follow the same shop ID into both parent keys.</p>
    <p class="explanation" data-explanation data-live aria-live="polite">The line belongs to shop 10. Both references carry that same 10, together with the ID of their parent.</p>
  </div>
  <div class="controls">
    <div role="group" aria-label="Line to follow" class="choices">
      <span>Line to follow</span>
      <button type="button" data-case="10" aria-pressed="true">Stored: shop 10</button>
      <button type="button" data-case="20" aria-pressed="false">Attempted: shop 20</button>
    </div>
    <div class="playback" role="group" aria-label="Figure 1 playback">
      <button type="button" data-play>Play</button>
      <button type="button" data-back aria-disabled="true">Back</button>
      <button type="button" data-next>Next</button>
      <button type="button" data-reset>Reset</button>
      <span data-step aria-label="Current step">1 / 4</span>
    </div>
    <div class="hold" data-hold aria-hidden="true"><span></span></div>
  </div>
  <figcaption>The relevant parent rows from the tenant variant. Shop 10 follows the stored mug line on order 103. Shop 20 is an invalid attempted line: its product exists, but order (20, 103) does not. The steps illustrate reference matching, not PostgreSQL’s check order or a complete insert.</figcaption>
  <details>
    <summary>The two lookups, as text</summary>
    <p>With shop 10, the order reference asks for (10, 103), and finds Mina’s order. The product reference asks for (10, P7), and finds the Blue mug. Both references are satisfied.</p>
    <p>With shop 20, the product reference asks for (20, P7), and finds the Copper mug. The order reference asks for (20, 103), which is absent. Order (10, 103) cannot satisfy it, so the order foreign key refuses the attempted line.</p>
  </details>
  <script type="application/json" data-facts set:html={JSON.stringify(facts)} />
</figure>

<style>
  .tenant-references { margin: 2.5rem 0; font-family: var(--font-sans); }
  header { display: flex; align-items: baseline; gap: .7rem; margin-bottom: .7rem; }
  header > span { text-transform: uppercase; letter-spacing: .08em; font-size: .7rem; color: var(--color-text-secondary); }
  header strong { font-family: var(--font-serif); font-weight: 400; font-size: 1.15rem; }
  .scene { border: 1px solid var(--color-rule-strong); padding: 1.1rem; background: var(--color-surface-alt); }
  .scene-label { margin: 0 0 .65rem; font-size: .8rem; }
  .line-record { display: grid; grid-template-columns: repeat(4,1fr); border: 1px solid var(--color-text-secondary); background: var(--color-surface); }
  .line-record > div { padding: .6rem; min-width: 0; }
  .line-record > div + div { border-inline-start: 1px solid var(--color-rule); }
  .line-record span { display: block; font-size: .72rem; }
  .line-record b { display: block; margin-top: .25rem; font-family: var(--font-mono); font-weight: 500; }
  .line-record > div:first-child { border-top: 3px solid var(--color-accent); }
  .parent-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .parent { min-width: 0; margin: 0; }
  .reference { text-align: center; margin: .8rem 0; font: .82rem var(--font-mono); }
  .parent-title { font: 500 .8rem var(--font-sans); margin: 0 0 .5rem; }
  .parent-row { display: grid; grid-template-columns: 6.5rem 1fr; align-items: center; gap: .3rem; border: 1px solid var(--color-text-secondary); padding: .65rem; background: var(--color-surface); margin-bottom: .4rem; }
  .parent-row code { font-size: .78rem; background: none; padding: 0; }
  .parent-row span { display: block; font-size: .8rem; margin: 0; }
  .parent-row[data-matched="true"] { border: 2px solid var(--color-accent); padding: calc(.65rem - 1px); }
  .match-state { font-size: .77rem; min-height: 2.8rem; margin: .6rem 0 0; }
  .parent[data-missing="true"] .match-state { border-inline-start: 3px solid var(--color-text); padding-inline-start: .5rem; }
  .outcome { font-weight: 600; font-size: .86rem; margin: .9rem 0; border-top: 1px solid var(--color-rule-strong); padding-top: .8rem; }
  .explanation { font-size: .85rem; line-height: 1.6; border-inline-start: 3px solid var(--color-accent); padding-inline-start: .75rem; margin: .7rem 0 0; min-height: 4.2rem; }
  .controls { padding: .85rem; border: 1px solid var(--color-rule-strong); border-top: 0; background: var(--color-surface); }
  .choices, .playback { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; }
  .choices { margin-bottom: .7rem; }
  .choices > span { font-size: .75rem; margin-inline-end: .25rem; }
  button { border: 1px solid var(--color-text-secondary); padding: .5rem .65rem; background: var(--color-surface-alt); color: var(--color-text); font: .75rem var(--font-sans); cursor: pointer; border-radius: 3px; min-height: 2.5rem; }
  button[aria-pressed="true"] { background: var(--color-text); color: var(--color-surface); border-color: var(--color-text); }
  button[aria-disabled="true"] { color: var(--color-text-secondary); cursor: default; }
  button:focus-visible, summary:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; }
  [data-step] { font: .74rem var(--font-mono); margin-inline-start: auto; }
  .hold { height: 3px; margin-top: .6rem; background: var(--color-rule); overflow: hidden; }
  .hold span { display: block; height: 100%; width: 0; background: var(--color-accent); }
  figcaption { font-size: .8rem; line-height: 1.65; color: var(--color-text-secondary); margin-top: .8rem; }
  details { font-size: .82rem; line-height: 1.65; margin-top: .75rem; }
  summary { cursor: pointer; text-decoration: underline; text-underline-offset: .2em; }
  details p { margin: .7rem 0; }
  @media (max-width: 500px) {
    .scene { padding: .8rem; }
    .line-record { grid-template-columns: 1fr 1fr; }
    .line-record > div:nth-child(3) { border-inline-start: 0; border-top: 1px solid var(--color-rule); }
    .line-record > div:nth-child(4) { border-top: 1px solid var(--color-rule); }
    .parent-grid { grid-template-columns: 1fr; gap: 0; }
    .parent + .parent { margin-top: .4rem; border-top: 1px solid var(--color-rule); }
    .parent-row { display: grid; grid-template-columns: 6rem 1fr; align-items: center; gap: .3rem; }
    .parent-row span { margin: 0; }
    .match-state { min-height: 0; }
    .choices > span { flex-basis: 100%; }
    .explanation { min-height: 7rem; }
  }
</style>
<script>
  import { stepper } from '../../figures/stepper.mjs';
  import { referenceStep } from './tenant-model.mjs';
  const initialise = () => document.querySelectorAll('[data-tenant-references]').forEach(root => {
    if (root.hasAttribute('data-ready')) return;
    root.setAttribute('data-ready','');
    const facts = JSON.parse(root.querySelector('[data-facts]')!.textContent!);
    let shop = 10;
    const setText = (selector, text) => { root.querySelector(selector).textContent = text; };
    const player = stepper(root, { steps: () => 4, draw: step => {
      const state = referenceStep(facts, shop, step);
      setText('[data-shop]', String(shop));
      setText('[data-line-kind]', shop === 10 ? 'stored line' : 'attempted line');
      setText('[data-order-reference]', `↓ (${shop}, ${facts.order.order_id})`);
      setText('[data-product-reference]', `↓ (${shop}, P7)`);
      setText('[data-order-state]', state.orderText);
      setText('[data-product-state]', state.productText);
      setText('[data-outcome]', state.outcome);
      setText('[data-explanation]', state.explanation);
      root.querySelector('[data-order-row]').setAttribute('data-matched', String(step >= 1 && state.orderMatch));
      root.querySelector('[data-order-parent]').setAttribute('data-missing', String(step >= 1 && !state.orderMatch));
      root.querySelectorAll('[data-product-shop]').forEach(row => row.setAttribute('data-matched', String(step >= 2 && Number(row.getAttribute('data-product-shop')) === shop)));
    }});
    root.querySelectorAll('[data-case]').forEach(button => button.addEventListener('click', () => {
      shop = Number(button.getAttribute('data-case'));
      root.querySelectorAll('[data-case]').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      player.render();
    }));
  });
  initialise();
  document.addEventListener('astro:page-load', initialise);
</script>
