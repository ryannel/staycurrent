---
import core from '../../../lib/relational-collection/core.json';
import './modelling.css';
const flat = core.order_items.map(line => {
  const order = core.orders.find(o => o.order_id === line.order_id)!;
  const customer = core.customers.find(c => c.customer_id === order.customer_id)!;
  return {...line, customer_id:customer.customer_id, name:customer.name};
});
---
<figure class="r01-figure r01-anomalies" aria-labelledby="r01-anomaly-title">
  <div class="r01-head"><span>Figure 2</span><p id="r01-anomaly-title">Where a change has to go</p></div>
  <div class="r01-options" role="group" aria-label="Change to compare">
    <button type="button" data-case="rename" aria-pressed="true">Change Mina’s name</button>
    <button type="button" data-case="insert" aria-pressed="false">Keep Edda without orders</button>
    <button type="button" data-case="delete" aria-pressed="false">Remove order 102</button>
  </div>
  <div class="r01-outcomes" aria-live="polite" aria-atomic="true">
    <p><strong>Sales sheet</strong><span data-flat-result>Four copies of Mina’s name must change together.</span></p>
    <p><strong>Separate tables</strong><span data-separated-result>One customer row changes. Her orders still carry ID 1.</span></p>
  </div>
  <p class="r01-explanation" data-explanation>The outlines mark four places to edit in the sales sheet and one in customers. Updating only one sheet row would give Mina different current names on different lines.</p>
  <div class="r01-comparison">
    <section aria-labelledby="r01-flat-title">
      <p class="r01-panel-title" id="r01-flat-title">A sales sheet</p>
      <p class="r01-subtitle">One row per order line; customer details copied in.</p>
      <div class="r01-scroll" role="region" tabindex="0" aria-label="Sales sheet, selected columns">
        <table><thead><tr><th scope="col">Order · line</th><th scope="col">Customer</th><th scope="col">Current name</th></tr></thead>
          <tbody>{flat.map(row => <tr data-flat-customer={row.customer_id} data-flat-order={row.order_id}><td>{row.order_id} · {row.line_no}</td><td>{row.customer_id}</td><td data-flat-name>{row.name}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
    <section aria-labelledby="r01-separated-title">
      <p class="r01-panel-title" id="r01-separated-title">Customers and orders</p>
      <p class="r01-subtitle">Names belong to customers; orders carry their IDs.</p>
      <div class="r01-scroll" role="region" tabindex="0" aria-label="Customers">
        <table><caption>customers</caption><thead><tr><th scope="col">Customer</th><th scope="col">Current name</th></tr></thead>
          <tbody>{core.customers.map(row => <tr data-customer={row.customer_id}><td>{row.customer_id}</td><td data-customer-name>{row.name}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="r01-reference" aria-hidden="true">↑ customer_id refers to a customer</div>
      <div class="r01-scroll" role="region" tabindex="0" aria-label="Orders, selected columns">
        <table><caption>orders</caption><thead><tr><th scope="col">Order</th><th scope="col">Customer</th></tr></thead>
          <tbody>{core.orders.map(row => <tr data-order={row.order_id}><td>{row.order_id}</td><td>{row.customer_id}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
  </div>
  <figcaption>Each option starts from the same shop rows. Outlines mark where a name would change or where Edda can be recorded; crossing out shows the rows that removing order 102 would lose. Unrelated columns and the separate design’s order-line table are omitted.</figcaption>
  <details><summary>All three comparisons, as text</summary><ul><li>A change to Mina’s current name has four edit locations in the sales sheet, one in customers.</li><li>Edda has no order line, so there is no sales-sheet row for her. A customers row can record her independently.</li><li>Removing order 102 and its line would remove the sales sheet’s only row for Tariq. Keeping customers separately preserves his customer row.</li></ul></details>
</figure>
<script>
  document.querySelectorAll('.r01-anomalies').forEach(root => {
    const flatResult = root.querySelector('[data-flat-result]')!;
    const separatedResult = root.querySelector('[data-separated-result]')!;
    const explanation = root.querySelector('[data-explanation]')!;
    const text = {
      rename:['Four copies of Mina’s name must change together.','One customer row changes. Her orders still carry ID 1.','The outlines mark four places to edit in the sales sheet and one in customers. Updating only one sheet row would give Mina different current names on different lines.'],
      insert:['No order line exists for Edda, so there is nowhere to put her.','Customer 3 exists without any order referring to her.','A line-shaped row cannot record just a customer. Inventing an order to hold Edda’s name would record a purchase that never happened.'],
      delete:['The only row carrying Tariq’s name would disappear.','Order 102 goes; customer 2 remains.','The crossed-out row is the sales sheet’s only record of Tariq. With separate tables, removing an order does not remove the independent fact that Tariq is a customer.']
    };
    const draw = (kind: keyof typeof text) => {
      root.querySelectorAll('.r01-mark,.r01-removed').forEach(el => el.classList.remove('r01-mark','r01-removed'));
      if(kind==='rename') root.querySelectorAll('[data-flat-customer="1"] [data-flat-name], [data-customer="1"] [data-customer-name]').forEach(el => el.classList.add('r01-mark'));
      if(kind==='insert') root.querySelector('[data-customer="3"]')!.classList.add('r01-mark');
      if(kind==='delete') root.querySelectorAll('[data-flat-order="102"], [data-order="102"]').forEach(el => el.classList.add('r01-removed'));
      flatResult.textContent=text[kind][0]; separatedResult.textContent=text[kind][1]; explanation.textContent=text[kind][2];
      root.querySelectorAll<HTMLButtonElement>('[data-case]').forEach(button => button.setAttribute('aria-pressed',String(button.dataset.case===kind)));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-case]').forEach(button => button.addEventListener('click',()=>draw(button.dataset.case as keyof typeof text)));
    draw('rename');
  });
</script>
