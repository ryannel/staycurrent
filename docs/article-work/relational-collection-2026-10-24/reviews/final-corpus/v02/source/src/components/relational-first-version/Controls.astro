---
const { label } = Astro.props;
---
<div class="rf-playback" role="group" aria-label={label}>
 <button type="button" data-play>Play</button>
 <button type="button" data-back aria-disabled="true">Back</button>
 <button type="button" data-next>Next</button>
 <button type="button" data-reset>Reset</button>
 <span data-step aria-label="Current step"></span>
</div>
<div class="rf-hold" data-hold aria-hidden="true"><span></span></div>
