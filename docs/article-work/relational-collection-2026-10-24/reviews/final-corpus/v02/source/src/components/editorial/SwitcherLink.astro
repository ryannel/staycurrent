---
// One entry in a collection switcher. The page you're on is text, not a link
// back to itself, with a "You're here" marker.
interface Props { href: string; path: string; class?: string }
const { href, path, class: className } = Astro.props;
const current = path === href;
---
{current
  ? <span class:list={['switcher-link', className]} aria-current="page"><slot /><span class="current-marker"> You’re here</span></span>
  : <a class:list={['switcher-link', className]} href={href}><slot /></a>}
