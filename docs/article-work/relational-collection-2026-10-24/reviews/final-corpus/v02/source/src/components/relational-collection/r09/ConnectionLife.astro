<figure class="connection-life" aria-labelledby="r09-life-title" data-connection-life>
  <figcaption id="r09-life-title"><span class="figure-number">Figure 2</span> One borrower until the transaction ends</figcaption>
  <div class="life-options"><label>Request outcome <select data-outcome><option value="success">Success</option><option value="refusal">No stock</option><option value="timeout">Statement cancelled</option><option value="broken">Connection lost</option></select></label></div>
  <div class="ownership" role="img" aria-label="A pool lends connection C to the request. The request keeps it while its transaction is active. It returns only after commit or rollback, or is discarded if broken.">
    <div class="owner pool"><strong>Pool</strong><span data-pool data-live>Connection C ready</span></div>
    <div class="transfer" data-transfer data-live>↓ borrow C</div>
    <div class="owner request"><strong>Purchase request</strong><span data-request data-live>Not started</span><div class="session"><span>Connection C</span><strong data-session data-live>Idle</strong></div></div>
    <div class="transfer" data-return data-live>Return waits for the outcome</div>
  </div>
  <p data-explanation data-live aria-live="polite">The pool has an idle connection. The request has not borrowed it yet.</p>
  <div class="life-controls" role="group" aria-label="Connection ownership steps"><button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 6</span><div data-hold><span></span></div></div>
  <p class="caption">A model of ownership, not a capture of protocol messages. C denotes one database session. A broken session leaves the pool; a replacement is a different session.</p>
  <details><summary>Read the paths as text</summary><p>Success: borrow C, begin, reserve stock and write order, commit, return idle C. No stock: borrow, begin, receive zero rows, roll back all earlier work, return idle C. Statement cancelled: borrow, begin, receive cancellation error, roll back the failed transaction, return idle C. Connection lost: borrow, begin, lose the connection, discard C, resolve any uncertain commit separately before retrying the purchase.</p></details>
</figure>
<script>
  import { stepper } from '../../figures/stepper.mjs';
  document.querySelectorAll('[data-connection-life]').forEach(root=>{
    const select=root.querySelector('select');
    const endings={
      success:[['Stock and order written','Active','The stock changes and order writes have returned successfully. They are still uncommitted.'],['Commit acknowledged','Idle','The transaction context commits. Only its successful exit establishes this attempt’s success.'],['Finished','Idle','The request returns idle C to the pool, then reports the completed purchase.']],
      refusal:[['No stock returned','Active','The update succeeded as SQL but returned no row. The application raises its purchase refusal.'],['Purchase refused','Idle','The transaction context rolls back, including any stock already taken for another line.'],['Finished','Idle','Idle C returns to the pool. The request reports that the purchase was not accepted.']],
      timeout:[['Statement cancelled','Failed transaction','A server cancellation response ends the statement, not the explicit transaction. Further ordinary commands fail.'],['Error propagated','Idle','The exception leaves the transaction context, which rolls the transaction back before reuse.'],['Finished','Idle','After cleanup has settled, idle C returns to the pool. The request reports the failed attempt.']],
      broken:[['Connection lost','Broken','The request cannot continue using C. A missing commit reply may leave the purchase outcome unknown.'],['Connection discarded','Broken','The broken connection cannot become an idle session through a local rollback call. The pool discards it.'],['Resolution required','Gone','The request releases its resource ownership. Resolving an uncertain purchase is a separate step; borrowing a replacement is not that resolution.']]
    };
    const player=stepper(root,{steps:()=>6,draw:n=>{
      const kind=select.value;
      const common=[['Not started','Idle','The pool has an idle connection. The request has not borrowed it yet.'],['Owns C','Idle','The request borrows C. Helpers receive this connection rather than borrowing another one.'],['Transaction started','Active','The request opens its explicit transaction on C. Every participating statement stays on C.']];
      const [request,session,explanation]=n<3?common[n]:endings[kind][n-3];
      root.querySelector('[data-request]').textContent=request;root.querySelector('[data-session]').textContent=session;root.querySelector('[data-explanation]').textContent=explanation;
      root.querySelector('[data-pool]').textContent=n===0?'Connection C ready':n===5?(kind==='broken'?'C discarded; replacement needed':'Connection C ready'):'C lent to this request';
      root.querySelector('[data-transfer]').textContent=n===0?'↓ borrow C':n===5?'Borrowing has ended':'C belongs to this request';
      root.querySelector('[data-return]').textContent=n===5?(kind==='broken'?'C is gone':'↑ return idle C'):'Return waits for the outcome';
      root.querySelector('.request').classList.toggle('active',n>0&&n<5);
    }}); select.addEventListener('change',()=>player.render());
  });
</script>
<style>
.connection-life { margin:2rem 0; font: .95rem/1.5 var(--font-sans); }
figcaption {font:1.2rem/1.4 var(--font-serif);margin-bottom:.8rem}.figure-number {font:.75rem var(--font-sans);text-transform:uppercase;margin-right:.7rem;color:var(--color-text-secondary)}
.life-options,.life-controls {padding:1rem;background:var(--color-surface-alt)}label{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem}select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-text-secondary);border-radius:.2rem;padding:.45rem .65rem}button{cursor:pointer}button[aria-disabled=true]{color:var(--color-text-secondary)}button:focus-visible,select:focus-visible{outline:3px solid var(--color-accent);outline-offset:3px}.ownership{padding:1.2rem;border:1px solid var(--color-rule-strong);display:grid;gap:.4rem}.owner{border:1px solid var(--color-text-secondary);padding:.8rem;display:grid;gap:.3rem}.owner>strong{font-size:1.05rem}.session{margin-top:.5rem;border-left:3px solid var(--color-accent);padding:.5rem .7rem;display:flex;justify-content:space-between;gap:.7rem;flex-wrap:wrap}.active{outline:2px solid var(--color-accent)}.transfer{text-align:center;color:var(--color-text-secondary);padding:.3rem}[data-explanation]{padding:.8rem 1rem;margin:0;border-left:3px solid var(--color-accent);min-height:6.5rem}.life-controls{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}[data-hold]{height:3px;flex-basis:100%;background:var(--color-rule)}[data-hold] span{display:block;height:100%;background:var(--color-accent);width:0}.caption,details{color:var(--color-text-secondary);font-size:.85rem}.caption{margin:.75rem 0}details p{margin:.6rem 0}summary{cursor:pointer}
</style>
