---
import './figures.css';
import Controls from './Controls.astro';
const initial = { mug: 1, tea: 12, order: 'absent', lines: 0 };
const descriptions = [
 'Before BEGIN: one blue mug and twelve packs of tea are available. Order 103 has not been stored.',
 'BEGIN starts the transaction. The application has not changed any rows yet.',
 'The transaction reduces mug stock to 0 and tea stock to 10. These changes are still private. Another connection’s ordinary read still sees the committed stock.',
 'It adds pending order 103 and two order lines. The transaction now has the complete purchase, still uncommitted.',
 'COMMIT makes the stock changes, order and lines visible together. No observer reads a committed state with only half of this transaction.',
];
---
<div class="rf-figure" data-rf-transaction>
 <figure aria-labelledby="rf-transaction-title">
  <div class="rf-head"><span class="rf-number">Figure 3</span><p class="rf-name" id="rf-transaction-title">One purchase, one commit</p></div>
  <div class="rf-board">
   <p class="rf-phase" data-phase data-live>Before BEGIN</p>
   <div class="rf-state">
    {[['visible', 'An ordinary read on another connection'], ['working', 'This transaction’s own view']].map(([side, title]) => <div class="rf-state-panel" data-private={side === 'working' ? '' : undefined}>
     <p class="rf-state-title">{title}</p>
     <dl data-live>{Object.entries({mug: 'P7 stock', tea: 'P3 stock', order: 'Order 103', lines: 'Its order lines'}).map(([key, label]) => <Fragment><dt>{label}</dt><dd data-side={side} data-field={key}>{initial[key]}</dd></Fragment>)}</dl>
     <p class="rf-state-note" data-state-note={side}>{side === 'visible' ? 'Committed data' : 'Not yet a transaction'}</p>
    </div>)}
   </div>
   <p class="rf-explanation" data-explanation data-live aria-live="polite">{descriptions[0]}</p>
  </div>
  <div class="rf-controls rf-js-controls">
   <fieldset class="rf-options"><legend>At the end</legend><button type="button" data-tx-outcome="commit" aria-pressed="true">Commit</button><button type="button" data-tx-outcome="rollback" aria-pressed="false">Stop before commit</button></fieldset>
   <Controls label="Playback for figure 3" />
  </div>
  <figcaption>Order 103 is a pending purchase of one mug and two packs of tea. This conceptual PostgreSQL picture follows one transaction, with no competing writer. Each ordinary read shown on the left starts at that step; a long-running read can keep an older view.</figcaption>
  <details><summary>The changes and both endings, as text</summary><ol>{descriptions.map(e => <li>{e}</li>)}<li>If the transaction stops before committing, rollback discards its changes: stock remains 1 and 12, and order 103 and its lines are absent.</li></ol></details>
 </figure>
</div>
<script>
 import { stepper } from '../figures/stepper.mjs';
 import { transactionState } from './shop.mjs';
 const descriptions = [
  'Before BEGIN: one blue mug and twelve packs of tea are available. Order 103 has not been stored.',
  'BEGIN starts the transaction. The application has not changed any rows yet.',
  'The transaction reduces mug stock to 0 and tea stock to 10. These changes are still private. Another connection’s ordinary read still sees the committed stock.',
  'It adds pending order 103 and two order lines. The transaction now has the complete purchase, still uncommitted.',
  'COMMIT makes the stock changes, order and lines visible together. No observer reads a committed state with only half of this transaction.',
 ];
 document.querySelectorAll<HTMLElement>('[data-rf-transaction]').forEach(root => {
  let commit = true;
  const player = stepper(root, { steps: () => 5, draw: (step: number) => {
   const state = transactionState(step, commit);
   root.querySelector('[data-phase]')!.textContent = state.phase;
   root.querySelectorAll<HTMLElement>('[data-side]').forEach(cell => {
    const values = state[cell.dataset.side];
    cell.textContent = String(values?.[cell.dataset.field] ?? '—');
   });
   root.querySelector('[data-state-note="visible"]')!.textContent = 'Committed data';
   root.querySelector('[data-state-note="working"]')!.textContent = step === 4 ? 'Transaction ended' : step === 0 ? 'Not yet a transaction' : 'Uncommitted work';
   root.querySelector('[data-explanation]')!.textContent = step === 4 && !commit ? 'The transaction stops without committing. Rollback discards both the stock changes and the new order and lines. Another connection still sees stock 1 and 12, with no order 103.' : descriptions[step];
  }});
  root.querySelectorAll<HTMLButtonElement>('[data-tx-outcome]').forEach(button => button.addEventListener('click', () => {
   commit = button.dataset.txOutcome === 'commit';
   root.querySelectorAll<HTMLButtonElement>('[data-tx-outcome]').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
   player.render();
  }));
  root.dataset.ready = 'true';
 });
</script>
