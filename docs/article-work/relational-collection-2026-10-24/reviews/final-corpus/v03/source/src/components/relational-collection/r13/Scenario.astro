---
import {models} from './model.mjs';
import './figures.css';
interface Props {kind:'snapshots'|'skew';number:number;caption:string;}
const {kind,number,caption}=Astro.props;
const model=models[kind];
const id=`r13-${kind}`;
---
<figure class="r13-figure" data-r13-scene={kind} aria-labelledby={`${id}-title`}>
  <div class="r13-head"><span>Figure {number}</span><p id={`${id}-title`}>{model.title}</p></div>
  <div class="r13-enhanced" hidden>
    <div class="r13-board"><div data-drawing></div><p class="r13-explanation" data-explanation data-live aria-live="polite"></p></div>
    <div class="r13-controls">
      <div class="r13-options" role="group" aria-label={`Isolation for figure ${number}`}>
        {model.options.map(([value,label],i)=><button type="button" data-mode={value} aria-pressed={String(i===0)}>{label}</button>)}
      </div>
      <div class="r13-transport" role="group" aria-label={`Playback for figure ${number}`}>
        <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step aria-label="Current step"></span>
      </div>
      <div class="r13-hold" data-hold aria-hidden="true"><span></span></div>
    </div>
  </div>
  <details class="r13-text" open><summary>Steps as text</summary>
    {model.options.map(([value,label])=><div><p><strong>{label}</strong></p><ol>{Array.from({length:model.steps},(_,i)=><li>{model.explain(value,i)}</li>)}</ol></div>)}
  </details>
  <figcaption>{caption}</figcaption>
</figure>
<script>import './player.mjs';</script>
