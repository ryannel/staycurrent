---
import ModellingFirstDraft from '../../../layouts/ModellingFirstDraft.astro';

export function getStaticPaths() {
  if (process.env.MODELLING_FIRST_DRAFT_PREVIEW !== '1') return [];
  const articles = import.meta.glob('../../../articles/modelling-first-draft/article.astro', { eager: true, import: 'default' });
  const metadata = import.meta.glob('../../../articles/modelling-first-draft/article.meta.json', { eager: true, import: 'default' });
  const Article = articles['../../../articles/modelling-first-draft/article.astro'];
  const meta = metadata['../../../articles/modelling-first-draft/article.meta.json'] || {};
  return Article ? [{ params: { slug: undefined }, props: { Article, meta } }] : [];
}

const { Article, meta } = Astro.props;
---
<ModellingFirstDraft title={meta.title || 'Relational data modelling'} description={meta.description || 'An unpublished first draft about relational data modelling.'} type={meta.type || 'Guide'}>
  <Article />
</ModellingFirstDraft>
