---
import { customers, products, orders, lines, payments, offers, tags, suppliers, money, pairs, reconstructedOffers, total, laterMugPrice, explanations, paymentTotal, wrongJoinedTotals, repricedTotal } from './model.mjs';
import './figures.css';
const { kind, number, title } = Astro.props;
const selected = lines.filter(l => l.order === 101 || l.order === 103);
const name = (id) => customers.find(c => c.id === id).name;
const product = (id) => products.find(p => p.id === id);
const order = (id) => orders.find(o => o.id === id);
const stepCount = kind === 'normalise' || kind === 'offers' ? 4 : 0;

---
<figure class="md-figure wide" data-modelling={stepCount ? kind : undefined} aria-labelledby={`md-title-${number}`}>
  <figcaption id={`md-title-${number}`} class="md-title"><span>Figure {number}</span><strong>{title}</strong></figcaption>

  {kind === 'grain' && <>
    <div class="md-scene">
      <div class="md-two">
        <div><p class="md-label">Order lines · order 101</p><table><thead><tr><th>Line</th><th>Product</th><th>Value</th></tr></thead><tbody>{lines.filter(l=>l.order===101).map(l=><tr><td>{l.line}</td><td>{l.product}</td><td>{money(l.quantity*l.price)}</td></tr>)}</tbody><tfoot><tr><th colspan="2">Line total</th><td>{money(total(101))}</td></tr></tfoot></table></div>
        <div><p class="md-label">Payments · order 101</p><table><thead><tr><th>ID</th><th>Method</th><th>Amount</th></tr></thead><tbody>{payments.filter(p=>p.order===101).map(p=><tr><td>{p.id}</td><td>{p.method}</td><td>{money(p.amount)}</td></tr>)}</tbody><tfoot><tr><th colspan="2">Paid</th><td>{money(paymentTotal(101))}</td></tr></tfoot></table></div>
      </div>
      <p class="md-arrow">↓ Match both lists on order 101</p>
      <div class="md-scroll" tabindex="0" role="region" aria-label="Four line and payment combinations for order 101"><table><thead><tr><th>Line</th><th>Line value</th><th>Payment</th><th>Amount</th></tr></thead><tbody>{lines.filter(l=>l.order===101).flatMap(l=>payments.filter(p=>p.order===101).map(p=><tr><td>{l.line} · {l.product}</td><td>{money(l.quantity*l.price)}</td><td>{p.id}</td><td>{money(p.amount)}</td></tr>))}</tbody><tfoot><tr><th>Wrong sums</th><td><strong>{money(wrongJoinedTotals(101).lines)}</strong></td><td></td><td><strong>{money(wrongJoinedTotals(101).payments)}</strong></td></tr></tfoot></table></div>
      <p class="md-callout">2 lines × 2 payments = 4 combinations. Each value is counted twice.</p>
    </div>
    <p class="md-caption">Both payments settle the order. The shop records no allocation of a payment to a particular line. The four combinations above do not create that allocation.</p>
  </>}

  {kind === 'normalise' && <>
    <div class="md-scene">
      {[0,1,2,3].map(stage=><div data-stage={stage} hidden={stage!==0} data-live>
        {stage === 0 && <div class="md-scroll" tabindex="0" role="region" aria-label="Flattened order lines"><table><thead><tr><th>Line key</th><th>Order facts</th><th>Customer</th><th>Current product</th><th>Line facts</th></tr></thead><tbody>{selected.map(l=><tr><td>{l.order}, {l.line}</td><td>{order(l.order).placed}<br/>UTC 2026</td><td>1<br/>{name(1)}</td><td>{l.product} · {product(l.product).name}<br/>{money(product(l.product).price)}</td><td>qty {l.quantity}<br/>at {money(l.price)}</td></tr>)}</tbody></table></div>}
        {stage > 0 && <>
          <div class="md-tables">
            <div><p class="md-label">orders · key: order_id</p><table><thead><tr><th>Order</th><th>Customer</th><th>Placed (UTC, 2026)</th>{stage===1&&<th>Name</th>}</tr></thead><tbody>{orders.filter(o=>o.id!==102).map(o=><tr><td>{o.id}</td><td>{o.customer}</td><td>{o.placed}</td>{stage===1&&<td>{name(o.customer)}</td>}</tr>)}</tbody></table></div>
            {stage>=2 && <div><p class="md-label">customers · key: customer_id</p><table><thead><tr><th>Customer</th><th>Current name</th></tr></thead><tbody><tr><td>1</td><td>{name(1)}</td></tr></tbody></table></div>}
            {stage===3 && <div><p class="md-label">products · key: product_id</p><table><thead><tr><th>Product</th><th>Current name</th><th>Price</th></tr></thead><tbody>{products.map(p=><tr><td>{p.id}</td><td>{p.name}</td><td>{money(p.price)}</td></tr>)}</tbody></table></div>}
          </div>
          <p class="md-arrow">↑ References keep each line attached to its order and product</p>
          <p class="md-label">order_items · key: (order_id, line_no)</p>
          <div class="md-scroll" tabindex="0" role="region" aria-label="Order lines after separating facts"><table><thead><tr><th>Order</th><th>Line</th><th>Product</th>{stage<3&&<th>Current name / price</th>}<th>Qty</th><th>Agreed price</th></tr></thead><tbody>{selected.map(l=><tr><td>{l.order}</td><td>{l.line}</td><td>{l.product}</td>{stage<3&&<td>{product(l.product).name}<br/>{money(product(l.product).price)}</td>}<td>{l.quantity}</td><td>{money(l.price)}</td></tr>)}</tbody></table></div>
        </>}
      </div>)}
      <p class="md-explanation" data-explanation data-live aria-live="polite">{explanations.normalise[0]}</p>
    </div>
    <div class="md-player" role="group" aria-label={`Figure ${number} controls`}>
      <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><span class="md-hold" data-hold aria-hidden="true"><span></span></span><button type="button" data-reset>Reset</button><span data-step>1 / 4</span>
    </div>
    <p class="md-caption">A conceptual decomposition of four lines from orders 101 and 103. Status and stock are omitted. Each step moves one kind of fact; repeated IDs remain as references. This is a design illustration, not a migration or an engine trace. The line tables scroll sideways when needed.</p>
    <details class="md-alternative"><summary>The four stages as text</summary><ol>{explanations.normalise.map(e=><li>{e}</li>)}</ol></details>
  </>}

  {kind === 'split' && <>
    <div class="md-scene">
      <div class="md-two">
        <div><p class="md-label">Original order–product associations</p><table><thead><tr><th>Order</th><th>Customer</th><th>Product</th></tr></thead><tbody>{selected.map(l=><tr><td>{l.order}</td><td>1</td><td>{l.product}</td></tr>)}</tbody></table></div>
        <div><p class="md-label">After keeping only these pairs</p><p class="md-pair-list"><b>Order → customer</b><span>101 → 1<br/>103 → 1</span></p><p class="md-pair-list"><b>Customer → product bought</b><span>1 → P3<br/>1 → P7<br/>1 → P9</span></p></div>
      </div>
      <p class="md-arrow">↓ Reconstruct through customer 1</p>
      <table class="md-matrix"><thead><tr><th>Order</th><th>P3</th><th>P7</th><th>P9</th></tr></thead><tbody><tr><th>101</th><td>Original</td><td class="md-invented">Invented</td><td>Original</td></tr><tr><th>103</th><td>Original</td><td>Original</td><td class="md-invented">Invented</td></tr></tbody></table>
      <p class="md-callout">The customer’s purchases no longer tell us which order contained which product.</p>
    </div>
    <p class="md-caption">All four original associations survive, but two more appear. The split lost the order–product distinction. A reconstruction with extra rows is a loss of information, even though it returns more rows.</p>
  </>}

  {kind === 'offers' && <>
    <div class="md-scene">
      <p class="md-label">Complete hypothetical offers</p><table><thead><tr><th>Supplier</th><th>Product</th><th>Location</th></tr></thead><tbody>{offers.map(o=><tr>{o.map(v=><td>{v}</td>)}</tr>)}</tbody></table>
      {[0,1,2,3].map(stage=><div data-stage={stage} hidden={stage!==0} data-live>
        {stage===0&&<p class="md-callout">No offer says: S1 · P7 · North.</p>}
        {(stage===1||stage===2)&&<><p class="md-arrow">↓ Keep the three lists of pairs</p><div class="md-three">{[[0,1,'Supplier / product'],[0,2,'Supplier / location'],[1,2,'Product / location']].map(([a,b,label])=><div><p class="md-label">{label}</p><table><tbody>{pairs(offers,a,b).map(row=><tr class:list={{'md-match':stage===2&&((a===0&&b===1&&row[0]==='S1'&&row[1]==='P7')||(a===0&&b===2&&row[0]==='S1'&&row[1]==='North')||(a===1&&row[0]==='P7'&&row[1]==='North'))}}>{row.map(v=><td>{v}</td>)}</tr>)}</tbody></table></div>)}</div>{stage===2&&<p class="md-callout">All three marked pairs support S1 · P7 · North. The full offer still does not exist.</p>}</>}
        {stage===3&&<><p class="md-arrow">↓ Put the pairs together</p><table><thead><tr><th>Supplier</th><th>Product</th><th>Location</th><th>Result</th></tr></thead><tbody>{reconstructedOffers().map(row=>{const real=offers.some(o=>o.every((v,i)=>v===row[i]));return <tr class:list={{'md-invented':!real}}>{row.map(v=><td>{v}</td>)}<td>{real?'Original':'Invented'}</td></tr>})}</tbody></table></>}
      </div>)}
      <p class="md-explanation" data-live data-explanation aria-live="polite">{explanations.offers[0]}</p>
    </div>
    <div class="md-player" role="group" aria-label={`Figure ${number} controls`}><button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><span class="md-hold" data-hold aria-hidden="true"><span></span></span><button type="button" data-reset>Reset</button><span data-step>1 / 4</span></div>
    <p class="md-caption">Every pair is copied from a real illustrative offer. Their agreement does not establish the fourth triple. The pair lists describe a different rule from the offers table.</p>
    <details class="md-alternative"><summary>The reconstruction as text</summary><ol>{explanations.offers.map(e=><li>{e}</li>)}</ol></details>
  </>}

  {kind === 'sets' && <>
    <div class="md-scene"><div class="md-two"><div><p class="md-label">product_tags · P7</p><div class="md-set">{tags.map(t=><span>{t}</span>)}</div></div><div><p class="md-label">product_suppliers · P7</p><div class="md-set">{suppliers.map(s=><span>{s}</span>)}</div></div></div><p class="md-arrow">↓ If one row must hold a tag and a supplier</p><table class="md-matrix"><thead><tr><th>P7</th>{tags.map(t=><th>{t}</th>)}</tr></thead><tbody>{suppliers.map(s=><tr><th>{s}</th>{tags.map(t=><td>{s} + {t}</td>)}</tr>)}</tbody></table><p class="md-callout">All four combinations mean only two independent sets. Neither supplier owns a particular tag.</p></div>
    <p class="md-caption">Hypothetical catalogue memberships. These four combinations are required by the assumed independence; they are not four separate supply offers. Keeping the two sets separately represents the same information without their cross-product.</p>
  </>}

  {kind === 'price' && <>
    <div class="md-scene"><table><thead><tr><th>Moment</th><th>P7 catalogue price</th><th>103, line 1 agreed price</th><th>103 line total</th></tr></thead><tbody><tr><th>Order 103 placed</th><td>{money(product('P7').price)}</td><td>{money(lines.find(l=>l.order===103&&l.line===1).price)}</td><td>{money(total(103))}</td></tr><tr><th>Later price change</th><td class="md-match">{money(laterMugPrice)}<br/><small>changed</small></td><td>{money(lines.find(l=>l.order===103&&l.line===1).price)}<br/><small>same agreement</small></td><td>{money(total(103))}<br/><small>same order</small></td></tr></tbody></table><p class="md-callout">Catalogue price: what the shop asks now.<br/>Agreed unit price: what this line was sold for.</p></div>
    <p class="md-caption">The later change to 22.00 is hypothetical. Recalculating order 103 from the new catalogue would give {money(repricedTotal(103))}; its agreed lines still total {money(total(103))}. No tax, shipping or discount is modelled.</p>
  </>}
</figure>

<script>
  import { stepper } from '../figures/stepper.mjs';
  import { explanations } from './model.mjs';
  document.querySelectorAll('[data-modelling]').forEach(root => {
    const kind = root.getAttribute('data-modelling');
    if (!(kind in explanations)) return;
    const stages = [...root.querySelectorAll('[data-stage]')];
    stepper(root, { steps: () => 4, draw: step => {
      stages.forEach((stage, i) => { stage.hidden = i !== step; });
      root.querySelector('[data-explanation]').textContent = explanations[kind][step];
    }});
  });
</script>
