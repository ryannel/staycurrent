---
import { scenes } from './scenes.mjs';
interface Props { scene: keyof typeof scenes; number: number }
const { scene, number } = Astro.props;
const c = scenes[scene];
const first = c.options[0][0];
const stages = c.stages(first);
const initial = c.draw(0, first);
---
<figure class="decision-figure" data-a00-decision={scene} aria-labelledby={`a00-${scene}-title`}>
  <figcaption><span class="eyebrow">Figure {number} · illustrative model</span><strong id={`a00-${scene}-title`}>{c.title}</strong></figcaption>
  <div class="controls"><label>{c.label} <select data-choice>{c.options.map(([value, label]) => <option value={value}>{label}</option>)}</select></label></div>
  <ol class="stages" data-live style={`--stages:${stages.length}`}>{stages.map((title, i) => <li data-stage={i} aria-current={i === 0 ? 'step' : 'false'}>{title}</li>)}</ol>
  <div data-picture data-live class={`picture ${scene}`} set:html={initial.picture} />
  <p data-explanation data-live aria-live="polite" class="explanation">{initial.message}</p>
  <div class="controls"><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / {stages.length}</span><span class="hold" data-hold aria-hidden="true"><span></span></span></div>
  <p class="caption">{c.caption}</p>
  <details><summary>Read this figure as text</summary><p>{c.alternative}</p></details>
</figure>
<script>
import { scenes } from './scenes.mjs';
import { stepper } from './player.mjs';
document.querySelectorAll<HTMLElement>('[data-a00-decision]').forEach(root => {
  const scene = scenes[root.dataset.a00Decision as keyof typeof scenes];
  const select = root.querySelector<HTMLSelectElement>('[data-choice]')!;
  const list = root.querySelector<HTMLElement>('.stages')!;
  const draw = (step: number) => {
    const { picture, message } = scene.draw(step, select.value);
    const stages = scene.stages(select.value);
    list.style.setProperty('--stages', String(stages.length));
    list.querySelectorAll('[data-stage]').forEach((el, i) => { el.textContent = stages[i]; el.setAttribute('aria-current', i === step ? 'step' : 'false'); });
    root.querySelector('[data-picture]')!.innerHTML = picture;
    root.querySelector('[data-explanation]')!.textContent = message;
  };
  const player = stepper(root, { steps: () => scene.stages(select.value).length, draw });
  select.addEventListener('change', player.render);
});
</script>
<style>
  figure{--a00-warn:color-mix(in srgb,var(--coral) 75%,var(--color-text));margin:2rem 0;padding:1.2rem;border:1px solid var(--color-rule);background:var(--color-surface-alt)}figcaption span,figcaption strong{display:block}figcaption strong{font-size:1.1rem}
  .controls{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin:1rem 0}label{min-width:0;max-width:100%;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-size:.85rem}
  button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .7rem;cursor:pointer;max-width:100%}button[aria-disabled="true"]{opacity:.5;cursor:default}button:focus-visible,select:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}
  .stages{display:grid;grid-template-columns:repeat(var(--stages,4),minmax(0,1fr));gap:.4rem;list-style:none;padding:0;margin:1.2rem 0}.stages li{border-top:3px solid var(--color-rule);padding:.4rem;font-size:.75rem}.stages [aria-current="step"]{border-color:var(--color-accent);font-weight:700}
  .picture{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;min-height:12rem;align-content:start}
  .picture.lookup,.picture.recovery{grid-template-columns:repeat(3,minmax(0,1fr))}
  .picture :global(.state-card){border:2px solid var(--color-rule);padding:.8rem;background:var(--color-surface);display:flex;flex-direction:column;gap:.4rem;min-width:0}
  .picture :global(.state-card strong){font-size:.8rem}.picture :global(.state-card span){font:600 .85rem/1.5 var(--font-mono);overflow-wrap:anywhere}.picture :global(small){font-size:.75rem;color:var(--color-text-secondary)}
  .picture :global(.state-card.changed){border-color:var(--color-accent)}
  .picture :global(.state-card.problem){border-color:var(--coral)}.picture :global(.state-card.problem span){color:var(--a00-warn)}
  .picture :global(.state-card.chosen){border-color:var(--color-accent);box-shadow:inset 0 0 0 1px var(--color-accent)}.picture :global(.state-card.chosen small){color:var(--color-accent-strong);font-weight:700}
  .picture :global(.state-card.unusable){border-style:dashed}.picture :global(.state-card.unusable small){color:var(--a00-warn);font-weight:700}
  .picture :global(.access),.picture :global(.pages),.picture :global(.full-row){grid-column:1/-1}.picture :global(.access){font:600 .8rem/1.5 var(--font-mono)}
  .picture :global(.pages){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}
  .picture :global(.page){border:2px solid var(--color-rule);padding:.3rem;background:var(--color-surface);min-width:0}.picture :global(.page.examined){border-color:var(--color-accent)}
  .picture :global(.mini table){display:table;width:100%;margin:0;border-collapse:collapse;font:.75rem/1.4 var(--font-mono)}
  .picture :global(.mini caption){text-align:left;font:600 .75rem/1.4 var(--font-sans);padding:.1rem .2rem .3rem}
  .picture :global(.mini th),.picture :global(.mini td){border:0;border-bottom:1px solid var(--color-rule);padding:.25rem .3rem;text-align:left;background:none}
  .picture :global(.mini th){font-size:.68rem}
  .picture :global(.full-row .mini){background:var(--color-surface);border:1px solid var(--color-rule);padding:.5rem}
  .picture :global(tr.answer td),.picture :global(tr.changed td){font-weight:700;box-shadow:inset 0 -2px var(--color-accent)}
  .picture :global(tr.problem td){color:var(--a00-warn);font-weight:700;box-shadow:inset 0 -2px var(--coral)}
  .explanation{min-height:5rem;font-size:.9rem}.caption,details{font-size:.8rem;color:var(--color-text-secondary)}summary{cursor:pointer}
  .hold{flex:0 0 4rem;height:3px;background:var(--color-rule)}.hold span{display:block;height:100%;width:0;background:var(--color-accent)}
  @media(max-width:600px){figure{padding:.8rem}.stages{grid-template-columns:repeat(2,minmax(0,1fr))}.picture,.picture.lookup,.picture.recovery{grid-template-columns:1fr;min-height:0}.explanation{min-height:0}select{font-size:.8rem}.picture :global(.mini th){font-size:.62rem}}
</style>
