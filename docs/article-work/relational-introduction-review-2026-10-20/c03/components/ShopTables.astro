---
import { customers, orders, items, products } from './models.mjs';
const money = (value: number) => value.toFixed(2);
---
<figure class="shop" aria-labelledby="a00-shop-title">
  <figcaption><strong id="a00-shop-title">The shop’s four tables</strong><span>Every row the next two sections use. <span class="tag key">PK</span> marks primary-key columns. <span class="tag ref">FK</span> marks a foreign-key column, whose values have a dashed underline. Each arrow runs from a foreign key to the key it must match: the same value appears at both ends.</span></figcaption>
  <div class="grid">
    <div class="box customers">
      <table>
        <caption><code>customers</code> · one row per customer</caption>
        <thead><tr><th scope="col">customer_id <span class="tag key">PK</span></th><th scope="col">name</th></tr></thead>
        <tbody>{customers.map(row => <tr><td class="key">{row.customer_id}</td><td>{row.name}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="link l-customer" aria-label="orders.customer_id refers to customers.customer_id"><span aria-hidden="true"><span class="arrow">↑</span> orders.customer_id matches customers.customer_id</span></p>
    <div class="box orders">
      <table>
        <caption><code>orders</code> · one row per order</caption>
        <thead><tr><th scope="col">order_id <span class="tag key">PK</span></th><th scope="col">customer_id <span class="tag ref">FK<span class="to"> → customers</span></span></th><th scope="col">status</th><th scope="col">shipped_at</th></tr></thead>
        <tbody>{orders.map(row => <tr><td class="key">{row.order_id}</td><td class="ref">{row.customer_id}</td><td>{row.status}</td><td class="null">{row.shipped_at ?? 'NULL'}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="link l-order" aria-label="order_items.order_id refers to orders.order_id"><span aria-hidden="true"><span class="arrow">↑</span> order_items.order_id matches orders.order_id</span></p>
    <div class="box items">
      <table>
        <caption><code>order_items</code> · one product on one order</caption>
        <thead><tr><th scope="col">order_id <span class="tag key">PK</span> <span class="tag ref">FK<span class="to"> → orders</span></span></th><th scope="col">product_id <span class="tag key">PK</span> <span class="tag ref">FK<span class="to"> → products</span></span></th><th scope="col">quantity</th><th scope="col">unit_price_gbp</th></tr></thead>
        <tbody>{items.map(row => <tr><td class="key ref">{row.order_id}</td><td class="key ref">{row.product_id}</td><td>{row.quantity}</td><td>{money(row.unit_price_gbp)}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="link l-product" aria-label="order_items.product_id refers to products.product_id"><span aria-hidden="true"><span class="arrow">↓</span> order_items.product_id matches products.product_id</span></p>
    <div class="box products">
      <table>
        <caption><code>products</code> · one row per product</caption>
        <thead><tr><th scope="col">product_id <span class="tag key">PK</span></th><th scope="col">available</th></tr></thead>
        <tbody>{products.map(row => <tr><td class="key">{row.product_id}</td><td>{row.available}</td></tr>)}</tbody>
      </table>
    </div>
  </div>
</figure>
<style>
  .shop { margin: 2rem 0; padding: 1.2rem; border: 1px solid var(--color-rule); background: var(--color-surface-alt); }
  figcaption { margin-bottom: 1rem; font-size: .85rem; color: var(--color-text-secondary); line-height: 1.6; }
  figcaption strong { display: block; font-size: 1.1rem; color: var(--color-text); margin-bottom: .3rem; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: start; }
  .box { min-width: min(16rem, 100%); max-width: 100%; overflow-x: auto; border: 1px solid var(--color-rule-strong); background: var(--color-surface); padding: .6rem; }
  .shop table { display: table; width: auto; min-width: 100%; margin: 0; border-collapse: collapse; font: .78rem/1.45 var(--font-mono); }
  .shop caption { text-align: left; font: 600 .82rem/1.5 var(--font-sans); padding-bottom: .45rem; color: var(--color-text); }
  .shop caption code { font-size: .82rem; }
  .shop th, .shop td { border: 0; border-bottom: 1px solid var(--color-rule); padding: .35rem .45rem; text-align: left; vertical-align: bottom; }
  .shop th { background: none; font-weight: 600; }
  .tag { display: inline-block; font: 600 .62rem/1.3 var(--font-sans); letter-spacing: .02em; padding: .05rem .3rem; border-radius: .2rem; white-space: nowrap; vertical-align: .08em; }
  .tag.key { background: var(--color-accent); color: var(--color-surface); }
  .tag.ref { border: 1px solid var(--color-accent); color: var(--color-accent-strong); }
  td.key { font-weight: 700; }
  td.ref { text-decoration: underline dashed var(--color-accent); text-underline-offset: .25em; }
  td.null { color: var(--color-text-secondary); font-style: italic; }
  .link { margin: 0; padding: .35rem 0 .35rem 1.4rem; border-left: 2px solid var(--color-accent); margin-left: 1.6rem; font: 600 .78rem/1.4 var(--font-mono); color: var(--color-accent-strong); overflow-wrap: anywhere; }
  .arrow { font: 700 1.1rem/1 var(--font-sans); margin-right: .2rem; }
  @media (max-width: 640px) {
    .shop { padding: .6rem; }
    .box { padding: .35rem; }
    .link { margin-left: 1rem; padding-left: .9rem; }
    .shop table { font-size: .68rem; }
    .shop th, .shop td { padding: .3rem .2rem; }
    .tag { font-size: .56rem; padding: .05rem .18rem; letter-spacing: 0; }
  }
</style>
