[
  {
    "label": "environment",
    "version": {
      "version": "PostgreSQL 18.6 (Homebrew) on aarch64-apple-darwin25.6.0, compiled by Apple clang version 21.0.0 (clang-2100.3.34.2), 64-bit",
      "fsync": "on",
      "synchronous_commit": "on"
    }
  },
  {
    "label": "blocked booking evidence",
    "sql": "SELECT pid,state,wait_event_type,wait_event,pg_blocking_pids(pid) blockers FROM pg_stat_activity WHERE pid IN ($1,$2) ORDER BY pid",
    "args": [
      67282,
      67283
    ],
    "rows": [
      {
        "pid": 67282,
        "state": "idle in transaction",
        "wait_event_type": "Client",
        "wait_event": "ClientRead",
        "blockers": []
      },
      {
        "pid": 67283,
        "state": "active",
        "wait_event_type": "Lock",
        "wait_event": "transactionid",
        "blockers": [
          67282
        ]
      }
    ]
  },
  {
    "label": "cancel idle blocker has no statement to interrupt",
    "sql": "SELECT pg_cancel_backend($1) cancelled",
    "args": [
      67282
    ],
    "rows": [
      {
        "cancelled": true
      }
    ]
  },
  {
    "label": "waiter still pending after cancel request",
    "done": false
  },
  {
    "label": "release transaction lets waiter finish",
    "result": {
      "ok": true,
      "rows": [
        {
          "reserved": 1
        }
      ],
      "rowCount": 1
    }
  }
]
