[
  {
    "label": "environment",
    "version": {
      "version": "PostgreSQL 18.6 (Homebrew) on aarch64-apple-darwin25.6.0, compiled by Apple clang version 21.0.0 (clang-2100.3.34.2), 64-bit",
      "fsync": "on",
      "synchronous_commit": "on"
    }
  },
  {
    "label": "old primary has acknowledged work beyond stopped replica",
    "sql": "SELECT * FROM durable_probe WHERE id='old_primary_only'",
    "rows": [
      {
        "id": "old_primary_only"
      }
    ]
  },
  {
    "label": "cached old writer cannot commit after fence",
    "result": {
      "ok": false,
      "code": "EPIPE",
      "message": "write EPIPE"
    }
  },
  {
    "label": "promote only after fence confirmed",
    "sql": "SELECT pg_promote(true,10) promoted",
    "rows": [
      {
        "promoted": true
      }
    ]
  },
  {
    "label": "promoted history lacks later old-primary commit",
    "sql": "SELECT * FROM durable_probe WHERE id='old_primary_only'",
    "rows": []
  },
  {
    "label": "new authority writes",
    "sql": "INSERT INTO durable_probe VALUES('new_primary') RETURNING *",
    "rows": [
      {
        "id": "new_primary"
      }
    ]
  },
  {
    "label": "uncommitted old work absent",
    "sql": "SELECT * FROM durable_probe WHERE id='stale_uncommitted'",
    "rows": []
  },
  {
    "label": "old node rejoined without write authority",
    "sql": "SELECT pg_is_in_recovery() recovery",
    "rows": [
      {
        "recovery": true
      }
    ]
  },
  {
    "label": "rejoined node rejects writes",
    "result": {
      "ok": false,
      "code": "25006",
      "message": "cannot execute INSERT in a read-only transaction"
    }
  }
]
