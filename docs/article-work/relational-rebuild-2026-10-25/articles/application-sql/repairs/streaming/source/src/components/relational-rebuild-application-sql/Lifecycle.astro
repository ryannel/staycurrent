<figure class="boundary-figure" data-lifecycle>
  <figcaption><span class="figure-number">Figure 5</span><strong>Who returns the connection?</strong></figcaption>
  <label class="choice">Purchase outcome <select data-outcome aria-label="Purchase transaction outcome"><option value="success">Commit acknowledged</option><option value="guard">Stock condition does not match</option><option value="error">SQL statement rejected</option><option value="broken">Connection breaks before commit</option><option value="unknown">Commit reply is lost</option></select></label>
  <div class="lifecycle-scene">
    <div class="connection" data-live><span class="panel-label">One checked-out connection</span><b data-connection>In the pool</b><span data-state>No transaction</span></div>
    <ol class="path" data-live data-path></ol>
    <div class="purchase-result" data-live><span class="panel-label">What the caller can report</span><b data-result>Nothing yet</b></div>
  </div>
  <p class="step-explanation" data-explanation data-live aria-live="polite"></p>
  <div class="figure-controls"><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step></span></div>
  <div class="hold" data-hold aria-hidden="true"><span></span></div>
  <details><summary>Connection paths, as text</summary><p>Every path checks out one connection and begins a transaction. Success writes the purchase, receives the commit reply and releases the connection. A zero stock match or a database rejection stops further purchase work, rolls back and releases only after rollback completes. A broken connection is discarded. If the commit reply is lost, discard the connection and report an unknown outcome: it may have committed. None of these paths returns an in-flight query or an unfinished transaction to another request.</p></details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  document.querySelectorAll('[data-lifecycle]').forEach(root=>{
    const select=root.querySelector('[data-outcome]');
    const start=[['Check out','Held by this request','No transaction','Nothing yet','The pool lends one connection to this request. No other request may borrow it yet.'],['BEGIN','Held by this request','Transaction open','Nothing yet','BEGIN and every purchase statement go through this same connection.']];
    const variants={
      success:[['Write purchase','Held by this request','Transaction open','Nothing yet','Both stock guards match. Write order 103 and its two lines; these changes are still uncommitted.'],['COMMIT → reply','Held by this request','Transaction ended','Order 103 committed','The server acknowledges COMMIT. The caller has a confirmed success.'],['Release','Back in the pool','No transaction','Order 103 committed','The transaction owner returns the connection for another request.']],
      guard:[['Guard → zero rows','Held by this request','Transaction open','Purchase rejected','The statement completed, but its condition matched no row. Stop the purchase. Earlier writes must be rolled back.'],['ROLLBACK → reply','Held by this request','Transaction ended','Purchase rejected','The server acknowledges ROLLBACK. None of this transaction’s purchase changes remain.'],['Release','Back in the pool','No transaction','Purchase rejected','Return the connection after cleanup. The application rejection remains the reason this purchase failed.']],
      error:[['Statement → error','Held by this request','Transaction failed','Database rejection','A statement is rejected. Further purchase statements cannot repair the failed PostgreSQL transaction.'],['ROLLBACK → reply','Held by this request','Transaction ended','Database rejection','Roll back before reuse. Preserve the original error code and relevant constraint identity.'],['Release','Back in the pool','No transaction','Database rejection','The clean connection returns to the pool; the original failure goes to the caller.']],
      broken:[['Connection lost','Unusable','State not established','Purchase failed before COMMIT','The link breaks before the application sends COMMIT. This connection cannot be handed to another request.'],['Discard','Removed from the pool','No reusable session','Purchase failed before COMMIT','Destroy the client. The server rolls back its open transaction when it detects the lost session. No commit was sent on this path.']],
      unknown:[['Send COMMIT','Held by this request','COMMIT in flight','Nothing confirmed','COMMIT has left the application. The server may commit before the application hears the reply.'],['Reply lost','Unusable','Outcome unknown','May have committed','A broken connection gives no answer about the purchase. A later rollback attempt cannot undo an already committed transaction.'],['Discard','Removed from the pool','No reusable session','Outcome unknown','Dispose of the connection. Recover the logical request through a recorded identity, rather than declaring failure and purchasing again.']]
    };
    const player=stepper(root,{steps:()=>start.length+variants[select.value].length,draw:step=>{
      const list=[...start,...variants[select.value]];const [action,connection,state,result,text]=list[step];
      root.querySelector('[data-connection]').textContent=connection;root.querySelector('[data-state]').textContent=state;root.querySelector('[data-result]').textContent=result;root.querySelector('[data-explanation]').textContent=text;
      root.querySelector('[data-path]').replaceChildren(...list.map(([label],i)=>{const li=document.createElement('li');li.textContent=label;li.className=i===step?'current':i<step?'past':'';if(i===step)li.setAttribute('aria-current','step');return li;}));
    }});
    select.addEventListener('change',()=>root.querySelector('[data-reset]').click());
  });
</script>
<style is:global>
  [data-lifecycle] .lifecycle-scene { display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.3rem 0; }
  [data-lifecycle] :is(.connection,.purchase-result) { border:1px solid var(--color-rule-strong);padding:1rem;display:flex;flex-direction:column;gap:.6rem;background:var(--color-surface); }
  [data-lifecycle] .connection { border-top:3px solid var(--teal); }
  [data-lifecycle] .purchase-result { grid-column:1/-1; }
  [data-lifecycle] :is(.connection,.purchase-result) b { font-size:1rem; }
  [data-lifecycle] .path { margin:0;padding-left:1.7rem; }
  [data-lifecycle] .path li { padding:.45rem;color:var(--color-text-secondary); }
  [data-lifecycle] .path li.current { color:var(--color-text);background:color-mix(in srgb,var(--teal) 10%,var(--color-surface));outline:1px solid var(--teal);font-weight:600; }
  [data-lifecycle] .path li.past::marker { color:var(--teal); }
  @media(max-width:550px) { [data-lifecycle] .lifecycle-scene {grid-template-columns:1fr;} [data-lifecycle] .purchase-result {grid-column:auto;} }
</style>
