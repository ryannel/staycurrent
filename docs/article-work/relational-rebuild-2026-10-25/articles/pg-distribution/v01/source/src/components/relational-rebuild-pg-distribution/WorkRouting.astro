---
const requests = [
 {label:'Mina’s history',key:'history',route:'customer_id = 1 → A',a:'Find orders 101 and 103; join their lines locally.',b:'Excluded by customer key',c:'Excluded by customer key',p:'Not needed',result:'A returns 101: 39.50; 103: 29.00. One customer owner does the order work.'},
 {label:'Order 103, no customer key',key:'order',route:'order_id = 103 → maintained directory → A',a:'Local order-ID index finds 103.',b:'Not searched after a valid directory lookup',c:'Not searched after a valid directory lookup',p:'Not needed',result:'The directory supplies the customer group. Without it or another routing index, search A, B and C.'},
 {label:'Create purchase 103',key:'purchase',route:'customer_id = 1 → A; product IDs → P',a:'Create order 103, its lines and the durable request result.',b:'No Tariq order work',c:'No Edda order work',p:'Guard P7: 1 → 0 and P3: 12 → 10.',result:'A and P need one atomic outcome. Global identity and reference enforcement can add further work.'}
];
---
<figure class="pg-figure" data-pg-routing aria-labelledby="pg-routing-title">
 <figcaption id="pg-routing-title"><span class="figure-number">Figure 2</span> From a request to its owners</figcaption>
 <label class="pg-option">Request <select data-request>{requests.map((r,i)=><option value={i}>{r.label}</option>)}</select></label>
 <div class="entry"><strong>Application router</strong><span data-route data-live>{requests[0].route}</span></div>
 <div class="arrow" aria-hidden="true">↓ choose owners, then run SQL ↓</div>
 <div class="owners">
  <div data-owner="A"><strong>A · Mina’s customer group</strong><span data-a data-live>Waiting</span></div>
  <div data-owner="B"><strong>B · Tariq’s customer group</strong><span data-b data-live>Waiting</span></div>
  <div data-owner="C"><strong>C · Edda’s customer group</strong><span data-c data-live>Waiting</span></div>
  <div data-owner="P"><strong>P · shared products</strong><span data-p data-live>Waiting</span></div>
 </div>
 <p class="pg-explanation" data-explanation data-live aria-live="polite">Start with the information on the request.</p>
 <div class="pg-controls" role="group" aria-label="Figure 2 controls"><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step>1 / 3</span></div>
 <div class="pg-hold" data-hold aria-hidden="true"><span></span></div>
 <p class="pg-caption">Illustrative application placement: A/B/C own related customer, order, line and payment records; P owns shared products. The purchase is an independent replay from before 103. Owner counts omit replicas and any additional constraint participants.</p>
 <details><summary>Requests as text</summary><ul>{requests.map(r=><li><strong>{r.label}.</strong> {r.route}. {r.a} {r.p} {r.result}</li>)}</ul></details>
 <script define:vars={{ requests }}>window.__pgRequests = requests;</script>
</figure>
<script>
 import { stepper } from '../figures/stepper.mjs';
 const root=document.querySelector('[data-pg-routing]');
 if(root){
 const cases=(window as any).__pgRequests;
 const choice=root.querySelector('select')!;
 const player=stepper(root,{steps:()=>3,draw:(step)=>{
  const r=cases[Number(choice.value)];
  root.querySelector('[data-route]')!.textContent=r.route;
  ['a','b','c','p'].forEach(k=>{root.querySelector(`[data-${k}]`)!.textContent=step===0?'Waiting':r[k];});
  root.querySelectorAll('[data-owner]').forEach(el=>el.classList.toggle('active',step>0&&(el.getAttribute('data-owner')==='A'||(r.key==='purchase'&&el.getAttribute('data-owner')==='P'))));
  root.querySelector('[data-explanation]')!.textContent=step===0?'Start with the information on the request.':step===1?'Routing selects a database owner. Its indexes and executor still have to find and process the rows.':r.result;
 }});
 choice.addEventListener('change',()=>{root.querySelector<HTMLButtonElement>('[data-reset]')!.click();player.render();});
 }
</script>
