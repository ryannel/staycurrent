---
import { deletionSteps } from './model.mjs';
const destinations = ['Profile · customer 1', 'Earlier profile versions', 'Generated invoice PDF', 'Search copy', 'Affected backups'];
---
<figure class="history-figure" data-deletion aria-labelledby="deletion-title">
  <figcaption id="deletion-title"><span class="figure-number">Figure 5</span> One request, several places to finish</figcaption>
  <div class="history-scene">
    <p class="deletion-scope">Hypothetical approved scope → profile and copies removed; any permitted purchase facts retained separately.</p>
    <ol class="deletion-destinations">{destinations.map((destination, i) => <li><span>{destination}</span><strong data-status data-live>{deletionSteps[0].statuses[i]}</strong></li>)}</ol>
    <p class="history-explanation" data-explanation data-live aria-live="polite">{deletionSteps[0].explanation}</p>
    <div class="history-controls" role="group" aria-label="Figure 5 controls">
      <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 5</span>
    </div>
    <div class="history-hold" data-hold aria-hidden="true"><span></span></div>
  </div>
  <p class="history-caption">An illustrative workflow, with a failed search deletion and later backup expiry. No retention duration or legal outcome is assumed. “Verified” describes the checks this design requires; the drawing is not a run against real services.</p>
  <details class="history-alt"><summary>All steps as text</summary><ol>{deletionSteps.map(step => <li>{step.explanation}</li>)}</ol></details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  import { deletionSteps } from './model.mjs';
  document.querySelectorAll<HTMLElement>('[data-deletion]').forEach(root => stepper(root, {
    steps: () => deletionSteps.length,
    draw: (index: number) => {
      const step = deletionSteps[index];
      root.querySelectorAll<HTMLElement>('[data-status]').forEach((status, i) => {
        status.textContent = step.statuses[i];
        status.classList.toggle('needs-work', /Pending|pending|Failed|In scope/.test(step.statuses[i]));
        status.classList.toggle('verified', /verified/i.test(step.statuses[i]));
      });
      root.querySelector('[data-explanation]')!.textContent = step.explanation;
    },
  }));
</script>
