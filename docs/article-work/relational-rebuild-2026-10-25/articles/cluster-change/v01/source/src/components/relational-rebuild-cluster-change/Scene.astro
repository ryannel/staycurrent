---
import { copyStages, memberships, connectivity, quorum, backlog } from './model.mjs';
import './figures.css';
const { kind } = Astro.props;
const copy = kind === 'copy';
const member = kind === 'membership';
const figure = copy ? 1 : member ? 3 : 4;
const title = copy ? 'A finished base copy can still be behind' : member ? 'Test the same voters at three checkpoints' : 'Work arrives while the backlog drains';
const id = `cluster-${kind}`;
---
<figure class="cluster-scene" data-kind={kind} aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`}><span class="fig-number">Figure {figure}</span> {title}</figcaption>
  <div class="cluster-panel">
    {member && <label class="cluster-option">Communicating voters
      <select data-option aria-label="Communicating voters">{connectivity.map(x => <option value={x.value}>{x.label}</option>)}</select>
    </label>}
    {!copy && !member && <label class="cluster-option">Replay capacity
      <select data-option aria-label="Replay capacity"><option value="20">20 MiB/s</option><option value="10">10 MiB/s</option><option value="8">8 MiB/s</option></select>
    </label>}
    <p class="cluster-stage" data-title data-live>{copy ? copyStages[0].title : member ? memberships[0].title : '0 seconds after the base copy'}</p>
    {copy && <div data-chart data-live>
      <p class="cluster-group-label">Old voting group · majority 2 of 3</p>
      <div class="cluster-voters">{['R1','R2','R3'].map(x => <div class="cluster-card"><strong>{x}{x === 'R1' ? ' · leader' : ''}</strong><span>b · durable</span><span>20.00 applied</span></div>)}</div>
      <p class="cluster-arrow">↓ consistent base b + later agreed history</p>
      <div class="cluster-destination"><strong>R4 · learner · no vote</strong><div class="cluster-chunks">{[0,1,2,3].map(() => <span class="cluster-chunk">·</span>)}</div><p>Base: 0 of 4 chunks</p><p>U: absent · Applied price: —</p></div>
    </div>}
    {member && <div data-chart data-live>
      <div class="cluster-member-cards">{['R1','R2','R3','R4'].map(x => <div class="cluster-card"><strong>{x}</strong><span>{x === 'R4' ? 'learner' : 'voter'}</span></div>)}</div>
      <div class="cluster-quorums"><div class="cluster-quorum"><strong>Old · R1 R2 R3</strong><span>3 present · need 2</span><b>Required · passes</b></div><span class="cluster-and">AND</span><div class="cluster-quorum"><strong>New · R1 R2 R4</strong><span>3 present · need 2</span><b>Not yet active</b></div></div>
      <p class="cluster-verdict">Required quorum is present</p>
    </div>}
    {!copy && !member && <div data-chart data-live>
      <div class="cluster-flow"><span>+10 MiB/s<br/>new history</span><span>→</span><span>Backlog<br/><strong>600 MiB</strong></span><span>→</span><span>Up to 20 MiB/s<br/>replay</span></div>
      <div class="cluster-track"><span style="width:71.4286%"></span></div>
      <p class="cluster-verdict">600 MiB left · net reduction 10 MiB/s</p>
    </div>}
    <p class="cluster-explanation" data-explanation data-live aria-live="polite">{copy ? copyStages[0].explanation : member ? memberships[0].explanation : 'The base copy is installed, leaving 600 MiB of later history to apply. New history continues to arrive at an assumed 10 MiB/s.'}</p>
    <div class="cluster-controls" role="group" aria-label={`Figure ${figure} controls`}>
      <button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / {copy ? 6 : member ? 3 : 4}</span>
    </div>
    <div class="cluster-hold" data-hold aria-hidden="true"><span></span></div>
  </div>
  <p class="cluster-caption">{copy ? 'A conceptual schedule for P, with four equal drawn chunks standing for the whole snapshot. b and U are symbolic history markers. No transfer time or byte size is implied. The old voters remain authoritative throughout.' : member ? 'Three assumed configuration checkpoints for replacing R3 with R4. Each selection tests a communicating set at that checkpoint, with healthy durable histories and any necessary election. Next does not execute a membership change; later checkpoints require the preceding protocol steps to have completed.' : 'An illustrative fixed-rate calculation, starting after the base copy. The bar uses one scale, 0–840 MiB. Steps are 0, 30, 60 and 90 seconds; a zero backlog stays zero. No cluster or replay speed was measured.'}</p>
  <details class="cluster-text"><summary>{copy ? 'All copying stages as text' : member ? 'All quorum tests as text' : 'All backlog results as text'}</summary>
    {copy && <ol>{copyStages.map(s => <li><strong>{s.title}.</strong> {s.explanation}</li>)}</ol>}
    {member && <div class="table-scroll" role="region" tabindex="0" aria-label="Quorum results"><table><caption>Structural quorum tests at each assumed checkpoint</caption><thead><tr><th>Communicating set</th><th>Old</th><th>Joint</th><th>New</th></tr></thead><tbody>{connectivity.map(c => <tr><th scope="row">{c.label}</th>{[0,1,2].map(s => <td>{quorum(s,c.members).passes ? 'Passes' : 'No quorum'}</td>)}</tr>)}</tbody></table></div>}
    {!copy && !member && <div class="table-scroll" role="region" tabindex="0" aria-label="Backlog arithmetic"><table><caption>MiB of backlog with 10 MiB/s arriving</caption><thead><tr><th>Replay</th><th>0 s</th><th>30 s</th><th>60 s</th><th>90 s</th></tr></thead><tbody>{[20,10,8].map(r => <tr><th scope="row">{r} MiB/s</th>{[0,30,60,90].map(t => <td>{backlog(r,t)}</td>)}</tr>)}</tbody></table></div>}
  </details>
</figure>

<script>
  import { stepper } from '../figures/stepper.mjs';
  import { copyStages, memberships, connectivity, quorum, backlog } from './model.mjs';
  function element(tag, text, className = '') {
    const el = document.createElement(tag); el.textContent = text; if (className) el.className = className; return el;
  }
  document.querySelectorAll('.cluster-scene[data-kind]').forEach(root => {
    const kind = root.getAttribute('data-kind');
    const title = root.querySelector('[data-title]');
    const chart = root.querySelector('[data-chart]');
    const explanation = root.querySelector('[data-explanation]');
    const select = root.querySelector('select');
    const player = stepper(root, { steps: () => kind === 'copy' ? 6 : kind === 'membership' ? 3 : 4, draw: i => {
      chart.replaceChildren();
      if (kind === 'copy') {
        const s = copyStages[i]; title.textContent = s.title; explanation.textContent = s.explanation;
        chart.append(element('p', 'Old voting group · majority 2 of 3', 'cluster-group-label'));
        const voters = element('div', '', 'cluster-voters');
        ['R1','R2','R3'].forEach(r => { const card = element('div','','cluster-card'); card.append(element('strong',r === 'R1' ? 'R1 · leader' : r),element('span',i >= 2 ? 'b + U · durable' : 'b · durable'),element('span',`${s.oldPrice} applied`)); voters.append(card); });
        chart.append(voters,element('p','↓ consistent base b + later agreed history','cluster-arrow'));
        const dest = element('div','','cluster-destination'); dest.append(element('strong','R4 · learner · no vote'));
        const chunks = element('div','','cluster-chunks'); [0,1,2,3].forEach(n => chunks.append(element('span',n < s.base ? 'b' : '·',`cluster-chunk${n < s.base ? ' filled' : ''}`)));
        dest.append(chunks,element('p',`Base: ${s.base} of 4 chunks`),element('p',`U: ${s.later} · Applied price: ${s.newPrice}`)); chart.append(dest);
      } else if (kind === 'membership') {
        const s = memberships[i]; const available = connectivity.find(c => c.value === select.value).members; const q = quorum(i,available);
        title.textContent = s.title; explanation.textContent = `${s.explanation} ${q.passes ? 'The selected communicating set passes this checkpoint’s quorum count.' : 'The selected set cannot form the required quorum at this checkpoint.'}`;
        const cards = element('div','','cluster-member-cards'); ['R1','R2','R3','R4'].forEach(r => { const card = element('div','','cluster-card'); const role = s.voters.includes(r) ? (i === 1 && r === 'R3' ? 'old voter' : i === 1 && r === 'R4' ? 'new voter' : 'voter') : r === 'R4' ? 'learner' : 'removed'; card.append(element('strong',r),element('span',role),element('span',available.includes(r) ? 'connected' : 'unreachable')); cards.append(card); }); chart.append(cards);
        const counts = element('div','','cluster-quorums');
        [['Old · R1 R2 R3',q.oldCount,s.old],['New · R1 R2 R4',q.newCount,s.next]].forEach(([label,count,required],n) => { if(n) counts.append(element('span','AND','cluster-and')); const box=element('div','','cluster-quorum'); box.append(element('strong',label),element('span',`${count} present · need 2`),element('b',required ? (count >= 2 ? 'Required · passes' : 'Required · missing') : i === 0 ? 'Not yet active' : 'No longer required')); counts.append(box); });
        chart.append(counts,element('p',q.passes ? 'Required quorum is present' : 'Required quorum is missing','cluster-verdict'));
      } else {
        const rate = Number(select.value); const t = [0,30,60,90][i]; const left = backlog(rate,t); const net = rate - 10;
        title.textContent = `${t} seconds after the base copy`;
        const flow=element('div','','cluster-flow'); flow.append(element('span','+10 MiB/s\nnew history'),element('span','→'),element('span',`Backlog\n${left} MiB`),element('span','→'),element('span',`Up to ${rate} MiB/s\nreplay`));
        const track = element('div','','cluster-track'); const fill = element('span',''); fill.style.width = `${left/840*100}%`; track.append(fill);
        chart.append(flow,track,element('p',left === 0 ? '0 MiB left · caught up; new history still arrives' : `${left} MiB left · ${net > 0 ? `net reduction ${net}` : net === 0 ? 'no net reduction: 0' : `net growth ${-net}`} MiB/s`,'cluster-verdict'));
        explanation.textContent = net > 0 ? `Replay can remove ${rate} MiB/s while ${10} MiB/s arrives. Only ${net} MiB/s reduces the old backlog. At these fixed rates, 600 ÷ ${net} = ${600/net} seconds reaches zero; matching new work must continue afterwards.` : net === 0 ? 'Every MiB replay can apply is replaced by one arriving MiB. Time passes but the backlog stays at 600 MiB.' : `Incoming history exceeds replay by ${-net} MiB/s. After ${t} seconds, the backlog is 600 + ${-net} × ${t} = ${left} MiB. Waiting alone makes this move further behind.`;
      }
    }});
    select?.addEventListener('change', () => player.render());
  });
</script>
