<figure class="pgx-figure" data-range-figure aria-label="Two attempts against one reservation">
  <figcaption><span>Figure 1</span> Two attempts against one reservation</figcaption>
  <div class="pgx-options"><label>Attempt <select data-attempt><option value="7002">7002 · 10:30–11:30</option><option value="7003">7003 · 11:00–12:00</option></select></label></div>
  <div class="pgx-scene">
    <p class="pgx-small">Room R1 · 2 November 2026 · UTC · [start, end)</p>
    <svg viewBox="0 0 600 220" role="img" aria-label="Reservation 7001 from 10 to 11, compared with the selected attempt. Filled start dots are included; open end dots are excluded.">
      <path class="pgx-rule" d="M95 45H555 M95 45V190 M210 45V190 M325 45V190 M440 45V190 M555 45V190" />
      <g class="pgx-svg-text"><text x="95" y="25" text-anchor="middle">10:00</text><text x="210" y="25" text-anchor="middle">10:30</text><text x="325" y="25" text-anchor="middle">11:00</text><text x="440" y="25" text-anchor="middle">11:30</text><text x="555" y="25" text-anchor="middle">12:00</text><text x="8" y="89">7001</text><text data-attempt-label x="8" y="159">7002</text></g>
      <path class="pgx-range-base" d="M95 85H325"/><circle class="pgx-start" cx="95" cy="85" r="7"/><circle class="pgx-end" cx="325" cy="85" r="7"/>
      <g data-proposal><path class="pgx-range-proposal" d="M210 155H440"/><circle class="pgx-start pgx-proposal-dot" cx="210" cy="155" r="7"/><circle class="pgx-end pgx-proposal-end" cx="440" cy="155" r="7"/></g>
      <rect data-overlap class="pgx-overlap" x="210" y="58" width="115" height="123" hidden />
      <text data-boundary x="325" y="212" text-anchor="middle" class="pgx-svg-text" hidden>11:00 belongs only to 7003</text>
    </svg>
    <p class="pgx-result" data-range-result data-live>Compare the time ranges, then apply the same-room rule.</p>
    <p data-explanation data-live aria-live="polite">7001 is stored. The selected attempt is a separate proposal for the same room.</p>
  </div>
  <div class="pgx-controls" role="group" aria-label="Figure 1 playback"><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step>1 / 3</span><div data-hold><span></span></div></div>
  <p class="pgx-caption">Filled starts are included; open ends are excluded. Each attempt starts independently from 7001. This models the checked predicates and constraint outcomes, rather than a concurrent execution.</p>
  <details><summary>All stages, as text</summary><ol><li>7001 reserves R1 from 10:00 up to 11:00 UTC.</li><li>7002 shares 10:30 up to 11:00 with it. Their ranges overlap. 7003 starts at the excluded end of 7001: they adjoin without overlap.</li><li>The same-room exclusion refuses 7002 and permits 7003. A different room would not satisfy both forbidden comparisons.</li></ol></details>
</figure>
<script>
import {stepper} from '../figures/stepper.mjs';
for(const root of document.querySelectorAll<HTMLElement>('[data-range-figure]')) {
 const select=root.querySelector<HTMLSelectElement>('[data-attempt]')!;
 const player=stepper(root,{steps:()=>3,draw:(step:number)=>{
  const adjacent=select.value==='7003'; const proposal=root.querySelector<SVGGElement>('[data-proposal]')!;
  proposal.setAttribute('transform',adjacent?'translate(115 0)':'translate(0 0)');
  root.querySelector('[data-attempt-label]')!.textContent=select.value;
  root.querySelector('[data-overlap]')!.toggleAttribute('hidden',adjacent||step===0);
  root.querySelector('[data-boundary]')!.toggleAttribute('hidden',!adjacent||step===0);
  root.querySelector('[data-range-result]')!.textContent=step===0?'Compare the time ranges, then apply the same-room rule.':step===1?(adjacent?'&& false · -|- true · no shared instant':'&& true · shared time 10:30–11:00'):(adjacent?'Same room + no overlap → attempt permitted':'Same room + overlap → attempt refused');
  root.querySelector('[data-explanation]')!.textContent=step===0?'7001 is stored. The selected attempt is a separate proposal for the same room.':step===1?(adjacent?'7001 excludes 11:00; 7003 includes it. Touching boundaries do not double-book an instant.':'Both ranges include 10:30 and continue together until the excluded 11:00 end of 7001.'):(adjacent?'The exclusion rule has no pair for which both room equality and time overlap are true.':'Both comparisons are true. The exclusion constraint rejects 7002; an ordinary search alone would not enforce this rule.');
 }});select.addEventListener('change',()=>player.render());
}
</script>
