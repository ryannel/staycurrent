<figure class="crh-read-figure" aria-labelledby="price-figure-title" data-price-history>
  <figcaption><span class="crh-number">Figure 1</span><span id="price-figure-title">Two reads around one price change</span></figcaption>
  <div class="crh-frame">
    <div class="crh-choice"><label for="read-mode">Read choice</label><select id="read-mode" data-mode><option value="serializable">Serializable</option><option value="committed">Read Committed</option><option value="historical">Fixed historical time H</option></select></div>
    <div class="crh-history" aria-label="P7 committed price history">
      <div class="crh-version"><span>Earlier committed version</span><strong>P7 · 20.00</strong></div><div class="crh-commit"><span>Price update commits</span><strong>C →</strong></div><div class="crh-version"><span>Later committed version</span><strong>P7 · 22.00</strong></div>
    </div>
    <div class="crh-read-lanes">
      <div class="crh-lane"><span>First SELECT<br/><small>before commit C</small></span><strong data-first data-live>—</strong><span data-first-time data-live>not run</span></div>
      <div class="crh-lane"><span>Second SELECT<br/><small>after commit C</small></span><strong data-second data-live>—</strong><span data-second-time data-live>not run</span></div>
    </div>
    <p class="crh-explanation" data-explanation data-live aria-live="polite">The transaction starts while P7 costs 20.00. The price update is a separate transaction.</p>
    <div class="crh-controls" role="group" aria-label="Price history playback"><button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 4</span></div><div class="crh-hold" data-hold><span></span></div>
  </div>
  <p class="crh-caption">A conceptual schedule. H is a database timestamp before C. The fixed historical transaction chooses H once; Read Committed chooses a new snapshot for the second statement. The price changes independently of order 103, whose agreed line prices and 29.00 total stay fixed.</p>
  <details><summary>Read the schedule as text</summary><ol><li>The reader starts before the independent update; P7 is 20.00.</li><li>The first SELECT returns 20.00.</li><li>The update to 22.00 commits at C.</li><li>A second SELECT in the same Serializable transaction returns 20.00. Under Read Committed it returns 22.00. A transaction fixed at historical H before C returns 20.00.</li></ol></details>
</figure>
<script>
import { stepper } from '../figures/stepper.mjs';
for (const root of document.querySelectorAll('[data-price-history]')) {
 const mode=root.querySelector('[data-mode]') as HTMLSelectElement;
 const text=(selector:string,value:string)=>{root.querySelector(selector)!.textContent=value};
 const explanations={
  serializable:['The transaction starts while P7 costs 20.00. The price update is a separate transaction.','The first SELECT reads 20.00 in this transaction’s coherent history.','The other transaction commits 22.00. This reader has already observed 20.00.','The second SELECT still returns 20.00. Both reads belong to one Serializable transaction. A fresh current transaction can read 22.00.'],
  committed:['The Read Committed transaction starts while P7 costs 20.00.','The first statement’s snapshot gives 20.00.','The independent update commits 22.00 before the next statement starts.','The next statement takes a new snapshot and returns 22.00. Both answers were committed values.'],
  historical:['The reader deliberately chooses one historical timestamp H before commit C.','The first SELECT reads P7 as of H: 20.00.','The independent update commits at C, later than H. The fixed view stays at H.','The second SELECT also reads as of H and returns 20.00, even if it runs much later.']
 };
 const player=stepper(root,{steps:()=>4,draw:(step:number)=>{
  const value=mode.value as keyof typeof explanations;
  text('[data-first]',step>=1?'20.00':'—');text('[data-first-time]',step>=1?(value==='historical'?'history H':'first snapshot'):'not run');
  text('[data-second]',step>=3?(value==='committed'?'22.00':'20.00'):'—');text('[data-second-time]',step>=3?(value==='historical'?'same H':value==='committed'?'new statement snapshot':'same transaction history'):'not run');
  text('[data-explanation]',explanations[value][step]);
  root.querySelector('.crh-commit')!.classList.toggle('reached',step>=2);
 }});mode.addEventListener('change',()=>player.render());
}
</script>
<style>
.crh-read-figure{margin:2rem 0;font: .86rem/1.5 var(--font-sans);color:var(--color-text)}figcaption{display:flex;gap:.8rem;align-items:baseline;margin-bottom:.6rem;font:1.15rem/1.35 var(--font-serif)}.crh-number{font:.65rem var(--font-sans);text-transform:uppercase;letter-spacing:.09em;color:var(--color-text-secondary);white-space:nowrap}.crh-frame{border:1px solid var(--color-rule-strong);background:var(--color-surface-alt);padding:1.1rem}.crh-choice{display:flex;gap:.7rem;flex-wrap:wrap;align-items:center;margin-bottom:1.3rem}select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-text-secondary);border-radius:4px;padding:.4rem .65rem}button{cursor:pointer;min-height:2.65rem}button[aria-disabled=true]{opacity:.55}select:focus-visible,button:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}.crh-history{display:grid;grid-template-columns:1fr .8fr 1fr;gap:.5rem;align-items:stretch}.crh-version{padding:.65rem;border:1px solid var(--color-rule-strong);display:flex;flex-direction:column;gap:.4rem}.crh-version strong{font-size:1.15rem}.crh-version span,.crh-commit span{font-size:.73rem;color:var(--color-text-secondary)}.crh-commit{display:flex;flex-direction:column;justify-content:center;text-align:center;border-bottom:2px solid var(--color-rule-strong)}.crh-commit.reached{border-color:var(--color-accent)}.crh-commit strong{font-size:1.2rem}.crh-read-lanes{margin-top:1rem}.crh-lane{display:grid;grid-template-columns:1.2fr .65fr 1.2fr;align-items:center;gap:.6rem;padding:.7rem 0;border-bottom:1px solid var(--color-rule-strong)}.crh-lane strong{font-size:1.5rem;color:var(--color-accent)}.crh-lane small{color:var(--color-text-secondary)}.crh-lane>span:last-child{font-size:.75rem}.crh-explanation{border-left:3px solid var(--color-accent);padding-left:.8rem;min-height:4.8em}.crh-controls{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap}.crh-controls>span{margin-left:auto;font-size:.75rem}.crh-hold{height:3px;background:var(--color-rule);margin-top:.8rem}.crh-hold span{display:block;height:100%;background:var(--color-accent);width:0}.crh-caption{color:var(--color-text-secondary);font-size:.8rem;margin:.65rem 0}.crh-read-figure details{font-size:.8rem}.crh-read-figure summary{cursor:pointer}@media(max-width:450px){.crh-frame{padding:.8rem}.crh-history{grid-template-columns:1fr}.crh-commit{flex-direction:row;gap:1rem;padding:.2rem}.crh-lane{grid-template-columns:1fr .65fr 1fr;gap:.4rem}.crh-explanation{min-height:7em}}
</style>
