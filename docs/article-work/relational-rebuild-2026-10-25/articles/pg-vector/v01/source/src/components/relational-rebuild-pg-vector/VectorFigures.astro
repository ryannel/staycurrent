---
interface Props { kind: 'distance'|'filter'|'hnsw'|'ivf'; }
const {kind}=Astro.props;
const info={
 distance:{number:1,title:'The query supplies the order',caption:'Invented two-dimensional vectors. The query and P7 share [1,0]. The coordinates have no learned meaning. Scaling P9 is a separate numerical variation; it changes no catalogue fact.'},
 filter:{number:2,title:'Nearest in stock is a different question',caption:'The independent post-103 shop copy has stock P7=0, P9=4 and P3=10. Distances use the original unscaled vectors from Figure 1, with L2 and k=2. The stages describe the query’s meaning, not an observed executor schedule.'},
 hnsw:{number:3,title:'A closer point beyond a worse step',caption:'A deliberately chosen graph, not a dump of a pgvector index. A–E are mathematical points at distances 9, 5, 2, 3 and 0.5 from the query. Horizontal positions show links, not a geometric scale. The two exploration choices are a simplified candidate-list model, not particular ef_search values.'},
 ivf:{number:4,title:'A nearby point across a list boundary',caption:'A one-dimensional mathematical example, independent of the shop vectors. Chosen centres are 0, 4 and 8. Points are assigned to the closest centre. The query at 1.9 is nearer centre 0, but its nearest point B=2.1 is assigned to centre 4. These centres were chosen, not learned by a captured index build.'}
}[kind];
---
<figure class="vf" data-vector-figure={kind} aria-label={`Figure ${info.number} ${info.title}`}>
 <figcaption><span>Figure {info.number}</span> {info.title}</figcaption>
 <div class="vf-surface">
 {kind==='distance' && <>
  <div class="vf-options"><label>Distance <select data-metric><option value="l2">L2 · &lt;-&gt;</option><option value="cos">Cosine · &lt;=&gt;</option><option value="ip">Negative inner product · &lt;#&gt;</option></select></label><label><input type="checkbox" data-scale/> Double P9’s coordinates</label></div>
  <div class="vf-distance">
   <svg viewBox="0 0 320 230" role="img" aria-label="P3, P7, P9 and the query drawn as arrows from the origin. The table gives their coordinates and distances.">
    <path class="vf-axis" d="M35 195H300M35 195V15"/><text x="290" y="216">x</text><text x="15" y="22">y</text><text x="17" y="211">0</text>
    <path class="vf-guide" d="M155 195V65M35 65H155"/><text x="151" y="215">1</text><text x="15" y="70">1</text>
    <line class="vf-arrow" x1="35" y1="195" x2="35" y2="65"/><circle class="vf-dot" cx="35" cy="65" r="5"/><text x="47" y="54">P3 [0,1]</text>
    <line class="vf-query" x1="35" y1="195" x2="155" y2="195"/><circle class="vf-dot" cx="155" cy="195" r="6"/><text x="170" y="187">query = P7</text>
    <line class="vf-arrow vf-p9-line" x1="35" y1="195" x2="131" y2="117"/><circle class="vf-p9-dot vf-dot" cx="131" cy="117" r="5"/><text class="vf-p9-label" x="140" y="107">P9 [0.8,0.6]</text>
   </svg>
   <div><p class="vf-request">Query [1,0]</p><table><thead><tr><th>Row</th><th>Vector</th><th data-metric-label>L2</th></tr></thead><tbody data-distance-rows><tr><td>P7</td><td>[1,0]</td><td>0</td></tr><tr><td>P9</td><td>[0.8,0.6]</td><td>0.632</td></tr><tr><td>P3</td><td>[0,1]</td><td>1.414</td></tr></tbody></table></div>
  </div>
  <p data-distance-explanation data-live class="vf-explanation" aria-live="polite">L2 measures the straight-line gap. P7 is closest, then P9, then P3.</p>
 </>}
 {kind==='filter' && <>
  <label class="vf-options">Request <select data-path><option value="eligible">Filter, then choose two</option><option value="global">Choose two, then filter</option></select></label>
  <p class="vf-request" data-request data-live>WHERE stock &gt; 0 · ORDER BY distance · LIMIT 2</p>
  <div class="vf-product-rows">
   <div data-product="P7"><strong>P7</strong><span>Blue mug</span><span>stock 0</span><span>distance 0</span><b data-status data-live>not tested</b></div>
   <div data-product="P9"><strong>P9</strong><span>Teapot</span><span>stock 4</span><span>distance 0.632</span><b data-status data-live>not tested</b></div>
   <div data-product="P3"><strong>P3</strong><span>Green tea, 50 g</span><span>stock 10</span><span>distance 1.414</span><b data-status data-live>not tested</b></div>
  </div>
  <p class="vf-answer" data-answer data-live>Answer: not chosen</p>
 </>}
 {kind==='hnsw' && <>
  <label class="vf-options">Ground-layer exploration <select data-width><option value="narrow">Keep one candidate</option><option value="wide">Keep two candidates</option></select></label>
  <svg viewBox="0 0 360 255" role="img" aria-label="Upper layer links A to C. On the ground layer A connects through B, C and D to E. E is nearest, but reaching it from C needs exploration through the farther D.">
   <text x="12" y="22">Upper layer · long links</text><path class="vf-edge" d="M35 65H180"/>
   <g data-node="A-top"><circle cx="35" cy="65" r="19"/><text x="35" y="70">A</text></g><g data-node="C-top"><circle cx="180" cy="65" r="19"/><text x="180" y="70">C</text></g><path class="vf-guide" d="M180 86V160"/>
   <text x="12" y="126">Ground layer · explore more routes</text><path class="vf-edge" d="M35 183H325"/>
   {['A','B','C','D','E'].map((id,i)=><g data-node={id}><circle cx={35+i*72.5} cy="183" r="19"/><text x={35+i*72.5} y="188">{id}</text><text class="vf-node-distance" x={35+i*72.5} y="223">{[9,5,2,3,0.5][i]}</text></g>)}
   <text x="12" y="249">Numbers below nodes: distance to the query</text>
  </svg>
  <p class="vf-answer" data-answer data-live>Search starts above the ground layer.</p>
 </>}
 {kind==='ivf' && <>
  <label class="vf-options">Lists probed <select data-probes><option value="1">1 · closest centre</option><option value="2">2 · include the next centre</option></select></label>
  <svg viewBox="0 0 360 160" role="img" aria-label="On a number line the query is 1.9, just left of boundary 2. Point B at 2.1 is closest but belongs to the list centred at 4.">
   <path class="vf-axis" d="M20 100H340"/><path class="vf-guide" d="M96 15V125"/><text x="100" y="27">boundary 2</text>
   <circle class="vf-dot" cx="20" cy="100" r="4"/><text x="14" y="141">0</text><circle class="vf-dot" cx="172" cy="100" r="4"/><text x="168" y="141">4</text><circle class="vf-dot" cx="324" cy="100" r="4"/><text x="320" y="141">8</text>
   <circle class="vf-dot" cx="35.2" cy="100" r="5"/><text x="27" y="78">A=0.4</text><path class="vf-query" d="M92.2 48V98"/><text x="21" y="43">query 1.9</text><circle class="vf-dot vf-nearest" cx="99.8" cy="100" r="5"/><path class="vf-guide" d="M99.8 96L129 65"/><text x="125" y="57">B=2.1</text><text x="162" y="78">C=4</text>
  </svg>
  <div class="vf-lists">
   <div data-list="0"><strong>Centre 0</strong><span>query → centre: 1.9</span><p>A · query distance 1.5</p><b data-status data-live>not searched</b></div>
   <div data-list="1"><strong>Centre 4</strong><span>query → centre: 2.1</span><p>B · 0.2<br/>C · 2.1</p><b data-status data-live>not searched</b></div>
   <div data-list="2"><strong>Centre 8</strong><span>query → centre: 6.1</span><p>D=8 · 6.1</p><b data-status data-live>not searched</b></div>
  </div>
  <p class="vf-answer" data-answer data-live>Find the closest list centre first.</p>
 </>}
 {kind!=='distance' && <>
 <p class="vf-explanation" data-explanation data-live aria-live="polite"></p>
 <div class="vf-hold" data-hold aria-hidden="true"><span></span></div>
 <div class="vf-controls" role="group" aria-label={`Figure ${info.number} playback`}><button data-play type="button">Play</button><button data-back type="button">Back</button><button data-next type="button">Next</button><button data-reset type="button">Reset</button><span data-step>1 / 4</span></div>
 </>}
 </div>
 <p class="vf-caption">{info.caption}</p>
 {kind!=='distance' && <details class="vf-alternative"><summary>All stages, as text</summary><div data-all-stages></div></details>}
</figure>
<script>
import {stepper} from '../figures/stepper.mjs';
const boot=()=>{
 document.querySelectorAll<HTMLElement>('[data-vector-figure]').forEach(root=>{
  if(root.dataset.ready) return; root.dataset.ready='true';
  const kind=root.dataset.vectorFigure;
  if(kind==='distance'){
   const metric=root.querySelector<HTMLSelectElement>('[data-metric]')!;
   const scale=root.querySelector<HTMLInputElement>('[data-scale]')!;
   const render=()=>{
    const factor=scale.checked?2:1; const m=metric.value;
    const rows=[{id:'P7',v:[1,0]},{id:'P9',v:[0.8*factor,0.6*factor]},{id:'P3',v:[0,1]}].map(p=>({...p,d:m==='l2'?Math.hypot(p.v[0]-1,p.v[1]):m==='cos'?1-p.v[0]/Math.hypot(...p.v):-p.v[0]})).sort((a,b)=>a.d-b.d);
    root.querySelector('[data-distance-rows]')!.innerHTML=rows.map(p=>`<tr><td>${p.id}</td><td>[${p.v.join(',')}]</td><td>${Math.abs(p.d)<1e-10?'0':Number(p.d.toFixed(3))}</td></tr>`).join('');
    root.querySelector('[data-metric-label]')!.textContent=m==='l2'?'L2':m==='cos'?'Cosine':'−inner product';
    const x=35+96*factor,y=195-78*factor;
    root.querySelector('.vf-p9-line')!.setAttribute('x2',String(x));root.querySelector('.vf-p9-line')!.setAttribute('y2',String(y));root.querySelector('.vf-p9-dot')!.setAttribute('cx',String(x));root.querySelector('.vf-p9-dot')!.setAttribute('cy',String(y));
    const label=root.querySelector('.vf-p9-label')!;label.setAttribute('x',String(scale.checked?x-9:x+9));label.setAttribute('text-anchor',scale.checked?'end':'start');label.setAttribute('y',String(y-10));label.textContent=scale.checked?'P9 [1.6,1.2]':'P9 [0.8,0.6]';
    root.querySelector('[data-distance-explanation]')!.textContent=(m==='l2'?'L2 measures the straight-line gap. ':m==='cos'?'Cosine compares direction; doubling P9 leaves its angle and cosine distance unchanged. ':(scale.checked?'Negative inner product puts the largest dot product first. P9’s −1.6 now comes before P7’s −1. ':'Negative inner product puts the largest dot product first. P7’s −1 comes before P9’s −0.8. Double P9 to change the order. '))+`Order: ${rows.map(p=>p.id).join(', ')}. Smaller scores come first.`;
   };metric.addEventListener('change',render);scale.addEventListener('change',render);render();return;
  }
  const select=root.querySelector<HTMLSelectElement>('select')!;
  const states=()=>kind==='filter'?(select.value==='eligible'?[
   'Ask for the two nearest products whose stock is greater than zero. All three rows are still visible.',
   'Check eligibility. P7 has stock zero and leaves the population before the nearest two are chosen.',
   'Compare distances for P9 and P3. They are both eligible; P9 is closer to the query.',
   'Return P9 and P3. Two eligible rows exist, so the exact answer contains two rows.'
  ]:[
   'Ask for the global nearest two, then test stock outside that limited result. This is another question.',
   'Compare all distances. P7 is closest, P9 is second, and P3 is third.',
   'LIMIT 2 keeps P7 and P9. P3 is outside the chosen result even though it is in stock.',
   'Reject P7 because stock is zero. Only P9 remains. Filtering cannot bring P3 back through the earlier limit.'
  ]):kind==='hnsw'?(select.value==='narrow'?[
   'Start at A in the sparse upper layer. Its distance to the query is 9.',
   'Follow the upper link to C, distance 2, then descend to C in the ground layer.',
   'C reveals neighbours B at 5 and D at 3. Keeping only the best candidate retains C and discards both farther routes.',
   'Stop with C, distance 2. E at 0.5 is closer, but its route through D was not explored.'
  ]:[
   'Start at A in the same sparse upper layer. Its distance to the query is 9.',
   'Follow the upper link to C, distance 2, then descend to C in the ground layer.',
   'C reveals B at 5 and D at 3. Keeping two candidates retains C and D, leaving a route to explore.',
   'Explore D. Its link reveals E, distance 0.5. E replaces a worse candidate, at the cost of more distance tests.',
   'Return E, the closest point in this chosen graph. A larger search budget helped here; it is not a general proof of exact retrieval.'
  ]):(select.value==='1'?[
   'Compare the query with the three centres. Centre 0 is closest at distance 1.9; centre 4 follows at 2.1.',
   'Probe only the list centred at 0. Compute the query distance for A: 1.5.',
   'Return A. B is much closer at 0.2, but belongs to the unprobed list centred at 4.'
  ]:[
   'Compare the query with the same three centres. Keep the two closest: 0 and 4.',
   'Probe both lists. Compare A at 1.5, B at 0.2 and C at 2.1 with the query.',
   'Return B at 0.2. Searching another list recovered the missed neighbour and computed more point distances.'
  ]);
  const all=()=>{root.querySelector('[data-all-stages]')!.innerHTML='<ol>'+states().map(s=>`<li>${s}</li>`).join('')+'</ol>';};
  const player=stepper(root,{steps:()=>states().length,draw:(s:number)=>{
   root.querySelector('[data-explanation]')!.textContent=states()[s];
   if(kind==='filter'){
    const eligible=select.value==='eligible';root.querySelector('[data-request]')!.textContent=eligible?'WHERE stock > 0 · ORDER BY distance · LIMIT 2':'ORDER BY distance · LIMIT 2 inside · WHERE stock > 0 outside';
    root.querySelectorAll<HTMLElement>('[data-product]').forEach(row=>{
     const id=row.dataset.product;let status='not tested';
     if(s>0){if(eligible) status=id==='P7'?'rejected · stock 0':s>1?(s===3?'returned':'eligible · ranked'):'eligible';else status=s===1?'ranked':id==='P3'?'outside LIMIT':s===3?(id==='P7'?'rejected · stock 0':'returned'):'inside LIMIT';}
     row.querySelector('[data-status]')!.textContent=status;row.dataset.state=status.startsWith('returned')?'selected':status.includes('rejected')||status.includes('outside')?'rejected':'';
    });
    root.querySelector('[data-answer]')!.textContent=s===3?(eligible?'Answer: P9, P3 · 2 rows':'Answer: P9 · 1 row'):'Answer: not chosen';
   } else if(kind==='hnsw'){
    root.querySelectorAll<HTMLElement>('[data-node]').forEach(node=>{const id=node.dataset.node!;node.dataset.state=(s===0?id==='A-top':s===1?id==='C-top'||id==='C':s===2?id==='C'||(select.value==='wide'&&id==='D'):select.value==='wide'?id==='D'||id==='E':id==='C')?'selected':'';});
    root.querySelector('[data-answer]')!.textContent=s===states().length-1?(select.value==='wide'?'Returned E · distance 0.5':'Returned C · distance 2; E missed'):s===2?(select.value==='wide'?'Retained: C, D':'Retained: C'):'Follow links from the upper layer.';
   } else {
    root.querySelectorAll<HTMLElement>('[data-list]').forEach(row=>{const probed=s>0&&Number(row.dataset.list)<Number(select.value);row.dataset.state=probed?'selected':'';row.querySelector('[data-status]')!.textContent=probed?'searched':'not searched';});
    root.querySelector('[data-answer]')!.textContent=s===2?(select.value==='1'?'Returned A · distance 1.5; B missed':'Returned B · distance 0.2'):'Choose lists, then compare their points.';
   }
  }});
  select.addEventListener('change',()=>{root.querySelector<HTMLButtonElement>('[data-reset]')!.click();all();player.render();});all();
 });
};boot();document.addEventListener('astro:page-load',boot);
</script>
<style>
.vf{margin:2.2rem 0;font: .87rem/1.6 var(--font-sans);}
.vf figcaption{font:1.15rem/1.5 var(--font-serif);margin-bottom:.65rem;}
.vf figcaption>span{font:.68rem var(--font-sans);text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-secondary);margin-right:.6rem;}
.vf-surface{border:1px solid var(--color-rule-strong);background:var(--color-surface-alt);padding:1rem;}
.vf-options{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap;font-size:.8rem;margin-bottom:1rem;}
.vf-options label{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;}
.vf select,.vf button{font:inherit;background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-text-secondary);border-radius:3px;padding:.4rem .6rem;max-width:100%;}
.vf button{cursor:pointer;}.vf button[aria-disabled=true]{color:var(--color-text-secondary);border-color:var(--color-rule-strong);}
.vf :is(button,select,input,summary):focus-visible{outline:2px solid var(--color-accent);outline-offset:3px;}
.vf p{font:inherit;margin:.6rem 0;}.vf .vf-caption{font-size:.8rem;color:var(--color-text-secondary);margin:.6rem 0;}
.vf .vf-request{font:.78rem/1.6 var(--font-mono);border-bottom:1px solid var(--color-rule-strong);padding-bottom:.6rem;}
.vf-distance{display:grid;grid-template-columns:1fr 1.15fr;gap:.7rem;align-items:center;}
.vf svg{display:block;width:100%;max-width:440px;margin:.5rem auto;overflow:visible;}
.vf svg text{font:14px var(--font-sans);fill:var(--color-text);}
.vf-axis{fill:none;stroke:var(--color-text-secondary);stroke-width:1.5;}.vf-guide{fill:none;stroke:var(--color-text-secondary);stroke-dasharray:4 4;stroke-width:1;}
.vf-arrow{stroke:var(--color-accent);stroke-width:2.5;}.vf-query{stroke:var(--color-text);stroke-width:3;}.vf-dot{fill:var(--color-accent);stroke:var(--color-text);stroke-width:1;}
.vf-edge{fill:none;stroke:var(--color-text-secondary);stroke-width:2;}
.vf [data-node] circle{fill:var(--color-surface);stroke:var(--color-text-secondary);stroke-width:2;}.vf [data-node] text{text-anchor:middle;font-weight:600;}.vf [data-node] .vf-node-distance{font-weight:400;}
.vf [data-node][data-state=selected] circle{fill:var(--color-surface);stroke:var(--color-accent);stroke-width:4;}
.vf table{display:table;font:.76rem/1.5 var(--font-mono);width:100%;margin:0;}.vf th,.vf td{padding:.4rem .2rem;text-align:left;border-bottom:1px solid var(--color-rule-strong);}.vf th{font-family:var(--font-sans);}
.vf-product-rows{display:grid;gap:.5rem;}.vf-product-rows>div{border:1px solid var(--color-rule-strong);padding:.65rem;display:grid;grid-template-columns:2.4rem 1.4fr .8fr 1fr;gap:.2rem .5rem;}.vf-product-rows b{grid-column:2/-1;font-weight:500;color:var(--color-text-secondary);}.vf-product-rows span{font-size:.8rem;}
.vf [data-state=selected]{border-color:var(--color-accent);box-shadow:inset 3px 0 var(--color-accent);}.vf [data-state=rejected]{border-style:dashed;}
.vf g[data-state=selected]{box-shadow:none;}
.vf .vf-answer{font-weight:600;min-height:1.6em;}
.vf .vf-explanation{border-left:3px solid var(--color-accent);padding:.3rem 0 .3rem .7rem;min-height:5em;margin:1rem 0;}
.vf-controls{display:flex;flex-wrap:wrap;gap:.45rem;align-items:center;border-top:1px solid var(--color-rule-strong);padding-top:.8rem;}.vf-controls>span{margin-left:auto;color:var(--color-text-secondary);font-size:.8rem;}
.vf-hold{height:3px;margin:.6rem 0;background:var(--color-rule);}.vf-hold span{display:block;height:100%;width:0;background:var(--color-accent);}
.vf-lists{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;}.vf-lists>div{padding:.6rem;border:1px solid var(--color-rule-strong);}.vf-lists strong,.vf-lists span{display:block;}.vf-lists span,.vf-lists b{font-size:.75rem;}.vf-lists b{font-weight:500;}
.vf-alternative{font-size:.8rem;color:var(--color-text-secondary);}.vf-alternative summary{cursor:pointer;}.vf-alternative li{margin:.5rem 0;}
@media(min-width:850px){.vf{width:calc(100% + 5rem);margin-left:-2.5rem;}}
@media(max-width:550px){.vf-surface{padding:.75rem;}.vf-distance{grid-template-columns:1fr;}.vf-distance svg{max-width:320px;}.vf-product-rows>div{grid-template-columns:5rem 1fr;}.vf-product-rows b{grid-column:1/-1;}.vf-lists{grid-template-columns:1fr;}.vf-lists>div{display:grid;grid-template-columns:1fr 1fr;gap:.2rem;}.vf-lists p{grid-column:1/2;margin:0;}.vf-lists b{align-self:center;}.vf .vf-explanation{min-height:8em;}.vf-controls>span{font-size:.7rem;}.vf select{font-size:.75rem;}}
</style>
