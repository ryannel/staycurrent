table_name,create_statement
shop.customers,"CREATE TABLE shop.customers (
	customer_id INT8 NOT NULL,
	tenant_id INT8 NOT NULL,
	name STRING NOT NULL,
	CONSTRAINT customers_pkey PRIMARY KEY (customer_id ASC),
	UNIQUE INDEX customers_tenant_id_customer_id_key (tenant_id ASC, customer_id ASC)
) WITH (schema_locked = true);
ALTER TABLE shop.customers ENABLE ROW LEVEL SECURITY, FORCE ROW LEVEL SECURITY;
CREATE POLICY tenant_rows ON shop.customers AS PERMISSIVE FOR ALL TO public USING (tenant_id::STRING = current_setting('application_name':::STRING)) WITH CHECK (tenant_id::STRING = current_setting('application_name':::STRING));"
