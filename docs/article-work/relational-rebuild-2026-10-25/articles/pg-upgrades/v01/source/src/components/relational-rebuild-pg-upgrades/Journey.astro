---
import { scenes } from './model.mjs';
const { kind } = Astro.props;
const scene = scenes[kind];
const first = Object.values(scene.options)[0].steps[0];
---
<figure class="upgrade-journey" data-upgrade-journey={kind} aria-labelledby={`upgrade-${kind}-title`}>
  <figcaption id={`upgrade-${kind}-title`}><span class="fig-number">Figure {scene.number}</span><strong>{scene.title}</strong></figcaption>
  <div class="choice"><label>{scene.label} <select data-option aria-label={`${scene.label} in figure ${scene.number}`}>{Object.entries(scene.options).map(([value, option]) => <option value={value}>{option.label}</option>)}</select></label></div>
  <div class="journey-panels" data-live>
    {[['source',first.source],['transfer',first.transfer],['target',first.target]].map(([name, lines]) => <div class={`journey-panel ${name}`}><p data-panel-label={name}>{lines[0]}</p><strong data-panel-main={name}>{lines[1]}</strong><p data-panel-note={name}>{lines[2]}</p></div>)}
  </div>
  <p class="journey-result" data-result data-live>{first.result}</p>
  <div class="step-story" data-live><p class="step-title" data-title>{first.title}</p><p data-explanation aria-live="polite">{first.explanation}</p></div>
  <div class="journey-controls" role="group" aria-label={`Playback for figure ${scene.number}`}><button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step aria-label="Step">1 / {Object.values(scene.options)[0].steps.length}</span><span class="hold" data-hold aria-hidden="true"><span></span></span></div>
  <p class="journey-caption">{scene.caption}</p>
  <details><summary>Figure as text</summary>{Object.values(scene.options).map(option => <div><p><strong>{option.label}</strong></p><ol>{option.steps.map(step => <li><strong>{step.title}.</strong> {step.explanation} Source: {step.source.slice(1).join('; ')}. Target: {step.target.slice(1).join('; ')}. {step.result}.</li>)}</ol></div>)}</details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  import { scenes } from './model.mjs';
  document.querySelectorAll('[data-upgrade-journey]').forEach(root => {
    const scene = scenes[root.getAttribute('data-upgrade-journey')];
    const option = root.querySelector('select');
    const steps = () => scene.options[option.value].steps;
    const player = stepper(root, { steps: () => steps().length, draw: step => {
      const state = steps()[step];
      for (const panel of ['source','transfer','target']) {
        root.querySelector(`[data-panel-label="${panel}"]`).textContent = state[panel][0];
        root.querySelector(`[data-panel-main="${panel}"]`).textContent = state[panel][1];
        root.querySelector(`[data-panel-note="${panel}"]`).textContent = state[panel][2];
      }
      root.querySelector('[data-title]').textContent = state.title;
      root.querySelector('[data-explanation]').textContent = state.explanation;
      root.querySelector('[data-result]').textContent = state.result;
    }});
    option.addEventListener('change', () => player.render());
  });
</script>
<style>
  .upgrade-journey { margin: 2rem 0; font-family: var(--font-sans); }
  figcaption { display:flex; align-items:baseline; gap:.65rem; margin-bottom:.65rem; }
  figcaption strong { font:400 1.15rem/1.35 var(--font-serif); }
  .fig-number { font-size:.65rem; text-transform:uppercase; letter-spacing:.1em; color:var(--color-text-secondary); white-space:nowrap; }
  .choice { padding:.8rem; background:var(--control-tint); border:1px solid var(--color-rule-strong); font-size:.8rem; }
  select { max-width:100%; padding:.4rem; margin-left:.4rem; border:1px solid var(--control); border-radius:.2rem; background:var(--color-surface); color:var(--color-text); font:inherit; }
  .journey-panels { display:grid; grid-template-columns:1fr 1fr 1fr; gap:.7rem; padding:1rem .8rem; background:var(--color-surface-alt); border-inline:1px solid var(--color-rule-strong); }
  .journey-panel { min-width:0; border:1px solid var(--color-rule-strong); border-top:3px solid var(--teal); padding:.65rem; overflow-wrap:anywhere; }
  .transfer { border-top-color:var(--blue); }
  .target { border-top-color:var(--coral); }
  .journey-panel p { font:.72rem/1.5 var(--font-sans); margin:0; color:var(--color-text-secondary); }
  .journey-panel strong { display:block; font:500 1rem/1.5 var(--font-sans); margin:.5rem 0; }
  .journey-result { border-inline:1px solid var(--color-rule-strong); border-block:1px solid var(--color-rule-strong); background:var(--color-surface-alt); padding:.65rem .9rem; font:500 .82rem/1.5 var(--font-sans); margin:0; }
  .step-story { border-inline:1px solid var(--color-rule-strong); padding:.8rem; }
  .step-story p { font:.82rem/1.6 var(--font-sans); margin:.25rem 0; }
  .step-story .step-title { font-weight:600; }
  .journey-controls { display:flex; flex-wrap:wrap; gap:.4rem; align-items:center; border:1px solid var(--color-rule-strong); background:var(--control-tint); padding:.65rem; }
  button { font:500 .76rem/1.4 var(--font-sans); color:var(--control); background:var(--color-surface); border:1px solid var(--control); border-radius:.25rem; padding:.5rem .65rem; cursor:pointer; }
  button[aria-disabled="true"] { color:var(--color-text-secondary); border-color:var(--color-rule-strong); cursor:default; }
  :is(button,select,summary):focus-visible { outline:3px solid var(--control); outline-offset:3px; }
  [data-step] { margin-left:auto; color:var(--color-text-secondary); font:.73rem var(--font-mono); }
  .hold { flex-basis:100%; height:2px; background:var(--color-rule); }
  .hold > span { display:block; height:100%; width:0; background:var(--control); }
  .journey-caption { font:.76rem/1.6 var(--font-sans); color:var(--color-text-secondary); margin:.6rem 0; }
  details { font:.76rem/1.6 var(--font-sans); color:var(--color-text-secondary); }
  summary { cursor:pointer; }
  details li { margin-bottom:.65rem; }
  @media(max-width:600px) { .journey-panels { grid-template-columns:1fr; gap:.55rem; padding:.7rem; } .journey-panel { display:grid; grid-template-columns:minmax(6.5rem,.8fr) 1.3fr; column-gap:.7rem; } .journey-panel strong { margin:0; font-size:.94rem; } .journey-panel p:last-child { grid-column:2; } }
  @media(prefers-reduced-motion:reduce) { .hold > span { transition:none !important; } }
</style>
