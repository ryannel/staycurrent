---
import {definitions,scene} from './model.mjs';
const {kind}=Astro.props;
const def=definitions[kind];
const initial=scene(kind,def.options[0][0],0);
---
<figure class="hf" data-hierarchy={kind} aria-label={def.title}>
 <figcaption><span class="hf-number">{def.label}</span> {def.title}</figcaption>
 <div class="hf-options"><label>Show <select aria-label={def.title}>{def.options.map(([value,label])=><option value={value}>{label}</option>)}</select></label></div>
 <div class="hf-panels" data-live><div class="hf-visual" set:html={initial.visual}/><div class="hf-data" set:html={initial.data}/></div>
 <p class="hf-explanation" data-live data-explanation aria-live="polite">{initial.explanation}</p>
 {def.steps>1&&<div class="hf-controls" role="group" aria-label={`${def.label} playback`}>
  <button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step>1 / {def.steps}</span><div data-hold aria-hidden="true"><span/></div>
 </div>}
 <details><summary>Figure as text</summary><div class="hf-alternative">{def.options.map(([value,label])=><div><p><strong>{label}</strong></p>{Array.from({length:def.steps},(_,step)=><p>{scene(kind,value,step).explanation}</p>)}</div>)}</div></details>
</figure>
<script>
 import {definitions,scene} from './model.mjs';
 import {stepper} from '../figures/stepper.mjs';
 document.querySelectorAll('[data-hierarchy]').forEach(root=>{
  const kind=root.dataset.hierarchy,def=definitions[kind],select=root.querySelector('select');
  const draw=step=>{const result=scene(kind,select.value,step);root.querySelector('.hf-visual').innerHTML=result.visual;root.querySelector('.hf-data').innerHTML=result.data;root.querySelector('[data-explanation]').textContent=result.explanation;};
  const player=def.steps>1?stepper(root,{steps:()=>def.steps,draw}):null;
  select.addEventListener('change',()=>{if(player){root.querySelector('[data-reset]').click();}else draw(0);});
 });
</script>
<style is:global>
.hf { margin:2rem 0; padding:0; font: .88rem/1.6 var(--font-sans); }
.hf figcaption { margin-bottom:.8rem; font:1.2rem/1.45 var(--font-serif);color:var(--color-text); }
.hf-number { font:.7rem/1.4 var(--font-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--color-text-secondary);margin-right:.5rem; }
.hf-options { padding:.8rem 1rem; background:var(--color-surface-alt);border:1px solid var(--color-rule-strong);border-bottom:0; }
.hf select,.hf button { color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule-strong);border-radius:4px;font:inherit;padding:.4rem .6rem; }
.hf select { max-width:100%;margin-left:.4rem; }
.hf select:focus-visible,.hf button:focus-visible,.hf summary:focus-visible { outline:2px solid var(--teal);outline-offset:3px; }
.hf-panels { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:1rem;padding:1rem;border:1px solid var(--color-rule-strong); }
.hf svg { display:block;width:100%;height:auto;overflow:visible;color:var(--color-text-secondary); }
.hf svg text { fill:var(--color-text);font:15px var(--font-sans); }
.hf svg .hf-id { fill:var(--color-text-secondary);font-size:12px; }
.hf svg rect { fill:var(--color-surface-alt);stroke:var(--color-text-secondary);stroke-width:1.4; }
.hf svg .hf-active rect { stroke:var(--teal);stroke-width:2.5; }
.hf-edge { stroke:var(--color-text-secondary);fill:none;stroke-width:1.6; }
.hf-ghost { stroke-dasharray:5 4; }
.hf-rejected { stroke:var(--coral);fill:none;stroke-width:2.5;stroke-dasharray:5 4; }
.hf-table { overflow-x:auto;max-width:100%; }
.hf .hf-table table { display:table;margin:0;width:100%;border-collapse:collapse;font:.84rem/1.6 var(--font-sans); }
.hf-table th,.hf-table td { padding:.45rem .35rem;border-bottom:1px solid var(--color-rule);text-align:left;vertical-align:top; }
.hf-table th { font-weight:500; }
.hf-table caption { text-align:left;font:.72rem/1.5 var(--font-sans);color:var(--color-text-secondary);padding-bottom:.6rem; }
.hf .hf-matrix th,.hf .hf-matrix td { text-align:center; }
.hf-pair { font-weight:650; }
.hf-changed { color:var(--teal);text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:4px; }
.hf-explanation { border:1px solid var(--color-rule-strong);border-top:0;margin:0!important;min-height:6rem;padding:1rem;font:.88rem/1.7 var(--font-sans)!important; }
.hf-controls { display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;padding:.8rem 1rem;background:var(--color-surface-alt);border:1px solid var(--color-rule-strong);border-top:0; }
.hf button[aria-disabled="true"] { opacity:.55; }
.hf [data-step] { margin-left:auto;font-size:.78rem;color:var(--color-text-secondary); }
.hf [data-hold] { flex-basis:100%;height:2px;background:var(--color-rule); }
.hf [data-hold] span { display:block;height:100%;width:0;background:var(--teal); }
.hf details { margin-top:.7rem;color:var(--color-text-secondary);font:.8rem/1.65 var(--font-sans); }
.hf summary { cursor:pointer; }
.hf-alternative p { font:inherit!important; }
.hf-small { font:.8rem/1.7 var(--font-sans)!important; }
.hf-cycle,.hf-chain { display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.7rem;min-height:310px;padding:1rem;text-align:center;border:1px solid var(--color-rule); }
.hf-cycle { border-color:var(--coral); }
.hf-cycle span { display:block; }
.hf-interval { stroke:var(--teal);stroke-width:4; }
.hf svg circle { fill:var(--teal); }
@media(min-width:900px){.hf{width:calc(100% + 120px);margin-left:-60px;}}
@media(max-width:650px){.hf-panels{grid-template-columns:1fr;}.hf-visual{max-width:350px;width:100%;margin:auto;}.hf-explanation{min-height:0;}.hf select{display:block;margin:.4rem 0 0;width:100%;}.hf-controls{gap:.4rem;padding:.7rem;}.hf button{padding:.4rem .5rem;}}
</style>
