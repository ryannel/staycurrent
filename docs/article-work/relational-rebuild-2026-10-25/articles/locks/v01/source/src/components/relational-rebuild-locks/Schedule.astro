---
const { model } = Astro.props;
const initial = model.options[0].steps[0];
---
<figure class="lock-schedule" id={model.id} data-lock-schedule data-model={JSON.stringify(model)} aria-labelledby={`${model.id}-title`}>
  <figcaption id={`${model.id}-title`}><span class="figure-number">Figure {model.number}</span><span>{model.title}</span></figcaption>
  <div class="lock-drawing">
    <p class="resource-label">{model.resource}</p>
    <div class="lock-authority" data-live data-holder>{initial.holder}</div>
    {model.id === 'product-deadlock' && <svg class="wait-graph" viewBox="0 0 300 180" aria-hidden="true">
      <defs><marker id="lock-wait-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="var(--coral)" /></marker></defs>
      <rect x="10" y="66" width="80" height="40" rx="3"/><text x="50" y="91">A</text>
      <rect x="210" y="66" width="80" height="40" rx="3"/><text x="250" y="91">B</text>
      <g data-edge-ab opacity="0"><path d="M90 76 Q150 4 210 76" marker-end="url(#lock-wait-arrow)"/><text x="150" y="23">waits for P7</text></g>
      <g data-edge-ba opacity="0"><path d="M210 99 Q150 170 90 99" marker-end="url(#lock-wait-arrow)"/><text x="150" y="169">waits for P3</text></g>
    </svg>}
    <div class="lock-columns"><p>{model.labels[0]}</p><p>{model.labels[1]}</p></div>
    <div class="lock-events" aria-label="Steps in order">
      {model.options[0].steps.map((s, i) => <div class:list={['lock-event', {current:i===0}]} data-row={i}>
        <div data-live data-a>{i===0?s.a:'…'}</div><span class="event-number" aria-label={`Step ${i+1}`}>{i+1}</span><div data-live data-b>{i===0?s.b:'…'}</div>
      </div>)}
    </div>
    <p class="lock-result"><span>{model.valueLabel}</span><strong data-live data-value>{initial.value}</strong></p>
    <p class="lock-explanation" data-live data-explanation aria-live="polite">{initial.explanation}</p>
  </div>
  <div class="lock-controls" role="group" aria-label={`Controls for figure ${model.number}`}>
    <label>Compare <select data-option aria-label={`Comparison for figure ${model.number}`}>
      {model.options.map(option => <option value={option.value}>{option.label}</option>)}
    </select></label>
    <div class="lock-playback"><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-live data-step>1 / {model.options[0].steps.length}</span></div>
    <div data-hold aria-hidden="true"><span></span></div>
  </div>
  <p class="lock-caption">{model.caption}</p>
  <details class="lock-text"><summary>Figure as text</summary>
    {model.options.map(option => <div><p><strong>{option.label}</strong></p><ol>{option.steps.map(s=><li>{s.explanation}</li>)}</ol></div>)}
  </details>
</figure>

<script>
  import { stepper } from '../figures/stepper.mjs';
  function initialiseLockFigures() {
    document.querySelectorAll('[data-lock-schedule]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready) return;
      root.dataset.ready = 'true';
      const model = JSON.parse(root.dataset.model!);
      const option = root.querySelector<HTMLSelectElement>('[data-option]')!;
      const current = () => model.options.find((entry) => entry.value === option.value).steps;
      const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
      const player = stepper(root, { steps: () => current().length, draw: (index) => {
        const steps = current();
        const state = steps[index];
        root.querySelector('[data-holder]')!.textContent = state.holder;
        root.querySelector('[data-value]')!.textContent = state.value;
        root.querySelector('[data-explanation]')!.textContent = state.explanation;
        const ab = root.querySelector('[data-edge-ab]');
        const ba = root.querySelector('[data-edge-ba]');
        if (ab && ba) {
          ab.setAttribute('opacity', state.value.includes('A → B') ? '1' : '0');
          ba.setAttribute('opacity', state.value.includes('B → A') ? '1' : '0');
        }
        rows.forEach((row, i) => {
          row.classList.toggle('current', i === index);
          row.classList.toggle('past', i < index);
          row.querySelector('[data-a]')!.textContent = i <= index ? steps[i].a : '…';
          row.querySelector('[data-b]')!.textContent = i <= index ? steps[i].b : '…';
        });
      }});
      option.addEventListener('change', () => { root.querySelector<HTMLButtonElement>('[data-reset]')!.click(); player.render(); });
    });
  }
  initialiseLockFigures();
  document.addEventListener('astro:page-load', initialiseLockFigures);
</script>

<style>
  .lock-schedule { margin:2.4rem -3.75rem; font-family:var(--font-sans); }
  figcaption { display:flex; align-items:baseline; gap:.8rem; margin-bottom:.7rem; font:1.1rem/1.5 var(--font-serif); }
  .figure-number { color:var(--color-text-secondary); font:.65rem/1.5 var(--font-sans); letter-spacing:.1em; text-transform:uppercase; white-space:nowrap; }
  .lock-drawing { background:var(--color-surface-alt); border:1px solid var(--color-rule-strong); padding:1rem 1.2rem .8rem; }
  .resource-label { margin:0 0 .4rem; font:.74rem/1.5 var(--font-mono); color:var(--color-text-secondary); }
  .lock-authority { border:1px solid var(--teal); border-left:4px solid var(--teal); padding:.55rem .75rem; font:.83rem/1.5 var(--font-sans); min-height:2.6rem; }
  .lock-columns { display:grid; grid-template-columns:1fr 1fr; gap:2rem; margin-top:1rem; }
  .lock-columns p { margin:0; font:.81rem/1.5 var(--font-sans); font-weight:650; }
  .lock-columns p:last-child { color:var(--color-text); }
  .wait-graph { display:block; width:min(100%,350px); height:auto; margin:.7rem auto 0; overflow:visible; }
  .wait-graph rect { fill:var(--color-surface); stroke:var(--color-text-secondary); stroke-width:1.5; }
  .wait-graph text { text-anchor:middle; fill:var(--color-text); font:15px var(--font-sans); }
  .wait-graph g path { stroke:var(--coral); stroke-width:2; fill:none; }
  .lock-events { margin:.45rem 0 1rem; }
  .lock-event { display:grid; grid-template-columns:minmax(0,1fr) 1.5rem minmax(0,1fr); align-items:stretch; gap:.5rem; border-top:1px solid var(--color-rule-strong); font:.82rem/1.55 var(--font-sans); }
  .lock-event > div { padding:.6rem .35rem; min-height:3.3rem; }
  .lock-event > div:first-child { border-left:2px solid var(--teal); }
  .lock-event > div:last-child { border-left:2px solid var(--blue); }
  .lock-event.current > div { background:var(--color-surface); font-weight:600; }
  .lock-event.past { color:var(--color-text-secondary); }
  .event-number { padding-top:.65rem; color:var(--color-text-secondary); text-align:center; font:.69rem/1.6 var(--font-mono); }
  .lock-result { display:flex; justify-content:space-between; flex-wrap:wrap; gap:.4rem 1rem; margin:.4rem 0 .8rem; padding:.6rem 0; border-top:1px solid var(--color-rule-strong); border-bottom:1px solid var(--color-rule-strong); font:.8rem/1.5 var(--font-sans); }
  .lock-result strong { color:var(--color-text); font-weight:650; }
  .lock-explanation { margin:.7rem 0 .1rem; min-height:4.7rem; padding-left:.8rem; border-left:3px solid var(--teal); font:.83rem/1.7 var(--font-sans); }
  .lock-controls { padding:.8rem 1rem .35rem; border:1px solid var(--color-rule-strong); border-top:0; background:var(--color-surface); }
  label { display:flex; align-items:center; gap:.7rem; font:.77rem/1.5 var(--font-sans); }
  select { max-width:100%; min-width:0; padding:.45rem; border:1px solid var(--color-text-secondary); border-radius:3px; color:var(--color-text); background:var(--color-surface); font:.77rem/1.5 var(--font-sans); }
  .lock-playback { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; margin:.7rem 0 .5rem; font:.75rem/1.5 var(--font-sans); }
  button { padding:.4rem .7rem; border:1px solid var(--color-text-secondary); border-radius:3px; background:var(--color-surface); color:var(--color-text); cursor:pointer; font:.77rem/1.5 var(--font-sans); }
  button[data-play] { border-color:var(--teal); }
  button[aria-disabled="true"] { opacity:.55; }
  [data-step] { margin-left:auto; color:var(--color-text-secondary); font-variant-numeric:tabular-nums; }
  [data-hold] { height:3px; background:var(--color-rule); }
  [data-hold] span { display:block; width:0; height:100%; background:var(--teal); }
  button:focus-visible,select:focus-visible,summary:focus-visible { outline:2px solid var(--teal); outline-offset:3px; }
  .lock-caption { margin:.65rem 0; color:var(--color-text-secondary); font:.76rem/1.65 var(--font-sans); }
  .lock-text { font:.8rem/1.65 var(--font-sans); }
  summary { cursor:pointer; }
  .lock-text p { font:inherit; margin:1rem 0 .3rem; }
  .lock-text ol { margin:.4rem 0 1rem; padding-left:1.3rem; }
  @media(max-width:850px) { .lock-schedule { margin:2rem 0; } }
  @media(max-width:550px) { .lock-drawing { padding:.75rem; } .lock-event { gap:.3rem; grid-template-columns:minmax(0,1fr) 1rem minmax(0,1fr); } .lock-event > div { min-height:4rem; padding:.5rem .3rem; } .lock-columns { gap:1.8rem; } .lock-columns p { font-size:.78rem; } .lock-controls { padding:.65rem .65rem .3rem; } label { align-items:flex-start; flex-direction:column; gap:.3rem; } select { width:100%; } figcaption { align-items:flex-start; } .lock-explanation { min-height:8rem; } }
  @media(prefers-reduced-motion:reduce) { [data-hold] span { transition:none !important; } }
</style>
