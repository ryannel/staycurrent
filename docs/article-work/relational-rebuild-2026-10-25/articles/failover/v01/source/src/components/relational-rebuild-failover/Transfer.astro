---
const { kind } = Astro.props;
const fenceSteps = [
 ['One writer', 'The existing pool sends writes to the primary. The new pool can read A, which is still a replica.'],
 ['The monitor loses contact', 'The monitor and A cannot reach the primary. An existing pool connection still can. No database has been stopped.'],
 ['Choose how to exclude the old writer', 'With a confirmed fence, the old primary is powered off and cannot restart as a writer. Without it, moving new connections to A leaves the old pool connected.'],
 ['Admit writes on the replacement', 'With the fence confirmed, only A accepts writes. Without the fence, both databases can commit separate work: split brain.']
];
const historySteps = [
 ['Inspect surviving history', 'The primary confirmed C. A has H through C durable, but replay is before U. B has only the earlier history. Neither candidate accepts writes.'],
 ['Exclude the former writer', 'The former primary is fenced. That establishes exclusion, but changes none of the surviving records.'],
 ['Make the selected history usable', 'A can replay its durable U and C and retain 22.00. B cannot reconstruct them from the earlier prefix alone.'],
 ['Open the chosen branch', 'Promotion of A retains C. Promotion of B without obtaining C begins a branch that omits the confirmed price edit.']
];
const all = kind === 'fence' ? fenceSteps : historySteps;
---
<figure class="failover-transfer" data-transfer={kind} aria-label={kind === 'fence' ? 'A broken link does not stop a writer' : 'Choose the history that survives'}>
 <figcaption><span>Figure {kind === 'fence' ? '1' : '2'}</span> {kind === 'fence' ? 'A broken link does not stop a writer' : 'Which copy can retain C?'}</figcaption>
 <div class="choice"><label>{kind === 'fence' ? 'Before promotion' : 'Candidate'} <select aria-label={kind === 'fence' ? 'Writer exclusion' : 'Promotion candidate'} data-choice>{kind === 'fence' ? <><option value="safe">Confirm power fence</option><option value="unsafe">Move address only</option></> : <><option value="safe">A · C is durable</option><option value="unsafe">B · before C</option></>}</select></label></div>
 {kind === 'fence' ? <div class="network" data-live>
  <div class="monitor">Monitor + A <span data-heartbeat>← heartbeat received ← Primary</span></div>
  <div class="route"><div class="caller">Existing pool</div><div class="arrow" data-old-arrow>→ writes →</div><div class="node" data-old>Primary<br/><strong data-old-state>Accepts writes</strong></div></div>
  <div class="route"><div class="caller">New pool</div><div class="arrow" data-new-arrow>→ reads →</div><div class="node" data-new><span data-new-role>A · replica</span><br/><strong data-new-state>No writes</strong></div></div>
  <div class="verdict" data-verdict>One database accepts writes</div>
 </div> : <div class="histories" data-live>
  <p class="axis">History H → <span>symbolic positions</span></p>
  <div class="history-row"><b>Primary’s confirmed history</b><div class="cells"><span>Earlier<br/>20.00</span><span>U<br/>22.00 edit</span><span>C<br/>commit</span></div></div>
  <div class="history-row"><b>A · durable</b><div class="cells"><span>Earlier</span><span>U</span><span>C</span></div><small data-a-price>New read: 20.00 · replay before U</small></div>
  <div class="history-row"><b>B · durable</b><div class="cells"><span>Earlier</span><span class="missing">U absent</span><span class="missing">C absent</span></div><small>New read: 20.00</small></div>
  <div class="verdict" data-verdict>No candidate has write authority yet</div>
 </div>}
 <div class="explanation" data-explanation aria-live="polite"><strong data-title data-live>{all[0][0]}</strong><p data-copy data-live>{all[0][1]}</p></div>
 <div class="controls" role="group" aria-label={`Figure ${kind === 'fence' ? '1' : '2'} controls`}><button data-play>Play</button><button data-back aria-disabled="true">Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step>1 / 4</span></div><div class="hold" data-hold><span></span></div>
 <p class="caption">{kind === 'fence' ? 'A conceptual link-failure schedule. The fence uses an independent control path and includes restart exclusion. Candidate data is assumed ready here; Figure 2 separates that question.' : 'The parent article’s H/U/C model, with no native log positions or elapsed times. A’s durable chain is assumed complete and usable; B obtains no additional history in this schedule.'}</p>
 <details><summary>Figure as text</summary><ol>{all.map(([title, copy]) => <li><b>{title}.</b> {copy}</li>)}</ol></details>
 <script type="application/json" data-scenes set:html={JSON.stringify(all)} />
</figure>
<style>
.failover-transfer{margin:2.2rem 0;font-family:var(--font-sans);font-size:.9rem;color:var(--color-text)}
figcaption{margin-bottom:.65rem;font-size:1.15rem}figcaption>span{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;display:inline-block;margin-right:.6rem;color:var(--color-text-secondary)}
.choice{padding:.8rem 1rem;background:var(--color-surface-alt);border:1px solid var(--color-rule)}label{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem}select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule-strong);border-radius:4px;padding:.5rem .65rem;min-height:40px}button{cursor:pointer}button[aria-disabled=true]{opacity:.55}button:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--color-accent);outline-offset:3px}
.network,.histories{padding:1rem;background:var(--color-surface);border-inline:1px solid var(--color-rule)}.monitor{border-bottom:1px dashed var(--color-rule-strong);padding-bottom:1rem;margin-bottom:1rem;font-weight:600}.monitor span{display:block;font-size:.8rem;font-weight:400;margin-top:.3rem}.route{display:grid;grid-template-columns:1fr 1fr 1.2fr;align-items:center;gap:.4rem;margin:.9rem 0}.caller,.node{padding:.8rem .5rem;border:1px solid var(--color-rule-strong);text-align:center}.node{border:2px solid var(--color-text-secondary)}.node strong{display:block;font-size:.8rem;margin-top:.3rem}.arrow{text-align:center;font-size:.8rem}.node.blocked{border-style:dashed}.node.active{border-color:var(--color-accent-strong)}.verdict{padding:.7rem;border-top:2px solid var(--color-rule-strong);font-weight:600;margin-top:1rem}.verdict.danger{border-color:var(--coral)}
.axis{margin:0 0 .8rem;font-weight:600}.axis span{font-size:.75rem;font-weight:400;color:var(--color-text-secondary)}.history-row{margin:.9rem 0}.history-row>b{font-size:.8rem}.cells{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.3rem;margin:.35rem 0}.cells span{padding:.6rem .25rem;min-height:2rem;border:1px solid var(--color-text-secondary);background:var(--color-surface-alt);text-align:center;font-size:.8rem}.cells .missing{border-style:dashed;background:var(--color-surface);color:var(--color-text-secondary)}small{font-size:.8rem}
.explanation{border:1px solid var(--color-rule);padding:1rem;min-height:8.7rem;background:var(--color-surface-alt)}.explanation p{margin:.4rem 0 0;line-height:1.6}.controls{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;padding:.75rem;border:1px solid var(--color-rule);border-top:0}.controls>span{margin-left:auto;font-size:.8rem}.hold{height:3px;background:var(--color-rule)}.hold span{display:block;width:0;height:100%;background:var(--color-accent)}.caption{font-size:.8rem;line-height:1.6;color:var(--color-text-secondary);margin:.7rem 0}details{font-size:.85rem}details li{margin:.5rem 0}
@media(max-width:450px){.network,.histories{padding:.7rem}.route{grid-template-columns:.85fr .8fr 1.15fr}.caller,.node{padding:.7rem .3rem;font-size:.8rem}.arrow{font-size:.7rem}.explanation{min-height:12rem}.controls{gap:.3rem;padding:.6rem}.controls button{padding:.45rem .55rem}}
</style>
<script>
import { stepper } from '../figures/stepper.mjs';
document.querySelectorAll<HTMLElement>('[data-transfer]').forEach(root => {
 const scenes = JSON.parse(root.querySelector('[data-scenes]')!.textContent!);
 const choice = root.querySelector<HTMLSelectElement>('[data-choice]')!;
 const set = (selector: string, value: string) => { root.querySelector(selector)!.textContent = value; };
 const player = stepper(root, {steps:()=>scenes.length, draw:(step:number)=> {
  const safe = choice.value === 'safe';
  set('[data-title]', scenes[step][0]); set('[data-copy]', scenes[step][1]);
  if (root.dataset.transfer === 'fence') {
   const fenced = step >= 2 && safe;
   set('[data-heartbeat]', step===0 ? '← heartbeat received ← Primary' : '× heartbeat link broken × Primary');
   set('[data-old-arrow]',fenced ? '× blocked ×' : '→ writes →');
   set('[data-new-arrow]',step>=3 ? '→ writes →' : '→ reads →');
   set('[data-old-state]',fenced ? 'Off · restart excluded' : 'Accepts writes');
   set('[data-new-role]',step>=3 ? 'A · promoted' : 'A · replica');
   set('[data-new-state]',step>=3 ? 'Accepts writes' : 'No writes');
   root.querySelector('[data-old]')!.classList.toggle('blocked', fenced);
   root.querySelector('[data-new]')!.classList.toggle('active', step>=3);
   set('[data-verdict]',step>=3 ? safe ? 'One writer: A' : 'Split brain: two writers' : fenced ? 'No writer during the transfer' : 'One database accepts writes');
   root.querySelector('[data-verdict]')!.classList.toggle('danger',step>=3 && !safe);
  } else {
   set('[data-a-price]',step>=2 && safe ? 'New read: 22.00 · U and C replayed' : 'New read: 20.00 · replay before U');
   set('[data-verdict]',step===0 ? 'No candidate has write authority yet' : step===1 ? 'Former primary fenced · no candidate writing' : step===2 ? safe ? 'A recovers C → 22.00' : 'B lacks C → 20.00' : safe ? 'New authority: A · C retained' : 'New authority: B · C omitted');
   root.querySelector('[data-verdict]')!.classList.toggle('danger',step>=2 && !safe);
  }
 }});
 choice.addEventListener('change',()=>player.render());
});
</script>
