---
import { orders, customers } from './model.mjs';
---
<figure class="qr-figure" id="join-rows" aria-labelledby="join-rows-title" data-join-rows>
  <figcaption id="join-rows-title"><span>Figure 1</span>One order, as many rows as it has matches</figcaption>
  <div class="qr-panel">
    <div class="qr-option"><label for="join-kind">Attach</label><select id="join-kind" data-kind><option value="customer">The customer</option><option value="lines">The order lines</option></select></div>
    <div class="qr-path">
      <div><h3>Orders · one row per order</h3>{orders.map(o => <div class="qr-record future" data-order={o.id}><strong>Order {o.id}</strong><small>customer {o.customer}</small></div>)}</div>
      <div class="qr-arrow" aria-hidden="true">→</div>
      <div class="qr-result"><h3 data-live data-result-title>Result · one row per order</h3><div data-live data-result><p>No order considered yet.</p></div></div>
    </div>
    <p class="qr-explanation" data-live data-explanation aria-live="polite">Start with the three orders. Each order will contribute one result row for each matching customer.</p>
  </div>
  <div class="qr-controls" aria-label="Figure 1 controls"><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span class="qr-counter" data-step>1 / 4</span><div class="qr-hold" data-hold aria-hidden="true"><span></span></div></div>
  <p class="qr-note">The drawing constructs the result to explain its meaning; it does not show PostgreSQL’s execution plan. Switch to order lines and watch order 101 contribute two rows.</p>
  <details><summary>Both results, as text</summary><p>With customers: 101 → Mina Shah, 102 → Tariq Aziz, 103 → Mina Shah. With order lines: 101 → line 1 P3, 101 → line 2 P9, 102 → line 1 P7, 103 → line 1 P7, 103 → line 2 P3.</p></details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  import { orders, customers, linesFor } from './model.mjs';
  const root = document.querySelector('[data-join-rows]');
  if (root) {
    const select = root.querySelector('select');
    const result = root.querySelector('[data-result]');
    const title = root.querySelector('[data-result-title]');
    const explanation = root.querySelector('[data-explanation]');
    const player = stepper(root, { steps: () => 4, draw: step => {
      const lines = select.value === 'lines';
      title.textContent = lines ? 'Result · one row per line' : 'Result · one row per order';
      root.querySelectorAll('[data-order]').forEach((el, i) => { el.classList.toggle('current', i === step - 1); el.classList.toggle('future', i >= step); });
      const rows = orders.slice(0,step).flatMap(o => lines ? linesFor(o.id).map(i => `<div class="qr-record"><strong>${o.id} · line ${i.line}</strong><small>${i.product}</small></div>`) : [`<div class="qr-record"><strong>${o.id}</strong><small>${customers.find(c => c.id === o.customer).name}</small></div>`]);
      result.innerHTML = rows.join('') || '<p>No order considered yet.</p>';
      if (!step) explanation.textContent = `Start with the three orders. Each order will contribute one result row for each matching ${lines ? 'order line' : 'customer'}.`;
      else { const o = orders[step-1]; const n = lines ? linesFor(o.id).length : 1; explanation.textContent = `Order ${o.id} has ${n} matching ${lines ? (n === 1 ? 'line' : 'lines') : 'customer'}, so it contributes ${n} result ${n === 1 ? 'row' : 'rows'}. ${rows.length} result ${rows.length === 1 ? 'row' : 'rows'} so far${step === 3 ? ': all three orders are now included.' : '.'}`; }
    }});
    select.addEventListener('change', () => player.render());
  }
</script>
