---
import { orders, paymentsFor, money } from './model.mjs';
---
<figure class="qr-figure" data-missing-rows aria-labelledby="missing-title">
 <figcaption id="missing-title"><span>Figure 2</span>Which orders survive the payment condition?</figcaption>
 <div class="qr-panel">
  <div class="qr-option"><label for="payment-condition">Payment condition</label><select id="payment-condition"><option value="all">None · all payments</option><option value="on">Card in ON</option><option value="where">Card in WHERE</option></select></div>
  <div class="qr-lanes" data-live>{orders.map(o => <div><h3>Order {o.id}</h3><div data-payments={o.id}>{paymentsFor(o.id).length ? paymentsFor(o.id).map(p => <div class="qr-record"><strong>{p.id} · {money(p.amount)}</strong><small>{p.method}</small></div>) : <div class="qr-record qr-missing"><strong>NULL · NULL</strong><small>No matching payment</small></div>}</div></div>)}</div>
  <p class="qr-explanation" data-live data-explanation aria-live="polite">Order 101 contributes two payment rows, 102 contributes one, and 103 contributes one row with NULL payment columns. All three orders survive.</p>
 </div>
 <p class="qr-note">Each small box is a result row. A dashed box has no payment behind it. “Card in ON” keeps every order but attaches only card payments. “Card in WHERE” keeps only rows whose attached payment is by card.</p>
 <details><summary>Comparison, as text</summary><p>All payments: 101/501, 101/502, 102/503, 103/NULL. Card in ON: 101/501, 102/503, 103/NULL. Card in WHERE: 101/501, 102/503; order 103 is absent.</p></details>
</figure>
<script>
 import { orders, paymentsFor, money } from './model.mjs';
 const root = document.querySelector('[data-missing-rows]');
 if (root) root.querySelector('select').addEventListener('change', event => {
  const mode = event.target.value;
  for (const o of orders) {
   const matches = paymentsFor(o.id).filter(p => mode === 'all' || p.method === 'card');
   root.querySelector(`[data-payments="${o.id}"]`).innerHTML = matches.length ? matches.map(p => `<div class="qr-record"><strong>${p.id} · ${money(p.amount)}</strong><small>${p.method}</small></div>`).join('') : mode === 'where' ? '<div class="qr-record qr-missing"><strong>No result row</strong><small>NULL fails the WHERE test</small></div>' : '<div class="qr-record qr-missing"><strong>NULL · NULL</strong><small>No matching payment</small></div>';
  }
  root.querySelector('[data-explanation]').textContent = mode === 'all' ? 'Order 101 contributes two payment rows, 102 contributes one, and 103 contributes one row with NULL payment columns. All three orders survive.' : mode === 'on' ? 'The gift-card payment no longer matches. Order 103 still has a row: LEFT JOIN preserves it even though no card payment matches.' : 'The WHERE condition removes the gift-card row and the NULL row. Order 103 disappears, because the method test is unknown for NULL, not true.';
 });
</script>
