---
import { orders, linesFor, paymentsFor, lineValue, balances, money } from './model.mjs';
---
<figure class="qr-figure" aria-labelledby="summaries-title">
 <figcaption id="summaries-title"><span>Figure 4</span>Give each side one row per order</figcaption>
 <div class="qr-panel">
  <div class="qr-summary-path">
   <div><h3>Order lines → line_totals</h3>{orders.map(o => <div class="qr-group"><b>Order {o.id}</b><span>{linesFor(o.id).map(i => money(lineValue(i))).join(' + ')}</span><div class="qr-down">↓ SUM in this order’s group</div><div class="qr-record"><strong>{o.id} · {money(balances().find(b => b.id === o.id).value)}</strong></div></div>)}</div>
   <div><h3>Payments → payment_totals</h3>{orders.map(o => <div class="qr-group"><b>Order {o.id}</b><span>{paymentsFor(o.id).map(p => money(p.amount)).join(' + ') || 'No payments'}</span><div class="qr-down">↓ {paymentsFor(o.id).length ? 'SUM in this order’s group' : 'No group to summarise'}</div><div class={`qr-record ${paymentsFor(o.id).length ? '' : 'qr-missing'}`}><strong>{paymentsFor(o.id).length ? `${o.id} · ${money(balances().find(b => b.id === o.id).paid)}` : 'No summary row'}</strong></div></div>)}</div>
  </div>
  <p class="qr-down">↓ LEFT JOIN both summaries to orders on order_id</p>
  <table><caption class="qr-tag">One result row per order · absent summaries treated as zero</caption><thead><tr><th scope="col">Order</th><th scope="col">Lines</th><th scope="col">Paid</th><th scope="col">Due</th></tr></thead><tbody>{balances().map(b => <tr><th scope="row">{b.id}</th><td>{money(b.value)}</td><td>{money(b.paid)}</td><td><strong>{money(b.due)}</strong></td></tr>)}</tbody></table>
 </div>
 <p class="qr-note">Each summary can match an order at most once. Order 103 has no payment summary: the outer join retains it, and the report’s zero policy makes its recorded balance 29.00.</p>
</figure>
