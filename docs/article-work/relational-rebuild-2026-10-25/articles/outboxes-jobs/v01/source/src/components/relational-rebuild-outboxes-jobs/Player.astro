---
import { deliverySteps, leaseSteps, work } from './models.mjs';
interface Props { kind: 'delivery' | 'lease'; number: number; }
const {kind, number} = Astro.props;
const isDelivery = kind === 'delivery';
const title = isDelivery ? 'The call can succeed before the shop knows' : 'One work ID, two worker claims';
const first = isDelivery ? deliverySteps('accepted', false)[0] : leaseSteps[0];
---
<figure class="oj-figure oj-player wide" data-kind={kind} aria-label={title}>
  <figcaption><span>Figure {number}</span> {title}</figcaption>
  {isDelivery && <div class="oj-options">
    <label>Relay stops <select data-stop aria-label="Relay stops"><option value="before">Before the call</option><option value="accepted" selected>After acceptance</option><option value="finished">After completion record</option></select></label>
    <label>Receiver <select data-dedup aria-label="Receiver"><option value="no">No deduplication</option><option value="yes">Deduplicates ID and payload</option></select></label>
  </div>}
  <div class="oj-scene">
    <p class="oj-identity">Work ID <code>{work.id}</code> · order received · total {work.total}</p>
    <div class="oj-system-pair">
      <div class="oj-system"><p class="oj-label">Shop database</p><div class="oj-record"><code>{work.id}</code><strong data-db data-live>{first.db}</strong>{!isDelivery && <span>Lease deadline <b data-deadline data-live>10:17:00 UTC</b></span>}</div></div>
      <div class="oj-system"><p class="oj-label">{isDelivery ? 'Example receiver' : 'Worker processes'}</p>{isDelivery ? <div class="oj-receiver"><strong class="oj-count" data-count data-live>0</strong><span>accepted acknowledgements</span><div class="oj-effects" aria-hidden="true"><i></i><i></i></div></div> : <div class="oj-workers"><p><b>A</b><span data-a data-live>working with claim 7</span></p><p><b>B</b><span data-b data-live>no claim</span></p></div>}</div>
    </div>
    <div class="oj-transfer"><span aria-hidden="true">→</span><strong data-action data-live>{first.action}</strong></div>
    {isDelivery && <p class="oj-worker" data-worker data-live>{first.worker}</p>}
    <p class="oj-explanation" data-explanation data-live aria-live="polite">{first.explanation}</p>
  </div>
  <div class="oj-controls" role="group" aria-label={`Playback for figure ${number}`}><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step>1 / 5</span><div data-hold aria-hidden="true"><span></span></div></div>
  <details class="oj-alternative"><summary>Steps as text</summary>{isDelivery ? <p>Committed work survives a relay stopping before the call. If the receiver accepts before the relay stops, the missing completion record leads to another attempt. A receiver that atomically remembers the stable ID, matching payload and result can return the existing result; one without that contract may accept twice. If completion was already recorded, a later poll skips the row.</p> : <ol>{leaseSteps.map(s => <li><strong>{s.action}.</strong> {s.explanation}</li>)}</ol>}</details>
  <p class="oj-caption">{isDelivery ? 'A model of three stopping points, with and without an explicit receiver contract. Acceptance is the model’s effect; no real email service is being called. Step through After acceptance, then enable deduplication and compare the final count.' : 'An illustrative schedule in UTC, with one-minute leases and generations 7 and 8. Expiry makes recovery possible; it does not stop an old process. The separate SQL checks exercise the database guards.'}</p>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  import { deliverySteps, leaseSteps } from './models.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('.oj-player')) {
    const delivery = root.dataset.kind === 'delivery';
    const stop = root.querySelector<HTMLSelectElement>('[data-stop]');
    const dedup = root.querySelector<HTMLSelectElement>('[data-dedup]');
    const current = () => delivery ? deliverySteps(stop!.value, dedup!.value === 'yes') : leaseSteps;
    const text = (key: string, value: unknown) => { const element = root.querySelector(`[data-${key}]`); if (element) element.textContent = String(value); };
    const player = stepper(root, { steps: () => current().length, draw: (index: number) => {
      const scene = current()[index];
      for (const key of ['db','action','explanation','worker','deadline','a','b']) if (key in scene) text(key, scene[key]);
      if (delivery) {
        text('count', scene.receiver);
        root.querySelectorAll<HTMLElement>('.oj-effects i').forEach((el, i) => el.classList.toggle('accepted', i < scene.receiver));
      }
    }});
    stop?.addEventListener('change', () => { root.querySelector<HTMLButtonElement>('[data-reset]')!.click(); });
    dedup?.addEventListener('change', () => player.render());
  }
</script>
<style is:global>
  .oj-figure { margin-top:2.4rem; margin-bottom:2.4rem; font:.85rem/1.6 var(--font-sans); }
  .oj-figure.wide { width:min(840px,calc(100vw - 3rem)); }
  .oj-figure figcaption { font:500 1.15rem/1.4 var(--font-serif); margin-bottom:.65rem; }
  .oj-figure figcaption > span { display:inline-block; font:.65rem var(--font-mono); text-transform:uppercase; letter-spacing:.07em; color:var(--color-text-secondary); margin-right:.6rem; }
  .oj-scene,.oj-static { padding:1.15rem; border:1px solid var(--color-rule-strong); background:var(--color-surface-alt); }
  .oj-figure p { font:inherit; margin:.6rem 0; }
  .oj-identity { padding-bottom:.7rem; border-bottom:1px solid var(--color-rule-strong); color:var(--color-text-secondary); }
  .oj-system-pair { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; margin:1rem 0; }
  .oj-system { min-width:0; }
  .oj-label { font-weight:600 !important; }
  .oj-record,.oj-receiver { min-height:140px; padding:.8rem; border:1px solid var(--color-text-secondary); background:var(--color-surface); display:flex; flex-direction:column; justify-content:center; gap:.5rem; }
  .oj-record code { display:block; overflow-wrap:anywhere; }
  .oj-record strong { display:block; font-weight:500; }
  .oj-count { font:500 2rem var(--font-serif); }
  .oj-effects { display:flex; gap:.4rem; }
  .oj-effects i { width:2.1rem; height:1.3rem; border:1px dashed var(--color-text-secondary); }
  .oj-effects i.accepted { border:2px solid var(--color-accent); background:color-mix(in srgb,var(--color-accent) 12%,var(--color-surface)); }
  .oj-transfer { border-top:1px solid var(--color-rule-strong); padding-top:.7rem; display:flex; gap:.6rem; align-items:baseline; }
  .oj-transfer > span { font-size:1.5rem; color:var(--color-accent); }
  .oj-transfer strong { font-weight:500; }
  .oj-worker { color:var(--color-text-secondary); }
  .oj-explanation { padding:.6rem 0 .6rem .8rem; border-left:3px solid var(--color-accent); min-height:4.9em; }
  .oj-options { display:flex; flex-wrap:wrap; gap:.75rem 1rem; padding:.8rem; border:1px solid var(--color-rule-strong); border-bottom:0; }
  .oj-options label { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; }
  .oj-figure select,.oj-figure button { color:var(--color-text); background:var(--color-surface); border:1px solid var(--color-text-secondary); padding:.5rem .7rem; border-radius:4px; font:inherit; min-height:42px; cursor:pointer; }
  .oj-controls { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; padding:.7rem; border:1px solid var(--color-rule-strong); border-top:0; }
  .oj-controls [data-step] { margin-left:auto; font:.75rem var(--font-mono); }
  .oj-controls [aria-disabled="true"] { color:var(--color-text-secondary); border-style:dashed; }
  .oj-controls [data-hold] { height:3px; width:100%; background:var(--color-rule); }
  .oj-controls [data-hold] > span { display:block; height:100%; width:0; background:var(--color-accent); }
  .oj-figure :focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
  .oj-caption,.oj-alternative { font-size:.78rem !important; color:var(--color-text-secondary); }
  .oj-alternative { margin:.7rem 0; }
  .oj-alternative summary { cursor:pointer; }
  .oj-workers p { display:flex; gap:.65rem; border:1px solid var(--color-text-secondary); padding:.7rem; background:var(--color-surface); }
  .oj-workers b { font:600 1.25rem var(--font-serif); }
  .oj-static code { overflow-wrap:anywhere; }
  .oj-static .oj-lanes { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
  .oj-lanes > div { min-width:0; }
  .oj-static .oj-node { padding:.65rem .8rem; border:1px solid var(--color-text-secondary); background:var(--color-surface); }
  .oj-static .oj-node b,.oj-static .oj-node span { display:block; }
  .oj-static .oj-node span { color:var(--color-text-secondary); }
  .oj-static .oj-arrow { padding:.3rem .8rem; border-left:1px solid var(--color-text-secondary); margin-left:1.2rem; }
  .oj-static .oj-stop { border-left:3px solid var(--coral); padding:.65rem .8rem; background:var(--color-surface); }
  .oj-static .oj-transaction { border:2px solid var(--color-accent); padding:.8rem; }
  .oj-static .oj-transaction > p { margin-top:0; }
  .oj-static .oj-row { display:grid; grid-template-columns:1fr 1fr; gap:1rem; border-top:1px solid var(--color-rule-strong); padding:.8rem 0; }
  .oj-static .oj-result { font-weight:600; }
  @media(max-width:550px) {
    .oj-figure.wide { width:calc(100vw - 2rem); }
    .oj-scene,.oj-static { padding:.8rem; }
    .oj-system-pair { gap:.65rem; }
    .oj-record,.oj-receiver { padding:.55rem; min-height:160px; }
    .oj-static .oj-lanes { grid-template-columns:1fr; gap:1.4rem; }
    .oj-explanation { min-height:0; }
    .oj-options label,.oj-options select { width:100%; }
    .oj-workers p { padding:.5rem; gap:.4rem; flex-direction:column; }
    .oj-controls { gap:.4rem; }
  }
</style>
