  "displayedSql": [
    {
      "label": "Mina’s ordinary history read",
      "sql": "SELECT order_id, placed_at, status\nFROM orders\nWHERE customer_id = 1\nORDER BY placed_at DESC, order_id DESC\nLIMIT 10;"
    },
    {
      "label": "Sample client activity in the current database",
      "sql": "SELECT clock_timestamp() AS sampled_at,\n       pid, backend_start, usename, application_name,\n       state, xact_start, query_start, state_change,\n       wait_event_type, wait_event, query\nFROM pg_stat_activity\nWHERE datname = current_database()\n  AND backend_type = 'client backend'\n  AND pid <> pg_backend_pid()\nORDER BY xact_start NULLS LAST, pid;"
    },
    {
      "label": "Follow the identified waiter to its immediate blockers",
      "sql": "-- Bind $1 to the current waiter PID from the request evidence.\nSELECT w.pid AS waiter_pid, w.backend_start AS waiter_start,\n       w.state AS waiter_state, w.wait_event_type, w.wait_event,\n       p.pid AS blocker_pid, b.backend_start AS blocker_start,\n       b.application_name AS blocker_application,\n       b.state AS blocker_state, b.xact_start, b.query\nFROM pg_stat_activity AS w\nCROSS JOIN LATERAL unnest(pg_blocking_pids(w.pid)) AS p(pid)\nLEFT JOIN pg_stat_activity AS b ON b.pid = p.pid\nWHERE w.pid = $1;"
    },
    {
      "label": "Inspect the two sessions’ table-lock requests",
      "sql": "-- Bind $1 and $2 to H and W. Connect to the orders database.\nSELECT pid, relation::regclass AS relation, mode, granted\nFROM pg_locks\nWHERE database = (SELECT oid FROM pg_database\n                  WHERE datname = current_database())\n  AND relation = 'orders'::regclass\n  AND pid IN ($1, $2)\nORDER BY pid, mode;"
    },
    {
      "label": "Retain statement counters at each end of the incident window",
      "sql": "SELECT clock_timestamp() AS sampled_at,\n       dbid, userid, queryid, toplevel, stats_since,\n       calls, total_exec_time, rows,\n       shared_blks_hit, shared_blks_read, temp_blks_written\nFROM pg_stat_statements\nWHERE dbid = (SELECT oid FROM pg_database\n              WHERE datname = current_database());\n\nSELECT stats_reset, dealloc FROM pg_stat_statements_info;"
    },
    {
      "label": "Count client sessions and inspect the admission settings",
      "sql": "SELECT application_name, usename, state, count(*) AS sessions\nFROM pg_stat_activity\nWHERE backend_type = 'client backend'\nGROUP BY application_name, usename, state\nORDER BY sessions DESC;\n\nSELECT name, setting\nFROM pg_settings\nWHERE name IN ('max_connections', 'reserved_connections',\n               'superuser_reserved_connections');"
    },
    {
      "label": "Retain I/O counters for the same incident window",
      "sql": "SELECT clock_timestamp() AS sampled_at,\n       backend_type, object, context,\n       reads, read_time, writes, write_time, stats_reset\nFROM pg_stat_io\nORDER BY backend_type, object, context;"
    },
    {
      "label": "Apply limits only to this explicit attempt",
      "sql": "BEGIN;\nSET LOCAL lock_timeout = '200ms';\nSET LOCAL statement_timeout = '900ms';\nSELECT order_id, placed_at, status\nFROM orders\nWHERE customer_id = 1\nORDER BY placed_at DESC, order_id DESC\nLIMIT 10;\nCOMMIT;"
    },
    {
      "label": "Bind the sampled identity before cancelling one active statement",
      "sql": "SELECT pg_cancel_backend(pid) AS signal_sent\nFROM pg_stat_activity\nWHERE pid = $1\n  AND backend_start = $2::timestamptz\n  AND datname = current_database()\n  AND application_name = $3\n  AND state = 'active'\n  AND query_start = $4::timestamptz;"
    }
  ],
