---
import { capacity, capacityHours, copyState, copySteps, incidents } from './models.mjs';
interface Props { scene: 'capacity' | 'copies' | 'incident'; number: number; }
const {scene, number} = Astro.props;
const title = { capacity: 'Free space is also time to intervene', copies: 'Acknowledged, durable elsewhere and readable are different moments', incident: 'One decision sequence, two different recoveries' }[scene];
const id = `a07-${scene}`;
const first = capacity(4, 0);
---
<figure class="service-figure" data-service-scene={scene} aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`}><span>Figure {number}</span> {title}</figcaption>
  {scene === 'capacity' && <>
    <label class="choice">Growth scenario <select data-choice aria-label="Storage growth scenario"><option value="4">Ordinary: 4 GB/h</option><option value="12">Archive blocked: 12 GB/h total</option></select></label>
    <div class="metrics"><div><strong data-free>{first.free} GB</strong><span>Free space</span></div><div><strong>32 GB</strong><span>Reserved for intervention</span></div><div><strong data-time>{first.hoursToReserve} h</strong><span>Until reserve is reached</span></div></div>
    <div class="budget" aria-hidden="true"><div class="used" data-used style="width:0%"></div><div class="reserve" data-reserve>32 GB reserve</div></div>
    <p class="clock" data-clock>Elapsed: 0 h · intervention needs up to 8 h</p>
    <p class="narration" data-narration aria-live="polite">Ordinary growth leaves 16 hours before the 32 GB reserve is reached. An eight-hour intervention still fits. Switch to a blocked archive before advancing.</p>
    <p class="model-note">Illustrative constant-rate budget, starting with 96 GB free. Data and index growth uses 4 GB/h; a blocked archive adds 8 GB/h of retained logs. The reserve is a planning allowance, not a database threshold.</p>
  </>}
  {scene === 'copies' && <>
    <label class="choice">Commit acknowledgement <select data-choice aria-label="Commit acknowledgement policy"><option value="local">Wait for writer flush only</option><option value="standby">Also wait for selected standby flush</option></select></label>
    <div class="metrics"><div><strong data-ack>Waiting</strong><span>Order 103 acknowledgement</span></div><div><strong data-progress>0 / 5</strong><span>Sequence position</span></div></div>
    <div class="copies"><div><span>Writable service</span><strong data-writer>{copyState('local',0).writer}</strong></div><div><span>Standby’s durable history</span><strong data-durable>No order 103</strong></div><div><span>Replica’s new query</span><strong data-readable>No order 103</strong></div><div class="history"><span>Retained recovery inputs</span><strong>Base copy + complete log history</strong><small data-history>Separate from the live copies</small></div></div>
    <p class="narration" data-narration aria-live="polite">{copySteps[0]}</p>
    <p class="model-note">Illustrative PostgreSQL physical-replication sequence. “Standby flush” assumes a configured, selected synchronous standby and synchronous_commit=on. Replay may follow flush; this figure deliberately separates them. It assumes retained recovery inputs cover the deletion boundary. No failover or restore was executed for this model.</p>
  </>}
  {scene === 'incident' && <>
    <p class="phase" data-phase>{incidents[0].phase}</p>
    <div class="incident-pair"><div><span>Overload</span><strong data-overload-title>{incidents[0].overload[0]}</strong><p data-overload>{incidents[0].overload[1]}</p></div><div><span>Accidental deletion</span><strong data-deletion-title>{incidents[0].deletion[0]}</strong><p data-deletion>{incidents[0].deletion[1]}</p></div></div>
    <p class="narration" data-narration aria-live="polite">{incidents[0].note}</p>
    <p class="model-note">Invented incidents in the same order service. Times illustrate the decision paths and establish no recovery-time promise. Each step keeps the two cases together for comparison.</p>
  </>}
  <div class="controls" aria-label={`Controls for figure ${number}`}>
    <button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button>
    <label>Step <input data-step aria-label={`Figure ${number} step`} type="range" min="0" max={scene === 'capacity' ? 3 : scene === 'copies' ? 5 : 6} value="0" /></label><output data-step-label>1 / {scene === 'capacity' ? 4 : scene === 'copies' ? 6 : 7}</output>
    <button type="button" data-reset>Reset</button>
  </div>
  <p class="control-note">Play waits for the narration and both comparison panels. Pause or step at any time. Changing a scenario keeps the same step.</p>
</figure>

<script>
  import { capacity, capacityHours, copyState, copySteps, incidents, readingDelay } from './models.mjs';
  document.querySelectorAll<HTMLElement>('[data-service-scene]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const scene = root.dataset.serviceScene!;
    const find = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-${name}]`)!;
    const play = find<HTMLButtonElement>('play');
    const back = find<HTMLButtonElement>('back');
    const next = find<HTMLButtonElement>('next');
    const slider = find<HTMLInputElement>('step');
    const choice = root.querySelector<HTMLSelectElement>('[data-choice]');
    const max = Number(slider.max);
    let step = 0;
    let playing = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const set = (key: string, value: string) => { find(key).textContent = value; };
    function stop() { playing = false; clearTimeout(timer); play.textContent = step === max ? 'Replay' : 'Play'; }
    function render() {
      slider.value = String(step);
      set('step-label', `${step + 1} / ${max + 1}`);
      back.setAttribute('aria-disabled', String(step === 0));
      next.setAttribute('aria-disabled', String(step === max));
      if (scene === 'capacity') {
        const rate = Number(choice!.value);
        const hours = capacityHours[step];
        const state = capacity(rate, hours);
        set('free', `${state.free} GB`);
        set('reserve', state.free < state.reserve ? 'Reserve crossed' : '32 GB reserve');
        set('time', `${Number(state.hoursToReserve.toFixed(1))} h`);
        set('clock', `Elapsed: ${hours} h · intervention needs up to 8 h`);
        find('used').style.width = `${(96-state.free)/96*100}%`;
        set('narration', state.free <= state.reserve ? `The ${hours}-hour point has crossed the planned reserve. Only ${state.free} GB is free; the intervention allowance no longer fits. This forecast should have triggered action earlier.` : `After ${hours} hours at ${rate} GB/h, ${state.free} GB is free. The 32 GB reserve is reached in ${Number(state.hoursToReserve.toFixed(1))} hours. ${state.act ? 'Act now: that is no longer than the eight-hour intervention lead time.' : 'The eight-hour intervention fits, but keep checking growth and the archive.'}`);
      } else if (scene === 'copies') {
        const state = copyState(choice!.value, step);
        set('ack', state.acknowledged ? 'Commit confirmed' : 'Waiting');
        set('progress', `${step} / ${max}`);
        set('writer', state.writer); set('durable', state.durable); set('readable', state.readable);
        set('history', step >= 4 ? 'Can reconstruct a state before deletion' : 'Separate from the live copies');
        set('narration', copySteps[step]);
      } else {
        const current = incidents[step];
        set('phase', current.phase); set('overload-title', current.overload[0]); set('overload', current.overload[1]); set('deletion-title', current.deletion[0]); set('deletion', current.deletion[1]); set('narration', current.note);
      }
      if (!playing) play.textContent = step === max ? 'Replay' : 'Play';
    }
    function schedule() {
      clearTimeout(timer);
      const text = scene === 'incident' ? [incidents[step].note,...incidents[step].overload,...incidents[step].deletion].join(' ') : find('narration').textContent || '';
      timer = setTimeout(() => { if (step === max) { stop(); return; } step += 1; render(); schedule(); }, readingDelay(text));
    }
    play.addEventListener('click', () => { if (playing) { stop(); return; } if (step === max) step = 0; playing = true; render(); play.textContent = 'Pause'; schedule(); });
    back.addEventListener('click', () => { stop(); if (step > 0) step -= 1; render(); });
    next.addEventListener('click', () => { stop(); if (step < max) step += 1; render(); });
    slider.addEventListener('input', () => { stop(); step = Number(slider.value); render(); });
    find('reset').addEventListener('click', () => { stop(); step = 0; render(); });
    choice?.addEventListener('change', () => { stop(); render(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    render();
  });
</script>

<style>
  .service-figure{margin:2.5rem 0;padding:1rem;border:1px solid var(--color-rule);background:var(--color-surface-alt);font-family:var(--font-sans);font-size:.9rem;min-width:0;}
  figcaption{font-family:var(--font-serif);font-size:1.1rem;margin-bottom:1rem;}figcaption span{font-family:var(--font-sans);text-transform:uppercase;font-size:.7rem;letter-spacing:.1em;margin-right:.5rem;color:var(--color-text-secondary);}
  .choice{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;margin-bottom:1rem;}select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);padding:.55rem .65rem;min-height:44px;max-width:100%;}button{cursor:pointer;}button[aria-disabled="true"]{opacity:.5;cursor:default;}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--color-text);outline-offset:3px;}
  .metrics{display:flex;flex-wrap:wrap;gap:1.2rem;padding:.8rem 0 1.2rem;}.metrics div{display:grid;gap:.15rem;}.metrics strong{font-size:1.25rem;font-weight:500;}.metrics span,.clock,.control-note,.model-note{font-size:.77rem;color:var(--color-text-secondary);}.metrics span{max-width:12rem;}
  .budget{position:relative;height:3rem;background:var(--color-surface);border:1px solid var(--color-rule);overflow:hidden;}.used{height:100%;background:var(--color-text-secondary);opacity:.6;}.reserve{position:absolute;inset:0 0 0 auto;width:33.333%;border-left:2px dashed var(--color-text);display:flex;align-items:center;justify-content:center;font-size:.75rem;background:transparent;}
  .copies{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;}.copies>div,.incident-pair>div{border:1px solid var(--color-rule);padding:.8rem;display:flex;flex-direction:column;gap:.4rem;min-width:0;}.copies span,.incident-pair span{font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;color:var(--color-text-secondary);}.copies strong{font-size:.95rem;font-weight:500;}.copies small{font-size:.77rem;color:var(--color-text-secondary);}.history{border-style:dashed!important;}.narration{border-left:2px solid var(--color-text-secondary);padding:.65rem .8rem;line-height:1.6;min-height:6rem;margin:1rem 0!important;}.phase{font-weight:600;min-height:2.6rem;}.incident-pair{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;}.incident-pair strong{font-size:.95rem;}.incident-pair p{font-size:.88rem;line-height:1.65;margin:0!important;}.model-note,.control-note{line-height:1.6;}.controls{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;border-top:1px solid var(--color-rule);padding-top:1rem;}.controls label{display:flex;align-items:center;gap:.4rem;flex:1;min-width:9rem;}.controls input{width:100%;min-height:44px;}.controls output{font-size:.77rem;white-space:nowrap;}.control-note{margin-bottom:0!important;}
  @media(max-width:600px){.service-figure{padding:.8rem;}.copies,.incident-pair{grid-template-columns:1fr;}.metrics{gap:.8rem;}.metrics strong{font-size:1.1rem;}.narration{min-height:0;}.controls label{order:2;flex-basis:70%;}.controls output{order:2;}.incident-pair p{font-size:.86rem;}}
</style>
