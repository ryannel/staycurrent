---
import {scenes,frames} from './model.mjs';
const {scene,number}=Astro.props;
const def=scenes[scene];
const steps=frames(scene,def.initial);
const last=steps.at(-1);
const id=`isolation-${scene}`;
---
<isolation-figure data-scene={scene}>
 <figure aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`}>Figure {number}. {def.title}</figcaption>
  <p class="model-label">{def.label} · not a live database</p>
  <label hidden data-controls for={`${id}-choice`}>Compare <select id={`${id}-choice`} data-choice>{def.options.map(([value,label])=><option value={value}>{label}</option>)}</select></label>
  <p class="step-title" data-title>{last.title}</p>
  <div class="panels" data-panels>{last.panels.map(panel=><div class="panel"><p class="name">{panel.name}</p><p class="state">{panel.state}</p><p class="detail">{panel.detail}</p></div>)}</div>
  <p class="result" data-result>{last.result}</p>
  <div class="dock">
   <p class="note" data-note aria-live="polite">{last.note}</p>
   <div class="transport" hidden data-controls><button type="button" data-act="play">Play</button><button type="button" data-act="back">Back</button><button type="button" data-act="next">Next</button><button type="button" data-act="reset">Reset</button><label>Step <input type="range" data-step min="0" max={steps.length-1} value={steps.length-1} step="1" /></label><span data-count></span></div>
  </div>
 </figure>
</isolation-figure>
<script>
 import {scenes,frames} from './model.mjs';
 class IsolationFigure extends HTMLElement {
  timer=0;
  connectedCallback(){
   const scene=this.dataset.scene!;
   const def=scenes[scene];
   const q=(s:string)=>this.querySelector<HTMLElement>(s)!;
   const choice=q('[data-choice]') as HTMLSelectElement;
   const slider=q('[data-step]') as HTMLInputElement;
   let steps=frames(scene,def.initial),step=0,playing=false;
   const stop=()=>{window.clearTimeout(this.timer);playing=false;q('[data-act="play"]').textContent='Play';q('[data-note]').setAttribute('aria-live','polite');};
   const draw=()=>{
    const f=steps[step];q('[data-title]').textContent=f.title;q('[data-result]').textContent=f.result;q('[data-note]').textContent=f.note;
    const panels=q('[data-panels]');panels.replaceChildren();
    for(const p of f.panels){const box=document.createElement('div');box.className='panel';for(const [cls,text] of [['name',p.name],['state',p.state],['detail',p.detail]]){const el=document.createElement('p');el.className=cls;el.textContent=text;box.append(el);}panels.append(box);}
    slider.value=String(step);slider.setAttribute('aria-valuetext',`${step+1} of ${steps.length}: ${f.title}`);q('[data-count]').textContent=`${step+1} / ${steps.length}`;
    q('[data-act="back"]').setAttribute('aria-disabled',String(step===0));q('[data-act="next"]').setAttribute('aria-disabled',String(step===steps.length-1));
   };
   const schedule=()=>{const f=steps[step];const text=[f.title,f.result,f.note,...f.panels.flatMap(p=>[p.name,p.state,p.detail])].join(' ');const hold=Math.max(6500,3000+text.split(/\s+/).length*1000/3);this.timer=window.setTimeout(()=>{if(step<steps.length-1){step++;draw();schedule();}else stop();},hold);};
   this.addEventListener('click',event=>{const act=(event.target as Element).closest<HTMLButtonElement>('button')?.dataset.act;if(!act)return;if(act==='play'){if(playing){stop();return;}if(step===steps.length-1)step=0;playing=true;q('[data-act="play"]').textContent='Pause';q('[data-note]').setAttribute('aria-live','off');draw();schedule();return;}stop();if(act==='back')step=Math.max(0,step-1);if(act==='next')step=Math.min(steps.length-1,step+1);if(act==='reset'){choice.value=def.initial;steps=frames(scene,def.initial);step=0;}draw();});
   choice.addEventListener('change',()=>{stop();steps=frames(scene,choice.value);slider.max=String(steps.length-1);step=0;draw();});
   slider.addEventListener('input',()=>{stop();step=Number(slider.value);draw();});
   document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
   this.querySelectorAll<HTMLElement>('[data-controls]').forEach(el=>el.hidden=false);draw();
  }
  disconnectedCallback(){window.clearTimeout(this.timer);}
 }
 if(!customElements.get('isolation-figure'))customElements.define('isolation-figure',IsolationFigure);
</script>
<style>
 isolation-figure{display:block;margin:2rem 0;padding:1rem;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);}figure{margin:0;}figcaption{font-weight:650;}.model-label{font-size:.72rem;color:var(--color-text-secondary);margin:.4rem 0 .8rem;}label{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;font-size:.8rem;}select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.4rem .55rem;max-width:100%;}button{cursor:pointer;}button[aria-disabled=true]{opacity:.55;}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px;}.step-title{font-weight:650;margin:1rem 0 .65rem;}.panels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;}.panel{margin:0;padding:.65rem;background:var(--color-surface);border:1px solid var(--color-rule);border-top:3px solid var(--color-accent);min-width:0;animation:arrive .3s ease-out;}.name{font-size:.7rem;text-transform:uppercase;letter-spacing:.04em;margin:0 0 .4rem;}.state{font-size:.87rem;font-weight:650;margin:0 0 .4rem;overflow-wrap:anywhere;}.detail{font-size:.78rem;margin:0;line-height:1.55;}.result{padding:.6rem;border-left:3px solid var(--color-accent);font-size:.85rem;font-weight:600;margin:.7rem 0;}.dock{position:sticky;bottom:0;background:var(--color-surface-alt);border-top:1px solid var(--color-rule);padding:.35rem 0;z-index:1;}.note{font-size:.82rem;line-height:1.6;margin:.35rem 0 .65rem;}.transport{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem;font-size:.76rem;}.transport label{flex:1;min-width:8rem;}.transport input{width:7rem;min-width:4rem;max-width:100%;}.transport span{font-size:.7rem;}[hidden]{display:none;}@keyframes arrive{from{opacity:.4;transform:translateY(3px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.panel{animation:none;}}@media(max-width:600px){isolation-figure{padding:.65rem;}.panels{grid-template-columns:1fr;gap:.4rem;}.panel{display:grid;grid-template-columns:5.1rem 1fr;gap:.2rem .4rem;padding:.5rem;margin:0;}.name{grid-row:span 2;align-self:center;margin:0;font-size:.64rem;}.state{font-size:.79rem;margin:0;}.detail{font-size:.73rem;}.note{font-size:.77rem;}.result{font-size:.79rem;}}
</style>
