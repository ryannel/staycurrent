---
const common = [
 ['Initial state','Both people are available. Neither transaction has begun.','—','—','available','available'],
 ['Both read the same two people','Both transactions begin and count two available people. Each decides it can let its own person leave.','read both → 2','read both → 2','available','available'],
 ['A changes Mina','A relies on Tariq remaining available and changes Mina. Its write is still uncommitted.','write Mina → unavailable','read both → 2','available','available'],
 ['B changes Tariq','B relies on Mina remaining available and changes Tariq. Different rows were written, so there is no same-row write conflict.','write Mina → unavailable','write Tariq → unavailable','available','available'],
 ['A commits','Mina is now unavailable in the committed state. B still carries its earlier decision.','COMMIT','old decision pending','unavailable','available'],
];
const endings = {
 repeatable: [
  ['B commits too','The chosen Repeatable Read schedule accepts both departures. No instructor remains.','committed','COMMIT','unavailable','unavailable'],
  ['The rule is broken','A before B would make B refuse; B before A would make A refuse. Neither serial order accepts both.','committed','committed','unavailable','unavailable'],
 ],
 serializable: [
  ['B is rejected','In the selected Serializable run, B’s COMMIT fails with 40001. Its change is discarded; Tariq remains available.','committed','40001: aborted','unavailable','available'],
  ['B reconsiders from the beginning','B’s new transaction counts one available instructor. The old decision to leave is no longer valid.','committed','new read → 1; stay','unavailable','available'],
 ],
};
---
<figure class="staffing" data-staffing data-common={JSON.stringify(common)} data-endings={JSON.stringify(endings)} aria-labelledby="staffing-title">
  <figcaption id="staffing-title"><span>Figure 2</span> Different writes, one shared decision</figcaption>
  <p class="legend">Illustrative dependency model · initially Mina and Tariq are available · committed state shown</p>
  <div class="decisions"><div><strong>A · may Mina leave?</strong><p data-a>—</p><p class="state">Mina: <strong data-mina>available</strong></p></div><div><strong>B · may Tariq leave?</strong><p data-b>—</p><p class="state">Tariq: <strong data-tariq>available</strong></p></div></div>
  <p class="dependency" data-dependency>Each decision must keep at least one person available.</p>
  <p class="step-title" data-title>Initial state</p><p class="outcome" data-outcome aria-live="polite">Both people are available. Neither transaction has begun.</p>
  <div class="controls"><label>Isolation <select data-isolation><option value="repeatable">PostgreSQL Repeatable Read</option><option value="serializable">PostgreSQL Serializable</option></select></label></div>
  <div class="controls step-controls"><button type="button" data-back aria-disabled="true">Previous step</button><button type="button" data-next>Next step</button><button type="button" data-reset>Reset</button><span data-progress>1 / 7</span></div>
  <p class="legend">The dependency arrows describe reliance on old values, not messages or elapsed time. The two final outcomes follow the selected native runs. Another run can reject a different attempt or fail earlier.</p>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-staffing]').forEach((figure) => {
    const common = JSON.parse(figure.dataset.common || '[]');
    const endings = JSON.parse(figure.dataset.endings || '{}');
    const isolation = figure.querySelector<HTMLSelectElement>('[data-isolation]')!;
    let step = 0;
    const text = (key: string, value: string) => { figure.querySelector(`[data-${key}]`)!.textContent = value; };
    const render = () => {
      const events = [...common,...endings[isolation.value]];
      const [title,outcome,a,b,mina,tariq] = events[step];
      text('title',title); text('outcome',outcome); text('a',a); text('b',b); text('mina',mina); text('tariq',tariq);
      text('dependency', step >= 3 ? 'A relies on Tariq’s old value → B changes it. B relies on Mina’s old value → A changes it.' : 'Each decision must keep at least one person available.');
      text('progress',`${step+1} / ${events.length}`);
      figure.querySelector('[data-back]')!.setAttribute('aria-disabled',String(step===0));
      figure.querySelector('[data-next]')!.setAttribute('aria-disabled',String(step===events.length-1));
    };
    figure.querySelector('[data-back]')!.addEventListener('click',() => { if(step>0) step--; render(); });
    figure.querySelector('[data-next]')!.addEventListener('click',() => { if(step<6) step++; render(); });
    figure.querySelector('[data-reset]')!.addEventListener('click',() => { step=0; render(); });
    isolation.addEventListener('change',render);
    render();
  });
</script>
<style>
  .staffing{margin:2.2rem 0;padding:1.2rem;border:1px solid var(--color-rule);background:var(--color-surface-alt);font-family:var(--font-sans);}
  figcaption{font:1.2rem var(--font-serif);}figcaption span{font:.7rem var(--font-sans);text-transform:uppercase;letter-spacing:.12em;color:var(--color-text-secondary);margin-right:.6rem;}
  .legend{font-size:.76rem;line-height:1.5;color:var(--color-text-secondary);}.decisions{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.1rem 0;}.decisions>div{border:1px solid var(--color-rule);padding:.8rem;min-width:0;}.decisions strong{font-size:.82rem;}.decisions p{font:.8rem/1.5 var(--font-mono);min-height:3em;overflow-wrap:anywhere;}.decisions .state{min-height:0;border-top:1px solid var(--color-rule);padding-top:.7rem;font:.78rem var(--font-sans);}.dependency{font:.78rem/1.6 var(--font-mono);min-height:3.2em;overflow-wrap:anywhere;}.step-title{font-size:.95rem;font-weight:650;margin:1rem 0 .4rem;}.outcome{font-size:.86rem;line-height:1.6;min-height:4.8em;}
  .step-controls{margin-top:.6rem;}.controls{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-size:.78rem;}.controls label{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;}.controls button,.controls select{max-width:100%;font:inherit;background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-text-secondary);padding:.45rem .6rem;border-radius:.2rem;}.controls button{cursor:pointer;}.controls button[aria-disabled="true"]{opacity:.4;cursor:default;}.controls button:focus-visible,.controls select:focus-visible{outline:2px solid var(--color-text);outline-offset:3px;}
  @media(max-width:540px){.staffing{padding:.8rem;}.decisions{gap:.5rem;}.decisions>div{padding:.5rem;}.decisions p{font-size:.7rem;}.outcome{min-height:7em;}}
</style>
