---
const schedules = {
  overwrite: [
    ['Initial state', 'Neither transaction has started.', '—', '—', 1, 0],
    ['A begins and reads', 'A sees one remaining place and decides it can reserve.', 'BEGIN; read 1', '—', 1, 0],
    ['B begins and reads', 'B sees the same committed value and makes the same decision.', 'read 1', 'BEGIN; read 1', 1, 0],
    ['A writes its decision', 'A writes the constant zero and inserts R1. Its changes are uncommitted.', 'write 0; insert R1', 'read 1', 1, 0],
    ['A commits', 'R1 and remaining = 0 become committed together.', 'COMMIT', 'read 1', 0, 1],
    ['B writes its old decision', 'B writes the constant zero too. It does not test whether a place remains.', 'committed', 'write 0; insert R2', 0, 1],
    ['B commits', 'Both requests were accepted. Zero remaining plus two reservations exceeds capacity one.', 'committed R1', 'COMMIT R2', 0, 2],
  ],
  conditional: [
    ['Initial state', 'Neither transaction has started.', '—', '—', 1, 0],
    ['A begins and takes a place', 'A changes remaining from one to zero only if it is positive. A holds the row lock.', 'BEGIN; decrement → 0', '—', 1, 0],
    ['B begins and tries', 'B reaches the same row. In the model of PostgreSQL Read Committed, its UPDATE waits.', 'holds row lock', 'BEGIN; UPDATE waits', 1, 0],
    ['A records ownership', 'A inserts R1 in the same transaction. Ordinary readers still see the old committed state.', 'insert R1', 'waiting', 1, 0],
    ['A commits', 'A’s reservation and decrement become committed. The row lock is released.', 'COMMIT R1', 'can resume', 0, 1],
    ['B rechecks its condition', 'The current row has zero remaining. The condition remaining > 0 is false, so B changes zero rows.', 'committed R1', 'UPDATE 0', 0, 1],
    ['B declines the reservation', 'B inserts nothing and ends its transaction. There is one accepted request and no overselling.', 'committed R1', 'ROLLBACK; full', 0, 1],
  ],
};
---
<figure class="reservation-race" data-reservation-race data-schedules={JSON.stringify(schedules)} aria-labelledby="reservation-race-title">
  <figcaption id="reservation-race-title"><span>Figure 1</span> Two requests for one place</figcaption>
  <p class="boundary">Illustrative schedules · capacity 1 · committed state shown below</p>
  <div class="lanes"><div><strong>Transaction A · Mina</strong><p data-a>—</p></div><div><strong>Transaction B · Tariq</strong><p data-b>—</p></div></div>
  <div class="state"><div><strong data-remaining>1</strong><span>remaining</span></div><span class="operator">+</span><div><strong data-reservations>0</strong><span>reservations</span></div><span class="operator">=</span><div><strong data-total>1</strong><span>capacity is 1</span></div></div>
  <p class="step-title" data-title>Initial state</p><p class="explanation" data-explanation aria-live="polite">Neither transaction has started.</p>
  <div class="controls"><label>Protection <select data-mode><option value="overwrite">Read, then write zero</option><option value="conditional">Conditional decrement</option></select></label></div>
  <div class="controls step-controls"><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Previous step</button><button type="button" data-next>Next step</button><button type="button" data-reset>Reset</button><span data-progress>1 / 7</span></div>
  <p class="boundary">Each lane is one transaction, from BEGIN to COMMIT or ROLLBACK. The figure is a teaching model; separate native sessions checked these selected schedules.</p>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-reservation-race]').forEach((figure) => {
    const schedules = JSON.parse(figure.dataset.schedules || '{}');
    const mode = figure.querySelector<HTMLSelectElement>('[data-mode]')!;
    const previous = figure.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = figure.querySelector<HTMLButtonElement>('[data-next]')!;
    const play = figure.querySelector<HTMLButtonElement>('[data-play]')!;
    let step = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let playing = false;
    const pause = () => { clearTimeout(timer); playing = false; play.textContent = 'Play'; };
    const text = (name: string, value: string | number) => { figure.querySelector(`[data-${name}]`)!.textContent = String(value); };
    const render = () => {
      const events = schedules[mode.value];
      const [title, explanation, a, b, remaining, reservations] = events[step];
      text('title', title); text('explanation', explanation); text('a', a); text('b', b);
      text('remaining', remaining); text('reservations', reservations); text('total', remaining + reservations);
      text('progress', `${step + 1} / ${events.length}`);
      figure.dataset.invalid = String(remaining + reservations !== 1);
      previous.setAttribute('aria-disabled', String(step === 0)); next.setAttribute('aria-disabled', String(step === events.length - 1));
    };
    const advance = () => {
      if (!playing) return;
      const events = schedules[mode.value];
      const words = events[step][1].split(/\s+/).length;
      timer = setTimeout(() => {
        if (step < events.length - 1) { step++; render(); advance(); }
        else pause();
      }, Math.max(4500, words * 60000 / 165 + 1500));
    };
    play.addEventListener('click', () => {
      if (playing) { pause(); return; }
      if (step === schedules[mode.value].length - 1) step = 0;
      playing = true; play.textContent = 'Pause'; render(); advance();
    });
    previous.addEventListener('click', () => { pause(); if (step > 0) step--; render(); });
    next.addEventListener('click', () => { pause(); if (step < schedules[mode.value].length - 1) step++; render(); });
    figure.querySelector('[data-reset]')!.addEventListener('click', () => { pause(); step = 0; render(); });
    mode.addEventListener('change', () => { pause(); render(); });
    render();
  });
</script>
<style>
  .reservation-race{margin:2.2rem 0;padding:1.2rem;border:1px solid var(--color-rule);background:var(--color-surface-alt);font-family:var(--font-sans);}
  figcaption{font-family:var(--font-serif);font-size:1.2rem;}figcaption span{font: .7rem var(--font-sans);text-transform:uppercase;letter-spacing:.12em;margin-right:.6rem;color:var(--color-text-secondary);}
  .boundary{font-size:.76rem;line-height:1.5;color:var(--color-text-secondary);margin:.6rem 0;}
  .lanes{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.1rem 0;}
  .lanes>div{padding:.8rem;border:1px solid var(--color-rule);border-top:3px solid var(--color-text-secondary);min-width:0;}
  .lanes strong{font-size:.8rem;}.lanes p{font:.82rem/1.6 var(--font-mono);min-height:3.1em;margin:.7rem 0 0;overflow-wrap:anywhere;}
  .state{display:flex;align-items:center;justify-content:space-around;padding:1rem .3rem;border-block:1px solid var(--color-rule);gap:.4rem;}
  .state div{display:flex;flex-direction:column;text-align:center;}.state strong{font:2rem var(--font-mono);}.state span{font-size:.7rem;color:var(--color-text-secondary);}.state .operator{font-size:1.4rem;}
  [data-invalid="true"] .state{border:2px dashed var(--color-text);}.step-title{font-size:.95rem;font-weight:650;margin:1rem 0 .4rem;}.explanation{min-height:4.5em;font-size:.86rem;line-height:1.6;margin:.4rem 0 1rem;}
  .step-controls{margin-top:.6rem;}.controls{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-size:.78rem;}.controls label{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;}.controls button,.controls select{font:inherit;background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-text-secondary);padding:.45rem .6rem;border-radius:.2rem;}.controls button{cursor:pointer;}.controls button[aria-disabled="true"]{opacity:.4;cursor:default;}.controls button:focus-visible,.controls select:focus-visible{outline:2px solid var(--color-text);outline-offset:3px;}
  @media(max-width:540px){.reservation-race{padding:.8rem;}.lanes{gap:.5rem;}.lanes>div{padding:.5rem;}.lanes strong{font-size:.7rem;}.lanes p{font-size:.72rem;}.explanation{min-height:7em;}}
</style>
