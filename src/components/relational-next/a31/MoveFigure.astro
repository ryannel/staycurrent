---
import { scenes, frames } from './model.mjs';
const { scene, number } = Astro.props;
const def = scenes[scene];
const steps = frames(scene, def.initial);
const last = steps.at(-1);
const id = `a31-${scene}`;
---
<database-move-figure data-scene={scene}>
 <figure aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`}>Figure {number}. {def.title}</figcaption>
  <p class="model-label">Illustrative model · no database runs in this figure</p>
  <label class="comparison" data-controls hidden for={`${id}-choice`}>Compare <select id={`${id}-choice`} data-choice>{def.options.map(([value,label]) => <option value={value} selected={value===def.initial}>{label}</option>)}</select></label>
  <ol class="timeline" data-timeline aria-label="Procedure progress">{steps.map((f,i)=><li data-current={i===steps.length-1?'true':undefined}>{f.title}</li>)}</ol>
  <p class="step-title" data-title>{last.title}</p>
  <p class="event" data-event>{last.event}</p>
  <div class="lanes" data-panels>{last.panels.map(p=><div class="lane"><p class="name">{p.name}</p><p class="state">{p.state}</p><ul class="rows">{p.rows.map(r=><li>{r}</li>)}</ul><p class="detail">{p.detail}</p></div>)}</div>
  <p class="result" data-result data-gate={last.gate}>{last.result}</p>
  <p class="note" data-note aria-live="polite">{last.note}</p>
  <div class="transport" data-controls hidden>
   <button type="button" data-action="play">Play</button><button type="button" data-action="back">Back</button><button type="button" data-action="next">Next</button><button type="button" data-action="end">End</button><button type="button" data-action="reset">Reset</button>
   <label for={`${id}-step`}>Step <input id={`${id}-step`} type="range" min="0" max={steps.length-1} value={steps.length-1} step="1" data-step /></label><span data-count></span>
  </div>
  <details><summary>Default sequence as text</summary><ol>{steps.map(f=><li><strong>{f.title}.</strong> {f.event} {f.panels.map(p=>`${p.name}: ${p.state}; ${p.rows.join(', ')}. `).join('')} {f.result} {f.note}</li>)}</ol></details>
 </figure>
</database-move-figure>
<script>
 import { scenes, frames } from './model.mjs';
 class DatabaseMoveFigure extends HTMLElement {
  timer=0;
  dispose=()=>{};
  connectedCallback(){
   const scene=this.dataset.scene!;
   const def=scenes[scene];
   const q=(selector:string)=>this.querySelector<HTMLElement>(selector)!;
   const choice=q('[data-choice]') as HTMLSelectElement;
   const slider=q('[data-step]') as HTMLInputElement;
   let steps=frames(scene,def.initial),step=0,playing=false;
   const stop=()=>{window.clearTimeout(this.timer);playing=false;q('[data-action="play"]').textContent='Play';q('[data-note]').setAttribute('aria-live','polite');};
   const draw=()=>{
    const f=steps[step];
    for(const [selector,value] of [['[data-title]',f.title],['[data-event]',f.event],['[data-result]',f.result],['[data-note]',f.note]])q(selector).textContent=value;
    q('[data-result]').dataset.gate=f.gate;
    const lanes=q('[data-panels]');lanes.replaceChildren();
    for(const p of f.panels){
     const lane=document.createElement('div');lane.className='lane';
     for(const [cls,value] of [['name',p.name],['state',p.state]]){const el=document.createElement('p');el.className=cls;el.textContent=value;lane.append(el);}
     const rows=document.createElement('ul');rows.className='rows';
     for(const text of p.rows){const li=document.createElement('li');li.textContent=text;rows.append(li);}lane.append(rows);
     const detail=document.createElement('p');detail.className='detail';detail.textContent=p.detail;lane.append(detail);lanes.append(lane);
    }
    const timeline=q('[data-timeline]');timeline.replaceChildren(...steps.map((f,i)=>{const li=document.createElement('li');li.textContent=f.title;li.dataset.current=String(i===step);li.dataset.done=String(i<step);return li;}));
    slider.value=String(step);slider.max=String(steps.length-1);slider.setAttribute('aria-valuetext',`${step+1} of ${steps.length}: ${f.title}`);
    q('[data-count]').textContent=`${step+1} / ${steps.length}`;
    // aria-disabled preserves keyboard focus on controls at the endpoints.
    q('[data-action="back"]').setAttribute('aria-disabled',String(step===0));q('[data-action="next"]').setAttribute('aria-disabled',String(step===steps.length-1));
   };
   const schedule=()=>{
    // All rendered visible text contributes, including changed rows and controls.
    const words=q('figure').innerText.split(/\s+/).filter(Boolean).length;
    const hold=Math.max(12000,4000+words*1000/3);
    this.timer=window.setTimeout(()=>{if(step<steps.length-1){step++;draw();schedule();}else stop();},hold);
   };
   this.addEventListener('click',event=>{
    const action=(event.target as Element).closest<HTMLButtonElement>('button')?.dataset.action;if(!action)return;
    if(action==='play'){if(playing){stop();return;}if(step===steps.length-1)step=0;playing=true;q('[data-action="play"]').textContent='Pause';q('[data-note]').setAttribute('aria-live','off');draw();schedule();return;}
    stop();if(action==='back')step=Math.max(0,step-1);if(action==='next')step=Math.min(steps.length-1,step+1);if(action==='end')step=steps.length-1;
    if(action==='reset'){choice.value=def.initial;steps=frames(scene,def.initial);step=0;}draw();
   });
   choice.addEventListener('change',()=>{stop();steps=frames(scene,choice.value);step=Math.min(step,steps.length-1);draw();});
   slider.addEventListener('input',()=>{stop();step=Number(slider.value);draw();});
   const onVisibility=()=>{if(document.hidden)stop();};
   document.addEventListener('visibilitychange',onVisibility);
   // No whole-figure intersection threshold: tall phone figures play when partly visible.
   this.dispose=()=>document.removeEventListener('visibilitychange',onVisibility);
   this.querySelectorAll<HTMLElement>('[data-controls]').forEach(el=>el.hidden=false);draw();
  }
  disconnectedCallback(){window.clearTimeout(this.timer);this.dispose();}
 }
 if(!customElements.get('database-move-figure'))customElements.define('database-move-figure',DatabaseMoveFigure);
</script>
<style>
 database-move-figure{display:block;margin:2rem 0;padding:1rem;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);}
 figure{margin:0;}figcaption{font-weight:650;font-size:.92rem;}.model-label{margin:.4rem 0 .8rem;color:var(--color-text-secondary);font-size:.72rem;}
 .comparison{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;font-size:.8rem;}button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .55rem;max-width:100%;}button{cursor:pointer;}button[aria-disabled=true]{opacity:.55;}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px;}
 .timeline{display:flex;flex-wrap:wrap;list-style:none;padding:0;gap:.25rem;margin:1rem 0;counter-reset:move-step;}.timeline :global(li){counter-increment:move-step;border-bottom:2px solid var(--color-rule);padding:.3rem;font-size:.66rem;color:var(--color-text-secondary);}.timeline :global(li::before){content:counter(move-step) '. ';}.timeline :global(li[data-current=true]){color:var(--color-text);border-color:var(--color-accent);font-weight:650;}.timeline :global(li[data-done=true]){border-color:var(--color-rule-strong);}
 .step-title{font-weight:650;font-size:.9rem;margin:.7rem 0 .5rem;}.event{border-left:3px solid var(--color-accent);background:var(--color-surface);padding:.4rem .6rem;font-size:.8rem;margin:0 0 .7rem;overflow-wrap:anywhere;}
 .lanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;}.lanes :global(.lane){padding:.65rem;border:1px solid var(--color-rule);background:var(--color-surface);min-width:0;}.lanes :global(.name){margin:0 0 .4rem;font-size:.67rem;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.04em;}.lanes :global(.state){margin:0 0 .4rem;font-weight:650;font-size:.82rem;line-height:1.45;overflow-wrap:anywhere;}.lanes :global(.rows){list-style:none;margin:.3rem 0;padding:0;}.lanes :global(.rows li){padding:.3rem;margin:.2rem 0;border:1px solid var(--color-rule);font:.72rem/1.5 var(--font-mono);background:var(--color-surface-alt);overflow-wrap:anywhere;}.lanes :global(.detail){margin:0;font-size:.75rem;}
 .result{padding:.45rem .6rem;border:1px solid var(--color-rule);font-weight:650;font-size:.83rem;margin:.7rem 0 .4rem;}.result[data-gate=closed]{border-style:dashed;border-color:var(--color-rule-strong);}.result[data-gate=pass]{border-color:var(--color-accent);}.note{font-size:.8rem;line-height:1.6;margin:.4rem 0 .8rem;}
 .transport{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem;border-top:1px solid var(--color-rule);padding-top:.65rem;font-size:.75rem;}.transport label{display:flex;align-items:center;gap:.35rem;flex:1;min-width:8rem;}.transport input{min-width:4rem;width:100%;}.transport span{font-size:.7rem;}details{margin-top:.7rem;font-size:.76rem;}[hidden]{display:none;}
 @media(max-width:600px){database-move-figure{padding:.65rem;}.lanes{grid-template-columns:1fr;gap:.4rem;}.lanes :global(.lane){display:grid;grid-template-columns:5rem 1fr;gap:.2rem .4rem;padding:.5rem;}.lanes :global(.name){grid-row:span 3;align-self:center;margin:0;font-size:.62rem;}.lanes :global(.state){font-size:.77rem;margin:0;}.lanes :global(.rows){margin:0;}.lanes :global(.rows li){font-size:.7rem;margin:.15rem 0;}.event,.note{font-size:.76rem;}.timeline :global(li){font-size:.62rem;}.result{font-size:.78rem;}figcaption{font-size:.86rem;}.step-title{font-size:.84rem;}}
</style>
