---
import {scenes} from './model.mjs';
const {scene,number}=Astro.props;
const model=scenes[scene];
const first=model.steps(0)[0];
const initialPanels=first.panels||[{label:'',lanes:first.lanes,metrics:first.metrics}];
const transcript=s=>`${s.title}. ${(s.panels||[{label:'',lanes:s.lanes,metrics:s.metrics}]).map(p=>`${p.label}. ${p.lanes.map(l=>`${l.label}: ${l.items.join('; ')||'None'}`).join('. ')}. ${p.metrics.map(m=>`${m.label}: ${m.value}`).join('; ')}`).join('. ')}. ${s.note}`;
---
<figure class="load-figure" data-load-figure data-scene={scene} aria-labelledby={`a28-${scene}`}>
 <figcaption id={`a28-${scene}`}><span>Figure {number}</span>{model.title}</figcaption>
 <p class="kind">{model.kind}</p>
 <div class="choices" role="group" aria-label={`Assumptions for figure ${number}`}>{model.choices.map((choice,i)=><button type="button" data-choice={i} aria-pressed={i===0}>{choice}</button>)}</div>
 <p class="step-title" data-step-title>{first.title}</p>
 {scene==='boundary'&&<div class="timeline" data-timeline aria-label="Queue 70 ms, row wait 0 ms, work 20 ms, reply 10 ms"><span style="flex:70">Queue</span><span style="flex:20">Work</span><span style="flex:10">Reply</span></div>}
 <div class:list={['panels',{'comparison':Boolean(first.panels)}]} data-board>{initialPanels.map(panel=><div class="panel">{panel.label&&<p class="panel-label">{panel.label}</p>}<div class="lanes">{panel.lanes.map(lane=><div class="lane"><p>{lane.label}</p><div class="chips">{lane.items.length?lane.items.map(item=><span>{item}</span>):<span>None yet</span>}</div></div>)}</div>{panel.offered!==undefined&&<p class="completion-count">{panel.completed} useful completions / {panel.offered} arrivals</p>}<dl>{panel.metrics.map(m=><div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl></div>)}</div>
 <p class="note" data-note aria-live="polite">{first.note}</p>
 <div class="controls" role="group" aria-label={`Playback for figure ${number}`}><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-play>Play</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><output data-position>Step 1 of {model.steps(0).length}</output></div>
 <details><summary>Read every step</summary>{model.choices.map((choice,i)=><div><p><strong>{choice}</strong></p><ol>{model.steps(i).map(step=><li>{transcript(step)}</li>)}</ol></div>)}</details>
</figure>
<script>
 import {scenes,readingMilliseconds} from './model.mjs';
 document.querySelectorAll<HTMLElement>('[data-load-figure]').forEach(root=>{
  if(root.dataset.ready)return;root.dataset.ready='true';
  const model=scenes[root.dataset.scene!];
  let variant=0,position=0,timer:ReturnType<typeof setTimeout>|undefined;
  const el=(s:string)=>root.querySelector<HTMLElement>(s)!;
  const steps=()=>model.steps(variant);
  const node=(tag:string,className:string,text?:string|number)=>{const n=document.createElement(tag);n.className=className;if(text!==undefined)n.textContent=String(text);return n;};
  const stop=()=>{clearTimeout(timer);timer=undefined;el('[data-play]').textContent='Play';};
  const render=()=>{
   position=Math.max(0,Math.min(position,steps().length-1));const s=steps()[position];
   el('[data-step-title]').textContent=s.title;el('[data-note]').textContent=s.note;
   const panels=s.panels||[{label:'',lanes:s.lanes,metrics:s.metrics}];
   el('[data-board]').replaceChildren(...panels.map(p=>{
    const panel=node('div','panel');if(p.label)panel.append(node('p','panel-label',p.label));
    const lanes=node('div','lanes');p.lanes.forEach(l=>{const lane=node('div','lane');lane.append(node('p','lane-label',l.label));const chips=node('div','chips');(l.items.length?l.items:['None yet']).forEach(t=>chips.append(node('span','chip',t)));lane.append(chips);lanes.append(lane);});panel.append(lanes);
    if(p.offered!==undefined){const progress=node('div','progress');progress.setAttribute('aria-hidden','true');const bar=node('span','progress-fill');bar.style.width=`${p.completed/240*100}%`;progress.append(bar);panel.append(progress,node('p','completion-count',`${p.completed} useful completions / ${p.offered} arrivals`));}
    const dl=node('dl','metrics');p.metrics.forEach(m=>{const box=node('div','metric');box.append(node('dt','metric-label',m.label),node('dd','metric-value',m.value));dl.append(box);});panel.append(dl);return panel;
   }));
   const timeline=root.querySelector<HTMLElement>('[data-timeline]');if(timeline){timeline.replaceChildren(...s.segments.map((n:number,i:number)=>{const item=node('span','segment',`${['Queue','Row wait','Work','Reply'][i]} ${n} ms`);item.style.flex=String(n);item.hidden=n===0;return item;}));timeline.setAttribute('aria-label',s.segments.map((n:number,i:number)=>`${['Queue','Row wait','Work','Reply'][i]} ${n} ms`).join(', '));}
   el('[data-position]').textContent=`Step ${position+1} of ${steps().length}`;el('[data-back]').setAttribute('aria-disabled',String(position===0));el('[data-next]').setAttribute('aria-disabled',String(position===steps().length-1));
   root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((b,i)=>b.setAttribute('aria-pressed',String(i===variant)));
  };
  const play=()=>{render();if(position===steps().length-1){stop();return;}el('[data-play]').textContent='Pause';timer=setTimeout(()=>{position++;play();},readingMilliseconds(root.innerText));};
  root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{stop();variant=Number(b.dataset.choice);position=0;render();}));
  el('[data-back]').addEventListener('click',()=>{stop();position=Math.max(0,position-1);render();});
  el('[data-next]').addEventListener('click',()=>{stop();position=Math.min(steps().length-1,position+1);render();});
  el('[data-reset]').addEventListener('click',()=>{stop();position=0;render();});
  el('[data-play]').addEventListener('click',()=>{if(timer){stop();return;}if(position===steps().length-1)position=0;play();});
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  const observer=new IntersectionObserver(entries=>{for(const entry of entries)if(!entry.isIntersecting)stop();},{threshold:0});observer.observe(root);
  render();
 });
</script>
<style>
 .load-figure{margin:2rem 0;padding:1rem;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface);min-width:0}
 figcaption{font-weight:650;line-height:1.5}figcaption>span{display:block;font-size:.74rem;letter-spacing:.06em;text-transform:uppercase;color:var(--color-text-secondary)}.kind{margin:.35rem 0 .8rem;font-size:.8rem;color:var(--color-text-secondary)}.choices,.controls{display:flex;flex-wrap:wrap;gap:.4rem}.choices button,.controls button{font:inherit;font-size:.82rem;min-height:44px;padding:.5rem .65rem;border:1px solid var(--color-rule);background:var(--color-surface-alt);color:var(--color-text);border-radius:.3rem;cursor:pointer}.choices button[aria-pressed=true]{border-color:var(--color-text);box-shadow:inset 0 -3px var(--color-text)}button[aria-disabled=true]{opacity:.5}button:focus-visible,summary:focus-visible{outline:2px solid var(--color-text);outline-offset:3px}.step-title{font-weight:650;font-size:.95rem;line-height:1.5;margin:1rem 0 .6rem}.panels{display:grid;grid-template-columns:minmax(0,1fr);gap:.7rem}.panels.comparison{grid-template-columns:repeat(2,minmax(0,1fr))}
 .panels :global(.panel){min-width:0}.panels :global(.panel-label){font-size:.9rem;font-weight:650;margin:.3rem 0 .6rem}.panels :global(.lane){padding:.65rem;border:1px solid var(--color-rule);background:var(--color-surface-alt);margin:.4rem 0;min-height:74px}.panels :global(.lane p){font-size:.74rem;color:var(--color-text-secondary);margin:0 0 .35rem}.panels :global(.chips){display:flex;flex-wrap:wrap;gap:.3rem}.panels :global(.chips span){font:.76rem/1.5 var(--font-mono);padding:.25rem .4rem;border:1px solid var(--color-rule);background:var(--color-surface);overflow-wrap:anywhere;animation:a28-appear .2s ease-out}.panels :global(dl){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin:.8rem 0}.panels :global(dl>div){border-top:2px solid var(--color-text);padding-top:.35rem}.panels :global(dt){font-size:.7rem;line-height:1.5;color:var(--color-text-secondary)}.panels :global(dd){font-size:1rem;font-weight:650;margin:.25rem 0;overflow-wrap:anywhere}.panels :global(.progress){height:.6rem;background:var(--color-surface-alt);border:1px solid var(--color-rule);margin-top:.8rem}.panels :global(.progress-fill){display:block;height:100%;background:var(--color-text);transition:width .25s ease}.panels :global(.completion-count){font-size:.78rem;margin:.35rem 0}.note{font-size:.9rem;line-height:1.75;margin:.8rem 0}.controls output{font-size:.8rem;align-self:center}.timeline{display:flex;width:100%;height:3rem;gap:2px;margin-bottom:.9rem}.timeline :global(span){min-width:0;display:flex;align-items:center;justify-content:center;border:1px solid var(--color-rule);background:var(--color-surface-alt);font-size:.7rem;overflow:hidden;text-align:center}.timeline :global(span[hidden]){display:none}details{font-size:.85rem;margin-top:1rem}summary{cursor:pointer;min-height:36px}details li{margin:.6rem 0;line-height:1.7}
 @keyframes a28-appear{from{opacity:.4;transform:translateY(3px)}to{opacity:1;transform:translateY(0)}}
 @media(max-width:620px){.load-figure{padding:.75rem}.panels.comparison{grid-template-columns:1fr}.choices button{flex:1 1 140px}.controls button{flex:1}.controls output{flex-basis:100%}.panels :global(dd){font-size:.95rem}.timeline :global(span){font-size:.63rem}}
 @media(prefers-reduced-motion:reduce){.panels :global(.chips span){animation:none}.panels :global(.progress-fill){transition:none}}
</style>
