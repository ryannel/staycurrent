---
interface Props { scene: 'boundary' | 'pages' | 'plan' | 'load' | 'comparison'; number: number }
const { scene, number } = Astro.props;
const titles = { boundary: 'The same request, three different delays', pages: 'Four matching rows can occupy one page or four', plan: 'A small prediction becomes 8,000 repeated probes', load: 'Admission changes where work waits', comparison: 'Keep the report beside the work it competes with' };
const states = {
 boundary: [
  { label: 'Pool wait', note: 'The database finishes in 20 ms. Waiting to borrow a connection adds 120 ms.', bars: [['Connection wait',120],['Database',20],['Transfer + application',20]], result: '160 ms from request to response' },
  { label: 'Execution', note: 'The same total now comes mainly from database execution. A pool change would miss this cause.', bars: [['Connection wait',5],['Database',135],['Transfer + application',20]], result: '160 ms from request to response' },
  { label: 'Transfer', note: 'The database is quick, but a large response and application processing dominate.', bars: [['Connection wait',5],['Database',20],['Transfer + application',135]], result: '160 ms from request to response' }
 ],
 pages: [
  { label:'Scattered matches', note:'Four matching rows live on four different table pages. Locating four entries still needs four base-page accesses.', marks:[0,8,16,24], touched:[0,1,2,4],result:'4 matching rows · 4 table pages' },
  { label:'Nearby matches',note:'The same four rows now share one page. The result is unchanged; locality removes three table-page accesses.', marks:[0,1,2,3],touched:[0],result:'4 matching rows · 1 table page' },
  { label:'Broad request',note:'Twenty matching rows reach every page. An index route adds index work before visiting all six table pages.',marks:[0,1,2,6,7,8,12,13,14,18,19,20,24,25,26,30,31,32,33,34],touched:[0,1,2,3,4,5],result:'20 matching rows · all 6 table pages' }
 ],
 plan: [
  { label:'Before: expected',note:'The stale estimate predicts 18 north customers. Repeated indexed lookups appear small enough.',path:['Customers: estimated 18','Order lookup: estimated 10 per customer','Group + rank: estimated 18 groups'],result:'Estimated customers: 18; observed customers: 8,000' },
  { label:'Before: observed',note:'Every customer produces ten orders. The inner scan runs 8,000 times, and sorting all 80,000 rows spills.',path:['Customers: observed 8,000','Order lookup: 10 rows × 8,000 loops','Sort 80,000 rows → 8,000 groups → top 10'],result:'96,104 shared hits · 187 temporary blocks read' },
  { label:'After ANALYZE',note:'The refreshed estimate is 8,000 customers. A hash join scans orders once, then hash aggregation forms the groups.',path:['Customers: estimated and observed 8,000','Scan 100,000 orders → hash join → 80,000 rows','Hash aggregate: 8,000 groups → top 10'],result:'745 shared hits · no temporary blocks read' }
 ],
 load: [
  {label:'Admit all six',note:'Illustrative model: one bottleneck finishes one job per tick. Six callers enter together; five wait inside the database.',path:['Application queue: 0','Database: 1 working + 5 waiting','Completion times: ticks 1, 2, 3, 4, 5, 6'],result:'Last response: tick 6' },
  {label:'Admit only two',note:'Four callers now wait before admission. The bottleneck still finishes one per tick. Moving the queue alone has saved no caller time.',path:['Application queue: 4','Database: 1 working + 1 waiting','Completion times: ticks 1, 2, 3, 4, 5, 6'],result:'Last response: still tick 6' },
  {label:'Remove half the work',note:'With the same admission limit, each job now needs half a tick at the bottleneck. Useful work really does finish sooner.',path:['Application queue: 4 at the start','Database: half a tick per job','Completion times: ticks ½, 1, 1½, 2, 2½, 3'],result:'Last response: tick 3' }
 ],
 comparison: [
  {label:'Before',note:'Observed ranges across three short runs with three clients. Each run completed 364 lookups, 176 changes and 60 reports.',metrics:[['Report p95','55.12–56.61 ms'],['Lookup p95','0.148–0.169 ms'],['Change p95','0.258–0.305 ms'],['All completions','532–587 / s']],result:'Repeated probes and a spilling sort' },
  {label:'After ANALYZE',note:'The same scripts, seed, client count and data size. The report result is identical; ongoing changes only increment a revision counter.',metrics:[['Report p95','15.73–16.30 ms'],['Lookup p95','0.134–0.156 ms'],['Change p95','0.221–0.266 ms'],['All completions','1,408–1,623 / s']],result:'One orders scan; no observed report spill' }
 ]
};
const panels = states[scene];
const comparisonRows = [
 ['Report p95', 'ms', '55.12–56.61', '15.73–16.30'],
 ['Lookup p95', 'ms', '0.148–0.169', '0.134–0.156'],
 ['Change p95', 'ms', '0.258–0.305', '0.221–0.266'],
 ['All completions', '/ second', '532–587', '1,408–1,623']
];
---
<figure class="performance-figure" data-performance-figure data-selected-case="0" aria-labelledby={`a05-figure-${number}`}>
 <figcaption id={`a05-figure-${number}`}><span>Figure {number}</span> {titles[scene]}</figcaption>
 <div class="choices" role="group" aria-label={`Cases for figure ${number}`}>
  {panels.map((state,index)=><button type="button" data-case={index} aria-pressed={index===0}>{state.label}</button>)}
 </div>
 {scene==='comparison' && <div class="comparison-evidence" data-comparison-evidence><table>
  <caption>Observed ranges across three runs per phase</caption>
  <thead><tr><th scope="col">Measurement</th><th scope="col" data-phase="0">Before</th><th scope="col" data-phase="1">After<br />ANALYZE</th></tr></thead>
  <tbody>{comparisonRows.map(([label,unit,before,after])=><tr><th scope="row">{label}<small>{unit}</small></th><td data-phase="0">{before}</td><td data-phase="1">{after}</td></tr>)}</tbody>
 </table></div>}
 {panels.map((state,index)=><div class="panel" data-panel={index} hidden={index!==0}>
  {'bars' in state && <div class="bars">{state.bars.map(([label,value])=><div class="bar-row"><span>{label}</span><div class="track"><i style={`width:${Number(value)/160*100}%`}></i></div><b>{value} ms</b></div>)}</div>}
  {'marks' in state && <div class="page-map" aria-label={state.result}>{Array.from({length:6},(_,page)=><div class:list={['page',state.touched.includes(page)&&'touched']}><span>Page {page+1}</span><div class="cells">{Array.from({length:6},(_,row)=><i class:list={[state.marks.includes(page*6+row)&&'match']}>{state.marks.includes(page*6+row)?'✓':'·'}</i>)}</div></div>)}</div>}
  {'path' in state && <ol class="path">{state.path.map(item=><li>{item}</li>)}</ol>}

  <p class="result">{state.result}</p><p class="explanation">{state.note}</p>
 </div>)}
 <div class="steps"><button type="button" data-play>Play cases</button><button type="button" data-back disabled>Back</button><output aria-live="polite">1 / {panels.length}</output><button type="button" data-next>Next</button></div>
 <p class="provenance">{scene==='plan'||scene==='comparison'?'Captured PostgreSQL 18.6 verification; this small shared instance is not a production benchmark.':'Illustrative model. These values and layouts are invented; they are not captured execution.'}</p>
 <details><summary>All cases as text</summary><ol>{panels.map(state=><li><strong>{state.label}.</strong> {state.note} {state.result}{'metrics' in state && <ul>{state.metrics.map(([label,value])=><li>{label}: {value}</li>)}</ul>}{'bars' in state && <ul>{state.bars.map(([label,value])=><li>{label}: {value} ms</li>)}</ul>}{'path' in state && <ul>{state.path.map(item=><li>{item}</li>)}</ul>}</li>)}</ol></details>
</figure>
<script>
 document.querySelectorAll<HTMLElement>('[data-performance-figure]').forEach(figure=>{
  if(figure.dataset.ready) return;
  figure.dataset.ready='true';
  const panels=Array.from(figure.querySelectorAll<HTMLElement>('[data-panel]'));
  const choices=Array.from(figure.querySelectorAll<HTMLButtonElement>('[data-case]'));
  const back=figure.querySelector<HTMLButtonElement>('[data-back]')!;
  const next=figure.querySelector<HTMLButtonElement>('[data-next]')!;
  const output=figure.querySelector('output')!;
  const play=figure.querySelector<HTMLButtonElement>('[data-play]')!;
  let timer:ReturnType<typeof setTimeout>|undefined;
  const pause=()=>{if(timer!==undefined)clearTimeout(timer);timer=undefined;play.textContent='Play cases';};
  let current=0;
  const holdFor=(index:number)=>{
   const comparison=figure.querySelector<HTMLElement>('[data-comparison-evidence]');
   const visibleText=[panels[index].innerText,comparison?.innerText].filter(Boolean).join(' ');
   const words=visibleText.trim().split(/\s+/).length;
   // Read the complete visible panel at 180 words/minute, then compare its evidence.
   return Math.max(6000,Math.ceil(words/180*60000)+6000);
  };
  const show=(index:number)=>{
   current=Math.max(0,Math.min(panels.length-1,index));
   // A button becoming disabled must hand keyboard focus to an available control first.
   if((current===0&&document.activeElement===back)||(current===panels.length-1&&document.activeElement===next))play.focus();
   panels.forEach((panel,i)=>panel.hidden=i!==current);
   choices.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===current)));
   figure.dataset.selectedCase=String(current);
   figure.dataset.holdMs=String(holdFor(current));
   back.disabled=current===0;next.disabled=current===panels.length-1;
   output.textContent=`${current+1} / ${panels.length}`;
  };
  const schedule=()=>{
   timer=setTimeout(()=>{
    timer=undefined;show(current+1);
    if(current===panels.length-1){pause();return;}
    schedule();
   },holdFor(current));
  };
  choices.forEach((button,index)=>button.addEventListener('click',()=>{pause();show(index);}));
  back.addEventListener('click',()=>{pause();show(current-1);});next.addEventListener('click',()=>{pause();show(current+1);});
  play.addEventListener('click',()=>{if(timer!==undefined){pause();return;}if(current===panels.length-1)show(0);play.textContent='Pause';schedule();});
  show(0);
 });
</script>
<style>
 .performance-figure{margin:2.5rem 0;padding:1rem;border:1px solid var(--color-rule-strong);background:var(--color-surface-alt);color:var(--color-text)}
 figcaption{font:1.1rem/1.5 var(--font-serif);margin-bottom:1rem}figcaption span{font:.7rem var(--font-sans);text-transform:uppercase;letter-spacing:.09em;margin-right:.6rem;color:var(--color-text-secondary)}
 .choices,.steps{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}.choices{margin-bottom:1.2rem}button{font:.8rem/1.4 var(--font-sans);padding:.5rem .7rem;min-height:2.75rem;border:1px solid var(--color-rule-strong);background:var(--color-surface);color:var(--color-text);border-radius:.2rem;cursor:pointer}button[aria-pressed=true]{border-color:var(--color-accent);box-shadow:inset 0 -3px var(--color-accent)}button:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}button:disabled{opacity:.45;cursor:default}.steps{justify-content:center;margin:1rem 0}.steps output{font:.8rem var(--font-mono);min-width:3rem;text-align:center}
 .comparison-evidence{margin:0 0 1rem;max-width:100%}.comparison-evidence table{width:100%;table-layout:fixed;border-collapse:collapse;font:.76rem/1.55 var(--font-mono)}.comparison-evidence caption{text-align:left;font:.8rem/1.5 var(--font-sans);margin-bottom:.6rem;color:var(--color-text-secondary)}.comparison-evidence th,.comparison-evidence td{padding:.65rem .3rem;border-bottom:1px solid var(--color-rule-strong);text-align:left;vertical-align:top;overflow-wrap:anywhere}.comparison-evidence th{font-family:var(--font-sans);font-weight:600}.comparison-evidence th:first-child{width:34%}.comparison-evidence small{display:block;font-weight:400;color:var(--color-text-secondary)}[data-selected-case="0"] .comparison-evidence [data-phase="0"],[data-selected-case="1"] .comparison-evidence [data-phase="1"]{background:color-mix(in srgb,var(--color-accent) 9%,var(--color-surface));box-shadow:inset 0 -2px var(--color-accent)}
 .bar-row{display:grid;grid-template-columns:10rem 1fr 4rem;align-items:center;gap:.5rem;font:.8rem var(--font-sans);margin:.8rem 0}.bar-row b{font:inherit;text-align:right}.track{height:1.1rem;border-left:1px solid var(--color-rule-strong);background:var(--color-surface)}.track i{display:block;height:100%;background:var(--color-accent)}
 .page-map{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}.page{border:1px dashed var(--color-rule-strong);padding:.5rem;opacity:.55}.page.touched{border:2px solid var(--color-accent);opacity:1}.page>span{font:.7rem var(--font-mono)}.cells{display:grid;grid-template-columns:repeat(3,1fr);gap:.2rem;margin-top:.4rem}.cells i{text-align:center;font:1rem var(--font-mono);background:var(--color-surface);border:1px solid var(--color-rule);padding:.2rem}.cells .match{color:var(--color-accent);border-color:var(--color-accent);font-weight:700}.path{list-style:none;padding:0;margin:0;display:grid;gap:.5rem}.path li{margin:0;padding:.7rem;border:1px solid var(--color-rule-strong);font:.85rem/1.5 var(--font-mono)}.path li+li:before{content:'↓ ';color:var(--color-accent)}.result{font:1rem/1.5 var(--font-mono);border-top:1px solid var(--color-rule-strong);padding-top:.8rem}.explanation{min-height:4.5em;font:.9rem/1.65 var(--font-sans)}.provenance,details{font:.78rem/1.6 var(--font-sans);color:var(--color-text-secondary)}summary{cursor:pointer}details li{margin:.6rem 0}.panel[hidden]{display:none}
 @media(max-width:550px){.performance-figure{padding:.7rem}.bar-row{grid-template-columns:1fr 4rem}.bar-row>span{grid-column:1/-1}.page-map{grid-template-columns:repeat(2,1fr)}.explanation{min-height:0}.path li{font-size:.75rem}.choices button{flex:1 1 8rem}}
</style>
