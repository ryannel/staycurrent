---
import {scenes, frames} from './model.mjs';
const {scene,number}=Astro.props;
const def=scenes[scene];
const steps=frames(scene,def.initial);
const first=steps[0];
const id=`a37-${scene}`;
---
<maintenance-figure data-scene={scene}>
 <figure aria-labelledby={`${id}-caption`}>
  <figcaption id={`${id}-caption`}>Figure {number}. {def.title}</figcaption>
  <p class="model-label">Illustrative model · controls do not run a database</p>
  <label class="comparison" data-controls hidden for={`${id}-choice`}>Compare <select id={`${id}-choice`} data-choice>{def.options.map(([value,label])=><option value={value}>{label}</option>)}</select></label>
  <p class="step-title" data-title>{first.title}</p>
  <p class="event" data-event>{first.event}</p>
  <div class="lanes" data-panels>{first.panels.map(p=><div class="lane"><p class="name">{p.name}</p><p class="state">{p.state}</p><p class="detail">{p.detail}</p>{scene==='budget'&&<div class="bar" aria-hidden="true"><span style={`width:${p.fill}%`}></span></div>}</div>)}</div>
  <p class="result" data-result>{first.result}</p>
  <p class="note" data-note aria-live="polite">{first.note}</p>
  <div class="transport" data-controls hidden><button type="button" data-action="play">Play</button><button type="button" data-action="back" aria-disabled="true">Back</button><button type="button" data-action="next">Next</button><button type="button" data-action="end">End</button><button type="button" data-action="reset">Reset</button><output data-count>Step 1 of {steps.length}</output></div>
  <details><summary>Read both sequences as text</summary>{def.options.map(([value,label])=><div><p><strong>{label}</strong></p><ol>{frames(scene,value).map(s=><li><strong>{s.title}.</strong> {s.event}. {s.panels.map(p=>`${p.name}: ${p.state}. ${p.detail}`).join(' ')} {s.result} {s.note}</li>)}</ol></div>)}</details>
 </figure>
</maintenance-figure>
<script>
 import {scenes,frames} from './model.mjs';
 class MaintenanceFigure extends HTMLElement {
  timer:number|undefined;
  observer?:IntersectionObserver;
  visibilityHandler?:()=>void;
  connectedCallback(){
   if(this.dataset.ready)return;
   this.dataset.ready='true';
   const scene=this.dataset.scene!; const def=scenes[scene];
   const q=(s:string)=>this.querySelector<HTMLElement>(s)!;
   const choice=q('[data-choice]') as HTMLSelectElement;
   let steps=frames(scene,def.initial),step=0,playing=false;
   const stop=()=>{window.clearTimeout(this.timer);this.timer=undefined;playing=false;q('[data-action="play"]').textContent='Play';q('[data-note]').setAttribute('aria-live','polite');};
   const draw=()=>{
    const f=steps[step];
    for(const [selector,value] of [['[data-title]',f.title],['[data-event]',f.event],['[data-result]',f.result],['[data-note]',f.note]])q(selector).textContent=value;
    q('[data-panels]').replaceChildren(...f.panels.map(p=>{
     const lane=document.createElement('div');lane.className='lane';
     for(const [cls,value] of [['name',p.name],['state',p.state],['detail',p.detail]]){const el=document.createElement('p');el.className=cls;el.textContent=value;lane.append(el);}
     if(scene==='budget'&&p.name!=='Acceptance gate'){const bar=document.createElement('div');bar.className='bar';bar.setAttribute('aria-hidden','true');const fill=document.createElement('span');fill.style.width=`${p.fill}%`;bar.append(fill);lane.append(bar);}
     return lane;
    }));
    q('[data-count]').textContent=`Step ${step+1} of ${steps.length}`;
    q('[data-action="back"]').setAttribute('aria-disabled',String(step===0));
    q('[data-action="next"]').setAttribute('aria-disabled',String(step===steps.length-1));
    q('[data-action="end"]').setAttribute('aria-disabled',String(step===steps.length-1));
   };
   const schedule=()=>{
    // innerText includes all visible panels, labels, controls and any opened transcript.
    const words=q('figure').innerText.split(/\s+/).filter(Boolean).length;
    this.timer=window.setTimeout(()=>{if(step<steps.length-1){step++;draw();schedule();}else stop();},Math.max(12000,4000+words*1000/3));
   };
   this.addEventListener('click',event=>{
    const button=(event.target as Element).closest<HTMLButtonElement>('button[data-action]');if(!button||button.getAttribute('aria-disabled')==='true')return;
    const action=button.dataset.action;
    if(action==='play'){if(playing){stop();return;}if(step===steps.length-1)step=0;playing=true;q('[data-action="play"]').textContent='Pause';q('[data-note]').setAttribute('aria-live','off');draw();schedule();return;}
    stop();if(action==='back')step--;if(action==='next')step++;if(action==='end')step=steps.length-1;
    if(action==='reset'){choice.value=def.initial;steps=frames(scene,def.initial);step=0;}draw();
   });
   choice.addEventListener('change',()=>{stop();steps=frames(scene,choice.value);step=Math.min(step,steps.length-1);draw();});
   // Pause only when the entire figure has left the viewport, even on a tall phone layout.
   this.observer=new IntersectionObserver(entries=>{if(!entries[0].isIntersecting)stop();},{threshold:0});this.observer.observe(this);
   this.visibilityHandler=()=>{if(document.hidden)stop();};document.addEventListener('visibilitychange',this.visibilityHandler);
   this.querySelectorAll<HTMLElement>('[data-controls]').forEach(el=>el.hidden=false);draw();
  }
  disconnectedCallback(){window.clearTimeout(this.timer);this.observer?.disconnect();if(this.visibilityHandler)document.removeEventListener('visibilitychange',this.visibilityHandler);}
 }
 if(!customElements.get('maintenance-figure'))customElements.define('maintenance-figure',MaintenanceFigure);
</script>
<style>
 maintenance-figure{display:block;margin:2rem 0;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);padding:1rem;min-width:0}figure{margin:0}figcaption{font-weight:650;font-size:.95rem}.model-label{margin:.4rem 0 .8rem;font-size:.75rem;color:var(--color-text-secondary)}.comparison{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-size:.85rem}button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.5rem .65rem;min-height:44px;max-width:100%}button{cursor:pointer}button[aria-disabled=true]{opacity:.55}button:focus-visible,select:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}.step-title{font-weight:650;font-size:.95rem;margin:1rem 0 .5rem}.event{font:.8rem/1.65 var(--font-mono);padding:.5rem .65rem;background:var(--color-surface);border-left:3px solid var(--color-accent);overflow-wrap:anywhere}.lanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}.lanes :global(.lane){border:1px solid var(--color-rule);background:var(--color-surface);padding:.65rem;min-width:0}.lanes :global(.name){font-size:.72rem;color:var(--color-text-secondary);margin:0 0 .5rem}.lanes :global(.state){font-size:.93rem;line-height:1.5;font-weight:650;margin:0 0 .5rem;overflow-wrap:anywhere}.lanes :global(.detail){font-size:.8rem;line-height:1.6;margin:0}.lanes :global(.bar){height:.6rem;border:1px solid var(--color-rule);margin-top:.6rem}.lanes :global(.bar span){height:100%;display:block;background:var(--color-accent)}.result{font-weight:650;font-size:.9rem;line-height:1.6;margin:.9rem 0 .4rem}.note{font-size:.85rem;line-height:1.65;margin:.4rem 0 .9rem}.transport{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;border-top:1px solid var(--color-rule);padding-top:.7rem;font-size:.8rem}.transport output{font-size:.75rem}details{margin-top:.8rem;font-size:.8rem}summary{min-height:36px;cursor:pointer}details li{margin:.6rem 0} [hidden]{display:none}
 @media(max-width:600px){maintenance-figure{padding:.65rem}.lanes{grid-template-columns:1fr}.lanes :global(.lane){padding:.6rem}.lanes :global(.name){margin-bottom:.25rem}.lanes :global(.state){margin-bottom:.3rem}.transport button{flex:1 1 60px}.transport output{flex-basis:100%}.comparison{display:block}.comparison select{display:block;width:100%;margin:.3rem 0}.event{font-size:.75rem}}
</style>
