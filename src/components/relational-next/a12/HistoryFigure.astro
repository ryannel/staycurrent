---
import { kinds, frame } from './model.mjs';
interface Props { kind: keyof typeof kinds; number: number }
const { kind, number } = Astro.props;
const config = kinds[kind];
const initial = frame(kind, config.options[0][0], 0);
const id = `history-${kind}`;
---
<history-model data-kind={kind}>
 <figure aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`}><span>Figure {number}</span> {config.title}</figcaption>
  <div class="hm-options" role="group" aria-label={config.label}>
   <span>{config.label}</span>
   {config.options.map(([value, label], i) => <button type="button" data-choice={value} aria-pressed={String(i === 0)}>{label}</button>)}
  </div>
  <div class="hm-board">
   <p class="hm-step" data-step>{initial.title}</p>
   <div class="hm-cards" data-cards>{initial.cards.map(card => <div class="hm-card"><p class="hm-title">{card.title}</p><ul>{card.lines.map(line => <li>{line}</li>)}</ul></div>)}</div>
   <p class="hm-result" data-result>{initial.result}</p>
  </div>
  <p class="hm-note" data-note aria-live="polite">{initial.note}</p>
  <div class="hm-controls" role="group" aria-label={`Playback for figure ${number}`}>
   <button type="button" data-action="play">Play</button>
   <button type="button" data-action="back">Back</button>
   <button type="button" data-action="next">Next</button>
   <button type="button" data-action="reset">Reset</button>
   <label>Step <input type="range" min="0" max="3" value="0" step="1" aria-label={`Step for figure ${number}`} /></label>
   <output data-count>1 / 4</output>
  </div>
  <p class="hm-scope">Illustrative model of the stated policy. No database runs in this figure.</p>
  <details><summary>Read all steps without playback</summary><ol>{config.options.map(([choice, label]) => <li>{label}<ol>{config.steps.map((_, i) => { const f = frame(kind, choice, i); return <li>{f.title}: {f.note} Result: {f.result}.</li>; })}</ol></li>)}</ol></details>
 </figure>
</history-model>
<script>
 import { kinds, frame } from './model.mjs';
 class HistoryModel extends HTMLElement {
  connectedCallback() {
   const kind = this.dataset.kind as keyof typeof kinds;
   const config = kinds[kind];
   let choice = config.options[0][0], step = 0, playing = false, timer = 0;
   const q = <T extends Element>(selector: string) => this.querySelector<T>(selector)!;
   const scrub = q<HTMLInputElement>('input');
   const playButton = q<HTMLButtonElement>('[data-action="play"]');
   const note = q<HTMLElement>('[data-note]');
   const stop = () => { playing = false; window.clearTimeout(timer); playButton.textContent = step === 3 ? 'Replay' : 'Play'; note.setAttribute('aria-live', 'polite'); };
   const render = () => {
    const f = frame(kind, choice, step);
    q<HTMLElement>('[data-step]').textContent = f.title;
    q<HTMLElement>('[data-cards]').replaceChildren(...f.cards.map(card => {
     const div = document.createElement('div'); div.className = 'hm-card';
     const title = document.createElement('p'); title.className = 'hm-title'; title.textContent = card.title;
     const ul = document.createElement('ul');
     ul.replaceChildren(...card.lines.map(line => { const li = document.createElement('li'); li.textContent = line; return li; }));
     div.append(title, ul); return div;
    }));
    q<HTMLElement>('[data-result]').textContent = f.result;
    note.textContent = f.note;
    scrub.value = String(step);
    scrub.setAttribute('aria-valuetext', `${step + 1} of 4: ${f.title}`);
    q<HTMLElement>('[data-count]').textContent = `${step + 1} / 4`;
    this.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.choice === choice)));
    this.querySelectorAll<HTMLButtonElement>('[data-action="back"], [data-action="next"]').forEach(b => b.setAttribute('aria-disabled', String(b.dataset.action === 'back' ? step === 0 : step === 3)));
    playButton.textContent = playing ? 'Pause' : step === 3 ? 'Replay' : 'Play';
   };
   const schedule = () => {
    // Count every visible board label, card value, result and narration, plus
    // the selected control label. Add time to inspect relationships after reading.
    const visibleText = `${q<HTMLElement>('.hm-board').innerText} ${note.innerText} ${config.label} ${config.options.find(([v]) => v === choice)![1]} ${q<HTMLElement>('figcaption').innerText}`;
    const words = visibleText.trim().split(/\s+/).length;
    const hold = 2500 + Math.ceil(words / 180 * 60000);
    this.dataset.holdMs = String(hold);
    timer = window.setTimeout(() => { if (step === 3) { stop(); return; } step++; render(); schedule(); }, hold);
   };
   this.addEventListener('click', event => {
    const b = (event.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.dataset.choice) { stop(); choice = b.dataset.choice; render(); return; }
    if (b.dataset.action === 'play') {
     if (playing) { stop(); return; }
     if (step === 3) step = 0;
     playing = true; note.setAttribute('aria-live', 'off'); render(); schedule(); return;
    }
    stop();
    if (b.dataset.action === 'next') step = Math.min(3, step + 1);
    if (b.dataset.action === 'back') step = Math.max(0, step - 1);
    if (b.dataset.action === 'reset') { step = 0; choice = config.options[0][0]; }
    render();
   });
   scrub.addEventListener('input', () => { stop(); step = Number(scrub.value); render(); });
   document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
   new IntersectionObserver(entries => { if (!entries[0].isIntersecting) stop(); }).observe(this);
   render(); this.dataset.ready = '';
  }
 }
 if (!customElements.get('history-model')) customElements.define('history-model', HistoryModel);
</script>
<style>
 history-model { display:block; margin:2rem 0; }
 figure { margin:0; border:1px solid var(--color-rule); padding:1rem; background:var(--color-surface-alt); }
 figcaption { font:600 1rem/1.45 var(--font-sans); margin:0 0 .8rem; }
 figcaption span { display:block; font:.72rem/1.4 var(--font-sans); color:var(--color-text-secondary); }
 .hm-options, .hm-controls { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; font:.8rem/1.4 var(--font-sans); }
 .hm-options { margin-bottom:.8rem; }
 button { border:1px solid var(--color-rule-strong); background:var(--color-surface); color:var(--color-text); padding:.45rem .6rem; border-radius:.2rem; cursor:pointer; font:inherit; min-height:2.5rem; }
 button[aria-pressed="true"] { border-color:var(--blue); background:color-mix(in srgb,var(--blue) 13%,var(--color-surface)); }
 button[aria-disabled="true"] { opacity:.6; cursor:default; }
 button:focus-visible,input:focus-visible,summary:focus-visible { outline:2px solid var(--blue); outline-offset:3px; }
 .hm-board { padding:.8rem; background:var(--color-surface); border:1px solid var(--color-rule); }
 .hm-step { margin:0 0 .5rem; font:600 .85rem/1.4 var(--font-sans); }
 .hm-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.6rem; }
 :global(history-model .hm-card) { padding:.65rem; border:1px solid var(--color-rule-strong); min-width:0; }
 :global(history-model .hm-card .hm-title) { margin:0 0 .35rem; font:600 .8rem/1.4 var(--font-sans); }
 :global(history-model .hm-card ul) { margin:0; padding:0; list-style:none; font:.8rem/1.5 var(--font-sans); overflow-wrap:anywhere; }
 :global(history-model .hm-card li) { margin:0; }
 .hm-result { margin:.65rem 0 0; padding-top:.5rem; border-top:1px solid var(--color-rule); font:600 .85rem/1.45 var(--font-sans); }
 .hm-note { margin:.7rem 0; font:.85rem/1.5 var(--font-sans); }
 .hm-controls label { display:flex; align-items:center; gap:.4rem; }
 input { max-width:7rem; accent-color:var(--blue); }
 output { font-variant-numeric:tabular-nums; }
 .hm-scope { margin:.6rem 0; font:.72rem/1.4 var(--font-sans); color:var(--color-text-secondary); }
 details { font:.8rem/1.5 var(--font-sans); }
 summary { cursor:pointer; }
 @media(max-width:520px) {
  figure { padding:.65rem; }
  .hm-board { padding:.55rem; }
  .hm-cards { grid-template-columns:minmax(0,1fr); gap:.4rem; }
  :global(history-model .hm-card) { padding:.45rem .55rem; }
  :global(history-model .hm-card ul) { font-size:.76rem; }
  .hm-options { gap:.3rem; }
  .hm-options>span { width:100%; }
  .hm-controls { gap:.3rem; }
 }
</style>
