---
interface Props {scene: 'width'|'locality'|'toast'|'versions'|'pruning';number:number}
const {scene,number}=Astro.props;
const titles={width:'Wider rows spread the same answer across more pages',locality:'The same four orders, in different places',toast:'A wide value is a separate journey',versions:'A row can disappear before its space is reusable',pruning:'Which month can the predicate exclude?'};
const options={width:[['short','Short notes; id + total'],['wide','Wide notes; id + total'],['project','Wide notes; id only']],locality:[['scattered','Scattered locators'],['nearby','Nearby locators'],['scan','Scan every page']],toast:[['short','Read identifiers'],['full','Read full notes']],versions:[['held','Reader holds snapshot'],['released','Reader finishes']],pruning:[['day','28 February only'],['all','All three months']]} as const;
---
<figure class="a24-figure" data-a24-scene={scene}>
 <figcaption><strong>Figure {number}. {titles[scene]}</strong></figcaption>
 <div class="a24-options"><label>Compare <select data-choice>{options[scene].map(([v,t])=><option value={v}>{t}</option>)}</select></label>{scene==='locality'&&<label><input type="checkbox" data-warm /> Pages already cached</label>}</div>
 <div class="a24-stage" data-stage></div>
 <p class="a24-note" data-note aria-live="polite"></p>
 <p class="a24-count" data-count></p>
 <div class="a24-controls"><button type="button" data-back aria-label={`Previous step in figure ${number}`}>Back</button><button type="button" data-next>Next</button><button type="button" data-play>Play</button><button type="button" data-reset>Reset</button><span data-step></span></div>
 <p class="a24-bound">{scene==='pruning'?'Captured PostgreSQL 18.6 counts, displayed as steps; the cards summarise the observed plan.':'Illustrative mechanism; page positions and animation timing are invented.'} {scene==='toast'&&'The final counter compares captured executions, not the model’s drawn chunks.'}</p>
 <noscript><p>{scene==='width'?'The 12 invented orders fit on three narrow-row pages or six wide-row pages. Selecting id alone leaves the wide-row scan at six pages.':scene==='locality'?'Four row requests can visit four different table pages or one shared page. A sequential scan of this model visits all six pages.':scene==='toast'?'Identifiers need the main table; consuming the full note additionally fetches the out-of-line chunks. Captured buffer hits: 7 versus 4,008.':scene==='versions'?'The old snapshot can retain replaced and deleted row versions. After it ends, cleanup can make their space reusable without shrinking the allocated file.':'The one-day predicate scanned only February: 32 shared hits, versus 103 on the unpartitioned table. All months touched 104, versus 103 unpartitioned.'}</p></noscript>
</figure>
<script>
 type Card={title:string;rows:string[];state?:string};type Frame={cards:Card[];note:string;count:string};
 document.querySelectorAll<HTMLElement>('[data-a24-scene]').forEach(root=>{
  const select=root.querySelector<HTMLSelectElement>('[data-choice]')!;const warm=root.querySelector<HTMLInputElement>('[data-warm]');
  const stage=root.querySelector<HTMLElement>('[data-stage]')!,note=root.querySelector<HTMLElement>('[data-note]')!,count=root.querySelector<HTMLElement>('[data-count]')!;
  const back=root.querySelector<HTMLButtonElement>('[data-back]')!,next=root.querySelector<HTMLButtonElement>('[data-next]')!,play=root.querySelector<HTMLButtonElement>('[data-play]')!,reset=root.querySelector<HTMLButtonElement>('[data-reset]')!;
  let step=0,timer:ReturnType<typeof setTimeout>|undefined;let frames:Frame[]=[];
  const stop=()=>{clearTimeout(timer);timer=undefined;play.textContent='Play';};
  const build=():Frame[]=>{
   const choice=select.value;
   if(root.dataset.a24Scene==='width'){
    const wide=choice!=='short',capacity=wide?2:4,pages=12/capacity,wanted=[1,4,7,10];
    return Array.from({length:pages+1},(_,s)=>({cards:Array.from({length:pages},(_,p)=>({title:`Table page ${p}`,state:s&&p===s-1?'current':p<s?'visited':'',rows:Array.from({length:capacity},(_,r)=>{const id=p*capacity+r+1;return `${wanted.includes(id)?'●':'·'} order ${id} + ${wide?'wide':'short'} note`})})),note:s===0?'Twelve invented orders: four fit on each short-row page, two on each wide-row page. This is a capacity model, not a byte-scale drawing.':s===pages?choice==='project'?'Selecting only id still scanned every wide-row page. Projection changed the answer’s columns, not the stored layout.':'The scan is complete. The same four wanted orders occupy more pages when their inline notes are wider.':`Scan page ${s-1}; examine its ${capacity} rows, including the space occupied by notes the answer does not return.`,count:`${s} of ${pages} model pages scanned · ${wanted.filter(id=>id<=s*capacity).length} of 4 wanted orders found`}));
   }
   if(root.dataset.a24Scene==='locality'){
    const pages=choice==='scattered'?[0,1,3,5]:choice==='nearby'?[0,0,0,0]:[0,1,2,3,4,5];const scanning=choice==='scan';
    return Array.from({length:pages.length+1},(_,s)=>{
     const done=pages.slice(0,s),unique=new Set(done);const matches=[1,6,15,24];const layout=choice==='nearby'?[...matches,...Array.from({length:24},(_,i)=>i+1).filter(id=>!matches.includes(id))]:Array.from({length:24},(_,i)=>i+1);
     const found=scanning?matches.filter(id=>Math.floor((id-1)/4)<s).length:s;
     return {cards:Array.from({length:6},(_,p)=>({title:`Table page ${p}`,state:s&&pages[s-1]===p?'current':unique.has(p)?'visited':'',rows:Array.from({length:4},(_,r)=>{const id=layout[p*4+r];return `${matches.includes(id)?'● wanted':'· other'} order ${id}`;})})),
      note:s===0?'Four wanted orders are marked ●. Predict how many different table pages the chosen route will touch.':s===pages.length?`Finished: ${found} orders found. ${unique.size} different table pages were touched.`:scanning?`Examine page ${pages[s-1]}; test its four rows. ${found} wanted orders found so far.`:`Locator ${s} leads to page ${pages[s-1]}. ${unique.size< s?'This page was already visited.':'This is a different page.'}`,
      count:`${s} table-page accesses · ${unique.size} distinct pages · ${warm?.checked?0:unique.size} loads into the model cache · ${found} orders found`};
    });
   }
   if(root.dataset.a24Scene==='toast'){
    const full=choice==='full';return [
     {cards:[{title:'Stored order',rows:['id = 42','note → out-of-line value']},{title:'TOAST value',rows:['8,192 logical bytes','stored in chunk rows']}],note:'This fixture forces out-of-line storage without compression. The main row keeps a small pointer.',count:'Before the query: main row and chunks are separate'},
     {cards:[{title:'Read main table',rows:['Fetch rows containing id','Pointer present; note not yet consumed'],state:'current'},{title:'TOAST value',rows:['Chunks remain separate','No note fetch yet']}],note:'The identifier query consumes only id. Reading a page containing a pointer does not require following it.',count:'Both queries begin with the main table'},
     {cards:[{title:full?'Consume note':'Return identifiers',rows:full?['Follow TOAST value pointer','Fetch chunks; hash complete value']:['Use id from the main row','Leave the TOAST value alone'],state:'current'},{title:'TOAST value',rows:full?['Chunks fetched via TOAST index','No decompression in this fixture']:['Not fetched for this query','Still occupies allocated storage'],state:full?'visited':''}],note:full?'Hashing the full text forces the value to be fetched. Compression, if used, can add decompression work too.':'The value still exists, but this execution has no reason to fetch its chunks.',count:full?'Captured full-note aggregate: 4,008 shared hits, 0 shared reads':'Captured identifier aggregate: 7 shared hits, 0 shared reads'},
    ];
   }
   if(root.dataset.a24Scene==='versions'){
    const released=choice==='released';return [
     {cards:[{title:'Table page',rows:['Order 42: total 10','Free slot']},{title:'Reader R',rows:['Takes earlier snapshot','Sees total 10']}],note:'R establishes a repeatable-read snapshot before the writer changes the order.',count:'1 current version · 0 replaced versions'},
     {cards:[{title:'Table page',rows:['Old: total 10 — retained','New: total 11 — current'],state:'current'},{title:'Reader R / later reader',rows:['R still reads 10','Later reader reads 11']}],note:'The committed update creates a new heap version. The old one remains for the earlier reader; both occupy space.',count:'1 current version · 1 retained version'},
     {cards:[{title:'After committed DELETE',rows:['Old total 10 — retained','Total 11 — deleted'],state:'current'},{title:'Reader R / later reader',rows:['R still sees order 42','Later reader sees no order']}],note:'Logical deletion removes the order from later results. It does not make all its physical versions immediately reusable.',count:'0 current visible rows · older data still occupies space'},
     {cards:[{title:released?'After R ends + cleanup':'Cleanup while R remains',rows:released?['Old versions removable','Space becomes reusable']:['Old total 10 remains needed','Cleanup cannot free that version'],state:'current'},{title:'Allocated file',rows:['File can remain the same size',released?'Future rows can reuse gaps':'Visibility horizon still limits cleanup']}],note:released?'Ending R permits cleanup of the old version. Reusable bytes inside the file are different from bytes returned to the operating system.':'Cleanup can remove other eligible versions, but must retain what R still needs. Repeating cleanup cannot overrule that snapshot.',count:released?'Old snapshot ended → cleanup may reclaim its versions':'Old snapshot retained → some versions cannot be reclaimed'},
    ];
   }
   const all=choice==='all';return [
    {cards:[{title:'January',rows:['[1 Jan, 1 Feb)']},{title:'February',rows:['[1 Feb, 1 Mar)']},{title:'March',rows:['[1 Mar, 1 Apr)']}],note:all?'The request has no date restriction. No partition bound rules out any month.':'The request is placed_at ≥ 28 February and < 1 March. Which bounds overlap?',count:'Compare bounds before visiting table pages'},
    {cards:[{title:'January',rows:[all?'Scan this partition':'Excluded by bounds'],state:all?'visited':''},{title:'February',rows:['Scan this partition'],state:'current'},{title:'March',rows:[all?'Scan this partition':'Excluded by bounds'],state:all?'visited':''}],note:all?'All three child tables execute. Splitting storage has not eliminated this report’s data.':'The literal-date plan contains a scan of orders_feb only. January and March are absent.',count:all?'3 partitions accessed · 104 shared hits · 0 shared reads':'1 partition accessed · 32 shared hits · 0 shared reads'},
    {cards:[{title:'Unpartitioned',rows:['103 shared hits','0 shared reads']},{title:'Partitioned',rows:all?['104 shared hits','9,000 rows → count + sum']:['32 shared hits','100 rows → count 100, sum 1,000'],state:'current'}],note:all?'The unbounded query accessed 104 blocks against 103 on the original table, with an Append over three children. This is no read-work win.':'The one-day answer was identical. PostgreSQL still examined all February rows; pruning excluded months, not individual rows.',count:all?'No pruning benefit for this query':'71 fewer shared hits for the one-day report'},
   ];
  };
  const render=()=>{
   const f=frames[step];stage.replaceChildren(...f.cards.map(c=>{const card=document.createElement('div');card.className='a24-card';card.dataset.state=c.state||'';const title=document.createElement('p');title.className='a24-card-title';title.textContent=c.title;card.append(title);c.rows.forEach(r=>{const p=document.createElement('p');p.textContent=r;card.append(p);});return card;}));
   note.textContent=f.note;count.textContent=f.count;root.querySelector('[data-step]')!.textContent=`${step+1} / ${frames.length}`;back.setAttribute('aria-disabled',String(step===0));next.setAttribute('aria-disabled',String(step===frames.length-1));
  };
  const restart=()=>{stop();step=0;frames=build();render();};
  back.onclick=()=>{stop();step=Math.max(0,step-1);render();};next.onclick=()=>{stop();step=Math.min(frames.length-1,step+1);render();};reset.onclick=restart;
  const hold=()=>Math.max(6000,(root.innerText.trim().split(/\s+/).length/180)*60000+2000);
  const tick=()=>{step++;render();if(step<frames.length-1)timer=setTimeout(tick,hold());else stop();};
  play.onclick=()=>{if(timer){stop();return;}if(step===frames.length-1){step=0;render();}const rect=root.getBoundingClientRect();if(rect.height<=innerHeight-24&&(rect.top<12||rect.bottom>innerHeight-12))root.scrollIntoView({block:'center',behavior:'instant'});play.textContent='Pause';timer=setTimeout(tick,hold());};select.onchange=restart;if(warm)warm.onchange=restart;
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  new IntersectionObserver(entries=>{if(!entries[0].isIntersecting)stop();},{threshold:0}).observe(root);
  restart();
 });
</script>
<style>
.a24-figure{margin:2rem 0;padding:1rem;border:1px solid var(--color-rule);background:var(--color-surface-alt);border-radius:.35rem}
.a24-figure figcaption{font-size:.95rem;line-height:1.5;margin:0 0 .8rem}.a24-options,.a24-controls{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem}.a24-options label{font-size:.82rem;display:flex;gap:.4rem;align-items:center}.a24-options select,.a24-controls button{font:inherit;background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-rule);border-radius:.25rem;padding:.35rem .55rem}.a24-controls{font-size:.8rem}.a24-controls button{cursor:pointer}.a24-controls button[aria-disabled="true"]{opacity:.45;cursor:default}.a24-controls button:focus-visible,.a24-options select:focus-visible{outline:2px solid var(--color-text);outline-offset:3px}
.a24-stage{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin:1rem 0}.a24-stage :global(.a24-card){min-width:0;padding:.65rem;border:1px solid var(--color-rule);background:var(--color-surface);border-radius:.2rem}.a24-stage :global(.a24-card[data-state="current"]){outline:2px solid var(--color-text);outline-offset:-2px}.a24-stage :global(.a24-card[data-state="visited"]){border-style:dashed}.a24-stage :global(.a24-card p){font-size:.77rem;line-height:1.5;margin:.2rem 0;overflow-wrap:anywhere}.a24-stage :global(.a24-card .a24-card-title){font-weight:700;margin:0 0 .4rem}.a24-note{font-size:.9rem;line-height:1.55;min-height:4.7em;margin:.65rem 0}.a24-count{font-size:.82rem;line-height:1.55;font-weight:700;margin:.6rem 0}.a24-bound{font-size:.75rem;color:var(--color-text-secondary);line-height:1.5;margin:.8rem 0 0}
@media(max-width:600px){.a24-figure{padding:.7rem}.a24-stage{grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem}.a24-stage :global(.a24-card){padding:.45rem}.a24-note{min-height:6.2em}.a24-controls{gap:.45rem}}
</style>
