---
import {scenes} from './model.mjs';
const {scene,number}=Astro.props;
const model=scenes[scene];
const first=model.steps(0)[0];
const maximum=Math.max(...first.rows.map(r=>r[1]));
---
<figure class="plan-work" data-plan-work data-scene={scene} aria-labelledby={`a26-${scene}`}>
 <figcaption id={`a26-${scene}`}><span>Figure {number}</span>{model.title}</figcaption>
 <p class="provenance">{model.label}</p>
 <div class="choices" role="group" aria-label={`Case for figure ${number}`}>{model.choices.map((label,i)=><button type="button" data-choice={i} aria-pressed={i===0}>{label}</button>)}</div>
 <div class="board">
  <p class="step-title" data-title>{first.title}</p>
  <div class="rows" data-rows>{first.rows.map(([label,value,status],i)=><div class="row" data-active={scene==='flow'&&i===0?'true':'false'}><div><strong>{label}</strong><span>{Number(value).toLocaleString()} · {status}</span></div><div class="track" aria-hidden="true"><span style={`width:${Math.max(1,100*Number(value)/maximum)}%`}></span></div></div>)}</div>
  <p class="note" data-note aria-live="polite">{first.note}</p>
  <dl>{model.metric.map((label,i)=><div><dt>{label}</dt><dd data-count={i}>{first.counts[i].toLocaleString()}</dd></div>)}</dl>
 </div>
 <div class="controls" role="group" aria-label={`Playback for figure ${number}`}><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-play>Play</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><output data-position>Step 1 of {model.steps(0).length}</output></div>
 <details><summary>Read every step</summary>{model.choices.map((choice,i)=><div><p><strong>{choice}</strong></p><ol>{model.steps(i).map(s=><li>{s.title}. {s.note} {s.rows.map(([l,v,u])=>`${l}: ${v} ${u}`).join('; ')}. {model.metric.map((l,i)=>`${l}: ${s.counts[i]}`).join('; ')}.</li>)}</ol></div>)}</details>
</figure>
<script>
 import {scenes,holdMilliseconds} from './model.mjs';
 document.querySelectorAll<HTMLElement>('[data-plan-work]').forEach(root=>{
  if(root.dataset.ready)return;root.dataset.ready='true';
  const model=scenes[root.dataset.scene!];let variant=0,step=0,timer:ReturnType<typeof setTimeout>|undefined;
  const el=(selector:string)=>root.querySelector<HTMLElement>(selector)!;
  const steps=()=>model.steps(variant);
  const stop=()=>{clearTimeout(timer);timer=undefined;el('[data-play]').textContent='Play';};
  const render=()=>{
   const values=steps();step=Math.max(0,Math.min(step,values.length-1));const s=values[step];
   el('[data-title]').textContent=s.title;el('[data-note]').textContent=s.note;
   const maximum=Math.max(...s.rows.map(r=>r[1]));
   el('[data-rows]').replaceChildren(...s.rows.map(([label,value,status],i)=>{
    const row=document.createElement('div');row.className='row';row.dataset.active=String(root.dataset.scene==='flow'&&i===Math.max(0,step-1));
    const copy=document.createElement('div'),strong=document.createElement('strong'),count=document.createElement('span');
    strong.textContent=label;count.textContent=`${Number(value).toLocaleString()} · ${status}`;copy.append(strong,count);
    const track=document.createElement('div');track.className='track';track.setAttribute('aria-hidden','true');const fill=document.createElement('span');fill.style.width=`${Math.max(1,100*value/maximum)}%`;track.append(fill);row.append(copy,track);return row;
   }));
   s.counts.forEach((n,i)=>el(`[data-count="${i}"]`).textContent=n.toLocaleString());
   el('[data-position]').textContent=`Step ${step+1} of ${values.length}`;
   el('[data-back]').setAttribute('aria-disabled',String(step===0));el('[data-next]').setAttribute('aria-disabled',String(step===values.length-1));
   root.querySelectorAll('[data-choice]').forEach((button,i)=>button.setAttribute('aria-pressed',String(i===variant)));
  };
  const play=()=>{render();if(step===steps().length-1){stop();return;}el('[data-play]').textContent='Pause';timer=setTimeout(()=>{step++;play();},holdMilliseconds(root.innerText));};
  root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button=>button.addEventListener('click',()=>{stop();variant=Number(button.dataset.choice);step=0;render();}));
  el('[data-back]').addEventListener('click',()=>{stop();step=Math.max(0,step-1);render();});
  el('[data-next]').addEventListener('click',()=>{stop();step=Math.min(steps().length-1,step+1);render();});
  el('[data-reset]').addEventListener('click',()=>{stop();step=0;render();});
  el('[data-play]').addEventListener('click',()=>{if(timer){stop();return;}if(step===steps().length-1)step=0;play();});
  root.querySelector('details')?.addEventListener('toggle',()=>{if(timer){clearTimeout(timer);timer=setTimeout(()=>{step++;play();},holdMilliseconds(root.innerText));}});
  new IntersectionObserver(entries=>{if(!entries[0].isIntersecting)stop();},{threshold:0}).observe(root);
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  render();
 });
</script>
<style>
 .plan-work{margin:1.8rem 0;padding:1rem;border:1px solid var(--color-rule);background:var(--color-surface);border-radius:.5rem;min-width:0}
 figcaption{font-weight:650;line-height:1.5}figcaption>span{display:block;font-size:.75rem;text-transform:uppercase;color:var(--color-text-secondary);letter-spacing:.05em}
 .provenance{font-size:.8rem;line-height:1.6;color:var(--color-text-secondary);margin:.4rem 0 .8rem}.choices,.controls{display:flex;gap:.4rem;flex-wrap:wrap}
 button{font:inherit;font-size:.82rem;min-height:44px;padding:.5rem .7rem;border:1px solid var(--color-rule);border-radius:.3rem;color:var(--color-text);background:var(--color-surface-alt);cursor:pointer}button[aria-pressed=true]{box-shadow:inset 0 -3px var(--color-text);border-color:var(--color-text)}button[aria-disabled=true]{opacity:.5}button:focus-visible{outline:2px solid var(--color-text);outline-offset:3px}
 .board{margin:1rem 0}.step-title{font-weight:650;line-height:1.6}.rows{display:grid;gap:.6rem}.rows :global(.row){border:1px solid var(--color-rule);padding:.6rem;background:var(--color-surface-alt)}.rows :global(.row>div:first-child){display:flex;justify-content:space-between;gap:.6rem;flex-wrap:wrap;font-size:.82rem}.rows :global(.row strong){font-weight:600}.rows :global(.track){height:.45rem;background:var(--color-rule);margin-top:.45rem}.rows :global(.track span){height:100%;display:block;background:var(--color-text-secondary);transition:width .4s ease}
 .note{font-size:.9rem;line-height:1.7;min-height:5em}dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}dl>div{border-top:2px solid var(--color-text);padding-top:.4rem}dt{font-size:.72rem;line-height:1.5;color:var(--color-text-secondary)}dd{margin:.3rem 0 0;font-size:1.15rem;font-weight:650;overflow-wrap:anywhere}.controls output{font-size:.8rem;align-self:center}details{font-size:.82rem;margin-top:1rem;line-height:1.7}summary{cursor:pointer;min-height:36px}details li{margin:.6rem 0}
 .plan-work[data-scene=flow] .rows{gap:1.3rem}.plan-work[data-scene=flow] .rows :global(.row){position:relative}.plan-work[data-scene=flow] .rows :global(.row:not(:last-child)::after){content:'↓';position:absolute;bottom:-1.3rem;left:50%;color:var(--color-text-secondary);line-height:1.3rem}.rows :global(.row[data-active=true]){border-color:var(--color-text);box-shadow:inset 3px 0 var(--color-text)}
 @media(prefers-reduced-motion:reduce){.rows :global(.track span){transition:none}}
 @media(max-width:560px){.plan-work{padding:.7rem}.choices button{flex:1 1 120px}.controls button{flex:1}.controls output{flex-basis:100%}dd{font-size:.95rem}.note{min-height:0}}
</style>
