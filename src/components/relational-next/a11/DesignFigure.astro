---
import { scenarios, frame } from './model.mjs';
const { kind } = Astro.props;
const scenario = scenarios[kind];
const choice = scenario.choices[0][0];
const cause = scenario.causes?.[0][0] ?? '';
const initial = frame(kind, choice, cause, 0);
const prefix = `a11-${kind}`;
---
<figure class="design-figure" data-a11-figure={kind} aria-labelledby={`${prefix}-title`}>
  <figcaption id={`${prefix}-title`}><span>Figure {scenario.number}</span> {scenario.title}</figcaption>
  <div class="choices">
    <label>Compare designs
      <select data-choice>{scenario.choices.map(([value, label]) => <option value={value}>{label}</option>)}</select>
    </label>
    {scenario.causes && <label>Change the requirement or action
      <select data-cause>{scenario.causes.map(([value, label]) => <option value={value}>{label}</option>)}</select>
    </label>}
  </div>
  <p class="step-label" data-step>1 / {scenario.steps.length} · {scenario.steps[0]}</p>
  <div class="fact-grid" data-boxes>{initial.boxes.map(box => <section class="fact-box"><p class="box-title">{box.title}</p><ul>{box.rows.map(row => <li class={row.state}>{row.text}</li>)}</ul></section>)}</div>
  <p class="result" data-result>{initial.result}</p>
  <p class="narration" data-note aria-live="polite">{initial.note}</p>
  <div class="controls" role="group" aria-label={`Figure ${scenario.number} playback`}>
    <button type="button" data-play>Play</button>
    <button type="button" data-back aria-disabled="true">Back</button>
    <button type="button" data-next>Next</button>
    <button type="button" data-reset>Reset</button>
  </div>
  <p class="model-note">Illustrative design model; no database runs here. Compare at the same step. Solid outline = changed or maintained result; dashed outline = conflicting or stale result.</p>
  <details><summary>Read every step of this comparison</summary><ol data-transcript>{scenario.steps.map((title, step) => <li><strong>{title}.</strong> {frame(kind, choice, cause, step).note}</li>)}</ol></details>
  <noscript><p>The comparison controls require JavaScript. The full starting comparison is readable above; the article explains each alternative.</p></noscript>
</figure>

<script>
  import { scenarios, frame } from './model.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('[data-a11-figure]')) {
    const kind = root.dataset.a11Figure!;
    const scenario = scenarios[kind];
    const select = root.querySelector<HTMLSelectElement>('[data-choice]')!;
    const cause = root.querySelector<HTMLSelectElement>('[data-cause]');
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    let step = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const text = (selector: string, value: string) => { root.querySelector(selector)!.textContent = value; };
    const stop = () => { clearTimeout(timer); timer = undefined; play.textContent = 'Play'; };
    function render() {
      const current = frame(kind, select.value, cause?.value ?? '', step);
      const boxes = root.querySelector('[data-boxes]')!;
      boxes.replaceChildren(...current.boxes.map(box => {
        const section = document.createElement('section');
        section.className = 'fact-box';
        const title = document.createElement('p'); title.className = 'box-title'; title.textContent = box.title;
        const list = document.createElement('ul');
        list.replaceChildren(...box.rows.map(row => { const item = document.createElement('li'); item.textContent = row.text; item.className = row.state; return item; }));
        section.append(title, list);
        return section;
      }));
      text('[data-step]', `${step + 1} / ${scenario.steps.length} · ${scenario.steps[step]}`);
      text('[data-note]', current.note);
      text('[data-result]', current.result);
      back.setAttribute('aria-disabled', String(step === 0));
      next.setAttribute('aria-disabled', String(step === scenario.steps.length - 1));
      root.querySelector('[data-transcript]')!.replaceChildren(...scenario.steps.map((title, index) => {
        const item = document.createElement('li');
        item.textContent = `${title}. ${frame(kind, select.value, cause?.value ?? '', index).note}`;
        return item;
      }));
    }
    function schedule() {
      const visible = ['[data-step]', '[data-boxes]', '[data-result]', '[data-note]']
        .map(selector => root.querySelector(selector)!.textContent ?? '').join(' ');
      const comparison = [select.selectedOptions[0]?.text, cause?.selectedOptions[0]?.text].filter(Boolean).join(' ');
      const words = `${visible} ${comparison}`.trim().split(/\s+/).length;
      // Read all displayed facts and narration, then allow five seconds to compare.
      timer = setTimeout(() => { step++; render(); if (step === scenario.steps.length - 1) stop(); else schedule(); }, Math.max(12000, 5000 + words * 320));
    }
    back.addEventListener('click', () => { stop(); step = Math.max(0, step - 1); render(); });
    next.addEventListener('click', () => { stop(); step = Math.min(scenario.steps.length - 1, step + 1); render(); });
    root.querySelector('[data-reset]')!.addEventListener('click', () => { stop(); step = 0; render(); });
    select.addEventListener('change', () => { stop(); render(); });
    cause?.addEventListener('change', () => { stop(); render(); });
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      if (step === scenario.steps.length - 1) step = 0;
      render(); play.textContent = 'Pause'; schedule();
    });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    document.addEventListener('astro:before-swap', stop, { once: true });
    render();
  }
</script>

<style>
  .design-figure { margin: 2rem 0; padding: 1rem; background: var(--color-surface-alt); border: 1px solid var(--color-rule-strong); }
  figcaption { color: var(--color-text); font: 1.12rem/1.45 var(--font-serif); }
  figcaption span { color: var(--color-text-secondary); margin-right: .45rem; font: .72rem var(--font-mono); text-transform: uppercase; }
  .choices { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,16rem),1fr)); gap: .6rem; margin: .9rem 0; }
  label { display: grid; gap: .3rem; font: .78rem/1.4 var(--font-sans); }
  select, button { min-height: 2.6rem; border: 1px solid var(--color-rule-strong); border-radius: .2rem; padding: .4rem .6rem; color: var(--color-text); background: var(--color-surface); font: .8rem/1.4 var(--font-sans); }
  select { width: 100%; max-width: 100%; }
  button { cursor: pointer; }
  button[aria-disabled="true"] { opacity: .5; cursor: default; }
  button:focus-visible, select:focus-visible, summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .step-label { font: 600 .8rem/1.5 var(--font-sans); }
  .fact-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,15rem),1fr)); gap: .6rem; }
  .design-figure :global(.fact-box) { margin: 0; min-width: 0; border: 1px solid var(--color-rule-strong); background: var(--color-surface); padding: .65rem; }
  .design-figure :global(.box-title) { margin: 0 0 .5rem; font: 600 .8rem/1.5 var(--font-sans); overflow-wrap: anywhere; }
  .design-figure :global(.fact-box ul) { list-style: none; padding: 0; margin: 0; }
  .design-figure :global(.fact-box li) { border: 1px solid var(--color-rule); padding: .4rem; margin: .35rem 0; font: .78rem/1.5 var(--font-mono); overflow-wrap: anywhere; }
  .design-figure :global(.fact-box li.changed) { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .design-figure :global(.fact-box li.problem) { border: 2px dashed var(--color-text-secondary); }
  .result { margin: .8rem 0 .3rem; font: 600 .82rem/1.5 var(--font-sans); }
  .narration { margin: .5rem 0 .8rem; padding-top: .6rem; border-top: 1px solid var(--color-rule-strong); min-height: 5em; font: .88rem/1.6 var(--font-sans); }
  .controls { display: flex; flex-wrap: wrap; gap: .4rem; }
  .model-note, details { color: var(--color-text-secondary); font: .76rem/1.55 var(--font-sans); }
  .model-note { margin: .7rem 0; }
  details ol { padding-left: 1.2rem; }
  @media(max-width:520px) { .design-figure { padding: .7rem; } .fact-grid { grid-template-columns: 1fr; } .narration { min-height: 7em; } }
</style>
