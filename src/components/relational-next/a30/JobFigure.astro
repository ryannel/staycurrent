---
import { scenes } from './model.mjs';
const {scene,number}=Astro.props;
const model=scenes[scene];
const first=model.frames(0)[0];
---
<figure class="job-figure" data-job-figure data-scene={scene} aria-labelledby={`a30-${scene}`}>
 <figcaption id={`a30-${scene}`}><span>Figure {number}</span>{model.title}</figcaption>
 <p class="boundary">Illustrative model · native observations are reported separately</p>
 <div class="choices" role="group" aria-label={`Comparison for figure ${number}`}>{model.choices.map((choice,i)=><button type="button" data-choice={i} aria-pressed={i===0}>{choice}</button>)}</div>
 <div class="board">
  <p class="step-title" data-title>{first.title}</p>
  <div class="lanes">{model.labels.map((label,i)=><div class="lane"><p class="lane-label">{label}</p><ol data-lane={i}>{first.lanes[i].map(row=><li>{row}</li>)}</ol></div>)}</div>
  <p class="consequence" data-note aria-live="polite">{first.note}</p>
 </div>
 <div class="controls" role="group" aria-label={`Playback for figure ${number}`}><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-play>Play</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><output data-position>Step 1 of {model.frames(0).length}</output></div>
 <details><summary>Read every step</summary>{model.choices.map((choice,v)=><div><p><strong>{choice}</strong></p><ol>{model.frames(v).map(s=><li>{s.title}. {s.lanes.map((rows,i)=>`${model.labels[i]}: ${rows.join('; ')}.`).join(' ')} {s.note}</li>)}</ol></div>)}</details>
</figure>
<script>
 import { scenes,holdMilliseconds } from './model.mjs';
 document.querySelectorAll<HTMLElement>('[data-job-figure]').forEach(root=>{
  if(root.dataset.ready)return;root.dataset.ready='true';
  const model=scenes[root.dataset.scene!];let variant=0,step=0,timer:ReturnType<typeof setTimeout>|undefined;
  const el=(s:string)=>root.querySelector<HTMLElement>(s)!;
  const frames=()=>model.frames(variant);
  const stop=()=>{clearTimeout(timer);timer=undefined;el('[data-play]').textContent='Play';};
  const render=()=>{
   const all=frames();step=Math.max(0,Math.min(step,all.length-1));const f=all[step];
   el('[data-title]').textContent=f.title;el('[data-note]').textContent=f.note;
   f.lanes.forEach((rows:string[],i:number)=>el(`[data-lane="${i}"]`).replaceChildren(...rows.map(row=>{const item=document.createElement('li');item.textContent=row;return item;})));
   el('[data-position]').textContent=`Step ${step+1} of ${all.length}`;
   el('[data-back]').setAttribute('aria-disabled',String(step===0));el('[data-next]').setAttribute('aria-disabled',String(step===all.length-1));
   root.querySelectorAll<HTMLElement>('[data-choice]').forEach((b,i)=>b.setAttribute('aria-pressed',String(i===variant)));
  };
  const play=()=>{render();if(step===frames().length-1){stop();return;}el('[data-play]').textContent='Pause';timer=setTimeout(()=>{step++;play();},holdMilliseconds(root.innerText));};
  el('[data-play]').addEventListener('click',()=>{if(timer){stop();return;}if(step===frames().length-1)step=0;play();});
  el('[data-back]').addEventListener('click',()=>{stop();step--;render();});el('[data-next]').addEventListener('click',()=>{stop();step++;render();});el('[data-reset]').addEventListener('click',()=>{stop();step=0;render();});
  root.querySelectorAll<HTMLElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{stop();variant=Number(b.dataset.choice);render();}));
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  new IntersectionObserver(entries=>{if(!entries[0].isIntersecting)stop();},{threshold:0}).observe(root);
  render();
 });
</script>
<style>
 .job-figure{margin:1.9rem 0;border:1px solid var(--color-rule);border-radius:.5rem;padding:1rem;background:var(--color-surface);min-width:0}
 figcaption{font-weight:650;line-height:1.5}figcaption>span{display:block;font-size:.75rem;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-secondary)}
 .boundary{font-size:.8rem;color:var(--color-text-secondary);margin:.4rem 0 .8rem}.choices,.controls{display:flex;flex-wrap:wrap;gap:.45rem}
 button{font:inherit;font-size:.84rem;min-height:44px;padding:.5rem .7rem;color:var(--color-text);background:var(--color-surface-alt);border:1px solid var(--color-rule);border-radius:.3rem;cursor:pointer}button[aria-pressed=true]{border-color:var(--color-text);box-shadow:inset 0 -3px var(--color-text)}button[aria-disabled=true]{opacity:.5}button:focus-visible,summary:focus-visible{outline:2px solid var(--color-text);outline-offset:3px}
 .board{margin:.8rem 0}.step-title{font-weight:650;margin:.5rem 0}.lanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem}.lane{min-width:0;border:1px solid var(--color-rule);background:var(--color-surface-alt);padding:.65rem;position:relative}.lane+.lane:before{content:'→';position:absolute;left:-1.1rem;top:2.7rem;color:var(--color-text-secondary)}.lane-label{font-weight:650;font-size:.76rem;margin:0 0 .5rem}.lane ol{list-style:none;margin:0;padding:0}.lane :global(li){font:.79rem/1.6 var(--font-mono);padding:.4rem 0;border-top:1px solid var(--color-rule);overflow-wrap:anywhere;animation:a30-arrive .3s ease-out}.consequence{font-size:.9rem;line-height:1.7;margin:.8rem 0;min-height:5rem}.controls output{align-self:center;font-size:.8rem}
 details{margin-top:.8rem;font-size:.85rem;line-height:1.7}summary{cursor:pointer;min-height:36px}details :global(li){margin:.65rem 0}
 @keyframes a30-arrive{from{opacity:.45;transform:translateY(3px)}to{opacity:1;transform:translateY(0)}}
 @media(prefers-reduced-motion:reduce){.lane :global(li){animation:none}}
 @media(max-width:620px){.job-figure{padding:.7rem}.lanes{grid-template-columns:1fr;gap:1.4rem}.lane+.lane:before{content:'↓';top:-1.45rem;left:50%}.lane-label{font-size:.8rem}.lane :global(li){font-size:.8rem;padding:.25rem 0}.choices button{flex:1 1 140px}.controls button{flex:1}.controls output{flex-basis:100%}.consequence{min-height:0}}
</style>
