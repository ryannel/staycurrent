---
import { scenes, frames } from './model.mjs';
const { scene, number } = Astro.props;
const def = scenes[scene];
const steps = frames(scene, def.initial);
const last = steps.at(-1);
const id = `recovery-${scene}`;
---
<recovery-figure data-scene={scene}>
 <figure aria-labelledby={`${id}-caption`}>
  <figcaption id={`${id}-caption`}>Figure {number}. {def.title}</figcaption>
  <p class="model-label">Illustrative steps · not a live database</p>
  <label class="comparison" data-controls hidden for={`${id}-compare`}>Compare <select id={`${id}-compare`} data-choice>{def.options.map(([value,label]) => <option value={value} selected={value===def.initial}>{label}</option>)}</select></label>
  <p class="step-title" data-title>{last.title}</p>
  <p class="event" data-event>{last.event}</p>
  <div class="budget-track" data-budget hidden aria-hidden="true"><span></span></div>
  <div class="lanes" data-panels>{last.panels.map(p => <div class="lane"><p class="name">{p.name}</p><p class="state">{p.state}</p><p class="detail">{p.detail}</p></div>)}</div>
  <p class="result" data-result>{last.result}</p>
  <p class="note" data-note aria-live="polite">{last.note}</p>
  <div class="transport" data-controls hidden>
   <button type="button" data-action="play">Play</button><button type="button" data-action="back">Back</button><button type="button" data-action="next">Next</button><button type="button" data-action="end">End</button><button type="button" data-action="reset">Reset</button>
   <label for={`${id}-step`}>Step <input id={`${id}-step`} type="range" min="0" max={steps.length-1} value={steps.length-1} step="1" data-step /></label><span data-count></span>
  </div>
  <details><summary>Default sequence as text</summary><ol>{steps.map(s => <li><strong>{s.title}.</strong> {s.event}. {s.result} {s.note}</li>)}</ol></details>
 </figure>
</recovery-figure>
<script>
 import { scenes, frames } from './model.mjs';
 class RecoveryFigure extends HTMLElement {
  timer=0;
  connectedCallback(){
   const scene=this.dataset.scene!;
   const def=scenes[scene];
   const q=(selector:string)=>this.querySelector<HTMLElement>(selector)!;
   const choice=q('[data-choice]') as HTMLSelectElement;
   choice.value=def.initial;
   const slider=q('[data-step]') as HTMLInputElement;
   let steps=frames(scene,def.initial), step=0, playing=false;
   const stop=()=>{window.clearTimeout(this.timer);playing=false;q('[data-action="play"]').textContent='Play';q('[data-note]').setAttribute('aria-live','polite');};
   const draw=()=>{
    const f=steps[step];
    for(const [selector,value] of [['[data-title]',f.title],['[data-event]',f.event],['[data-result]',f.result],['[data-note]',f.note]])q(selector).textContent=value;
    const lanes=q('[data-panels]');lanes.replaceChildren();
    for(const p of f.panels){const lane=document.createElement('div');lane.className='lane';for(const [cls,value] of [['name',p.name],['state',p.state],['detail',p.detail]]){const el=document.createElement('p');el.className=cls;el.textContent=value;lane.append(el);}lanes.append(lane);}
    slider.value=String(step);slider.max=String(steps.length-1);slider.setAttribute('aria-valuetext',`${step+1} of ${steps.length}: ${f.title}`);
    q('[data-count]').textContent=`${step+1} / ${steps.length}`;
    q('[data-action="back"]').setAttribute('aria-disabled',String(step===0));q('[data-action="next"]').setAttribute('aria-disabled',String(step===steps.length-1));
    if(scene==='budget'){q('[data-budget]').hidden=false;const elapsed=Number(f.panels[0].state.split(' ')[0]);q('[data-budget] span').style.width=`${elapsed/8}%`;}
   };
   const schedule=()=>{
    // Count the whole visible scene, including its comparison and all lane text.
    const words=q('figure').innerText.split(/\s+/).filter(Boolean).length;
    const hold=Math.max(12000,4000+words*1000/3);
    this.timer=window.setTimeout(()=>{if(step<steps.length-1){step++;draw();schedule();}else stop();},hold);
   };
   this.addEventListener('click',event=>{
    const action=(event.target as Element).closest<HTMLButtonElement>('button')?.dataset.action;if(!action)return;
    if(action==='play'){if(playing){stop();return;}if(step===steps.length-1)step=0;playing=true;q('[data-action="play"]').textContent='Pause';q('[data-note]').setAttribute('aria-live','off');draw();schedule();return;}
    stop();if(action==='back')step=Math.max(0,step-1);if(action==='next')step=Math.min(steps.length-1,step+1);if(action==='end')step=steps.length-1;
    if(action==='reset'){choice.value=def.initial;steps=frames(scene,def.initial);step=0;}draw();
   });
   choice.addEventListener('change',()=>{stop();steps=frames(scene,choice.value);step=Math.min(step,steps.length-1);draw();});
   slider.addEventListener('input',()=>{stop();step=Number(slider.value);draw();});
   document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
   this.querySelectorAll<HTMLElement>('[data-controls]').forEach(el=>el.hidden=false);draw();
  }
  disconnectedCallback(){window.clearTimeout(this.timer);}
 }
 if(!customElements.get('recovery-figure'))customElements.define('recovery-figure',RecoveryFigure);
</script>
<style>
 recovery-figure{display:block;margin:2rem 0;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);padding:1rem;}
 figure{margin:0;}figcaption{font-weight:650;font-size:.92rem;}.model-label{margin:.4rem 0 .8rem;color:var(--color-text-secondary);font-size:.72rem;}
 .comparison{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;font-size:.8rem;}button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .55rem;max-width:100%;}button{cursor:pointer;}button[aria-disabled=true]{opacity:.55;}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px;}
 .step-title{font-weight:650;margin:1rem 0 .5rem;font-size:.9rem;}.event{margin:0 0 .7rem;border-left:3px solid var(--color-accent);padding:.4rem .6rem;font-size:.8rem;background:var(--color-surface);overflow-wrap:anywhere;}
 .lanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;}.lanes :global(.lane){margin:0;padding:.65rem;border:1px solid var(--color-rule);background:var(--color-surface);min-width:0;}.lanes :global(.name){margin:0 0 .4rem;font-size:.67rem;text-transform:uppercase;letter-spacing:.04em;color:var(--color-text-secondary);}.lanes :global(.state){margin:0 0 .4rem;font-weight:650;font-size:.85rem;line-height:1.45;overflow-wrap:anywhere;}.lanes :global(.detail){margin:0;font-size:.77rem;line-height:1.5;}
 .result{font-size:.85rem;font-weight:650;margin:.7rem 0 .4rem;}.note{font-size:.8rem;line-height:1.6;margin:.4rem 0 .8rem;}.transport{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem;font-size:.75rem;border-top:1px solid var(--color-rule);padding-top:.65rem;}.transport label{display:flex;align-items:center;gap:.35rem;flex:1;min-width:8rem;}.transport input{min-width:4rem;width:100%;}.transport span{font-size:.7rem;}details{margin-top:.7rem;font-size:.76rem;}
 .budget-track{margin:0 0 .7rem;height:.7rem;background:var(--color-surface);border:1px solid var(--color-rule);overflow:hidden;}.budget-track span{display:block;height:100%;width:0;background:var(--color-accent);}[hidden]{display:none;}
 @media(max-width:600px){recovery-figure{padding:.65rem;}.lanes{grid-template-columns:1fr;gap:.4rem;}.lanes :global(.lane){display:grid;grid-template-columns:5.4rem 1fr;gap:.2rem .4rem;padding:.5rem;margin:0;}.lanes :global(.name){grid-row:span 2;align-self:center;margin:0;font-size:.63rem;}.lanes :global(.state){font-size:.78rem;margin:0;}.lanes :global(.detail){font-size:.73rem;}.event{font-size:.76rem;}.note{font-size:.76rem;}.result{font-size:.79rem;}.step-title{font-size:.85rem;}figcaption{font-size:.87rem;}}
</style>
