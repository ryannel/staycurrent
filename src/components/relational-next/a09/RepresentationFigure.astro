---
interface Props { kind: 'number' | 'text' | 'time' | 'missing' | 'structure'; }
const { kind } = Astro.props;
const config = {
 number: { n: 1, title: 'Where does the fraction of a cent go?', label: 'Input amount in euros', options: [['20.00','20.00'],['20.005','20.005'],['999999.995','999999.995']], compare: 'Input policy', choices: [['round','Let numeric(8,2) round'],['reject','Require whole cents']], fallback: '20.005 becomes 20.01 when PostgreSQL assigns it to numeric(8,2). A whole-cent input policy rejects it before assignment. 999999.995 rounds beyond the column’s range and is rejected by PostgreSQL.' },
 text: { n: 2, title: 'Which membership codes become the same?', label: 'Incoming code', options: [['M007','M007'],['m007','m007'],['M007 ','M007 + trailing space']], compare: 'Equality policy', choices: [['exact','Exact text'],['trim','Trim spaces, uppercase ASCII']], fallback: 'Against stored code M007, exact text matching distinguishes m007 and M007 followed by a space. The illustrated ASCII canonicalisation maps all three to M007. Preserve the original separately if its spelling matters.' },
 time: { n: 3, title: 'One clock reading, two instants', label: 'Readout', options: [['london','Europe/London'],['utc','UTC']], compare: 'Stored fact', choices: [['instant','Instant with offset'],['wall','Clock reading only']], fallback: 'On 25 October 2026, 00:30 UTC is 01:30 in London at offset +01. At 01:30 UTC, London reads 01:30 again at offset +00. A clock reading without its resolution policy does not select one of these instants.' },
 missing: { n: 4, title: 'Can the stored value explain why it is missing?', label: 'What the customer tells us', options: [['unasked','Not asked yet'],['declined','Declined to provide'],['empty','Submitted empty text'],['supplied','Supplied a number']], compare: 'Representation', choices: [['nullable','Nullable phone only'],['state','State plus phone']], fallback: 'A nullable phone alone cannot distinguish not asked from declined. State plus phone retains that distinction. In this example blank submission is invalid, rather than silently becoming a refusal or an unknown number.' },
 structure: { n: 5, title: 'When an option needs its own row', label: 'Requirement', options: [['note','Two notes printed with the booking'],['reference','Each option names a catalogue item'],['change','Staff fulfil each option separately']], compare: 'Representation', choices: [['json','One JSON value'],['rows','Related option rows']], fallback: 'Two booking-owned notes can be one small JSON value with a defined shape. Referencing catalogue items or tracking separate fulfilment makes related option rows a clearer boundary for references, validation and updates.' }
}[kind];
---
<figure class="representation-figure" aria-labelledby={`a09-${kind}-title`}>
 <p class="figure-name" id={`a09-${kind}-title`}><span>Figure {config.n}</span> {config.title}</p>
 <representation-figure data-kind={kind}>
  <div class="parameters">
   <label>{config.label}<select data-input>{config.options.map(([v,t]) => <option value={v}>{t}</option>)}</select></label>
   <label>{config.compare}<select data-policy>{config.choices.map(([v,t]) => <option value={v}>{t}</option>)}</select></label>
  </div>
  <div class="board" hidden>
   <ol class="pipeline" aria-label="Value through three stages">
    <li><span data-label="0">Input</span><strong data-value="0"></strong><small data-detail="0"></small></li>
    <li><span data-label="1">Stored representation</span><strong data-value="1"></strong><small data-detail="1"></small></li>
    <li><span data-label="2">What we can conclude</span><strong data-value="2"></strong><small data-detail="2"></small></li>
   </ol>
   <p class="narration" aria-live="polite"></p>
   <div class="transport" role="group" aria-label={`Figure ${config.n} playback`}>
    <button type="button" data-act="play">Play</button><button type="button" data-act="back">Back</button><button type="button" data-act="next">Next</button><button type="button" data-act="reset">Reset</button><span data-count></span>
   </div>
  </div>
  <p class="fallback">{config.fallback}</p>
 </representation-figure>
 <figcaption>A bounded teaching model. Change either choice at the same step to compare what survives. Use Next to read at your own pace; Play holds each explanation before continuing. {kind === 'time' ? 'The time-zone mapping uses the browser’s time-zone data; the stated London transition was also checked on PostgreSQL 18.6.' : 'The model does not execute a database request.'}</figcaption>
</figure>
<script>
 import { framesFor } from './model';
 class RepresentationFigure extends HTMLElement {
  step = 0;
  timer: ReturnType<typeof setTimeout> | undefined;
  playing = false;
  connectedCallback() {
   if (this.dataset.ready) return;
   this.dataset.ready = 'true';
   this.querySelector<HTMLElement>('.board')!.hidden = false;
   this.querySelector<HTMLElement>('.fallback')!.hidden = true;
   this.querySelectorAll('select').forEach(el => el.addEventListener('change', () => { this.stop(); this.render(); }));
   this.querySelectorAll<HTMLButtonElement>('button').forEach(el => el.addEventListener('click', () => {
    const act = el.dataset.act;
    if (act === 'play') {
     if (this.playing) { this.stop(); this.render(); }
     else { if (this.step === 2) this.step = 0; this.playing = true; this.render(); this.schedule(); }
    } else { this.stop(); this.step = act === 'reset' ? 0 : Math.max(0,Math.min(2,this.step + (act === 'back' ? -1 : 1))); this.render(); }
   }));
   this.render();
  }
  disconnectedCallback() { this.stop(); }
  stop() { clearTimeout(this.timer); this.playing = false; }
  frames() { return framesFor(this.dataset.kind!, this.querySelector<HTMLSelectElement>('[data-input]')!.value, this.querySelector<HTMLSelectElement>('[data-policy]')!.value); }
  schedule() {
   const f = this.frames();
   const text = [...f.labels, ...f.values, ...f.details, f.notes[this.step]].join(' ');
   this.timer = setTimeout(() => {
    if (!this.isConnected) return;
    if (this.step < 2) this.step++;
    if (this.step === 2) this.playing = false;
    this.render();
    if (this.playing) this.schedule();
   }, Math.max(6000, text.trim().split(/\s+/).length * (60000 / 180) + 3000));
  }
  render() {
   const f = this.frames();
   this.querySelectorAll<HTMLElement>('.pipeline li').forEach((el,i) => {
    el.dataset.active = String(i === this.step);
    el.dataset.future = String(i > this.step);
    this.querySelector(`[data-label="${i}"]`)!.textContent = f.labels[i];
    this.querySelector(`[data-value="${i}"]`)!.textContent = f.values[i];
    this.querySelector(`[data-detail="${i}"]`)!.textContent = f.details[i];
   });
   this.querySelector('.narration')!.textContent = f.notes[this.step];
   this.querySelector('[data-count]')!.textContent = `${this.step + 1} / 3`;
   this.querySelector('[data-act="play"]')!.textContent = this.playing ? 'Pause' : this.step === 2 ? 'Replay' : 'Play';
   this.querySelector('[data-act="back"]')!.setAttribute('aria-disabled',String(this.step === 0));
   this.querySelector('[data-act="next"]')!.setAttribute('aria-disabled',String(this.step === 2));
  }
 }
 if (!customElements.get('representation-figure')) customElements.define('representation-figure',RepresentationFigure);
</script>
<style>
 .representation-figure{margin:2rem 0;padding:1rem;border:1px solid var(--color-rule);border-radius:.4rem;background:var(--color-surface-alt)}
 .figure-name{font-weight:650;margin:0 0 1rem}.figure-name span{display:block;font-size:.75rem;font-weight:400;color:var(--color-text-secondary)}
 .parameters{display:flex;flex-wrap:wrap;gap:.8rem;margin-bottom:1rem}.parameters label{flex:1 1 13rem;display:grid;gap:.35rem;font-size:.8rem}select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.25rem;padding:.55rem;max-width:100%;width:100%;min-height:44px}
 .pipeline{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;padding:0;gap:.65rem;margin:0}.pipeline li{display:flex;flex-direction:column;gap:.5rem;padding:.8rem;border:2px solid var(--color-rule);border-radius:.35rem;min-width:0;transition:opacity .3s,border-color .3s,transform .3s;background:var(--color-surface)}
 .pipeline li[data-active="true"]{border-color:var(--color-text);transform:translateY(-3px)}.pipeline li[data-future="true"]{opacity:.5}.pipeline span{font-size:.72rem;color:var(--color-text-secondary)}.pipeline strong{font:.9rem/1.5 var(--font-mono);overflow-wrap:anywhere;white-space:pre-wrap}.pipeline small{font-size:.77rem;line-height:1.5}
 .narration{min-height:6.6em;font-size:.9rem;line-height:1.6;margin:1.2rem 0}.transport{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center}.transport button{font:inherit;font-size:.8rem;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.25rem;min-height:44px;padding:.5rem .75rem;cursor:pointer}.transport button[aria-disabled="true"]{opacity:.55;cursor:default}.transport span{font-size:.75rem;margin-left:auto}button:focus-visible,select:focus-visible{outline:3px solid var(--color-text);outline-offset:3px}figcaption{font-size:.78rem;line-height:1.6;color:var(--color-text-secondary);margin-top:1rem}
 @media(max-width:600px){.pipeline{grid-template-columns:1fr}.pipeline li{display:grid;grid-template-columns:1fr 1fr;gap:.25rem .65rem}.pipeline small{grid-column:1/-1}.pipeline li[data-active="true"]{transform:none}.narration{min-height:8em}.representation-figure{padding:.75rem}.parameters{gap:.6rem}}
 @media(prefers-reduced-motion:reduce){.pipeline li{transition:none;transform:none!important}}
</style>
