---
import { scenes } from './scenes.mjs';
const { scene, number, left = 'Application knows', right = 'Database state' } = Astro.props;
const model = scenes[scene];
const first = model.variants[0][0];
---
<figure class="boundary-player" data-boundary-player data-model={JSON.stringify(model)} aria-label={model.title}>
 <figcaption><span>Figure {number}</span> {model.title}</figcaption>
 <p class="model-note">Illustrative model · step order, not elapsed time</p>
 <div class="choices" role="group" aria-label={`Comparison for figure ${number}`}>
  {model.choices.map((choice, i) => <button type="button" data-choice={i} aria-pressed={i === 0}>{choice}</button>)}
 </div>
 <ol class="path" aria-label="Steps in the selected path">{model.variants[0].map((step, i) => <li class:list={[i === 0 && 'current']} data-step={i}><span>{i + 1}</span> <span>{step[0]}</span></li>)}</ol>
 <div class="event"><p class="owner" data-owner>{first[1]}</p><p class="event-title" data-title>{first[0]}</p><p data-detail>{first[2]}</p></div>
 <div class="states"><div><span>{left}</span><strong data-left>{first[3]}</strong></div><div><span>{right}</span><strong data-right>{first[4]}</strong></div></div>
 <div class="controls" role="group" aria-label={`Playback for figure ${number}`}><button type="button" data-back>Back</button><button type="button" data-play>Play</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><output data-position aria-live="polite">Step 1 of {model.variants[0].length}</output></div>
 <details><summary>All steps as text</summary>{model.choices.map((choice, v) => <div><p><strong>{choice}</strong></p><ol>{model.variants[v].map(s => <li>{s[0]} — {s[2]} {left}: {s[3]}. {right}: {s[4]}.</li>)}</ol></div>)}</details>
</figure>
<script>
 document.querySelectorAll<HTMLElement>('[data-boundary-player]').forEach(root => {
  if (root.dataset.initialised) return;
  root.dataset.initialised = 'true';
  const model = JSON.parse(root.dataset.model!);
  let variant = 0, step = 0, timer: ReturnType<typeof setTimeout> | undefined;
  const el = (selector: string) => root.querySelector<HTMLElement>(selector)!;
  const stop = () => { clearTimeout(timer); timer = undefined; el('[data-play]').textContent = 'Play'; };
  const render = () => {
   const rows = model.variants[variant];
   const row = rows[step];
   ['owner','title','detail','left','right'].forEach((key, i) => el(`[data-${key}]`).textContent = row[[1,0,2,3,4][i]]);
   root.querySelectorAll('[data-step]').forEach((item, i) => { item.classList.toggle('current', i === step); item.classList.toggle('complete', i < step); item.querySelector('span:last-child')!.textContent = rows[i][0]; });
   root.querySelectorAll('[data-choice]').forEach((button, i) => button.setAttribute('aria-pressed', String(i === variant)));
   el('[data-position]').textContent = `Step ${step + 1} of ${rows.length}`;
   const back = el('[data-back]') as HTMLButtonElement;
   const next = el('[data-next]') as HTMLButtonElement;
   if ((step === 0 && document.activeElement === back) || (step === rows.length - 1 && document.activeElement === next)) el('[data-play]').focus();
   back.disabled = step === 0;
   next.disabled = step === rows.length - 1;
  };
  root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button => button.addEventListener('click', () => { stop(); variant = Number(button.dataset.choice); render(); }));
  el('[data-back]').addEventListener('click', () => { stop(); step = Math.max(0, step - 1); render(); });
  el('[data-next]').addEventListener('click', () => { stop(); step = Math.min(model.variants[variant].length - 1, step + 1); render(); });
  el('[data-reset]').addEventListener('click', () => { stop(); step = 0; render(); });
  const playStep = () => {
   render();
   const rows = model.variants[variant];
   if (step === rows.length - 1) { stop(); return; }
   el('[data-play]').textContent = 'Pause';
   const words = rows[step].slice(2).join(' ').trim().split(/\s+/).length;
   timer = setTimeout(() => { step++; playStep(); }, Math.max(6000, words * 60000 / 180 + 1800));
  };
  el('[data-play]').addEventListener('click', () => {
   if (timer) { stop(); return; }
   if (step === model.variants[variant].length - 1) step = 0;
   playStep();
  });
  document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
  render();
 });
</script>
<style>
 .boundary-player{border:1px solid var(--color-rule);border-radius:.5rem;padding:1.1rem;margin:1.8rem 0;background:var(--color-surface);}
 figcaption{font-weight:650;line-height:1.5}figcaption span{display:block;font-size:.75rem;text-transform:uppercase;letter-spacing:.07em;color:var(--color-text-secondary)}
 .model-note,.owner{font-size:.8rem;color:var(--color-text-secondary);margin:.5rem 0}.choices,.controls{display:flex;flex-wrap:wrap;gap:.5rem}
 button{font:inherit;font-size:.85rem;padding:.55rem .7rem;min-height:44px;border:1px solid var(--color-rule);border-radius:.3rem;background:var(--color-surface-alt);color:var(--color-text);cursor:pointer}
 button[aria-pressed=true]{border-color:var(--color-text);box-shadow:inset 0 -3px var(--color-text)}button:disabled{opacity:.45;cursor:default}button:focus-visible{outline:2px solid var(--color-text);outline-offset:3px}
 .path{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;padding:0;list-style:none;margin:1rem 0}.path li{border:1px dashed var(--color-rule);padding:.5rem;font-size:.75rem;line-height:1.4;display:flex;gap:.4rem;align-items:start}.path li>span:first-child{font-weight:bold}.path .current{border:2px solid var(--color-text);font-weight:650}.path .complete{border-style:solid;background:var(--color-surface-alt)}
 .event{border-left:3px solid var(--color-text);padding:.1rem .8rem;background:var(--color-surface-alt);min-height:10rem}.event-title{font-weight:650;margin:.25rem 0}.event p:last-child{font-size:.95rem;margin:.5rem 0 1rem}
 .states{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin:1rem 0}.states>div{border:1px solid var(--color-rule);padding:.7rem;min-width:0}.states span{display:block;font-size:.75rem;color:var(--color-text-secondary)}.states strong{display:block;margin-top:.4rem;font-size:.9rem;overflow-wrap:anywhere}.controls output{font-size:.8rem;align-self:center}details{margin-top:1rem;font-size:.85rem}summary{cursor:pointer;min-height:30px}
 @media(max-width:540px){.boundary-player{padding:.75rem}.path{grid-template-columns:1fr 1fr}.states{grid-template-columns:1fr}.event{min-height:7rem}.controls button{flex:1}.controls output{flex-basis:100%}}
</style>
