---
import { framesFor, renderFrame } from './models.mjs';
const {scene,number} = Astro.props;
const definitions = {
 matches:{title:'A result row is a pair of matching rows',label:'Join condition',options:[['key','Same customer ID'],['all','No relationship condition']],caption:'Illustrative pairing model of the January orders, not an execution trace. A cross marks a rejected pair; a labelled cell is one result row. The highlighted cell is the pair just emitted.'},
 outer:{title:'Where the period condition acts',label:'Period condition',options:[['on','In ON'],['where','In WHERE']],caption:'Illustrative logical stages. NULL (extended) marks a row added because no order matched. The rows and final counts agree with the PostgreSQL runs; the database need not perform these stages in this physical order.'},
 fanout:{title:'Two independent detail sets, four joined pairs',label:'Combine',options:[['details','Join details'],['totals','Total each side first']],caption:'Illustrative model for customer 1, using order values calculated from lines. Each step highlights contributing source rows and adds one joined pair. Playback is a teaching order, not an observed query plan.'}
};
const def=definitions[scene];
const frames=framesFor(scene,def.options[0][0]);
const last=frames.at(-1);
---
<figure class="ja-figure" aria-labelledby={`ja-${scene}-title`}>
 <div class="ja-heading"><span>Figure {number}</span><p id={`ja-${scene}-title`}>{def.title}</p></div>
 <join-explainer data-scene={scene}>
  <div class="ja-controls" hidden>
   <div class="ja-options" role="group" aria-label={def.label}>
    <span>{def.label}</span>
    {def.options.map(([value,label],i)=><button type="button" data-mode={value} aria-pressed={String(i===0)}>{label}</button>)}
   </div>
   <div class="ja-transport" role="group" aria-label={`Playback for figure ${number}`}>
    <button type="button" data-action="play">Play</button>
    <button type="button" data-action="back">Back</button>
    <button type="button" data-action="next">Next</button>
    <button type="button" data-action="reset">Reset</button>
    <output data-progress></output>
   </div>
  </div>
  <div class="ja-board" data-board set:html={renderFrame(last)} />
  <p class="ja-note" data-note role="status" aria-live="polite">{last.note}</p>
 </join-explainer>
 <figcaption>{def.caption}</figcaption>
</figure>
<script>
 import {framesFor,renderFrame} from './models.mjs';
 class JoinExplainer extends HTMLElement {
  frames:any[]=[];
  step=0;
  mode='';
  timer:ReturnType<typeof setTimeout>|undefined;
  connectedCallback(){
   if(this.dataset.ready)return;
   this.dataset.ready='true';
   this.mode=this.querySelector<HTMLButtonElement>('[data-mode]')!.dataset.mode!;
   this.frames=framesFor(this.dataset.scene,this.mode);
   this.querySelector<HTMLElement>('.ja-controls')!.hidden=false;
   this.addEventListener('click',(event)=>{
    const button=(event.target as HTMLElement).closest<HTMLButtonElement>('button');
    if(!button)return;
    if(button.dataset.mode){
     this.pause();this.mode=button.dataset.mode;this.frames=framesFor(this.dataset.scene,this.mode);this.step=0;
     this.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
    }else if(button.dataset.action==='play'){
     if(this.timer){this.pause();}else{if(this.step===this.frames.length-1)this.step=0;this.advance();}
    }else{
     this.pause();
     this.step=button.dataset.action==='reset'?0:Math.max(0,Math.min(this.frames.length-1,this.step+(button.dataset.action==='next'?1:-1)));
    }
    this.render();
   });
   this.render();
  }
  disconnectedCallback(){this.pause();}
  pause(){clearTimeout(this.timer);this.timer=undefined;const b=this.querySelector('[data-action="play"]');if(b)b.textContent='Play';}
  advance(){
   this.render();
   this.querySelector('[data-action="play"]')!.textContent='Pause';
   this.timer=setTimeout(()=>{if(this.step<this.frames.length-1){this.step++;this.advance();}else{this.pause();}},Math.max(1800,this.frames[this.step].note.length*40));
  }
  render(){
   const f=this.frames[this.step];
   const board=this.querySelector<HTMLElement>('[data-board]')!;
   const oldScroll=board.querySelector<HTMLElement>('.ja-scroll');
   const scrollLeft=this.step===0?0:(oldScroll?.scrollLeft??0);
   board.innerHTML=renderFrame(f);
   const scroller=board.querySelector<HTMLElement>('.ja-scroll');
   if(scroller){
    scroller.scrollLeft=scrollLeft;
    const current=scroller.querySelector<HTMLElement>('.ja-matrix .ja-current');
    if(current){
     const cell=current.getBoundingClientRect(), area=scroller.getBoundingClientRect();
     if(cell.right>area.right)scroller.scrollLeft+=cell.right-area.right+4;
     else if(cell.left<area.left)scroller.scrollLeft-=area.left-cell.left+4;
    }
   }
   this.querySelector('[data-note]')!.textContent=f.note;
   this.querySelector('[data-progress]')!.textContent=`${this.step+1} / ${this.frames.length}`;
   const back=this.querySelector<HTMLButtonElement>('[data-action="back"]')!;
   const next=this.querySelector<HTMLButtonElement>('[data-action="next"]')!;
   const focused=document.activeElement;
   const atStart=this.step===0, atEnd=this.step===this.frames.length-1;
   if(atEnd&&focused===next)back.focus();
   else if(atStart&&focused===back)next.focus();
   back.disabled=atStart;
   next.disabled=atEnd;
  }
 }
 if(!customElements.get('join-explainer'))customElements.define('join-explainer',JoinExplainer);
</script>
<style is:global>
 .ja-figure{margin:2.2rem 0;border-block:1px solid var(--color-rule);padding:1.1rem 0;font-family:var(--font-sans);}
 .ja-heading{display:flex;gap:.8rem;align-items:baseline;margin-bottom:.8rem;}
 .ja-heading>span{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;white-space:nowrap;color:var(--color-text-secondary);}
 .ja-heading>p{margin:0;font-family:var(--font-serif);font-size:1.1rem;}
 .ja-board{background:var(--color-surface-alt);border:1px solid var(--color-rule);padding:1rem;}
 .ja-controls{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center;margin-bottom:.8rem;}
 .ja-controls[hidden]{display:none;}
 .ja-options,.ja-transport{display:flex;flex-wrap:wrap;gap:.35rem;align-items:center;}
 .ja-options>span{font-size:.75rem;color:var(--color-text-secondary);margin-right:.25rem;}
 .ja-controls button{appearance:none;border:1px solid var(--color-rule);border-radius:.25rem;background:var(--color-surface);color:var(--color-text);padding:.4rem .65rem;font:500 .74rem/1.4 var(--font-sans);cursor:pointer;}
 .ja-controls button[aria-pressed="true"]{border-color:var(--color-accent);box-shadow:inset 0 -2px var(--color-accent);}
 .ja-controls button:disabled{opacity:.45;cursor:default;}
 .ja-controls button:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px;}
 .ja-controls output{font-size:.7rem;margin-left:.4rem;color:var(--color-text-secondary);}
 .ja-stats{display:flex;gap:1.5rem;margin:0 0 1rem;flex-wrap:wrap;}
 .ja-stats>div{display:flex;flex-direction:column-reverse;}
 .ja-stats dt{font-size:.7rem;color:var(--color-text-secondary);}
 .ja-stats dd{margin:0;font:500 1.4rem/1.2 var(--font-mono);}
 .ja-scroll{overflow-x:auto;max-width:100%;}
 .ja-board table{border-collapse:collapse;width:100%;margin:0;font:.73rem/1.5 var(--font-mono);}
 .ja-board th,.ja-board td{border:1px solid var(--color-rule);padding:.55rem .45rem;text-align:left;transition:background .4s,opacity .4s;}
 .ja-board th{font:500 .7rem/1.4 var(--font-sans);color:var(--color-text-secondary);}
 .ja-matrix{min-width:460px;table-layout:fixed;}
 .ja-current{background:color-mix(in srgb,var(--color-accent) 19%,var(--color-surface))!important;outline:2px solid var(--color-accent);outline-offset:-2px;}
 .ja-accepted{background:color-mix(in srgb,var(--color-accent) 9%,var(--color-surface));}
 .ja-waiting{opacity:.32;}
 .ja-current{animation:ja-arrive .55s ease-out;}
 @keyframes ja-arrive{from{opacity:.4}to{opacity:1}}
 .ja-reject{color:var(--color-text-secondary);background:var(--color-surface);opacity:.55;}
 tr.ja-reject td:last-child{text-decoration:line-through;}
 .ja-sources{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
 .ja-sources .ja-source-title{margin:0 0 .5rem;font:500 .75rem/1.5 var(--font-sans);}
 .ja-chips{display:flex;gap:.5rem;}
 .ja-chip{flex:1;display:flex;justify-content:space-between;gap:.3rem;padding:.65rem;border:1px solid var(--color-rule);border-radius:.2rem;font:.8rem/1.4 var(--font-mono);transition:background .4s;}
 .ja-chip span{color:var(--color-text-secondary);}
 .ja-subtotal,.ja-final{border:1px solid var(--color-rule);padding:.6rem;font:.75rem/1.6 var(--font-mono);transition:opacity .4s,background .4s;}
 .ja-subtotal{margin-top:.6rem;}
 .ja-final{text-align:center;}
 .ja-note{font:.84rem/1.6 var(--font-sans);min-height:4.8em;margin:.8rem 0;}
 .ja-figure figcaption{font:.74rem/1.6 var(--font-sans);color:var(--color-text-secondary);}
 @media(max-width:500px){.ja-board{padding:.6rem}.ja-chip{padding:.45rem;flex-direction:column}.ja-board th,.ja-board td{padding:.4rem .3rem}.ja-heading{gap:.5rem}.ja-note{min-height:6.4em}}
 @media(prefers-reduced-motion:reduce){.ja-figure *{transition:none!important;animation:none!important}}
</style>
