---
import {scenes,frames} from './model.mjs';
const {scene,number}=Astro.props;
const def=scenes[scene];const steps=frames(scene,def.initial);const last=steps.at(-1);const id=`a25-${scene}`;
---
<workload-index-figure data-scene={scene}>
<figure aria-labelledby={`${id}-caption`}>
<figcaption id={`${id}-caption`}>Figure {number}. {def.title}</figcaption>
<p class="model">Illustrative mechanism · invented rows and positions · not a measured plan</p>
<label class="comparison" data-controls hidden for={`${id}-choice`}>Compare <select id={`${id}-choice`} data-choice>{def.options.map(([value,label])=><option value={value} selected={value===def.initial}>{label}</option>)}</select></label>
<p class="step-title" data-title>{last.title}</p>
<div class="boards" data-boards>{last.boards.map(b=><div class="board"><p class="name">{b.name}</p><div class="cells">{b.cells.map(c=><div class="cell" data-state={c.state}><strong>{c.text}</strong>{c.detail&&<span>{c.detail}</span>}</div>)}</div></div>)}</div>
<p class="result" data-result>{last.result}</p>
<p class="note" data-note aria-live="polite">{last.note}</p>
<div class="transport" data-controls hidden><button type="button" data-action="play">Play</button><button type="button" data-action="back">Back</button><button type="button" data-action="next">Next</button><button type="button" data-action="end">End</button><button type="button" data-action="reset">Reset</button><label for={`${id}-step`}>Step <input id={`${id}-step`} data-step type="range" min="0" max={steps.length-1} value={steps.length-1}/></label><span data-count></span></div>
<details><summary>Default sequence as text</summary><ol>{steps.map(s=><li><strong>{s.title}.</strong> {s.note} {s.result}</li>)}</ol></details>
</figure>
</workload-index-figure>
<script>
import {scenes,frames} from './model.mjs';
class WorkloadIndexFigure extends HTMLElement{
 timer=0;
 connectedCallback(){
 const q=(s:string)=>this.querySelector<HTMLElement>(s)!;
 const scene=this.dataset.scene!;const def=scenes[scene];const choice=q('[data-choice]') as HTMLSelectElement;const slider=q('[data-step]') as HTMLInputElement;
 let steps=frames(scene,def.initial),step=0,playing=false;
 const stop=()=>{window.clearTimeout(this.timer);playing=false;q('[data-action="play"]').textContent='Play';q('[data-note]').setAttribute('aria-live','polite');};
 const draw=()=>{const f=steps[step];q('[data-title]').textContent=f.title;q('[data-result]').textContent=f.result;q('[data-note]').textContent=f.note;const root=q('[data-boards]');root.replaceChildren();
 for(const b of f.boards){const board=document.createElement('div');board.className='board';const name=document.createElement('p');name.className='name';name.textContent=b.name;const cells=document.createElement('div');cells.className='cells';for(const c of b.cells){const cell=document.createElement('div');cell.className='cell';cell.dataset.state=c.state;const main=document.createElement('strong');main.textContent=c.text;cell.append(main);if(c.detail){const detail=document.createElement('span');detail.textContent=c.detail;cell.append(detail);}cells.append(cell);}board.append(name,cells);root.append(board);}
 slider.value=String(step);slider.max=String(steps.length-1);slider.setAttribute('aria-valuetext',`${step+1} of ${steps.length}: ${f.title}`);q('[data-count]').textContent=`${step+1} / ${steps.length}`;q('[data-action="back"]').setAttribute('aria-disabled',String(step===0));q('[data-action="next"]').setAttribute('aria-disabled',String(step===steps.length-1));};
 const schedule=()=>{const visible=q('figure').innerText.split(/\s+/).filter(Boolean).length;const hold=Math.max(12000,4000+visible*1000/3);this.timer=window.setTimeout(()=>{if(step<steps.length-1){step++;draw();schedule();}else stop();},hold);};
 this.addEventListener('click',e=>{const action=(e.target as Element).closest<HTMLButtonElement>('button')?.dataset.action;if(!action)return;if(action==='play'){if(playing){stop();return;}if(step===steps.length-1)step=0;playing=true;q('[data-action="play"]').textContent='Pause';q('[data-note]').setAttribute('aria-live','off');draw();schedule();return;}stop();if(action==='back')step=Math.max(0,step-1);if(action==='next')step=Math.min(steps.length-1,step+1);if(action==='end')step=steps.length-1;if(action==='reset'){choice.value=def.initial;steps=frames(scene,def.initial);step=0;}draw();});
 choice.addEventListener('change',()=>{stop();steps=frames(scene,choice.value);step=Math.min(step,steps.length-1);draw();});slider.addEventListener('input',()=>{stop();step=Number(slider.value);draw();});
 const visibility=()=>{if(document.hidden)stop();};document.addEventListener('visibilitychange',visibility);this.cleanup=()=>document.removeEventListener('visibilitychange',visibility);
 this.querySelectorAll<HTMLElement>('[data-controls]').forEach(e=>e.hidden=false);draw();
 }
 cleanup=()=>{};
 disconnectedCallback(){window.clearTimeout(this.timer);this.cleanup();}
}
if(!customElements.get('workload-index-figure'))customElements.define('workload-index-figure',WorkloadIndexFigure);
</script>
<style>
workload-index-figure{display:block;margin:2rem 0;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);padding:1rem;}figure{margin:0;}figcaption{font-size:.95rem;font-weight:650;}.model{font-size:.7rem;color:var(--color-text-secondary);margin:.4rem 0 .8rem;}.comparison{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;font-size:.8rem;}button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem;max-width:100%;}button{cursor:pointer;}button[aria-disabled=true]{opacity:.55;}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px;}.step-title{font-size:.9rem;font-weight:650;margin:1rem 0 .5rem;}.boards{display:grid;gap:.6rem;}.boards :global(.board){padding:.6rem;border:1px solid var(--color-rule);background:var(--color-surface);}.boards :global(.name){font-size:.7rem;letter-spacing:.02em;margin:0 0 .4rem;color:var(--color-text-secondary);}.boards :global(.cells){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.3rem;}.boards :global(.cell){min-width:0;border:1px solid var(--color-rule);padding:.35rem .4rem;font-size:.7rem;line-height:1.4;transition:background .25s,border-color .25s;overflow-wrap:anywhere;}.boards :global(.cell strong){font-weight:550;display:block;}.boards :global(.cell span){display:block;margin-top:.2rem;font-size:.65rem;color:var(--color-text-secondary);}.boards :global(.cell[data-state=match]){border-color:var(--color-accent);background:color-mix(in srgb,var(--color-accent) 14%,var(--color-surface));}.boards :global(.cell[data-state=match] strong)::before{content:'✓ ';}.boards :global(.cell[data-state=reject]){border-style:dashed;opacity:.65;}.boards :global(.cell[data-state=reject] strong)::before{content:'× ';}.result{font-size:.8rem;font-weight:650;margin:.7rem 0 .4rem;}.note{font-size:.8rem;line-height:1.6;margin:.4rem 0 .8rem;}.transport{display:flex;flex-wrap:wrap;align-items:center;gap:.3rem;font-size:.74rem;border-top:1px solid var(--color-rule);padding-top:.65rem;}.transport label{display:flex;gap:.3rem;align-items:center;flex:1;min-width:8rem;}.transport input{width:100%;min-width:4rem;}details{font-size:.75rem;margin-top:.6rem;}[hidden]{display:none;}
@media(max-width:600px){workload-index-figure{padding:.6rem;}.boards :global(.cells){grid-template-columns:repeat(2,minmax(0,1fr));}.boards :global(.cell){font-size:.68rem;}.boards :global(.cell span){font-size:.63rem;}.boards :global(.board){padding:.4rem;}.comparison{font-size:.75rem;}.comparison select{width:100%;}.note,.result{font-size:.75rem;}}
@media(prefers-reduced-motion:reduce){.boards :global(.cell){transition:none;}}
</style>
