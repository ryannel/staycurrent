---
import {scenes} from './models.mjs';
const {scene,number}=Astro.props;
const model=scenes[scene];
const first=model.steps(0)[0];
---
<figure class="capacity-figure" data-capacity-figure data-scene={scene} aria-labelledby={`a36-${scene}-title`}>
 <figcaption id={`a36-${scene}-title`}><span>Figure {number}</span>{model.title}</figcaption>
 <p class="legend">{model.legend}</p>
 <div class="choices" role="group" aria-label={`Assumption for figure ${number}`}>
  {model.choices.map((choice,i)=><button type="button" data-choice={i} aria-pressed={i===0}>{choice}</button>)}
 </div>
 <div class="board">
  <p class="step-title" data-step-title>{first.title}</p>
  <div class="panels" data-panels>{first.panels.map(panel=><section class="panel"><p class="panel-title">{panel.title}</p><dl>{panel.rows.map(r=><div class="metric"><dt>{r.label}</dt><dd>{r.value}</dd>{r.max&&<progress max={r.max} value={Math.min(r.used,r.max)} aria-label={r.label}/>}</div>)}</dl></section>)}</div>
  <p class="note" data-note aria-live="polite">{first.note}</p>
 </div>
 <div class="controls" role="group" aria-label={`Playback for figure ${number}`}><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-play>Play</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><output data-position>Step 1 of {model.steps(0).length}</output></div>
 <details><summary>Read every step and assumption</summary>{model.choices.map((choice,v)=><div><p><strong>{choice}</strong></p><ol>{model.steps(v).map(s=><li>{s.title}. {s.panels.map(p=>`${p.title}: ${p.rows.map(r=>`${r.label}: ${r.value}`).join('; ')}.`).join(' ')} {s.note}</li>)}</ol></div>)}</details>
</figure>
<script>
 import {scenes,holdMilliseconds} from './models.mjs';
 document.querySelectorAll<HTMLElement>('[data-capacity-figure]').forEach(root=>{
  if(root.dataset.ready)return;root.dataset.ready='true';
  const model=scenes[root.dataset.scene!];
  let variant=0,step=0,timer:ReturnType<typeof setTimeout>|undefined,visible=true;
  const el=(s:string)=>root.querySelector<HTMLElement>(s)!;
  const steps=()=>model.steps(variant);
  const make=(tag:string,text:string,className?:string)=>{const e=document.createElement(tag);e.textContent=text;if(className)e.className=className;return e;};
  const stop=()=>{clearTimeout(timer);timer=undefined;el('[data-play]').textContent='Play';};
  const render=()=>{
   const state=steps()[step];el('[data-step-title]').textContent=state.title;el('[data-note]').textContent=state.note;
   el('[data-panels]').replaceChildren(...state.panels.map(p=>{const section=make('section','','panel');section.append(make('p',p.title,'panel-title'));const dl=document.createElement('dl');p.rows.forEach(r=>{const div=make('div','','metric');div.append(make('dt',r.label),make('dd',r.value));if(r.max){const bar=document.createElement('progress');bar.max=r.max;bar.value=Math.min(r.used,r.max);bar.setAttribute('aria-label',r.label);div.append(bar);}dl.append(div);});section.append(dl);return section;}));
   root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((b,i)=>b.setAttribute('aria-pressed',String(i===variant)));
   el('[data-back]').setAttribute('aria-disabled',String(step===0));el('[data-next]').setAttribute('aria-disabled',String(step===steps().length-1));el('[data-position]').textContent=`Step ${step+1} of ${steps().length}`;
  };
  const schedule=()=>{if(step===steps().length-1||!visible||document.hidden){stop();return;}el('[data-play]').textContent='Pause';timer=setTimeout(()=>{step++;render();schedule();},holdMilliseconds(root.innerText));};
  root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{stop();variant=Number(b.dataset.choice);step=Math.min(step,steps().length-1);render();}));
  el('[data-back]').addEventListener('click',()=>{stop();step=Math.max(0,step-1);render();});
  el('[data-next]').addEventListener('click',()=>{stop();step=Math.min(steps().length-1,step+1);render();});
  el('[data-reset]').addEventListener('click',()=>{stop();step=0;render();});
  el('[data-play]').addEventListener('click',()=>{if(timer){stop();return;}if(step===steps().length-1){step=0;render();}schedule();});
  root.querySelector('details')!.addEventListener('toggle',()=>{if(timer){clearTimeout(timer);schedule();}});
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(!visible)stop();},{threshold:0}).observe(root);
  render();
 });
</script>
<style>
 .capacity-figure{min-width:0;margin:1.8rem 0;padding:1rem;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface)}
 figcaption{font-weight:650;line-height:1.5}figcaption>span{display:block;font-size:.75rem;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-secondary)}
 .legend{font-size:.81rem;line-height:1.65;color:var(--color-text-secondary);margin:.5rem 0 .9rem}.choices,.controls{display:flex;flex-wrap:wrap;gap:.5rem}
 button{font:inherit;font-size:.84rem;min-height:44px;padding:.5rem .7rem;border:1px solid var(--color-rule);border-radius:.3rem;background:var(--color-surface-alt);color:var(--color-text);cursor:pointer}button[aria-pressed=true]{border-color:var(--color-text);box-shadow:inset 0 -3px var(--color-text)}button[aria-disabled=true]{opacity:.5}button:focus-visible{outline:2px solid var(--color-text);outline-offset:3px}
 .board{margin:1rem 0}.step-title{font-weight:650;font-size:.95rem}.panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.panels :global(.panel){margin:0;min-width:0;padding:.8rem;background:var(--color-surface-alt);border:1px solid var(--color-rule)}
 .panels :global(.panel-title){font-size:.88rem;font-weight:650;line-height:1.5;margin:0 0 .7rem}.panels :global(dl){margin:0}.panels :global(.metric){margin:.7rem 0 0;border-top:1px solid var(--color-rule);padding-top:.45rem}.panels :global(dt){font-size:.73rem;line-height:1.5;color:var(--color-text-secondary)}.panels :global(dd){font-size:.85rem;line-height:1.55;margin:.15rem 0 0;overflow-wrap:anywhere}.panels :global(progress){width:100%;height:.6rem;margin-top:.45rem;accent-color:var(--color-text)}
 .note{font-size:.89rem;line-height:1.75;margin:.9rem 0}.controls output{font-size:.8rem;align-self:center}details{margin-top:1rem;font-size:.82rem;line-height:1.7}summary{cursor:pointer;min-height:36px}details li{margin:.7rem 0}
 @media(max-width:600px){.capacity-figure{padding:.7rem}.panels{grid-template-columns:1fr}.choices button{flex:1 1 145px}.controls button{flex:1}.controls output{flex-basis:100%}}
</style>
