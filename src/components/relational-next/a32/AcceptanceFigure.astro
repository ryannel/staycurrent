---
import { scenes } from './model.mjs';
const { scene, number } = Astro.props;
const def = scenes[scene];
const steps = def.frames(0);
const first = steps[0];
const id = `a32-${scene}`;
---
<sqlite-acceptance data-scene={scene}>
 <figure aria-labelledby={`${id}-caption`}>
  <figcaption id={`${id}-caption`}>Figure {number}. {def.title}</figcaption>
  <p class="model">Illustrative sequence · selected observations are labelled</p>
  <label class="comparison" data-controls hidden>Compare <select data-choice aria-label={`Comparison for figure ${number}`}>{def.choices.map((text,i)=><option value={i}>{text}</option>)}</select></label>
  <p class="title" data-title>{first.title}</p><p class="event" data-event>{first.event}</p>
  <div class="lanes" data-lanes>{first.lanes.map(l=><div class="lane"><p class="name">{l.name}</p><p class="state">{l.state}</p><div class="chips">{l.chips.map(t=><span>{t}</span>)}</div></div>)}</div>
  <p class="result" data-result>{first.result}</p><p class="note" data-note aria-live="polite">{first.note}</p>
  <div class="transport" data-controls hidden><button type="button" data-action="play">Play</button><button type="button" data-action="back" aria-disabled="true">Back</button><button type="button" data-action="next">Next</button><button type="button" data-action="end">End</button><button type="button" data-action="reset">Reset</button><label>Step <input type="range" data-step min="0" max={steps.length-1} step="1" value="0" aria-label={`Step in figure ${number}`} /></label><output data-position>1 / {steps.length}</output></div>
  <details><summary>Read both sequences</summary>{def.choices.map((choice,v)=><div><p><strong>{choice}</strong></p><ol>{def.frames(v).map(f=><li><strong>{f.title}.</strong> {f.event} {f.lanes.map(l=>`${l.name}: ${l.state}; ${l.chips.join(', ')}.`).join(' ')} {f.result} {f.note}</li>)}</ol></div>)}</details>
 </figure>
</sqlite-acceptance>
<script>
 import { scenes, holdMilliseconds } from './model.mjs';
 class SQLiteAcceptance extends HTMLElement {
  timer=0;
  connectedCallback(){
   const def=scenes[this.dataset.scene!];
   const q=(s:string)=>this.querySelector<HTMLElement>(s)!;
   const choice=q('[data-choice]') as HTMLSelectElement;
   const slider=q('[data-step]') as HTMLInputElement;
   let variant=0, step=0, playing=false;
   const stop=()=>{window.clearTimeout(this.timer);this.timer=0;playing=false;q('[data-action="play"]').textContent='Play';q('[data-note]').setAttribute('aria-live','polite');};
   const draw=()=>{
    const steps=def.frames(variant), f=steps[step];
    for(const [sel,text] of [['[data-title]',f.title],['[data-event]',f.event],['[data-result]',f.result],['[data-note]',f.note]])q(sel).textContent=text;
    q('[data-lanes]').replaceChildren(...f.lanes.map(l=>{
     const panel=document.createElement('div');panel.className='lane';
     for(const [cls,text] of [['name',l.name],['state',l.state]]){const p=document.createElement('p');p.className=cls;p.textContent=text;panel.append(p);}
     const chips=document.createElement('div');chips.className='chips';
     for(const text of l.chips){const chip=document.createElement('span');chip.textContent=text;chips.append(chip);}panel.append(chips);return panel;
    }));
    slider.value=String(step);slider.setAttribute('aria-valuetext',`${step+1} of ${steps.length}: ${f.title}`);
    q('[data-position]').textContent=`${step+1} / ${steps.length}`;
    q('[data-action="back"]').setAttribute('aria-disabled',String(step===0));q('[data-action="next"]').setAttribute('aria-disabled',String(step===steps.length-1));
   };
   const schedule=()=>{
    // innerText includes every rendered word: title, controls, lane labels,
    // chips, result, note, and the transcript if the reader has opened it.
    this.timer=window.setTimeout(()=>{if(step<def.frames(variant).length-1){step++;draw();schedule();}else stop();},holdMilliseconds(q('figure').innerText));
   };
   this.addEventListener('click',event=>{
    const action=(event.target as Element).closest<HTMLButtonElement>('button')?.dataset.action;if(!action)return;
    if(action==='play'){if(playing){stop();return;}if(step===def.frames(variant).length-1)step=0;playing=true;q('[data-action="play"]').textContent='Pause';q('[data-note]').setAttribute('aria-live','off');draw();schedule();return;}
    stop();if(action==='back')step=Math.max(0,step-1);if(action==='next')step=Math.min(def.frames(variant).length-1,step+1);if(action==='end')step=def.frames(variant).length-1;
    if(action==='reset'){variant=0;choice.value='0';step=0;}draw();
   });
   choice.addEventListener('change',()=>{stop();variant=Number(choice.value);step=Math.min(step,def.frames(variant).length-1);draw();});
   slider.addEventListener('input',()=>{stop();step=Number(slider.value);draw();});
   this.querySelector('details')?.addEventListener('toggle',()=>{if(playing){window.clearTimeout(this.timer);schedule();}});
   this.addEventListener('focusout',event=>{if(event.relatedTarget&&!this.contains(event.relatedTarget as Node))stop();});
   document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
   this.querySelectorAll<HTMLElement>('[data-controls]').forEach(el=>el.hidden=false);draw();
  }
  disconnectedCallback(){window.clearTimeout(this.timer);}
 }
 if(!customElements.get('sqlite-acceptance'))customElements.define('sqlite-acceptance',SQLiteAcceptance);
</script>
<style>
 sqlite-acceptance{display:block;margin:1.7rem 0;padding:1rem;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);min-width:0}figure{margin:0}figcaption{font-size:.92rem;font-weight:650;line-height:1.5}.model{font-size:.72rem;color:var(--color-text-secondary);margin:.4rem 0 .8rem}.comparison{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;font-size:.8rem}
 button,select{font:inherit;font-size:.78rem;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.5rem;min-height:44px;max-width:100%}button{cursor:pointer}button[aria-disabled=true]{opacity:.5}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}
 .title{font-size:.9rem;font-weight:650;margin:1rem 0 .5rem}.event{font-size:.82rem;border-left:3px solid var(--color-accent);padding:.4rem .6rem;background:var(--color-surface);line-height:1.6}.lanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem}.lanes :global(.lane){padding:.65rem;border:1px solid var(--color-rule);background:var(--color-surface);min-width:0}.lanes :global(.name){font-size:.66rem;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.04em;margin:0 0 .5rem}.lanes :global(.state){font-size:.82rem;font-weight:650;line-height:1.5;margin:0 0 .5rem;overflow-wrap:anywhere}.lanes :global(.chips){display:flex;flex-wrap:wrap;gap:.3rem}.lanes :global(.chips span){font:.72rem/1.5 var(--font-mono);padding:.25rem;border:1px solid var(--color-rule);overflow-wrap:anywhere;background:var(--color-surface-alt)}
 .result{font-size:.87rem;font-weight:650;line-height:1.6;margin:.8rem 0 .4rem}.note{font-size:.8rem;line-height:1.65;margin:.4rem 0 .8rem}.transport{display:flex;align-items:center;flex-wrap:wrap;gap:.35rem;font-size:.75rem;border-top:1px solid var(--color-rule);padding-top:.7rem}.transport label{display:flex;align-items:center;gap:.3rem;flex:1;min-width:7rem}.transport input{width:100%;min-width:3rem}details{font-size:.78rem;margin-top:.8rem}summary{cursor:pointer;min-height:36px}details li{margin:.6rem 0;line-height:1.65}[hidden]{display:none}
 @media(max-width:600px){sqlite-acceptance{padding:.65rem}.lanes{grid-template-columns:1fr}.lanes :global(.lane){display:grid;grid-template-columns:5rem minmax(0,1fr);gap:.3rem .5rem;padding:.5rem}.lanes :global(.name){grid-row:span 2;align-self:center;margin:0}.lanes :global(.state){margin:0;font-size:.78rem}.lanes :global(.chips span){font-size:.68rem}.transport button{flex:1}.comparison select{width:100%}.transport label{flex-basis:75%}}
</style>
