---
import { scenes, frames, type Scene } from './model';
interface Props { scene: Scene; number: number; }
const { scene, number } = Astro.props;
const config = scenes[scene];
const initial = frames(scene)[0];
---
<figure class="restore-figure" aria-labelledby={`a39-${scene}-title`}>
 <figcaption id={`a39-${scene}-title`}><span>Figure {number}</span> {config.title}</figcaption>
 <a39-recovery data-scene={scene}>
  <p class="model-label">Explanatory model · use Next to compare each state</p>
  <div class="choices" role="group" aria-label="Change the recovery assumption">
   {config.options.map((label,i)=><button type="button" data-choice={i} aria-pressed={i===0?'true':'false'}>{label}</button>)}
  </div>
  <div class="state-board">
   <p class="stage" data-stage>{initial.stage}</p>
   <div class="comparison">
    <div><p class="panel-label">{config.left}</p><ul data-left>{initial.left.map(text=><li>{text}</li>)}</ul></div>
    <div><p class="panel-label">{config.right}</p><ul data-right>{initial.right.map(text=><li>{text}</li>)}</ul></div>
   </div>
   <p class="narration" data-note aria-live="polite">{initial.note}</p>
  </div>
  <div class="transport" role="group" aria-label={`Figure ${number} playback`}>
   <button type="button" data-action="play" aria-pressed="false">Play</button>
   <button type="button" data-action="back">Back</button>
   <button type="button" data-action="next">Next</button>
   <label>Step <input type="range" min="1" max={frames(scene).length} value="1" step="1" /></label>
   <output data-count>1 / {frames(scene).length}</output>
   <button type="button" data-action="reset">Reset</button>
  </div>
  <noscript><p>With scripts disabled, the complete default sequence follows.</p><ol>{frames(scene).map(frame=><li><strong>{frame.stage}.</strong> {frame.note} {frame.left.join('; ')} / {frame.right.join('; ')}</li>)}</ol></noscript>
 </a39-recovery>
</figure>
<script>
 import { frames, readingDelay, type Scene } from './model';
 class RecoveryFigure extends HTMLElement {
  private step=0; private changed=false; private timer:ReturnType<typeof setTimeout>|undefined; private playing=false;
  connectedCallback() {
   if(this.dataset.ready)return;this.dataset.ready='true';
   this.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button=>button.addEventListener('click',()=>{this.pause();this.changed=button.dataset.choice==='1';this.render();}));
   this.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(button=>button.addEventListener('click',()=>{
    const action=button.dataset.action;
    if(action==='play'){if(this.playing)this.pause();else {if(this.step===this.sequence.length-1)this.step=0;this.playing=true;this.render();this.schedule();}return;}
    this.pause();if(action==='next')this.step=Math.min(this.step+1,this.sequence.length-1);if(action==='back')this.step=Math.max(0,this.step-1);if(action==='reset')this.step=0;this.render();
   }));
   this.querySelector('input')?.addEventListener('input',event=>{this.pause();this.step=Number((event.target as HTMLInputElement).value)-1;this.render();});
   this.render();
  }
  get sequence(){return frames(this.dataset.scene as Scene,this.changed);}
  pause(){this.playing=false;clearTimeout(this.timer);this.querySelector('[data-action="play"]')?.setAttribute('aria-pressed','false');const b=this.querySelector('[data-action="play"]');if(b)b.textContent='Play';}
  schedule(){clearTimeout(this.timer);this.timer=setTimeout(()=>{if(!this.playing)return;if(this.step<this.sequence.length-1){this.step++;this.render();this.schedule();}else{this.pause();}},readingDelay(this.sequence[this.step],Array.from(this.querySelectorAll('.panel-label')).map(el=>el.textContent).join(' ')));}
  render(){
   const frame=this.sequence[this.step];
   for(const [selector,value] of [['[data-stage]',frame.stage],['[data-note]',frame.note],['[data-count]',`${this.step+1} / ${this.sequence.length}`]]){const el=this.querySelector(selector);if(el)el.textContent=value;}
   for(const side of ['left','right'] as const){const list=this.querySelector(`[data-${side}]`);if(list)list.replaceChildren(...frame[side].map(text=>{const li=document.createElement('li');li.textContent=text;return li;}));}
   this.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button=>button.setAttribute('aria-pressed',String((button.dataset.choice==='1')===this.changed)));
   const range=this.querySelector('input');if(range){range.value=String(this.step+1);range.setAttribute('aria-valuetext',`${this.step+1} of ${this.sequence.length}: ${frame.stage}`);}
   const play=this.querySelector('[data-action="play"]');if(play){play.textContent=this.playing?'Pause':'Play';play.setAttribute('aria-pressed',String(this.playing));}
   // aria-disabled preserves keyboard focus at either endpoint.
   this.querySelector('[data-action="back"]')?.setAttribute('aria-disabled',String(this.step===0));
   this.querySelector('[data-action="next"]')?.setAttribute('aria-disabled',String(this.step===this.sequence.length-1));
  }
  disconnectedCallback(){clearTimeout(this.timer);}
 }
 if(!customElements.get('a39-recovery'))customElements.define('a39-recovery',RecoveryFigure);
</script>
<style>
 .restore-figure{border:1px solid var(--color-rule);border-radius:.6rem;margin:2rem 0;overflow:hidden;background:var(--color-surface);}
 figcaption{padding:1rem;font-weight:650;border-bottom:1px solid var(--color-rule);}figcaption span{display:block;font-size:.75rem;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.06em;}
 a39-recovery{display:block;padding:1rem;}.model-label{font-size:.78rem;color:var(--color-text-secondary);margin:0 0 .8rem;}.choices,.transport{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;}
 button{font:inherit;font-size:.82rem;min-height:44px;border:1px solid var(--color-rule);border-radius:.3rem;background:var(--color-surface);color:var(--color-text);padding:.5rem .7rem;cursor:pointer;}button[aria-pressed="true"]{background:var(--color-surface-alt);border-color:var(--color-text);font-weight:650;}button[aria-disabled="true"]{opacity:.55;cursor:default;}button:focus-visible,input:focus-visible{outline:3px solid var(--color-text);outline-offset:3px;}
 .state-board{margin:1rem 0;border:1px solid var(--color-rule);border-radius:.4rem;background:var(--color-surface-alt);padding:1rem;}.stage{font-weight:650;margin:0 0 1rem;}.comparison{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}.comparison>div{border-left:3px solid var(--color-rule);padding-left:.75rem;min-width:0;}.panel-label{font-size:.78rem;font-weight:650;margin:0 0 .6rem;}ul{padding:0;list-style:none;margin:0;}li{font:.83rem/1.7 var(--font-mono);overflow-wrap:anywhere;margin:.2rem 0;}.narration{font-size:.9rem;line-height:1.65;min-height:5em;margin:1rem 0 0;border-top:1px solid var(--color-rule);padding-top:.8rem;}.transport label{display:flex;align-items:center;gap:.4rem;font-size:.8rem;}.transport input{width:6rem;min-height:44px;}.transport output{font-size:.8rem;}
 @media(max-width:520px){a39-recovery{padding:.75rem;}.state-board{padding:.8rem;}.comparison{grid-template-columns:1fr;gap:1rem;}.narration{min-height:0;}.choices button{flex:1 1 9rem;}.transport label{flex:1 1 8rem;}.transport input{width:100%;}}
</style>
