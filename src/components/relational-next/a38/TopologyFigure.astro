---
import { specs, frame } from './model.mjs';
const { scene, number } = Astro.props;
const spec=specs[scene];
const f=frame(scene,spec.initial,0);
const uid=`a38-${scene}`;
---
<figure class="topology-figure" aria-labelledby={`${uid}-title`}>
 <div class="figure-heading"><span>Figure {number}</span><p id={`${uid}-title`}>{spec.title}</p></div>
 <topology-player data-scene={scene}>
  <div class="choice"><label for={`${uid}-choice`}>{spec.label}</label><select id={`${uid}-choice`} data-choice>{spec.options.map(([value,label])=><option value={value} selected={value===spec.initial}>{label}</option>)}</select></div>
  <div class="board">
   <p class="route" data-route>{f.route}</p>
   <div class="copies" data-copies>{f.cards.map(c=><div class="copy" data-active={c.active}><p class="copy-name">{c.name}</p><p class="role">{c.role}</p><div class="rows">{c.rows.map(r=><span>{r}</span>)}</div>{c.log&&<p class="log">{c.log}</p>}</div>)}</div>
   <ol class="boundaries" data-marks>{f.marks.map(m=><li data-passed={m.on}>{m.label}</li>)}</ol>
   <p class="result" data-result>{f.result}</p><p class="outcome" data-outcome>{f.outcome}</p>
   <p class="narration" data-note aria-live="polite">{f.note}</p>
  </div>
  <div class="controls" role="group" aria-label={`Playback for figure ${number}`}><button type="button" data-act="play">Play</button><button type="button" data-act="back">Back</button><button type="button" data-act="next">Next</button><button type="button" data-act="reset">Reset</button><label>Step <input data-step type="range" min="0" max={spec.steps.length-1} value="0" step="1" /></label><output data-count>1 / {spec.steps.length}</output></div>
  <details><summary>Read the complete default sequence</summary><ol>{spec.steps.map((_,i)=><li>{frame(scene,spec.initial,i).note}</li>)}</ol></details>
 </topology-player>
 <figcaption>Explanatory model. Change the selection at any step to compare causes at the same boundary. The native observations below come from a separate disposable PostgreSQL run.</figcaption>
</figure>
<script>
 import {specs,frame,holdMilliseconds} from './model.mjs';
 class TopologyPlayer extends HTMLElement {
  connectedCallback(){
   const scene=this.dataset.scene!,spec=specs[scene];
   const q=(s:string)=>this.querySelector(s) as HTMLElement;
   const choice=q('[data-choice]') as HTMLSelectElement,range=q('[data-step]') as HTMLInputElement;
   const play=q('[data-act="play"]');
   let step=0,timer=0,playing=false;
   const pause=()=>{playing=false;clearTimeout(timer);play.textContent=step===spec.steps.length-1?'Replay':'Play';};
   const scope=this.closest('figure')!.getAttributeNames().filter(name=>name.startsWith('data-astro-cid-'));
   const el=(tag:string,cls:string,text:string)=>{const n=document.createElement(tag);scope.forEach(name=>n.setAttribute(name,''));n.className=cls;n.textContent=text;return n;};
   const draw=()=>{
    const f=frame(scene,choice.value,step);
    q('[data-route]').textContent=f.route;q('[data-result]').textContent=f.result;q('[data-note]').textContent=f.note;q('[data-outcome]').textContent=f.outcome;
    q('[data-copies]').replaceChildren(...f.cards.map(c=>{const n=el('div','copy','');n.dataset.active=String(c.active);n.append(el('p','copy-name',c.name),el('p','role',c.role));const rows=el('div','rows','');rows.append(...c.rows.map(r=>el('span','',r)));if(!c.rows.length)rows.append(el('span','empty','No matching rows'));n.append(rows);if(c.log)n.append(el('p','log',c.log));return n;}));
    q('[data-marks]').replaceChildren(...f.marks.map(m=>{const n=el('li','',m.label);n.dataset.passed=String(m.on);return n;}));
    range.value=String(step);q('[data-count]').textContent=`${step+1} / ${spec.steps.length}`;
    if(!playing)play.textContent=step===spec.steps.length-1?'Replay':'Play';
   };
   const schedule=()=>{
    // Count all visible figure text, including cards, results and controls, then allow inspection.
    const text=(this.closest('figure') as HTMLElement).innerText;
    timer=window.setTimeout(()=>{if(step===spec.steps.length-1){pause();return;}step++;draw();schedule();},holdMilliseconds(text));
   };
   this.querySelectorAll<HTMLButtonElement>('button[data-act]').forEach(b=>b.addEventListener('click',()=>{
    if(b.dataset.act==='play'){if(playing){pause();return;}if(step===spec.steps.length-1)step=0;playing=true;play.textContent='Pause';draw();schedule();return;}
    pause();step=b.dataset.act==='reset'?0:b.dataset.act==='next'?Math.min(step+1,spec.steps.length-1):Math.max(0,step-1);draw();
   }));
   choice.addEventListener('change',()=>{pause();draw();});range.addEventListener('input',()=>{pause();step=Number(range.value);draw();});
   document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();});
   new IntersectionObserver(([entry])=>{if(!entry.isIntersecting)pause();}).observe(this);
   draw();
  }
 }
 if(!customElements.get('topology-player'))customElements.define('topology-player',TopologyPlayer);
</script>
<style>
 .topology-figure{margin:2rem 0;border:1px solid var(--color-rule);padding:1rem;max-width:100%;font: .86rem/1.55 var(--font-sans)}
 .figure-heading{display:flex;gap:.7rem;align-items:baseline;margin-bottom:.8rem}.figure-heading>span{color:var(--color-text-secondary);font-size:.75rem;white-space:nowrap}.figure-heading p{margin:0;font-weight:650}
 topology-player{display:block;min-width:0}.choice{display:flex;flex-wrap:wrap;gap:.4rem .8rem;align-items:center;margin-bottom:.8rem}.choice label{font-weight:600}
 select,button{font:inherit;color:var(--color-text);border:1px solid var(--color-rule-strong);background:var(--color-surface);padding:.45rem .6rem;border-radius:.25rem;min-height:2.6rem;max-width:100%}button{cursor:pointer}button:hover{background:var(--color-surface-alt)}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
 .board{padding:.8rem;background:var(--color-surface-alt);border:1px solid var(--color-rule)}.route{font: .78rem/1.5 var(--font-mono);margin:0 0 .8rem;overflow-wrap:anywhere}.copies{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.copy{padding:.7rem;border:1px solid var(--color-rule-strong);background:var(--color-surface);min-width:0}.copy[data-active=true]{border-color:var(--blue);box-shadow:inset 3px 0 var(--blue)}.copy-name{margin:0;font-weight:700}.role{color:var(--color-text-secondary);font-size:.75rem;min-height:2.4em;margin:.25rem 0 .6rem}.rows{display:flex;flex-direction:column;gap:.35rem;min-height:4rem}.rows span{display:block;padding:.3rem .45rem;border:1px solid var(--color-rule);font: .77rem/1.5 var(--font-mono);overflow-wrap:anywhere}.rows .empty{color:var(--color-text-secondary)}.log{font: .75rem/1.5 var(--font-mono);padding-top:.5rem;border-top:1px dashed var(--color-rule-strong);margin:.6rem 0 0}
 .boundaries{display:flex;flex-wrap:wrap;list-style:none;padding:0;margin:1rem 0;gap:.35rem}.boundaries li{font-size:.7rem;padding:.2rem .4rem;border:1px solid var(--color-rule);margin:0}.boundaries li[data-passed=true]{border-color:var(--blue);background:color-mix(in srgb,var(--blue) 10%,var(--color-surface))}.result{font-weight:650;margin:.6rem 0 .3rem}.outcome{color:var(--color-text-secondary);font-size:.78rem;margin:0 0 .65rem}.narration{margin:0;min-height:5em;border-top:1px solid var(--color-rule);padding-top:.7rem}
 .controls{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin:.8rem 0}.controls label{display:flex;align-items:center;gap:.4rem}.controls input{width:6rem}.controls output{font-variant-numeric:tabular-nums;font-size:.75rem}.topology-figure details{font-size:.78rem}.topology-figure details li{margin:.5rem 0}.topology-figure figcaption{font-size:.75rem;color:var(--color-text-secondary);margin-top:.8rem}
 @media(max-width:580px){.topology-figure{padding:.65rem}.board{padding:.6rem}.copies{grid-template-columns:minmax(0,1fr)}.copy{margin:0}.role{min-height:0}.rows{min-height:0}.narration{min-height:0}.figure-heading{display:block}.figure-heading p{margin-top:.2rem}.controls label{flex:1;min-width:8rem}.controls input{width:100%;min-width:3rem}.choice{display:block}.choice label{display:block;margin-bottom:.35rem}.choice select{width:100%}}
</style>
