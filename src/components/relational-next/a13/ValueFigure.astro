---
import { definitions, frame, renderFrame } from './model.mjs';
interface Props { scene: keyof typeof definitions; number: number }
const {scene,number} = Astro.props;
const def=definitions[scene];
const initial=frame(scene,def.initial,2);
const id=`sql-value-${scene}`;
---
<figure class="sv-figure" aria-labelledby={`${id}-title`}>
 <p class="sv-title" id={`${id}-title`}><span>Figure {number}</span> {def.title}</p>
 <sql-value-figure data-scene={scene}>
  <div class="sv-controls" data-controls hidden>
   <label class="sv-choice">{def.label}<select data-choice>{def.options.map(o=><option value={o.value} selected={o.value===def.initial}>{o.label}</option>)}</select></label>
   <div class="sv-transport" role="group" aria-label={`Playback for figure ${number}`}>
    <button type="button" data-action="play">Play</button>
    <button type="button" data-action="back">Back</button>
    <button type="button" data-action="next">Next</button>
    <button type="button" data-action="reset">Reset</button>
    <label class="sv-step">Step<input data-step type="range" min="0" max="2" step="1" value="2" /></label>
    <output data-count>3 / 3</output>
   </div>
  </div>
  <ol class="sv-stages" aria-label="Calculation stages">{def.steps.map((s,i)=><li data-stage={i}>{s}</li>)}</ol>
  <div class="sv-board" data-board set:html={renderFrame(initial)} />
  <p class="sv-note" data-note aria-live="polite">{initial.note}</p>
 </sql-value-figure>
 <figcaption>{def.caption} Play pauses long enough to read all visible values; Next and Back let you set your own pace.</figcaption>
</figure>
<script>
 import { definitions, frame, renderFrame, holdFor } from './model.mjs';
 class SqlValueFigure extends HTMLElement {
  stopPlayback: (()=>void) | undefined;
  connectedCallback() {
   if(this.dataset.ready) return;
   this.dataset.ready='true';
   const scene=this.dataset.scene as keyof typeof definitions;
   const def=definitions[scene];
   const choice=this.querySelector<HTMLSelectElement>('[data-choice]')!;
   const scrub=this.querySelector<HTMLInputElement>('[data-step]')!;
   const board=this.querySelector<HTMLElement>('[data-board]')!;
   const note=this.querySelector<HTMLElement>('[data-note]')!;
   const count=this.querySelector<HTMLOutputElement>('[data-count]')!;
   const play=this.querySelector<HTMLButtonElement>('[data-action="play"]')!;
   const back=this.querySelector<HTMLButtonElement>('[data-action="back"]')!;
   const next=this.querySelector<HTMLButtonElement>('[data-action="next"]')!;
   let step=0, playing=false, timer=0;
   const stop=()=>{playing=false;window.clearTimeout(timer);play.textContent='Play';play.setAttribute('aria-pressed','false');};
   this.stopPlayback=stop;
   const draw=()=>{
    const f=frame(scene,choice.value,step);
    board.innerHTML=renderFrame(f);note.textContent=f.note;
    scrub.value=String(step);scrub.setAttribute('aria-valuetext',`${step+1} of 3: ${def.steps[step]}`);
    count.textContent=`${step+1} / 3`;
    back.setAttribute('aria-disabled',String(step===0));next.setAttribute('aria-disabled',String(step===2));
    this.querySelectorAll<HTMLElement>('[data-stage]').forEach((el,i)=>{el.dataset.current=String(i===step); if(i===step)el.setAttribute('aria-current','step');else el.removeAttribute('aria-current');});
   };
   const tick=()=>{
    timer=window.setTimeout(()=>{
     if(!playing)return;
     if(step===2){stop();return;}
     step++;draw();tick();
    },holdFor(frame(scene,choice.value,step)));
   };
   play.addEventListener('click',()=>{
    if(playing){stop();return;}
    if(step===2)step=0;
    playing=true;play.textContent='Pause';play.setAttribute('aria-pressed','true');draw();tick();
   });
   this.querySelector('[data-action="reset"]')!.addEventListener('click',()=>{stop();step=0;draw();});
   back.addEventListener('click',()=>{stop();step=Math.max(0,step-1);draw();});
   next.addEventListener('click',()=>{stop();step=Math.min(2,step+1);draw();});
   choice.addEventListener('change',()=>{stop();draw();});
   scrub.addEventListener('input',()=>{stop();step=Number(scrub.value);draw();});
   document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
   new IntersectionObserver(entries=>{if(!entries[0].isIntersecting)stop();}).observe(this);
   this.querySelector<HTMLElement>('[data-controls]')!.hidden=false;
   draw();
  }
  disconnectedCallback(){this.stopPlayback?.();}
 }
 if(!customElements.get('sql-value-figure'))customElements.define('sql-value-figure',SqlValueFigure);
</script>
<style>
 .sv-figure{margin:2rem 0;border:1px solid var(--color-rule);border-radius:.65rem;overflow:hidden;background:var(--color-surface);}
 .sv-title{margin:0;padding:1rem 1rem .8rem;font-weight:650;line-height:1.5;}
 .sv-title span{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-secondary);font-weight:500;}
 sql-value-figure{display:block;padding:0 1rem;}
 .sv-controls{display:grid;gap:.65rem;padding:.75rem;background:var(--color-surface-alt);border:1px solid var(--color-rule);border-radius:.4rem;}
 .sv-controls[hidden]{display:none;}
 .sv-choice{display:grid;gap:.3rem;font-size:.8rem;}
 select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;min-height:2.6rem;padding:.4rem .65rem;}
 select{width:100%;min-width:0;}
 button{cursor:pointer;font-size:.8rem;}
 button[aria-disabled="true"]{color:var(--color-text-secondary);}
 button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px;}
 .sv-transport{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;}
 .sv-step{display:flex;align-items:center;gap:.3rem;font-size:.75rem;flex:1;min-width:8rem;}
 .sv-step input{width:100%;min-width:3rem;accent-color:var(--color-accent);}
 output{font-size:.75rem;font-variant-numeric:tabular-nums;}
 .sv-stages{display:flex;gap:.5rem;list-style:none;padding:0;margin:1rem 0;font-size:.75rem;}
 .sv-stages li{flex:1;border-top:3px solid var(--color-rule);padding-top:.4rem;}
 .sv-stages li[data-current="true"]{border-color:var(--color-accent);font-weight:700;}
 .sv-board{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,21rem),1fr));gap:.75rem;align-items:start;}
 .sv-board :global(.sv-panel){min-width:0;margin:0;padding:0;border:1px solid var(--color-rule);border-radius:.4rem;overflow:hidden;}
 .sv-board :global(.sv-label){padding:.6rem .7rem;margin:0;font-size:.8rem;font-weight:650;background:var(--color-surface-alt);}
 .sv-board :global(.sv-scroll){overflow:auto;max-width:100%;}
 .sv-board :global(table){margin:0;width:100%;font-size:.73rem;line-height:1.55;border-collapse:collapse;}
 .sv-board :global(th),.sv-board :global(td){padding:.55rem .6rem;border-bottom:1px solid var(--color-rule);text-align:left;overflow-wrap:anywhere;min-width:3.8rem;}
 .sv-board :global(tbody th){font-weight:500;}
 .sv-board :global(td[data-value="keep"]){font-weight:700;color:var(--color-accent);}
 .sv-board :global(td[data-value="unknown"]){font-style:italic;font-weight:650;}
 .sv-note{font-size:.87rem;line-height:1.65;min-height:5.3rem;margin:1rem 0;}
 figcaption{font-size:.78rem;color:var(--color-text-secondary);padding:.8rem 1rem;border-top:1px solid var(--color-rule);}
 @media(max-width:600px){sql-value-figure{padding:0 .6rem;}.sv-title{padding:.8rem .6rem;}.sv-board{grid-template-columns:1fr;}.sv-stages{gap:.35rem;font-size:.68rem;}.sv-board :global(th),.sv-board :global(td){padding:.45rem .4rem;min-width:3rem;}.sv-note{min-height:7rem;}.sv-transport button{flex:1;}.sv-step{flex-basis:75%;}.sv-controls{padding:.5rem;}}
</style>
