---
<figure data-a00-order aria-labelledby="a00-order-title">
  <figcaption><span class="eyebrow">Figure 2 · illustrative change</span><strong id="a00-order-title">Which facts survive a failed request?</strong></figcaption>
  <div class="controls"><label>Save the changes <select data-together><option value="separate">Each statement commits</option><option value="together">One transaction</option></select></label><label>Request <select data-fail><option value="fail">Fails after inserting the item</option><option value="success">Completes</option></select></label></div>
  <ol class="steps"><li data-stage="0" aria-current="step">Start</li><li data-stage="1">Insert order</li><li data-stage="2">Insert item</li><li data-stage="3">Reserve stock / fail</li><li data-stage="4">Finish</li></ol>
  <div class="states"><div><p class="input-title">This request’s view</p><dl><dt>Order 103</dt><dd data-work-order>absent</dd><dt>MUG item for 103</dt><dd data-work-item>absent</dd><dt>Mugs available</dt><dd data-work-stock>1</dd></dl></div><div><p class="input-title">A new reader’s view</p><dl><dt>Order 103</dt><dd data-read-order>absent</dd><dt>MUG item for 103</dt><dd data-read-item>absent</dd><dt>Mugs available</dt><dd data-read-stock>1</dd></dl></div></div>
  <p class="explanation" data-explanation aria-live="polite">One mug is available. The new order, 103, does not exist.</p>
  <div class="controls"><button type="button" data-play>Play</button><button type="button" data-back disabled>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 5</span></div>
  <p class="boundary">Model of commit and rollback, with one buyer. The reader starts a new read at each step. No payment call, elapsed time or competing transaction is simulated.</p>
  <details><summary>Read the model without animation</summary><p>With separate commits, a failure after the second statement leaves an order and its item but stock unchanged. In one transaction, the request sees its own unfinished changes while other readers do not. Rolling back removes both new rows. On success, committing publishes the order, item and stock reduction together.</p></details>
</figure>
<script>
  import { orderState } from './models.mjs';
  document.querySelectorAll<HTMLElement>('[data-a00-order]').forEach(root => {
    let step = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const get = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const stop = () => { clearTimeout(timer); timer = undefined; get('[data-play]').textContent = 'Play'; };
    const draw = () => {
      const together = get<HTMLSelectElement>('[data-together]').value === 'together';
      const fail = get<HTMLSelectElement>('[data-fail]').value === 'fail';
      const state = orderState(step, together, fail);
      for (const [prefix, view] of [['work', state.working], ['read', state.visible]] as const) {
        get(`[data-${prefix}-order]`).textContent = view.order ? 'pending_payment' : 'absent';
        get(`[data-${prefix}-item]`).textContent = view.item ? '1 × MUG' : 'absent';
        get(`[data-${prefix}-stock]`).textContent = String(view.stock);
        get(`[data-${prefix}-order]`).classList.toggle('present', view.order);
        get(`[data-${prefix}-item]`).classList.toggle('present', view.item);
      }
      root.querySelectorAll('[data-stage]').forEach((el, i) => el.setAttribute('aria-current', i === step ? 'step' : 'false'));
      get('[data-explanation]').textContent = state.message;
      get('[data-step]').textContent = `${step + 1} / 5`;
      const back = get<HTMLButtonElement>('[data-back]');
      const next = get<HTMLButtonElement>('[data-next]');
      if (step === 4 && document.activeElement === next) back.focus();
      else if (step === 0 && document.activeElement === back) next.focus();
      back.disabled = step === 0;
      next.disabled = step === 4;
      if (step === 4) stop();
    };
    get('[data-next]').addEventListener('click', () => { stop(); step = Math.min(4, step + 1); draw(); });
    get('[data-back]').addEventListener('click', () => { stop(); step = Math.max(0, step - 1); draw(); });
    const reset = () => { stop(); step = 0; draw(); };
    get('[data-reset]').addEventListener('click', reset);
    get('[data-together]').addEventListener('change', reset);
    get('[data-fail]').addEventListener('change', reset);
    const playStep = () => {
      draw();
      if (step === 4) return;
      get('[data-play]').textContent = 'Pause';
      const words = get('[data-explanation]').textContent!.trim().split(/\s+/).length;
      timer = setTimeout(() => { step = Math.min(4, step + 1); playStep(); }, Math.max(4500, words * 60000 / 180 + 1800));
    };
    get('[data-play]').addEventListener('click', () => {
      if (timer) { stop(); return; }
      if (step === 4) step = 0;
      playStep();
    });
    document.addEventListener('astro:before-swap', stop, { once: true });
  });
</script>
<style>
  figure{margin:2rem 0;border:1px solid var(--color-rule);padding:1.2rem;background:var(--color-surface-alt)} figcaption strong,figcaption span{display:block} figcaption strong{font-size:1.1rem}
  .controls{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin:1rem 0}label{display:flex;align-items:center;gap:.5rem;font-size:.8rem;flex-wrap:wrap} button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .7rem;cursor:pointer}button:disabled{opacity:.45;cursor:default}button:focus-visible,select:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}
  .steps{display:flex;gap:.4rem;list-style:none;padding:0;margin:1.2rem 0}.steps li{flex:1;border-top:3px solid var(--color-rule);padding:.5rem;font-size:.75rem}.steps [aria-current="step"]{border-color:var(--color-accent);font-weight:700}
  .states{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.states>div{background:var(--color-surface);border:1px solid var(--color-rule);padding:1rem}.input-title{font-size:.9rem;margin:0 0 .8rem}dl{display:grid;grid-template-columns:1fr auto;gap:.5rem;font-size:.8rem;margin:0}dt,dd{margin:0;padding:.3rem 0}dd{font-family:var(--font-mono)}.present{font-weight:700;color:var(--color-accent)}.explanation{min-height:4rem;font-size:.9rem}.boundary,details{font-size:.8rem;color:var(--color-text-secondary)}summary{cursor:pointer}
  @media(max-width:600px){figure{padding:.8rem}.states{grid-template-columns:1fr}.steps{gap:.2rem}.steps li{padding:.3rem;font-size:.65rem}select{max-width:100%}}
</style>
