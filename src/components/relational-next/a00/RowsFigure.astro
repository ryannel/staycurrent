---
import { joinedRows, items } from './models.mjs';
const orderRows = joinedRows(true).filter((row, i, all) => all.findIndex(other => other.order_id === row.order_id) === i);
---
<figure class="rows-figure" data-a00-rows aria-labelledby="a00-rows-title">
  <figcaption><span class="eyebrow">Figure 1 · illustrative rows</span><strong id="a00-rows-title">One order can become several result rows</strong></figcaption>
  <div class="controls"><label>Orders without items <select data-empty><option value="omit">Omit: JOIN</option><option value="keep">Keep: LEFT JOIN</option></select></label></div>
  <div class="inputs">
    <div><p class="input-title">orders, joined to customers</p><table><thead><tr><th>order_id</th><th>customer</th><th>status</th></tr></thead><tbody>{orderRows.map(row => <tr data-order={row.order_id}><td>{row.order_id}</td><td>{row.customer}</td><td>{row.status}</td></tr>)}</tbody></table></div>
    <div><p class="input-title">order_items</p><table><thead><tr><th>order_id</th><th>product_id</th><th>quantity</th><th>unit_price_gbp</th></tr></thead><tbody>{items.map(row => <tr data-item={row.order_id}><td>{row.order_id}</td><td>{row.product_id}</td><td>{row.quantity}</td><td>{row.unit_price_gbp.toFixed(2)}</td></tr>)}</tbody></table></div>
  </div>
  <ol class="row-steps" data-live><li data-stage="0" aria-current="step">Read related tables</li><li data-stage="1">Match on order_id</li><li data-stage="2">Group by order</li></ol>
  <div class="result" data-result data-live role="region" tabindex="0" aria-label="Result rows"><p>Two orders; two item rows. Predict how many rows the join will return.</p></div>
  <p class="explanation" data-explanation data-live aria-live="polite">The items both belong to order 101. Order 102 has no items yet.</p>
  <div class="controls"><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 3</span><span class="hold" data-hold aria-hidden="true"><span></span></span></div>
  <details><summary>Read this figure as text</summary><p>The ordinary join returns two rows for order 101, one per matching item, and omits order 102. Grouping adds 1 × £20 and 2 × £8 to give order 101 a total of £36. LEFT JOIN also keeps order 102 with NULL item values; its sum is NULL because it has no item values to add.</p></details>
</figure>
<script>
  import { joinedRows, summaries } from './models.mjs';
  import { stepper } from '../../figures/stepper.mjs';
  document.querySelectorAll<HTMLElement>('[data-a00-rows]').forEach(root => {
    const get = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const draw = (step: number) => {
      const keep = get<HTMLSelectElement>('[data-empty]').value === 'keep';
      const rows = joinedRows(keep);
      const totals = summaries(keep);
      root.querySelectorAll('[data-stage]').forEach((el, i) => { el.setAttribute('aria-current', i === step ? 'step' : 'false'); });
      root.querySelectorAll<HTMLElement>('[data-order]').forEach(el => {
        const id = Number(el.dataset.order);
        const matched = rows.some(row => row.order_id === id && row.product_id !== null);
        el.classList.toggle('matched', step === 1 && matched);
        el.classList.toggle('kept', step === 1 && !matched && keep);
        el.classList.toggle('dropped', step === 1 && !matched && !keep);
      });
      root.querySelectorAll<HTMLElement>('[data-item]').forEach(el => el.classList.toggle('matched', step === 1));
      const result = get('[data-result]');
      const row = (count: number) => `${count} ${count === 1 ? 'row' : 'rows'}`;
      if (step === 0) result.innerHTML = '<p>Two orders; two item rows. Predict how many rows the join will return.</p>';
      if (step === 1) result.innerHTML = `<table><caption>${row(rows.length)} joined; ${totals.length} distinct ${totals.length === 1 ? 'order' : 'orders'}</caption><thead><tr><th>order_id</th><th>customer</th><th>product_id</th><th>quantity</th><th>unit_price_gbp</th></tr></thead><tbody>${rows.map(r => `<tr${r.product_id === null ? ' class="kept"' : ''}><td>${r.order_id}</td><td>${r.customer}</td><td>${r.product_id ?? 'NULL'}</td><td>${r.quantity ?? 'NULL'}</td><td>${r.unit_price_gbp === null ? 'NULL' : r.unit_price_gbp.toFixed(2)}</td></tr>`).join('')}</tbody></table>`;
      if (step === 2) result.innerHTML = `<table><caption>${totals.length} grouped ${totals.length === 1 ? 'row' : 'rows'}: one per included order</caption><thead><tr><th>order_id</th><th>customer</th><th>item_total_gbp</th></tr></thead><tbody>${totals.map(r => `<tr><td>${r.order_id}</td><td>${r.customer}</td><td>${r.total === null ? 'NULL' : r.total.toFixed(2)}</td></tr>`).join('')}</tbody></table>`;
      get('[data-explanation]').textContent = step === 0 ? 'The items both belong to order 101. Order 102 has no items yet.' : step === 1 ?
        `Both items match order 101, so order 101 appears twice.${keep ? ' LEFT JOIN keeps order 102 once, with NULL item values.' : ' Ordinary JOIN drops order 102 because no item matches it.'} Counting these rows would not count orders.` :
        `GROUP BY gathers order 101’s two items: 1 × £20 + 2 × £8 = £36.${keep ? ' Order 102 has no item values to add, so SUM returns NULL.' : ' Order 102 was removed by the join; grouping cannot bring it back.'}`;
    };
    const player = stepper(root, { steps: () => 3, draw });
    get('[data-empty]').addEventListener('change', player.render);
  });
</script>
<style>
  figure { margin: 2rem 0; border: 1px solid var(--color-rule); padding: 1.2rem; background: var(--color-surface-alt); }
  figcaption strong, figcaption span { display: block; } figcaption strong { font-size: 1.1rem; }
  .inputs { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.45fr);gap:1rem; } .inputs > div { min-width:0;overflow-x:auto; } .inputs th, .inputs td { padding:.4rem .3rem; }.input-title {font:600 .85rem var(--font-mono);margin:.8rem 0;}
  table { display:table;width:100%;margin:0;font:.77rem/1.5 var(--font-mono);border-collapse:collapse; } th, td {padding:.4rem;text-align:left;border:0;border-bottom:1px solid var(--color-rule);} th {background:none;} caption {text-align:left;font:600 .85rem/1.5 var(--font-sans);margin-bottom:.6rem;}
  tr.matched td {background:var(--color-surface);font-weight:700;box-shadow:inset 0 -2px var(--color-accent);}
  tr.kept td {background:var(--color-surface);box-shadow:inset 0 -2px var(--color-accent);font-style:italic;}
  tr.dropped td {color:var(--color-text-secondary);text-decoration:line-through;}
  .row-steps {display:flex;gap:.5rem;list-style:none;padding:0;margin:1.2rem 0;} .row-steps li {flex:1;border-top:3px solid var(--color-rule);padding:.5rem;font-size:.8rem;} .row-steps [aria-current="step"] {border-color:var(--color-accent);font-weight:700;}
  .result :global(table) {display:table;width:100%;margin:0;font:.77rem/1.5 var(--font-mono);border-collapse:collapse;} .result :global(th), .result :global(td) {padding:.4rem;text-align:left;border:0;border-bottom:1px solid var(--color-rule);background:none;} .result :global(caption) {text-align:left;font:600 .85rem/1.5 var(--font-sans);margin-bottom:.6rem;} .result :global(tr.kept td) {font-style:italic;}
  .result {min-height:10rem;overflow:auto;border:1px solid var(--color-rule);padding:.8rem;background:var(--color-surface);} .result :global(p) {margin:0;}
  .explanation {min-height:5rem;font-size:.9rem;} .controls {display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin:1rem 0;} label {min-width:0;max-width:100%;font-size:.8rem;display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;}
  button, select {font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .7rem;cursor:pointer;} button[aria-disabled="true"] {opacity:.45;cursor:default;} button:focus-visible,select:focus-visible,.result:focus-visible {outline:2px solid var(--color-accent);outline-offset:2px;}
  .hold {flex:0 0 4rem;height:3px;background:var(--color-rule);} .hold span {display:block;height:100%;width:0;background:var(--color-accent);}
  details {font-size:.85rem;} summary {cursor:pointer;} @media(max-width:600px){figure{padding:.8rem}.result{padding:.5rem}.result :global(table){font-size:.68rem}.result :global(th),.result :global(td){padding:.3rem .25rem}.inputs{grid-template-columns:1fr} .row-steps{gap:.2rem} .row-steps li{padding:.35rem;font-size:.72rem} table{font-size:.72rem} th,td{padding:.3rem}}
</style>
