---
import { orders, items } from './models.mjs';
---
<figure class="rows-figure" data-a00-rows aria-labelledby="a00-rows-title">
  <figcaption><span class="eyebrow">Figure 1 · illustrative rows</span><strong id="a00-rows-title">One order can become several result rows</strong></figcaption>
  <div class="controls"><label>Orders without items <select data-empty><option value="omit">Omit: JOIN</option><option value="keep">Keep: LEFT JOIN</option></select></label></div>
  <div class="inputs">
    <div><p class="input-title">orders + customers</p><table><thead><tr><th>order_id</th><th>customer</th><th>status</th></tr></thead><tbody>{orders.map(row => <tr><td>{row.order_id}</td><td>{row.customer}</td><td>{row.status}</td></tr>)}</tbody></table></div>
    <div><p class="input-title">order_items</p><table><thead><tr><th>order_id</th><th>product</th><th>qty × price</th></tr></thead><tbody>{items.map(row => <tr><td>{row.order_id}</td><td>{row.product_id}</td><td>{row.quantity} × £{row.unit_price_gbp}</td></tr>)}</tbody></table></div>
  </div>
  <ol class="flow"><li data-stage="0" aria-current="step">Read related tables</li><li data-stage="1">Match on order_id</li><li data-stage="2">Group by order</li></ol>
  <div class="result" data-result aria-label="Result rows"><p>Two orders; two item rows. Predict how many rows the join will return.</p></div>
  <p class="explanation" data-explanation aria-live="polite">The items both belong to order 101. Order 102 has no items yet.</p>
  <div class="controls"><button type="button" data-play>Play</button><button type="button" data-back disabled>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 3</span></div>
  <details><summary>Read the model without animation</summary><p>The ordinary join returns two rows for order 101, one per matching item, and omits order 102. Grouping adds £20 and £16 to give order 101 a total of £36. LEFT JOIN also retains order 102 with NULL item values; its sum is NULL because it has no item values to add.</p></details>
</figure>
<script>
  import { joinedRows, summaries } from './models.mjs';
  document.querySelectorAll<HTMLElement>('[data-a00-rows]').forEach(root => {
    let step = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const get = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const stop = () => { clearTimeout(timer); timer = undefined; get('[data-play]').textContent = 'Play'; };
    const draw = () => {
      const keep = get<HTMLSelectElement>('[data-empty]').value === 'keep';
      const rows = joinedRows(keep);
      const totals = summaries(keep);
      root.querySelectorAll('[data-stage]').forEach((el, i) => { el.setAttribute('aria-current', i === step ? 'step' : 'false'); });
      const result = get('[data-result]');
      if (step === 0) result.innerHTML = '<p>Two orders; two item rows. Predict how many rows the join will return.</p>';
      if (step === 1) result.innerHTML = `<table><caption>${rows.length} joined rows; ${totals.length} distinct ${totals.length === 1 ? 'order' : 'orders'}</caption><thead><tr><th>order_id</th><th>customer</th><th>product</th><th>line £</th></tr></thead><tbody>${rows.map(row => `<tr><td>${row.order_id}</td><td>${row.customer}</td><td>${row.product_id ?? 'NULL'}</td><td>${row.product_id === null ? 'NULL' : (row.quantity * row.unit_price_gbp).toFixed(2)}</td></tr>`).join('')}</tbody></table>`;
      if (step === 2) result.innerHTML = `<table><caption>${totals.length} grouped rows: one per included order</caption><thead><tr><th>order_id</th><th>customer</th><th>item_total_gbp</th></tr></thead><tbody>${totals.map(row => `<tr><td>${row.order_id}</td><td>${row.customer}</td><td>${row.total === null ? 'NULL' : row.total.toFixed(2)}</td></tr>`).join('')}</tbody></table>`;
      get('[data-explanation]').textContent = step === 0 ? 'The items both belong to order 101. Order 102 has no items yet.' : step === 1 ?
        `Order 101 appears twice because it matches two items.${keep ? ' LEFT JOIN keeps order 102 with empty item values.' : ' Ordinary JOIN omits order 102 because there is no matching item.'} Counting these rows would not count orders.` :
        `GROUP BY gathers order 101’s two lines: 1 × £20 + 2 × £8 = £36.${keep ? ' Order 102 has no line values to add, so SUM returns NULL.' : ' Order 102 was removed by the join; grouping cannot bring it back.'}`;
      const back = get<HTMLButtonElement>('[data-back]');
      const next = get<HTMLButtonElement>('[data-next]');
      if (step === 2 && document.activeElement === next) back.focus();
      else if (step === 0 && document.activeElement === back) next.focus();
      back.disabled = step === 0;
      next.disabled = step === 2;
      get('[data-step]').textContent = `${step + 1} / 3`;
      if (step === 2) stop();
    };
    get('[data-next]').addEventListener('click', () => { stop(); step = Math.min(2, step + 1); draw(); });
    get('[data-back]').addEventListener('click', () => { stop(); step = Math.max(0, step - 1); draw(); });
    get('[data-reset]').addEventListener('click', () => { stop(); step = 0; draw(); });
    get('[data-empty]').addEventListener('change', () => { stop(); draw(); });
    const playStep = () => {
      draw();
      if (step === 2) return;
      get('[data-play]').textContent = 'Pause';
      const words = get('[data-explanation]').textContent!.trim().split(/\s+/).length;
      timer = setTimeout(() => { step = Math.min(2, step + 1); playStep(); }, Math.max(4500, words * 60000 / 180 + 1800));
    };
    get('[data-play]').addEventListener('click', () => {
      if (timer) { stop(); return; }
      if (step === 2) step = 0;
      playStep();
    });
    document.addEventListener('astro:before-swap', stop, { once: true });
  });
</script>
<style>
  figure { margin: 2rem 0; border: 1px solid var(--color-rule); padding: 1.2rem; background: var(--color-surface-alt); }
  figcaption strong, figcaption span { display: block; } figcaption strong { font-size: 1.1rem; }
  .inputs { display:grid;grid-template-columns:1fr 1fr;gap:1rem; }.input-title {font:600 .85rem var(--font-mono);margin:.8rem 0;}
  table { width:100%;font:.77rem/1.5 var(--font-mono);border-collapse:collapse; } th, td {padding:.4rem;text-align:left;border-bottom:1px solid var(--color-rule);} caption {text-align:left;font:600 .85rem/1.5 var(--font-sans);margin-bottom:.6rem;}
  .flow {display:flex;gap:.5rem;list-style:none;padding:0;margin:1.2rem 0;} .flow li {flex:1;border-top:3px solid var(--color-rule);padding:.5rem;font-size:.8rem;} .flow [aria-current="step"] {border-color:var(--color-accent);font-weight:700;}
  .result :global(table) {width:100%;font:.77rem/1.5 var(--font-mono);border-collapse:collapse;} .result :global(th), .result :global(td) {padding:.4rem;text-align:left;border-bottom:1px solid var(--color-rule);} .result :global(caption) {text-align:left;font:600 .85rem/1.5 var(--font-sans);margin-bottom:.6rem;}
  .result {min-height:10rem;overflow:auto;border:1px solid var(--color-rule);padding:.8rem;background:var(--color-surface);} .result :global(p) {margin:0;}
  .explanation {min-height:5rem;font-size:.9rem;} .controls {display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin:1rem 0;} label {font-size:.8rem;display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;}
  button, select {font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .7rem;cursor:pointer;} button:disabled {opacity:.45;cursor:default;} button:focus-visible,select:focus-visible {outline:2px solid var(--color-accent);outline-offset:2px;}
  details {font-size:.85rem;} summary {cursor:pointer;} @media(max-width:600px){figure{padding:.8rem}.inputs{grid-template-columns:1fr} .flow{gap:.2rem} .flow li{padding:.35rem;font-size:.72rem}}
</style>
