<figure class="keys-figure" data-a01-keys aria-labelledby="a01-keys-title">
  <figcaption id="a01-keys-title"><span>Figure 1</span> A new number cannot repair a broken relationship</figcaption>
  <label>Compare a change
    <select data-case>
      <option value="original">Store the original B11</option>
      <option value="duplicate">Try B99: same customer and session</option>
      <option value="tenant">Try B14: customer from tenant 2</option>
    </select>
  </label>
  <p class="existing" data-existing>No bookings are stored yet.</p>
  <div class="relationship" aria-label="Customer, booking and session rows">
    <div class="node" data-customer><p class="node-title">Customer row</p><p class="tuple" data-customer-key>(1, 7)</p><p class="field-label">tenant, customer</p></div>
    <div class="node booking" data-booking><p class="node-title" data-booking-title>Booking B11</p><p class="tuple" data-row-key>(1, 11)</p><p class="field-label">tenant, booking</p><p data-references>C7 → S21</p></div>
    <div class="node" data-session><p class="node-title">Session row</p><p class="tuple">(1, 21)</p><p class="field-label">tenant, session</p></div>
  </div>
  <p class="flow">customer ← booking → session</p>
  <ol class="checks" aria-label="Checks illustrated in order">
    <li data-check="0" aria-current="step"><strong>Row key</strong><code data-own-key>(1, 11)</code><span data-own-result>Unused</span></li>
    <li data-check="1"><strong>Business key</strong><code data-business-key>(1, 7, 21)</code><span data-business-result>Not checked yet</span></li>
    <li data-check="2"><strong>References</strong><code data-reference-keys>(1, 7) + (1, 21)</code><span data-reference-result>Not checked yet</span></li>
  </ol>
  <p class="narration" data-narration aria-live="polite">B11’s row key is tenant 1, booking 11. It is unused, so the primary key permits it. That says nothing yet about which customer and session it connects.</p>
  <div class="controls" aria-label="Key and reference checks">
    <button type="button" data-back aria-disabled="true">Back</button>
    <button type="button" data-next>Next check</button>
    <button type="button" data-reset>Reset checks</button>
    <span data-progress>1 / 4</span>
  </div>
  <p class="model-note">Illustrative checks, not a database execution trace. This order explains the rules; PostgreSQL need not check them in this order. Tuples show the full key, including its tenant.</p>
  <noscript><p>B11 with keys (1, 11) and (1, 7, 21) is valid when initially stored. A later B99 has a new row key but repeats B11’s business key and is rejected. B14 in tenant 1 cannot reference customer (2, 9): it requires (1, 9), which does not exist.</p></noscript>
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-a01-keys]')) {
    const choice = root.querySelector<HTMLSelectElement>('[data-case]')!;
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    let step = 0;
    const text = (selector: string, value: string) => { root.querySelector(selector)!.textContent = value; };
    function render() {
      const duplicate = choice.value === 'duplicate';
      const tenant = choice.value === 'tenant';
      const id = duplicate ? 99 : tenant ? 14 : 11;
      const customer = tenant ? 9 : 7;
      text('[data-existing]', choice.value === 'original' ? 'No bookings are stored yet.' : 'Already stored: B11 → tenant 1, customer 7, session 21.');
      text('[data-customer-key]', tenant ? '(2, 9)' : '(1, 7)');
      text('[data-booking-title]', `Booking B${id}`);
      text('[data-row-key]', `(1, ${id})`);
      text('[data-references]', `C${customer} → S21`);
      text('[data-own-key]', `(1, ${id})`);
      text('[data-business-key]', `(1, ${customer}, 21)`);
      text('[data-reference-keys]', `(1, ${customer}) + (1, 21)`);
      text('[data-own-result]', 'Unused: passes');
      text('[data-business-result]', step < 1 ? 'Not checked yet' : duplicate ? 'Already B11: fails' : 'Unused: passes');
      text('[data-reference-result]', step < 2 ? 'Not checked yet' : tenant ? 'Customer (1, 9) missing: fails' : 'Both targets exist: passes');
      root.querySelector('[data-business-result]')!.classList.toggle('failed', duplicate && step >= 1);
      root.querySelector('[data-reference-result]')!.classList.toggle('failed', tenant && step >= 2);
      root.querySelector('[data-booking]')!.classList.toggle('highlight', step === 0 || step === 1);
      root.querySelector('[data-customer]')!.classList.toggle('highlight', step >= 2);
      root.querySelector('[data-session]')!.classList.toggle('highlight', step >= 2);
      root.querySelector('[data-customer]')!.classList.toggle('mismatch', step >= 2 && tenant);
      root.querySelectorAll<HTMLElement>('[data-check]').forEach((item, index) => {
        if (index === step) item.setAttribute('aria-current', 'step'); else item.removeAttribute('aria-current');
      });
      const notes = [
        `B${id}’s row key is tenant 1, booking ${id}. It is unused, so the primary key permits it. That says nothing yet about which customer and session it connects.`,
        duplicate
          ? 'B99 changes only the booking number. Its business key (tenant 1, customer 7, session 21) is already B11’s. The additional unique constraint rejects this duplicate fact.'
          : `The business key is tenant 1, customer ${customer}, session 21. No existing booking has that combination, so the additional uniqueness rule permits it.`,
        tenant
          ? 'The booking requires customer (1, 9). The visible customer is (2, 9). Customer 9 exists, but in the wrong tenant, so the complete foreign key fails. The session reference passes.'
          : `The booking requires customer (1, ${customer}) and session (1, 21). Each complete pair matches its target row, so both required references pass.`,
        duplicate
          ? 'Rejected. B99’s new row identity does not make the repeated customer–session fact valid.'
          : tenant
            ? 'Rejected. An individually valid customer number cannot satisfy a reference to the wrong tenant.'
            : 'Accepted. B11 has a unique row identity, a unique customer–session combination and two valid references within tenant 1.'
      ];
      text('[data-narration]', notes[step]);
      text('[data-progress]', `${step + 1} / 4`);
      back.setAttribute('aria-disabled', String(step === 0));
      next.setAttribute('aria-disabled', String(step === 3));
    }
    choice.addEventListener('change', () => { step = 0; render(); });
    back.addEventListener('click', () => { step = Math.max(0, step - 1); render(); });
    next.addEventListener('click', () => { step = Math.min(3, step + 1); render(); });
    root.querySelector('[data-reset]')!.addEventListener('click', () => { step = 0; render(); });
    render();
  }
</script>

<style>
  .keys-figure { margin: 2rem 0; padding: 1rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface-alt); }
  figcaption { font: 1.1rem/1.4 var(--font-serif); }
  figcaption span { margin-right: .6rem; font: .7rem var(--font-mono); text-transform: uppercase; color: var(--color-text-secondary); }
  label { display: grid; gap: .3rem; margin: .8rem 0; font: .8rem/1.4 var(--font-sans); }
  select, button { color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-rule-strong); border-radius: .2rem; padding: .4rem .55rem; min-height: 2.4rem; font: .8rem/1.4 var(--font-sans); }
  button { cursor: pointer; }
  button[aria-disabled="true"] { opacity: .45; cursor: default; }
  button:focus-visible, select:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .existing { font: .76rem/1.5 var(--font-sans); min-height: 3em; }
  .relationship { display: grid; grid-template-columns: 1fr 1.15fr 1fr; gap: .5rem; }
  .node { padding: .6rem .4rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface); text-align: center; min-width: 0; }
  .node p { margin: .25rem 0; font: .78rem/1.4 var(--font-sans); }
  .node .node-title { font-weight: 700; }
  .node .tuple { font: .9rem/1.6 var(--font-mono); }
  .node .field-label { font-size: .68rem; color: var(--color-text-secondary); }
  .flow { text-align: center; font: .72rem/1.4 var(--font-mono); margin: .5rem 0; }
  .highlight { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .mismatch { border-style: dashed; }
  .checks { margin: .75rem 0; padding: 0; list-style: none; display: grid; gap: .4rem; }
  .checks li { display: grid; grid-template-columns: 7rem 1fr; margin: 0; padding: .4rem; gap: .2rem .5rem; border: 1px solid var(--color-rule); font: .76rem/1.5 var(--font-sans); }
  .checks li[aria-current] { border-color: var(--color-accent); border-width: 2px; }
  .checks code { font: .76rem/1.5 var(--font-mono); background: transparent; padding: 0; }
  .checks span { grid-column: 2; }
  .failed { font-weight: 700; text-decoration: underline; text-underline-offset: .2rem; }
  .narration { min-height: 6em; margin: .75rem 0; font: .85rem/1.55 var(--font-sans); }
  .controls { display: flex; gap: .4rem; flex-wrap: wrap; align-items: center; font: .75rem var(--font-mono); }
  .model-note { margin: .7rem 0 0; color: var(--color-text-secondary); font: .72rem/1.5 var(--font-sans); }
  @media(max-width: 520px) { .keys-figure { padding: .7rem; } .relationship { gap: .3rem; } .node { padding: .4rem .2rem; } .checks li { grid-template-columns: 6.4rem 1fr; } .narration { min-height: 5.5em; } }
</style>
