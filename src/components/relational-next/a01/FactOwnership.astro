<figure class="ownership" data-a01-ownership aria-labelledby="a01-ownership-title">
  <figcaption id="a01-ownership-title"><span>Figure 2</span> What changes when Mina changes her name?</figcaption>
  <label class="storage-choice">Store current customer details
    <select data-layout><option value="copied">On each booking</option><option value="owned">Once, on the customer</option></select>
  </label>
  <p class="step-label" data-step-label>1 / 4 · Two bookings</p>
  <div class="facts">
    <section class="fact-card" data-customer><p class="card-title">Customer C7</p><p data-customer-name hidden>Name: <strong data-name>Mina Shah</strong></p><p class="ownership-label" data-customer-label>Name copied below</p></section>
    <section class="fact-card" data-session><p class="card-title">Session S21</p><p>Offer: <strong data-fee>€20.00</strong></p></section>
    <div class="relationship">C7 → bookings → sessions</div>
    <section class="fact-card" data-b11><p class="card-title">B11 · C7 / S21</p><p data-b11-name>Name: <strong>Mina Shah</strong></p><p>Agreed: <strong>€20.00</strong></p><p>Status: <strong data-status>booked</strong></p></section>
    <section class="fact-card" data-b12><p class="card-title">B12 · C7 / S22</p><p data-b12-name>Name: <strong>Mina Shah</strong></p><p>Agreed: <strong>€25.00</strong></p><p>Status: <strong>booked</strong></p></section>
  </div>
  <p class="explanation" data-explanation aria-live="polite">Two bookings repeat Mina’s current name. Both happen to agree.</p>
  <div class="controls" aria-label="Ownership figure playback">
    <button type="button" data-play>Play changes</button>
    <button type="button" data-back aria-disabled="true">Back</button>
    <button type="button" data-next>Next</button>
    <button type="button" data-reset>Reset</button>
  </div>
  <p class="model-note">Illustrative model, not SQL. Outline = changed row; dashed border = stale copy.</p>
  <details><summary>How to compare the designs</summary><p class="model-note">Switch storage at the same step to compare. The copied design deliberately misses B12 during correction. Play allows time to read each explanation and compare the cards; Next advances immediately.</p></details>
  <noscript><p>In the copied design, correcting B11 alone leaves B12 with the old current name. In the separated design, one customer update changes the name both booking screens read. Raising S21’s current fee leaves B11’s agreed €20.00 intact. Cancellation changes B11’s status and keeps its agreement.</p></noscript>
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-a01-ownership]')) {
    const select = root.querySelector<HTMLSelectElement>('[data-layout]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    let step = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const setText = (selector: string, value: string) => { root.querySelector(selector)!.textContent = value; };
    const stop = () => { clearTimeout(timer); timer = undefined; play.textContent = 'Play changes'; };
    function render() {
      const owned = select.value === 'owned';
      const corrected = step >= 1;
      root.querySelector<HTMLElement>('[data-customer-name]')!.hidden = !owned;
      setText('[data-name]', corrected && owned ? 'Mina Patel' : 'Mina Shah');
      setText('[data-customer-label]', owned ? 'Current name owner' : 'Name copied below');
      setText('[data-b11-name]', owned ? 'Name: read C7 above' : `Name: ${corrected ? 'Mina Patel' : 'Mina Shah'}`);
      setText('[data-b12-name]', owned ? 'Name: read C7 above' : 'Name: Mina Shah');
      setText('[data-fee]', step >= 2 ? '€22.00' : '€20.00');
      setText('[data-status]', step >= 3 ? 'cancelled' : 'booked');
      root.querySelector('[data-customer]')!.classList.toggle('changed', step === 1 && owned);
      root.querySelector('[data-b11]')!.classList.toggle('changed', (step === 1 && !owned) || step === 3);
      root.querySelector('[data-b12]')!.classList.toggle('inconsistent', corrected && !owned);
      root.querySelector('[data-session]')!.classList.toggle('changed', step === 2);
      setText('[data-step-label]', `${step + 1} / 4 · ${['Two bookings', 'Correct name', 'Change session fee', 'Cancel B11'][step]}`);
      const notes = owned ? [
        'Two bookings refer to C7. The current name has one owner, the customer row.',
        'One stored row changes: C7 now says Mina Patel. Both booking screens get the corrected current name by following C7.',
        'S21 now offers €22.00. B11 still records the €20.00 agreed earlier; it is a different fact.',
        'B11 is cancelled. It no longer occupies a place, but its €20.00 agreement remains available to reports.'
      ] : [
        'Two bookings repeat Mina’s current name. Both happen to agree.',
        'Only B11 was corrected. B12 still says Mina Shah. Two copies now disagree about one current fact.',
        'S21 now offers €22.00. B11 keeps its agreed €20.00. This difference is intended, unlike the conflicting current names.',
        'B11 is cancelled and retained. The forgotten current-name copy on B12 is still wrong; cancellation did not repair it.'
      ];
      setText('[data-explanation]', notes[step]);
      back.setAttribute('aria-disabled', String(step === 0));
      next.setAttribute('aria-disabled', String(step === 3));
    }
    function scheduleNext() {
      const words = root.querySelector('[data-explanation]')!.textContent!.trim().split(/\s+/).length;
      const hold = Math.max(7500, 3500 + words * 300);
      timer = setTimeout(() => {
        step++;
        render();
        if (step === 3) stop(); else scheduleNext();
      }, hold);
    }
    back.addEventListener('click', () => { stop(); step = Math.max(0, step - 1); render(); });
    next.addEventListener('click', () => { stop(); step = Math.min(3, step + 1); render(); });
    root.querySelector('[data-reset]')!.addEventListener('click', () => { stop(); step = 0; render(); });
    select.addEventListener('change', () => { stop(); render(); });
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      if (step === 3) step = 0;
      render();
      play.textContent = 'Pause';
      scheduleNext();
    });
    document.addEventListener('astro:before-swap', stop, { once: true });
    render();
  }
</script>

<style>
  .ownership { margin: 2rem 0; padding: 1rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface-alt); }
  figcaption { font: 1.1rem/1.4 var(--font-serif); color: var(--color-text); }
  figcaption span { font: .7rem var(--font-mono); text-transform: uppercase; margin-right: .6rem; color: var(--color-text-secondary); }
  .ownership .model-note { margin: .55rem 0; font: .76rem/1.5 var(--font-sans); color: var(--color-text-secondary); }
  .controls { display: flex; gap: .4rem; flex-wrap: wrap; align-items: center; margin: .6rem 0; }
  .storage-choice { margin: .8rem 0 .6rem; }
  .step-label { margin: .5rem 0; font: 600 .8rem/1.5 var(--font-sans); }
  label { display: grid; gap: .25rem; font: .8rem/1.4 var(--font-sans); }
  button, select { min-height: 2.4rem; padding: .4rem .6rem; border: 1px solid var(--color-rule-strong); border-radius: .2rem; background: var(--color-surface); color: var(--color-text); font: .8rem/1.3 var(--font-sans); }
  button { cursor: pointer; }
  button[aria-disabled="true"] { opacity: .45; cursor: default; }
  button:focus-visible, select:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .facts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .5rem; margin: .5rem 0; }
  .fact-card { margin: 0; padding: .65rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface); min-width: 0; }
  .fact-card .card-title { margin: 0 0 .35rem; font: 600 .8rem/1.4 var(--font-sans); }
  .fact-card p { margin: .2rem 0; font: .78rem/1.45 var(--font-sans); overflow-wrap: anywhere; }
  .ownership-label { color: var(--color-text-secondary); }
  .relationship { grid-column: 1/-1; text-align: center; font: .75rem/1.5 var(--font-mono); }
  .changed { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .inconsistent { border-style: dashed; border-width: 2px; }
  .explanation { border-top: 1px solid var(--color-rule-strong); margin: .65rem 0; padding-top: .65rem; min-height: 5em; font: .84rem/1.5 var(--font-sans); }
  details { margin: .5rem 0 0; font: .75rem/1.5 var(--font-sans); }
  @media(max-width: 520px) { .ownership { padding: .7rem; } .fact-card { padding: .45rem; } .controls { gap: .3rem; } button { padding: .4rem .45rem; font-size: .75rem; } }
</style>
