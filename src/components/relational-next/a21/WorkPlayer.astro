---
import { scenes } from './models.mjs';
const {scene, number} = Astro.props;
const model = scenes[scene];
const variants = [0,1].map(v=>model.steps(v));
const first=variants[0][0];
---
<figure class="query-work" data-query-work data-scene={scene} aria-labelledby={`a21-${scene}-title`}>
 <figcaption id={`a21-${scene}-title`}><span>Figure {number}</span>{model.title}</figcaption>
 <p class="model">Illustrative model · order and work, not elapsed time</p>
 <div class="choices" role="group" aria-label={`Comparison for figure ${number}`}>
  {model.choices.map((s,i)=><button type="button" data-choice={i} aria-pressed={i===0}>{s}</button>)}
 </div>
 {scene==='multiply'&&<label class="large"><input type="checkbox" data-large/> Increase from 3 to 12 items</label>}
 <div class="work-board">
  <p class="step-title" data-title>{first.title}</p>
  <pre><code data-code>{first.code}</code></pre>
  <div class="panels">
   <div class="work-panel"><p class="panel-title">Database result at this step</p><div class="chips" data-rows>{first.rows.map(s=><span>{s}</span>)}</div></div>
   <div class="work-panel"><p class="panel-title">Application state</p><ul data-objects>{first.objects.map(s=><li>{s}</li>)}</ul></div>
  </div>
  <dl class="counts">{['Statements','SQL rows returned so far','Entity references now'].map((s,i)=><div><dt>{s}</dt><dd data-count={i}>{first.count[i]}</dd></div>)}</dl>
  <p class="note" data-note aria-live="polite">{first.note}</p>
 </div>
 <div class="controls" role="group" aria-label={`Playback for figure ${number}`}><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-play>Play</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><output data-position>Step 1 of {variants[0].length}</output></div>
 <details><summary>Read every step</summary>{model.choices.map((choice,v)=><div><p><strong>{choice}</strong></p><ol data-transcript={v}>{variants[v].map(s=><li>{s.title}. {s.code}. Database: {s.rows.join('; ')}. Application: {s.objects.join('; ')}. Statements: {s.count[0]}; SQL rows returned: {s.count[1]}; entity references: {s.count[2]}. {s.note}</li>)}</ol></div>)}</details>
</figure>
<script>
 import {scenes, holdMilliseconds} from './models.mjs';
 document.querySelectorAll<HTMLElement>('[data-query-work]').forEach(root=>{
  if(root.dataset.ready) return;
  root.dataset.ready='true';
  const model=scenes[root.dataset.scene!];
  let variant=0, step=0, large=false, timer:ReturnType<typeof setTimeout>|undefined;
  const el=(s:string)=>root.querySelector<HTMLElement>(s)!;
  const steps=()=>model.steps(variant,large);
  const stop=()=>{clearTimeout(timer);timer=undefined;el('[data-play]').textContent='Play';};
  const list=(selector:string,values:string[],tag:string)=>{const target=el(selector);target.replaceChildren(...values.map(value=>{const child=document.createElement(tag);child.textContent=value;return child;}));};
  const render=()=>{
   const rows=steps(); step=Math.min(step,rows.length-1); const s=rows[step];
   el('[data-title]').textContent=s.title; el('[data-code]').textContent=s.code;
   list('[data-rows]',s.rows,'span');list('[data-objects]',s.objects,'li');
   s.count.forEach((n:number,i:number)=>el(`[data-count="${i}"]`).textContent=String(n));
   el('[data-note]').textContent=s.note;
   [0,1].forEach(v=>list(`[data-transcript="${v}"]`,model.steps(v,large).map(t=>`${t.title}. ${t.code}. Database: ${t.rows.join('; ')}. Application: ${t.objects.join('; ')}. Statements: ${t.count[0]}; SQL rows returned: ${t.count[1]}; entity references: ${t.count[2]}. ${t.note}`),'li'));
   el('[data-position]').textContent=`Step ${step+1} of ${rows.length}`;
   el('[data-back]').setAttribute('aria-disabled',String(step===0));
   el('[data-next]').setAttribute('aria-disabled',String(step===rows.length-1));
   root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((b,i)=>b.setAttribute('aria-pressed',String(i===variant)));
  };
  const play=()=>{render(); if(step===steps().length-1){stop();return;}el('[data-play]').textContent='Pause';timer=setTimeout(()=>{step++;play();},holdMilliseconds(steps()[step]));};
  root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.addEventListener('click',()=>{stop();variant=Number(b.dataset.choice);step=0;render();}));
  root.querySelector<HTMLInputElement>('[data-large]')?.addEventListener('change',event=>{stop();large=(event.target as HTMLInputElement).checked;render();});
  el('[data-back]').addEventListener('click',()=>{stop();step=Math.max(0,step-1);render();});
  el('[data-next]').addEventListener('click',()=>{stop();step=Math.min(steps().length-1,step+1);render();});
  el('[data-reset]').addEventListener('click',()=>{stop();step=0;render();});
  el('[data-play]').addEventListener('click',()=>{if(timer){stop();return;}if(step===steps().length-1)step=0;play();});
  root.addEventListener('focusout',event=>{if(event.relatedTarget&&!root.contains(event.relatedTarget as Node))stop();});
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  render();
 });
</script>
<style>
 .query-work{margin:1.8rem 0;border:1px solid var(--color-rule);border-radius:.5rem;padding:1rem;background:var(--color-surface);min-width:0}
 figcaption{font-weight:650;line-height:1.5}figcaption>span{display:block;font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--color-text-secondary)}
 .model{font-size:.8rem;color:var(--color-text-secondary);margin:.4rem 0 .8rem}.choices,.controls{display:flex;flex-wrap:wrap;gap:.45rem}
 button{font:inherit;font-size:.85rem;min-height:44px;padding:.5rem .7rem;color:var(--color-text);background:var(--color-surface-alt);border:1px solid var(--color-rule);border-radius:.3rem;cursor:pointer}button[aria-pressed=true]{border-color:var(--color-text);box-shadow:inset 0 -3px var(--color-text)}button[aria-disabled=true]{opacity:.5}button:focus-visible,input:focus-visible{outline:2px solid var(--color-text);outline-offset:3px}
 .large{display:flex;align-items:center;gap:.5rem;font-size:.85rem;min-height:44px;margin:.5rem 0}.large input{width:1.1rem;height:1.1rem}
 .work-board{margin:1rem 0}.step-title{font-weight:650;margin:.5rem 0}pre{padding:.7rem;overflow:auto;max-width:100%;border:1px solid var(--color-rule);font:.76rem/1.6 var(--font-mono);background:var(--color-surface-alt)}pre code{font:inherit;padding:0;background:none}
 .panels{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin:.7rem 0}.work-panel{min-width:0;border:1px solid var(--color-rule);padding:.65rem;background:var(--color-surface-alt)}.panel-title{font-size:.78rem;font-weight:650;margin:0 0 .5rem}.chips{display:flex;flex-wrap:wrap;gap:.35rem;align-content:start}.chips :global(span){font:.75rem/1.5 var(--font-mono);border:1px solid var(--color-rule);padding:.3rem;overflow-wrap:anywhere}.work-panel ul{font-size:.85rem;line-height:1.6;margin:0;padding-left:1.1rem}.work-panel :global(li){margin:.2rem 0}
 .counts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem;margin:.8rem 0}.counts>div{border-top:2px solid var(--color-text);padding-top:.4rem}.counts dt{font-size:.7rem;line-height:1.4;color:var(--color-text-secondary)}.counts dd{margin:.3rem 0 0;font-size:1.3rem;font-weight:650}.note{font-size:.9rem;line-height:1.7;margin:.7rem 0}.controls output{align-self:center;font-size:.8rem}details{margin-top:.9rem;font-size:.85rem}summary{cursor:pointer;min-height:36px}details p{margin:.5rem 0}details :global(li){margin:.5rem 0}
 @media(max-width:560px){.query-work{padding:.7rem}.panels{grid-template-columns:1fr}.work-panel{margin:0}.choices button{flex:1 1 140px}.controls button{flex:1}.controls output{flex-basis:100%}pre{font-size:.7rem}.counts dt{font-size:.68rem}}
</style>
