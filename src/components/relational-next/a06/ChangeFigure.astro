---
import { scenes, getFrame } from './model.mjs';
interface Props { scene: 'evolution' | 'race' | 'move'; number: number; }
const { scene, number } = Astro.props;
const config = scenes[scene];
const mode = config.options[0]?.[0] || '';
const first = getFrame(scene, mode, 0);
---
<figure class="change-figure" data-change-figure data-scene={scene}>
  <figcaption><span>Figure {number}</span><strong>{config.title}</strong></figcaption>
  {config.options.length > 0 && <label class="choice">{scene === 'race' ? 'Worker write' : 'Cutover'} <select aria-label={scene === 'race' ? 'Worker write' : 'Cutover'}>{config.options.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>}
  <ol class="track" aria-label="Stages">{config.steps.map((title, i) => <li data-mark data-current={i === 0 ? '' : undefined}><span>{i + 1}</span>{title}</li>)}</ol>
  <p class="action" data-action>{first.action}</p>
  <div class="comparison">
    {(['left', 'right'] as const).map(side => <div class="store" data-side={side} data-active={first.active === side ? '' : undefined}>
      <p class="store-label" data-label>{first[side].label}</p>
      <ul data-rows>{first[side].rows.map(row => <li><span class="identity">{row.id}</span><span><b>{row.value}</b><small>{row.note}</small></span></li>)}</ul>
    </div>)}
  </div>
  <p class="explanation" data-explanation aria-live="polite" aria-atomic="true">{first.note}</p>
  <p class="gate" data-gate>{first.gate}</p>
  <div class="transport" role="group" aria-label={`Figure ${number} playback`}>
    <button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-count>1 / {config.steps.length}</span>
  </div>
  <p class="model-note">Illustrative schedule. Play allows reading time plus 4 seconds to compare the two sides; use Next to read at your own pace. The figure does not run a database.</p>
  <noscript><p>JavaScript enables the comparison. The complete sequence is described in the surrounding article.</p></noscript>
</figure>
<script>
  import { scenes, getFrame } from './model.mjs';
  for (const figure of document.querySelectorAll<HTMLElement>('[data-change-figure]')) {
    if (figure.dataset.ready) continue;
    figure.dataset.ready = 'true';
    const scene = figure.dataset.scene as keyof typeof scenes;
    const config = scenes[scene];
    let step = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const select = figure.querySelector('select');
    const play = figure.querySelector<HTMLButtonElement>('[data-play]')!;
    const back = figure.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = figure.querySelector<HTMLButtonElement>('[data-next]')!;
    const stop = () => { clearTimeout(timer); timer = undefined; play.textContent = 'Play'; };
    const render = () => {
      const current = getFrame(scene, select?.value || '', step);
      figure.querySelector('[data-action]')!.textContent = current.action;
      figure.querySelector('[data-explanation]')!.textContent = current.note;
      figure.querySelector('[data-gate]')!.textContent = current.gate;
      figure.querySelector('[data-count]')!.textContent = `${step + 1} / ${config.steps.length}`;
      for (const side of ['left', 'right'] as const) {
        const panel = figure.querySelector<HTMLElement>(`[data-side="${side}"]`)!;
        panel.toggleAttribute('data-active', current.active === side);
        panel.querySelector('[data-label]')!.textContent = current[side].label;
        const rows = current[side].rows.map(row => {
          const li = document.createElement('li');
          const id = document.createElement('span'); id.className = 'identity'; id.textContent = row.id;
          const values = document.createElement('span');
          const value = document.createElement('b'); value.textContent = row.value;
          const note = document.createElement('small'); note.textContent = row.note;
          values.append(value, note); li.append(id, values); return li;
        });
        panel.querySelector('[data-rows]')!.replaceChildren(...rows);
      }
      figure.querySelectorAll('[data-mark]').forEach((mark, i) => { mark.toggleAttribute('data-current', i === step); mark.setAttribute('aria-current', i === step ? 'step' : 'false'); });
      back.setAttribute('aria-disabled', String(step === 0));
      next.setAttribute('aria-disabled', String(step === config.steps.length - 1));
      play.setAttribute('aria-disabled', String(step === config.steps.length - 1));
    };
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      if (step === config.steps.length - 1) return;
      play.textContent = 'Pause';
      const schedule = () => {
        const current = getFrame(scene, select?.value || '', step);
        const words = `${current.action} ${current.note} ${current.gate}`.trim().split(/\s+/).length;
        const hold = Math.max(8500, words * 300 + 4000);
        timer = setTimeout(() => {
          step++; render();
          if (step === config.steps.length - 1) stop(); else schedule();
        }, hold);
      };
      schedule();
    });
    back.addEventListener('click', () => { stop(); step = Math.max(0, step - 1); render(); });
    next.addEventListener('click', () => { stop(); step = Math.min(config.steps.length - 1, step + 1); render(); });
    figure.querySelector('[data-reset]')!.addEventListener('click', () => { stop(); step = 0; render(); });
    select?.addEventListener('change', () => { stop(); render(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    document.addEventListener('astro:before-swap', stop, { once: true });
    render();
  }
</script>
<style>
  .change-figure{margin:2rem 0;padding:1rem;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);font-size:.88rem;}
  figcaption{display:flex;gap:.4rem;flex-direction:column;margin-bottom:1rem;}figcaption span,.model-note{color:var(--color-text-secondary);font-size:.78rem;}figcaption strong{font-size:1.05rem;}
  .choice{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;margin-bottom:1rem;}select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .65rem;}
  button{cursor:pointer;}button[aria-disabled="true"]{opacity:.55;cursor:default;}button:focus-visible,select:focus-visible{outline:3px solid var(--color-accent);outline-offset:3px;}
  .track{display:flex;gap:.35rem;list-style:none;padding:0;margin:1rem 0;flex-wrap:wrap;}.track li{display:flex;gap:.25rem;align-items:center;font-size:.72rem;padding:.25rem;color:var(--color-text-secondary);border-bottom:2px solid transparent;}.track li[data-current]{border-color:var(--color-accent);color:var(--color-text);font-weight:700;}.track span{font-variant-numeric:tabular-nums;}
  .action{font-weight:700;min-height:2.6em;}.comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;}.store{min-width:0;border:2px solid var(--color-rule);padding:.7rem;border-radius:.4rem;background:var(--color-surface);}.store[data-active]{border-color:var(--color-accent);}.store-label{font-weight:700;margin:0 0 .7rem!important;}.store ul{list-style:none;padding:0;margin:0;}.store :global(li){display:flex;gap:.5rem;border-top:1px solid var(--color-rule);padding:.6rem 0;line-height:1.5;}.store :global(.identity){font-family:var(--font-mono);color:var(--color-text-secondary);min-width:2.6rem;}.store :global(b){font-weight:500;overflow-wrap:anywhere;}.store :global(small){display:block;color:var(--color-text-secondary);font-size:.74rem;}.explanation{min-height:5em;line-height:1.65;}.gate{border-left:3px solid var(--color-accent);padding:.5rem .75rem;font-weight:600;}.transport{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;}.transport span{font-variant-numeric:tabular-nums;margin-left:auto;}.model-note{margin-bottom:0!important;line-height:1.5;}
  @media(max-width:600px){.change-figure{padding:.75rem;}.comparison{grid-template-columns:1fr;}.store{padding:.65rem;}.explanation{min-height:0;}.track{gap:.2rem;}.action{min-height:0;}button{min-height:2.5rem;}}
</style>
