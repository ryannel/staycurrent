---
import { figures, defaults, frame, type Kind } from './model';
import '../../../styles/explorables.css';
interface Props { kind: Kind; number: number }
const { kind, number } = Astro.props;
const def = figures[kind], values = defaults(kind), last = frame(kind, values, 3);
const id = `a10-${kind}`;
---
<constraint-figure class="visual-essay" data-kind={kind}>
  <figure aria-labelledby={`${id}-caption`}>
    <figcaption id={`${id}-caption`}>Figure {number}. {def.title}</figcaption>
    <div class="parameters" data-controls>
      {def.params.map(param => <label>{param.label}<select data-param={param.key}>
        {param.options.map(([value,label]) => <option value={value} selected={value === param.initial}>{label}</option>)}
      </select></label>)}
    </div>
    <div class="board">
      <div class="cards" data-cards>{last.cards.map(card => <div class="card" data-tone={card.tone}><span>{card.label}</span><strong>{card.value}</strong></div>)}</div>
      <div class="bars" data-bars hidden={!last.bars}>
        {last.bars?.map(bar => <div class="lane"><span>{bar.label}</span><div class="track"><div class="bar" data-tone={bar.tone} style={`left:${(bar.start-10)/3*100}%;width:${(bar.end-bar.start)/3*100}%`}></div></div></div>)}
        <p class="axis">10:00 <span>11:00</span><span>12:00</span><span>13:00</span></p>
      </div>
      <ol class="gates" data-gates>{last.gates.map(gate => <li data-tone={gate.tone}><strong>{gate.label}</strong><span>{gate.answer}</span></li>)}</ol>
      <p class="result" data-result data-bad={last.bad}>{last.result}</p>
    </div>
    <p class="narration" data-note aria-live="polite">{last.note}</p>
    <div class="transport" data-controls role="group" aria-label={`Playback for figure ${number}`}>
      <button type="button" data-action="play">Play</button>
      <button type="button" data-action="back" aria-disabled="false">Back</button>
      <button type="button" data-action="next" aria-disabled="true">Next</button>
      <label>Step <input type="range" min="0" max="3" value="3" step="1" data-step aria-label={`Figure ${number} step`} /></label>
      <span data-count>4 / 4</span>
      <button type="button" data-action="reset">Reset</button>
    </div>
    <details><summary>Read the default sequence as text</summary><ol>{[0,1,2,3].map(step => <li>{frame(kind,values,step).note}</li>)}</ol></details>
    <p class="model-note">Illustrative model of the stated rules. The figure does not run SQL or show an observed concurrent execution.</p>
  </figure>
</constraint-figure>
<script>
  import { figures, defaults, frame, type Kind } from './model';
  const escape = (text: string) => text.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
  class ConstraintFigure extends HTMLElement {
    timer = 0;
    playing = false;
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const kind = this.dataset.kind as Kind;
      const q = <T extends HTMLElement>(selector: string) => this.querySelector<T>(selector)!;
      let values = defaults(kind), step = 0;
      const stop = () => { this.playing = false; clearTimeout(this.timer); q<HTMLButtonElement>('[data-action="play"]').textContent = step === 3 ? 'Replay' : 'Play'; q('[data-note]').setAttribute('aria-live','polite'); };
      const render = () => {
        const view = frame(kind,values,step);
        q('[data-cards]').innerHTML = view.cards.map(c => `<div class="card" data-tone="${c.tone}"><span>${escape(c.label)}</span><strong>${escape(c.value)}</strong></div>`).join('');
        q('[data-gates]').innerHTML = view.gates.map(g => `<li data-tone="${g.tone}"><strong>${escape(g.label)}</strong><span>${escape(g.answer)}</span></li>`).join('');
        const bars = q('[data-bars]');
        bars.hidden = !view.bars;
        if (view.bars) {
          const lanes = [...bars.querySelectorAll<HTMLElement>('.lane')];
          view.bars.forEach((bar,index) => {
            lanes[index].querySelector('span')!.textContent=bar.label;
            const mark=lanes[index].querySelector<HTMLElement>('.bar')!;
            mark.dataset.tone=bar.tone;
            mark.style.left=`${(bar.start-10)/3*100}%`;
            mark.style.width=`${(bar.end-bar.start)/3*100}%`;
          });
        }
        q('[data-result]').textContent = view.result;
        q('[data-result]').dataset.bad = String(view.bad);
        q('[data-note]').textContent = view.note;
        q<HTMLInputElement>('[data-step]').value = String(step);
        q('[data-step]').setAttribute('aria-valuetext',`Step ${step+1} of 4`);
        q('[data-count]').textContent = `${step+1} / 4`;
        // Keep endpoint buttons focusable so repeated keyboard activation never loses focus.
        q('[data-action="back"]').setAttribute('aria-disabled',String(step===0));
        q('[data-action="next"]').setAttribute('aria-disabled',String(step===3));
        q('[data-action="play"]').textContent = this.playing ? 'Pause' : step === 3 ? 'Replay' : 'Play';
      };
      const schedule = () => {
        const text = `${q('.board').innerText} ${q('[data-note]').innerText}`;
        const words = text.trim().split(/\s+/).length;
        // Read the visible comparison and narration, then inspect the changed diagram.
        this.timer = window.setTimeout(() => {
          if (step === 3) { stop(); return; }
          step++; render(); schedule();
        }, Math.max(6000,words*(60000/180)+3000));
      };
      this.addEventListener('click', event => {
        const button = (event.target as Element).closest<HTMLButtonElement>('button[data-action]');
        if (!button) return;
        const action = button.dataset.action;
        if (action === 'play') {
          if (this.playing) { stop(); return; }
          if (step === 3) step=0;
          this.playing=true;
          q('[data-note]').setAttribute('aria-live','off'); render(); schedule(); return;
        }
        stop();
        if (action === 'next') step = Math.min(3,step+1);
        if (action === 'back') step = Math.max(0,step-1);
        if (action === 'reset') {
          values=defaults(kind); step=0;
          for (const select of this.querySelectorAll<HTMLSelectElement>('select[data-param]')) select.value=values[select.dataset.param!];
        }
        render();
      });
      this.addEventListener('change',event => {
        const target = event.target as HTMLSelectElement;
        if (!target.matches('select[data-param]')) return;
        stop(); values={...values,[target.dataset.param!]:target.value}; render();
      });
      q<HTMLInputElement>('[data-step]').addEventListener('input',event => { stop(); step=Number((event.target as HTMLInputElement).value); render(); });
      document.addEventListener('visibilitychange',() => { if (document.hidden) stop(); });
      new IntersectionObserver(entries => { if (!entries[0].isIntersecting) stop(); }).observe(this);
      render();
    }
    disconnectedCallback() { clearTimeout(this.timer); }
  }
  if (!customElements.get('constraint-figure')) customElements.define('constraint-figure',ConstraintFigure);
</script>
<style is:global>
  constraint-figure { display:block; margin:2rem 0; }
  constraint-figure {
  figure { margin:0; border:1px solid var(--color-rule); padding:clamp(.7rem,2vw,1.2rem); background:var(--color-surface-alt); }
  figcaption { margin:0 0 1rem; font:600 .95rem/1.5 var(--font-sans); color:var(--color-text); }
  [data-controls] { display:none; }
  &[data-ready] [data-controls] { display:flex; flex-wrap:wrap; align-items:center; gap:.65rem; }
  .parameters { margin-bottom:1rem; }
  label { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; font:.8rem/1.5 var(--font-sans); min-width:0; }
  select,button { color:var(--color-text); background:var(--color-surface); border:1px solid var(--color-rule-strong); border-radius:3px; padding:.5rem .65rem; font:.8rem/1.4 var(--font-sans); max-width:100%; }
  button { cursor:pointer; min-height:2.5rem; }
  button[aria-disabled="true"] { opacity:.55; cursor:default; }
  button:focus-visible, select:focus-visible, input:focus-visible { outline:2px solid var(--blue); outline-offset:3px; }
  .cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; }
  .card { border:1px solid var(--color-rule-strong); padding:.8rem; background:var(--color-surface); min-width:0; transition:border-color .4s,opacity .4s; }
  .card span,.card strong { display:block; overflow-wrap:anywhere; }
  .card span { font:.75rem/1.5 var(--font-sans); color:var(--color-text-secondary); }
  .card strong { font:600 .9rem/1.6 var(--font-sans); margin-top:.35rem; }
  .gates { list-style:none; display:grid; grid-template-columns:repeat(auto-fit,minmax(9rem,1fr)); gap:.6rem; margin:1rem 0; padding:0; }
  .gates li { border-top:3px solid var(--color-rule-strong); padding:.5rem; background:var(--color-surface); font:.78rem/1.5 var(--font-sans); margin:0; }
  .gates strong,.gates span { display:block; }
  .gates span { color:var(--color-text-secondary); margin-top:.3rem; }
  [data-tone="pass"] { border-color:var(--blue); }
  [data-tone="fail"] { border-color:var(--coral); }
  [data-tone="outside"] { border-style:dashed; }
  .result { font:600 .85rem/1.5 var(--font-sans); border-left:3px solid var(--blue); padding:.6rem .8rem; margin:.7rem 0 0; }
  .result[data-bad="true"] { border-color:var(--coral); }
  .narration { font:.88rem/1.65 var(--font-sans); min-height:5.8em; margin:1rem 0; }
  .transport { border-top:1px solid var(--color-rule); padding-top:.8rem; font:.75rem/1.5 var(--font-sans); }
  .transport label { flex:1 1 7rem; }
  input { width:6rem; max-width:100%; flex:1; accent-color:var(--blue); }
  details { font:.8rem/1.6 var(--font-sans); margin-top:1rem; }
  .model-note { font:.72rem/1.5 var(--font-sans); color:var(--color-text-secondary); margin:.8rem 0 0; }
  .bars { margin-top:1rem; }
  .bars[hidden] { display:none; }
  .lane { margin:.8rem 0; }
  .lane > span { display:block; font:.75rem/1.5 var(--font-mono); margin-bottom:.3rem; }
  .track { position:relative; height:1.7rem; background:var(--color-surface); border:1px solid var(--color-rule); background-image:linear-gradient(to right,transparent calc(100% - 1px),var(--color-rule) 1px); background-size:33.333% 100%; }
  .bar { transition:left .7s, width .7s, background-color .5s, border-color .5s; position:absolute; height:100%; background:color-mix(in srgb,var(--blue) 25%,var(--color-surface)); border:2px solid var(--blue); border-right-style:dashed; box-sizing:border-box; }
  .bar[data-tone="fail"] { border-color:var(--coral); background:color-mix(in srgb,var(--coral) 25%,var(--color-surface)); }
  .bar[data-tone="outside"] { background:var(--color-surface); border-style:dashed; }
  .axis { display:flex; justify-content:space-between; margin:.1rem 0; font:.68rem/1.4 var(--font-mono); color:var(--color-text-secondary); }
  @media(max-width:520px) { .cards { grid-template-columns:1fr; } .gates { grid-template-columns:1fr; } .gates li { display:flex; justify-content:space-between; gap:.7rem; } .gates span { margin:0; text-align:right; } .narration { min-height:8em; } .parameters label { width:100%; } select { flex:1; } }
  @media(prefers-reduced-motion:reduce) { .card,.bar { transition:none; } }
  }
</style>
