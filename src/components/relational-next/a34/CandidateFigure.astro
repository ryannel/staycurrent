---
import { choices, titles, captions, frames, type Scene } from './model';
interface Props { scene: Scene; number: number }
const { scene, number } = Astro.props;
const variant = choices[scene][0].value;
const initial = frames(scene, variant)[0];
---
<figure class="candidate" data-candidate={scene} aria-labelledby={`a34-figure-${number}`}>
 <figcaption id={`a34-figure-${number}`}><span>Figure {number} · explanatory model</span><strong>{titles[scene]}</strong></figcaption>
 <div class="settings">
  <label>Compare <select data-variant aria-label={`Figure ${number} comparison`}>{choices[scene].map(c => <option value={c.value}>{c.label}</option>)}</select></label>
  {scene === 'budget' && <label>RTT allowance <select data-rtt aria-label="Coordination round-trip allowance"><option value="10">10 ms</option><option value="40" selected>40 ms</option><option value="100">100 ms</option></select></label>}
 </div>
 <p class="phase" data-phase>{initial.title}</p>
 <div class="vote-map" data-map hidden={scene !== 'topology'} aria-label="Voting copies by region"></div>
 <div class="route" data-route hidden={scene !== 'locality'} aria-label="Operation homes"></div>
 <div class="meter" data-meter hidden={scene !== 'budget'} aria-label="Illustrative elapsed time against the deadline"></div>
 <div class="panels" data-panels>{initial.panels.map(p => <div class="panel"><p class="label">{p.label}</p><ul>{p.lines.map(line => <li>{line}</li>)}</ul></div>)}</div>
 <p class="result" data-result>{initial.result}</p>
 <p class="narration" data-note aria-live="polite">{initial.note}</p>
 <div class="controls" role="group" aria-label={`Figure ${number} playback`}>
  <button type="button" data-play aria-pressed="false">Play</button>
  <button type="button" data-back>Back</button>
  <button type="button" data-next>Next</button>
  <button type="button" data-reset>Reset</button>
  <label>Step <input data-step aria-label={`Figure ${number} step`} type="range" min="0" max="3" value="0" step="1" /></label>
  <output data-position>1 / 4</output>
 </div>
 <p class="caption">{captions[scene]}</p>
 <noscript>These controls need JavaScript. The opening model state is shown; the surrounding article explains the comparison and its limits.</noscript>
</figure>
<script>
 import { frames, type Scene } from './model';
 document.querySelectorAll<HTMLElement>('[data-candidate]').forEach(root => {
  const scene = root.dataset.candidate as Scene;
  const variant = root.querySelector<HTMLSelectElement>('[data-variant]')!;
  const rtt = root.querySelector<HTMLSelectElement>('[data-rtt]');
  const slider = root.querySelector<HTMLInputElement>('[data-step]')!;
  const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
  let step = 0;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let playing = false;
  const stop = () => { if (timer) clearTimeout(timer); timer = undefined; playing = false; play.textContent = 'Play'; play.setAttribute('aria-pressed', 'false'); };
  const render = () => {
   const states = frames(scene, variant.value, Number(rtt?.value || 40));
   step = Math.min(Math.max(0, step), states.length - 1);
   const state = states[step];
   root.querySelector('[data-phase]')!.textContent = state.title;
   const panels = root.querySelector('[data-panels]')!;
   panels.replaceChildren(...state.panels.map(panel => {
    const box = document.createElement('div'); box.className = 'panel';
    const label = document.createElement('p'); label.className = 'label'; label.textContent = panel.label;
    const list = document.createElement('ul');
    panel.lines.forEach(line => { const item = document.createElement('li'); item.textContent = line; list.append(item); });
    box.append(label, list); return box;
   }));
   if (scene === 'locality') {
    const route = root.querySelector<HTMLElement>('[data-route]')!;
    route.replaceChildren(...['Gateway · Ireland', 'Stock · ' + (variant.value === 'remote' ? 'Germany' : 'Ireland'), 'Reservation · Ireland'].flatMap((label, i) => {
     const item = document.createElement('span'); item.textContent = label; item.className = 'route-node';
     item.dataset.active = String(step >= i);
     if (i === 2) return [item];
     const arrow = document.createElement('span'); arrow.className = 'route-arrow'; arrow.textContent = '→'; arrow.setAttribute('aria-hidden', 'true'); return [item, arrow];
    }));
   }
   if (scene === 'budget') {
    const meter = root.querySelector<HTMLElement>('[data-meter]')!;
    const coordination = Number(rtt?.value || 40) * 2;
    const pieces = step === 0 ? [] : [{ value: 20, label: 'Admission' }, { value: variant.value === 'hot' ? 170 : 10, label: 'Queue' }];
    if (step >= 2) pieces.push({ value: coordination, label: 'Network' }, { value: 30, label: 'Other' });
    if (step >= 3) pieces.push({ value: 20, label: 'Backoff' }, { value: coordination, label: 'Retry network' }, { value: 30, label: 'Retry other' });
    const rail = document.createElement('div'); rail.className = 'rail'; rail.setAttribute('aria-hidden', 'true');
    const gate = document.createElement('span'); gate.className = 'deadline'; rail.append(gate);
    pieces.forEach((piece, i) => { const bar = document.createElement('span'); bar.className = 'bar bar-' + i; bar.style.width = (piece.value / 800 * 100) + '%'; rail.append(bar); });
    const axis = document.createElement('p'); axis.className = 'axis'; axis.textContent = '0 ms · deadline marker at 300 ms · full scale 800 ms';
    const legend = document.createElement('p'); legend.className = 'legend'; legend.textContent = pieces.length ? pieces.map(piece => piece.label + ': ' + piece.value + ' ms').join(' + ') : 'No request time spent yet.';
    meter.replaceChildren(rail, axis, legend);
   }
   root.querySelector('[data-result]')!.textContent = state.result;
   root.querySelector('[data-note]')!.textContent = state.note;
   if (scene === 'topology') {
    const map = root.querySelector<HTMLElement>('[data-map]')!;
    const regional = variant.value === 'region';
    const counts = regional ? [2, 2, 1] : [3, 0, 0];
    let id = 0;
    map.replaceChildren(...['Ireland', 'Germany', 'France'].map((name, index) => {
     const region = document.createElement('div'); region.className = 'map-region';
     const label = document.createElement('p'); label.textContent = name; region.append(label);
     const copies = document.createElement('div'); copies.className = 'copies';
     for (let n = 0; n < (counts[index] || 1); n++) {
      const copy = document.createElement('span');
      const voter = counts[index] > 0; const unavailable = index === 0 && step >= 2;
      copy.className = 'copy' + (voter ? '' : ' nonvoter') + (unavailable ? ' unavailable' : '');
      copy.textContent = voter ? 'V' + ++id : 'N';
      copy.setAttribute('aria-label', voter ? copy.textContent + (unavailable ? ', unavailable or returning' : ', reachable voter') : 'Non-voting copy');
      copies.append(copy);
     }
     region.append(copies);
     const status = document.createElement('small');
     status.textContent = index === 0 && step >= 2 ? (step === 2 ? 'Unavailable ×' : 'Returning · not yet verified') : (counts[index] || 0) + ' reachable votes';
     region.append(status); return region;
    }));
   }
   root.querySelector('[data-position]')!.textContent = `${step + 1} / ${states.length}`;
   slider.max = String(states.length - 1); slider.value = String(step);
  };
  const schedule = () => {
   // Budget every visible panel, result, control, caption and narration, plus inspection time.
   const words = root.innerText.trim().split(/\s+/).length;
   timer = setTimeout(() => { if (step >= 3) { stop(); return; } step++; render(); schedule(); }, Math.max(7000, words / 3.3 * 1000 + 5000));
  };
  play.addEventListener('click', () => { if (playing) { stop(); return; } if (step === 3) { step = 0; render(); } playing = true; play.textContent = 'Pause'; play.setAttribute('aria-pressed', 'true'); schedule(); });
  const move = (change: number) => { stop(); step += change; render(); };
  root.querySelector('[data-back]')!.addEventListener('click', () => move(-1));
  root.querySelector('[data-next]')!.addEventListener('click', () => move(1));
  root.querySelector('[data-reset]')!.addEventListener('click', () => { stop(); step = 0; render(); });
  slider.addEventListener('input', () => { stop(); step = Number(slider.value); render(); });
  variant.addEventListener('change', () => { stop(); render(); });
  rtt?.addEventListener('change', () => { stop(); render(); });
  render();
  document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
 });
</script>
<style>
 .candidate{margin:2rem 0;border:1px solid var(--color-rule);border-radius:.6rem;padding:clamp(.8rem,3vw,1.3rem);background:var(--color-surface-alt);font-size:.9rem;overflow:hidden}
 figcaption{display:grid;gap:.35rem;margin-bottom:1rem}figcaption span{font: .68rem var(--font-mono);text-transform:uppercase;color:var(--color-text-secondary)}figcaption strong{font-size:1.1rem}
 .settings,.controls{display:flex;gap:.65rem;align-items:center;flex-wrap:wrap}.settings label{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap}.settings{margin-bottom:1rem}
 select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .6rem;min-height:44px;max-width:100%}button{cursor:pointer}button:hover{border-color:var(--color-text)}
 .phase{font-weight:650;margin:1rem 0 .65rem}.panels{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr));gap:.7rem}.panel{border:1px solid var(--color-rule);background:var(--color-surface);padding:.75rem;border-radius:.35rem;min-width:0}.panel .label{font-weight:650;margin:0 0 .6rem}.panel ul{margin:0;padding-left:1.05rem}.panel li{margin:.35rem 0;overflow-wrap:anywhere;font-size:.85rem;line-height:1.55}
 .candidate :global(.map-region){border:1px solid var(--color-rule);border-radius:.4rem;padding:.8rem;display:grid;gap:.6rem;text-align:center;background:var(--color-surface)}.candidate :global(.map-region p){margin:0;font-weight:650}.candidate :global(.map-region small){font-size:.72rem}.vote-map{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem;margin:1rem 0}.vote-map[hidden]{display:none}.candidate :global(.copies){display:flex;gap:.4rem;justify-content:center;flex-wrap:wrap}.candidate :global(.copy){border:2px solid var(--color-text);border-radius:50%;width:2.5rem;height:2.5rem;display:grid;place-items:center;background:var(--color-text);color:var(--color-surface);font:700 .75rem var(--font-mono)}.candidate :global(.copy.nonvoter){border-style:dashed;background:none;color:var(--color-text)}.candidate :global(.copy.unavailable){background:none;color:var(--color-text-secondary);text-decoration:line-through;opacity:.6}.candidate :global(.panel){border:1px solid var(--color-rule);background:var(--color-surface);padding:.75rem;border-radius:.35rem;min-width:0}.candidate :global(.panel .label){font-weight:650;margin:0 0 .6rem}.candidate :global(.panel ul){margin:0;padding-left:1.05rem}.candidate :global(.panel li){margin:.35rem 0;overflow-wrap:anywhere;font-size:.85rem;line-height:1.55}
 .result{border-left:3px solid var(--color-text);padding:.65rem .8rem;background:var(--color-surface);font-weight:600;line-height:1.55;margin:1rem 0}.narration{font-size:.9rem;line-height:1.65;margin:1rem 0;min-height:5.8em}.controls label{display:flex;gap:.45rem;align-items:center}.controls input{width:7rem;min-height:44px;accent-color:var(--color-text)}.controls output{font: .78rem var(--font-mono)}.caption{color:var(--color-text-secondary);font-size:.78rem;line-height:1.65;margin:1rem 0 0}
 .candidate :global(.rail){height:2rem;display:flex;position:relative;border:1px solid var(--color-rule);background:var(--color-surface)}.candidate :global(.deadline){position:absolute;left:37.5%;height:100%;border-left:3px dashed var(--color-text);z-index:1}.candidate :global(.bar){display:block;background:var(--color-text);border-right:2px solid var(--color-surface)}.candidate :global(.bar-1),.candidate :global(.bar-4){opacity:.35}.candidate :global(.bar-2),.candidate :global(.bar-5){opacity:.65}.candidate :global(.axis),.candidate :global(.legend){font-size:.72rem;line-height:1.6;margin:.4rem 0}.meter{margin:1rem 0}.meter[hidden],.route[hidden]{display:none}.route{display:flex;gap:.4rem;align-items:center;margin:1rem 0}.candidate :global(.route-node){padding:.65rem;border:1px solid var(--color-rule);border-radius:.4rem;flex:1;text-align:center;font-size:.78rem;background:var(--color-surface)}.candidate :global(.route-node[data-active=true]){border:2px solid var(--color-text);font-weight:650}.candidate :global(.route-arrow){font-size:1.3rem}
 :is(button,select,input):focus-visible{outline:2px solid var(--color-text);outline-offset:3px}
 @media(max-width:600px){.route{flex-direction:column}.candidate :global(.route-node){width:100%}.candidate :global(.route-arrow){transform:rotate(90deg)}.panels{grid-template-columns:1fr}.controls label{width:100%}.controls input{flex:1;min-width:0}.narration{min-height:0}.candidate{font-size:.85rem}.settings label{width:100%}}
</style>
