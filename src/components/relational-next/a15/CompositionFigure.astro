---
import {definitions,frames} from './model.mjs';
const {scene,number}=Astro.props;
const def=definitions[scene];
const all=frames(scene,def.initial);
const last=all.at(-1);
const id=`composition-${scene}`;
---
<query-composition data-scene={scene}>
 <figure aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`}>Figure {number}. {def.title}</figcaption>
  <label hidden data-controls for={`${id}-choice`}>Change the question <select id={`${id}-choice`} data-choice>{def.options.map(([value,label])=><option value={value} selected={value===def.initial}>{label}</option>)}</select></label>
  <p class="step-title" data-title>{last.title}</p>
  <p class="boundary">Rule or relevant query fragment at this step; complete SQL is in the article.</p>
  <pre><code data-sql>{last.sql}</code></pre>
  <div class="panels" data-panels>{last.panels.map(panel=><div class="panel"><p class="panel-title">{panel.title}</p><div class="table-wrap" tabindex="0" role="region" aria-label={panel.title}><table><thead><tr>{panel.columns.map(c=><th scope="col">{c}</th>)}</tr></thead><tbody>{panel.rows.length?panel.rows.map(row=><tr>{row.map(c=><td>{c}</td>)}</tr>):<tr><td colspan={panel.columns.length}>No rows</td></tr>}</tbody></table></div></div>)}</div>
  <div class="dock">
   <p data-note aria-live="polite">{last.note}</p>
   <div class="transport" hidden data-controls><button type="button" data-act="play">Play</button><button type="button" data-act="back">Back</button><button type="button" data-act="next">Next</button><button type="button" data-act="reset">Reset</button><label class="scrub">Step <input data-step type="range" min="0" max={all.length-1} step="1" value={all.length-1}/></label><span data-position></span></div>
  </div>
  <p class="boundary">Illustrative logical model, checked against PostgreSQL results. These are reasoning steps, not an execution trace. Play advances after time to inspect every visible panel; pause or step to take longer.</p>
 </figure>
</query-composition>
<script>
 import {definitions,frames} from './model.mjs';
 class QueryComposition extends HTMLElement{
  timer=0;
  connectedCallback(){
   if(this.dataset.ready)return;this.dataset.ready='';
   const scene=this.dataset.scene!;
   let choice=definitions[scene].initial,steps=frames(scene,choice),step=0,playing=false;
   const q=(s:string)=>this.querySelector<HTMLElement>(s)!;
   const slider=q('[data-step]') as HTMLInputElement;
   const stop=()=>{playing=false;window.clearTimeout(this.timer);q('[data-act="play"]').textContent='Play';q('[data-note]').setAttribute('aria-live','polite');};
   const draw=()=>{
    const f=steps[step];q('[data-title]').textContent=f.title;q('[data-sql]').textContent=f.sql;q('[data-note]').textContent=f.note;
    q('[data-position]').textContent=`${step+1} / ${steps.length}`;slider.max=String(steps.length-1);slider.value=String(step);
    const container=q('[data-panels]');container.replaceChildren();
    for(const p of f.panels){
     const panel=document.createElement('div');panel.className='panel';const title=document.createElement('p');title.className='panel-title';title.textContent=p.title;panel.append(title);
     const wrap=document.createElement('div');wrap.className='table-wrap';wrap.tabIndex=0;wrap.setAttribute('role','region');wrap.setAttribute('aria-label',p.title);
     const table=document.createElement('table'),head=document.createElement('thead'),tr=document.createElement('tr');for(const c of p.columns){const th=document.createElement('th');th.scope='col';th.textContent=c;tr.append(th);}head.append(tr);table.append(head);
     const body=document.createElement('tbody');for(const row of p.rows){const r=document.createElement('tr');for(const c of row){const td=document.createElement('td');td.textContent=c;r.append(td);}body.append(r);}if(!p.rows.length){const r=document.createElement('tr'),td=document.createElement('td');td.colSpan=p.columns.length;td.textContent='No rows';r.append(td);body.append(r);}table.append(body);wrap.append(table);panel.append(wrap);container.append(panel);
    }
   };
   const schedule=()=>{
    const f=steps[step];
    // Budget narration, code, all table panels and a separate inspection pause.
    const text=[f.title,f.sql,f.note,...f.panels.flatMap(p=>[p.title,...p.columns,...p.rows.flat()])].join(' ');
    const hold=2500+text.split(/\s+/).length*300+f.panels.reduce((n,p)=>n+p.rows.length,0)*300;
    this.timer=window.setTimeout(()=>{if(step<steps.length-1){step++;draw();schedule();}else stop();},hold);
   };
   this.addEventListener('click',e=>{const btn=(e.target as Element).closest<HTMLButtonElement>('button');if(!btn)return;const act=btn.dataset.act;if(act==='play'){if(playing){stop();return;}if(step===steps.length-1)step=0;playing=true;q('[data-act="play"]').textContent='Pause';q('[data-note]').setAttribute('aria-live','off');draw();schedule();return;}stop();if(act==='back')step=Math.max(0,step-1);if(act==='next')step=Math.min(steps.length-1,step+1);if(act==='reset'){choice=definitions[scene].initial;(q('[data-choice]') as HTMLSelectElement).value=choice;steps=frames(scene,choice);step=0;}draw();});
   q('[data-choice]').addEventListener('change',e=>{stop();choice=(e.target as HTMLSelectElement).value;steps=frames(scene,choice);step=0;draw();});
   slider.addEventListener('input',()=>{stop();step=Number(slider.value);draw();});
   this.querySelectorAll<HTMLElement>('[data-controls]').forEach(e=>e.hidden=false);draw();
   document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  }
  disconnectedCallback(){window.clearTimeout(this.timer);}
 }
 if(!customElements.get('query-composition'))customElements.define('query-composition',QueryComposition);
</script>
<style>
 query-composition{display:block;margin:2rem 0;padding:1rem;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);}figure{margin:0;}figcaption{font-weight:650;margin-bottom:.9rem;}label{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-size:.83rem;}select,button{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.4rem .55rem;max-width:100%;}button{cursor:pointer;}button:focus-visible,select:focus-visible,input:focus-visible,.table-wrap:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px;}.step-title{font-weight:650;margin:1rem 0 .4rem;}pre{margin:.5rem 0;padding:.65rem;background:var(--color-surface);border:1px solid var(--color-rule);overflow:auto;font:.72rem/1.6 var(--font-mono);}pre code{font:inherit;background:none;padding:0;}.panels{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr));gap:.7rem;}.panel{min-width:0;margin:0;padding:.5rem;background:var(--color-surface);border:1px solid var(--color-rule);}.panel-title{font-size:.8rem;font-weight:650;margin:.2rem 0 .4rem;}.table-wrap{overflow:auto;}table{font-size:.76rem;width:100%;table-layout:fixed;border-collapse:collapse;margin:0;}th,td{padding:.4rem .22rem;border-bottom:1px solid var(--color-rule);text-align:left;vertical-align:top;overflow-wrap:anywhere;}th{font-size:.7rem;}tbody{animation:appear .3s ease-out;}.dock{position:sticky;bottom:0;background:var(--color-surface-alt);border-top:1px solid var(--color-rule);padding:.45rem 0;margin-top:.75rem;z-index:1;}[data-note]{font-size:.86rem;margin:.4rem 0 .7rem;}.transport{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;font-size:.8rem;}.transport span{font-size:.73rem;}.scrub{flex:1;min-width:8rem;font-size:.75rem;}.scrub input{min-width:4rem;max-width:9rem;width:100%;}.boundary{font-size:.74rem;color:var(--color-text-secondary);margin:.7rem 0 0;}[hidden]{display:none;}@keyframes appear{from{opacity:.4}to{opacity:1}}@media(prefers-reduced-motion:reduce){tbody{animation:none;}}@media(max-width:480px){query-composition{padding:.65rem;}.panels{grid-template-columns:1fr;gap:.5rem;}.panel{margin:0;padding:.4rem;}table{font-size:.69rem;}th{font-size:.62rem;}th,td{padding:.35rem .16rem;}pre{font-size:.64rem;}[data-note]{font-size:.8rem;}.dock{padding-bottom:.3rem;}}
</style>
