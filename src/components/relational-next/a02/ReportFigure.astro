---
import {reportModel,reportNote,reportSql} from './model.mjs';
const rows=reportModel().rows;
---
<sql-report-stages>
 <figure aria-labelledby="report-stages-title">
  <figcaption id="report-stages-title">Figure 2. From independent details to one follow-up row per order</figcaption>
  <label data-controls hidden>Change one input <select data-change><option value="none">Original fixture</option><option value="receipt">101: add receipt 204 for 5</option><option value="settle">101: add receipt 204 for 15</option><option value="line">106: add line 1 for 10</option></select></label>
  <p class="stage-name" data-stage-name>4 · Final SELECT</p>
  <p class="code-label">Relevant SQL fragments; the complete statement follows.</p>
  <pre><code data-sql>{reportSql[3]}</code></pre>
  <p class="key" data-key>Candidate identities stay visible. Faint rows are excluded from the SQL answer.</p>
  <div class="report-table" role="region" tabindex="0" aria-label="Report stages by order identity">
   <table><thead><tr><th>Order</th><th data-lines-head>line_totals</th><th data-paid-head>payment_totals</th><th>balances<br/>due / receipt?</th><th>Final<br/>SELECT</th></tr></thead><tbody>{rows.map(row=><tr data-order={row.order_id} data-excluded={!row.keep?'':undefined}><th>{row.order_id}</th><td data-line>{row.order_value??'no row'}</td><td data-paid>{row.paid??'0 ← no row'}</td><td><strong data-due>{row.due??'NULL'}</strong><small data-presence>{row.has_payment?'yes':'no'}</small></td><td data-keep>{row.keep?'keep':'settled: out'}</td></tr>)}</tbody></table>
  </div>
  <p class="answer" data-answer>SQL answer: 101 → 15; 102 → 20; 106 → NULL.</p>
  <div class="control-dock">
   <p data-note aria-live="polite">{reportNote('none',3)}</p>
   <div class="transport" data-controls hidden><button type="button" data-act="play">Replay</button><button type="button" data-act="back">Back</button><button type="button" data-act="next">Next</button><button type="button" data-act="reset">Reset</button><span data-position></span></div>
  </div>
  <p class="boundary">Illustrative logical stages, not engine execution order. JavaScript calculates the shown values; every input choice was checked against the report’s SQL.</p>
 </figure>
</sql-report-stages>
<script>
 import {reportModel,reportNote,reportSql} from './model.mjs';
 import {attachPlayer} from './player';
 class SqlReportStages extends HTMLElement {
  dispose?:()=>void;
  connectedCallback(){
   let change='none';
   const q=(s:string)=>this.querySelector<HTMLElement>(s)!;
   const render=(step:number)=>{
    const data=reportModel(change);
    q('[data-stage-name]').textContent=['1 · Source details for the five candidates','2 · line_totals and payment_totals','3 · balances: preserve, subtract, test presence','4 · Final SELECT'][step];
    q('[data-sql]').textContent=reportSql[step];
    q('[data-lines-head]').textContent=step===0?'Lines: no. → amount':'line_totals';
    q('[data-paid-head]').textContent=step===0?'Receipt ID → amount':'payment_totals';
    q('[data-key]').textContent=step===0?'Each source identity is visible; “none” means no detail rows.':step===1?'One subtotal row per order on each side. “No row” is absence, not a stored zero.':step===2?'Absent receipts default to zero. An absent line subtotal remains NULL.':'Candidate identities stay visible. Faint rows are excluded from the SQL answer.';
    for(const row of data.rows){
     const tr=q(`[data-order="${row.order_id}"]`);
     const cell=(s:string)=>tr.querySelector<HTMLElement>(s)!;
     tr.toggleAttribute('data-excluded',step===3&&!row.keep);
     cell('[data-line]').textContent=step===0?(row.lineRows.map(r=>`${r.line_no} → ${r.amount}`).join('; ')||'none'):(row.order_value===null?(step<2?'no row':'NULL ← no row'):String(row.order_value));
     cell('[data-paid]').textContent=step===0?(row.receiptRows.map(r=>`${r.payment_id} → ${r.amount}`).join('; ')||'none'):(row.paid===null?(step<2?'no row':'0 ← no row'):String(row.paid));
     cell('[data-due]').textContent=step<2?'—':`${row.order_value??'NULL'} − ${row.paid??0} = ${row.due??'NULL'}`;
     cell('[data-presence]').textContent=step<2?'':`receipt: ${row.has_payment?'yes':'no'}`;
     cell('[data-keep]').textContent=step<3?'—':row.keep?'keep':'settled: out';
    }
    q('[data-answer]').textContent=step<3?'Inspect this stage before advancing.':'SQL answer: '+data.final.map(r=>`${r.order_id} → ${r.due??'NULL'}`).join('; ')+'.';
    return reportNote(change,step);
   };
   const player=attachPlayer(this,3,render);
   this.addEventListener('change',e=>{change=(e.target as HTMLSelectElement).value;player.refresh();});
   this.dispose=player.destroy;
  }
  disconnectedCallback(){this.dispose?.();}
 }
 if(!customElements.get('sql-report-stages'))customElements.define('sql-report-stages',SqlReportStages);
</script>
<style>
 sql-report-stages{display:block;margin:2rem 0;padding:1rem;background:var(--color-surface-alt);border:1px solid var(--color-rule);border-radius:.5rem;}figure{margin:0;}figcaption{font-weight:650;margin-bottom:.8rem;}label{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;font-size:.85rem;}.stage-name{font-weight:650;margin:.8rem 0 .3rem;}.code-label,.key,.boundary{font-size:.77rem;color:var(--color-text-secondary);margin:.3rem 0;}.boundary{margin-top:.7rem;}pre{padding:.65rem;overflow:auto;background:var(--color-surface);border:1px solid var(--color-rule);font:.68rem/1.5 var(--font-mono);margin:.5rem 0;}pre code{font:inherit;padding:0;background:none;}.report-table{overflow:auto;}table{width:100%;table-layout:fixed;font-size:.77rem;font-variant-numeric:tabular-nums;}th,td{padding:.4rem .25rem;overflow-wrap:anywhere;text-align:left;vertical-align:top;border-bottom:1px solid var(--color-rule);}thead th{font-size:.68rem;}th:first-child{width:11%;}small{display:block;font-size:.66rem;font-weight:400;}tr[data-excluded]{opacity:.48;}tr[data-excluded] th{text-decoration:line-through;}.answer{font-size:.85rem;}.control-dock{position:sticky;bottom:0;background:var(--color-surface-alt);padding:.45rem 0;border-top:1px solid var(--color-rule);z-index:1;}[data-note]{font-size:.85rem;margin:.4rem 0 .7rem;}.transport{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;}.transport span{font-size:.73rem;}button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.35rem .5rem;}button{cursor:pointer;}button:disabled{opacity:.45;cursor:default;}button:focus-visible,select:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px;}[hidden]{display:none;}@media(max-width:480px){sql-report-stages{padding:.65rem;}table{font-size:.71rem;}thead th{font-size:.61rem;}td,th{padding:.35rem .18rem;}.transport{font-size:.84rem;}[data-note]{font-size:.8rem;}pre{font-size:.62rem;}}
</style>
