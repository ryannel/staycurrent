---
import {joinSteps,paging,original} from './model.mjs';
const {scene,number}=Astro.props;
const join=scene==='join', uid='sql-a02-'+scene;
---
<sql-working-figure data-scene={scene}>
 <figure aria-labelledby={uid+'-title'}>
  <figcaption id={uid+'-title'}>Figure {number}. {join?'One row for every matching pair':'Two requests over a changing ordered result'}</figcaption>
  <div class="settings" data-controls hidden>
   {join?<label>Keep unmatched orders <select data-setting="join"><option value="inner">Inner join</option><option value="left">Left join</option></select></label>:<>
    <label>Second request <select data-setting="mode"><option value="offset">Offset 2</option><option value="keyset">After cursor</option></select></label>
    <label>Between requests <select data-setting="change"><option value="none">No change</option><option value="insert">Insert 107 before cursor</option><option value="delete">Delete 100 before cursor</option><option value="move">Move 102 before cursor</option></select></label>
   </>}
  </div>
  {join?<>
   <div class="inputs"><p><strong>Orders</strong><br/>101 · 102 · 106</p><p><strong>Lines</strong><br/>101/1: 20 · 101/2: 10 · 102/1: 20</p></div>
   <div class="table-scroll" role="region" tabindex="0" aria-label="Joined result"><table><thead><tr><th>order_id</th><th>line_no</th><th>amount</th></tr></thead><tbody data-rows>{joinSteps().at(-1).rows.map(row=><tr>{row.map(x=><td>{x===null?'NULL':x}</td>)}</tr>)}</tbody></table></div>
  </>:<>
   <p class="first-page">Saved first page: <strong data-first-page>100 · 101</strong><br/>Saved cursor: <code>(10 Jan 09:00 UTC, 101)</code>.</p>
   <div class="ordered" data-ordered role="list" aria-label="Current rows, positions and saved cursor">
    {[...original,107].map((id,index)=><><div class="page-row" data-row-id={id} hidden={id===107} role="listitem"><span class="position" data-row-position>{index+1}</span><strong>{id}</strong><span class="row-status" data-row-status>{index<2?'skip position '+(index+1):index<4?'second page':'later row'}</span></div>{id===101&&<div class="cursor" data-cursor role="listitem"><strong>Saved boundary after 101</strong><span>10 Jan 09:00 UTC · ID 101</span></div>}</>)}
   </div>
   <p class="answer">Second page: <strong data-answer>102 · 105</strong></p>
  </>}
  <div class="control-dock"><p data-note aria-live="polite">{join?joinSteps().at(-1).note:paging().note}</p><div class="transport" data-controls hidden><button type="button" data-act="play">Replay</button><button type="button" data-act="back">Back</button><button type="button" data-act="next">Next</button><button type="button" data-act="reset">Reset</button><span data-position></span></div></div>
  <p class="boundary">Illustrative logical model. These controls calculate rows in JavaScript; they do not run SQL or depict an execution plan.</p>
 </figure>
</sql-working-figure>
<script>
 import {joinSteps,paging,original} from './model.mjs';
 import {attachPlayer} from './player';
 class WorkingSqlFigure extends HTMLElement {
  dispose?:()=>void;
  connectedCallback(){
   const join=this.dataset.scene==='join';
   let mode='offset',change='none',left=false;
   const el=(s:string)=>this.querySelector<HTMLElement>(s)!;
   const rowNodes=new Map([...this.querySelectorAll<HTMLElement>('[data-row-id]')].map(n=>[Number(n.dataset.rowId),n]));
   const render=(step:number)=>{
    if(join){
     el('[data-rows]').replaceChildren(...joinSteps(left)[step].rows.map(row=>{const tr=document.createElement('tr');row.forEach(x=>{const td=document.createElement('td');td.textContent=x===null?'NULL':String(x);tr.append(td);});return tr;}));
     return joinSteps(left)[step].note;
    }
    const p=paging(mode,change,step), cursorIndex=p.rows.indexOf(101), container=el('[data-ordered]'), cursor=el('[data-cursor]');
    rowNodes.forEach((node,id)=>{node.hidden=!p.rows.includes(id);});
    for(const [index,id] of p.rows.entries()){
     const node=rowNodes.get(id)!;container.append(node);if(id===101)container.append(cursor);
     const was=original.indexOf(id)+1,now=index+1;
     node.querySelector<HTMLElement>('[data-row-position]')!.textContent=was===0?'new → '+now:was===now?String(now):was+' → '+now;
     node.toggleAttribute('data-chosen',p.next.includes(id));
     node.toggleAttribute('data-skipped',step===2&&mode==='offset'&&index<2);
     node.toggleAttribute('data-before',mode==='keyset'&&index<=cursorIndex);
     let status=step===2?(p.next.includes(id)?'second page':mode==='offset'&&index<2?'skip position '+now:mode==='keyset'&&index<=cursorIndex?'before saved boundary':'later row'):'not requested yet';
     if(id===100||id===101)status+=' · read on first page';
     if(id===107)status+=' · inserted before cursor';
     if(id===102&&change==='move'&&step>=1)status+=' · moved across cursor to 5 Jan';
     node.querySelector<HTMLElement>('[data-row-status]')!.textContent=status;
    }
    el('[data-first-page]').textContent=step>=1&&change==='delete'?'100 (now deleted) · 101':'100 · 101';
    el('[data-answer]').textContent=step<2?'Not requested yet':p.next.join(' · ');
    return p.note;
   };
   const player=attachPlayer(this,join?4:2,render);
   this.addEventListener('change',e=>{const s=e.target as HTMLSelectElement;if(s.dataset.setting==='join')left=s.value==='left';if(s.dataset.setting==='mode')mode=s.value;if(s.dataset.setting==='change')change=s.value;player.refresh();});
   this.dispose=player.destroy;
  }
  disconnectedCallback(){this.dispose?.();}
 }
 if(!customElements.get('sql-working-figure'))customElements.define('sql-working-figure',WorkingSqlFigure);
</script>
<style>
 sql-working-figure{display:block;margin:2rem 0;border:1px solid var(--color-rule);border-radius:.5rem;background:var(--color-surface-alt);padding:1rem;}figure{margin:0;}figcaption{font-weight:650;margin-bottom:1rem;}.settings,.transport{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;}[hidden]{display:none;}.settings{margin-bottom:1rem;}label{display:flex;gap:.4rem;flex-wrap:wrap;align-items:center;font-size:.85rem;}button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule);border-radius:.3rem;padding:.35rem .6rem;}button{cursor:pointer;}button:disabled{opacity:.45;cursor:default;}button:focus-visible,select:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px;}.inputs{display:flex;flex-wrap:wrap;gap:1rem 2rem;}.inputs p{margin:.4rem 0;}table{width:100%;font-variant-numeric:tabular-nums;}.table-scroll :global(td),.table-scroll :global(th){text-align:left;padding:.4rem;border-bottom:1px solid var(--color-rule);}.table-scroll{overflow:auto;}[data-note]{min-height:3.5rem;font-size:.86rem;margin:.5rem 0;}.ordered{display:grid;gap:.3rem;}.page-row[hidden]{display:none;}.page-row{display:grid;grid-template-columns:3.5rem 3rem minmax(0,1fr);align-items:center;gap:.5rem;padding:.35rem .5rem;border:1px solid var(--color-rule);border-radius:.25rem;}.position{font-size:.73rem;color:var(--color-text-secondary);}.row-status{font-size:.75rem;}.page-row strong{font:600 .9rem var(--font-mono);}.page-row[data-chosen]{outline:2px solid var(--color-accent);background:var(--color-surface);}.page-row[data-skipped]{border-style:dashed;background:var(--color-surface);}.page-row[data-skipped] .position{text-decoration:line-through;}.page-row[data-before]{border-style:dashed;}.cursor{border-top:3px solid var(--color-accent);padding:.3rem .5rem;color:var(--color-accent);font-size:.76rem;display:flex;flex-wrap:wrap;justify-content:space-between;gap:.3rem;}.first-page{font-size:.85rem;}.boundary{font-size:.78rem;color:var(--color-text-secondary);margin-bottom:0;}.transport span{font-size:.8rem;}.control-dock{position:sticky;bottom:0;background:var(--color-surface-alt);padding:.3rem 0;z-index:1;}@media(max-width:480px){sql-working-figure{padding:.65rem;}.page-row{grid-template-columns:2.4rem 2.6rem minmax(0,1fr);gap:.3rem;padding:.3rem;}.row-status{font-size:.69rem;}.settings{gap:.45rem;}[data-note]{font-size:.8rem;}.transport{font-size:.84rem;gap:.35rem;}}
</style>
