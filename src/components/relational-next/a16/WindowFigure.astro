---
import {scenes,state,render} from './model.mjs';
interface Props { scene: keyof typeof scenes; number:number }
const {scene,number}=Astro.props;
const def=scenes[scene], id=`wc-${scene}`;
const initial=state(scene,def.options[0][0],def.steps-1);
---
<figure class="wc-figure" aria-labelledby={`${id}-title`}>
 <p class="wc-title" id={`${id}-title`}><span>Figure {number}</span> {def.title}</p>
 <window-calculation data-scene={scene}>
  <div class="wc-controls" data-controls hidden>
   <label>Calculation<select data-choice>{def.options.map(([value,label])=><option value={value}>{label}</option>)}</select></label>
   <div class="wc-transport" role="group" aria-label={`Playback for figure ${number}`}>
    <button type="button" data-act="play" aria-pressed="false">Play</button>
    <button type="button" data-act="back">Back</button>
    <button type="button" data-act="next">Next</button>
    <button type="button" data-act="reset">Reset</button>
    <label>Step<input data-step type="range" min="0" max={def.steps-1} value={def.steps-1} /></label>
    <output data-count>{def.steps} / {def.steps}</output>
   </div>
  </div>
  <div data-board set:html={render(initial)} />
  <p data-note class="wc-note" aria-live="polite">{initial.text}</p>
 </window-calculation>
 <figcaption>A logical model of the fixture, checked against PostgreSQL 18.6 results. The current row has a solid outline; shaded rows are related inputs. Rows marked with a dashed edge are excluded. Playback allows time to inspect the whole table, rule, result and explanation.</figcaption>
</figure>
<script>
 import {scenes,state,render,holdFor} from './model.mjs';
 class WindowCalculation extends HTMLElement {
  stopPlayback: (()=>void)|undefined;
  connectedCallback(){
   if(this.dataset.ready)return;this.dataset.ready='true';
   const scene=this.dataset.scene as keyof typeof scenes, def=scenes[scene];
   const choice=this.querySelector<HTMLSelectElement>('[data-choice]')!;
   const scrub=this.querySelector<HTMLInputElement>('[data-step]')!;
   const board=this.querySelector<HTMLElement>('[data-board]')!;
   const note=this.querySelector<HTMLElement>('[data-note]')!;
   const play=this.querySelector<HTMLButtonElement>('[data-act="play"]')!;
   const back=this.querySelector<HTMLButtonElement>('[data-act="back"]')!;
   const next=this.querySelector<HTMLButtonElement>('[data-act="next"]')!;
   let step=0,playing=false,timer=0;
   const stop=()=>{playing=false;clearTimeout(timer);play.textContent=step===def.steps-1?'Replay':'Play';play.setAttribute('aria-pressed','false');};
   this.stopPlayback=stop;
   const draw=()=>{
    const s=state(scene,choice.value,step);board.innerHTML=render(s);note.textContent=s.text;
    scrub.value=String(step);scrub.setAttribute('aria-valuetext',`Row or stage ${step+1} of ${def.steps}`);
    this.querySelector('[data-count]')!.textContent=`${step+1} / ${def.steps}`;
    back.setAttribute('aria-disabled',String(step===0));next.setAttribute('aria-disabled',String(step===def.steps-1));
    if(!playing)play.textContent=step===def.steps-1?'Replay':'Play';
   };
   const tick=()=>{timer=window.setTimeout(()=>{if(!playing)return;if(step===def.steps-1){stop();return;}step++;draw();tick();},holdFor(state(scene,choice.value,step)));};
   play.addEventListener('click',()=>{if(playing){stop();return;}if(step===def.steps-1)step=0;playing=true;play.textContent='Pause';play.setAttribute('aria-pressed','true');draw();tick();});
   back.addEventListener('click',()=>{stop();step=Math.max(0,step-1);draw();});
   next.addEventListener('click',()=>{stop();step=Math.min(def.steps-1,step+1);draw();});
   this.querySelector('[data-act="reset"]')!.addEventListener('click',()=>{stop();step=0;draw();});
   choice.addEventListener('change',()=>{stop();draw();});
   scrub.addEventListener('input',()=>{stop();step=Number(scrub.value);draw();});
   document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
   this.querySelector<HTMLElement>('[data-controls]')!.hidden=false;draw();
  }
  disconnectedCallback(){this.stopPlayback?.();}
 }
 if(!customElements.get('window-calculation'))customElements.define('window-calculation',WindowCalculation);
</script>
<style>
 .wc-figure{margin:2rem 0;border:1px solid var(--color-rule);padding:1rem;border-radius:.3rem;background:var(--color-surface-alt)}
 .wc-title{font-weight:650;margin:0 0 1rem}.wc-title span{color:var(--color-text-secondary);font-size:.8rem;margin-right:.5rem}
 window-calculation{display:block;min-width:0}.wc-controls{display:grid;gap:.8rem;margin-bottom:1rem}.wc-controls[hidden]{display:none}
 .wc-controls label{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-size:.8rem}.wc-controls select{max-width:100%;padding:.5rem;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule)}
 .wc-transport{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem}.wc-transport button{padding:.5rem .65rem;min-height:2.75rem;border:1px solid var(--color-rule);border-radius:.2rem;background:var(--color-surface);color:var(--color-text);font:inherit;font-size:.8rem;cursor:pointer}
 .wc-transport button[aria-disabled="true"]{opacity:.55}.wc-controls :is(button,select,input):focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}.wc-transport output{font: .78rem var(--font-mono);white-space:nowrap}
 .wc-transport input{width:7rem;accent-color:var(--color-accent)}.wc-note{font-size:.86rem;min-height:4.5em;margin:.9rem 0 0}.wc-figure figcaption{margin:.9rem 0 0;font-size:.75rem;color:var(--color-text-secondary)}
 .wc-figure :global(.wc-rule){margin:.6rem 0;font-size:.77rem;overflow-wrap:anywhere}.wc-figure :global(.wc-rule code){white-space:normal}
 .wc-figure :global(.wc-table){overflow-x:auto;max-width:100%;border:1px solid var(--color-rule)}.wc-figure :global(table){width:100%;margin:0;border-collapse:collapse;font-size:.78rem}.wc-figure :global(th),.wc-figure :global(td){padding:.55rem .45rem;white-space:normal;text-align:left;border-bottom:1px solid var(--color-rule)}
 .wc-figure :global(tr[data-kind="included"]){background:color-mix(in srgb,var(--color-accent) 12%,var(--color-surface))}.wc-figure :global(tr[data-kind="current"]){outline:2px solid var(--color-accent);outline-offset:-2px;background:color-mix(in srgb,var(--color-accent) 19%,var(--color-surface))}.wc-figure :global(tr[data-kind="excluded"]){border-left:3px dashed var(--color-text-secondary);color:var(--color-text-secondary)}
 .wc-figure :global(.wc-result){padding:.75rem;margin:.8rem 0 0;background:var(--color-surface);font-size:.85rem;border-left:3px solid var(--color-accent)}
 @media(max-width:600px){.wc-figure{padding:.6rem}.wc-figure :global(th),.wc-figure :global(td){padding:.45rem .3rem;font-size:.7rem}.wc-controls select{width:100%}.wc-note{min-height:7em}}
</style>
