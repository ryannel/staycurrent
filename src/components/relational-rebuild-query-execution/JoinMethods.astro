<figure class="qe-figure qe-joins" aria-labelledby="join-method-title">
 <figcaption id="join-method-title"><span>Figure 2</span> Three methods, the same matching occurrences</figcaption>
 <label class="qe-option">Join method <select data-method><option value="nested">Nested loop with line lookup</option><option value="hash">Hash join</option><option value="merge">Merge join</option></select></label>
 <div class="qe-stage">
  <div data-mechanism data-live></div>
  <div class="qe-stream"><p class="qe-label" data-work-title data-live></p><p data-work data-live></p><p class="qe-label">Joined output so far</p><div data-output data-live></div></div>
 </div>
 <p class="qe-explanation" data-explanation data-live aria-live="polite"></p>
 <div class="qe-controls" role="group" aria-label="Figure 2 controls"><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step></span></div><div class="qe-hold" data-hold aria-hidden="true"><span></span></div>
 <p class="qe-caption">Conceptual executions. The nested loop assumes a lookup by order ID. The hash drawing builds from the two eligible orders. The merge drawing assumes both inputs already arrive in order-ID order. These assumptions carry different costs.</p>
 <details><summary>Methods, as text</summary><p>A nested loop takes order 101 and looks up its two lines, then order 102 and its one line. A hash join builds a key table containing orders 101 and 102, then probes it with lines: both 101 lines and the 102 line match; neither 103 line matches. A merge join advances through ordered key groups: 101 matches two lines, 102 matches one, and 103 has no eligible order. All produce the same three joined occurrences.</p></details>
</figure>
<script>
 import {stepper} from '../figures/stepper.mjs';
 document.querySelectorAll('.qe-joins').forEach(root=>{
 const select=root.querySelector('select');
 const scenes={
 nested:[['Outer row','Take order 101.',101,0,'The outer input supplies one eligible order. The inner lookup will use its order ID.'],['Inner lookup','Find lines 101/1 and 101/2.',101,2,'One lookup emits two matching occurrences. It need not scan the lines for other orders.'],['Outer row','Take order 102.',102,2,'The next outer row starts another inner lookup. More outer rows mean more repetitions.'],['Inner lookup','Find line 102/1.',102,3,'The second lookup emits one occurrence. Two cheap lookups served this small outer input.'],['Finished','2 outer rows → 2 line lookups.',0,3,'For a large outer input the same route repeats many times. Cheap per-lookup work can still be expensive in total.']],
 hash:[['Build','Store eligible keys 101 and 102.',0,0,'Build a hash table from the two eligible orders. Each bucket retains its order row, including customer ID.'],['Probe key 101','Both 101 lines find order 101.',101,2,'Hashing locates a candidate bucket; the join still checks the key. Both matching line occurrences survive.'],['Probe key 102','Line 102/1 finds order 102.',102,3,'The next line probes the table rather than starting a new search through all eligible orders.'],['Probe key 103','Neither 103 line finds a match.',103,3,'The line input includes pending order 103’s lines. Both are examined and rejected here.'],['Finished','2 build rows + 5 probe rows.',0,3,'This route reads the line input once, but has to build and hold the key table. A large build may require temporary disk work.']],
 merge:[['Ordered inputs','Start at key 101 on both sides.',101,0,'The merge can advance by key because both inputs are ordered. Obtaining that order may require extra sorting.'],['Match key 101','One order × two lines.',101,2,'Match the whole 101 key group. Repeated keys are retained; a merge does not pick only the first matching line.'],['Match key 102','Advance to 102 on both sides.',102,3,'The next groups match once. If both sides had several rows with a key, every required pair would be produced.'],['No more orders','The eligible-order input is exhausted.',0,3,'No remaining line can match, so the inner join can finish. It need not consume the rest of this ordered line input.'],['Finished','Two matching key groups.',0,3,'The method avoids repeated lookups, but its required input order has a cost. Keep ORDER BY in the report to request its final order.']]
 };
 const values=['101 / 1 · customer 1 · 4.50','101 / 2 · customer 1 · 35.00','102 / 1 · customer 2 · 40.00'];
 const mechanisms = (method, n, key) => {
   const groups = [[101, '101/1 · 4.50<br>101/2 · 35.00'], [102, '102/1 · 40.00'], [103, '103/1 · 20.00<br>103/2 · 9.00']];
   const pair = (left, right, active, arrow = '→') => '<div class="qe-method-pair'+(active?' qe-active-pair':'')+'"><div>'+left+'</div><span aria-hidden="true">'+(active?arrow:'')+'</span><div>'+right+'</div></div>';
   if (method === 'nested') return '<p class="qe-label">One order starts one indexed lookup</p><div class="qe-method-head"><span>Outer orders</span><span>Line index</span></div>'+
     groups.map(([id, rows]) => pair(id === 103 ? 'Not eligible' : 'Order '+id, rows, key===id || n===4&&id!==103)).join('')+
     '<p class="qe-mechanism-note">↻ Return for the next outer order</p>';
   if (method === 'hash') return '<p class="qe-label">Probe each line against the built table</p><div class="qe-method-head"><span>Line input</span><span>Hash table</span></div>'+
     groups.map(([id, rows]) => pair(rows, id===103 ? '<span class="qe-no-key">No equal key</span>' : '<span class="qe-bucket">Key '+id+'<small>customer '+(id===101?'1':'2')+'</small></span>', key===id, id===103?'×':'→')).join('')+
     '<p class="qe-mechanism-note">Two build rows · five line probes</p>';
   const cursor = n<2?101:n===2?102:103;
   return '<p class="qe-label">Both inputs ordered by order ID ↓</p><div class="qe-method-head"><span>Eligible orders</span><span>Line groups</span></div>'+
     groups.map(([id, rows]) => pair((cursor===id?'▶ ':'')+(id===103?'End of input':'Order '+id), (cursor===id?(id===103?'Unread · ':'▶ '):'')+rows, cursor===id, id===103?'×':'↔')).join('')+
     '<p class="qe-mechanism-note">'+(n>=3?'Orders exhausted · remaining lines need not be read':'The two cursors advance together through matching groups')+'</p>';
 };
 const player=stepper(root,{steps:()=>5,draw(n){const [title,work,key,count,text]=scenes[select.value][n];root.querySelector('[data-work-title]').textContent=title;root.querySelector('[data-work]').textContent=work;root.querySelector('[data-explanation]').textContent=text;root.querySelector('[data-mechanism]').innerHTML=mechanisms(select.value,n,key);root.querySelector('[data-output]').replaceChildren(...(count?values.slice(0,count):['No rows emitted yet.']).map(value=>{const p=document.createElement('p');p.textContent=value;return p;}));}});
 select.addEventListener('change',()=>{root.querySelector('[data-reset]').click();player.render();});
 });
</script>

<style is:global>
 .qe-joins .qe-method-head { display:grid; grid-template-columns:1fr 1fr; gap:2rem; font:.72rem/1.5 var(--font-sans); color:var(--color-text-secondary); margin-bottom:.5rem; }
 .qe-joins .qe-method-pair { display:grid; grid-template-columns:minmax(0,1fr) 1.5rem minmax(0,1fr); align-items:center; gap:.2rem; margin:.55rem 0; font:.8rem/1.6 var(--font-sans); }
 .qe-joins .qe-method-pair > div { padding:.55rem; border:1px solid var(--color-rule-strong); min-width:0; }
 .qe-joins .qe-method-pair > span { text-align:center; font-size:1.3rem; color:var(--color-accent); }
 .qe-joins .qe-active-pair > div { border-color:var(--color-accent); background:color-mix(in srgb,var(--teal) 9%,var(--color-surface)); }
 .qe-joins .qe-bucket { display:block; border:2px solid var(--color-accent); border-radius:0 0 10px 10px; padding:.4rem; }
 .qe-joins .qe-bucket small { display:block; color:var(--color-text-secondary); }
 .qe-joins .qe-no-key { border-bottom:2px dashed var(--color-text-secondary); }
 .qe-joins .qe-mechanism-note { font:.75rem/1.6 var(--font-sans); margin:.7rem 0 0; color:var(--color-text-secondary); }
 @media(max-width:550px) { .qe-joins .qe-method-pair { font-size:.76rem; } .qe-joins .qe-method-pair > div { padding:.4rem; } }
</style>
