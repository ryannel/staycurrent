---
const tables = [
  { name: 'customers', note: 'One row per customer', columns: [['customer_id', 'PK'], ['name', '']], rows: [[1, 'Mina Shah'], [2, 'Tariq Aziz'], [3, 'Edda Berg']] },
  { name: 'orders', note: 'One row per order', columns: [['order_id', 'PK'], ['customer_id', 'FK'], ['status', '']], rows: [[101, 1, 'paid'], [102, 2, 'paid'], [103, 1, 'pending']] },
  { name: 'order_items', note: 'One row per order line · PK uses both marked columns', columns: [['order_id', 'PK · FK'], ['line_no', 'PK'], ['product_id', 'FK'], ['quantity', ''], ['unit_price', '']], rows: [[101, 1, 'P3', 1, '4.50'], [101, 2, 'P9', 1, '35.00'], [102, 1, 'P7', 2, '20.00'], [103, 1, 'P7', 1, '20.00'], [103, 2, 'P3', 2, '4.50']] },
  { name: 'products', note: 'One row per product · stock is units still available', columns: [['product_id', 'PK'], ['name', ''], ['price', ''], ['stock', '']], rows: [['P3', 'Green tea, 50 g', '4.50', 10], ['P7', 'Blue mug', '20.00', 0], ['P9', 'Teapot', '35.00', 4]] },
];
const links = [
  { column: 'orders.customer_id', target: 'customers.customer_id', direction: 'up', meaning: 'Each order names one customer' },
  { column: 'order_items.order_id', target: 'orders.order_id', direction: 'up', meaning: 'Each line belongs to one order' },
  { column: 'order_items.product_id', target: 'products.product_id', direction: 'down', meaning: 'Each line names one product' },
];
---
<figure class="shop-schema" aria-labelledby="shop-schema-title">
  <div class="schema-title" id="shop-schema-title"><span>Figure 1</span> The facts behind an order</div>
  <div class="schema-paper">
    {tables.map((table, index) => <Fragment>
      {index > 0 && <div class="schema-connection">
        <span class="connection-arrow" aria-hidden="true">{links[index - 1].direction === 'up' ? '↑' : '↓'}</span>
        <div><code>{links[index - 1].column}</code><span class="match"> → </span><code>{links[index - 1].target}</code><small>{links[index - 1].meaning}</small></div>
      </div>}
      <div class="relation">
        <div class="relation-title"><code>{table.name}</code><span>{table.note}</span></div>
        <table aria-label={table.name}>
          <thead><tr>{table.columns.map(([column, key]) => <th scope="col"><code>{column}</code>{key && <small>{key}</small>}</th>)}</tr></thead>
          <tbody>{table.rows.map(row => <tr class:list={{ 'mina-line': table.name === 'order_items' && row[0] === 103, 'mina-order': table.name === 'orders' && row[0] === 103 }}>{row.map((value, column) => <td data-column={[table.columns[column][0], table.columns[column][1]].filter(Boolean).join(' · ')}>{value}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </Fragment>)}
  </div>
  <figcaption>Invented shop rows after order 103 has been stored and its stock taken. Order 103 and its lines are outlined. Arrows point from each foreign key to the key it references. The order’s date and time, payments and other constraints are left out.</figcaption>
</figure>
<style>
  .shop-schema { margin: 2rem 0; }
  .schema-title { margin: 0 0 .75rem; font: 1.2rem/1.4 var(--font-serif); }
  .schema-title > span { margin-right: .6rem; color: var(--color-text-secondary); font: .7rem/1.5 var(--font-mono); text-transform: uppercase; white-space: nowrap; }
  .schema-paper { padding: 1rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface-alt); }
  .relation { min-width: 0; }
  .relation-title { display: flex; align-items: baseline; flex-wrap: wrap; gap: .2rem .8rem; margin-bottom: .55rem; }
  .relation-title > code { font: 600 .85rem/1.5 var(--font-mono); }
  .relation-title > span { color: var(--color-text-secondary); font: .75rem/1.5 var(--font-sans); }
  table { display: table; width: 100%; margin: 0; border-collapse: collapse; font: .82rem/1.6 var(--font-sans); }
  th, td { padding: .5rem .55rem; text-align: left; border-bottom: 1px solid var(--color-rule-strong); }
  th { font-weight: 500; }
  th code { white-space: nowrap; font-size: .72rem; }
  th small { display: block; color: var(--color-accent); font: 600 .65rem/1.5 var(--font-sans); }
  code { padding: 0; background: transparent; color: inherit; }
  .mina-line, .mina-order { outline: 1px solid var(--color-accent); outline-offset: -1px; }
  .schema-connection { display: flex; align-items: center; gap: .8rem; padding: .8rem .5rem; color: var(--color-text); }
  .connection-arrow { color: var(--color-accent); font: 1.8rem/1 var(--font-sans); }
  .schema-connection code { font: .7rem/1.7 var(--font-mono); white-space: nowrap; }
  .match { color: var(--color-accent); }
  .schema-connection small { display: block; color: var(--color-text-secondary); font: .75rem/1.5 var(--font-sans); }
  figcaption { margin-top: .6rem; color: var(--color-text-secondary); font: .78rem/1.65 var(--font-sans); }
  @media (max-width: 550px) {
    .schema-paper { padding: .75rem; }
    .schema-connection { align-items: stretch; }
    .connection-arrow { align-self: center; }
    .schema-connection code { display: block; }
    .match { display: none; }
    .schema-connection code + .match + code::before { content: '→ '; }
    table, tbody { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: .4rem; margin-bottom: .45rem; border: 1px solid var(--color-rule-strong); gap: .4rem .7rem; }
    td { padding: 0; border: 0; }
    td::before { content: attr(data-column); display: block; color: var(--color-text-secondary); font: .65rem/1.5 var(--font-mono); }
    .mina-line, .mina-order { outline-offset: -2px; }
  }
</style>
