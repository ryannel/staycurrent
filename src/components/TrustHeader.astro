---
import { formatDate, isoDate } from '../lib/content';

interface Props {
  slug: string;
  version: number;
  lastResearched: Date;
}
const { slug, version, lastResearched } = Astro.props;
---
<p class="meta trust-header">
  <span class="badge">v{version}</span>
  <span class="sep" aria-hidden="true">·</span>
  <span>researched <time datetime={isoDate(lastResearched)}>{formatDate(lastResearched)}</time></span>
  <span class="sep" aria-hidden="true">·</span>
  <a href={`/${slug}/changelog/`}>changelog</a>
  <span class="sep" aria-hidden="true">·</span>
  <a href={`/${slug}/history/`}>history</a>
</p>
