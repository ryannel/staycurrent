---
import { scene } from './scene.mjs';
---
<figure class="bounce-figure" data-bounce-figure data-variant="story">
  <div class="delight-stage" role="img" aria-label={scene.alt} set:html={scene.render(1)}></div>
  <div class="delight-controls" hidden>
    <button type="button" data-pause aria-label={`Pause animation: ${scene.title}`}>Pause</button>
    <button type="button" data-replay aria-label={`Replay animation: ${scene.title}`}>Replay</button>
  </div>
  <figcaption>Different colours, the same request. Blue and gold join to form the result. The cache keeps a copy; later requests leave the database alone. Motion and timing are illustrative.</figcaption>
</figure>
<script>
  import { scene } from './scene.mjs';
  import { mountScene } from '../delight/player.mjs';
  const cleanups=[...document.querySelectorAll<HTMLElement>('[data-bounce-figure]')].map(root=>mountScene(root,scene));
  document.addEventListener('astro:before-swap',()=>cleanups.forEach(fn=>fn()),{once:true});
</script>
<style is:global>
  .visual-essay.cache-article .bounce-figure { max-width:none; margin:1.2rem 0 2rem; }
  .bounce-figure svg { width:100%; height:auto; overflow:visible; display:block; }
  .bounce-figure .bounce-portrait { display:none; }
  .bounce-figure .delight-controls { display:flex; justify-content:flex-end; gap:.5rem; margin-top:.5rem; }
  .bounce-figure .delight-controls[hidden], .bounce-figure button[hidden] { display:none; }
  .bounce-figure button { min-height:40px; padding:.4rem .7rem; border:0; background:transparent; font:.8rem var(--font-sans); color:var(--color-text-secondary); text-decoration:underline; text-underline-offset:4px; cursor:pointer; }
  .bounce-figure button:hover { color:var(--color-accent); }
  .bounce-figure button:focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; border-radius:3px; }
  .bounce-figure figcaption { max-width:640px; margin:.9rem 0 0; color:var(--color-text-secondary); font:.83rem/1.6 var(--font-sans); }
  @media(min-width:900px) { .visual-essay.cache-article .bounce-figure { width:800px; margin-left:-80px; } }
  @media(max-width:600px) { .bounce-figure .bounce-landscape { display:none; } .bounce-figure .bounce-portrait { display:block; } }
</style>
