<figure class="redis-request" data-redis-request>
  <figcaption><span>Figure 1</span> The answer stays with the application</figcaption>
  <div class="scene">
    <div class="states" data-live>
      <section data-node="app"><b>App A</b><div class="card-slot"><span class="product-card" data-card="app" aria-hidden="true"><svg viewBox="0 0 40 36"><path d="M 7 5 H 27 V 25 Q 17 34 7 25 Z M 27 9 H 32 Q 39 17 27 21"/></svg><span>P7</span></span></div><strong data-app>Waiting for P7</strong><small data-calls>Source reads: 0</small></section>
      <section data-node="cache"><b>Redis</b><div class="card-slot"><span class="product-card" data-card="cache" aria-hidden="true"><svg viewBox="0 0 40 36"><path d="M 7 5 H 27 V 25 Q 17 34 7 25 Z M 27 9 H 32 Q 39 17 27 21"/></svg><span>P7</span></span></div><strong data-cache>No entry</strong><small>Reusable copy</small></section>
      <section data-node="source"><b>Source</b><div class="card-slot"><span class="product-card" data-card="source" aria-hidden="true"><svg viewBox="0 0 40 36"><path d="M 7 5 H 27 V 25 Q 17 34 7 25 Z M 27 9 H 32 Q 39 17 27 21"/></svg><span>P7</span></span></div><strong>GBP 20.00</strong><small>Revision 1</small></section>
    </div>
    <div class="message" data-live>
      <p data-command>Ready to request the card</p>
      <svg viewBox="0 0 600 35" aria-hidden="true"><path data-arrow d="M 100 17 L 300 17" /><path data-head d="M 291 10 L 300 17 L 291 24" /></svg>
      <p data-reply>The source has the product; the cache is empty.</p>
    </div>
    <p class="explanation" data-explanation data-live aria-live="polite">The first caller asks App A for P7. Redis holds no copy yet.</p>
  </div>
  <div class="controls">
    <label>First request <select data-case><option value="normal">Everything succeeds</option><option value="get-fails">GET times out</option><option value="set-fails">SET is rejected</option></select></label>
    <div class="buttons"><button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 7</span></div>
    <div class="hold" data-hold><span></span></div>
  </div>
  <p class="caption">An illustration of the executed adapter branches. P7 abbreviates <code>product:v1:north:P7:en-GB:GBP</code>. Redis never reads the source. Change the failed command and follow what the caller receives.</p>
  <details><summary>Request path as text</summary><ol><li>App A sends GET for P7’s complete key.</li><li>An absent key or temporary cache failure leads to source admission.</li><li>The source returns revision 1 at GBP 20.00.</li><li>App A attempts SET with a 30-second expiry.</li><li>App A returns its source result even when that optional fill fails.</li><li>The next caller gets a cache hit only if a usable copy was stored.</li></ol></details>
</figure>
<script>
import { stepper } from '../../figures/stepper.mjs';
document.querySelectorAll('[data-redis-request]').forEach(root => {
  const select = root.querySelector('[data-case]') as HTMLSelectElement;
  const set = (name: string, text: string) => { root.querySelector(`[data-${name}]`)!.textContent = text; };
  let previous = '';
  let flying: HTMLElement | undefined;
  const state = (step: number) => {
    const getFails = select.value === 'get-fails', setFails = select.value === 'set-fails';
    const rows = [
      ['Waiting for P7','No entry','Ready to request the card','The source has the product; the cache is empty.','The first caller asks App A for P7. Redis holds no copy yet.',0,100,100],
      ['Waiting for Redis','No entry','App A → Redis: GET P7',getFails ? 'The GET wait reaches its limit.' : 'GET replies: no entry.',getFails ? 'A timed-out read gives no usable cached answer. App A records the error and may ask the source only if a source slot is free.' : 'The missing key is a cache miss. App A must obtain the card from its source.',0,100,300],
      ['Waiting for source','No entry','App A → source: read P7','A source slot is available.','App A admits this source read. If the source budget were full, the request would be refused here.',1,100,500],
      ['Holds GBP 20.00','No entry','Source → App A: revision 1','Product: Blue mug · price_pence: 2000','The source has answered. App A now owns the result it will return; saving a copy is a separate operation.',1,500,100],
      ['Holds GBP 20.00',setFails ? 'No entry' : 'GBP 20.00','App A → Redis: SET P7 … EX 30',setFails ? 'SET replies: OOM — copy rejected.' : 'SET replies: OK — copy saved.',setFails ? 'Redis rejects the optional fill. The source result is still in App A, so this cache error does not discard it.' : 'One SET stores both the value and its expiry. The next reader can reuse this copy.',1,100,300],
      ['Returns GBP 20.00',setFails ? 'No entry' : 'GBP 20.00','App A → caller: product card','The first caller receives revision 1.','The answer came from the source in all three runs. Only the existence of a reusable copy differs.',1,100,100],
      [setFails ? 'Needs source again' : 'Returns cache hit',setFails ? 'No entry' : 'GBP 20.00','Next caller: GET P7',setFails ? 'No entry: another admitted source read is needed.' : 'Usable product: no source read needed.',setFails ? 'Repeated fill failures keep sending later requests towards the source. Observe them even though this caller received a successful answer.' : 'The next request decodes and validates the saved card, then returns GBP 20.00 without calling the source.',1,100,300],
    ];
    const row = rows[step];
    const appCard = root.querySelector<HTMLElement>('[data-card="app"]')!;
    const cacheCard = root.querySelector<HTMLElement>('[data-card="cache"]')!;
    appCard.style.opacity = step >= 3 && !(step===6 && setFails) ? '1':'0';
    cacheCard.style.opacity = step >= 4 && !setFails ? '1':'0';
    root.querySelector('[data-node="source"]')!.classList.toggle('idle-source',step===6 && !setFails);
    const version = `${select.value}:${step}`;
    if (version !== previous) {
      flying?.remove(); flying=undefined;
      const journey = step===3 ? ['source','app'] : step===4 ? ['app','cache'] : step===6 && !setFails ? ['cache','app'] : null;
      if (journey && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const scene = root.querySelector<HTMLElement>('.scene')!;
        const fromCard = root.querySelector<HTMLElement>(`[data-card="${journey[0]}"]`)!;
        const toCard = root.querySelector<HTMLElement>(`[data-card="${journey[1]}"]`)!;
        const from = fromCard.getBoundingClientRect(), to = toCard.getBoundingClientRect(), origin = scene.getBoundingClientRect();
        const copy = fromCard.cloneNode(true) as HTMLElement;
        copy.removeAttribute('data-card'); copy.classList.add('flying-card');
        Object.assign(copy.style,{left:`${from.left-origin.left}px`,top:`${from.top-origin.top}px`,opacity:'1'});
        scene.append(copy); flying=copy;
        const dx=to.left-from.left, dy=to.top-from.top;
        const rejected = step===4 && setFails;
        const frames = rejected ? [
          {transform:'translate(0,0) rotate(0deg)',opacity:1},
          {transform:`translate(${dx}px,${dy-15}px) rotate(8deg)`,opacity:1,offset:.65},
          {transform:`translate(${dx*.65}px,${dy+24}px) rotate(-15deg)`,opacity:0}
        ] : [
          {transform:'translate(0,0) rotate(-4deg)',opacity:1},
          {transform:`translate(${dx/2}px,${dy/2-18}px) rotate(3deg)`,opacity:1,offset:.5},
          {transform:`translate(${dx}px,${dy}px) rotate(0deg)`,opacity:0}
        ];
        copy.animate(frames,{duration:950,easing:'ease-in-out',fill:'forwards'}).finished.finally(()=>copy.remove());
      }
      previous=version;
    }
    set('app',String(row[0])); set('cache',String(row[1])); set('command',String(row[2])); set('reply',String(row[3]));
    root.querySelector('[data-explanation]')!.textContent = String(row[4]);
    set('calls',`Source reads so far: ${row[5]}`);
    const from = Number(row[6]), to = Number(row[7]), direction = to >= from ? -1 : 1;
    root.querySelector('[data-arrow]')!.setAttribute('d',`M ${from} 17 L ${to} 17`);
    root.querySelector('[data-head]')!.setAttribute('d',from === to ? '' : `M ${to + direction*10} 9 L ${to} 17 L ${to + direction*10} 25`);
  };
  const player = stepper(root,{steps:()=>7,draw:state});
  select.addEventListener('change',()=>player.render());
});
</script>
<style>
.redis-request{margin:2rem 0;font:.88rem/1.55 var(--font-sans)}
figcaption{font:1.15rem/1.4 var(--font-serif);margin-bottom:.65rem}figcaption span{font:.68rem var(--font-mono);text-transform:uppercase;color:var(--color-text-secondary);margin-right:.6rem}
.card-slot{height:66px;display:flex;justify-content:center;margin-bottom:.6rem}
.product-card{display:flex;flex-direction:column;align-items:center;width:48px;height:62px;box-sizing:border-box;border:2px solid var(--teal);border-radius:5px;background:var(--color-surface);color:var(--color-text);font:12px var(--font-mono);padding:4px}
.product-card svg{width:35px;height:36px}.product-card path{fill:var(--color-surface-alt);stroke:var(--teal);stroke-width:2.5}
[data-card="app"],[data-card="cache"]{opacity:0}
.flying-card{position:absolute;z-index:3;pointer-events:none;box-shadow:0 4px 10px color-mix(in srgb,var(--color-text) 15%,transparent)}
.idle-source{border-style:dashed!important}
.scene{position:relative;border:1px solid var(--color-rule-strong);background:var(--color-surface-alt);padding:1rem}.states{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}.states section{margin:0;border:1px solid var(--color-rule-strong);background:var(--color-surface);padding:.65rem .45rem;min-height:7rem;text-align:center}.states b,.states strong,.states small{display:block}.states b{font-weight:600;margin-bottom:.7rem}.states strong{font-weight:500;color:var(--teal)}.states small{margin-top:.5rem;font-size:.75rem;color:var(--color-text-secondary)}.message{padding:.6rem 0;text-align:center}.message p{margin:.35rem 0;font-size:.85rem}.message svg{display:block;width:100%;height:35px}.message path{stroke:var(--teal);stroke-width:3;fill:none}.explanation{border-left:3px solid var(--teal);padding:.45rem .75rem;margin:.4rem 0 0;font-size:.88rem;min-height:5.4rem}.controls{padding:.8rem;border:1px solid var(--color-rule-strong);border-top:0;background:var(--color-surface)}label{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap}.buttons{display:flex;gap:.45rem;align-items:center;flex-wrap:wrap;margin-top:.7rem}button,select{font:inherit;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule-strong);padding:.45rem .65rem;border-radius:3px}button{cursor:pointer}button[aria-disabled="true"]{color:var(--color-text-secondary)}button:focus-visible,select:focus-visible{outline:2px solid var(--teal);outline-offset:2px}.buttons span{font:.75rem var(--font-mono);margin-left:auto}.hold{height:3px;margin-top:.6rem;background:var(--color-rule)}.hold span{display:block;height:100%;width:0;background:var(--teal)}.caption{color:var(--color-text-secondary);font-size:.82rem;margin:.65rem 0}.caption code{overflow-wrap:anywhere}details{font-size:.83rem}details li{margin:.35rem 0}@media(max-width:500px){.scene{padding:.65rem}.states{gap:.35rem}.states section{padding:.5rem .25rem}.states strong{font-size:.8rem}.explanation{min-height:8rem}}
</style>
