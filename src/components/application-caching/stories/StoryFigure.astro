---
const modules = import.meta.glob('./*.mjs', { eager: true });
const { group, kind, number } = Astro.props;
const scene = (modules[`./${group}.mjs`] as any)?.scenes?.[kind];
if (!scene) throw new Error(`Unknown caching story: ${group}/${kind}`);
const variant = scene.defaultVariant ?? 'story';
---
<figure class="cache-story" data-cache-story data-group={group} data-kind={kind} data-variant={variant}>
  <div class="delight-stage" role="img" aria-label={scene.altFor?.(variant) ?? scene.alt} set:html={scene.render(1, variant)}></div>
  <div class="delight-controls" hidden>
    {scene.actions?.map((action: {value: string; label: string}) => <button type="button" data-variant-action={action.value} aria-pressed={action.value === variant}>{action.label}</button>)}
    <span class="story-playback">
      <button type="button" data-pause aria-label={`Pause animation: ${scene.title}`}>Pause</button>
      <button type="button" data-replay aria-label={`Replay animation: ${scene.title}`}>Replay</button>
    </span>
  </div>
  <figcaption>{number && <span>Figure {number}. </span>}{scene.caption}</figcaption>
</figure>
<script>
  import { mountScene } from '../delight/player.mjs';
  const modules = import.meta.glob('./*.mjs', { eager: true });
  const cleanups = [...document.querySelectorAll<HTMLElement>('[data-cache-story]')].map(root => {
    const scene = (modules[`./${root.dataset.group}.mjs`] as any)?.scenes?.[root.dataset.kind!];
    const unmount = mountScene(root, scene);
    const updateSelection = () => root.querySelectorAll<HTMLButtonElement>('[data-variant-action]').forEach(button => {
      button.setAttribute('aria-pressed', String(button.dataset.variantAction === root.dataset.variant));
    });
    root.addEventListener('click', updateSelection);
    return () => { root.removeEventListener('click', updateSelection); unmount(); };
  });
  document.addEventListener('astro:before-swap', () => cleanups.forEach(cleanup => cleanup()), { once: true });
</script>
<style is:global>
  .visual-essay.cache-article .cache-story { max-width:none; margin:1.5rem 0 2.5rem; }
  .cache-story svg { display:block; width:100%; height:auto; overflow:visible; }
  .cache-story .story-portrait { display:none; }
  .cache-story .delight-controls { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; margin-top:.5rem; }
  .cache-story .story-playback { display:flex; gap:.5rem; margin-left:auto; }
  .cache-story .delight-controls[hidden], .cache-story button[hidden] { display:none; }
  .cache-story button { min-height:40px; padding:.4rem .7rem; border:0; background:transparent; font:.8rem var(--font-sans); color:var(--color-text-secondary); text-decoration:underline; text-underline-offset:4px; cursor:pointer; }
  .cache-story button[aria-pressed="true"] { color:var(--color-text); text-decoration-thickness:2px; }
  .cache-story button:hover { color:var(--color-accent); }
  .cache-story button:focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; border-radius:3px; }
  .cache-story figcaption { max-width:640px; margin:.9rem 0 0; font:.83rem/1.6 var(--font-sans); color:var(--color-text-secondary); }
  @media(min-width:900px) { .visual-essay.cache-article .cache-story { width:800px; margin-left:-80px; } }
  @media(max-width:600px) { .cache-story .story-landscape { display:none; } .cache-story .story-portrait { display:block; } }
</style>
