---
import { scene, stories } from './watch-scenes.mjs';
import './watching.css';
const { kind, number } = Astro.props;
const story = stories[kind];
---
<figure class="cache-watch" data-watch={story.duration ? kind : undefined} data-duration={story.duration}>
  <div class="watch-title"><span>Figure {number}</span><strong>{story.title}</strong></div>
  <div class="watch-drawing" role="img" aria-label={story.alt} set:html={scene(kind, 1)}></div>
  {story.duration > 0 && <div class="watch-player" hidden>
    <span class="watch-progress" aria-hidden="true"><i></i></span>
    <button type="button" data-pause aria-label={`Pause animation: ${story.title}`}>Pause</button>
    <button type="button" data-replay aria-label={`Replay animation: ${story.title}`}>Replay</button>
  </div>}
  <figcaption>{story.caption}</figcaption>
</figure>
<script>
  import { scene } from './watch-scenes.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('[data-watch]')) {
    const kind = root.dataset.watch!;
    const duration = Number(root.dataset.duration);
    const drawing = root.querySelector<HTMLElement>('.watch-drawing')!;
    const player = root.querySelector<HTMLElement>('.watch-player')!;
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
    const progress = root.querySelector<HTMLElement>('.watch-progress i')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let elapsed = 0, last = 0, frame = 0, visible = false, userPaused = false, finished = false;
    const paint = (fraction: number) => {
      drawing.innerHTML = scene(kind, fraction);
      progress.style.width = `${fraction * 100}%`;
      root.dataset.progress = String(fraction);
    };
    const stop = () => { cancelAnimationFrame(frame); frame = 0; last = 0; };
    const tick = (now: number) => {
      if (last) elapsed = Math.min(duration, elapsed + Math.min(now - last, 100));
      last = now; paint(elapsed / duration);
      if (elapsed < duration) frame = requestAnimationFrame(tick);
      else { stop(); finished = true; pause.hidden = true; }
    };
    const start = () => {
      if (!frame && visible && !document.hidden && !userPaused && !finished && !reduced.matches) frame = requestAnimationFrame(tick);
    };
    const preference = () => {
      stop();
      if (reduced.matches) { player.hidden = true; paint(1); }
      else { player.hidden = false; paint(finished ? 1 : elapsed / duration); start(); }
    };
    pause.addEventListener('click', () => {
      userPaused = !userPaused;
      pause.textContent = userPaused ? 'Resume' : 'Pause';
      pause.setAttribute('aria-label', `${userPaused ? 'Resume' : 'Pause'} animation: ${root.querySelector('.watch-title strong')!.textContent}`);
      if (userPaused) stop(); else start();
    });
    replay.addEventListener('click', () => {
      stop(); elapsed = 0; finished = false; userPaused = false;
      pause.hidden = false; pause.textContent = 'Pause';
      pause.setAttribute('aria-label', `Pause animation: ${root.querySelector('.watch-title strong')!.textContent}`);
      paint(0); start();
    });
    let observer: IntersectionObserver;
    const observe = () => {
      observer?.disconnect();
      const threshold = Math.min(.85, Math.max(.1, (innerHeight - 48) / drawing.getBoundingClientRect().height * .85));
      observer = new IntersectionObserver(entries => {
        visible = entries[0].intersectionRatio >= threshold;
        if (visible) start(); else stop();
      }, { threshold: [0, threshold, 1] });
      observer.observe(drawing);
    };
    const visibility = () => document.hidden ? stop() : start();
    observe();
    window.addEventListener('resize', observe);
    document.addEventListener('visibilitychange', visibility);
    reduced.addEventListener('change', preference);
    document.addEventListener('astro:before-swap', () => {
      stop(); observer.disconnect();
      window.removeEventListener('resize', observe);
      document.removeEventListener('visibilitychange', visibility);
      reduced.removeEventListener('change', preference);
    }, { once: true });
    preference();
  }
</script>
