---
import { reads, changes } from './scenes.mjs';
import './intro.css';
const { kind, number } = Astro.props;
const scenes = kind === 'read' ? reads : changes;
const first = scenes[0];
const title = kind === 'read' ? 'Two requests, one source read' : 'Change the source, then remove the copy';
---
<figure class="ci-figure ci-walk" data-kind={kind}>
  <figcaption><span>Figure {number}</span> {title}</figcaption>
  <div class="ci-scene">
    <div class="ci-counters"><div><strong data-reads data-live>{first.reads}</strong><span>source reads in this run</span></div><div><strong data-reply data-live>{first.reply}</strong><span>what the caller receives</span></div></div>
    <div class="ci-app ci-box"><b>App A</b><span data-app data-live>{first.app}</span></div>
    <svg class="ci-routes" viewBox="0 0 600 110" aria-hidden="true">
      <path class="ci-track" d="M 300 8 Q 300 58 150 100 M 300 8 Q 300 58 450 100" />
      <path class="ci-route-active" data-route d="" />
      <g class="ci-courier" data-courier opacity="0"><rect x="-36" y="-17" width="72" height="34" rx="9"/><text text-anchor="middle" y="7" data-parcel>GET</text></g>
    </svg>
    <div class="ci-pair"><div class="ci-box"><b>Cache · saved card</b><span data-cache data-live>{first.cache}</span></div><div class="ci-box"><b>Source · database</b><span data-source data-live>{first.source}</span></div></div>
    <p class="ci-action" data-action data-live>{first.action}</p>
    <p class="ci-explanation" data-explanation data-live aria-live="polite">{first.explanation}</p>
  </div>
  <div class="ci-controls" role="group" aria-label={`Playback for figure ${number}`}><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step>1 / 5</span><div data-hold aria-hidden="true"><span></span></div></div>
  <p class="ci-caption">An illustrative sequence, not a running database. P7 means the north shop’s English card in GBP. Its complete key is <code>product:v1:north:P7:en-GB:GBP</code>.</p>
  <details><summary>Steps as text</summary><ol>{scenes.map(scene => <li>{scene.explanation}</li>)}</ol></details>
</figure>
<script>
  import { stepper } from '../../figures/stepper.mjs';
  import { reads, changes } from './scenes.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('.ci-walk')) {
    const isRead = root.dataset.kind === 'read';
    const scenes = isRead ? reads : changes;
    let lastIndex = -1;
    const courier = root.querySelector<SVGGElement>('[data-courier]')!;
    let flight: Animation | undefined;
    stepper(root, { steps: () => scenes.length, draw: (index: number) => {
      const scene = scenes[index];
      for (const [key, value] of Object.entries(scene)) {
        const el = root.querySelector(`[data-${key}]`);
        if (el) el.textContent = String(value);
      }
      const moves = isRead
        ? [null, ['cache','GET','out'], ['source','P7','round'], ['cache','P7','out'], ['cache','P7','back']]
        : [null, ['source','£22','out'], ['cache','DEL','out'], ['source','P7','round'], ['cache','P7','out']];
      const move = moves[index];
      root.dataset.stage = String(index);
      const track = root.querySelector('[data-route]')!;
      track.setAttribute('d', move ? `M 300 8 Q 300 58 ${move[0] === 'cache' ? 150 : 450} 100` : '');
      if (index !== lastIndex) {
        flight?.cancel();
        courier.setAttribute('opacity','0');
        if (move && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.querySelector('[data-parcel]')!.textContent = move[1];
          const home = 'translate(300px, 8px)', away = `translate(${move[0] === 'cache' ? 150 : 450}px, 91px)`;
          const middle = `translate(${move[0] === 'cache' ? 260 : 340}px, 63px)`;
          const journey = move[2] === 'back' ? [away,middle,home] : move[2] === 'round' ? [home,middle,away,middle,home] : [home,middle,away];
          flight = courier.animate(journey.map((transform,i) => ({transform,opacity:i===0||i===journey.length-1?0:1})),{duration:move[2]==='round'?1300:850,easing:'ease-in-out'});
        }
        lastIndex = index;
      }
    }});
  }
</script>
