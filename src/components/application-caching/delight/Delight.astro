---
import { scenes } from './scenes.mjs';
import './delight.css';
import './reuse-placement.css';
import './identity-change.css';
import './burst-memory.css';
const { kind, number } = Astro.props;
const scene = scenes[kind];
const variant = scene.defaultVariant ?? 'story';
---
<figure class="cache-delight" data-kind={kind} data-variant={variant}>
  <div class="delight-heading"><span>Figure {number}</span><strong>{scene.title}</strong></div>
  <div class="delight-stage" role="img" aria-label={scene.altFor?.(variant) ?? scene.alt} set:html={scene.render(1, variant)}></div>
  <div class="delight-controls" hidden>
    <div class="delight-curiosity">
      {scene.actions?.map(action => <button type="button" data-variant-action={action.value}>{action.label}</button>)}
      {scene.range && <label class="delight-range">
        <span>{scene.range.label}</span>
        <input type="range" min={scene.range.min} max={scene.range.max} step={scene.range.step} value={scene.range.value} aria-label={scene.range.label} aria-valuetext={`${scene.range.value} ${scene.range.unit}`} />
        <output>{scene.range.value} {scene.range.unit}</output>
      </label>}
    </div>
    <div class="delight-playback">
      <button type="button" data-pause aria-label={`Pause animation: ${scene.title}`}>Pause</button>
      <button type="button" data-replay aria-label={`Replay animation: ${scene.title}`}>Replay</button>
    </div>
  </div>
  <figcaption>{scene.caption}</figcaption>
</figure>
<script>
  import { scenes } from './scenes.mjs';
  import { mountScene } from './player.mjs';
  const cleanups = [...document.querySelectorAll<HTMLElement>('.cache-delight')].map(root => mountScene(root, scenes[root.dataset.kind!]));
  document.addEventListener('astro:before-swap', () => cleanups.forEach(cleanup => cleanup()), { once: true });
</script>
