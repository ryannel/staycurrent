---
import { replay, policies } from './model.mjs';
import { names, renderReplay } from '../stories/capacity.mjs';
const defaults = replay();
const readable = (text:string) => text.replace(/\b(P7|P3|P8|P9|P40|Q)\b/g, key => names[key]);
---
<figure class="cache-story" data-memory-replay data-variant="story">
  <div class="replay-options" hidden>
    <label>Retention rule <select data-policy>{Object.entries(policies).map(([value,label])=><option value={value}>{label}</option>)}</select></label>
    <label>Cache budget <select data-capacity><option value="2">2 KiB</option><option value="3" selected>3 KiB</option><option value="5">5 KiB</option><option value="8">8 KiB</option></select></label>
    <label>Largest entry <select data-max-entry><option value="3">3 KiB</option><option value="1">1 KiB</option></select></label>
  </div>
  <div class="delight-stage" role="img" aria-label="A close-up of cache contents. Eighteen requests change from repeated favourites to browsing and then new favourites. The default LRU policy has a three KiB budget and a three KiB entry limit. It finishes with eight cache misses, ten hits and fifty work units saved." set:html={renderReplay(1)}></div>
  <div class="delight-controls" hidden><span class="story-playback"><button type="button" data-pause>Pause</button><button type="button" data-replay>Replay</button></span></div>
  <figcaption><span>Figure 4. </span>A close-up of retention after the server obtains each answer. The same requests compete for space under every setting; widths show charged bytes.</figcaption>
  <details>
    <summary>Model assumptions and the default trace</summary>
    <p>This is an invented sequential trace. Each product card costs 1 KiB; the catalogue result costs 3 KiB. A miss costs two source-work units, except the bowl (12) and the catalogue (20). The units are illustrative costs, not measured latency. Each fill completes before the next request; there are no updates, expiry or failures. Charged sizes include the model’s overhead and are not Redis measurements.</p>
    <p>LRU removes the resident with the oldest last access. LFU counts uses since admission, including the fill, and removes the lowest count; ties use LRU. Its counts never decay. Second request admits a key seen in the preceding eight requests, then uses LRU. That bounded history costs memory outside the entry budget. An answer exceeding either size limit is returned without being stored.</p>
    <ol>{defaults.slice(1).map(step=><li>{readable(step.text)} Residents: {step.residents.map(item=>names[item.id]).join(', ') || 'empty'}. Hits: {step.hits}; source reads: {step.reads}.</li>)}</ol>
  </details>
</figure>
<script>
  import { mountScene } from '../delight/player.mjs';
  import { renderReplay } from '../stories/capacity.mjs';
  import { replay } from './model.mjs';
  const cleanups = [...document.querySelectorAll<HTMLElement>('[data-memory-replay]')].map(root => {
    root.querySelector<HTMLElement>('.replay-options')!.hidden=false;
    const policy=root.querySelector<HTMLSelectElement>('[data-policy]')!;
    const capacity=root.querySelector<HTMLSelectElement>('[data-capacity]')!;
    const maxEntry=root.querySelector<HTMLSelectElement>('[data-max-entry]')!;
    let stop=()=>{};
    const start=()=>{
      stop();
      const options={policy:policy.value,capacity:Number(capacity.value),maxEntry:Number(maxEntry.value)};
      const result=replay(options).at(-1)!;
      const alt=`A close-up of cache retention after the server obtains each missed answer. Eighteen requests, using ${policy.selectedOptions[0].textContent}, a ${capacity.value} KiB cache budget and ${maxEntry.value} KiB entry limit. The run finishes with ${result.reads} cache misses, ${result.hits} hits and ${result.saved} source-work units saved.`;
      root.querySelector('.delight-stage')!.setAttribute('aria-label',alt);
      const pause=root.querySelector<HTMLButtonElement>('[data-pause]')!;
      pause.hidden=false;pause.textContent='Pause';pause.setAttribute('aria-label','Pause animation: Which answers keep their place?');
      stop=mountScene(root,{title:'Which answers keep their place?',duration:24000,alt,render:(t:number)=>renderReplay(t,options)});
    };
    const choices=[policy,capacity,maxEntry];
    choices.forEach(choice=>choice.addEventListener('change',start));
    start();
    return()=>{stop();choices.forEach(choice=>choice.removeEventListener('change',start));};
  });
  document.addEventListener('astro:before-swap',()=>cleanups.forEach(stop=>stop()),{once:true});
</script>
<style>
  .replay-options[hidden] { display:none; }
  .replay-options { display:flex; flex-wrap:wrap; gap:.8rem 1.5rem; margin-bottom:1.25rem; }
  .replay-options label { display:flex; flex-direction:column; gap:.3rem; font:.8rem var(--font-sans); color:var(--color-text-secondary); }
  select { min-height:42px; max-width:100%; border:1px solid var(--color-rule-strong); border-radius:5px; padding:.35rem .5rem; color:var(--color-text); background:var(--color-surface); font:.9rem var(--font-sans); }
  select:focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; }
  details { margin-top:1rem; font:.84rem/1.65 var(--font-sans); color:var(--color-text-secondary); }
  summary { cursor:pointer; }
  details ol { padding-left:1.5rem; }
  @media(max-width:600px) { .replay-options { display:grid; grid-template-columns:1fr 1fr; }.replay-options label:first-child { grid-column:1 / -1; } }
</style>
