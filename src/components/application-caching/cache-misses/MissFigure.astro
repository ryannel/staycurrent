---
// Pilot figures for Handling cache misses, in the ink-and-tokens house style.
// Playback reuses the shared caching player; variants are text tabs at the bottom left,
// Pause and Replay text links at the bottom right, and the caption is the only title.
import { scenes } from './scenes.mjs';
import './cache-misses.css';
const { kind, number } = Astro.props;
const scene = (scenes as any)[kind];
if (!scene) throw new Error(`Unknown cache-misses figure: ${kind}`);
const variant = scene.defaultVariant ?? 'story';
---
<figure class="miss-figure" data-miss-figure data-kind={kind} data-variant={variant}>
  <div class="delight-stage" role="img" aria-label={scene.altFor?.(variant) ?? scene.alt} set:html={scene.render(1, variant)}></div>
  <div class="delight-controls" hidden>
    <span class="miss-variants">
      {scene.actions?.map((action: { value: string; label: string }) => <button type="button" data-variant-action={action.value} aria-pressed={String(action.value === variant)}>{action.label}</button>)}
    </span>
    <span class="miss-playback">
      <button type="button" data-pause aria-label={`Pause animation: ${scene.title}`}>Pause</button>
      <button type="button" data-replay aria-label={`Replay animation: ${scene.title}`}>Replay</button>
    </span>
  </div>
  <figcaption><span>Figure {number}. </span>{scene.caption}</figcaption>
  <details class="miss-text"><summary>Figure as text</summary><p>{scene.textAlternative}</p></details>
</figure>
<script>
  import { scenes } from './scenes.mjs';
  import { mountScene } from '../delight/player.mjs';
  const cleanups = [...document.querySelectorAll<HTMLElement>('[data-miss-figure]')].map(root => {
    const scene = (scenes as any)[root.dataset.kind!];
    const unmount = mountScene(root, scene);
    const sync = () => root.querySelectorAll<HTMLButtonElement>('[data-variant-action]').forEach(button => {
      button.setAttribute('aria-pressed', String(button.dataset.variantAction === root.dataset.variant));
    });
    root.addEventListener('click', sync);
    return () => { root.removeEventListener('click', sync); unmount(); };
  });
  document.addEventListener('astro:before-swap', () => cleanups.forEach(cleanup => cleanup()), { once: true });
</script>
