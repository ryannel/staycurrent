---
import { scene } from './scene.mjs';
import './work.css';
---
<figure class="work-figure" data-work-figure data-variant="story">
  <div class="work-kicker">Five requests. The same blue mug.</div>
  <div class="delight-stage" role="img" aria-label={scene.alt} set:html={scene.render(1)}></div>
  <div class="delight-controls" hidden>
    <button type="button" data-pause aria-label={`Pause animation: ${scene.title}`}>Pause</button>
    <button type="button" data-replay aria-label={`Replay animation: ${scene.title}`}>Replay</button>
  </div>
  <figcaption>The server checks Redis before doing the work. The first check misses; later checks find the saved card. Redis is one cache implementation. These are repeated requests within one cache lifetime, with no product change. Timing is illustrative.</figcaption>
</figure>
<script>
  import { scene } from './scene.mjs';
  import { mountScene } from '../delight/player.mjs';
  const cleanups = [...document.querySelectorAll<HTMLElement>('[data-work-figure]')].map(root => mountScene(root,scene));
  document.addEventListener('astro:before-swap',()=>cleanups.forEach(cleanup=>cleanup()),{once:true});
</script>
