---
interface Props { number: number; title: string; id?: string; }
const { number, title, id } = Astro.props;
---
<figure class="value-figure" id={id} aria-label={`Figure ${number}: ${title}`}>
  <figcaption class="value-heading"><span>Figure {number}</span> {title}</figcaption>
  <div class="value-scene"><slot /></div>
  <div class="value-caption"><slot name="caption" /></div>
</figure>

<style is:global>
  .value-figure { margin:2.5rem 0; }
  .value-heading { display:flex; flex-wrap:wrap; align-items:baseline; gap:.5rem .8rem; margin-bottom:.8rem; font:500 1.18rem/1.4 var(--font-serif); }
  .value-heading > span { font:.68rem/1.5 var(--font-sans); color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:.1em; }
  .value-scene { background:var(--color-surface-alt); border:1px solid var(--color-rule-strong); padding:1.1rem; font:.84rem/1.6 var(--font-sans); }
  .value-scene p { font:inherit; margin:.5rem 0; }
  .value-caption { margin-top:.7rem; color:var(--color-text-secondary); font:.8rem/1.65 var(--font-sans); }
  .value-caption p { font:inherit; margin:.5rem 0; }
  .value-scene .value-label { display:block; color:var(--color-text-secondary); font-size:.73rem; margin-bottom:.45rem; }
  .value-scene .value-big { display:block; font:500 1.35rem/1.4 var(--font-mono); overflow-wrap:anywhere; }
  .value-scene code { font-size:.94em; overflow-wrap:anywhere; }
  .value-cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.7rem; }
  .value-card { min-width:0; padding:.85rem; border:1px solid var(--color-rule-strong); background:var(--color-surface); }
  .value-card > strong { display:block; }
  .value-rail { border-left:3px solid var(--teal); padding:.4rem .8rem; margin-top:.8rem; }
  .value-flow { display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); gap:.7rem; align-items:center; margin:.7rem 0; }
  .value-arrow { font-size:1.4rem; color:var(--color-text-secondary); }
  .value-branch { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.8rem; margin:.8rem 0; }
  .value-path { border-left:3px solid var(--blue); padding:.7rem .9rem; background:var(--color-surface); }
  .value-path p { margin:.25rem 0; }
  .value-result { margin-top:.7rem; border-top:1px solid var(--color-rule-strong); padding-top:.7rem; }
  .value-scene .value-detail { font-size:.74rem; color:var(--color-text-secondary); }
  .value-scene .value-rule { border:1px solid var(--color-rule-strong); padding:.7rem .8rem; text-align:center; background:var(--color-surface); }
  .value-player { display:flex; align-items:center; flex-wrap:wrap; gap:.5rem; margin-top:.9rem; }
  .value-scene button,.value-scene select { color:var(--color-text); background:var(--color-surface); border:1px solid var(--color-rule-strong); border-radius:3px; font:inherit; min-height:44px; padding:.5rem .7rem; cursor:pointer; max-width:100%; }
  .value-scene button:hover,.value-scene select:hover { border-color:var(--color-accent); }
  .value-scene button[aria-disabled="true"] { color:var(--color-text-secondary); cursor:default; }
  .value-scene :focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
  .value-hold { height:3px; background:var(--color-rule); margin-top:.7rem; }
  .value-hold > span { display:block; height:100%; width:0; background:var(--color-accent); }
  .value-count { margin-left:auto; font: .75rem var(--font-mono); }
  @media(max-width:550px) { .value-scene { padding:.85rem; } .value-cards,.value-branch { grid-template-columns:1fr; } .value-flow { grid-template-columns:1fr; gap:.4rem; } .value-arrow { transform:rotate(90deg); justify-self:center; } }
</style>
