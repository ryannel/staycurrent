---
import Figure from './Figure.astro';
import { packages, filters, truthLabel } from './model.mjs';
---
<Figure number={7} title="A missing weight through a filter" id="weight-filter">
  <div data-weight-filter>
    <label class="value-label" for="weight-predicate">Question</label>
    <select id="weight-predicate" data-filter>{filters.map(filter => <option value={filter.key}>{filter.label}</option>)}</select>
    <p class="filter-sql"><code data-query data-live>WHERE package_weight_g &gt;= 100</code></p>
    <div class="weight-grid" role="table" aria-label="Products, predicate results and WHERE decisions">
      <div class="weight-row weight-header" role="row"><span role="columnheader">Stored weight</span><span role="columnheader">Predicate</span><span role="columnheader">WHERE</span></div>
      {packages.map(row => <div class="weight-row" role="row" data-product={row.id}>
        <div role="cell"><strong>{row.id}</strong> <span class="weight-measure">{row.weight === null ? 'NULL' : `${row.weight} g`}</span><span class="value-detail">{row.weight === null ? 'Not yet measured' : row.name}</span></div>
        <div role="cell" data-truth data-live>—</div><div role="cell" data-decision data-live>—</div>
      </div>)}
    </div>
    <div class="value-rail" data-explanation data-live aria-live="polite">Three products have a row. P7’s row has no measured package weight.</div>
    <div class="value-player" role="group" aria-label="Figure 7 playback">
      <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span class="value-count" data-step>1 / 3</span>
    </div>
    <div class="value-hold" data-hold aria-hidden="true"><span></span></div>
    <details class="weight-text"><summary>All filter results, as text</summary>
      <p>Each filter is applied to all three rows. WHERE keeps only true.</p>
      <ul>{filters.map(filter => <li><code>{filter.sql}</code>: {packages.map((row,i)=> `${row.id}: ${truthLabel(filter.values[i])}`).join('; ')}. Kept: {packages.filter((row,i)=>filter.values[i] === true).map(row=>row.id).join(', ') || 'no rows'}.</li>)}</ul>
    </details>
  </div>
  <p slot="caption">Step from stored weights to predicate results to the rows kept. Then change the question. The three stages explain the result; they do not claim a physical execution order inside PostgreSQL.</p>
</Figure>

<script>
  import { stepper } from '../figures/stepper.mjs';
  import { packages, filters, truthLabel } from './model.mjs';
  document.querySelectorAll<HTMLElement>('[data-weight-filter]').forEach(root => {
    const select = root.querySelector<HTMLSelectElement>('[data-filter]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-product]')];
    const player = stepper(root, { steps: () => 3, draw: (step: number) => {
      const filter = filters.find(f => f.key === select.value)!;
      root.querySelector('[data-query]')!.textContent = `WHERE ${filter.sql}`;
      rows.forEach((row,i) => {
        const value = filter.values[i];
        row.querySelector('[data-truth]')!.textContent = step > 0 ? truthLabel(value) : '—';
        row.querySelector('[data-decision]')!.textContent = step > 1 ? value === true ? 'Keep' : 'Leave out' : '—';
        row.dataset.kept = step > 1 ? String(value === true) : '';
      });
      const kept = packages.filter((row,i)=>filter.values[i]===true).map(row=>row.id);
      root.querySelector('[data-explanation]')!.textContent = step === 0
        ? 'Three products have a row. P7’s row has no measured package weight.'
        : step === 1 ? filter.explanation
        : `WHERE keeps only true. ${kept.length ? `The result contains ${kept.join(' and ')}.` : 'No row passes this filter.'} False and unknown are both left out.`;
    }});
    select.addEventListener('change', () => player.render());
  });
</script>

<style>
  .filter-sql { min-height:3.8rem; display:flex; align-items:center; }
  .weight-grid { border-block:1px solid var(--color-rule-strong); margin:1rem 0; }
  .weight-row { display:grid; grid-template-columns:1.3fr 1fr 1fr; gap:.5rem; padding:.8rem .3rem; border-bottom:1px solid var(--color-rule); }
  .weight-row:last-child { border-bottom:0; }
  .weight-header { color:var(--color-text-secondary); font-size:.74rem; }
  .weight-row .value-detail { display:block; }
  .weight-measure { display:block; font:1rem/1.5 var(--font-mono); }
  .weight-row[data-kept="true"] { background:color-mix(in srgb,var(--teal) 12%,transparent); box-shadow:inset 3px 0 var(--teal); }
  .weight-row [data-truth],.weight-row [data-decision] { align-self:center; overflow-wrap:anywhere; }
  .weight-text { margin-top:1rem; color:var(--color-text-secondary); font:.77rem/1.6 var(--font-sans); }
  .weight-text summary { cursor:pointer; }
  .weight-text ul { padding-left:1.2rem; }
  @media(max-width:550px) { .weight-row { grid-template-columns:1.15fr 1fr 1fr; font-size:.77rem; gap:.35rem; } }
</style>
