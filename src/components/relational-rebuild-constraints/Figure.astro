---
import { figures } from './model.mjs';
const { kind } = Astro.props;
const f = figures[kind];
const options = f.options.map(()=>0);
const first = f.draw(0, options);
---
<figure class="cf" data-constraint-figure={kind} aria-labelledby={`cf-${kind}-title`}>
 <figcaption id={`cf-${kind}-title`}><span>Figure {f.number}</span> {f.title}</figcaption>
 <div class="cf-stage" data-scene data-live set:html={first.html}></div>
 <p class="cf-explanation" data-explanation data-live aria-live="polite">{first.explanation}</p>
 {f.steps > 1 && <div class="cf-controls">
  {f.options.map((option,i)=><label>{option.label}<select data-option={i}>{option.values.map(v=><option>{v}</option>)}</select></label>)}
  <div class="cf-playback" role="group" aria-label={`Figure ${f.number} playback`}>
   <button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / {f.steps}</span>
  </div>
  <div data-hold class="cf-hold" aria-hidden="true"><span></span></div>
 </div>}
 <p class="cf-caption">{f.caption}</p>
 {f.steps > 1 && <details><summary>All steps as text</summary>{f.options.length>0&&<p>Steps below use the initial choices. Change the controls to compare the other rule.</p>}<ol>{Array.from({length:f.steps},(_,s)=><li>{f.draw(s,options).explanation}</li>)}</ol></details>}
</figure>
<script>
 import { figures } from './model.mjs';
 import { stepper } from '../figures/stepper.mjs';
 document.querySelectorAll('[data-constraint-figure]').forEach(root=>{
  const f=figures[root.getAttribute('data-constraint-figure')];
  if (f.steps === 1) return;
  const selects=[...root.querySelectorAll('select')];
  const player=stepper(root,{steps:()=>f.steps,draw:s=>{
   const state=f.draw(s,selects.map(x=>x.selectedIndex));
   root.querySelector('[data-scene]').innerHTML=state.html;
   root.querySelector('[data-explanation]').textContent=state.explanation;
  }});
  selects.forEach(x=>x.addEventListener('change',()=>player.render()));
 });
</script>
<style is:global>
 .cf { margin:2.2rem 0; font:.86rem/1.6 var(--font-sans); }
 .cf figcaption { margin:0 0 .65rem; font:1.1rem/1.5 var(--font-serif); }
 .cf figcaption > span { color:var(--color-text-secondary); font:.68rem var(--font-sans); text-transform:uppercase; letter-spacing:.09em; margin-right:.6rem; }
 .cf-stage { border:1px solid var(--color-rule-strong); background:var(--color-surface-alt); padding:1rem; }
 .cf-box { padding:.75rem; border:1px solid var(--color-text-secondary); background:var(--color-surface); }
 .cf-box > strong { display:block; font-size:.82rem; font-weight:600; }
 .cf-box p { margin:.5rem 0 0; font:inherit; }
 .cf-value { font:1.1rem/1.8 var(--font-mono); }
 .cf-flow { padding:.5rem; text-align:center; color:var(--color-text-secondary); }
 .cf-pair { display:flex; gap:.7rem; flex-wrap:wrap; margin:.6rem 0 0; }
 .cf-pair span { padding:.4rem; border:1px solid var(--color-text-secondary); }
 .cf-stage table { width:100%; margin:.5rem 0 1rem; border-collapse:collapse; font:inherit; display:table; }
 .cf-stage table:last-child { margin-bottom:0; }
 .cf-stage caption { text-align:left; color:var(--color-text-secondary); font-size:.8rem; margin-bottom:.3rem; }
 .cf-stage th,.cf-stage td { text-align:left; padding:.4rem; border-bottom:1px solid var(--color-rule-strong); }
 .cf-stage th { font-weight:600; }
 .cf-verdict { padding:.4rem .5rem; border-left:3px solid var(--color-text-secondary); }
 .cf-good { border-color:var(--teal); }
 .cf-bad { border-color:var(--coral); }
 .cf-columns { display:grid; grid-template-columns:1fr 1fr; gap:.7rem; margin:.8rem 0; }
 .cf-explanation { font:inherit !important; min-height:5.5em; margin:0 !important; padding:.8rem 1rem; border:1px solid var(--color-rule-strong); border-top:0; border-left:3px solid var(--teal); background:var(--color-surface-alt); }
 .cf-controls { padding:.75rem; border:1px solid var(--color-rule-strong); border-top:0; background:var(--color-surface); }
 .cf-controls label { display:inline-flex; align-items:center; flex-wrap:wrap; gap:.5rem; margin:0 .5rem .7rem 0; }
 .cf-controls select,.cf-controls button { color:var(--color-text); background:var(--color-surface); border:1px solid var(--color-text-secondary); border-radius:4px; font:inherit; padding:.45rem .65rem; }
 .cf-controls button { cursor:pointer; min-height:40px; }
 .cf-controls :is(button,select):focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
 .cf-controls button[aria-disabled="true"] { color:var(--color-text-secondary); border-style:dashed; }
 .cf-playback { display:flex; gap:.4rem; flex-wrap:wrap; align-items:center; }
 .cf-playback [data-step] { margin-left:auto; color:var(--color-text-secondary); font-size:.78rem; }
 .cf-hold { height:2px; background:var(--color-rule); margin-top:.65rem; }
 .cf-hold span { display:block; height:100%; width:0; background:var(--teal); }
 .cf[data-constraint-figure="quantity"] .cf-explanation,.cf[data-constraint-figure="tenant"] .cf-explanation { min-height:0; }
 .cf-caption { font:.8rem/1.65 var(--font-sans) !important; color:var(--color-text-secondary); margin:.6rem 0 !important; }
 .cf details { font:.8rem/1.65 var(--font-sans); margin:.65rem 0; }
 .cf summary { cursor:pointer; color:var(--color-accent); }
 .cf details p,.cf details li { font:inherit; }
 @media(max-width:550px) { .cf-columns { grid-template-columns:1fr; } .cf-stage { padding:.7rem; } .cf-stage th,.cf-stage td { padding:.35rem .2rem; } .cf-playback { gap:.3rem; } .cf-controls button { padding:.4rem .55rem; } .cf-explanation { min-height:8.5em; } }
</style>
