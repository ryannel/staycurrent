---
import { indexSteps } from './model';
---
<figure class="schema-figure" data-index-build aria-labelledby="schema-index-title">
 <figcaption id="schema-index-title"><span class="figure-number">Figure 1</span> New entries before new reads</figcaption>
 <div class="schema-scene">
  <p class="schema-kind">Illustrative index build · logical current values</p>
  <p class="schema-phase" data-phase data-live>{indexSteps[0].phase}</p>
  <div class="schema-pair">
   <div class="schema-box"><p class="schema-label">Products · primary index</p><div class="schema-record"><span>P3</span><span>4.50</span></div><div class="schema-record" data-product><span>P7</span><span data-price data-live>20.00</span></div><div class="schema-record"><span>P9</span><span>35.00</span></div></div>
   <div class="schema-box"><p class="schema-label">New index · price, product key</p><div class="schema-entries" data-entries data-live><p>No index yet</p></div></div>
  </div>
  <div class="schema-capabilities"><p data-writes data-live>{indexSteps[0].writes}</p><p data-reads data-live>{indexSteps[0].reads}</p></div>
  <p class="schema-explanation" data-explanation data-live aria-live="polite">{indexSteps[0].note}</p>
 </div>
 <div class="schema-controls" role="group" aria-label="Figure 1 controls"><button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 7</span></div><div class="schema-hold" data-hold aria-hidden="true"><span></span></div>
 <p class="schema-caption">A possible ordering for a non-unique price index. Labels stand for encoded keys; retained MVCC versions, internal merge stages, ranges and timings are omitted. This is a teaching model, not a trace of the native run.</p>
 <details><summary>All stages, as text</summary><ol>{indexSteps.map(s=><li><strong>{s.phase}.</strong> {s.note}</li>)}</ol></details>
</figure>
<script>
 import {stepper} from '../figures/stepper.mjs';
 import {indexSteps} from './model';
 document.querySelectorAll('[data-index-build]').forEach(root=>stepper(root,{steps:()=>indexSteps.length,draw:n=>{
  const s=indexSteps[n];root.querySelector('[data-phase]').textContent=s.phase;root.querySelector('[data-price]').textContent=s.price;
  root.querySelector('[data-product]').classList.toggle('schema-highlight',n===4);
  const entries=root.querySelector('[data-entries]'); entries.replaceChildren(...(s.entries.length?s.entries:[n===0?'No index yet':'No entries yet']).map(text=>{const el=document.createElement('p');el.textContent=text;return el;}));
  root.querySelector('[data-writes]').textContent=s.writes;root.querySelector('[data-reads]').textContent=s.reads;root.querySelector('[data-explanation]').textContent=s.note;
 }}));
</script>
