---
import Figure from './Figure.astro';
import {orderState,pair,polygon,cardWorld} from './model.mjs';
import {compose} from '../geometry.mjs';
---
<Figure number={6} title="Pan then zoom? Read the product" caption="Predict which arrow will grow as zoom changes. Both panels use the same card and world point (130, 140). In T(pan) S(zoom), scaling happens first; S(zoom) T(pan) scales the pan as well. Illustrative model in V units." text="At zoom 2, T(pan) S(zoom) gives V (320,320), while S(zoom) T(pan) gives (380,360). The first pan arrow stays (60,40); the second is (120,80).">
  <div data-order-figure>
    <div class="controls"><label>Zoom <input type="range" min="0.5" max="3" step="0.5" value="2" data-order-zoom /></label><label>Emphasise order<select data-order-choice><option value="0">T(pan) S(zoom)</option><option value="1">S(zoom) T(pan)</option></select></label><button type="button" data-order-reset>Reset</button></div>
    <output data-order-summary aria-live="polite">Zoom 2. The emphasised T(pan) S(zoom) gives pV (320, 320); the pan arrow stays (60, 40).</output>
    <p class="axis-caption">Both plots use V axes: x rightwards, y downwards. Arrows show the pan; dots mark p.</p>
    <div class="panels">{[false,true].map((swapped,i)=>{const s=orderState(2,swapped);return <div class="panel" data-order-panel={i} style={i===0?'outline:2px solid var(--color-text)':''}><p class="panel-label">{swapped?'S(zoom) T(pan)':'T(pan) S(zoom)'}</p><p data-order-result>pV {pair(s.point)} · pan arrow {pair(s.pan)}</p><svg viewBox="-20 -20 660 800" role="img" aria-label={`${swapped?'Scaled':'Fixed'} pan in view space`}><defs><marker id={`panhead-${i}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="currentColor" /></marker></defs><path class="ink" d="M0 200V0H200"/><path data-pan-arrow class="ink" marker-end={`url(#panhead-${i})`} d={`M0,0 L${s.origin.x},${s.origin.y}`}/><polygon data-order-card class="paper" points={polygon(compose(s.matrix,cardWorld))}/><circle data-order-mark class="mark" cx={s.point.x} cy={s.point.y} r="6"/></svg></div>})}</div>
  </div>
</Figure>
<script>
import {orderState,pair,polygon,cardWorld} from './model.mjs';
import {compose} from '../geometry.mjs';
document.querySelectorAll<HTMLElement>('[data-order-figure]').forEach(host=>{
 const zoom=host.querySelector<HTMLInputElement>('[data-order-zoom]')!, choice=host.querySelector<HTMLSelectElement>('[data-order-choice]')!;
 function render(){const z=Number(zoom.value);host.querySelectorAll<HTMLElement>('[data-order-panel]').forEach((panel,i)=>{const s=orderState(z,i===1);panel.style.outline=i===Number(choice.value)?'2px solid var(--color-text)':'none';panel.querySelector('[data-order-card]')!.setAttribute('points',polygon(compose(s.matrix,cardWorld)));const mark=panel.querySelector('[data-order-mark]')!;mark.setAttribute('cx',String(s.point.x));mark.setAttribute('cy',String(s.point.y));panel.querySelector('[data-pan-arrow]')!.setAttribute('d',`M0,0 L${s.origin.x},${s.origin.y}`);panel.querySelector('[data-order-result]')!.textContent=`pV ${pair(s.point)} · pan arrow ${pair(s.pan)}`;});const s=orderState(z,choice.value==='1');host.querySelector('[data-order-summary]')!.textContent=`Zoom ${z}. The emphasised ${choice.value==='1'?'S(zoom) T(pan)':'T(pan) S(zoom)'} gives pV ${pair(s.point)}; pan arrow ${pair(s.pan)}.`;}
 zoom.addEventListener('input',render);choice.addEventListener('change',render);host.querySelector('[data-order-reset]')!.addEventListener('click',()=>{zoom.value='2';choice.value='0';render();});render();
});
</script>

<style>.axis-caption{font-size:.8rem;line-height:1.5;margin:.7rem 0;}[data-order-summary]{margin-bottom:.5rem;}[data-order-result]{margin-bottom:.4rem!important;}</style>
