---
import Figure from './Figure.astro';
import {polygon,pivotState,pair,card} from './model.mjs';
const options=[{name:'About card origin',centre:false},{name:'About card centre',centre:true}];
---
<Figure number={3} title="Pivot comparison" caption="Both cards turn 90° clockwise before their placement in G. The dashed outline is the starting card; the cross is the chosen fixed point. The centre stays at G (70, 40) only in the card-centre case. Illustrative model." text="Around the origin, the card centre moves from G (70,40) to (10,60). Around the centre, it stays at (70,40).">
  <div class="panels">{options.map(o=>{const s=pivotState(o.centre);return <div class="panel"><p class="panel-label">{o.name}</p><svg viewBox="-30 -15 175 150" role="img" aria-label={o.name}><polygon points={polygon(card)} class="ink" stroke-dasharray="4 4"/><polygon points={polygon(s.matrix)} class="paper"/><path class="ink" d={`M${s.pivot.x-7},${s.pivot.y}h14 M${s.pivot.x},${s.pivot.y-7}v14`}/><circle class="mark" cx={s.centre.x} cy={s.centre.y} r="3"/><text x="-22" y="127">G coordinates</text></svg><p>Centre after turn: {pair(s.centre)}.</p></div>})}</div>
</Figure>
