---
import Figure from './Figure.astro';
import { example, spaces } from '../example.mjs';
import { card,group,cardWorld,cardView,cardClient,pair } from './model.mjs';
import {point,displacement,identity} from '../geometry.mjs';
const matrices=[identity(),card,cardWorld,cardView,cardClient];
const labels=['Stored on Review','Add card placement','Turn and place Review lane','Zoom, then pan the board','Fit and place the SVG'];
---
<Figure number={1} title="Space ladder" caption="One spot on Review, named five ways. Each miniature draws the card’s local axes as they appear in that space; the drawing scale is adjusted to keep them legible. Coordinates are the worked model, not this page’s browser positions." text="The marked point is O (10,10), G (40,30), W (130,140), V (320,320), then C (440,400). Its card x-axis points downwards after the group’s quarter-turn; its card y-axis points leftwards.">
  <ol class="ladder">{spaces.map((s,i)=>{
    const m=matrices[i], x=displacement(m,{x:1,y:0}), y=displacement(m,{x:0,y:1}), length=Math.hypot(x.x,x.y);
    const xend={x:45+40*x.x/length,y:65+40*x.y/length},yend={x:45+32*y.x/length,y:65+32*y.y/length};
    return <li><div><strong>{s.id} · {s.name}</strong><span>{labels[i]}</span></div><svg viewBox="0 0 130 125" role="img" aria-label={`Card axes in ${s.name} space`}><path class="ink" d={`M${xend.x},${xend.y} L45,65 L${yend.x},${yend.y}`} /><text x={xend.x+4} y={xend.y+4}>x</text><text x={yend.x+4} y={yend.y-6}>y</text><circle class="mark" cx={45+(x.x+y.x)*18/length} cy={65+(x.y+y.y)*18/length} r="4"/><text x="6" y="117">p{s.id} {pair(s.point)}</text></svg></li>;
  })}</ol>
</Figure>
<style>.ladder{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.5rem;}.ladder li{border:1px solid var(--color-rule);padding:.5rem;min-width:0;}.ladder strong{font-size:.85rem;}.ladder span{display:block;font-size:.72rem;line-height:1.45;min-height:3em;margin-top:.3rem;}@media(max-width:700px){.ladder{grid-template-columns:1fr;}.ladder li{display:grid;grid-template-columns:1fr 130px;align-items:center;}.ladder span{min-height:0;}.ladder svg{width:130px;}}</style>
