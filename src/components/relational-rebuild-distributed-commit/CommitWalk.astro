---
import {commitPaths} from './model.mjs';
---
<figure class="dc-figure dc-walk" aria-labelledby="dc-walk-title" data-commit-walk>
  <figcaption id="dc-walk-title"><span class="dc-number">Figure 2</span> Prepare, record, then notify</figcaption>
  <div class="dc-panel">
    <label class="dc-choice">P’s vote <select data-vote><option value="ready">Prepared</option><option value="refuse">Cannot prepare</option></select></label>
    <p class="dc-legend">Solid arrows: delivered · dashed arrows: later in the walk</p>
    <div class="dc-ladder" aria-label="Messages between A, the coordinator and P">
      <div class="dc-lanes"><b>A<small>Order + lines</small></b><b>Coordinator<small>Joint decision</small></b><b>P<small>Shared stock</small></b></div>
      <div class="dc-message dc-left dc-to-left" data-at="1"><span>Prepare</span><i aria-hidden="true">←</i></div>
      <div class="dc-message dc-right" data-at="1"><span>Prepare</span><i aria-hidden="true">→</i></div>
      <div class="dc-message dc-left" data-at="2"><span>A: Prepared</span><i aria-hidden="true">→</i></div>
      <div class="dc-message dc-right dc-to-left" data-at="3"><span data-p-vote data-live>P: Prepared</span><i aria-hidden="true">←</i></div>
      <div class="dc-record-decision" data-at="4"><span data-live data-decision-label>Store COMMIT durably</span></div>
      <div class="dc-message dc-left dc-to-left" data-at="5"><span data-notify data-live>COMMIT</span><i aria-hidden="true">←</i></div>
      <div class="dc-message dc-right" data-at="6"><span data-notify data-live>COMMIT</span><i aria-hidden="true">→</i></div>
    </div>
    <p class="dc-record-label">Prepared and final records · durable before sending</p>
    <div class="dc-records">
      <div><b>A</b><strong data-a data-live>Working</strong></div>
      <div><b>Decision</b><strong data-c data-live>No final decision</strong></div>
      <div><b>P</b><strong data-p data-live>Working</strong></div>
    </div>
    <p class="dc-client" data-client data-live>No outcome learnt</p>
    <p class="dc-explanation" data-explanation data-live aria-live="polite">{commitPaths.ready[0].explanation}</p>
    <div class="dc-hold" data-hold aria-hidden="true"><span></span></div>
    <div class="dc-controls" role="group" aria-label="Figure 2 playback">
      <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 8</span>
    </div>
  </div>
  <p class="dc-caption">An illustrative two-phase commit schedule. Arrows show message direction; rows show order, not elapsed time. A and P retain provisional work before preparing. For clarity, the model sends outcome notifications to both and waits for both to finish before replying. Participant replica messages are omitted.</p>
  <details class="dc-alternative"><summary>Both paths as text</summary>{Object.entries(commitPaths).map(([key,steps])=><div><p><b>{key === 'ready' ? 'Both prepare' : 'P refuses'}</b></p><ol>{steps.map(s=><li>{s.explanation}</li>)}</ol></div>)}</details>
</figure>
<script>
  import {stepper} from '../figures/stepper.mjs';
  import {commitPaths} from './model.mjs';
  document.querySelectorAll('[data-commit-walk]').forEach(root=>{
    const select=root.querySelector('[data-vote]');
    const draw=(index)=>{
      const mode=select.value;
      const stage=commitPaths[mode][index];
      for (const key of ['a','p','c','client']) root.querySelector(`[data-${key}]`).textContent=stage[key];
      const outcome=mode==='ready'?'COMMIT':'ABORT';
      root.querySelector('[data-p-vote]').textContent=mode==='ready'?'P: Prepared':'P: Cannot prepare';
      root.querySelector('[data-decision-label]').textContent=`Store ${outcome} durably`;
      root.querySelectorAll('[data-notify]').forEach(n=>n.textContent=outcome);
      root.querySelectorAll('[data-at]').forEach(n=>{n.dataset.seen=String(Number(n.dataset.at)<=index);n.dataset.active=String(Number(n.dataset.at)===index);});
      root.querySelector('[data-explanation]').textContent=stage.explanation;
    };
    const player=stepper(root,{steps:()=>commitPaths[select.value].length,draw});
    select.addEventListener('change',()=>{root.querySelector('[data-reset]').click();player.render();});
  });
</script>
