---
import { scene, specs } from './model.mjs';
interface Props { kind: keyof typeof specs; number: number; }
const {kind,number} = Astro.props;
const spec = specs[kind];
const variant = spec.options[0]?.value || '';
const initial = scene(kind,variant,0);
const alternatives = spec.options.length ? spec.options : [{value:'',label:'Steps'}];
---
<figure class="ri-figure wide" data-ri-figure data-kind={kind} aria-labelledby={`ri-title-${kind}`}>
  <figcaption id={`ri-title-${kind}`}><span>Figure {number}</span><strong>{spec.title}</strong></figcaption>
  <div class="ri-frame">
    <div class="ri-scene" data-scene data-live set:html={initial.html} />
    <p class="ri-explanation" data-explanation data-live aria-live="polite">{initial.text}</p>
    <div class="ri-controls">
      {spec.options.length > 0 && <label class="ri-option">Compare <select data-option aria-label={`Comparison for figure ${number}`}>{spec.options.map(o => <option value={o.value}>{o.label}</option>)}</select></label>}
      <div class="ri-buttons" role="group" aria-label={`Playback for figure ${number}`}>
        <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / {spec.count}</span>
      </div>
      <div class="ri-hold" data-hold aria-hidden="true"><span /></div>
    </div>
  </div>
  <p class="ri-note">{spec.note}</p>
  <details class="ri-alternative"><summary>Figure as text</summary>{alternatives.map(o => <div><strong>{o.label}</strong><ol>{Array.from({length:spec.count},(_,i) => <li>{scene(kind,o.value,i).text}</li>)}</ol></div>)}</details>
</figure>

<script>
  import { stepper } from '../figures/stepper.mjs';
  import { scene, specs } from './model.mjs';
  document.querySelectorAll<HTMLElement>('[data-ri-figure]').forEach(root => {
    const kind = root.dataset.kind as keyof typeof specs;
    const select = root.querySelector<HTMLSelectElement>('[data-option]');
    const player = stepper(root, {
      steps: () => specs[kind].count,
      draw: step => {
        const state = scene(kind, select?.value || '', step);
        root.querySelector('[data-scene]')!.innerHTML = state.html;
        root.querySelector('[data-explanation]')!.textContent = state.text;
      }
    });
    select?.addEventListener('change', () => { root.querySelector<HTMLButtonElement>('[data-reset]')!.click(); player.render(); });
  });
</script>

<style is:global>
  .ri-figure { width:min(850px,calc(100vw - 2rem)); margin-top:2rem; margin-bottom:2rem; font:.83rem/1.6 var(--font-sans); }
  .ri-figure figcaption { display:flex; align-items:baseline; flex-wrap:wrap; gap:.5rem 1rem; padding:.75rem 0; color:var(--color-text); }
  .ri-figure figcaption > span { font:.68rem var(--font-mono); text-transform:uppercase; color:var(--color-text-secondary); }
  .ri-figure figcaption > strong { font:500 1.15rem var(--font-serif); }
  .ri-frame { border:1px solid var(--color-rule-strong); background:var(--color-surface-alt); }
  .ri-scene { padding:1.2rem; }
  .ri-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .ri-table-wrap { max-width:100%; overflow:auto; }
  .ri-figure table { display:table; margin:0; width:100%; border-collapse:collapse; font:.75rem/1.5 var(--font-sans); }
  .ri-figure caption { text-align:left; font:600 .75rem var(--font-mono); color:var(--color-text); padding:0 0 .65rem; }
  .ri-figure th,.ri-figure td { text-align:left; padding:.45rem; border-bottom:1px solid var(--color-rule-strong); white-space:nowrap; }
  .ri-figure th { font:500 .69rem var(--font-mono); color:var(--color-text-secondary); }
  .ri-match { background:color-mix(in srgb,var(--teal) 13%,var(--color-surface)); outline:2px solid var(--teal); outline-offset:-2px; }
  .ri-panel { padding:1rem; border:1px solid var(--color-rule-strong); background:var(--color-surface); min-width:0; }
  .ri-panel p { margin:.6rem 0; font:inherit; }
  .ri-panel .ri-grid { gap:.5rem; }
  .ri-label { display:block; margin-bottom:.7rem; font:.74rem var(--font-mono); }
  .ri-status { margin-bottom:1rem; font:600 .8rem var(--font-sans); color:var(--color-text); }
  .ri-stock { display:grid; gap:.7rem; }
  .ri-stock > div { display:grid; grid-template-columns:1fr auto; align-items:baseline; column-gap:.8rem; border-bottom:1px solid var(--color-rule); padding-bottom:.4rem; }
  .ri-stock b { font:500 1.8rem var(--font-mono); }
  .ri-stock small { grid-column:2; font:.68rem var(--font-sans); }
  .ri-order b,.ri-order span { display:block; }
  .ri-order span { font-size:.72rem; color:var(--color-text-secondary); margin:.3rem 0; }
  .ri-order ul { margin:.8rem 0 0; padding-left:1rem; font-size:.75rem; }
  .ri-empty { color:var(--color-text-secondary); }
  .ri-payment,.ri-outcome { margin-top:1rem; padding-top:.75rem; border-top:1px solid var(--color-rule-strong); font:.78rem/1.6 var(--font-sans); }
  .ri-arrow { text-align:center; margin:1rem 0; font:.8rem/1.6 var(--font-sans); color:var(--color-text); }
  .ri-arrow > span { margin-left:.4rem; }
  .ri-active { border:2px solid var(--teal) !important; }
  .ri-race { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .ri-lane > strong { display:block; font:.8rem var(--font-sans); margin-bottom:.8rem; }
  .ri-event { padding:.65rem .65rem .65rem 2rem; position:relative; min-height:4.7rem; border:1px solid var(--color-rule-strong); margin-bottom:.45rem; background:var(--color-surface); font:.75rem/1.55 var(--font-sans); }
  .ri-event > span { position:absolute; left:.6rem; color:var(--color-text-secondary); font:.7rem var(--font-mono); top:.8rem; }
  .ri-future { border-style:dashed; background:transparent; }
  .ri-scan { display:flex; gap:.4rem; flex-wrap:wrap; }
  .ri-scan > span { display:block; padding:.5rem; border:1px dashed var(--color-rule-strong); font:1rem var(--font-mono); }
  .ri-scan small { display:block; font:.65rem var(--font-sans); }
  .ri-visited { border:2px solid var(--teal) !important; }
  .ri-explanation { margin:.2rem 1.2rem 1.2rem; border-left:3px solid var(--teal); padding:.5rem 0 .5rem .8rem; font:.83rem/1.7 var(--font-sans); min-height:5.7em; }
  .ri-controls { padding:1rem; border-top:1px solid var(--color-rule-strong); background:var(--color-surface); }
  .ri-buttons { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
  .ri-figure button,.ri-figure select { font:.8rem var(--font-sans); color:var(--color-text); background:var(--color-surface); border:1px solid var(--color-text-secondary); padding:.6rem .7rem; min-height:42px; border-radius:4px; cursor:pointer; }
  .ri-figure button[aria-disabled="true"] { color:var(--color-text-secondary); border-style:dashed; cursor:default; }
  .ri-figure button[data-play] { font-weight:600; border-width:2px; }
  .ri-figure [data-step] { margin-left:auto; color:var(--color-text-secondary); font:.7rem var(--font-mono); }
  .ri-option { display:flex; gap:.7rem; align-items:center; flex-wrap:wrap; margin-bottom:.8rem; font:.75rem var(--font-sans); }
  .ri-figure select { max-width:100%; }
  .ri-hold { height:3px; margin-top:.7rem; background:var(--color-rule); }
  .ri-hold > span { display:block; width:0; height:100%; background:var(--teal); }
  .ri-note { margin:.7rem 0; font:.75rem/1.6 var(--font-sans); color:var(--color-text-secondary); }
  .ri-alternative { font:.75rem/1.65 var(--font-sans); }
  .ri-alternative summary { cursor:pointer; width:fit-content; color:var(--color-accent); }
  .ri-alternative li { margin:.5rem 0; }
  .ri-figure :focus-visible { outline:3px solid var(--color-accent); outline-offset:4px; }
  @media(max-width:600px) { .ri-figure th,.ri-figure td { padding:.45rem .3rem; } .ri-figure th { white-space:normal; } .ri-figure td { white-space:normal; } .ri-grid { grid-template-columns:1fr; } .ri-scene { padding:.8rem; } .ri-race { gap:.5rem; } .ri-event { padding:.6rem .4rem .6rem 1.5rem; min-height:7rem; overflow-wrap:anywhere; } .ri-event > span { left:.35rem; } .ri-explanation { margin:.2rem .8rem .8rem; } .ri-panel .ri-grid { grid-template-columns:1fr; } .ri-table-wrap { scrollbar-width:thin; } }
</style>
