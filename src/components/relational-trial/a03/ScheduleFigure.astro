---
import { scenarios, figureOptions, protectLabel, verdict } from './model.mjs';
import { scheduleView } from './schedule-view.mjs';
interface Props { mode: 'schedule' | 'protect'; number: number; title: string; caption: string }
const { mode, number, title, caption } = Astro.props;
const choices = figureOptions[mode];
const firstScenario = Object.keys(choices)[0];
const firstOption = choices[firstScenario][0];
const optionLabel = (scenario: string, option: string) => mode === 'schedule'
  ? scenarios[scenario].options[option].label
  : (protectLabel[option] ?? scenarios[scenario].options[option].protection);
const view = scheduleView(firstScenario, firstOption, 0);
const id = `a03-${mode}`;
const summary = Object.entries(choices).flatMap(([scenario, options]) => options.map(option =>
  `${scenarios[scenario].label}, ${optionLabel(scenario, option).toLowerCase()}: ${verdict(scenario, scenarios[scenario].options[option].steps.at(-1).state).text}`));
const optionData = JSON.stringify(Object.fromEntries(Object.entries(choices).map(([scenario, options]) => [scenario, options.map(option => [option, optionLabel(scenario, option)])])));
---
<figure class="a03-schedule" data-a03-schedule data-options={optionData} aria-labelledby={`${id}-title`}>
  <figcaption><span class="eyebrow">Figure {number} · illustrative schedule, replayed on PostgreSQL 18.6</span><strong id={`${id}-title`}>{title}</strong></figcaption>
  <div class="controls choices">
    <label>Example <select data-scenario>{Object.keys(choices).map(scenario => <option value={scenario}>{scenarios[scenario].label}</option>)}</select></label>
    <label>{mode === 'schedule' ? 'Schedule' : 'Protection'} <select data-option>{choices[firstScenario].map(option => <option value={option}>{optionLabel(firstScenario, option)}</option>)}</select></label>
  </div>
  <p class="rule" data-live>Rule: <span data-rule>{view.rule}</span></p>
  <div class="schedule" role="region" tabindex="0" aria-label="Schedule of the two transactions">
    <table>
      <thead><tr><th scope="col" class="n">Step</th><th scope="col" data-a-head>{view.a}</th><th scope="col" data-b-head>{view.b}</th>{view.headings.map(h => <th scope="col" class="st" data-state-head>{h}</th>)}</tr></thead>
      <tbody data-rows data-live>{view.rows.map(row => <tr aria-current={row.current ? 'step' : undefined} class="idle"><th scope="row" class="n">{row.label}</th><td data-label={view.a}>{row.a}</td><td data-label={view.b}>{row.b}</td>{row.state.map((cell, i) => <td class="st" data-label={view.headings[i]}>{cell}</td>)}</tr>)}</tbody>
    </table>
  </div>
  <p class="outcome" data-outcome data-live hidden></p>
  <p class="explanation" data-explanation data-live aria-live="polite">{view.note}</p>
  <div class="controls transport"><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / {view.count}</span><span class="hold" data-hold aria-hidden="true"><span></span></span></div>
  <p class="caption">{caption}</p>
  <details><summary>Read this figure as text</summary><ul>{summary.map(line => <li>{line}</li>)}</ul></details>
</figure>
<script>
  import { stepper } from '../../figures/stepper.mjs';
  import { scheduleView } from './schedule-view.mjs';
  document.querySelectorAll<HTMLElement>('[data-a03-schedule]').forEach(root => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const options = JSON.parse(root.dataset.options!) as Record<string, [string, string][]>;
    const scenario = q<HTMLSelectElement>('[data-scenario]');
    const option = q<HTMLSelectElement>('[data-option]');
    const el = (tag: string, text: string, attrs: Record<string, string> = {}) => { const node = document.createElement(tag); node.textContent = text; for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v); return node; };
    const draw = (step: number) => {
      const view = scheduleView(scenario.value, option.value, step);
      q('[data-rule]').textContent = view.rule;
      q('[data-a-head]').textContent = view.a;
      q('[data-b-head]').textContent = view.b;
      root.querySelectorAll('[data-state-head]').forEach(th => th.remove());
      const headRow = q('thead tr');
      for (const h of view.headings) headRow.append(el('th', h, { scope: 'col', class: 'st', 'data-state-head': '' }));
      q('[data-rows]').replaceChildren(...view.rows.map(row => {
        const tr = document.createElement('tr');
        if (row.current) tr.setAttribute('aria-current', 'step');
        tr.append(el('th', row.label, { scope: 'row', class: 'n' }));
        for (const [who, text, label] of [['A', row.a, view.a], ['B', row.b, view.b]] as const) {
          const td = el('td', text, { 'data-label': label });
          if (!text) td.classList.add('empty');
          if (row.who === who && row.waits) td.classList.add('waits');
          if (text === 'still waiting') td.classList.add('waits');
          if (row.who === who && row.error) td.classList.add('error');
          tr.append(td);
        }
        row.state.forEach((cell, i) => { const td = el('td', cell, { 'data-label': view.headings[i] }); td.className = 'st' + (row.changed ? ' changed' : ''); tr.append(td); });
        return tr;
      }));
      const outcome = q('[data-outcome]');
      outcome.hidden = !view.outcome;
      outcome.textContent = view.outcome ? view.outcome.text : '';
      outcome.classList.toggle('problem', Boolean(view.outcome && !view.outcome.holds));
      q('[data-explanation]').textContent = view.note;
    };
    stepper(root, { steps: () => scheduleView(scenario.value, option.value, 0).count, draw });
    // A new example or option starts again from its first step. The stepper's
    // Reset control stops playback, returns to step 0 and redraws.
    const restart = () => q('[data-reset]').click();
    scenario.addEventListener('change', () => {
      option.replaceChildren(...options[scenario.value].map(([value, label]) => el('option', label, { value })));
      restart();
    });
    option.addEventListener('change', restart);
  });
</script>
<style is:global>
  figure.a03-schedule { --a03-warn: color-mix(in srgb, var(--coral) 72%, var(--color-text)); margin: 2rem 0; border: 1px solid var(--color-rule); padding: 1.2rem; background: var(--color-surface-alt); }
  figure.a03-schedule figcaption strong, figure.a03-schedule figcaption span { display: block; } figure.a03-schedule figcaption strong { font-size: 1.1rem; }
  figure.a03-schedule .controls { display: flex; gap: .5rem .9rem; align-items: center; flex-wrap: wrap; margin: 1rem 0; }
  figure.a03-schedule label { min-width: 0; max-width: 100%; display: flex; align-items: center; gap: .5rem; font-size: .8rem; flex-wrap: wrap; }
  figure.a03-schedule button, figure.a03-schedule select { font: inherit; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-rule-strong); border-radius: .3rem; padding: .45rem .7rem; cursor: pointer; max-width: 100%; }
  figure.a03-schedule .transport { font-size: .8rem; }
  figure.a03-schedule button[aria-disabled="true"] { opacity: .45; cursor: default; }
  figure.a03-schedule button:focus-visible, figure.a03-schedule select:focus-visible, figure.a03-schedule .schedule:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  figure.a03-schedule .rule { margin: 0 0 .6rem; font-size: .85rem; font-weight: 600; }
  figure.a03-schedule .schedule { overflow-x: auto; background: var(--color-surface); border: 1px solid var(--color-rule); }
  figure.a03-schedule table { display: table; width: 100%; margin: 0; border-collapse: collapse; font-size: .8rem; }
  figure.a03-schedule th, figure.a03-schedule td { border: 0; border-bottom: 1px solid var(--color-rule); padding: .45rem .55rem; text-align: left; vertical-align: top; }
  figure.a03-schedule thead th { font-size: .74rem; background: none; }
  figure.a03-schedule .n { width: 3rem; font-weight: 600; }
  figure.a03-schedule .st { width: 6.5rem; font-family: var(--font-mono); font-size: .78rem; }
  figure.a03-schedule thead .st { font-family: var(--font-sans); }
  figure.a03-schedule tr[aria-current="step"] { background: color-mix(in srgb, var(--color-accent) 9%, var(--color-surface)); }
  figure.a03-schedule tr[aria-current="step"] .n { box-shadow: inset 3px 0 var(--color-accent); }
  figure.a03-schedule .changed { font-weight: 700; color: var(--color-accent-strong); }
  figure.a03-schedule .waits { font-style: italic; }
  figure.a03-schedule .error { color: var(--a03-warn); font-weight: 600; }
  figure.a03-schedule .outcome { margin: 1rem 0 .4rem; padding: .6rem .8rem; border-inline-start: 3px solid var(--color-accent); background: var(--color-surface); font-size: .9rem; font-weight: 600; }
  figure.a03-schedule .outcome.problem { border-color: var(--coral); color: var(--a03-warn); }
  figure.a03-schedule .outcome[hidden] { display: none; }
  figure.a03-schedule .explanation { min-height: 3.2rem; font-size: .9rem; margin: .8rem 0 0; }
  figure.a03-schedule .hold { flex: 0 0 4rem; height: 3px; background: var(--color-rule); } figure.a03-schedule .hold span { display: block; height: 100%; width: 0; background: var(--color-accent); }
  figure.a03-schedule .caption, figure.a03-schedule details { font-size: .8rem; color: var(--color-text-secondary); } figure.a03-schedule summary { cursor: pointer; } figure.a03-schedule details ul { margin: .5rem 0 0; padding-left: 1.1rem; }
  figure.a03-schedule .transport [data-step] { padding: 0; border: 0; margin: 0; min-width: 0; display: inline; }
  @media (max-width: 600px) {
    figure.a03-schedule { padding: .8rem; }
    figure.a03-schedule thead { display: none; }
    figure.a03-schedule table, figure.a03-schedule tbody, figure.a03-schedule tr, figure.a03-schedule th, figure.a03-schedule td { display: block; width: auto; }
    figure.a03-schedule tr { padding: .45rem .5rem; border-bottom: 1px solid var(--color-rule); }
    figure.a03-schedule th, figure.a03-schedule td { border: 0; padding: .1rem 0; }
    figure.a03-schedule td.empty { display: none; }
    figure.a03-schedule td::before { content: attr(data-label) ': '; font-family: var(--font-sans); font-weight: 600; font-size: .72rem; color: var(--color-text-secondary); }
    figure.a03-schedule .st { display: inline-block; width: auto; margin-right: .9rem; }
    figure.a03-schedule .n { width: auto; font-size: .74rem; }
    figure.a03-schedule .n::before { content: 'Step '; } figure.a03-schedule tbody tr:first-child .n::before { content: ''; }
  }
</style>
