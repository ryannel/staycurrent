---
import { versionOptions, versionSql, versionFrames } from './model.mjs';
interface Props { number: number }
const { number } = Astro.props;
const first = versionFrames('select')[0];
const all = Object.fromEntries(versionOptions.map(([id]) => [id, versionFrames(id)]));
const statusText = { committed: 'committed', pending: 'not committed', old: 'old version' } as Record<string, string>;
---
<figure class="a03-versions" data-a03-versions data-frames={JSON.stringify(all)} data-sql={JSON.stringify(versionSql)} aria-labelledby="a03-versions-title">
  <figcaption><span class="eyebrow">Figure {number} · a model of row versions; the waits and results were observed on PostgreSQL 18.6 at Read Committed</span><strong id="a03-versions-title">What B’s statement sees while A’s change is pending</strong></figcaption>
  <div class="controls"><label>B runs <select data-choice>{versionOptions.map(([id, label]) => <option value={id}>{label}</option>)}</select></label></div>
  <pre class="sql" data-sql-text data-live>{versionSql.select}</pre>
  <p class="frame-title" data-title data-live>{first.title}</p>
  <div class="layout">
    <div class="row-box" aria-label="Versions of the class 21 row">
      <p class="head">Class 21 row, <code>remaining</code></p>
      <ol data-versions data-live>{first.versions.map(v => <li class={v.status}><span class="value">{v.value}</span><span class="status">{statusText[v.status]}</span><span class="by">{v.by}</span></li>)}</ol>
    </div>
    <dl class="sessions">
      <div><dt>A · Mina’s booking</dt><dd data-a data-live>{first.a}</dd></div>
      <div><dt>B · Tariq’s statement</dt><dd data-b data-live>{first.b}</dd></div>
    </dl>
  </div>
  <p class="explanation" data-explanation data-live aria-live="polite">{first.note}</p>
  <div class="controls transport"><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 5</span><span class="hold" data-hold aria-hidden="true"><span></span></span></div>
  <p class="caption">PostgreSQL keeps more than one version of a changed row. The diagram simplifies version storage to a list.</p>
  <details><summary>Read this figure as text</summary>
    <p>A updates class 21 from 1 to 0 and has not committed. Then B runs one of three statements.</p>
    <ul>
      <li>Ordinary SELECT: returns 1 at once, without waiting or locking. After A commits, a new SELECT returns 0.</li>
      <li>SELECT … FOR UPDATE: waits for A. When A commits, it returns 0 and holds the row lock.</li>
      <li>Conditional UPDATE … WHERE remaining &gt; 0: waits for A. When A commits, it rechecks the condition against 0 and changes no row.</li>
    </ul>
  </details>
</figure>
<script>
  import { stepper } from '../../figures/stepper.mjs';
  document.querySelectorAll<HTMLElement>('[data-a03-versions]').forEach(root => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const frames = JSON.parse(root.dataset.frames!);
    const sql = JSON.parse(root.dataset.sql!);
    const choice = q<HTMLSelectElement>('[data-choice]');
    const statusText: Record<string, string> = { committed: 'committed', pending: 'not committed', old: 'old version' };
    const span = (cls: string, text: string) => { const s = document.createElement('span'); s.className = cls; s.textContent = text; return s; };
    const draw = (step: number) => {
      const f = frames[choice.value][step];
      q('[data-sql-text]').textContent = sql[choice.value];
      q('[data-title]').textContent = f.title;
      q('[data-versions]').replaceChildren(...f.versions.map((v: any) => { const li = document.createElement('li'); li.className = v.status; li.append(span('value', String(v.value)), span('status', statusText[v.status]), span('by', v.by)); return li; }));
      q('[data-a]').textContent = f.a;
      const b = q('[data-b]');
      b.textContent = f.b;
      b.classList.toggle('waits', Boolean(f.wait));
      b.classList.toggle('done', Boolean(f.done));
      q('[data-explanation]').textContent = f.note;
    };
    stepper(root, { steps: () => frames[choice.value].length, draw });
    // A new choice starts again from the first frame, through the Reset control.
    choice.addEventListener('change', () => q('[data-reset]').click());
  });
</script>
<style is:global>
  figure.a03-versions { margin: 2rem 0; border: 1px solid var(--color-rule); padding: 1.2rem; background: var(--color-surface-alt); }
  figure.a03-versions figcaption span, figure.a03-versions figcaption strong { display: block; } figure.a03-versions figcaption strong { font-size: 1.1rem; }
  figure.a03-versions .controls { display: flex; gap: .5rem .9rem; align-items: center; flex-wrap: wrap; margin: 1rem 0; }
  figure.a03-versions label { display: flex; gap: .5rem; align-items: center; font-size: .8rem; flex-wrap: wrap; max-width: 100%; }
  figure.a03-versions button, figure.a03-versions select { font: inherit; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-rule-strong); border-radius: .3rem; padding: .45rem .7rem; cursor: pointer; max-width: 100%; }
  figure.a03-versions .transport { font-size: .8rem; }
  figure.a03-versions button[aria-disabled="true"] { opacity: .45; cursor: default; }
  figure.a03-versions button:focus-visible, figure.a03-versions select:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  figure.a03-versions .sql { margin: 0 0 1rem; padding: .6rem .8rem; background: var(--color-surface); border: 1px solid var(--color-rule); font: .78rem/1.5 var(--font-mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  figure.a03-versions .frame-title { font-weight: 700; margin: 0 0 .6rem; }
  figure.a03-versions .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 1rem; align-items: start; }
  figure.a03-versions .row-box { border: 1px solid var(--color-rule-strong); background: var(--color-surface); padding: .7rem; }
  figure.a03-versions .head { margin: 0 0 .5rem; font-size: .8rem; font-weight: 600; }
  figure.a03-versions ol { list-style: none; margin: 0; padding: 0; display: grid; gap: .4rem; }
  figure.a03-versions li { display: grid; grid-template-columns: 2.2rem 1fr; column-gap: .6rem; padding: .45rem .55rem; border: 1px solid var(--color-rule); font-size: .78rem; }
  figure.a03-versions li .value { grid-row: span 2; font: 700 1.3rem/1.2 var(--font-mono); }
  figure.a03-versions li .status { font-weight: 600; } figure.a03-versions li .by { color: var(--color-text-secondary); }
  figure.a03-versions li.committed { border-color: var(--color-accent); box-shadow: inset 3px 0 var(--color-accent); }
  figure.a03-versions li.pending { border-style: dashed; border-color: var(--color-text-secondary); }
  figure.a03-versions li.old .value, figure.a03-versions li.old .status { color: var(--color-text-secondary); } figure.a03-versions li.old .value { text-decoration: line-through; }
  figure.a03-versions .sessions { margin: 0; display: grid; gap: .6rem; }
  figure.a03-versions .sessions div { border: 1px solid var(--color-rule); background: var(--color-surface); padding: .55rem .7rem; }
  figure.a03-versions dt { font-size: .74rem; font-weight: 600; color: var(--color-text-secondary); }
  figure.a03-versions dd { margin: .2rem 0 0; font-size: .86rem; }
  figure.a03-versions dd.waits { font-style: italic; } figure.a03-versions dd.done { font-weight: 700; color: var(--color-accent-strong); }
  figure.a03-versions .explanation { min-height: 3.2rem; font-size: .9rem; margin: 1rem 0 0; }
  figure.a03-versions .hold { flex: 0 0 4rem; height: 3px; background: var(--color-rule); } figure.a03-versions .hold span { display: block; height: 100%; width: 0; background: var(--color-accent); }
  figure.a03-versions .caption, figure.a03-versions details { font-size: .8rem; color: var(--color-text-secondary); } figure.a03-versions summary { cursor: pointer; } figure.a03-versions details ul { padding-left: 1.1rem; }
  figure.a03-versions .transport [data-step] { padding: 0; border: 0; margin: 0; min-width: 0; display: inline; }
  @media (max-width: 600px) { figure.a03-versions { padding: .8rem; } figure.a03-versions .layout { grid-template-columns: minmax(0, 1fr); } }
</style>
