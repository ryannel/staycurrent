---
// Figure 3: Mina and Tariq both try to buy the last blue mug. Each option's six
// steps were replayed in two PostgreSQL 18.6 sessions by verify.mjs.
import { raceOptions, raceSteps } from './model.mjs';
import './figures.css';

const first = raceSteps(raceOptions[0].key);
const s0 = first[0];
---
<figure class="a00-figure" data-a00-race aria-labelledby="a00-race-title">
  <figcaption id="a00-race-title"><span class="a00-label">Figure 3</span> Two transactions want the last blue mug</figcaption>
  <fieldset class="a00-options">
    <legend>How each transaction takes the mug</legend>
    <div class="a00-choices">
      {raceOptions.map((o, n) => <label><input type="radio" name="a00-race" value={o.key} checked={n === 0} /> {o.label}</label>)}
    </div>
  </fieldset>
  <div class="a00-sent">
    <p class="a00-who"><span data-live data-actor>{s0.actor}</span> sends</p>
    <pre data-live data-sql>{s0.sql}</pre>
    <p class="a00-who">Result: <code data-live data-result>{s0.result}</code></p>
  </div>
  <div class="a00-lanes">
    <div class="a00-lane"><p class="a00-lane-title">Mina’s transaction</p><p data-live data-mina>{s0.mina}</p></div>
    <div class="a00-lane"><p class="a00-lane-title">Tariq’s transaction</p><p data-live data-tariq>{s0.tariq}</p></div>
    <div class="a00-lane"><p class="a00-lane-title">Committed, visible to everyone</p>
      <p>P7 stock: <strong data-live data-stock>{s0.committed.stock}</strong></p>
      <p>Orders holding the mug: <strong data-live data-holders>{s0.committed.holders.join(', ') || 'none'}</strong></p>
    </div>
  </div>
  <p class="a00-explanation" data-live data-explanation aria-live="polite">{s0.text}</p>
  <div class="a00-controls" aria-label="Step through the race">
    <button type="button" data-play>Play</button>
    <button type="button" data-back aria-disabled="true">Back</button>
    <button type="button" data-next>Next</button>
    <button type="button" data-reset>Reset</button>
    <span data-step>1 / {first.length}</span>
    <span class="a00-hold" data-hold aria-hidden="true"><span></span></span>
  </div>
  <p class="a00-note">Observed: every statement and result in each option was replayed in two concurrent sessions against PostgreSQL 18.6 by the article’s verification script, which waited for the reported lock before continuing. A highlighted value changed at this step. The INSERT statements are shortened; the stock row is the part that matters.</p>
  <details>
    <summary>Read this figure as text</summary>
    {raceOptions.map(o => (
      <>
        <p><strong>{o.label}</strong></p>
        <ol>{raceSteps(o.key).map(s => <li>{s.actor}: {s.sql.replace(/\s+/g, ' ')} Result: {s.result}. Committed stock {s.committed.stock}; orders holding the mug: {s.committed.holders.join(', ') || 'none'}. {s.text}</li>)}</ol>
      </>
    ))}
  </details>
</figure>

<style>
  .a00-sent { padding: .6rem .75rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface); }
  .a00-sent pre { margin: .3rem 0; padding: .5rem .6rem; background: var(--color-code-bg); color: var(--color-text); font: .76rem/1.5 var(--font-mono); white-space: pre-wrap; overflow-wrap: anywhere; border: 0; }
  .a00-who { margin: 0; font: .8rem/1.4 var(--font-sans); color: var(--color-text-secondary); }
  .a00-who code { color: var(--color-text); overflow-wrap: anywhere; }
  .a00-lanes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; margin-top: .7rem; }
  .a00-lane { padding: .55rem .65rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface); font: .82rem/1.45 var(--font-sans); min-width: 0; }
  .a00-lane p { margin: .2rem 0; }
  .a00-lane-title { font-weight: 600; color: var(--color-text-secondary); font-size: .74rem; text-transform: uppercase; letter-spacing: .03em; }
  .a00-lane-title { margin-bottom: .35rem !important; }
  @media (max-width: 640px) { .a00-lanes { grid-template-columns: 1fr; } }
</style>

<script>
  import { stepper } from '../../figures/stepper.mjs';
  import { raceSteps } from './model.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('[data-a00-race]')) {
    const choice = () => root.querySelector<HTMLInputElement>('input[name="a00-race"]:checked')!.value;
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-${name}]`)!;
    const put = (name: string, value: string, prev: string | undefined) => {
      const el = field(name);
      el.textContent = value;
      el.classList.toggle('a00-changed', prev !== undefined && prev !== value);
    };
    const draw = (step: number) => {
      const all = raceSteps(choice());
      const s = all[step];
      const p = step > 0 ? all[step - 1] : undefined;
      put('actor', s.actor, undefined);
      put('sql', s.sql, undefined);
      put('result', s.result, undefined);
      put('mina', s.mina, p?.mina);
      put('tariq', s.tariq, p?.tariq);
      put('stock', String(s.committed.stock), p && String(p.committed.stock));
      put('holders', s.committed.holders.join(', ') || 'none', p && (p.committed.holders.join(', ') || 'none'));
      field('explanation').textContent = s.text;
      field('result').classList.toggle('a00-bad', /ERROR/.test(s.result));
      field('result').classList.toggle('a00-wait', /Waiting/.test(s.result));
    };
    const control = stepper(root, { steps: () => raceSteps(choice()).length, draw });
    root.querySelectorAll<HTMLInputElement>('input[name="a00-race"]').forEach(input => {
      input.addEventListener('change', () => { root.querySelector<HTMLButtonElement>('[data-reset]')!.click(); control.render(); });
    });
  }
</script>
