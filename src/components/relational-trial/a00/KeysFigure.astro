---
// Figure 1: the shop's five tables after order 103. Choosing an item line
// follows its keys to the order, the customer, the product and the payments.
import { customers, products, orders, items, payments } from './model.mjs';
import './figures.css';

const name = (id: number) => customers.find(c => c.customer_id === id)!.name;
const product = (id: string) => products.find(p => p.product_id === id)!;
const first = items.find(i => i.order_id === 103 && i.line_no === 1)!;
const lineKey = (i: { order_id: number; line_no: number }) => `${i.order_id}-${i.line_no}`;
const describe = (i: typeof items[number]) => {
  const o = orders.find(x => x.order_id === i.order_id)!;
  const paid = payments.filter(p => p.order_id === i.order_id);
  return {
    path: `order_items (${i.order_id}, ${i.line_no}) → orders ${o.order_id} → customers ${o.customer_id}; product_id ${i.product_id} → products ${i.product_id}`,
    row: `${o.order_id}, ${name(o.customer_id)}, line ${i.line_no}: ${i.quantity} × ${product(i.product_id).name} at ${i.unit_price}`,
    pays: paid.length ? `Payments for order ${o.order_id}: ${paid.map(p => `${p.payment_id} (${p.amount}, ${p.method})`).join(', ')}.` : `Order ${o.order_id} has no payment yet: no payments row refers to it.`,
  };
};
const start = describe(first);
const on = (cond: boolean) => (cond ? 'on' : undefined);
---
<figure class="a00-figure" data-a00-keys aria-labelledby="a00-keys-title">
  <figcaption id="a00-keys-title"><span class="a00-label">Figure 1</span> Each fact is stored once; keys connect the facts</figcaption>
  <label class="a00-select">Follow an item line’s keys
    <select data-line>
      {items.map(i => <option value={lineKey(i)} selected={i === first}>{`Order ${i.order_id}, line ${i.line_no}: ${i.quantity} × ${product(i.product_id).name}`}</option>)}
    </select>
  </label>
  <div class="a00-tables">
    <div class="a00-rel" role="region" tabindex="0" aria-label="order_items table"><table>
      <caption>order_items</caption>
      <thead><tr><th>order_id<small>PK, FK</small></th><th>line_no<small>PK</small></th><th>product_id<small>FK</small></th><th>quantity</th><th>unit_price</th></tr></thead>
      <tbody>{items.map(i => <tr data-item={lineKey(i)} class={on(i === first)}><td class="num">{i.order_id}</td><td class="num">{i.line_no}</td><td>{i.product_id}</td><td class="num">{i.quantity}</td><td class="num">{i.unit_price}</td></tr>)}</tbody>
    </table></div>
    <div class="a00-rel" role="region" tabindex="0" aria-label="orders table"><table>
      <caption>orders</caption>
      <thead><tr><th>order_id<small>PK</small></th><th>customer_id<small>FK</small></th><th>placed_at</th><th>status</th></tr></thead>
      <tbody>{orders.map(o => <tr data-order={o.order_id} class={on(o.order_id === first.order_id)}><td class="num">{o.order_id}</td><td class="num">{o.customer_id}</td><td>{o.placed_at}</td><td>{o.status}</td></tr>)}</tbody>
    </table></div>
    <div class="a00-rel" role="region" tabindex="0" aria-label="customers table"><table>
      <caption>customers</caption>
      <thead><tr><th>customer_id<small>PK</small></th><th>name</th></tr></thead>
      <tbody>{customers.map(c => <tr data-customer={c.customer_id} class={on(c.customer_id === 1)}><td class="num">{c.customer_id}</td><td>{c.name}</td></tr>)}</tbody>
    </table></div>
    <div class="a00-rel" role="region" tabindex="0" aria-label="products table"><table>
      <caption>products</caption>
      <thead><tr><th>product_id<small>PK</small></th><th>name</th><th>price</th><th>stock</th></tr></thead>
      <tbody>{products.map(p => <tr data-product={p.product_id} class={on(p.product_id === first.product_id)}><td>{p.product_id}</td><td>{p.name}</td><td class="num">{p.price}</td><td class="num">{p.stock}</td></tr>)}</tbody>
    </table></div>
    <div class="a00-rel" role="region" tabindex="0" aria-label="payments table"><table>
      <caption>payments</caption>
      <thead><tr><th>payment_id<small>PK</small></th><th>order_id<small>FK</small></th><th>amount</th><th>method</th></tr></thead>
      <tbody>{payments.map(p => <tr data-payment-order={p.order_id} class={on(p.order_id === first.order_id)}><td class="num">{p.payment_id}</td><td class="num">{p.order_id}</td><td class="num">{p.amount}</td><td>{p.method}</td></tr>)}</tbody>
    </table></div>
  </div>
  <div class="a00-explanation" aria-live="polite">
    <p><strong>Keys followed:</strong> <code data-path>{start.path}</code></p>
    <p><strong>Joined row:</strong> <span data-row>{start.row}</span></p>
    <p data-pays>{start.pays}</p>
  </div>
  <p class="a00-note">Highlighted rows are the ones the chosen line’s keys reach. PK marks a primary key column, FK a foreign key column. Rows and constraints are those that the article’s verification script loaded into PostgreSQL 18.6; the highlighting is an illustration of following keys, not a trace of how the database executes a join.</p>
  <details>
    <summary>Read this figure as text</summary>
    <p>Five tables after order 103 has committed. Customers: {customers.map(c => `${c.customer_id} ${c.name}`).join('; ')}. Products: {products.map(p => `${p.product_id} ${p.name}, price ${p.price}, stock ${p.stock}`).join('; ')}. Orders: {orders.map(o => `${o.order_id} for customer ${o.customer_id}, placed ${o.placed_at}, ${o.status}`).join('; ')}. Payments: {payments.map(p => `${p.payment_id} for order ${p.order_id}, ${p.amount} by ${p.method}`).join('; ')}.</p>
    <ul>{items.map(i => { const d = describe(i); return <li>{d.row}. {d.pays}</li>; })}</ul>
  </details>
</figure>

<script>
  import { customers, products, orders, items, payments } from './model.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('[data-a00-keys]')) {
    const select = root.querySelector<HTMLSelectElement>('[data-line]')!;
    const set = (selector: string, value: string) => { root.querySelector(selector)!.textContent = value; };
    const draw = () => {
      const [orderId, lineNo] = select.value.split('-').map(Number);
      const item = items.find(i => i.order_id === orderId && i.line_no === lineNo)!;
      const order = orders.find(o => o.order_id === orderId)!;
      const customer = customers.find(c => c.customer_id === order.customer_id)!;
      const product = products.find(p => p.product_id === item.product_id)!;
      const paid = payments.filter(p => p.order_id === orderId);
      const mark = (attr: string, match: (v: string) => boolean) =>
        root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach(row => row.classList.toggle('on', match(row.getAttribute(attr)!)));
      mark('data-item', v => v === select.value);
      mark('data-order', v => Number(v) === orderId);
      mark('data-customer', v => Number(v) === customer.customer_id);
      mark('data-product', v => v === product.product_id);
      mark('data-payment-order', v => Number(v) === orderId);
      set('[data-path]', `order_items (${orderId}, ${lineNo}) → orders ${orderId} → customers ${customer.customer_id}; product_id ${product.product_id} → products ${product.product_id}`);
      set('[data-row]', `${orderId}, ${customer.name}, line ${lineNo}: ${item.quantity} × ${product.name} at ${item.unit_price}`);
      set('[data-pays]', paid.length
        ? `Payments for order ${orderId}: ${paid.map(p => `${p.payment_id} (${p.amount}, ${p.method})`).join(', ')}.`
        : `Order ${orderId} has no payment yet: no payments row refers to it.`);
    };
    select.addEventListener('change', draw);
  }
</script>
