---
// Figure 4: an illustrative model of two failures, one that a replica answers
// and one that only a backup with archived log can answer.
import { recoveryOptions, recoverySteps } from './model.mjs';
import './figures.css';

const first = recoverySteps(recoveryOptions[0].key);
const s0 = first[0];
---
<figure class="a00-figure" data-a00-recovery aria-labelledby="a00-recovery-title">
  <figcaption id="a00-recovery-title"><span class="a00-label">Figure 4</span> A replica copies mistakes; a backup with archived log can go back before one</figcaption>
  <fieldset class="a00-options">
    <legend>What goes wrong</legend>
    <div class="a00-choices">
      {recoveryOptions.map((o, n) => <label><input type="radio" name="a00-recovery" value={o.key} checked={n === 0} /> {o.label}</label>)}
    </div>
  </fieldset>
  <p class="a00-time">Time: <strong data-live data-time>{s0.time}</strong></p>
  <div class="a00-copies">
    <div class="a00-copy"><p class="a00-copy-title" data-live data-primary-title>Primary</p><p class="a00-chips" data-live data-primary>{s0.primary!.join(' ')}</p></div>
    <div class="a00-copy"><p class="a00-copy-title" data-live data-replica-title>Replica</p><p class="a00-chips" data-live data-replica>{s0.replica.join(' ')}</p></div>
    <div class="a00-copy"><p class="a00-copy-title">Backup and archived log</p><p data-live data-backup>{s0.backup}</p><p class="a00-chips" data-live data-restored hidden></p></div>
  </div>
  <p class="a00-explanation" data-live data-explanation aria-live="polite">{s0.text}</p>
  <div class="a00-controls" aria-label="Step through the failure">
    <button type="button" data-play>Play</button>
    <button type="button" data-back aria-disabled="true">Back</button>
    <button type="button" data-next>Next</button>
    <button type="button" data-reset>Reset</button>
    <span data-step>1 / {first.length}</span>
    <span class="a00-hold" data-hold aria-hidden="true"><span></span></span>
  </div>
  <p class="a00-note">Illustrative model, not an executed failover or restore. Numbers are the orders each copy holds; “101 missing” marks the lost paid order and a newly arrived order is outlined. Order 104 never appears because the shop takes stock with the guarded update from Figure 3, so Tariq’s order 104 was rolled back. Real replication lag, restore time and the exact recovery target depend on the system and its configuration.</p>
  <details>
    <summary>Read this figure as text</summary>
    {recoveryOptions.map(o => (
      <>
        <p><strong>{o.label}</strong></p>
        <ol>{recoverySteps(o.key).map(s => <li>{s.time}. Primary: {s.primary ? s.primary.join(', ') : 'lost'}. {s.promoted ? 'Promoted replica' : 'Replica'}: {s.replica.join(', ')}. Backup: {s.backup}{s.restored ? ` ${s.restored.join(', ')}; ${s.absent.join(', ')} absent` : ''}. {s.text}</li>)}</ol>
      </>
    ))}
  </details>
</figure>

<style>
  .a00-time { margin: 0 0 .5rem; font: .85rem/1.4 var(--font-sans); color: var(--color-text-secondary); }
  .a00-time strong { color: var(--color-text); font-family: var(--font-mono); }
  .a00-copies { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; }
  .a00-copy { padding: .55rem .65rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface); font: .82rem/1.45 var(--font-sans); min-width: 0; }
  .a00-copy p { margin: .2rem 0; }
  .a00-copy-title { font-weight: 600; color: var(--color-text-secondary); font-size: .74rem; text-transform: uppercase; letter-spacing: .03em; }
  .a00-chips { display: flex; flex-wrap: wrap; gap: .3rem; font-family: var(--font-mono); }
  .a00-chips :global(span) { padding: .1rem .35rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface-alt); }
  .a00-chips :global(span.a00-bad) { border-style: dashed; background: var(--color-surface); }
  .a00-chips :global(span.a00-new) { background: var(--a00-changed); outline: 2px solid var(--color-accent); outline-offset: -2px; font-weight: 700; }
  .a00-chips[hidden] { display: none; }
  @media (max-width: 640px) { .a00-copies { grid-template-columns: 1fr; } }
</style>

<script>
  import { stepper } from '../../figures/stepper.mjs';
  import { recoverySteps } from './model.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('[data-a00-recovery]')) {
    const choice = () => root.querySelector<HTMLInputElement>('input[name="a00-recovery"]:checked')!.value;
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-${name}]`)!;
    const chips = (name: string, list: string[] | null, prev: string[] | null | undefined, mistake: boolean) => {
      const el = field(name);
      el.replaceChildren();
      if (!list) {
        const lost = document.createElement('span');
        lost.className = 'a00-bad';
        lost.textContent = 'Lost';
        el.append(lost);
        return;
      }
      for (const id of list) {
        const chip = document.createElement('span');
        chip.textContent = id;
        if (prev && !prev.includes(id)) chip.className = 'a00-new';
        el.append(chip);
      }
      if (mistake && !list.includes('101')) {
        const gone = document.createElement('span');
        gone.className = 'a00-bad';
        gone.textContent = '101 missing';
        el.append(gone);
      }
    };
    const draw = (step: number) => {
      const key = choice();
      const all = recoverySteps(key);
      const s = all[step];
      const p = step > 0 ? all[step - 1] : undefined;
      field('time').textContent = s.time;
      field('primary-title').textContent = s.primary ? 'Primary' : 'Primary (failed)';
      field('replica-title').textContent = s.promoted ? 'Replica, now promoted to primary' : 'Replica';
      chips('primary', s.primary, p?.primary, key === 'mistake');
      chips('replica', s.replica, p?.replica, key === 'mistake');
      field('backup').textContent = s.backup;
      const restored = field('restored');
      restored.hidden = !s.restored;
      restored.replaceChildren();
      if (s.restored) {
        for (const id of s.restored) { const chip = document.createElement('span'); chip.textContent = id; restored.append(chip); }
        for (const id of s.absent) { const chip = document.createElement('span'); chip.className = 'a00-bad'; chip.textContent = `${id} absent`; restored.append(chip); }
      }
      field('explanation').textContent = s.text;
    };
    const control = stepper(root, { steps: () => recoverySteps(choice()).length, draw });
    root.querySelectorAll<HTMLInputElement>('input[name="a00-recovery"]').forEach(input => {
      input.addEventListener('change', () => { root.querySelector<HTMLButtonElement>('[data-reset]')!.click(); control.render(); });
    });
  }
</script>
