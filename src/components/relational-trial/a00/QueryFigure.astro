---
// Figure 2: one question, three queries, results as PostgreSQL 18.6 returned
// them, compared cell by cell with the hand calculation.
import Sql from '../../explainers/querying/Sql.astro';
import { summaryQuestion, expectedSummary, summaryQueries } from './model.mjs';
import './figures.css';

const heads = ['order_id', 'value', 'paid', 'due'];
const marked = (rows: string[][]) => expectedSummary.map(want => {
  const got = rows.find(r => r[0] === want[0]);
  return { want, got, cells: got ? got.map((v, i) => ({ v, bad: v !== want[i] })) : null };
});
---
<figure class="a00-figure" data-a00-query aria-labelledby="a00-query-title">
  <figcaption id="a00-query-title"><span class="a00-label">Figure 2</span> Three queries run without error; only one answers the question</figcaption>
  <p><strong>Question:</strong> {summaryQuestion}</p>
  <fieldset class="a00-options">
    <legend>Choose a query</legend>
    <div class="a00-choices">
      {summaryQueries.map((q, n) => <label><input type="radio" name="a00-query" value={q.key} checked={n === 0} /> {q.label}</label>)}
    </div>
  </fieldset>
  {summaryQueries.map(q => (
    <div class="a00-panel" data-query={q.key}>
      <Sql code={q.sql} label={`SQL: ${q.label}`} />
      <div class="a00-results">
        <div class="a00-rel" role="region" tabindex="0" aria-label="Result returned"><table>
          <caption>Result returned</caption>
          <thead><tr>{heads.map(h => <th>{h}</th>)}</tr></thead>
          <tbody>
            {marked(q.rows).map(r => r.cells
              ? <tr>{r.cells.map(c => <td class={c.bad ? 'num a00-bad' : 'num'}>{c.v}{c.bad && <span> (wrong)</span>}</td>)}</tr>
              : <tr><td class="num">{r.want[0]}</td><td class="a00-bad" colspan="3">Row missing</td></tr>)}
          </tbody>
        </table></div>
        <div class="a00-rel" role="region" tabindex="0" aria-label="Calculated by hand"><table>
          <caption>Calculated by hand</caption>
          <thead><tr>{heads.map(h => <th>{h}</th>)}</tr></thead>
          <tbody>{expectedSummary.map(r => <tr>{r.map(v => <td class="num">{v}</td>)}</tr>)}</tbody>
        </table></div>
      </div>
      <p class="a00-explanation" data-verdict>{q.verdict}</p>
    </div>
  ))}
  <p class="a00-note">Observed in PostgreSQL 18.6: each query ran against the shop after order 103 and returned exactly the result shown. “(wrong)” marks a value that differs from the hand calculation: order 101 has order lines of 4.50 and 35.00 and payments of 30.00 and 9.50; order 102 one line of 2 × 20.00 and a payment of 40.00; order 103 lines of 20.00 and 2 × 4.50 and no payment.</p>
  <details>
    <summary>Read this figure as text</summary>
    <ul>
      {summaryQueries.map(q => <li><strong>{q.label}.</strong> Returns {q.rows.map(r => `order ${r[0]}: value ${r[1]}, paid ${r[2]}, due ${r[3]}`).join('; ')}. {q.verdict}</li>)}
    </ul>
  </details>
</figure>

<style>
  .a00-results { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: .9rem; margin-top: .8rem; }
  .a00-panel[hidden] { display: none; }
  .a00-panel + .a00-panel { margin-top: 1.4rem; }
  .a00-panel :global(.sql-scroll) { max-width: 100%; overflow-x: auto; }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-a00-query]')) {
    const panels = [...root.querySelectorAll<HTMLElement>('[data-query]')];
    const show = (key: string) => panels.forEach(p => { p.hidden = p.dataset.query !== key; });
    root.querySelectorAll<HTMLInputElement>('input[name="a00-query"]').forEach(input => {
      input.addEventListener('change', () => { if (input.checked) show(input.value); });
    });
    show(root.querySelector<HTMLInputElement>('input[name="a00-query"]:checked')!.value);
    root.classList.add('a00-ready');
  }
</script>
