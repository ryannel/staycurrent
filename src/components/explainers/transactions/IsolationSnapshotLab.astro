---
import '../design/design-aids.css';
import SketchSheet from '../design/SketchSheet.astro';
import SketchArrow from '../design/SketchArrow.astro';
---
<isolation-snapshot id="isolation-snapshot-lab" class="lab design-aid design-lab" aria-labelledby="isolation-snapshot-title">
  <div class="lab-heading"><span class="eyebrow">Interactive experiment</span></div>
  <h3 id="isolation-snapshot-title">Read the price before and after a commit</h3>
  <div class="lab-introduction">
    <p>A report transaction reads P7’s catalogue price twice. Another transaction commits a change from EUR 20 to EUR 22 between the reads. Both reads are ordinary SELECTs; the report writes nothing.</p>
    <p class="try-this">Choose an isolation level, then advance through the three events. Compare the price now committed in the catalogue with the price returned to the report.</p>
  </div>
  <div class="lab-controls" data-controls>
    <p class="lab-area-label">Controls <span>Changing the level resets the schedule</span></p>
    <div class="control-line"><label for="isolation-level">Isolation level</label><select id="isolation-level" data-level><option value="read-committed">Read Committed</option><option value="repeatable-read">Repeatable Read</option></select><button data-next>Advance one step</button><button data-reset>Reset</button></div>
  </div>
  <div class="lab-output paper-surface">
    <p class="lab-area-label">Result <span>Time runs down; the report transaction spans both reads</span></p>
    <div class="snapshot-catalogue"><SketchSheet tone="teal"><h4>Committed product row</h4><div class="snapshot-price"><span>P7 · Blue mug</span><strong data-catalogue>EUR 20</strong></div><small>Other transactions can commit while the report is open.</small></SketchSheet></div>
    <div class="snapshot-report">
      <p class="snapshot-bracket">Time ↓ · Events in two separate transactions</p>
      <div class="snapshot-event"><span class="event-number">1</span><div><h4>Report · first ordinary SELECT</h4><p data-first>Not read yet</p><small data-first-note>Establishes the first view.</small></div></div>
      <div class="snapshot-between"><SketchArrow direction="down" /><p><strong>2 · Separate writer transaction commits EUR 22</strong><br /><span data-writer>Not committed yet</span></p></div>
      <div class="snapshot-event"><span class="event-number">3</span><div><h4>Report · second ordinary SELECT</h4><p data-second>Not read yet</p><small data-second-note>A later statement in the same report transaction.</small></div></div>
    </div>
    <p class="design-state" data-status role="status" aria-live="polite" aria-atomic="true">The report transaction is open. Its first SELECT has not run.</p>
  </div>
  <details class="model-note"><summary>What this model shows</summary><p>This fixed schedule models PostgreSQL 18 ordinary reads. It is not connected to a database and does not time execution. Repeatable Read establishes its snapshot at the first query here, not at BEGIN. The model excludes the report’s own writes, locking reads, conflicting writes, failures and replicas. EUR 22 is a new catalogue offer; O12’s recorded EUR 18 purchase price is unrelated and unchanged.</p></details>
  <noscript><p>With Read Committed, the two reads return EUR 20 then EUR 22. With Repeatable Read, both return EUR 20. The catalogue ends at EUR 22 in either run.</p></noscript>
</isolation-snapshot>
<script>
  class IsolationSnapshot extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const level = this.querySelector<HTMLSelectElement>('[data-level]')!;
      const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
      let step = 0;
      const text = (name:string, value:string) => { this.querySelector(`[data-${name}]`)!.textContent = value; };
      const render = () => {
        const repeatable = level.value === 'repeatable-read';
        text('catalogue', step >= 2 ? 'EUR 22' : 'EUR 20');
        text('first', step >= 1 ? 'Returned EUR 20' : 'Not read yet');
        text('first-note', step >= 1 ? repeatable ? 'Transaction snapshot established here: EUR 20.' : 'This statement’s view: EUR 20.' : 'Establishes the first view.');
        text('writer', step >= 2 ? 'Committed; catalogue now EUR 22' : 'Not committed yet');
        text('second', step >= 3 ? `Returned EUR ${repeatable ? 20 : 22}` : 'Not read yet');
        text('second-note', step >= 3 ? repeatable ? 'Uses the same transaction snapshot as read 1.' : 'Uses a new statement view after the writer’s commit.' : 'A later statement in the same transaction.');
        text('status', step === 0 ? 'The report transaction is open. Its first SELECT has not run.' : step === 1 ? 'Step 1: the first SELECT returned EUR 20. The writer has not committed.' : step === 2 ? 'Step 2: the writer committed EUR 22. The report remains open; its second read has not run.' : repeatable ? 'Step 3: the second SELECT returned EUR 20, like the first. The report uses one stable view while the catalogue is now EUR 22.' : 'Step 3: the second SELECT returned EUR 22. The two statements in this transaction read different committed views.');
        next.disabled = step === 3;
        next.textContent = step === 3 ? 'All three steps completed' : `Run step ${step + 1}`;
      };
      next.addEventListener('click', () => { if (step < 3) step++; render(); });
      const reset = () => { step = 0; render(); };
      level.addEventListener('change', reset);
      this.querySelector('[data-reset]')!.addEventListener('click', reset);
      render(); this.dataset.ready = 'true';
    }
  }
  if (!customElements.get('isolation-snapshot')) customElements.define('isolation-snapshot', IsolationSnapshot);
</script>
<style>
  .snapshot-catalogue { margin:.5rem 0 1.4rem; }
  .snapshot-price { display:flex; flex-wrap:wrap; gap:.5rem 1rem; align-items:baseline; justify-content:space-between; margin:.7rem 0; }
  .snapshot-price strong { font:500 1.3rem var(--font-mono); }
  small { color:var(--color-text-secondary); }
  .snapshot-report { border-left:1px dashed var(--color-text-secondary); margin-left:.4rem; padding-left:1rem; }
  .snapshot-bracket { margin:0 0 1rem; color:var(--color-text-secondary); font-size:.8rem; }
  .snapshot-event { display:flex; align-items:flex-start; gap:.8rem; padding:.7rem 0; border-bottom:1px solid var(--color-rule); }
  .event-number { font:500 1.3rem var(--font-serif); color:var(--teal); }
  .snapshot-event h4 { margin-bottom:.3rem; }
  .snapshot-event p { margin:.4rem 0; font-family:var(--font-mono); }
  .snapshot-between { display:flex; align-items:center; gap:.8rem; margin:.5rem 0; }
  .snapshot-between p { font-size:.8rem; }
  .snapshot-between span { color:var(--color-text-secondary); }
</style>
