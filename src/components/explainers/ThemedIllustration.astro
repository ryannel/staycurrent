---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  loading?: 'eager' | 'lazy';
}
const { light, dark, alt, loading = 'lazy' } = Astro.props;
const widths = [480, 800, 1200];
const sizes = '(max-width: 880px) calc(100vw - 2rem), 840px';
const darkSources = await Promise.all(widths.map(async width => {
  const image = await getImage({ src: dark, width, format: 'webp' });
  return `${image.src} ${width}w`;
}));
---
<picture>
  <source media="(prefers-color-scheme: dark)" srcset={darkSources.join(', ')} sizes={sizes} type="image/webp" />
  <Image src={light} widths={widths} sizes={sizes} format="webp" loading={loading} alt={alt} />
</picture>
