---
import { tools, defaults, run } from './model.mjs';
import { renderResult } from './view.mjs';
import './product-tools.css';
interface Props { name: string; number?: number; }
const { name, number = 1 } = Astro.props;
const tool = tools[name];
if (!tool) throw new Error(`Unknown relational product tool: ${name}`);
const id = `rpt-${name}-${number}`;
---
<figure class="rpt-figure" aria-labelledby={`${id}-title`}>
  <div class="rpt-heading"><span>Figure {number}</span><p id={`${id}-title`}>{tool.title}</p></div>
  <p class="rpt-intro">{tool.intro}</p>
  <relational-product-tool data-model={name}>
    <div class="rpt-controls" aria-label={`Controls for ${tool.title}`}>
      <strong>Controls</strong>
      {tool.controls.map(c => <label><span>{c.label}</span><select data-input={c.id} aria-label={c.label}>{c.choices.map(([value,label]) => <option value={value} selected={value === c.initial}>{label}</option>)}</select></label>)}
      <button type="button" data-reset>Reset</button>
    </div>
    <div class="rpt-result"><p class="rpt-result-label">Result</p><div data-result set:html={renderResult(run(name, defaults(name)))} /></div>
    <noscript><p>The initial comparison above is complete without JavaScript. The article’s worked examples give the other cases.</p></noscript>
  </relational-product-tool>
  <figcaption>Figure {number}. <strong>Model bounds.</strong> {tool.bounds}</figcaption>
</figure>
<script>
  import { defaults, run } from './model.mjs';
  import { renderResult } from './view.mjs';
  class RelationalProductTool extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const name = this.dataset.model!;
      const inputs = [...this.querySelectorAll<HTMLSelectElement>('select[data-input]')];
      const result = this.querySelector<HTMLElement>('[data-result]')!;
      const update = () => { result.innerHTML = renderResult(run(name, Object.fromEntries(inputs.map(input => [input.dataset.input!, input.value])))); };
      this.addEventListener('change', update);
      this.querySelector('[data-reset]')!.addEventListener('click', () => {
        const initial = defaults(name);
        inputs.forEach(input => { input.value = initial[input.dataset.input!]; });
        update();
      });
      this.dataset.ready = 'true';
    }
  }
  if (!customElements.get('relational-product-tool')) customElements.define('relational-product-tool', RelationalProductTool);
</script>
