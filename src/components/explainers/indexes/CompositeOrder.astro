---
import '../design/design-aids.css';
const customers = [
 {customer:41,rows:[['59040','Feb 11'],['58040','Feb 10']]},
 {customer:42,rows:[['59041','Feb 11'],['58041','Feb 10'],['57041','Feb 09']]},
 {customer:43,rows:[['59042','Feb 11'],['58042','Feb 10']]},
];
---
<figure class="design-aid design-figure paper-surface" aria-labelledby="composite-title">
 <span class="plate-number">Illustration · A composite key</span>
 <h3 id="composite-title">Ordering a composite index</h3>
 <p class="key">customer_id ↑ &nbsp; then placed_at ↓ &nbsp; then order_id ↓</p>
 <div class="groups">{customers.map(group=><div class:list={['group',{selected:group.customer===42}]}><h4>Customer {group.customer}</h4><div class="column-head"><span>Date</span><span>Order</span></div>{group.rows.map(row=><div class="entry"><span>{row[1]}</span><code>{row[0]}</code></div>)}<p class="more">… earlier orders …</p></div>)}</div>
 <p class="selection">customer_id = 42 selects the middle run</p>
 <figcaption>A small excerpt from the generated data, with dates shortened to days. The index puts customer 42’s newest orders next to each other. Date order starts again for each customer, so February 11 appears in three separate groups here.</figcaption>
</figure>
<style>
 .key { font:.8rem/1.7 var(--font-mono); margin:1rem 0; } .groups {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;} .group {border-top:2px solid var(--color-rule-strong);padding:.7rem .5rem;border-bottom:1px solid var(--color-rule);} .group.selected {border-top-color:var(--teal);background:color-mix(in srgb,var(--teal) 7%,transparent);} h4 {font:.85rem/1.5 var(--font-sans);margin:0 0 .6rem;} .column-head,.entry {display:flex;justify-content:space-between;gap:.3rem;font-size:.75rem;border-bottom:1px solid var(--color-rule);padding:.35rem 0;} .column-head {color:var(--color-text-secondary);font-size:.67rem;} code {font-size:.7rem;background:none;padding:0;} .more {font-size:.7rem;color:var(--color-text-secondary);margin:.6rem 0 0;} .selection {font:.8rem/1.5 var(--font-mono);color:var(--teal);text-align:center;margin:1rem 0 0;} @media(max-width:500px){.groups{grid-template-columns:1fr;gap:.8rem;} .group{max-width:19rem;width:100%;margin:auto;} .key{font-size:.7rem;} }
</style>
