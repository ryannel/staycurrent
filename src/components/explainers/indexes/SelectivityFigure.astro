---
import IndexFigure from './IndexFigure.astro';
import Segmented from './Segmented.astro';
const { number = 5 } = Astro.props;
---
<IndexFigure tag="ix-selectivity-figure" number={number} title="Page visits as the range widens">
 <pre slot="query"><code>SELECT * FROM orders WHERE customer_id &lt;= <span data-bound-echo>5</span>;</code></pre>
 <Segmented slot="params" name="layout" label="Table order" value="scattered" options={[
  { value: 'scattered', label: 'Scattered' },
  { value: 'customer', label: 'By customer' },
 ]} />
 Each step widens the range by one customer. The bars count table page visits for an index scan, a bitmap heap scan and a sequential scan. The same 36 rows, stored in two orders, reach every page at very different points.
 <span slot="fallback">With the rows scattered, one customer matched (3 rows) means an index scan visits 3 pages and a sequential scan reads all 6. By the third customer, 8 rows or 22% of the table, the matches already sit on all six pages. With every row matched, an index scan makes 36 page visits, a bitmap heap scan still reads all 6 pages, and the sequential scan reads 6 pages in order without touching the index. With the same rows stored in customer order, the matches fill one page before reaching the next: 22 rows, 61% of the table, sit on 4 pages, and they reach all six only at 32 rows, 89%. The 60,000-order table is closer to the second order, because neighbouring rows have neighbouring customer numbers. There PostgreSQL chose a bitmap heap scan up to customer_id 500, reading 922 of the 1,725 pages, and a sequential scan from 550. On a copy with the rows shuffled, the same bitmap scan read all 1,715 of the copy’s pages.</span>
</IndexFigure>

<script>
 import { IndexFigure, canvas, svg, type Frame, type Layout } from './player';
 import { orders, customers, PAGES, PAGE_ROWS, type Order } from './model';
 import { heapPanel, heapWidth, panelHeight, setCell, moveCell, cellX, cellY, G, compact, type HeapPanel } from './scene';

 type Arrangement = 'scattered' | 'customer';
 interface SelFrame extends Frame { bound: number }
 // Phones get shorter bars, so the longest value (“36 visits”) stays inside the drawing.
 const BAR_X = 112, BAR_W = compact ? 80 : 104, MAX = 36;

 // The same rows stored in customer order, six to a page.
 const placed: Record<Arrangement, Map<number, { page: number; slot: number }>> = {
  scattered: new Map(orders.map((o) => [o.id, { page: o.page, slot: o.slot }])),
  customer: new Map([...orders].sort((a, b) => a.customer - b.customer || a.id - b.id)
   .map((o, i) => [o.id, { page: Math.floor(i / PAGE_ROWS), slot: (i % PAGE_ROWS) + 1 }])),
 };

 /** Table pages read by each route. An index scan revisits a page only when the next entry is on a different one. */
 function count(layout: Arrangement, bound: number) {
  const at = placed[layout];
  const rows = orders.filter((o) => o.customer <= bound)
   .sort((a, b) => a.customer - b.customer || at.get(a.id)!.page - at.get(b.id)!.page || at.get(a.id)!.slot - at.get(b.id)!.slot);
  const pages = new Set(rows.map((o) => at.get(o.id)!.page));
  let visits = 0, last = -1;
  for (const o of rows) { const p = at.get(o.id)!.page; if (p !== last) visits++; last = p; }
  return { rows, pages, visits };
 }

 class SelectivityFigure extends IndexFigure<SelFrame> {
  heap!: HeapPanel;
  bars: { bar: SVGRectElement; value: SVGTextElement }[] = [];
  keepDrawing = true;
  get layoutParam() { return this.param('layout') as Arrangement; }
  build(): SelFrame[] {
   const layout = this.layoutParam;
   let before = 0;
   return customers.map((bound, i) => {
    const { rows, pages, visits } = count(layout, bound);
    const firstFull = pages.size === PAGES && before < PAGES;
    before = pages.size;
    const pct = Math.round((rows.length / orders.length) * 100);
    const pageWord = pages.size === 1 ? 'page' : 'pages';
    let note: string;
    if (layout === 'scattered') {
     note = i === 0
      ? `customer_id ≤ ${bound} matches ${rows.length} rows, ${pct}% of the table, on ${pages.size} pages. Following the index touches only those pages.`
      : firstFull
       ? `≤ ${bound} matches ${rows.length} rows (${pct}%), and they now sit on all ${PAGES} pages. From here on, the index can’t save a single page read.`
       : rows.length === orders.length
        ? `Every row matches. Following the index means ${visits} page visits; a sequential scan reads ${PAGES} pages straight through and skips the index entirely.`
        : pages.size < PAGES
         ? `≤ ${bound} matches ${rows.length} rows (${pct}%). The index route makes ${visits} page visits, a bitmap heap scan reads ${pages.size} pages, and a sequential scan reads all ${PAGES}.`
         : `≤ ${bound} matches ${rows.length} rows (${pct}%). The index route makes ${visits} page visits; a bitmap heap scan or a sequential scan reads ${PAGES} pages.`;
    } else {
     note = i === 0
      ? `customer_id ≤ ${bound} matches ${rows.length} rows, ${pct}% of the table, all on page 0. Neighbouring customers share pages, so the matches fill one page before reaching the next.`
      : firstFull
       ? `≤ ${bound} matches ${rows.length} rows (${pct}%), and only now do they reach all ${PAGES} pages.`
       : rows.length === orders.length
        ? `Every row matches. All three routes read the ${PAGES} pages; the sequential scan reads them in order and skips the index.`
        : pages.size < PAGES
         ? `≤ ${bound} matches ${rows.length} rows (${pct}%) on ${pages.size} ${pageWord}. Both index routes read only ${pages.size === 1 ? 'that page' : 'those pages'}; a sequential scan reads all ${PAGES}.`
         : visits === PAGES
          ? `≤ ${bound} matches ${rows.length} rows (${pct}%) on all ${PAGES} pages. Every route now reads ${PAGES} pages, so the index saves nothing.`
          : `≤ ${bound} matches ${rows.length} rows (${pct}%) on all ${PAGES} pages. The index route makes ${visits} page visits; a bitmap heap scan or a sequential scan reads ${PAGES} pages.`;
    }
    return { bound, note, short: `≤ ${bound}: ${rows.length} rows on ${pages.size} ${pageWord}.`, hold: i === 0 ? 1600 : 1000 };
   });
  }
  draw(_layout: Layout) {
   const svgRoot = canvas(this.stage, heapWidth + 8, panelHeight + 104, 'The orders table with rows matching a widening customer range, and bars counting the table page visits of three access methods.', 1.4);
   this.heap = heapPanel(svgRoot, 4, 2);
   const labels = ['Index scan', 'Bitmap heap scan', 'Sequential scan'];
   const kinds = ['index', 'bitmap', 'seq'];
   this.bars = labels.map((label, i) => {
    const y = panelHeight + 26 + i * 26;
    svgRoot.append(svg('text', { x: 4, y: y + 12, class: 'ix-bar-label' }, label));
    svgRoot.append(svg('rect', { class: 'ix-bar-bg', x: BAR_X, y, width: BAR_W, height: 16, rx: 2 }));
    const bar = svg('rect', { class: 'ix-bar', 'data-kind': kinds[i], x: BAR_X, y, width: BAR_W, height: 16, rx: 2 }) as SVGRectElement;
    bar.style.transformOrigin = `${BAR_X}px ${y}px`;
    bar.style.transform = 'scaleX(0)';
    const value = svg('text', { class: 'ix-bar-value', x: BAR_X + BAR_W + 6, y: y + 12 }, '') as SVGTextElement;
    svgRoot.append(bar, value);
    return { bar, value };
   });
   svgRoot.append(svg('text', { x: 4, y: panelHeight + 17, class: 'ix-label-small' }, 'Table page visits'));
  }
  render(frame: SelFrame) {
   const layout = this.layoutParam;
   const at = placed[layout];
   this.querySelector('[data-bound-echo]')!.textContent = String(frame.bound);
   const { rows, pages, visits } = count(layout, frame.bound);
   orders.forEach((o: Order) => {
    const c = this.heap.cells.get(o.id)!;
    const { page, slot } = at.get(o.id)!;
    moveCell(c, G.pageLabel + cellX(slot - 1), cellY(page));
    setCell(c, o.customer <= frame.bound ? 'match' : '');
   });
   this.heap.pages.forEach((label, p) => label.setAttribute('data-state', pages.has(p) ? 'read' : ''));
   const values = [visits, pages.size, PAGES];
   const words = [`${visits} ${visits === 1 ? 'visit' : 'visits'}`, `${pages.size} ${pages.size === 1 ? 'page' : 'pages'}`, `${PAGES} pages`];
   this.bars.forEach(({ bar, value }, i) => {
    bar.style.transform = `scaleX(${values[i] / MAX})`;
    value.textContent = words[i];
   });
   this.counters([['rows matched', `${rows.length} of ${orders.length}`, true], ['of the table', `${Math.round((rows.length / orders.length) * 100)}%`], ['pages holding a match', `${pages.size} of ${PAGES}`]]);
   this.scale(layout === 'scattered'
    ? 'on a shuffled copy, a bitmap scan for customer_id ≤ 500 read all 1,715 of its pages'
    : 'a bitmap scan for customer_id ≤ 500 read 922 of 1,725 pages; a sequential scan from 550');
  }
 }
 if (!customElements.get('ix-selectivity-figure')) customElements.define('ix-selectivity-figure', SelectivityFigure);
</script>
