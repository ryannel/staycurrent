---
import IndexFigure from './IndexFigure.astro';
const { number = 7 } = Astro.props;
---
<IndexFigure tag="ix-selectivity-figure" number={number} title="As a query matches more rows, the index stops paying">
 <pre slot="query"><code>SELECT * FROM orders WHERE customer_id &lt;= <span data-bound-echo>5</span>;</code></pre>
 Each step widens the range by one customer. The bars count table page visits for three ways to fetch the matching rows: following index entries one by one, collecting their locations first and visiting each page once (a bitmap heap scan), or reading every page in order (a sequential scan).
 <span slot="fallback">With one customer matched (3 rows), an index scan visits 3 pages and a sequential scan reads all 6. By the third customer, 8 rows or 22% of the table, the matches already sit on all six pages. With every row matched, an index scan makes 36 page visits, a bitmap heap scan still reads all 6 pages, and the sequential scan reads 6 pages in order without touching the index.</span>
</IndexFigure>

<script>
 import { IndexFigure, canvas, svg, type Frame, type Layout } from './player';
 import { orders, customers, PAGES } from './model';
 import { heapPanel, heapWidth, panelHeight, setCell, type HeapPanel } from './scene';

 interface SelFrame extends Frame { bound: number }
 const BAR_X = 112, BAR_W = 104, MAX = 36;

 class SelectivityFigure extends IndexFigure<SelFrame> {
  heap!: HeapPanel;
  bars: { bar: SVGRectElement; value: SVGTextElement }[] = [];
  build(): SelFrame[] {
   let before = 0;
   return customers.map((bound, i) => {
    const rows = orders.filter((o) => o.customer <= bound);
    const pages = new Set(rows.map((o) => o.page)).size;
    const firstFull = pages === PAGES && before < PAGES;
    before = pages;
    const pct = Math.round((rows.length / orders.length) * 100);
    const note = i === 0
     ? `customer_id ≤ ${bound} matches ${rows.length} rows, ${pct}% of the table, on ${pages} pages. Following the index touches only those pages.`
     : firstFull
      ? `≤ ${bound} matches ${rows.length} rows (${pct}%), and they now touch all ${PAGES} pages. The index route reads every page anyway, in a jumping order, plus the index itself.`
      : rows.length === orders.length
       ? `Every row matches. Following the index means ${rows.length} page visits; a sequential scan reads ${PAGES} pages straight through and skips the index entirely.`
       : `≤ ${bound} matches ${rows.length} rows (${pct}%). The index route makes ${rows.length} page visits; a bitmap heap scan or a sequential scan reads ${pages} pages.`;
    return { bound, note, hold: i === 0 ? 1600 : 1000 };
   });
  }
  draw(_layout: Layout) {
   const svgRoot = canvas(this.stage, heapWidth + 8, panelHeight + 104, 'The orders table with rows matching a widening customer range, and bars counting the table page visits of three access methods.', 1.4);
   this.heap = heapPanel(svgRoot, 4, 2);
   const labels = ['Index scan', 'Bitmap heap scan', 'Sequential scan'];
   const kinds = ['index', 'bitmap', 'seq'];
   this.bars = labels.map((label, i) => {
    const y = panelHeight + 22 + i * 26;
    svgRoot.append(svg('text', { x: 4, y: y + 12, class: 'ix-bar-label' }, label));
    svgRoot.append(svg('rect', { class: 'ix-bar-bg', x: BAR_X, y, width: BAR_W, height: 16, rx: 2 }));
    const bar = svg('rect', { class: 'ix-bar', 'data-kind': kinds[i], x: BAR_X, y, width: BAR_W, height: 16, rx: 2 }) as SVGRectElement;
    bar.style.transformOrigin = `${BAR_X}px ${y}px`;
    bar.style.transform = 'scaleX(0)';
    const value = svg('text', { class: 'ix-bar-value', x: BAR_X + BAR_W + 6, y: y + 12 }, '') as SVGTextElement;
    svgRoot.append(bar, value);
    return { bar, value };
   });
   svgRoot.append(svg('text', { x: 4, y: panelHeight + 12, class: 'ix-label-small' }, 'Table page visits'));
  }
  render(frame: SelFrame) {
   this.querySelector('[data-bound-echo]')!.textContent = String(frame.bound);
   const rows = orders.filter((o) => o.customer <= frame.bound);
   const pages = new Set(rows.map((o) => o.page));
   orders.forEach((o) => setCell(this.heap.cells.get(o.id), o.customer <= frame.bound ? 'match' : ''));
   this.heap.pages.forEach((label, p) => label.setAttribute('data-state', pages.has(p) ? 'read' : ''));
   const values = [rows.length, pages.size, PAGES];
   const words = [`${rows.length} visits`, `${pages.size} pages`, `${PAGES} pages`];
   this.bars.forEach(({ bar, value }, i) => {
    bar.style.transform = `scaleX(${values[i] / MAX})`;
    value.textContent = words[i];
   });
   this.counters([['rows matched', `${rows.length} of ${orders.length}`, true], ['of the table', `${Math.round((rows.length / orders.length) * 100)}%`], ['pages holding a match', `${pages.size} of ${PAGES}`]]);
  }
 }
 if (!customElements.get('ix-selectivity-figure')) customElements.define('ix-selectivity-figure', SelectivityFigure);
</script>
