---
import IndexFigure from './IndexFigure.astro';
import { customers } from './model';
const { number = 3 } = Astro.props;
---
<IndexFigure tag="ix-descent-figure" number={number} title="B-tree search for one customer_id">
 <pre slot="query"><code>SELECT * FROM orders WHERE customer_id = <span data-key-echo>42</span>;</code></pre>
 <label slot="params">Find customer
  <select data-param="key">{customers.map((c) => <option value={c} selected={c === 42}>{c}</option>)}</select>
 </label>
 The index from figure 2 as a B-tree: a root page, two branch pages and six leaf pages, one per line. Pick a customer and count the pages read.
 <span slot="fallback">For customer 42, the root page sends the search to the lower branch page (42 and above). That branch page sends it to leaf page 4 (below 53), where four entries point to rows on table pages 0, 1, 3 and 5. The search reads one index page per level: three in all.</span>
</IndexFigure>

<script>
 import { IndexFigure, canvas, type Frame, type Layout } from './player';
 import { customerIndex, root, branches, slotFor, ctid } from './model';
 import { heapPanel, indexPanel, heapWidth, indexWidth, panelHeight, setCell, centre, pointer, G, compact, type HeapPanel, type IndexPanel } from './scene';

 type Phase = 'start' | 'root' | 'branch' | 'leaf' | 'fetch';
 interface DescentFrame extends Frame { phase: Phase; fetched: number }

 class DescentFigure extends IndexFigure<DescentFrame> {
  heap!: HeapPanel;
  index!: IndexPanel;
  overlay!: SVGGElement;
  vertical = false;
  wideAt = 580;
  get key() { return Number(this.param('key')); }
  build(): DescentFrame[] {
   const key = this.key;
   const echo = this.querySelector('[data-key-echo]');
   if (echo) echo.textContent = String(key);
   const r = slotFor(root, key);
   const b = slotFor(branches[r.child], key);
   const run = customerIndex.filter((o) => o.customer === key);
   const frames: DescentFrame[] = [
    { phase: 'start', fetched: 0, hold: 1200, short: 'Start at the root page.', note: `Looking for customer_id = ${key}. Every search starts at the root page.` },
    { phase: 'root', fetched: 0, hold: 1500, short: 'Root page: pick a branch page.', note: `Root page: ${key} is ${key < 42 ? 'below 42' : '42 or above'}, so the search follows the ${r.child === 0 ? 'upper' : 'lower'} pointer to a branch page. Half the leaf pages are now ruled out.` },
    { phase: 'branch', fetched: 0, hold: 1500, short: 'Branch page: pick a leaf page.', note: `Branch page: ${key} falls in the range ${b.label}, so the search follows that pointer to leaf page ${b.child + 1}.` },
    { phase: 'leaf', fetched: 0, hold: 1500, short: `Leaf page ${b.child + 1}: the matching entries.`, note: `Leaf page ${b.child + 1}: the ${run.length === 1 ? 'entry' : `${run.length} entries`} for customer ${key} ${run.length === 1 ? 'is' : 'are'} here. Three index pages read, one per level, out of nine.` },
   ];
   run.forEach((o, i) => frames.push({ phase: 'fetch', fetched: i + 1, hold: 950,
    short: `Follow ${ctid(o)} to page ${o.page}.`,
    note: i === run.length - 1
     ? `Done: 3 index pages, then ${new Set(run.map((x) => x.page)).size} table ${run.length === 1 ? 'page' : 'pages'} for ${run.length} ${run.length === 1 ? 'row' : 'rows'}.`
     : `Entry ${i + 1} points to ${ctid(o)}. Fetch that row from table page ${o.page}.` }));
   return frames;
  }
  draw(layout: Layout) {
   this.vertical = layout === 'narrow';
   const iw = indexWidth(true);
   const w = this.vertical ? Math.max(iw, heapWidth) + 8 : iw + 40 + heapWidth + 8;
   const h = this.vertical ? panelHeight * 2 + G.head + (compact ? 2 : 10) : panelHeight + 6;
   const svgRoot = canvas(this.stage, w, h, 'A B-tree index on customer_id beside the orders table. A search moves from the root page to a branch page to a leaf page, then follows each entry to its row.', this.vertical ? (compact ? 1 : 1.2) : 1.12);
   svgRoot.toggleAttribute('data-small', this.vertical);
   this.overlay = svgRoot.appendChild(document.createElementNS('http://www.w3.org/2000/svg', 'g')) as SVGGElement;
   this.index = indexPanel(svgRoot, 4, 2, customerIndex, { title: 'leaf pages · customer_id', tree: true });
   this.heap = heapPanel(svgRoot, this.vertical ? 4 : iw + 44, this.vertical ? panelHeight + G.head + (compact ? 0 : 8) : 2);
  }
  render(frame: DescentFrame) {
   const key = this.key;
   const r = slotFor(root, key);
   const b = slotFor(branches[r.child], key);
   const run = customerIndex.filter((o) => o.customer === key);
   const order = ['start', 'root', 'branch', 'leaf', 'fetch'];
   const at = order.indexOf(frame.phase);
   this.index.rootSlots.forEach((g, i) => g.setAttribute('data-state', at >= 1 ? (i === r.child ? 'chosen' : '') : at === 0 ? 'reading' : ''));
   this.index.branchSlots.forEach((list, bi) => list.forEach((g, si) => g.setAttribute('data-state',
    bi === r.child && at >= 2 && branches[bi][si].child === b.child ? 'chosen' : '')));
   this.index.leafRows.forEach((rect, li) => rect.setAttribute('data-state', at >= 3 && li === b.child ? 'current' : ''));
   customerIndex.forEach((o) => {
    const k = run.findIndex((x) => x.id === o.id);
    setCell(this.index.cells.get(o.id), at >= 3 ? (k >= 0 ? (frame.phase === 'fetch' && k === frame.fetched - 1 && frame.fetched < run.length ? 'reading' : 'found') : '') : '');
    setCell(this.heap.cells.get(o.id), frame.phase === 'fetch' && k >= 0 && k < frame.fetched ? 'fetch' : '');
   });
   const fetched = run.slice(0, frame.fetched);
   this.heap.pages.forEach((label, p) => label.setAttribute('data-state', fetched.some((o) => o.page === p) ? 'read' : ''));
   this.overlay.replaceChildren();
   fetched.forEach((o) => pointer(this.overlay, centre(this.index.origin, this.index.cells.get(o.id)!), centre(this.heap.origin, this.heap.cells.get(o.id)!), this.vertical));
   this.counters([['index pages read', Math.max(0, Math.min(at, 3))], ['table pages read', new Set(fetched.map((o) => o.page)).size], ['rows found', at >= 3 ? run.length : 0, true]]);
  }
 }
 if (!customElements.get('ix-descent-figure')) customElements.define('ix-descent-figure', DescentFigure);
</script>
