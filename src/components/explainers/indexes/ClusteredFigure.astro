---
import './indexes.css';
import { orders, PAGE_ROWS } from './model';
const { number = 3 } = Astro.props;

// Customer 42's orders, as in the other figures. In a table stored in key
// order, rows sit on pages by order_id, six to a page.
const mine = orders.filter((o) => o.customer === 42).sort((a, b) => a.id - b.id);
const pageOf = (id: number) => Math.floor((id - 1) / PAGE_ROWS);
const rows = mine.map((o) => {
  const page = pageOf(o.id);
  return { id: o.id, page, cells: Array.from({ length: PAGE_ROWS }, (_, i) => page * PAGE_ROWS + i + 1) };
});
---
<div class="ix-figure ix-clustered" data-figure data-ready>
 <figure aria-labelledby="ix-clustered-title">
  <div class="ix-head"><span class="ix-number">Figure {number}</span><p class="ix-name" id="ix-clustered-title">Finding customer 42’s orders when the table is stored in key order</p></div>
  <div class="ix-board paper-surface">
   <div class="cl-grid">
    <p class="cl-head">Index on <code>customer_id</code>: four entries</p>
    <p class="cl-head cl-head-table">Orders table, stored in <code>order_id</code> order: bottom pages</p>
    {rows.map((r) => (
     <div class="cl-row">
      <div class="cl-entry"><span class="cl-key">42</span><span class="cl-ref">order {r.id}</span></div>
      <div class="cl-arrow">
       <span class="cl-sr">Search the table’s tree for order {r.id}: through its upper levels to bottom page {r.page}.</span>
       <span class="cl-path" aria-hidden="true"><span class="cl-lv">upper levels</span></span>
      </div>
      <div class="cl-page">
       <span class="cl-pageno">Page {r.page}</span>
       <span class="cl-cells">{r.cells.map((c) => <span class="cl-cell" data-hit={c === r.id ? 'true' : undefined}>{c}</span>)}</span>
      </div>
     </div>
    ))}
   </div>
  </div>
  <figcaption>The same 36 orders, with <code>order_id</code> as the key of the table itself. Each index entry holds the order’s key instead of a page and slot, so every entry sends the search back down the table’s own tree, through its upper levels, to one of four different bottom pages. The unmarked numbers are the other orders stored on each page.</figcaption>
 </figure>
</div>

<style>
 .cl-grid { display: grid; grid-template-columns: minmax(7.5rem, 11rem) minmax(0, 1fr) minmax(0, 17rem); column-gap: .6rem; row-gap: .8rem; align-items: center; }
 .cl-head { grid-column: 1; margin: 0; font: .72rem/1.4 var(--font-sans); color: var(--color-text-secondary); }
 .cl-head-table { grid-column: 3; }
 .cl-head code { font: .7rem var(--font-mono); background: none; padding: 0; }
 .cl-row { display: contents; }
 .cl-entry { display: flex; align-items: baseline; gap: .5rem; padding: .35rem .6rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface); }
 .cl-key { font: 600 .95rem var(--font-sans); font-variant-numeric: tabular-nums; }
 .cl-ref { font: .78rem var(--font-sans); color: var(--color-text-secondary); font-variant-numeric: tabular-nums; }
 .cl-arrow { position: relative; display: flex; align-items: center; justify-content: center; min-height: 1.6rem; color: var(--blue); font: .7rem var(--font-sans); text-align: center; }
 .cl-arrow::before { content: ''; position: absolute; left: 0; right: .35rem; top: 50%; border-top: 1.7px solid var(--blue); }
 .cl-arrow::after { content: ''; position: absolute; right: .1rem; top: calc(50% - 4px); width: 7px; height: 7px; border-top: 1.7px solid var(--blue); border-right: 1.7px solid var(--blue); transform: rotate(45deg); }
 .cl-path { position: relative; display: inline-flex; gap: .3rem; padding: 0 .3rem; background: var(--color-surface-alt); }
 .cl-lv { padding: .05rem .35rem; border: 1px dashed var(--blue); font: .66rem var(--font-sans); color: var(--color-text-secondary); }
 .cl-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
 .cl-page { display: flex; align-items: center; gap: .5rem; padding: .3rem .45rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface); }
 .cl-pageno { font: .72rem var(--font-sans); color: var(--color-text-secondary); white-space: nowrap; }
 .cl-cells { display: flex; gap: 2px; }
 .cl-cell { min-width: 1.5rem; padding: .2rem 0; border: 1px solid var(--color-rule); text-align: center; font: .72rem var(--font-sans); font-variant-numeric: tabular-nums; color: var(--color-text-secondary); }
 .cl-cell[data-hit] { background: color-mix(in srgb, var(--blue) 22%, var(--color-surface)); border-color: var(--blue); color: var(--color-text); font-weight: 600; }
 @media (max-width: 640px) {
  .cl-grid { grid-template-columns: minmax(0, 1fr); row-gap: .3rem; }
  .cl-head, .cl-head-table { grid-column: 1; }
  .cl-head-table { display: none; }
  .cl-row { display: block; margin-top: .6rem; }
  .cl-arrow { min-height: 1.5rem; justify-content: flex-start; padding-left: 1.2rem; }
  .cl-arrow::before { left: .5rem; right: auto; top: 0; bottom: 0; border-top: 0; border-left: 1.7px solid var(--blue); }
  .cl-arrow::after { right: auto; left: calc(.5rem - 4px); top: auto; bottom: 0; transform: rotate(135deg); }
  .cl-path { background: none; }
 }
</style>
