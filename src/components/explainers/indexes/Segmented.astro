---
// A row of two to four pressed/unpressed buttons for one figure parameter.
interface Props {
  name: string;
  label: string;
  options: { value: string; label: string; code?: boolean }[];
  value: string;
}
const { name, label, options, value } = Astro.props;
---
<span class="ix-seg-wrap">
 <span class="ix-seg-label" id={`ix-seg-${name}`}>{label}</span>
 <span class="ix-seg" role="group" aria-labelledby={`ix-seg-${name}`} data-segmented data-param={name} data-value={value}>
  {options.map((o) => (
   <button type="button" data-value={o.value} aria-pressed={String(o.value === value)}>{o.code ? <code>{o.label}</code> : o.label}</button>
  ))}
 </span>
</span>
