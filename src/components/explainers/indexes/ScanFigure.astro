---
import IndexFigure from './IndexFigure.astro';
const { number = 1 } = Astro.props;
---
<IndexFigure tag="ix-scan-figure" number={number} title="Sequential scan for customer 42">
 <pre slot="query"><code>SELECT * FROM orders WHERE customer_id = 42;</code></pre>
 The invented orders table that most figures use: 36 rows, six to a page. Each cell shows a row’s <code>customer_id</code> above its order number. Step through it, or play it and watch the counters.
 <span slot="fallback">A sequential scan reads all six pages and checks all 36 rows. Four rows match customer 42: orders 3, 11, 21 and 36, on pages 0, 1, 3 and 5. The other 32 rows are discarded. On the 60,000-order table, the same scan read all 1,725 pages to return 60 rows.</span>
</IndexFigure>

<script>
 import { IndexFigure, canvas, type Frame, type Layout } from './player';
 import { orders, PAGES } from './model';
 import { heapPanel, heapWidth, panelHeight, setCell, readHead, moveHead, type HeapPanel } from './scene';

 interface ScanFrame extends Frame { checked: number }

 class ScanFigure extends IndexFigure<ScanFrame> {
  heap!: HeapPanel;
  head!: SVGRectElement;
  build() {
   const frames: ScanFrame[] = [{ checked: 0, note: 'Nothing tells the database where customer 42’s rows are, so the scan starts at page 0.' }];
   let found = 0;
   orders.forEach((o, i) => {
    const hit = o.customer === 42;
    if (hit) found++;
    const last = i === orders.length - 1;
    frames.push(last
     ? { checked: i + 1, note: `Done: all ${PAGES} pages read and all 36 rows checked, to return ${found}.` }
     : {
      checked: i + 1,
      quick: true,
      hold: hit ? 1100 : o.slot === 6 ? 520 : 340,
      note: hit ? `Page ${o.page}, item ${o.slot}: customer 42. A match.` : `Page ${o.page}, item ${o.slot}: customer ${o.customer}. Discarded.`,
     });
   });
   return frames;
  }
  draw(layout: Layout) {
   const root = canvas(this.stage, heapWidth + 8, panelHeight + 6, 'The orders table as six pages of six rows, scanned row by row for customer 42.', layout === 'wide' ? 1.45 : 1.2);
   this.heap = heapPanel(root, 4, 2);
   this.head = readHead(this.heap.cells.get(1)!.g.parentNode as SVGGElement);
  }
  render(frame: ScanFrame) {
   let matched = 0;
   orders.forEach((o, i) => {
    const c = this.heap.cells.get(o.id);
    if (i < frame.checked) { setCell(c, o.customer === 42 ? 'match' : 'reject'); if (o.customer === 42) matched++; }
    else setCell(c, '');
   });
   const current = frame.checked === 0 || frame.checked === orders.length ? null : this.heap.cells.get(orders[frame.checked - 1].id)!;
   moveHead(this.head, current ? [current.x, current.y] : null);
   const page = frame.checked === 0 ? 0 : orders[frame.checked - 1].page;
   this.heap.pages.forEach((label, p) => label.setAttribute('data-state', frame.checked === 0 ? (p === 0 ? 'current' : '') : p < page || frame.checked === orders.length ? 'read' : p === page ? 'current' : ''));
   const pagesRead = frame.checked === 0 ? 0 : page + 1;
   this.counters([['pages read', `${pagesRead} of ${PAGES}`], ['rows checked', frame.checked], ['rows matched', matched, true]]);
   this.scale('1,725 pages read to return 60 rows');
  }
 }
 if (!customElements.get('ix-scan-figure')) customElements.define('ix-scan-figure', ScanFigure);
</script>
