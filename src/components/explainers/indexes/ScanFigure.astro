---
import IndexFigure from './IndexFigure.astro';
const { number = 1 } = Astro.props;
---
<IndexFigure tag="ix-scan-figure" number={number} title="A sequential scan checks every row">
 <pre slot="query"><code>SELECT * FROM orders WHERE customer_id = 42;</code></pre>
 The invented 36-row orders table used in every figure, six rows to a page. With no index, the only way to find customer 42 is to read each page and test each row. Each cell shows a row’s <code>customer_id</code> and its order number.
 <span slot="fallback">The scan reads all six pages and checks all 36 rows to find the four orders for customer 42, on pages 0, 1, 3 and 5.</span>
</IndexFigure>

<script>
 import { IndexFigure, canvas, type Frame, type Layout } from './player';
 import { orders, PAGES } from './model';
 import { heapPanel, heapWidth, panelHeight, setCell, type HeapPanel } from './scene';

 interface ScanFrame extends Frame { checked: number }

 class ScanFigure extends IndexFigure<ScanFrame> {
  heap!: HeapPanel;
  build() {
   const frames: ScanFrame[] = [{ checked: 0, note: 'The table has 36 orders on six pages. Nothing tells the database where customer 42’s rows are, so it starts at page 0.', hold: 1300 }];
   let found = 0;
   orders.forEach((o, i) => {
    const hit = o.customer === 42;
    if (hit) found++;
    const last = i === orders.length - 1;
    frames.push({
     checked: i + 1,
     hold: last ? 1600 : hit ? 900 : o.slot === 6 ? 450 : 260,
     note: last
      ? `Done. The scan read all ${PAGES} pages and checked all 36 rows to return ${found}. Only the last row told it there were no more matches.`
      : hit ? `Page ${o.page}, row ${o.slot}: customer ${o.customer}. A match, the ${['first', 'second', 'third', 'fourth'][found - 1]} so far.`
      : `Page ${o.page}, row ${o.slot}: customer ${o.customer}. Not 42, so the row is discarded.`,
    });
   });
   return frames;
  }
  draw(layout: Layout) {
   const root = canvas(this.stage, heapWidth + 8, panelHeight + 6, 'The orders table as six pages of six rows, scanned row by row for customer 42.', layout === 'wide' ? 1.45 : 1.2);
   this.heap = heapPanel(root, 4, 2);
  }
  render(frame: ScanFrame) {
   let matched = 0;
   orders.forEach((o, i) => {
    const c = this.heap.cells.get(o.id);
    if (i < frame.checked - 1) { setCell(c, o.customer === 42 ? 'match' : 'reject'); if (o.customer === 42) matched++; }
    else if (i === frame.checked - 1) { setCell(c, o.customer === 42 ? 'match' : 'reading'); if (o.customer === 42) matched++; }
    else setCell(c, '');
   });
   const current = frame.checked === 0 ? 0 : orders[frame.checked - 1].page;
   this.heap.pages.forEach((label, p) => label.setAttribute('data-state', frame.checked === 0 ? (p === 0 ? 'current' : '') : p < current ? 'read' : p === current ? (frame.checked === 36 ? 'read' : 'current') : ''));
   const pagesRead = frame.checked === 0 ? 0 : current + 1;
   this.counters([['pages read', `${pagesRead} of ${PAGES}`], ['rows checked', frame.checked], ['rows matched', matched, true]]);
  }
 }
 if (!customElements.get('ix-scan-figure')) customElements.define('ix-scan-figure', ScanFigure);
</script>
