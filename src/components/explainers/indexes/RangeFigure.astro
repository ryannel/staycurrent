---
import IndexFigure from './IndexFigure.astro';
import { customers } from './model';
const { number = 4 } = Astro.props;
---
<IndexFigure tag="ix-range-figure" number={number} title="Range scan along the leaf pages">
 <pre slot="query"><code>SELECT * FROM orders
WHERE customer_id BETWEEN <span data-lo-echo>20</span> AND <span data-hi-echo>34</span>
ORDER BY customer_id;</code></pre>
 <Fragment slot="params">
  <label>From <select data-param="lo">{customers.map((c) => <option value={c} selected={c === 20}>{c}</option>)}</select></label>
  <label>to <select data-param="hi">{customers.map((c) => <option value={c} selected={c === 34}>{c}</option>)}</select></label>
 </Fragment>
 The tree from Figure 3, with each leaf page linked to the next. Table fetches are left out. Choose a range and watch where the scan starts, which links it follows and where it stops.
 <span slot="fallback">For customers 20 to 34, the search descends to leaf page 2, reads 20, 20, 23 and 23, follows the link to leaf page 3, reads 27 to 34, and stops at the first entry of leaf page 4, which is 42. On the 60,000-order table, customers 40 to 45 have 360 entries, read from 3 index pages.</span>
</IndexFigure>

<script>
 import { IndexFigure, canvas, svg, type Frame, type Layout } from './player';
 import { customerIndex, root, branches, slotFor, PAGE_ROWS } from './model';
 import { indexPanel, indexWidth, panelHeight, setCell, readHead, moveHead, G, cellY, gridWidth, type IndexPanel } from './scene';

 type Phase = 'start' | 'root' | 'branch' | 'scan' | 'stop' | 'end';
 interface RangeFrame extends Frame { phase: Phase; pos: number }

 class RangeFigure extends IndexFigure<RangeFrame> {
  panel!: IndexPanel;
  links: SVGPathElement[] = [];
  head!: SVGRectElement;
  bounds() {
   const a = Number(this.param('lo')), b = Number(this.param('hi'));
   return a <= b ? [a, b] : [b, a];
  }
  build(): RangeFrame[] {
   const [lo, hi] = this.bounds();
   this.querySelector('[data-lo-echo]')!.textContent = String(lo);
   this.querySelector('[data-hi-echo]')!.textContent = String(hi);
   const r = slotFor(root, lo);
   const b = slotFor(branches[r.child], lo);
   const first = customerIndex.findIndex((o) => o.customer >= lo);
   const frames: RangeFrame[] = [
    { phase: 'start', pos: -1, hold: 1100, short: `Find the first entry ≥ ${lo}.`, note: `The range starts at ${lo}. The search looks for the first entry that is ${lo} or more, starting at the root.` },
    { phase: 'root', pos: -1, hold: 1200, short: 'Root page.', note: `Root page: ${lo} ${lo < 42 ? 'is below 42' : 'is not below 42'}, so go to the branch page for ${r.child === 0 ? 'keys below 42' : '42 and above'}.` },
    { phase: 'branch', pos: -1, hold: 1200, short: `Branch page: go to leaf page ${b.child + 1}.`, note: `Branch page: ${lo} falls in ${b.label}, so go to leaf page ${b.child + 1}. This is the only descent the scan makes.` },
   ];
   let returned = 0;
   for (let i = first; i < customerIndex.length; i++) {
    const o = customerIndex[i];
    const crossed = i > first && i % PAGE_ROWS === 0;
    if (o.customer > hi) {
     frames.push({ phase: 'stop', pos: i, hold: 1800, short: `${o.customer} is past ${hi}: stop.`, note: `${crossed ? `Follow the link to leaf page ${Math.floor(i / PAGE_ROWS) + 1}. ` : ''}The next entry is ${o.customer}, past ${hi}. The scan stops here: ${returned} ${returned === 1 ? "entry" : "entries"} returned, already in order, and no later leaf page is read.` });
     return frames;
    }
    returned++;
    frames.push(crossed
     ? { phase: 'scan', pos: i, hold: 1300, short: `Follow the link to leaf page ${Math.floor(i / PAGE_ROWS) + 1}.`, note: `End of the leaf page. Follow its link to leaf page ${Math.floor(i / PAGE_ROWS) + 1} without going back up the tree. Entry ${o.customer} is in range.` }
     : { phase: 'scan', pos: i, hold: 600, quick: true, note: `Entry ${o.customer} is in range. Return it and move to the next entry.` });
   }
   frames.push({ phase: 'end', pos: customerIndex.length, hold: 1800, short: 'End of the last leaf page.', note: `The scan reached the last leaf page: ${returned} ${returned === 1 ? "entry" : "entries"} returned, in order.` });
   return frames;
  }
  draw(layout: Layout) {
   const w = indexWidth(true) + 22;
   const svgRoot = canvas(this.stage, w, panelHeight + 6, 'The B-tree index on customer_id with links between neighbouring leaf pages. A range scan descends once, then reads along the leaves.', 1.3);
   svgRoot.toggleAttribute('data-small', layout === 'narrow');
   this.panel = indexPanel(svgRoot, 4, 2, customerIndex, { title: 'leaf pages · customer_id', tree: true });
   this.links = [];
   const x = this.panel.gridX + gridWidth + 4;
   for (let r = 0; r < 5; r++) {
    const y1 = cellY(r) + G.ch / 2, y2 = cellY(r + 1) + G.ch / 2;
    const path = svg('path', { class: 'ix-sibling', d: `M ${x} ${y1} C ${x + 13} ${y1}, ${x + 13} ${y2}, ${x} ${y2}`, 'marker-end': '' }) as SVGPathElement;
    this.panel.group.append(path);
    this.links.push(path);
   }
   this.head = readHead(this.panel.group);
  }
  render(frame: RangeFrame) {
   const [lo, hi] = this.bounds();
   const r = slotFor(root, lo);
   const b = slotFor(branches[r.child], lo);
   const order: Phase[] = ['start', 'root', 'branch', 'scan', 'stop', 'end'];
   const at = order.indexOf(frame.phase);
   this.panel.rootSlots.forEach((g, i) => g.setAttribute('data-state', at >= 1 && i === r.child ? 'chosen' : at === 0 ? 'reading' : ''));
   this.panel.branchSlots.forEach((list, bi) => list.forEach((g, si) => g.setAttribute('data-state', at >= 2 && bi === r.child && branches[bi][si].child === b.child ? 'chosen' : '')));
   const first = customerIndex.findIndex((o) => o.customer >= lo);
   const currentLeaf = frame.pos >= 0 ? Math.floor(Math.min(frame.pos, customerIndex.length - 1) / PAGE_ROWS) : at >= 2 ? b.child : -1;
   const firstLeaf = Math.floor(first / PAGE_ROWS);
   this.panel.leafRows.forEach((rect, li) => rect.setAttribute('data-state', li === currentLeaf && frame.phase !== 'end' ? 'current' : li >= firstLeaf && li < currentLeaf ? 'read' : ''));
   this.links.forEach((path, li) => path.setAttribute('data-state', li >= firstLeaf && li < currentLeaf ? 'used' : ''));
   customerIndex.forEach((o, i) => {
    const c = this.panel.cells.get(o.id);
    if (frame.pos < 0 || i < first) setCell(c, '');
    else if (i < frame.pos) setCell(c, 'match');
    else if (i === frame.pos) setCell(c, frame.phase === 'stop' ? 'reject' : frame.phase === 'scan' ? 'reading' : '');
    else setCell(c, '');
   });
   const returned = frame.pos < 0 ? 0 : customerIndex.slice(first, frame.pos + (frame.phase === 'scan' ? 1 : 0)).filter((o) => o.customer <= hi).length;
   const pages = at < 1 ? 0 : at === 1 ? 1 : at === 2 ? 2 : 2 + (currentLeaf - firstLeaf + 1);
   if (frame.phase === 'scan') setCell(this.panel.cells.get(customerIndex[frame.pos].id), 'reading');
   const at2 = frame.phase === 'scan' || frame.phase === 'stop' ? this.panel.cells.get(customerIndex[frame.pos].id)! : null;
   moveHead(this.head, at2 ? [at2.x, at2.y] : null);
   this.counters([['index pages read', pages], [returned === 1 ? 'entry returned' : 'entries returned', returned, true], ['sort needed', 'no']]);
   this.scale('customers 40 to 45, 360 entries from 3 index pages');
  }
 }
 if (!customElements.get('ix-range-figure')) customElements.define('ix-range-figure', RangeFigure);
</script>
