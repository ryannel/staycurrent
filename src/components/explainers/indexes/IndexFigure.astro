---
import './indexes.css';
interface Props {
  tag: string;
  number: number;
  title: string;
  id?: string;
}
const { tag, number, title, id } = Astro.props;
const Tag = tag;
const titleId = `${tag}-title`;
---
<Tag class="ix-figure" id={id} data-figure>
 <figure aria-labelledby={titleId}>
  <div class="ix-head"><span class="ix-number">Figure {number}</span><p class="ix-name" id={titleId}>{title}</p></div>
  {Astro.slots.has('query') && <div class="ix-query"><slot name="query" /></div>}
  <div class="ix-board paper-surface">
   <div class="ix-counters" data-counters></div>
   <div class="ix-stage" data-stage tabindex="-1"></div>
   <p class="ix-status" data-status role="status" aria-live="polite"></p>
  </div>
  <div class="ix-controls" role="group" aria-label={`Controls for figure ${number}`}>
   {Astro.slots.has('params') && <div class="ix-params"><slot name="params" /></div>}
   <div class="ix-transport">
    <button type="button" data-play aria-pressed="false">Play</button>
    <button type="button" data-back aria-label="Step back">‹ Back</button>
    <button type="button" data-next aria-label="Step forward">Next ›</button>
    <button type="button" data-reset>Reset</button>
    <span class="ix-step" data-step></span>
   </div>
  </div>
  <figcaption><slot /></figcaption>
  <noscript><p class="ix-noscript"><slot name="fallback" /></p></noscript>
 </figure>
</Tag>
