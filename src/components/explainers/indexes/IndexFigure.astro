---
import './indexes.css';
interface Props {
  tag: string;
  number: number;
  title: string;
  /** Show a line under the counters with the same measurement on the 60,000-order table. */
  scale?: boolean;
}
const { tag, number, title, scale = true } = Astro.props;
const Tag = tag;
const titleId = `${tag}-title`;
const fallbackId = `${tag}-text`;
---
<Tag class="ix-figure" data-figure>
 <figure aria-labelledby={titleId}>
  <div class="ix-head"><span class="ix-number">Figure {number}</span><p class="ix-name" id={titleId}>{title}</p></div>
  {Astro.slots.has('query') && <div class="ix-query"><slot name="query" /></div>}
  <p class="ix-fallback" id={fallbackId}><slot name="fallback" /></p>
  <div class="ix-board paper-surface">
   <div class="ix-counters" data-counters></div>
   {scale && <p class="ix-scale" data-scale hidden><span data-scale-label></span> <strong data-scale-value></strong></p>}
   <div class="ix-stage" data-stage tabindex="-1"></div>
   <p class="ix-status" data-status role="status" aria-live="polite"></p>
  </div>
  <div class="ix-controls" role="group" aria-label={`Figure ${number} controls`}>
   {Astro.slots.has('params') && <div class="ix-params"><slot name="params" /></div>}
   <div class="ix-transport">
    <button type="button" data-play>Play</button>
    <button type="button" data-back><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>Back</button>
    <button type="button" data-next>Next<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg></button>
    <label class="ix-scrub"><span>Step</span><input type="range" data-scrub min="1" max="1" step="1" value="1" /></label>
    <button type="button" data-reset>Reset</button>
    <span class="ix-step" data-step></span>
   </div>
  </div>
  <figcaption><slot /></figcaption>
 </figure>
</Tag>
