---
import { Code } from 'astro:components';
import { countryReport } from '../../lib/explainers/models.mjs';
interface Props { shop?: string }
const { shop = 'all' } = Astro.props;
const result = countryReport(undefined, shop);
const query = `SELECT shop, country,\n       count(*) AS views\nFROM page_views${shop === 'all' ? '' : `\nWHERE shop = '${shop}'`}\nGROUP BY shop, country\nORDER BY shop, country;`;
---
<figure class="query-example wide">
  <figcaption class="example-type">SQL example</figcaption>
  <div><p class="example-label">{shop === 'all' ? 'Count the 16 page views' : `The same report, just for shop ${shop}`}</p><Code code={query} lang="sql" theme="css-variables" /></div>
  <table>
    <caption>{shop === 'all' ? 'The result, in either storage layout' : `Result: ${result.reduce((n, r) => n + r.views, 0)} page views`}</caption>
    <thead><tr><th scope="col">shop</th><th scope="col">country</th><th scope="col">views</th></tr></thead>
    <tbody>{result.map(r => <tr><td>{r.shop}</td><td>{r.country}</td><td>{r.views}</td></tr>)}</tbody>
  </table>
</figure>
