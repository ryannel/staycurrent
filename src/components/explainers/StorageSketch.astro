---
import SketchRelational from './SketchRelational.astro';
import SketchDataPlates from './SketchDataPlates.astro';
import SketchSystemsPlates from './SketchSystemsPlates.astro';
interface Props { kind: 'relational' | 'records' | 'keys' | 'columns' | 'search' | 'graphs' | 'caches' }
const { kind } = Astro.props;
---
{kind === 'relational' && <SketchRelational />}
{(kind === 'records' || kind === 'keys' || kind === 'columns') && <SketchDataPlates kind={kind} />}
{(kind === 'search' || kind === 'graphs' || kind === 'caches') && <SketchSystemsPlates kind={kind} />}
