---
import { Image, getImage } from 'astro:assets';
import lightArtwork from '../../assets/explainers/sketch-relational-light.png';
import darkArtwork from '../../assets/explainers/sketch-relational-dark.png';
const dark = await getImage({src:darkArtwork,width:1200,format:'webp'});
const labels = [
 ['Customers table',25.5,19],['Orders table',68,19],
 ['Ada',31.5,31],['C4',31.5,40],['O12 · C4',68.2,35],
 ['C4',49.2,32],['O12',93.3,52],['P7',49.2,71.5],
 ['Products table',24.5,59],['Order lines',66.1,59],
 ['P7',34,74],['Blue mug',23.1,84],
 ['O12 · P7',69,70.5],['Quantity: 2',70,80.5],
];
---
<figure class="paper-surface relational-plate" id="plate-relational" aria-labelledby="sketch-relational">
 <span class="plate-number">Illustration</span>
 <h3 id="sketch-relational">Separate records, connected by IDs</h3>
 <div class="crop"><div class="artwork">
  <picture><source media="(prefers-color-scheme: dark)" srcset={dark.src}/><Image src={lightArtwork} alt="Four table records. The order refers to Ada’s customer record; the order line refers to that order and to the blue mug product." widths={[600,1000,1448]} sizes="(max-width: 700px) 100vw, 640px" format="webp" loading="lazy"/></picture>
  {labels.map(([text,x,y])=><span class="label" style={`left:${x}%;top:${y}%`}>{text}</span>)}
 </div></div>
 <figcaption>Ada (C4) placed order O12. Its order line refers to product P7, the blue mug. Shared IDs let a query connect these records without copying the customer and product details into every order. The sheets represent tables; only one record from each is drawn.</figcaption>
</figure>
<style>
 .relational-plate{margin:2rem 0;padding:1.2rem;font:.8rem/1.6 var(--font-sans);scroll-margin-top:1rem}
 .crop{overflow:hidden}.artwork{position:relative;container-type:inline-size;color:#383a35;margin-top:-10%}
 img{display:block;width:100%;height:auto}
 h3{margin:0 0 1rem;font:500 1.35rem/1.3 var(--font-serif)}
 .label{position:absolute;transform:translate(-50%,-50%);white-space:nowrap;font:500 clamp(10px,3.15cqw,21px)/1.2 var(--font-serif)}
 figcaption{border-top:1px solid var(--color-rule-strong);padding-top:1rem;margin-top:1rem;color:var(--color-text-secondary);font-size:.75rem}
 @media(prefers-color-scheme:dark){.artwork{color:#e3dfd4}}
 @media(max-width:550px){.relational-plate{padding:.65rem}h3{font-size:1.2rem}}
</style>
