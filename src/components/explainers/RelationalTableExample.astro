<figure class="table-example paper-surface" id="table-example" aria-labelledby="table-example-title">
  <span class="plate-number">Example table</span>
  <h3 id="table-example-title">Products</h3>
  <p>Each row describes one product. Each column holds one kind of information about it.</p>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Products table">
    <table>
      <caption class="visually-hidden">Two products, with their identifiers, names, current prices, and available quantities</caption>
      <thead><tr><th scope="col">Product ID</th><th scope="col">Name</th><th scope="col">Price</th><th scope="col">In stock</th></tr></thead>
      <tbody>
        <tr><th scope="row">P7</th><td>Blue mug</td><td>€20</td><td>5</td></tr>
        <tr><th scope="row">P8</th><td>Bowl</td><td>€24</td><td>3</td></tr>
      </tbody>
    </table>
  </div>
  <figcaption>The product ID distinguishes each product. Price means the current price per item; stock counts the items available. This shows the table’s contents, not their physical arrangement on disk.</figcaption>
</figure>
<style>
  .table-example { margin:2rem 0; padding:1.2rem; font:.85rem/1.65 var(--font-sans); }
  h3 { margin:0 0 .75rem; font:500 1.4rem/1.3 var(--font-serif); }
  p { margin:0 0 1rem; font-size:.85rem; }
  .table-scroll { overflow-x:auto; }
  .table-example table { display:table; width:100%; margin:0; border-collapse:collapse; font:.85rem/1.5 var(--font-sans); }
  th,td { padding:.7rem .4rem; text-align:left; border-bottom:1px solid var(--color-rule-strong); }
  th { font-weight:600; }
  tbody th { font:500 .8rem/1.5 var(--font-mono); }
  figcaption { margin:1rem 0 0; font:.78rem/1.6 var(--font-sans); color:var(--color-text-secondary); }
  :focus-visible { outline:2px solid var(--teal); outline-offset:4px; }
  @media(max-width:480px) { .table-example { padding:.8rem; } table{font-size:.77rem} th,td{padding:.6rem .3rem} }
</style>
