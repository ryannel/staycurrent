---
import SketchSheet from '../design/SketchSheet.astro';
import SketchArrow from '../design/SketchArrow.astro';
import '../design/design-aids.css';
---
<pagination-lab class="lab design-lab design-aid" aria-labelledby="pagination-title">
  <div class="lab-introduction"><span class="plate-number">Interactive · Continuing after a change</span><h3 id="pagination-title">What comes after the first two orders?</h3><p>We already read O16 and O15, both placed at 12:00 UTC. The order is newest time first, then descending order ID. Unread O14 has the same time, 12:00, but follows O15 by ID. Each next page contains two orders. Choose one change after that first read, then compare the two ways to continue.</p></div>
  <div class="lab-controls" data-controls><p class="lab-area-label">Controls</p><div class="control-line"><label for="pagination-change">Change between reads</label><select id="pagination-change" data-change><option value="none">No change</option><option value="insert">Add O17 at 13:00</option><option value="delete">Delete already-read O16</option><option value="move">Move unread O14 to 13:00</option></select></div></div>
  <div class="lab-output paper-surface"><p class="lab-area-label">Result</p><h4>Orders visible to the second read</h4><ol class="ordered-records" data-order><li><strong>O16 · 12:00</strong><span>Already read</span></li><li><strong>O15 · 12:00</strong><span>Already read</span></li><li><strong>O14 · 12:00</strong><span>Unread</span></li><li><strong>O13 · 10:00</strong><span>Unread</span></li><li><strong>O12 · 09:00</strong><span>Unread</span></li></ol>
    <div class="continuation"><SketchArrow direction="down" /><span>Two continuation rules, applied to these same visible rows</span></div>
    <div class="methods"><SketchSheet tone="amber"><h4>Skip two current positions</h4><p class="rule">OFFSET 2 LIMIT 2</p><p class="answer" data-offset>O14, O13</p><p data-offset-note>Both are unread orders.</p></SketchSheet><SketchSheet tone="teal"><h4>Continue after O15’s key</h4><p class="rule">Earlier than (12:00, O15)</p><p class="answer" data-keyset>O14, O13</p><p data-keyset-note>O14 shares O15’s time; its smaller ID puts it after the saved pair.</p></SketchSheet></div>
    <p class="design-state" data-explanation role="status" aria-live="polite" aria-atomic="true">With no change, both methods return O14 and O13.</p>
  </div>
  <details class="model-note"><summary>What this experiment represents</summary><p>This is an in-browser model of ordered records, not a live database. Each choice starts from the same completed first read; changes are alternatives, not cumulative. All dates are 4 October 2026, times are UTC, and IDs are compared in the shown order. Neither method retains a snapshot. An earlier timestamp or ID correction can move a record across the saved boundary.</p></details>
  <noscript><p>After inserting O17, offset returns O15 and O14, repeating O15; keyset returns O14 and O13. After deleting O16, offset skips unread O14; keyset still returns O14 and O13. Moving unread O14 to 13:00 puts it before the saved key, so keyset misses it too.</p></noscript>
</pagination-lab>
<script>
 class PaginationLab extends HTMLElement {
   connectedCallback() {
     if (this.dataset.ready) return;
     this.dataset.ready = 'true';
     const choice = this.querySelector<HTMLSelectElement>('[data-change]')!;
     const write = (selector:string, value:string) => { this.querySelector(selector)!.textContent = value; };
     const update = () => {
       const records = [{id:'O16',hour:12},{id:'O15',hour:12},{id:'O14',hour:12},{id:'O13',hour:10},{id:'O12',hour:9}];
       if(choice.value === 'insert') records.push({id:'O17',hour:13});
       if(choice.value === 'delete') records.splice(records.findIndex(row=>row.id==='O16'),1);
       if(choice.value === 'move') records.find(row=>row.id==='O14')!.hour=13;
       records.sort((a,b)=>b.hour-a.hour || (a.id < b.id ? 1 : a.id > b.id ? -1 : 0));
       const list = this.querySelector('[data-order]')!;
       list.replaceChildren(...records.map(row=>{
         const item=document.createElement('li');
         const title=document.createElement('strong'); title.textContent=`${row.id} · ${String(row.hour).padStart(2,'0')}:00`;
         const state=document.createElement('span'); state.textContent=['O16','O15'].includes(row.id)?'Already read':row.id==='O17'?'New order':'Unread';
         item.dataset.seen=String(['O16','O15'].includes(row.id)); item.append(title,state); return item;
       }));
       const offset=records.slice(2,4), keyset=records.filter(row=>row.hour<12 || row.hour===12 && row.id<'O15').slice(0,2);
       write('[data-offset]',offset.map(row=>row.id).join(', ')); write('[data-keyset]',keyset.map(row=>row.id).join(', '));
       const notes:Record<string,[string,string,string]>={
         none:['Both are unread orders.','O14 shares O15’s time; its smaller ID puts it after the saved pair.','With no change, both methods return O14 and O13.'],
         insert:['O15 repeats from the first page.','O14 and O13 follow the saved key.','The new order shifts positions. It does not move the saved boundary; O17 belongs before it.'],
         delete:['Unread O14 was skipped.','The saved values still locate the boundary.','Deleting O16 shifts the remaining positions. Continuing after O15 still finds O14, even though page one’s size no longer matches the rows before it.'],
         move:['O15 repeats; unread O14 moved before the skipped positions.','Unread O14 moved before the saved key and is missed.','Keyset preserves a value boundary, not a frozen membership list. An unread record can move across that boundary when its sort value changes.']
       };
       const note=notes[choice.value]; write('[data-offset-note]',note[0]); write('[data-keyset-note]',note[1]); write('[data-explanation]',note[2]);
     };
     choice.addEventListener('change',update); update();
   }
 }
 if(!customElements.get('pagination-lab')) customElements.define('pagination-lab',PaginationLab);
</script>
<style>
 pagination-lab { display:block; margin:2rem 0; }
 .ordered-records { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); list-style:none; padding:0; margin:1rem 0; gap:.5rem; counter-reset:position; }
 .ordered-records :global(li) { padding:.55rem .65rem; border-top:1px solid var(--color-text-secondary); counter-increment:position; background:var(--paper-panel); }
 .ordered-records :global(li::before) { content:counter(position) ". "; font-size:.75rem; color:var(--color-text-secondary); }
 .ordered-records :global(strong) { font-weight:500; font-size:.83rem; }
 .ordered-records :global(span) { display:block; color:var(--color-text-secondary); font-size:.74rem; }
 .ordered-records :global([data-seen="true"]) { background:var(--paper-highlight); }
 .continuation { display:flex; align-items:center; gap:.7rem; justify-content:center; font-size:.75rem; }
 .methods { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
 .rule { font:.72rem/1.6 var(--font-mono); color:var(--color-text-secondary); }
 .answer { font-size:1.2rem; border-top:1px solid var(--color-rule); padding-top:.5rem; }
 .methods p { font-size:.8rem; }
 @media(max-width:600px) { .ordered-records { grid-template-columns:repeat(2,minmax(0,1fr)); } .methods { grid-template-columns:1fr; } }
</style>
