---
interface Props { caption: string; columns: string[]; rows: (string | number)[][]; }
const { caption, columns, rows } = Astro.props;
---
<div class="table-scroll" role="region" tabindex="0" aria-label={caption}>
  <table><caption>{caption}</caption><thead><tr>{columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
  <tbody>{rows.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table>
</div>
