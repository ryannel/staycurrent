---
import { queryWork } from './query-work-model';
const initial = queryWork(2, 2);
---
<section class="query-work-lab" data-query-work aria-labelledby="query-work-title">
  <header><span class="lab-kicker">Experiment · Same answer, different work</span><h3 id="query-work-title">Finding the names on a receipt</h3>
  <p>Each purchase line needs one product name. Add lines to the receipt or unrelated products to the catalogue, then compare two ways of finding the matches.</p></header>
  <div class="work-controls" role="group" aria-labelledby="query-work-controls-label">
    <p class="lab-kicker controls-label" id="query-work-controls-label">Controls</p>
    <label>Catalogue size<select data-catalogue><option value="2">2 products</option><option value="20">20 products</option><option value="200">200 products</option></select></label>
    <label>Receipt size<select data-lines><option value="1">1 line</option><option value="2" selected>2 lines</option><option value="6">6 lines</option></select></label>
    <label>Join method<select data-method><option value="scan">Scan products for each line</option><option value="lookup">Build a lookup, then probe it</option></select></label>
  </div>
  <div class="work-result paper-surface">
    <p class="lab-kicker">Result · Inputs and route</p>
    <p data-inputs>2 products: P7 is Blue mug, P8 is Bowl. The receipt has 2 lines, alternating P7 and P8.</p>
    <ol class="work-route" data-route><li>Take line 1 (P7). Compare its ID with all 2 products → Blue mug.</li><li>Take line 2 (P8). Compare its ID with all 2 products → Bowl.</li></ol>
    <div class="work-counts" aria-live="polite" aria-atomic="true"><p data-count>4 product-ID comparisons; 2 result rows.</p></div>
    <div class="work-table" tabindex="0" role="region" aria-label="Joined receipt result">
      <table><caption>Receipt result · ordered by line number; amounts in EUR</caption><thead><tr><th scope="col">Line</th><th scope="col">Product</th><th scope="col">Name</th><th scope="col">Amount</th></tr></thead>
      <tbody data-rows>{initial.scanRows.map(row => <tr><td>{row.line}</td><td>{row.product}</td><td>{row.name}</td><td>{row.amount.toFixed(2)}</td></tr>)}</tbody></table>
    </div>
    <p data-comparison>Building the lookup would instead store 2 product entries and make 2 probes. Both methods return the same 2 rows.</p>
  </div>
  <p class="work-prompt">Try 200 products and 6 lines. Switch methods without changing the data. Then reduce the receipt to 1 line: how much of the lookup-building work remains?</p>
  <p class="work-scope">This browser model counts full-scan comparisons, lookup entries and probes separately; they are not equal units of time. It omits indexes, early stopping, hash collisions, memory limits, disk access and sorting costs. The added receipt lines and products belong only to this experiment. No PostgreSQL query runs here.</p>
  <noscript><p>The two-line example above is complete. Enable JavaScript to vary it. With 200 products and 6 lines, full rescans make 1,200 comparisons; the lookup stores 200 entries and receives 6 probes.</p></noscript>
</section>
<script>
  import { queryWork } from './query-work-model';
  for (const lab of document.querySelectorAll<HTMLElement>('[data-query-work]')) {
    const catalogue = lab.querySelector<HTMLSelectElement>('[data-catalogue]')!;
    const lines = lab.querySelector<HTMLSelectElement>('[data-lines]')!;
    const method = lab.querySelector<HTMLSelectElement>('[data-method]')!;
    const set = (selector: string, text: string) => { lab.querySelector(selector)!.textContent = text; };
    const render = () => {
      const model = queryWork(Number(catalogue.value), Number(lines.value));
      const scan = method.value === 'scan';
      const result = scan ? model.scanRows : model.lookupRows;
      set('[data-inputs]', `${model.products.length} products: P7 is Blue mug, P8 is Bowl.${model.products.length > 2 ? ` The other ${model.products.length - 2} products are not on this receipt.` : ''} The receipt has ${model.lines.length} ${model.lines.length === 1 ? 'line (P7)' : 'lines, alternating P7 and P8'}.`);
      const route = lab.querySelector('[data-route]')!;
      route.replaceChildren();
      const steps = scan
        ? model.scanRows.map(row => `Take line ${row.line} (${row.product}). Compare its ID with all ${model.products.length} products → ${row.name}.`)
        : [`Read the ${model.products.length} products once, storing each ID and name in a temporary lookup.`, ...model.lookupRows.map(row => `Take line ${row.line} (${row.product}). Probe the lookup for ${row.product} → ${row.name}.`)];
      for (const step of steps) { const li = document.createElement('li'); li.textContent = step; route.append(li); }
      set('[data-count]', scan ? `${model.comparisons.toLocaleString()} product-ID comparisons; ${result.length} result ${result.length === 1 ? 'row' : 'rows'}.` : `${model.builds} lookup entries stored, then ${model.probes} ${model.probes === 1 ? 'probe' : 'probes'}; ${result.length} result ${result.length === 1 ? 'row' : 'rows'}.`);
      const body = lab.querySelector('[data-rows]')!;
      body.replaceChildren();
      for (const row of result) {
        const tr = document.createElement('tr');
        for (const value of [row.line, row.product, row.name, row.amount.toFixed(2)]) { const td = document.createElement('td'); td.textContent = String(value); tr.append(td); }
        body.append(tr);
      }
      set('[data-comparison]', scan ? `Building the lookup would instead store ${model.builds} product entries and make ${model.probes} ${model.probes === 1 ? 'probe' : 'probes'}. Both methods return the same ${result.length} ${result.length === 1 ? 'row' : 'rows'}.` : `Rescanning the catalogue would instead make ${model.comparisons.toLocaleString()} product-ID comparisons. Both methods return the same ${result.length} ${result.length === 1 ? 'row' : 'rows'}.`);
    };
    for (const control of [catalogue, lines, method]) control.addEventListener('change', render);
    lab.dataset.ready = 'true';
  }
</script>
<style>
  .query-work-lab:not([data-ready]) .work-controls { display:none; }
  .query-work-lab { border:1px solid var(--color-rule-strong); border-radius:5px; padding:1.4rem; margin:2rem 0; background:var(--color-surface-alt); font-family:var(--font-sans); }
  .query-work-lab h3 { font-size:1.3rem; margin:.35rem 0 .8rem; }
  .query-work-lab p { font-size:.88rem; line-height:1.65; }
  .lab-kicker { font-size:.7rem!important; text-transform:uppercase; letter-spacing:.07em; color:var(--color-text-secondary); }
  .work-controls { display:grid; grid-template-columns:1fr 1fr; gap:.85rem; margin:1.2rem 0; padding:1rem; border:1px solid var(--blue); border-left:3px solid var(--blue); border-radius:4px; background:color-mix(in srgb, var(--blue) 7%, var(--color-surface)); }
  .controls-label { grid-column:1 / -1; margin:0; color:var(--blue); }
  .work-controls label { display:flex; flex-direction:column; gap:.4rem; font-size:.8rem; }
  .work-controls label:last-child { grid-column:1 / -1; }
  select { width:100%; min-height:44px; border:1px solid var(--color-rule-strong); border-radius:4px; background:var(--color-surface); color:var(--color-text); padding:.55rem; font:inherit; }
  select:focus-visible,.work-table:focus-visible { outline:2px solid var(--teal); outline-offset:3px; }
  .work-result { padding:1.15rem; border:1px solid var(--color-rule); }
  .work-route { list-style:none; margin:1rem 0; padding:0 0 0 1rem; border-left:2px solid var(--teal); }
  .work-route li { position:relative; padding:.45rem 0; font-size:.82rem; line-height:1.6; }
  .work-route li::before { content:'→'; position:absolute; left:-1.65rem; background:var(--color-surface-alt); color:var(--teal); }
  .work-counts { border-block:1px solid var(--color-rule); font-weight:600; }
  .work-table { overflow:auto; max-width:100%; margin:1rem 0; }
  table { border-collapse:collapse; width:100%; font-size:.8rem; }
  caption { text-align:left; font-size:.75rem; margin-bottom:.6rem; color:var(--color-text-secondary); }
  td,th { text-align:left; padding:.45rem .4rem; border-bottom:1px solid var(--color-rule); }
  .work-scope { color:var(--color-text-secondary); font-size:.75rem!important; }
  @media(max-width:550px) { .query-work-lab { padding:1rem; } .work-result { padding:.8rem; } .work-controls { grid-template-columns:1fr; } }
</style>
