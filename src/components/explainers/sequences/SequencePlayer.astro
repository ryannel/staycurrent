---
/*
 * One animated sequence diagram. The server renders the finished diagram for the
 * default settings, so the figure reads without JavaScript; the script adds playback.
 * `source`, when given, is the figure's Mermaid text, kept in a closed disclosure so
 * readers can copy it without it interrupting the reading. `still` draws the finished
 * diagram with no playback, for figures whose point is the whole drawing at once.
 */
import { Code } from 'astro:components';
import { scenarios, defaults, layout, renderSVG, events, stops } from './sequence-model';
import './async-scenarios';
import './design-scenarios';
import '../../../styles/explorables.css';
import './sequences.css';

interface Props { scenario: string; n: number; source?: string; sourceLabel?: string; still?: boolean }
const { scenario, n, source, sourceLabel = 'Mermaid source', still = false } = Astro.props;
const def = scenarios[scenario];
if (!def) throw new Error(`Unknown sequence scenario: ${scenario}`);
const s = def.build(defaults(def));
const uid = `seq-${scenario}`;
const titleId = `${uid}-title`;
const summaryId = `${uid}-summary`;
const svg = renderSVG(s, layout(s, 640), s.duration, uid, { labelledby: titleId, describedby: summaryId });
const ev = events(s);
const ticks = stops(s);
---
<seq-player class="visual-essay" data-scenario={scenario} data-uid={uid} data-still={still ? '' : undefined}>
  <figure class="seq-fig" aria-labelledby={titleId}>
    <div class="seq-head"><span class="seq-number">Figure {n}</span><p class="seq-name" id={titleId}>{def.title}</p></div>
    <div class="seq-board paper-surface">
      {s.clock && <p class="seq-clock" data-clock aria-hidden="true"></p>}
      <div class="seq-stage" data-stage set:html={svg} />
      <p class="seq-now" data-now aria-live="polite"></p>
      <p class="seq-summary" id={summaryId} data-summary>{s.summary}</p>
    </div>
    {!still && <div class="seq-controls" data-controls>
      {def.params.length > 0 && (
        <div class="seq-params">
          {def.params.map(p => (
            <div class="seq-param" role="group" aria-label={p.label}>
              <span class="seq-param-label" aria-hidden="true">{p.label}</span>
              <span class="seq-segmented">{p.options.map(o => <button type="button" data-param={p.id} data-value={o.value} aria-pressed={String(o.value === p.default)}>{o.label}</button>)}</span>
            </div>
          ))}
        </div>
      )}
      <div class="seq-transport" role="group" aria-label={`Playback for figure ${n}`}>
        <button type="button" class="seq-play" data-act="play"><svg viewBox="0 0 16 16" aria-hidden="true"><path class="seq-fill" data-icon d="M4.5 2.5v11l9-5.5z" /></svg><span data-play-text>Play</span></button>
        <button type="button" data-act="back"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg><span class="seq-btn-label">Back</span></button>
        <button type="button" data-act="next"><span class="seq-btn-label">Next</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
        <span class="seq-scrub">
          <input type="range" data-scrub min="0" max={s.duration} step="0.01" value={s.duration} aria-label="Step" />
          <span class="seq-ticks" data-ticks aria-hidden="true">{ticks.map(t => <span style={`left:${(t / s.duration) * 100}%`} />)}</span>
        </span>
        <button type="button" data-act="reset"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.4-3.3" /><path d="M2.5 2.5v3h3" /></svg><span class="seq-btn-label">Reset</span></button>
        <span class="seq-count" data-count aria-hidden="true"></span>
      </div>
    </div>}
    <details class="seq-transcript">
      <summary>Messages in order, as text</summary>
      <ol data-transcript>{ev.map(e => <li>{e.text}</li>)}</ol>
    </details>
    {source && (
      <details class="seq-transcript seq-source">
        <summary>{sourceLabel}</summary>
        <Code code={source} lang="mermaid" themes={{ light: 'github-light', dark: 'github-dark' }} />
      </details>
    )}
  </figure>
</seq-player>

<script>
  import { scenarios, defaults, layout, renderSVG, updateSVG, events, stops, stopOf, clockAt, formatMs } from './sequence-model';
  import './async-scenarios';
  import './design-scenarios';
  import type { Scenario, Layout, Event, Item, Msg, Note } from './sequence-model';

  // How long a line of narration stays up during playback: about 230 words a minute.
  const holdFor = (text: string) => 900 + text.length * 45;
  // Items that sit on a row, and a key that finds the same item in a rebuilt scenario.
  const rowed = (it: Item): it is Msg | Note => it.type === 'msg' || it.type === 'note';
  const keyOf = (it: Msg | Note) => it.type === 'msg' ? `${it.from}>${it.to}:${it.label}` : `note:${it.over.join(',')}`;
  const MORPH_MS = 900;

  class SeqPlayer extends HTMLElement {
    connectedCallback() {
      const def = scenarios[this.dataset.scenario!];
      const uid = this.dataset.uid!;
      const aria = { labelledby: `${uid}-title`, describedby: `${uid}-summary` };
      // A still figure only needs laying out again when its width changes.
      if (this.dataset.still !== undefined) {
        const stage = this.querySelector('[data-stage]') as HTMLElement;
        const s = def.build(defaults(def));
        let width = 0;
        const render = () => { width = stage.clientWidth; stage.innerHTML = renderSVG(s, layout(s, width), s.duration, uid, aria); };
        render();
        this.dataset.ready = '';
        new ResizeObserver(() => { if (Math.abs(stage.clientWidth - width) > 4) render(); }).observe(stage);
        return;
      }
      const q = <T extends Element>(sel: string) => this.querySelector(sel) as T;
      const stage = q<HTMLElement>('[data-stage]');
      const scrub = q<HTMLInputElement>('[data-scrub]');
      const ticks = q<HTMLElement>('[data-ticks]');
      const now = q<HTMLElement>('[data-now]');
      const count = q<HTMLElement>('[data-count]');
      const clock = this.querySelector<HTMLElement>('[data-clock]');
      const playIcon = q<SVGPathElement>('[data-icon]');
      const playText = q<HTMLElement>('[data-play-text]');
      const transcript = q<HTMLOListElement>('[data-transcript]');
      const summary = q<HTMLElement>('[data-summary]');
      const paramButtons = [...this.querySelectorAll<HTMLButtonElement>('button[data-param]')];
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

      let params = defaults(def);
      let s: Scenario, L: Layout, ev: Event[], st: number[];
      let svg: SVGSVGElement | null = null;
      let T = 0, width = 0, raf = 0, timer = 0, lastFrame = 0;
      let playing = false, target: number | null = null, touched = false, resumeOnReturn = false;
      let shown = '', shownAt = 0, holdUntil = 0;
      let morphEnd: (() => void) | null = null;
      // `stepT[k]` is when step k is shown. Events are already in that order, and the last step is the
      // finished drawing, so every step, including the last, looks different from the one before.
      let stepT: number[] = [];
      let firstT0 = 0;

      const build = () => {
        s = def.build(params);
        ev = events(s);
        st = stops(s);
        stepT = [];
        ev.forEach((e, i) => stepT.push(Math.max(i ? stepT[i - 1] : 0, stopOf(e))));
        if (stepT.length) stepT[stepT.length - 1] = Math.max(stepT[stepT.length - 1], s.duration);
        firstT0 = Math.min(...ev.map(e => e.t0));
        scrub.max = String(s.duration);
        ticks.innerHTML = st.map(t => `<span style="left:${(t / s.duration) * 100}%"></span>`).join('');
        transcript.replaceChildren(...ev.map(e => { const li = document.createElement('li'); li.textContent = e.text; return li; }));
        summary.textContent = s.summary;
      };
      const render = () => {
        width = stage.clientWidth;
        L = layout(s, width);
        stage.innerHTML = renderSVG(s, L, T, uid, aria);
        svg = stage.querySelector('svg');
      };
      // The step being shown or played towards: none before anything starts, then the first step not yet passed.
      const stepAt = () => {
        if (!ev.length || T + 1e-6 < firstT0) return -1;
        const k = stepT.findIndex(t => t >= T - 1e-6);
        return k < 0 ? ev.length - 1 : k;
      };
      const setPlayLabel = () => {
        const atEnd = T >= s.duration - 1e-3;
        playText.textContent = playing ? 'Pause' : atEnd ? 'Replay' : 'Play';
        playIcon.setAttribute('d', playing ? 'M4.5 3h2.5v10H4.5zM9 3h2.5v10H9z' : atEnd ? 'M8 2.5a5.5 5.5 0 1 1-5.2 3.7l1.9.6A3.5 3.5 0 1 0 8 4.5v2L4.8 3.5 8 .5z' : 'M4.5 2.5v11l9-5.5z');
      };
      const draw = () => {
        if (!svg) return;
        updateSVG(svg, s, L, T);
        scrub.value = String(T);
        if (clock && s.clock) clock.textContent = `Clock ${formatMs(clockAt(s, T))}`;
        const k = stepAt();
        // While playing through a wait, keep naming the last step until the next one starts.
        const said = playing && k > 0 && T + 1e-6 < ev[k].t0 ? k - 1 : k;
        const text = k < 0 ? 'Press Play, or step through with Next.' : playing ? ev[said].short : ev[k].text;
        if (text !== shown) { shown = text; shownAt = performance.now(); now.textContent = text; }
        count.textContent = `${k + 1} / ${ev.length}`;
        scrub.setAttribute('aria-valuetext', k < 0 ? 'Start' : `Step ${k + 1} of ${ev.length}`);
        setPlayLabel();
      };
      // Finish a row morph at once, so nothing is left halfway between two drawings.
      const finishMorph = () => { const end = morphEnd; morphEnd = null; end?.(); };
      // Show the whole new drawing, sliding each item that changed row from where it was in `from`.
      const morph = (from: Scenario) => {
        const was = new Map<string, number>();
        for (const it of from.items) if (rowed(it)) was.set(keyOf(it), it.row);
        const moves = s.items.filter(rowed).flatMap(it => {
          const a = was.get(keyOf(it));
          return a !== undefined && a !== it.row ? [{ it, a, b: it.row }] : [];
        });
        T = s.duration;
        const note = def.morphNote?.(params);
        const done = () => {
          moves.forEach(m => { m.it.row = m.b; });
          render(); draw();
          if (note) { now.textContent = note; shown = note; }
        };
        if (motion.matches || !moves.length) { done(); return; }
        const start = performance.now();
        const step = (time: number) => {
          const p = Math.min(1, (time - start) / MORPH_MS);
          if (p >= 1) { morphEnd = null; done(); return; }
          const e = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
          moves.forEach(m => { m.it.row = m.a + (m.b - m.a) * e; });
          render(); draw();
          raf = requestAnimationFrame(step);
        };
        morphEnd = () => { cancelAnimationFrame(raf); done(); };
        moves.forEach(m => { m.it.row = m.a; });
        render(); draw();
        raf = requestAnimationFrame(step);
      };
      const stop = () => {
        finishMorph();
        playing = false; target = null;
        cancelAnimationFrame(raf); clearTimeout(timer);
        now.setAttribute('aria-live', 'polite');
        draw();
      };
      // Continuous playback, holding at the end of each step until its narration has been readable.
      const tick = (time: number) => {
        const dt = Math.min(0.1, (time - lastFrame) / 1000);
        lastFrame = time;
        if (time < holdUntil) { raf = requestAnimationFrame(tick); return; }
        const end = target ?? s.duration;
        const next = st.find(t => t > T + 1e-6 && t < end - 1e-6);
        let nextT = Math.min(end, T + dt);
        if (next !== undefined && nextT >= next && target === null) {
          nextT = next;
          T = nextT;
          draw();
          const k = stepAt();
          const need = k >= 0 && !ev[k].repeat ? holdFor(ev[k].short) : 0;
          holdUntil = shownAt + need;
          raf = requestAnimationFrame(tick);
          return;
        }
        T = nextT;
        draw();
        if (T >= end - 1e-6) { stop(); return; }
        raf = requestAnimationFrame(tick);
      };
      // The step on show: -1 at the start, k when paused on step k, null when paused between steps.
      const shownStep = () => {
        if (T < 1e-3) return -1;
        if (stepT.length && T >= stepT[stepT.length - 1] - 1e-3) return stepT.length - 1;
        const k = stepT.findIndex(t => Math.abs(t - T) < 1e-3);
        return k < 0 ? null : k;
      };
      const nextStep = () => {
        const k = shownStep();
        return k !== null ? k + 1 : stepT.findIndex(t => t > T);
      };
      const prevStep = () => {
        const k = shownStep();
        if (k !== null) return k - 1;
        let j = -1;
        stepT.forEach((t, i) => { if (t < T) j = i; });
        return j;
      };
      // Show step k, or the start for k < 0. Past the last step there is nothing more to show.
      const goStep = (k: number, animate: boolean) => {
        if (k >= ev.length) { stop(); return; }
        if (k < 0) { stop(); T = 0; draw(); return; }
        if (animate && stepT[k] > T + 1e-3) { play(stepT[k]); return; }
        stop(); T = stepT[k]; draw();
      };
      const play = (until: number | null = null) => {
        finishMorph();
        cancelAnimationFrame(raf); clearTimeout(timer);
        if (T >= s.duration - 1e-3) T = 0;
        playing = until === null;
        target = until;
        holdUntil = 0;
        now.setAttribute('aria-live', playing ? 'off' : 'polite');
        if (motion.matches) {
          // Reduced motion: jump from event to event instead of animating.
          const jump = () => {
            if (until !== null) { T = until; draw(); stop(); return; }
            const k = nextStep();
            if (k >= ev.length) { T = s.duration; draw(); stop(); return; }
            T = stepT[k];
            draw();
            timer = window.setTimeout(jump, holdFor(ev[k].short));
          };
          jump();
          return;
        }
        lastFrame = performance.now();
        draw();
        raf = requestAnimationFrame(tick);
      };
      const selectParams = () => paramButtons.forEach(b => b.setAttribute('aria-pressed', String(params[b.dataset.param!] === b.dataset.value)));

      this.addEventListener('click', e => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('button');
        if (!btn) return;
        touched = true;
        resumeOnReturn = false;
        if (btn.dataset.param) {
          if (params[btn.dataset.param] === btn.dataset.value) return;
          stop();
          const before = s;
          params = { ...params, [btn.dataset.param]: btn.dataset.value! };
          selectParams();
          build();
          if (def.morph) { morph(before); return; }
          T = motion.matches ? s.duration : 0;
          render(); draw();
          if (!motion.matches) play();
          return;
        }
        const act = btn.dataset.act;
        if (act === 'play') { if (playing) stop(); else play(); }
        if (act === 'next') {
          // A Next pressed while an earlier Next is still animating finishes that step first,
          // so every press moves one step on.
          const pending = !playing && target !== null ? target : null;
          if (pending !== null) { stop(); T = pending; }
          goStep(nextStep(), true);
        }
        if (act === 'back') goStep(prevStep(), false);
        if (act === 'reset') {
          stop();
          params = defaults(def);
          selectParams();
          build(); T = 0; render(); draw();
        }
      });
      scrub.addEventListener('input', () => {
        const v = Number(scrub.value);
        touched = true; resumeOnReturn = false; stop();
        T = v > s.duration - 0.02 ? s.duration : v;
        draw();
      });
      scrub.addEventListener('keydown', e => {
        if (!['ArrowRight', 'ArrowUp', 'ArrowLeft', 'ArrowDown'].includes(e.key)) return;
        e.preventDefault(); touched = true;
        goStep(e.key === 'ArrowRight' || e.key === 'ArrowUp' ? nextStep() : prevStep(), false);
      });

      build();
      T = motion.matches ? s.duration : 0;
      render(); draw();
      this.dataset.ready = '';

      new ResizeObserver(() => {
        if (Math.abs(stage.clientWidth - width) > 4) { render(); draw(); }
      }).observe(stage);

      // Play once when half the figure is in view; pause while it is out of view.
      new IntersectionObserver(entries => {
        for (const en of entries) {
          if (en.intersectionRatio >= 0.5) {
            if (!touched && !motion.matches) { touched = true; play(); }
            else if (resumeOnReturn) { resumeOnReturn = false; play(); }
          } else if (!en.isIntersecting && playing) {
            stop();
            resumeOnReturn = true;
          }
        }
      }, { threshold: [0, 0.5] }).observe(stage);
    }
  }
  if (!customElements.get('seq-player')) customElements.define('seq-player', SeqPlayer);
</script>
