---
import { records, featuredRecord } from '../../lib/explainers/models.mjs';
const dictionary = ['Sweden', 'UK', 'Germany'];
const encoded = records.map(record => ({ ...record, code: dictionary.indexOf(record.country) }));
---
<figure class="dictionary-diagram paper-surface wide" aria-labelledby="dictionary-title">
  <div class="dictionary-heading">
    <span class="plate-number">Illustration · Dictionary encoding</span>
    <h3 id="dictionary-title">Store each country name once</h3>
    <p>The country field from the same 16 page views, in the same order.</p>
  </div>
  <div class="dictionary-layout">
    <div class="encoding-columns">
      <div class="encoding-column-head"><strong>Before</strong><span>Country names</span></div>
      <div aria-hidden="true"></div>
      <div class="encoding-column-head"><strong>After</strong><span>Codes</span></div>
      {encoded.map(record => <>
        <div class:list={['country-slip', { 'traced-value': record.id === featuredRecord }]}>
          <span class="record-position" aria-label={`Record ${record.id + 1}`}>{String(record.id + 1).padStart(2, '0')}</span>
          <span>{record.country}</span>
          {record.id === featuredRecord && <span class="trace-marker" aria-label="Blue-mug visit">●</span>}
        </div>
        <div class:list={['encoding-link', { 'traced-link': record.id === featuredRecord }]} aria-hidden="true">{record.id === featuredRecord ? '→' : ''}</div>
        <div class:list={['code-slip', { 'traced-value': record.id === featuredRecord }]} aria-label={`Record ${record.id + 1}, code ${record.code}`}>{record.code}</div>
      </>)}
      <p class="encoding-column-foot">16 country names</p>
      <div aria-hidden="true"></div>
      <p class="encoding-column-foot">16 codes</p>
    </div>
    <div class="dictionary-aside">
      <div class="dictionary-card">
        <h4>Shared dictionary</h4>
        <p>Keep this alongside the codes.</p>
        <dl>{dictionary.map((country, code) => <div class:list={{ 'dictionary-match': country === records[featuredRecord].country }}>
          <dt><span class="dictionary-token">{code}</span></dt><span aria-hidden="true">→</span><dd>{country}</dd>
        </div>)}</dl>
        <p class="dictionary-card-foot">3 names, stored once each</p>
      </div>
      <div class="dictionary-trace">
        <h4><span aria-hidden="true">●</span> Follow the blue-mug visit</h4>
        <p>Record 02 came from Sweden. Its position stays the same; its country is now stored as code <strong>0</strong>.</p>
        <div class="decode-path" aria-label="Read code 0, look it up in the dictionary, recover Sweden"><span class="dictionary-token">0</span><span class="decode-arrow">look up<br /><span aria-hidden="true">→</span></span><strong>Sweden</strong></div>
        <p>The dictionary turns that code back into the original name.</p>
      </div>
    </div>
  </div>
  <figcaption>Every record still has a country. The encoded column holds a short code for each record, plus a dictionary of the three names. Box widths are schematic, not measured byte sizes.</figcaption>
</figure>

<style>
  .dictionary-diagram { width: min(840px, calc(100vw - 2rem)); margin-top: 2rem; margin-bottom: 2rem; padding: 1.6rem 2rem; border: 1px solid var(--color-rule-strong); border-radius: 0; background: var(--paper-background); color: var(--color-text); box-shadow: none; font: .85rem/1.55 var(--font-sans); }
  .dictionary-heading { margin-bottom: 1.4rem; }
  .dictionary-heading .plate-number { color: var(--color-text-secondary); }
  .dictionary-heading h3 { margin: .35rem 0; font: 500 1.7rem/1.2 var(--font-serif); }
  .dictionary-heading p { margin: .5rem 0 0; color: var(--color-text-secondary); }
  .dictionary-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2.8rem; align-items: start; }
  .encoding-columns { display: grid; grid-template-columns: minmax(0, 1fr) 2rem 3.7rem; gap: .22rem 0; }
  .encoding-column-head { padding-bottom: .5rem; }
  .encoding-column-head strong, .encoding-column-head span { display: block; }
  .encoding-column-head span { color: var(--color-text-secondary); font-size: .76rem; }
  .country-slip, .code-slip { height: 1.7rem; display: flex; align-items: center; background: transparent; border: 0; border-bottom: 1px solid var(--color-rule-strong); border-radius: 0; }
  .country-slip { padding: 0 .5rem; gap: .65rem; }
  .record-position { color: var(--color-text-secondary); font: .65rem var(--font-mono); }
  .code-slip { justify-content: center; font: .85rem var(--font-mono); }
  .traced-value { background: var(--paper-highlight); border-bottom: 1px solid var(--color-rule-strong); box-shadow: inset 3px 0 var(--gold); font-weight: 600; color: var(--color-text); }
  .trace-marker { margin-left: auto; font-size: .6rem; }
  .encoding-link { display: grid; place-items: center; }
  .traced-link { color: var(--teal); font-size: 1.3rem; }
  .encoding-column-foot { margin: .65rem 0 0; font-size: .72rem; color: var(--color-text-secondary); }
  .dictionary-card { margin-top: 3.2rem; padding: 1.1rem; background: var(--color-surface); border: 1px solid var(--color-rule-strong); border-radius: 0; box-shadow: none; }
  .dictionary-card h4, .dictionary-trace h4 { margin: 0; font: 600 .9rem/1.4 var(--font-sans); }
  .dictionary-card p { margin: .35rem 0 .8rem; font-size: .76rem; color: var(--color-text-secondary); }
  .dictionary-card dl { margin: 0; }
  .dictionary-card dl > div { display: grid; grid-template-columns: 2rem 1.2rem 1fr; align-items: center; gap: .5rem; padding: .45rem .3rem; border-bottom: 1px solid var(--color-rule); }
  .dictionary-card dd { margin: 0; }
  .dictionary-card dl > .dictionary-match { background: var(--paper-highlight); box-shadow: inset 3px 0 var(--gold); color: var(--color-text); }
  .dictionary-token { display: inline-grid; place-items: center; width: 1.8rem; height: 1.8rem; background: transparent; border: 0; border-bottom: 1px solid var(--color-rule-strong); border-radius: 0; font: .85rem var(--font-mono); color: var(--teal); }
  .dictionary-card .dictionary-card-foot { margin: .8rem 0 0; }
  .dictionary-trace { margin-top: 1.9rem; }
  .dictionary-trace h4 { color: var(--teal); }
  .dictionary-trace p { margin: .7rem 0; }
  .decode-path { display: flex; align-items: center; gap: .8rem; margin: 1rem 0; }
  .decode-arrow { font-size: .68rem; color: var(--color-text-secondary); text-align: center; line-height: 1.1; }
  .decode-arrow > span { font-size: 1.5rem; color: var(--teal); }
  .dictionary-diagram figcaption { border-top: 1px solid var(--color-rule-strong); margin-top: 1.5rem; padding-top: 1rem; font: .78rem/1.6 var(--font-sans); color: var(--color-text-secondary); }
  @media (max-width: 640px) {
    .dictionary-diagram { padding: 1.1rem; }
    .dictionary-layout { grid-template-columns: minmax(0, 1fr); gap: 1.3rem; }
    .encoding-columns { grid-template-columns: minmax(0, 1fr) 2.2rem 4rem; }
    .dictionary-card { margin-top: 0; }
    .dictionary-trace { margin-top: 1.5rem; }
  }
</style>
