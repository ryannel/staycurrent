---
import { definitions, defaults, view } from './views.mjs';
import './tools.css';
const { kind, number = 1 } = Astro.props;
const def = definitions[kind];
const id = `rdt-${kind.toLowerCase()}-${number}`;
---
<figure class="rdt" aria-labelledby={`${id}-title`}>
  <header><span class="rdt-number">Figure {number}</span><p class="rdt-title" id={`${id}-title`}>{def.title}</p></header>
  <p>{def.intro}</p>
  <relational-design-tool data-kind={kind}>
    <fieldset class="rdt-controls" disabled data-rdt-controls>
      <legend>Change the example</legend>
      {def.controls.map(control => <label for={`${id}-${control.key}`}>
        <span>{control.label}</span>
        {control.options ? <select id={`${id}-${control.key}`} data-key={control.key}>
          {control.options.map(([value,label])=><option value={value} selected={value===control.value}>{label}</option>)}
        </select> : <><input id={`${id}-${control.key}`} data-key={control.key} type="range" min={control.min} max={control.max} step="1" value={control.value}/><output for={`${id}-${control.key}`} data-value={control.key}>{control.value}</output></>}
      </label>)}
      <button type="button" data-rdt-reset>Reset example</button>
    </fieldset>
    <div class="rdt-view" data-rdt-view set:html={view(kind, defaults(kind))}></div>
    <p class="rdt-status" aria-live="polite" role="status" data-rdt-status></p>
  </relational-design-tool>
  <details class="rdt-scope"><summary>What this model represents</summary><p>{def.scope}</p></details>
  <noscript><p>{def.fallback}</p></noscript>
  <figcaption>Figure {number}. {def.caption}</figcaption>
</figure>
<script>
  import { defaults, view } from './views.mjs';
  class RelationalDesignTool extends HTMLElement {
    connectedCallback() {
      if(this.dataset.ready) return;
      this.dataset.ready='true';
      const kind=this.dataset.kind!;
      const controls=[...this.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[data-key]')];
      const draw=()=>{
        const state=Object.fromEntries(controls.map(control=>[control.dataset.key!,control.value]));
        const continuation=controls.find(control=>control.dataset.key==='method');
        if(continuation) continuation.disabled=state.capture==='ids'||state.capture==='values';
        this.querySelector('[data-rdt-view]')!.innerHTML=view(kind,state);
        this.querySelectorAll<HTMLOutputElement>('[data-value]').forEach(output=>output.value=state[output.dataset.value!]);
        this.querySelector('[data-rdt-status]')!.textContent=`Example updated. ${controls.map(control=>`${control.labels?.[0]?.querySelector('span')?.textContent}: ${control.disabled?'saved capture sequence':control instanceof HTMLSelectElement ? control.selectedOptions[0].text : control.value}`).join('; ')}.`;
      };
      controls.forEach(control=>control.addEventListener('input',draw));
      this.querySelector('[data-rdt-reset]')!.addEventListener('click',()=>{
        const initial=defaults(kind);
        controls.forEach(control=>control.value=initial[control.dataset.key!]);draw();
      });
      this.querySelector<HTMLFieldSetElement>('[data-rdt-controls]')!.disabled=false;
    }
  }
  if(!customElements.get('relational-design-tool'))customElements.define('relational-design-tool',RelationalDesignTool);
</script>
