---
import { Image, getImage } from 'astro:assets';
import recordsLight from '../../assets/explainers/sketch-records-light.png';
import recordsDark from '../../assets/explainers/sketch-records-dark.png';
import keysLight from '../../assets/explainers/sketch-keys-light.png';
import keysDark from '../../assets/explainers/sketch-keys-dark.png';
import columnsLight from '../../assets/explainers/sketch-columns-light.png';
import columnsDark from '../../assets/explainers/sketch-columns-dark.png';
interface Props { kind: 'records' | 'keys' | 'columns' }
const { kind } = Astro.props;
const plates = {
 records: {
  light: recordsLight, dark: recordsDark,
  title: 'A product with its details inside',
  alt: 'One product document encloses two mug sizes and a blue colour swatch.',
  caption: 'The blue mug is one document containing a name, two sizes, and a colour. The enclosing shape shows which details belong to that record. Relational databases can store nested JSON too; this is a representation, not an exclusive capability.',
 },
 keys: {
  light: keysLight, dark: keysDark,
  title: 'A known key takes you to its data',
  alt: 'A session ID points to one saved session. Below it, the middle two readings in an ordered device record are marked as a time range.',
  caption: 'A session key retrieves one saved value. A device key can instead locate a group whose readings are ordered by time. Range reads within that group require an ordered-key design; a basic key-value store does not necessarily provide them.',
 },
 columns: {
  light: columnsLight, dark: columnsDark,
  title: 'Read the fields the report needs',
  alt: 'Three separate strips store country, total, and delivery notes. Only country and total feed the report below; delivery is left unread.',
  caption: 'Entries at the same height in the three strips belong to the same order. The report reads country and total, leaving delivery notes unread. It still includes every order: Sweden totals 40 and the UK totals 15. The drawing shows logical column layout, not measured disk pages.',
 },
};
const plate = plates[kind];
const dark = await getImage({src:plate.dark,width:1200,format:'webp'});
---
<figure class="paper-surface sketch-data-plate" id={`plate-${kind}`} aria-labelledby={`sketch-${kind}`}>
 <span class="plate-number">Illustration</span>
 <h3 id={`sketch-${kind}`}>{plate.title}</h3>
 <div class:list={['artwork',kind]}>
  <picture><source media="(prefers-color-scheme: dark)" srcset={dark.src}/><Image src={plate.light} alt={plate.alt} widths={[600,1000,1440]} sizes="(max-width: 700px) 100vw, 640px" format="webp" loading="lazy"/></picture>
  {kind === 'records' && <>
   <span class="label product">Blue mug</span><span class="label product-id accent">P7</span>
   <span class="label sizes">Sizes</span><span class="label size-small">250 ml</span><span class="label size-large">350 ml</span>
   <span class="label colour">Colour</span><span class="label blue">Blue</span>
  </>}
  {kind === 'keys' && <>
   <span class="label session-id">Session ID</span><span class="label session-key">s42</span>
   <span class="label session-title">Saved session</span><span class="label session-value">Ada · 2 blue mugs</span>
   <span class="label ordered">Ordered keys: device + time</span>
   <span class="label device">Device D8</span><span class="label range">09:01–09:02</span>
   <span class="label read-range">Read this<br/>time range</span>
   {['D8 · 09:00   18 °C','D8 · 09:01   19 °C','D8 · 09:02   18 °C','D8 · 09:03   20 °C'].map((value,i)=><span class:list={['label reading',{'muted':i===0||i===3}]} style={`top:${59+i*8}%`}>{value}</span>)}
  </>}
  {kind === 'columns' && <>
   <span class="label stored">Stored together by field</span>
   <span class="label country-heading">Country</span><span class="label total-heading">Total</span><span class="label delivery-heading">Delivery</span>
   {['Sweden','UK','Sweden'].map((value,i)=><span class="label country-value" style={`top:${22.6+i*15.4}%`}>{value}</span>)}
   {['20','15','20'].map((value,i)=><span class="label total-value" style={`top:${22.6+i*15.4}%`}>{value}</span>)}
   <span class="label unread muted">Not read</span><span class="label report">Sweden: 40 · UK: 15</span>
  </>}
 </div>
 <figcaption>{plate.caption}</figcaption>
</figure>
<style>
 .sketch-data-plate{padding:1.2rem;margin:2rem 0;font:.8rem/1.6 var(--font-sans);scroll-margin-top:1rem}
 h3{font:500 1.35rem/1.3 var(--font-serif);margin:0 0 1rem;scroll-margin-top:4rem}
 .artwork{position:relative;container-type:inline-size;max-width:640px;margin:0 auto}
 picture,img{display:block;width:100%;height:auto}
 .label{position:absolute;transform:translate(-50%,-50%);font:500 clamp(11px,3.2cqw,20px)/1.25 var(--font-serif);color:#403e38;white-space:nowrap}
 .accent{color:#286c64}.muted{color:#777269}
 .product{left:59%;top:20%}.product-id{left:49%;top:29%}.sizes{left:30%;top:45%}.size-small{left:38%;top:70.5%}.size-large{left:60%;top:70.5%}.colour{left:33%;top:82.8%}.blue{left:63%;top:82.8%}
 .session-id{left:15.7%;top:10%}.session-key{left:15.7%;top:25.2%}.session-title{left:70%;top:14%}.session-value{left:77%;top:23%;font-size:clamp(10px,2.8cqw,18px)}
 .ordered{left:37%;top:52.5%;font-size:clamp(10px,2.8cqw,18px)}.device{left:19%;top:61%}.range{left:19%;top:67%;font-size:clamp(10px,2.7cqw,17px)}.read-range{left:20%;top:84%;font-size:clamp(10px,2.8cqw,18px)}
 .reading{left:70%;font-size:clamp(10px,2.7cqw,17px);font-variant-numeric:tabular-nums;white-space:pre}
 .stored{left:30%;top:4%;font-size:clamp(10px,2.7cqw,17px)}.country-heading{left:19%;top:11%}.total-heading{left:49%;top:11%}.delivery-heading{left:80%;top:11%}
 .country-value{left:19%}.total-value{left:49%}.unread{left:83%;top:70%;font-size:clamp(10px,2.8cqw,18px)}.report{left:48%;top:82.6%}
 figcaption{border-top:1px solid var(--color-rule-strong);padding-top:1rem;margin-top:1rem;font-size:.75rem;color:var(--color-text-secondary)}
 @media(prefers-color-scheme:dark){.label{color:#e6dfd1}.accent{color:#8ec1b6}.muted{color:#bab3a6}}
 @media(max-width:550px){.sketch-data-plate{padding:1rem}h3{font-size:1.2rem}}
</style>
