---
import { Image, getImage } from 'astro:assets';
import searchLight from '../../assets/explainers/sketch-search-light.png';
import searchDark from '../../assets/explainers/sketch-search-dark.png';
import graphsLight from '../../assets/explainers/sketch-graphs-light.png';
import graphsDark from '../../assets/explainers/sketch-graphs-dark.png';
import cachesLight from '../../assets/explainers/sketch-caches-light.png';
import cachesDark from '../../assets/explainers/sketch-caches-dark.png';

interface Props { kind: 'search' | 'graphs' | 'caches' }
const { kind } = Astro.props;
const plates = {
 search: {
  light: searchLight, dark: searchDark,
  title: 'Two ways to find a match',
  alt: 'A word index links blue to P9, a blue plate, and P7, a blue mug. It links mug to P7 and P8, a red mug. P7 contains both words in the query blue AND mug. Below, a diamond for the query “cup for coffee” has shorter distance guides to two mug points than to a plate point. All three candidate points use the same colour; no result boundary is drawn.',
  caption: 'At the top, a word index points from each word to records containing it: P7 contains both “blue” and “mug”. Below it, nearby points stand for similar numerical representations. That map is illustrative, not a measured embedding; proximity does not guarantee relevance.',
 },
 graphs: {
  light: graphsLight, dark: graphsDark,
  title: 'Who relies on Inventory?',
  alt: 'Four service nodes are connected by three arrows. Checkout points to Orders. Orders and Catalogue each point to Inventory. Every arrow means “depends on”.',
  caption: 'Each arrow means “depends on”. Orders and Catalogue depend directly on Inventory. Checkout depends on Orders, so it also relies on Inventory indirectly. Following incoming edges from Inventory uncovers those dependencies; reversing the question changes the path.',
 },
 caches: {
  light: cachesLight, dark: cachesDark,
  title: 'A saved answer makes a shorter journey',
  alt: 'Hit: the application checks a cache holding an answer for P7, and the cache returns that answer. Miss: step 1, the application queries the database; step 2, the database returns data to the application; step 3, the application saves its built answer in the cache. The application then returns the answer to its caller. There is no direct connection between cache and database.',
  caption: 'The application first checks for a saved answer. A hit returns it from the cache; a miss takes the longer route to the database, then saves a copy for later requests. The shorter path avoids another database read, but the copy needs to be expired or replaced when it becomes stale.',
 },
};
const plate = plates[kind];
const dark = await getImage({ src: plate.dark, width: 1380, format: 'webp' });
---
<figure class="paper-surface system-plate" id={`plate-${kind}`} aria-labelledby={`sketch-${kind}`}>
 <span class="plate-number">Illustration</span>
 <h3 id={`sketch-${kind}`}>{plate.title}</h3>
 <div class="artwork">
  <picture>
   <source media="(prefers-color-scheme: dark)" srcset={dark.src} />
   <Image src={plate.light} alt={plate.alt} widths={[640, 1000, 1380]} sizes="(max-width: 700px) 100vw, 640px" format="webp" loading="lazy" />
  </picture>
 </div>
 {kind !== 'graphs' && <details class="enlarge"><summary>Enlarge illustration</summary>
  <p>Scroll sideways to see the full drawing.</p>
  <div class="large-artwork" tabindex="0" role="region" aria-label={`${plate.title} — enlarged illustration`}>
   <picture><source media="(prefers-color-scheme: dark)" srcset={dark.src}/><Image src={plate.light} alt={plate.alt} width={1000} format="webp" loading="lazy"/></picture>
  </div>
 </details>}
 <figcaption>{plate.caption}</figcaption>
 <details><summary>Text description of the illustration</summary><p>{plate.alt}</p></details>
</figure>
<style>
 .system-plate {margin:2rem 0;padding:1.2rem;scroll-margin-top:1rem;font:.8rem/1.6 var(--font-sans)}
 h3 {font:500 1.35rem/1.3 var(--font-serif);margin:0 0 1rem}
 picture {display:block}
 img {display:block;width:100%;height:auto}
 .artwork {overflow-x:auto}
 .large-artwork:focus-visible {outline:2px solid var(--blue);outline-offset:4px}
 .enlarge{display:none}.large-artwork{overflow-x:auto}.large-artwork picture{min-width:520px}
 figcaption {border-top:1px solid var(--color-rule-strong);padding-top:1rem;margin-top:1rem;color:var(--color-text-secondary);font-size:.75rem}
 details {margin-top:1rem;font-size:.75rem;color:var(--color-text-secondary)}
 summary {cursor:pointer;text-decoration:underline;text-underline-offset:.2em}
 details p {margin:.6rem 0 0}
 @media(max-width:550px){.system-plate{padding:.8rem}.system-plate h3{font-size:1.2rem}}
 @media(max-width:500px){.enlarge{display:block}.enlarge p{margin-bottom:.6rem}}
</style>
