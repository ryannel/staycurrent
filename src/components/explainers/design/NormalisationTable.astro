---
import SketchSheet from './SketchSheet.astro';
interface Props { label: string; columns: string[]; rows: string[][]; keys?: number[]; moved?: number[]; }
const { label, columns, rows, keys = [], moved = [] } = Astro.props;
---
{columns.length > 3 && <p class="table-hint">Scroll across to see every column →</p>}
<SketchSheet tone={moved.length ? 'teal' : 'plain'}>
<div class="table-label" aria-hidden="true">{label}</div>
<div class="normal-table" role="region" tabindex="0" aria-label={label}>
  <table aria-label={label}>
    <thead><tr>{columns.map((column, i) => <th scope="col" class:list={[{key:keys.includes(i), moved:moved.includes(i)}]}>{column}</th>)}</tr></thead>
    <tbody>{rows.map(row => <tr>{row.map((value,i) => <td class:list={[{key:keys.includes(i), moved:moved.includes(i)}]}>{value}</td>)}</tr>)}</tbody>
  </table>
</div>
</SketchSheet>
<style>
  .normal-table { min-width:0; overflow-x:auto; padding-bottom:.4rem; }
  .table-hint { display:none; }
  .normal-table:focus-visible { outline:2px solid var(--teal); outline-offset:4px; }
  table { width:100%; display:table; border-collapse:collapse; font:.78rem/1.5 var(--font-sans); }
  .table-label { text-align:left; font:500 1rem/1.4 var(--font-serif); color:var(--color-text); padding:.2rem 0 .8rem; }
  th,td { padding:.6rem .5rem; border-bottom:1px solid var(--color-rule-strong); text-align:left; white-space:nowrap; }
  th { font:500 .72rem/1.4 var(--font-mono); color:var(--color-text-secondary); }
  .key { font-family:var(--font-mono); }
  th.key { text-decoration:underline; text-underline-offset:.3rem; }
  .moved { background:linear-gradient(177deg,transparent 3%,var(--paper-match) 7%,var(--paper-match) 93%,transparent 98%); }
  @media(max-width:600px) { .table-hint { display:block; font:.7rem/1.5 var(--font-sans); color:var(--color-text-secondary); margin:.6rem 0 .2rem; } }
</style>
