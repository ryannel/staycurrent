---
import './design-aids.css';
---
<rd-design-rules class="lab design-aid design-lab" aria-labelledby="rd-design-rules-title">
  <div class="lab-heading"><span class="eyebrow">Interactive experiment</span></div>
  <h3 id="rd-design-rules-title">Which design accepts this line?</h3>
  <div class="lab-introduction">
    <p>O12 already contains line 1: two P7 mugs at €18 each. Products P7 and P8 exist; P99 does not. Each proposal below starts from that same state.</p>
    <p class="try-this">Choose “Missing quantity”, then remove the required-value rule. The positive check remains. Afterwards, try another P7 line and add the extra uniqueness rule: it rejects a purchase our shop permits.</p>
  </div>
  <div class="lab-controls" data-controls>
    <p class="lab-area-label">Controls</p>
    <label class="proposal-label" for="rd-design-proposal">Proposed new line</label>
    <select id="rd-design-proposal" data-proposal>
      <option value="same">Another P7 line</option>
      <option value="bowl">A P8 bowl line</option>
      <option value="duplicate">Repeat line identity (O12, 1)</option>
      <option value="missing">Missing quantity</option>
      <option value="zero">Quantity zero</option>
      <option value="unknown">Product P99</option>
    </select>
    <fieldset><legend>Rules applied to each proposal</legend>
      <label><input type="checkbox" data-rule="identity" checked /> Unique order and line number</label>
      <label><input type="checkbox" data-rule="required" checked /> Quantity required (NOT NULL)</label>
      <label><input type="checkbox" data-rule="positive" checked /> Quantity greater than zero (CHECK)</label>
      <label><input type="checkbox" data-rule="reference" checked /> Product must exist (foreign key)</label>
      <label><input type="checkbox" data-rule="product" /> Extra rule: product only once per order</label>
    </fieldset>
    <button type="button" data-reset>Restore the intended rules</button>
  </div>
  <div class="lab-output paper-surface">
    <p class="lab-area-label">Result <span>One proposed insert</span></p>
    <div class="design-pair">
      <div class="design-record"><h4>Already stored</h4><dl>
        <div><dt>order_id</dt><dd>O12</dd></div><div><dt>line_no</dt><dd>1</dd></div>
        <div><dt>product_id</dt><dd>P7</dd></div><div><dt>quantity</dt><dd>2</dd></div>
        <div><dt>unit_price</dt><dd>€18.00</dd></div>
      </dl></div>
      <div class="design-record design-current"><h4>Proposed record</h4><dl>
        <div><dt>order_id</dt><dd>O12</dd></div><div><dt>line_no</dt><dd data-line>2</dd></div>
        <div><dt>product_id</dt><dd data-product>P7</dd></div><div><dt>quantity</dt><dd data-quantity>1</dd></div>
        <div><dt>unit_price</dt><dd>€18.00</dd></div>
      </dl></div>
    </div>
    <p data-status class="design-state" role="status" aria-live="polite" aria-atomic="true">Accepted. Line 2 has a new identity. Buying P7 again is allowed.</p>
    <p data-reason class="design-footnote">The proposed line is tested against the stored line, not added to it.</p>
  </div>
  <details class="model-note"><summary>What the experiment represents</summary><p>This is a rule model for these six proposed rows, not a live database. Order O12 exists. All other columns and rules are satisfied. Missing quantity passes the positive CHECK because its comparison is unknown; NOT NULL rejects it. Repeated products are valid in this shop when their line numbers differ. Failed rules are listed together without predicting which error PostgreSQL would report first.</p></details>
  <noscript><p>With the intended rules, another P7 line and a P8 line pass. Repeating line 1, omitting quantity, setting it to zero, or naming P99 fail. The extra product-uniqueness rule would also reject the legitimate second P7 line.</p></noscript>
</rd-design-rules>
<style>
  rd-design-rules { display:block; }
  fieldset { border:0; padding:0; margin:1rem 0; min-width:0; }
  legend { font-weight:600; margin-bottom:.65rem; }
  fieldset label { display:flex; align-items:baseline; gap:.6rem; margin:.6rem 0; }
  input { flex:none; }
  .proposal-label { display:block; margin-bottom:.4rem; }
  select { width:100%; }
  button { white-space:normal; }
  .design-current { padding-left:.65rem; padding-right:.65rem; }
</style>
<script>
  class RDDesignRules extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const proposal = this.querySelector<HTMLSelectElement>('[data-proposal]')!;
      const rules = Array.from(this.querySelectorAll<HTMLInputElement>('[data-rule]'));
      const enabled = (name: string) => rules.some(rule => rule.dataset.rule === name && rule.checked);
      const render = () => {
        const kind = proposal.value;
        const line = kind === 'duplicate' ? 1 : 2;
        const product = kind === 'bowl' ? 'P8' : kind === 'unknown' ? 'P99' : 'P7';
        const quantity = kind === 'missing' ? null : kind === 'zero' ? 0 : 1;
        this.querySelector('[data-line]')!.textContent = String(line);
        this.querySelector('[data-product]')!.textContent = product;
        this.querySelector('[data-quantity]')!.textContent = quantity === null ? 'SQL NULL' : String(quantity);
        const failures: string[] = [];
        if (enabled('identity') && line === 1) failures.push('The identity (O12, 1) already exists.');
        if (enabled('required') && quantity === null) failures.push('NOT NULL requires a quantity.');
        if (enabled('positive') && quantity === 0) failures.push('Zero makes the positive CHECK false.');
        if (enabled('reference') && product === 'P99') failures.push('The product reference has no matching product.');
        if (enabled('product') && product === 'P7') failures.push('The extra product rule forbids a second P7 entry in O12.');
        const status = this.querySelector<HTMLElement>('[data-status]')!;
        status.dataset.outcome = failures.length ? 'rejected' : 'accepted';
        const explanations: Record<string, string> = {
          same: 'Line 2 has a new identity. Buying P7 again is allowed.',
          bowl: 'Line 2 refers to the existing bowl P8.',
          duplicate: 'Without the identity rule, two rows can claim to be line 1 of O12.',
          missing: 'No rule requires quantity. A positive CHECK permits its unknown comparison.',
          zero: 'Without the positive CHECK, zero is a present integer and is accepted.',
          unknown: 'Without the foreign key, P99 can be stored even though that product does not exist.',
        };
        status.textContent = failures.length ? `Rejected. ${failures.join(' ')}` : `Accepted. ${explanations[kind]}`;
        this.querySelector('[data-reason]')!.textContent = enabled('product') && product === 'P7'
          ? 'The extra rule conflicts with this shop’s decision to allow separate lines for the same product.'
          : 'The proposed line is tested against the stored line, not added to it.';
      };
      proposal.addEventListener('change', render);
      rules.forEach(rule => rule.addEventListener('change', render));
      this.querySelector('[data-reset]')!.addEventListener('click', () => {
        rules.forEach(rule => rule.checked = rule.dataset.rule !== 'product');
        render();
      });
      render(); this.dataset.ready = 'true';
    }
  }
  if (!customElements.get('rd-design-rules')) customElements.define('rd-design-rules', RDDesignRules);
</script>
