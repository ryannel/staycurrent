---
import './design-aids.css';
---
<design-fact-change id="fact-change-lab" class="lab design-aid design-lab" aria-labelledby="fact-change-title">
  <div class="lab-heading"><span class="eyebrow">Interactive experiment</span></div>
  <h3 id="fact-change-title">Which facts should change together?</h3>
  <div class="lab-introduction">
    <p>C4 has orders O12 and O13. Their customer display should use C4’s <strong>current name</strong>, initially Ada. O12 also records two P7 mugs purchased at <strong>EUR 18 each</strong>. The catalogue starts at EUR 18.</p>
    <p class="try-this">Correct Ada’s name to Ada Noor. Compare updating copies on orders with updating one customer record. Then change the catalogue price to EUR 20 and inspect O12’s purchase price.</p>
  </div>
  <div class="lab-controls" data-controls>
    <p class="lab-area-label">Controls <span>Changing the layout resets the example</span></p>
    <div class="control-line"><label for="fact-change-layout">Current customer name</label><select id="fact-change-layout" data-layout><option value="copies">Copied onto each order</option><option value="reference">Stored in customers</option></select></div>
    <div class="control-line"><button data-correct>Correct customer name</button><button data-next disabled>Update next order copy</button></div>
    <div class="control-line"><button data-price>Change catalogue price</button><button data-reset>Reset</button></div>
  </div>
  <div class="lab-output paper-surface">
    <p class="lab-area-label">Result <span>Stored facts and the answers read from them</span></p>
    <div data-view>
      <h4>Names copied onto orders</h4>
      <table><caption class="visually-hidden">Initial copied customer names</caption><thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Stored current name</th></tr></thead><tbody><tr><th scope="row">O12</th><td>C4</td><td>Ada</td></tr><tr><th scope="row">O13</th><td>C4</td><td>Ada</td></tr></tbody></table>
      <div class="design-pair"><div class="design-record"><h4>Product P7 · current catalogue</h4><p>EUR 18 each</p></div><div class="design-record"><h4>O12, line 1 · agreed at purchase</h4><p>2 × EUR 18 = EUR 36</p></div></div>
    </div>
    <p class="design-state" data-message role="status" aria-live="polite" aria-atomic="true">Both orders show Ada. O12’s purchase total is EUR 36.</p>
  </div>
  <details class="model-note"><summary>What this model assumes</summary><p>The copied names mean the customer’s current name, so a correction needs to reach every copy. An intentionally preserved name on an invoice would be a different fact. Each button performs one row update; this model deliberately shows copying in separate steps, with no transaction or automatic propagation. Purchase prices are stored on order lines in both layouts. This shop uses EUR throughout.</p></details>
  <noscript><p>With copied current names, correcting just O12 leaves O13 saying Ada. With a customer record, one correction makes both orders resolve Ada Noor. Changing P7’s catalogue price to EUR 20 leaves O12’s stored EUR 18 unit price and EUR 36 total intact.</p></noscript>
</design-fact-change>
<script>
  class DesignFactChange extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const layout = this.querySelector<HTMLSelectElement>('[data-layout]')!;
      const correct = this.querySelector<HTMLButtonElement>('[data-correct]')!;
      const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
      const priceButton = this.querySelector<HTMLButtonElement>('[data-price]')!;
      let corrected = false;
      let copiesUpdated = 0;
      let cataloguePrice = 18;
      const render = () => {
        const referenced = layout.value === 'reference';
        const name = corrected ? 'Ada Noor' : 'Ada';
        const names = referenced ? [name, name] : [copiesUpdated > 0 ? 'Ada Noor' : 'Ada', copiesUpdated > 1 ? 'Ada Noor' : 'Ada'];
        const writes = referenced ? Number(corrected) : copiesUpdated;
        const table = `<h4>${referenced ? 'Orders resolve the customer name' : 'Names copied onto orders'}</h4><table><caption class="visually-hidden">Customer names for O12 and O13</caption><thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">${referenced ? 'Resolved current name' : 'Stored current name'}</th></tr></thead><tbody>${names.map((value, i) => `<tr><th scope="row">O${12 + i}</th><td>C4</td><td class="${corrected && value === 'Ada' ? 'design-old' : value === 'Ada Noor' ? 'design-current' : ''}">${value}${corrected && value === 'Ada' ? '<br /><small>Outdated copy</small>' : ''}</td></tr>`).join('')}</tbody></table>`;
        this.querySelector('[data-view]')!.innerHTML = `${referenced ? `<div class="design-record"><h4>customers · stored once</h4><dl><div><dt>customer_id</dt><dd>C4</dd></div><div class="${corrected ? 'design-current' : ''}"><dt>name</dt><dd>${name}</dd></div></dl><small>The orders store C4. Their display reads this name.</small></div>` : ''}<div style="margin-top:1rem">${table}</div><p class="design-footnote">Name updates since reset: ${writes}. ${corrected ? 'The correction is Ada Noor.' : 'No correction yet.'}</p><div class="design-pair"><div class="design-record"><h4>Product P7 · current catalogue</h4><dl><div class="${cataloguePrice === 20 ? 'design-current' : ''}"><dt>current_price</dt><dd>EUR ${cataloguePrice}</dd></div></dl><small>Used to offer the next purchase.</small></div><div class="design-record"><h4>O12, line 1 · agreed at purchase</h4><dl><div><dt>unit_price</dt><dd>EUR 18</dd></div><div><dt>quantity</dt><dd>2</dd></div><div><dt>Line total</dt><dd>EUR 36</dd></div></dl><small>Stored purchase fact: it stays EUR 18.</small></div></div>`;
        const stale = names.filter(value => corrected && value === 'Ada').length;
        this.querySelector('[data-message]')!.textContent = `${stale ? `${stale} order ${stale === 1 ? 'copy still says' : 'copies still say'} Ada.` : `Both orders show ${names[0]}.`} ${writes} name ${writes === 1 ? 'update' : 'updates'} completed. Catalogue: EUR ${cataloguePrice}. O12’s purchase total: EUR 36.`;
        correct.disabled = corrected;
        next.disabled = referenced || !corrected || copiesUpdated === 2;
        priceButton.disabled = cataloguePrice === 20;
      };
      const reset = () => { corrected = false; copiesUpdated = 0; cataloguePrice = 18; render(); };
      correct.addEventListener('click', () => { corrected = true; if (layout.value === 'copies') copiesUpdated = 1; render(); });
      next.addEventListener('click', () => { if (copiesUpdated < 2) copiesUpdated++; render(); });
      priceButton.addEventListener('click', () => { cataloguePrice = 20; render(); });
      layout.addEventListener('change', reset);
      this.querySelector('[data-reset]')!.addEventListener('click', reset);
      render();
      this.dataset.ready = 'true';
    }
  }
  if (!customElements.get('design-fact-change')) customElements.define('design-fact-change', DesignFactChange);
</script>
