---
interface Props { direction?: 'right' | 'down'; }
const { direction = 'right' } = Astro.props;
---
<svg class:list={['sketch-arrow',{vertical:direction==='down'}]} viewBox="0 0 100 50" aria-hidden="true">
  <path class="arrow-wash" d="M69 8 L93 24 L69 41 L75 25 Z" />
  <path d="M5 27 Q43 21 91 25 M70 9 L93 25 L69 41" />
  <path class="second-pass" d="M7 29 Q50 24 91 26 M72 11 L91 25 L71 39" />
</svg>
<style>
  .sketch-arrow { display:block; width:100%; height:3rem; color:var(--teal); overflow:visible; }
  path { fill:none; stroke:currentColor; stroke-width:1.1; stroke-linecap:round; stroke-linejoin:round; vector-effect:non-scaling-stroke; }
  .arrow-wash { fill:currentColor; fill-opacity:.18; stroke:none; }
  .second-pass { opacity:.5; stroke-width:.55; }
  .vertical { width:3rem; height:4rem; transform:rotate(90deg); flex-shrink:0; }
</style>
