---
import './design-aids.css';
---
<design-check-constraint id="check-constraint-lab" class="lab design-aid design-lab" aria-labelledby="check-constraint-title">
  <div class="lab-heading"><span class="eyebrow">Interactive experiment</span></div>
  <h3 id="check-constraint-title">Will this quantity be accepted?</h3>
  <div class="lab-introduction">
    <p>Try inserting a quantity into a PostgreSQL integer column with <code>CHECK (quantity &gt; 0)</code>. Every other column and constraint is satisfied.</p>
    <p class="try-this">Choose a positive value, a negative value or SQL NULL. Then add <code>NOT NULL</code> and try the same value. The result separates the comparison from the decision to accept the row.</p>
  </div>
  <div class="lab-controls" data-controls>
    <p class="lab-area-label">Controls</p>
    <div class="control-line"><label for="check-quantity">Quantity</label><select id="check-quantity" data-quantity><option value="2">2</option><option value="0">0</option><option value="-1">−1</option><option value="null">SQL NULL</option></select><label class="check-label"><input type="checkbox" data-required /> Add NOT NULL</label></div>
  </div>
  <div class="lab-output paper-surface">
    <p class="lab-area-label">Result <span>One proposed insert</span></p>
    <div class="design-sql" data-definition><code>quantity integer CHECK (quantity &gt; 0)</code></div>
    <div class="design-expression"><span>Proposed quantity</span><strong data-value>2</strong></div>
    <div class="design-expression"><code>quantity &gt; 0</code><strong data-truth>TRUE</strong></div>
    <div class="design-expression"><span>CHECK decision</span><strong data-check>Pass</strong></div>
    <p class="design-state" data-message role="status" aria-live="polite" aria-atomic="true">Accepted. 2 is greater than zero, so the CHECK is TRUE.</p>
  </div>
  <details class="model-note"><summary>What the result means</summary><p>PostgreSQL accepts a CHECK expression that is TRUE or SQL UNKNOWN; it rejects FALSE. Comparing NULL with zero gives UNKNOWN. NOT NULL rejects a missing quantity independently. This is a small rule model, not a database connection; it shows acceptance for these four inputs with no other constraints or triggers.</p></details>
  <noscript><p>2 passes. 0 and −1 make the CHECK FALSE and fail. SQL NULL makes the CHECK UNKNOWN and passes this CHECK; adding NOT NULL rejects it.</p></noscript>
</design-check-constraint>
<script>
  class DesignCheckConstraint extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const quantity = this.querySelector<HTMLSelectElement>('[data-quantity]')!;
      const required = this.querySelector<HTMLInputElement>('[data-required]')!;
      const render = () => {
        const missing = quantity.value === 'null';
        const truth = missing ? 'UNKNOWN' : Number(quantity.value) > 0 ? 'TRUE' : 'FALSE';
        const accepted = truth !== 'FALSE' && !(missing && required.checked);
        this.querySelector('[data-definition]')!.textContent = `quantity integer${required.checked ? ' NOT NULL' : ''} CHECK (quantity > 0)`;
        this.querySelector('[data-value]')!.textContent = missing ? 'SQL NULL' : quantity.value;
        this.querySelector('[data-truth]')!.textContent = truth;
        this.querySelector('[data-check]')!.textContent = truth === 'FALSE' ? 'Fail' : 'Pass';
        const result = this.querySelector<HTMLElement>('[data-message]')!;
        result.dataset.outcome = accepted ? 'accepted' : 'rejected';
        result.textContent = missing ? required.checked ? 'Rejected by NOT NULL. The CHECK is UNKNOWN and passes, but the column also requires a value.' : 'Accepted. The CHECK is UNKNOWN, which passes a CHECK constraint. No NOT NULL rule requires a value.' : truth === 'TRUE' ? `Accepted. ${quantity.value} is greater than zero, so the CHECK is TRUE.` : `Rejected by CHECK. ${quantity.value} is not greater than zero, so the CHECK is FALSE.`;
      };
      quantity.addEventListener('change', render);
      required.addEventListener('change', render);
      render(); this.dataset.ready = 'true';
    }
  }
  if (!customElements.get('design-check-constraint')) customElements.define('design-check-constraint', DesignCheckConstraint);
</script>
