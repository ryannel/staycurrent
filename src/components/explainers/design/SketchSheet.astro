---
interface Props { class?: string; tone?: 'plain' | 'teal' | 'amber' | 'blue'; }
const { class: className, tone = 'plain' } = Astro.props;
---
<div class:list={['sketch-sheet', `sheet-${tone}`, className]}>
  <svg class="sheet-drawing" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
    <path class="sheet-edge" d="M22 21 L991 23 L989 596 L23 593 Z" />
    <path class="edge-hatching" d="M35 577l19 17m14-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17m15-17 19 17 M971 42l19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17m-19 12 19 17" />
    <path class="sheet-face" d="M9 7 Q230 9 482 6 T976 8 L974 579 Q751 575 489 578 T9 576 Q12 286 9 7 Z" />
    <path class="pencil-pass" d="M8 10 Q243 7 492 9 L977 7 M972 13 Q976 294 972 581 M972 577 Q716 581 483 576 L7 578 M10 574 Q7 289 12 9" />
  </svg>
  <div class="sheet-content"><slot /></div>
</div>
<style>
  .sketch-sheet { position:relative; min-width:0; isolation:isolate; --sheet-fill:var(--paper-panel,#f5f1e7); }
  .sheet-teal { --sheet-fill:color-mix(in srgb,var(--teal) 8%,var(--paper-panel,#f5f1e7)); }
  .sheet-amber { --sheet-fill:color-mix(in srgb,var(--gold) 8%,var(--paper-panel,#f5f1e7)); }
  .sheet-blue { --sheet-fill:color-mix(in srgb,var(--blue) 7%,var(--paper-panel,#f5f1e7)); }
  .sheet-drawing { position:absolute; inset:0; width:100%; height:100%; z-index:-1; overflow:visible; pointer-events:none; }
  .sheet-drawing path { vector-effect:non-scaling-stroke; stroke-linejoin:round; stroke-linecap:round; }
  .sheet-edge { fill:var(--paper-panel,#f5f1e7); stroke:var(--color-text-secondary); stroke-width:.75; }
  .edge-hatching { fill:none; stroke:var(--color-text-secondary); stroke-width:.55; opacity:.55; }
  .sheet-face { fill:var(--sheet-fill); stroke:var(--color-text); stroke-width:1.05; }
  .pencil-pass { fill:none; stroke:var(--color-text-secondary); stroke-width:.55; opacity:.65; }
  .sheet-content { padding:1rem max(1.25rem,4%) 1.25rem max(1rem,2%); margin:2px; }
  @media(prefers-color-scheme:dark) { .sketch-sheet { --paper-panel:#302f28; } }
  @media(max-width:500px) { .sheet-content { padding:.75rem .9rem 1rem .7rem; } }
</style>
