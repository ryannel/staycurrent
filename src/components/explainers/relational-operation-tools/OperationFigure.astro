---
import { scenes, defaults, render } from './scenes.mjs';
import './operation.css';
const { kind, number=1 }=Astro.props;
const scene=scenes[kind];
const initial=render(kind);
const id=`operation-${kind.toLowerCase()}-${number}`;
---
<figure class="op-tool" aria-labelledby={`${id}-title`}>
  <workshop-operation data-kind={kind}>
    <p class="op-eyebrow">Interactive model</p>
    <p class="op-title" id={`${id}-title`}>{scene.title}</p>
    <p class="op-intro">{scene.intro}</p>
    <fieldset class="op-controls"><legend>Controls</legend>
      {scene.controls.map(control=><label for={`${id}-${control.key}`}>{control.label}
        {control.options?<select id={`${id}-${control.key}`} data-input={control.key}>
          {control.options.map(([value,label])=><option value={value} selected={String(value)===String(control.value)}>{label}</option>)}
        </select>:<span class="op-range"><input id={`${id}-${control.key}`} data-input={control.key} type="range" min={control.min} max={control.max} value={control.value} step={control.step}/><output data-value={control.key}>{control.value}</output></span>}
      </label>)}
      <button type="button" data-reset>Reset model</button>
    </fieldset>
    <div class="op-result"><p class="op-eyebrow">Result</p><div data-picture set:html={initial.html}></div><p class="op-status" role="status" aria-live="polite" aria-atomic="true" data-status>{initial.status}</p></div>
    <details class="op-note"><summary>Model rules and limits</summary><p>{scene.note}</p></details>
    <noscript><p>{scene.fallback} Enable JavaScript to vary this model; the initial state above remains readable.</p></noscript>
  </workshop-operation>
  <figcaption>Figure {number}. {scene.fallback}</figcaption>
</figure>
<script>
  import { defaults, render } from './scenes.mjs';
  class WorkshopOperation extends HTMLElement {
    connectedCallback(){
      if(this.dataset.ready)return;
      const name=this.dataset.kind!;
      const inputs=Array.from(this.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[data-input]'));
      const update=()=>{
        const values=Object.fromEntries(inputs.map(input=>[input.dataset.input!,input.value]));
        const state=render(name,values);
        this.querySelector('[data-picture]')!.innerHTML=state.html;
        this.querySelector('[data-status]')!.textContent=state.status;
        for(const input of inputs){const output=this.querySelector<HTMLOutputElement>(`[data-value="${input.dataset.input}"]`);if(output)output.value=input.value;}
      };
      for(const input of inputs)input.addEventListener('input',update);
      this.querySelector('[data-reset]')!.addEventListener('click',()=>{const initial=defaults(name);for(const input of inputs)input.value=String(initial[input.dataset.input!]);update();});
      this.dataset.ready='true';update();
    }
  }
  if(!customElements.get('workshop-operation'))customElements.define('workshop-operation',WorkshopOperation);
</script>
