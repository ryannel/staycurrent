---
import './operation.css';
const {number=3}=Astro.props;
const original=Array.from({length:3},(_,p)=>Array.from({length:6},(_,r)=>p*6+r+1));
const survivors=new Set([1,2,7,8,13,14]);
---
<figure class="op-tool op-static">
  <p class="op-eyebrow">Storage layout</p><p class="op-title">The same six live rows in two file layouts</p>
  {[{title:'Before deletion · three full pages',pages:original,removed:false},{title:'After cleanup · three sparse pages',pages:original,removed:true},{title:'After rewrite · one packed page',pages:[[1,2,7,8,13,14]],removed:false}].map(stage=><section class="op-card"><p class="op-card-title">{stage.title}</p><div class="op-page-row">{stage.pages.map((rows,p)=><div class="op-page"><p>Page {String.fromCharCode(65+p)}</p><div>{rows.map(row=><span class={stage.removed&&!survivors.has(row)?'op-empty-slot':''}>{stage.removed&&!survivors.has(row)?'free':`r${row}`}</span>)}</div></div>)}</div></section>)}
  <figcaption>Figure {number}. Cleanup leaves six live rows and twelve reusable slots inside three pages. A rewrite packs the six survivors into one new page. This invented page holds six equal-size rows; real layouts have headers, alignment and engine-specific reuse rules. Rewriting also needs room for the replacement while the earlier file remains.</figcaption>
</figure>
