---
/* Shared SVG definitions for the storage figures. Include once per page. */
---
<svg class="sf-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <marker id="sf-arrowhead" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 10 5 0 10z" class="sf-arrowhead" />
    </marker>
    <pattern id="sf-new" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="6" height="6" class="sf-new-bg" />
      <line x1="0" y1="0" x2="0" y2="6" class="sf-new-line" />
    </pattern>
  </defs>
</svg>
<style>
  .sf-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .sf-arrowhead { fill: var(--color-text-secondary); }
  .sf-new-bg { fill: var(--coral); }
  .sf-new-line { stroke: rgba(255, 255, 255, .4); stroke-width: 2; }
</style>
