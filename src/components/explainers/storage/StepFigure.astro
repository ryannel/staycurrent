---
/*
 * One animated storage figure. The scene id selects the model in
 * ./model/index.ts. Without JavaScript the figure shows its steps as a list,
 * which also serves as the text alternative for screen readers.
 */
import { scenes } from './model/index';
import { defaults } from './model/types';
import './storage-figures.css';

interface Props {
  scene: string;
  label: string;
  title: string;
  caption: string;
  /** A short description of what the animation shows, read before the step list. */
  alt: string;
  /** Text steps to list instead of the scene's own (for scenes with many steps). */
  outline?: string[];
}
const { scene: sceneId, label, title, caption, alt, outline } = Astro.props;
const scene = scenes[sceneId];
if (!scene) throw new Error(`Unknown storage scene: ${sceneId}`);
const initial = defaults(scene);
const stepTexts = outline ?? scene.steps(initial).map(step => step.text);
const id = `sf-${sceneId}`;
---
<figure class="sf-figure paper-surface" aria-labelledby={`${id}-title`}>
  <storage-figure data-scene={sceneId}>
    <div class="sf-head">
      <span class="plate-number">{label}</span>
      <h3 id={`${id}-title`}>{title}</h3>
    </div>
    {scene.params?.map(param => (
      <div class="sf-params" role="group" aria-label={param.label}>
        <span class="sf-param-label" aria-hidden="true">{param.label}</span>
        <span class="sf-segmented">
          {param.options.map(option => (
            <button type="button" data-param={param.id} data-value={option.value} aria-pressed={String(option.value === param.initial)}>{option.label}</button>
          ))}
        </span>
      </div>
    ))}
    <div class="sf-stage" aria-hidden="true">
      <svg class="sf-svg" xmlns="http://www.w3.org/2000/svg" focusable="false"><g class="sf-layer"></g></svg>
    </div>
    <dl class="sf-stats"></dl>
    <p class="sf-step" aria-live="polite"></p>
    <div class="sf-controls">
      <button type="button" data-act="reset" aria-label="Back to the first step"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.4-3.3" /><path d="M2.5 2.5v3h3" /></svg><span class="sf-btn-label">Reset</span></button>
      <button type="button" data-act="back" aria-label="Previous step"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg><span class="sf-btn-label">Back</span></button>
      <button type="button" data-act="play" class="sf-play" aria-label="Play" data-state="paused"><svg class="sf-icon-play" viewBox="0 0 16 16" aria-hidden="true"><path class="sf-fill" d="M5 3v10l8-5z" /></svg><svg class="sf-icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path class="sf-fill" d="M4.5 3h2.5v10H4.5zM9 3h2.5v10H9z" /></svg><span class="sf-btn-label">Play</span></button>
      <button type="button" data-act="next" aria-label="Next step"><span class="sf-btn-label">Next</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
      <label class="sf-scrub-wrap"><span class="visually-hidden">Step</span><input class="sf-scrub" type="range" min="0" max="0" value="0" step="1" /></label>
      <span class="sf-count" aria-hidden="true"></span>
    </div>
    <div class="sf-alt">
      <p>{alt}</p>
      <ol>{stepTexts.map(text => <li>{text}</li>)}</ol>
    </div>
  </storage-figure>
  <figcaption>{caption}</figcaption>
</figure>
<script>
  import './model/player';
</script>
