---
/*
 * One animated storage figure. The scene id selects the model in
 * ./model/index.ts. Until the script is ready, the board and controls stay
 * hidden and the figure shows its steps as a list. After that the list stays
 * in the page, visually hidden, as the drawing's description.
 */
import { scenes } from './model/index';
import { defaults } from './model/types';
import './storage-figures.css';

interface Props {
  scene: string;
  number: number;
  title: string;
  caption: string;
  /** One or two sentences describing the drawing, read before the step list. */
  alt: string;
}
const { scene: sceneId, number, title, caption, alt } = Astro.props;
const scene = scenes[sceneId];
if (!scene) throw new Error(`Unknown storage scene: ${sceneId}`);
const initial = defaults(scene);
const stepTexts = scene.outline?.(initial) ?? scene.steps(initial).map(step => step.text);
const id = `sf-${sceneId}`;
---
<figure class="sf-figure" aria-labelledby={`${id}-title`}>
  <div class="sf-head"><span class="sf-number">Figure {number}</span><p class="sf-name" id={`${id}-title`}>{title}</p></div>
  <storage-figure data-scene={sceneId}>
    <div class="sf-board paper-surface">
      <dl class="sf-stats"></dl>
      <div class="sf-stage">
        <svg class="sf-svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby={`${id}-title`} aria-describedby={`${id}-alt`}><g class="sf-layer"></g></svg>
      </div>
      <p class="sf-step" aria-live="polite"></p>
    </div>
    <div class="sf-alt" id={`${id}-alt`}>
      <p>{alt}</p>
      <ol>{stepTexts.map(text => <li>{text}</li>)}</ol>
    </div>
    <div class="sf-controls" role="group" aria-label={`Controls for figure ${number}`}>
      {scene.params?.map(param => (
        <div class="sf-params" role="group" aria-label={param.label}>
          <span class="sf-param-label" aria-hidden="true">{param.label}</span>
          <span class="sf-segmented">
            {param.options.map(option => (
              <button type="button" data-param={param.id} data-value={option.value} aria-pressed={String(option.value === param.initial)}>{option.label}</button>
            ))}
          </span>
        </div>
      ))}
      <div class="sf-transport">
        <button type="button" data-act="play" class="sf-play" data-state="paused"><svg class="sf-icon-play" viewBox="0 0 16 16" aria-hidden="true"><path class="sf-fill" d="M5 3v10l8-5z" /></svg><svg class="sf-icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path class="sf-fill" d="M4.5 3h2.5v10H4.5zM9 3h2.5v10H9z" /></svg><span class="sf-btn-label">Play</span></button>
        <button type="button" data-act="back"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg><span class="sf-btn-label">Back</span></button>
        <button type="button" data-act="next"><span class="sf-btn-label">Next</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
        <label class="sf-scrub-wrap"><span class="visually-hidden">Step</span><input class="sf-scrub" type="range" min="0" max="0" value="0" step="1" /></label>
        <button type="button" data-act="reset"><span class="sf-btn-label">Reset</span></button>
        <span class="sf-count" aria-hidden="true"></span>
      </div>
    </div>
  </storage-figure>
  <figcaption>{caption}</figcaption>
</figure>
<script>
  import './model/player';
</script>
