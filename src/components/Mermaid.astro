---
// Renders ```mermaid fences in the browser. The fenced source stays on the page
// until the diagram replaces it, so the page reads without JavaScript.
---
<script>
  const blocks = document.querySelectorAll<HTMLElement>('pre > code.language-mermaid');
  if (blocks.length > 0) {
    const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    import('mermaid').then(({ default: mermaid }) => {
      mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'neutral', fontFamily: 'inherit' });
      blocks.forEach(async (code, i) => {
        const pre = code.parentElement!;
        const source = code.textContent ?? '';
        try {
          const { svg } = await mermaid.render(`mermaid-${i}`, source);
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.innerHTML = svg;
          pre.replaceWith(div);
        } catch {
          // Leave the source readable.
        }
      });
    });
  }
</script>
