---
import RelationalRebuildTree from './RelationalRebuildTree.astro';
import { relationalRebuildHref, relationalRebuildHome, relationalRebuildTree, type RelationalRebuildState } from '../../lib/relational-rebuild';
interface Props { entry: RelationalRebuildState; entries: RelationalRebuildState[]; title: string; compact?: boolean }
const { entry, entries, title, compact = false } = Astro.props;
const Wrapper = compact ? 'details' : 'div';
const root = entries.find(item => item.parent === null)!;
const groups = [...new Set(entries.filter(item => item.parent !== null).map(item => item.group))];
const path = relationalRebuildHref(entry.slug);
const groupTree = (group: string) => {
  const members = entries.filter(item => item.parent !== null && item.group === group);
  const keys = new Set(members.map(item => item.key));
  return members.filter(item => !item.parent || !keys.has(item.parent)).map(item => ({
    entry: item,
    children: relationalRebuildTree(members, item.key),
  }));
};
const count = (group: string) => {
  const items = entries.filter(item => item.parent !== null && item.group === group);
  const available = items.filter(item => item.available).length;
  const planned = items.filter(item => item.status === 'planned').length;
  const missing = items.length - available - planned;
  return [`${available} ${available === 1 ? 'draft' : 'drafts'}`, planned ? `${planned} planned` : '', missing ? `${missing} not yet available` : ''].filter(Boolean).join(' · ');
};
---
<div class:list={['rebuild-navigation', { compact }]} data-pagefind-ignore>
  {compact && <nav class="breadcrumbs" aria-label="Breadcrumb"><ol>
    <li><a href="/">Home</a></li>
    {entry.parent !== null && <li><a href={relationalRebuildHome}>Draft collection</a></li>}
    <li><span aria-current="page">{entry.parent === null ? 'Draft collection' : entry.title}</span></li>
  </ol></nav>}
  <Wrapper class="tree-disclosure">
    {compact && <summary>{title}: collection tree</summary>}
    <nav id={compact ? undefined : 'collection'} aria-label="Draft collection tree">
      {!compact && <><h2>The {title.toLowerCase()} collection</h2><p>Draft collection. Available drafts link to reading; planned articles show the intended route.</p></>}
      <RelationalRebuildTree nodes={[{ entry: root, children: [] }]} currentKey={entry.key} currentPath={path} showBrief={!compact} />
      {groups.map((group, index) => <details class="subject" id={compact ? undefined : `reading-${index + 1}`}>
        <summary><span>{group}</span><span class="subject-count">{count(group)}</span></summary>
        <RelationalRebuildTree nodes={groupTree(group)} currentKey={entry.key} currentPath={path} showBrief={!compact} />
      </details>)}
      {compact && <a class="full-collection" href="#collection">Browse all subjects →</a>}
    </nav>
  </Wrapper>
</div>
<style>
  .rebuild-navigation { margin:2.75rem 0 0; border-top:1px solid var(--color-rule-strong); padding-top:1.5rem; }
  h2 { margin-top:0; padding-top:0; }
  nav > p { max-width:62ch; font:.85rem/1.7 var(--font-sans); color:var(--color-text-secondary); }
  .subject { border-bottom:1px solid var(--color-rule); }
  summary { display:flex; align-items:center; gap:.8rem; padding:.85rem 0; list-style:none; cursor:pointer; font:500 .9rem/1.5 var(--font-sans); }
  summary::-webkit-details-marker { display:none; }
  summary::after { content:''; flex:none; width:.4rem; height:.4rem; margin-left:auto; border-right:1.5px solid var(--color-text-secondary); border-bottom:1.5px solid var(--color-text-secondary); transform:rotate(-45deg); }
  details[open] > summary::after { transform:rotate(45deg); }
  .subject-count { margin-left:auto; font:.7rem/1.5 var(--font-sans); color:var(--color-text-secondary); white-space:nowrap; }
  .subject > summary::after { margin-left:0; }
  .compact { margin:0 0 1.75rem; padding:0; border:0; font:.8rem/1.5 var(--font-sans); }
  .breadcrumbs { font-size:.75rem; color:var(--color-text-secondary); }
  .breadcrumbs a { color:inherit; text-decoration:none; }
  .breadcrumbs a:hover { color:var(--color-accent); text-decoration:underline; }
  ol { display:flex; flex-wrap:wrap; gap:.3rem .6rem; list-style:none; padding:0; margin:0; }
  li { margin:0; }
  ol li + li::before { content:'/'; padding-right:.6rem; color:var(--color-text-secondary); }
  .compact > .tree-disclosure { margin-top:.85rem; border:1px solid var(--color-rule); border-radius:.4rem; }
  .compact > .tree-disclosure > summary { padding:.75rem .9rem; font-size:.8rem; }
  .compact > .tree-disclosure[open] > summary { border-bottom:1px solid var(--color-rule); }
  .compact .tree-disclosure > nav { padding:.85rem .9rem; max-height:min(72vh,42rem); overflow-y:auto; scrollbar-gutter:stable; }
  .compact .subject summary { padding:.65rem .15rem; font-size:.78rem; color:var(--color-text-secondary); }
  .full-collection { display:block; border-top:1px solid var(--color-rule); padding-top:.75rem; font-weight:500; }
  summary:focus-visible, a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  @media(max-width:480px) { summary { gap:.5rem; font-size:.85rem; } .subject-count { font-size:.65rem; } }
  @media print { .compact .tree-disclosure { display:none; } }
</style>
