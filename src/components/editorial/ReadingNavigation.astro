---
import { breadcrumbs, relationalHome } from '../../lib/reading';
import { relationalCollection, relationalArticleHref } from '../../lib/relational-collection';
import { objectArticles, objectHome } from '../../lib/object-storage-collection';
const { title } = Astro.props;
const path = Astro.url.pathname;
const trail = breadcrumbs(path, title);
const isRelational = path.startsWith(relationalHome);
const availableGroups = relationalCollection.filter(group => group.articles.some(article => !!article.status));
---
{trail.length > 0 && <div class="reading-navigation">
  <nav aria-label="Breadcrumb">
    <ol>{trail.map((item, index) => <li>{index === trail.length - 1 ? <span aria-current="page">{item.title}</span> : <a href={item.href}>{item.title}</a>}</li>)}</ol>
  </nav>
  {path.startsWith(objectHome) && <details class="article-switcher"><summary>Object storage: articles and practice</summary><nav aria-label="Articles in the object-storage collection"><a href={objectHome} aria-current={path === objectHome ? 'page' : undefined}>Object storage: introduction</a><ul class="collection-groups">{Array.from(new Set(objectArticles.map(a=>a.group))).map(group=><li class="collection-group"><span class="group-label">{group}</span><ul class="subarticles">{objectArticles.filter(a=>a.group===group).map(a=><li><a href={`${objectHome}${a.slug}/`} aria-current={path === `${objectHome}${a.slug}/` ? 'page' : undefined}>{a.title}</a></li>)}</ul></li>)}</ul><ul class="practice-links"><li><a href={`${objectHome}sandbox/`}>Object-storage sandbox</a></li><li><a href={`${objectHome}practice/`}>Try real S3</a></li></ul></nav></details>}
  {isRelational && <details class="article-switcher">
    <summary>Relational databases: articles</summary>
    <nav aria-label="Articles in the relational collection">
      <a href={relationalHome} aria-current={path === relationalHome ? 'page' : undefined}>Relational databases: introduction{path === relationalHome && <span class="current-marker"> You’re here</span>}</a>
      <ul class="collection-groups">
        {availableGroups.map(group => {
          const main = group.articles.find(article => article.slug === group.main && !!article.status);
          const children = group.articles.filter(article => !!article.status && article !== main);
          return <li class="collection-group">
            {main ? <a class="main-link" href={relationalArticleHref(main.slug)} aria-current={path === relationalArticleHref(main.slug) ? 'page' : undefined}>{main.title}{path === relationalArticleHref(main.slug) && <span class="current-marker"> You’re here</span>}</a> : <span class="group-label">{group.title}</span>}
            {children.length > 0 && <ul class="subarticles">{children.map(article => <li>
              <a href={relationalArticleHref(article.slug)} aria-current={path === relationalArticleHref(article.slug) ? 'page' : undefined}>{article.title}{path === relationalArticleHref(article.slug) && <span class="current-marker"> You’re here</span>}</a>
            </li>)}</ul>}
          </li>;
        })}
      </ul>
      <ul class="practice-links">
        <li><a href={`${relationalHome}sandbox/`} aria-current={path === `${relationalHome}sandbox/` ? 'page' : undefined}>SQL sandbox{path === `${relationalHome}sandbox/` && <span class="current-marker"> You’re here</span>}</a></li>
        <li><a href={`${relationalHome}checkout/`} aria-current={path === `${relationalHome}checkout/` ? 'page' : undefined}>Worked tour: The last blue mug{path === `${relationalHome}checkout/` && <span class="current-marker"> You’re here</span>}</a></li>
        <li><a href={`${relationalHome}practice/`} aria-current={path === `${relationalHome}practice/` ? 'page' : undefined}>SQL practice{path === `${relationalHome}practice/` && <span class="current-marker"> You’re here</span>}</a></li>
      </ul>
      <a class="full-collection" href={`${relationalHome}#collection`}>The full relational collection →</a>
    </nav>
  </details>}
</div>}
<style>
  .reading-navigation { margin: 0 0 2rem; font: .85rem/1.6 var(--font-sans); }
  ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .3rem .6rem; }
  li { margin: 0; }
  ol li + li::before { content: '/'; padding-right: .6rem; color: var(--color-text-secondary); }
  [aria-current="page"] { color: var(--color-text-secondary); }
  .article-switcher { margin-top: 1rem; border-block: 1px solid var(--color-rule); }
  summary { cursor: pointer; padding: .7rem 0; color: var(--color-accent); }
  summary:focus-visible, a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .article-switcher nav { padding: .3rem 0 1rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  .collection-groups { display: grid; gap: 1rem; margin: 1rem 0; }
  .main-link, .group-label { font-weight: 600; }
  .article-switcher a { display: block; padding: .25rem 0; }
  .subarticles { margin: .3rem 0 0 .2rem; padding-left: 1rem; border-left: 1px solid var(--color-rule); }
  .article-switcher a[aria-current="page"] { color: var(--color-text); text-decoration: none; }
  .current-marker { display: inline-block; margin-left: .6rem; color: var(--color-text-secondary); font-size: .75rem; font-weight: 400; white-space: nowrap; }
  .practice-links { padding-top: .7rem; border-top: 1px solid var(--color-rule); }
  .full-collection { margin-top: .7rem; }
</style>
