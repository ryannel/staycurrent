---
import { breadcrumbs, relationalHome } from '../../lib/reading';
import { relationalCollection, relationalArticleHref } from '../../lib/relational-collection';
const { title } = Astro.props;
const path = Astro.url.pathname;
const trail = breadcrumbs(path, title);
const isRelational = path.startsWith(relationalHome);
const currentGroup = relationalCollection.find(group => group.articles.some(article => relationalArticleHref(article.slug) === path));
---
{trail.length > 0 && <div class="reading-navigation">
  <nav aria-label="Breadcrumb">
    <ol>{trail.map((item, index) => <li>{index === trail.length - 1 ? <span aria-current="page">{item.title}</span> : <a href={item.href}>{item.title}</a>}</li>)}</ol>
  </nav>
  {isRelational && <details class="article-switcher">
    <summary>In this collection{currentGroup && <span> · {currentGroup.title}</span>}</summary>
    <nav aria-label="Articles in the relational collection">
      <a href={relationalHome} aria-current={path === relationalHome ? 'page' : undefined}>Relational databases: introduction</a>
      <div class="collection-groups">
        {relationalCollection.filter(group => group.articles.some(article => article.status === 'draft')).map(group => <section>
          <h2>{group.title}</h2>
          <ul>{group.articles.filter(article => article.status === 'draft').map(article => <li>
            <a href={relationalArticleHref(article.slug)} aria-current={path === relationalArticleHref(article.slug) ? 'page' : undefined}>{article.title}</a>
          </li>)}</ul>
        </section>)}
      </div>
      <p><a href={`${relationalHome}checkout/`} aria-current={path === `${relationalHome}checkout/` ? 'page' : undefined}>The last blue mug: optional worked tour</a></p>
      <p><a href={`${relationalHome}practice/`} aria-current={path === `${relationalHome}practice/` ? 'page' : undefined}>Start the SQL practice</a></p>
      <a href={`${relationalHome}#collection`}>Full collection and planned articles →</a>
    </nav>
  </details>}
</div>}
<style>
  .reading-navigation { margin: 0 0 2rem; font: .85rem/1.6 var(--font-sans); }
  ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .3rem .6rem; }
  li { margin: 0; }
  ol li + li::before { content: '/'; padding-right: .6rem; color: var(--color-text-secondary); }
  [aria-current="page"] { color: var(--color-text-secondary); }
  .article-switcher { margin-top: 1rem; border-block: 1px solid var(--color-rule); }
  summary { cursor: pointer; padding: .7rem 0; color: var(--color-accent); }
  summary span { color: var(--color-text-secondary); }
  summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .article-switcher nav { padding: .5rem 0 1.2rem; }
  .collection-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1.2rem 2rem; margin: 1rem 0; }
  h2 { font: 600 .85rem/1.5 var(--font-sans); margin: 0 0 .6rem; padding: 0; }
  ul { list-style: none; padding: 0; margin: 0; }
  ul a { display: block; padding: .3rem 0; }
  a[aria-current="page"] { font-weight: 600; text-decoration: none; }
</style>
