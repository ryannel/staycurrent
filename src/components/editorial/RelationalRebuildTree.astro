---
import SwitcherLink from './SwitcherLink.astro';
import { relationalRebuildHref, type RelationalRebuildNode } from '../../lib/relational-rebuild';
interface Props { nodes: RelationalRebuildNode[]; currentKey: string; currentPath: string; showBrief?: boolean }
const { nodes, currentKey, currentPath, showBrief = false } = Astro.props;
---
<ul class:list={['rebuild-tree', { 'with-briefs': showBrief }]}>
  {nodes.map(({ entry, children }) => <li>
    {entry.available
      ? <SwitcherLink href={relationalRebuildHref(entry.slug)} path={currentPath}>{entry.title}</SwitcherLink>
      : <span class="unavailable" aria-current={entry.key === currentKey ? 'page' : undefined}>{entry.title}
          {entry.key === currentKey && <span class="current-marker">You’re here</span>}
        </span>}
    {!entry.available && <span class="status">{entry.status === 'planned' ? 'Planned' : 'Not yet available'}</span>}
    {showBrief && <p>{entry.brief}</p>}
    {children.length > 0 && <Astro.self nodes={children} currentKey={currentKey} currentPath={currentPath} showBrief={showBrief} />}
  </li>)}
</ul>
<style>
  .rebuild-tree { list-style:none; padding:0; margin:.15rem 0 .85rem; font:.8rem/1.5 var(--font-sans); }
  li { margin:.55rem 0; }
  .rebuild-tree :global(.rebuild-tree) { margin:.45rem 0 .65rem .2rem; padding-left:1rem; border-left:1px solid var(--color-rule); }
  :global(.rebuild-tree .switcher-link), .unavailable { text-underline-offset:.2em; }
  :global(.rebuild-tree .switcher-link[aria-current="page"]), .unavailable[aria-current="page"] { display:inline-flex; align-items:center; flex-wrap:wrap; gap:.4rem .65rem; color:var(--color-text); }
  .unavailable,.status { color:var(--color-text-secondary); }
  .status { display:inline-block; margin-left:.5rem; font-size:.65rem; }
  :global(.rebuild-tree .current-marker) { display:inline-block; padding:.08rem .45rem; border-radius:1rem; background:color-mix(in srgb,var(--color-accent) 10%,transparent); color:var(--color-accent); font:500 .65rem/1.5 var(--font-sans); white-space:nowrap; }
  .with-briefs { font-size:.95rem; }
  .with-briefs li { margin:0 0 1rem; }
  p { margin:.3rem 0 0; font:.85rem/1.6 var(--font-sans); color:var(--color-text-secondary); }
  :global(.rebuild-tree a:focus-visible) { outline:2px solid var(--color-accent); outline-offset:4px; }
</style>
