---
import SwitcherLink from './SwitcherLink.astro';
import { relationalDraftHref, relationalDraftGroups, type RelationalDraftState } from '../../lib/relational-draft-20261024';
interface Props { entry: RelationalDraftState; entries: RelationalDraftState[]; published?: boolean }
const { entry, entries, published = false } = Astro.props;
const href = (slug: string) => published ? `/learn/databases/relational/${slug ? `${slug}/` : ''}` : relationalDraftHref(slug);
const path = href(entry.slug);
const introduction = entries.find(item => item.key === 'r00');
---
<div class="draft-navigation" data-pagefind-ignore>
  <nav aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      {published && <li><a href="/learn/databases/choosing/">Databases and storage</a></li>}
      {entry.slug && <li>{introduction?.status !== 'planned' ? <a href={href('')}>{published ? "Relational databases" : "Relational draft"}</a> : <span>{published ? "Relational databases" : "Relational draft"}</span>}</li>}
      <li><span aria-current="page">{entry.slug ? entry.title : (published ? 'Relational databases' : 'Relational draft')}</span></li>
    </ol>
  </nav>
  <details class="article-switcher">
    <summary>{published ? "Relational databases: articles" : "Relational databases: draft articles"}</summary>
    <nav aria-label={published ? "Articles in this collection" : "Articles in this draft collection"}>
      {introduction && (introduction.status !== 'planned'
        ? <SwitcherLink href={href('')} path={path}>{introduction.title}</SwitcherLink>
        : <span class="planned">{introduction.title}<span class="status">Planned</span></span>)}
      <ul class="collection-groups">
        {relationalDraftGroups.map(group => <li>
          <details>
            <summary>{group.title}</summary>
            <ul class="subarticles">{entries.filter(item => item.group === group.id).map(item => <li>
              {item.status !== 'planned'
                ? <SwitcherLink href={href(item.slug)} path={path}>{item.title}</SwitcherLink>
                : <span class="planned">{item.title}<span class="status">Planned</span></span>}
            </li>)}</ul>
          </details>
        </li>)}
      </ul>
      <a class="full-collection" href={`${path}#collection`}>Browse all subjects →</a>
    </nav>
  </details>
</div>
<style>
  .draft-navigation { margin:0 0 1.75rem; font:.8rem/1.5 var(--font-sans); }
  .draft-navigation > nav { font-size:.75rem; color:var(--color-text-secondary); }
  .draft-navigation > nav a { color:inherit; text-decoration:none; }
  .draft-navigation > nav a:hover { color:var(--color-accent); text-decoration:underline; }
  ol { display:flex; flex-wrap:wrap; gap:.3rem .6rem; list-style:none; padding:0; margin:0; }
  li { margin:0; }
  ol li + li::before { content:'/'; padding-right:.6rem; color:var(--color-text-secondary); }
  .article-switcher { margin-top:.85rem; border:1px solid var(--color-rule); border-radius:.4rem; }
  summary { display:flex; align-items:center; gap:1rem; list-style:none; cursor:pointer; padding:.75rem .9rem; color:var(--color-text); }
  summary::-webkit-details-marker { display:none; }
  summary::after { content:''; flex:none; width:.4rem; height:.4rem; margin-left:auto; border-right:1.5px solid var(--color-text-secondary); border-bottom:1.5px solid var(--color-text-secondary); transform:rotate(-45deg); }
  details[open] > summary::after { transform:rotate(45deg); }
  summary:hover { background:var(--color-surface-alt); }
  .article-switcher[open] > summary { border-bottom:1px solid var(--color-rule); }
  .article-switcher nav { padding:.85rem .9rem; max-height:min(72vh,42rem); overflow-y:auto; scrollbar-gutter:stable; }
  ul { list-style:none; padding:0; margin:0; }
  .collection-groups { margin:.8rem 0; }
  .collection-groups > li > details { border-top:1px solid var(--color-rule); }
  .collection-groups summary { padding:.65rem .15rem; font-size:.78rem; color:var(--color-text-secondary); }
  .article-switcher a, .article-switcher :global(.switcher-link), .planned { display:block; padding:.35rem 0; font-size:.8rem; text-decoration:none; }
  .article-switcher a:hover, .article-switcher :global(a.switcher-link:hover) { text-decoration:underline; }
  .subarticles { margin:0 0 .65rem .2rem; padding-left:.8rem; border-left:1px solid var(--color-rule); }
  .article-switcher :global(.switcher-link[aria-current="page"]) { display:flex; align-items:center; flex-wrap:wrap; gap:.4rem .65rem; color:var(--color-text); }
  .article-switcher :global(.current-marker) { padding:.08rem .45rem; border-radius:1rem; background:color-mix(in srgb,var(--color-accent) 10%,transparent); color:var(--color-accent); font-size:.65rem; font-weight:500; white-space:nowrap; }
  .planned { color:var(--color-text-secondary); }
  .status { margin-left:.5rem; font-size:.65rem; white-space:nowrap; }
  .full-collection { border-top:1px solid var(--color-rule); padding-top:.75rem !important; font-weight:500; }
  summary:focus-visible, a:focus-visible, .article-switcher :global(a:focus-visible) { outline:2px solid var(--color-accent); outline-offset:3px; }
  @media print { .article-switcher { display:none; } }
</style>
