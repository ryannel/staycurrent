---
import RelationalCollectionDraft from '../../layouts/RelationalCollectionDraft.astro';
import { relationalPublishedEntries, relationalPublishedGroups } from '../../lib/relational-publication';
interface Props { entryKey: string }
const { entryKey } = Astro.props;
const entry = relationalPublishedEntries.find(item => item.key === entryKey);
if (!entry) throw new Error(`Unknown relational article: ${entryKey}`);
const fragments = import.meta.glob('../../articles/relational-collection/*.astro', { eager: true, import: 'default' });
const Component = fragments[`../../articles/relational-collection/${entry.key}.astro`];
if (!Component) throw new Error(`Missing published relational article: ${entry.key}`);
---
<RelationalCollectionDraft entry={entry} entries={relationalPublishedEntries} published>
  <Component entry={entry} entries={relationalPublishedEntries} collection={relationalPublishedGroups} />
</RelationalCollectionDraft>
