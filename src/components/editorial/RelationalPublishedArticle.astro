---
import RelationalRebuild from '../../layouts/RelationalRebuild.astro';
import { relationalPublishedStates, relationalPublishedCollection, relationalPublishedHome } from '../../lib/relational-publication';
import { relationalRebuildHrefFor } from '../../lib/relational-rebuild';
interface Props { entryKey: string }
const { entryKey } = Astro.props;
const entries = relationalPublishedStates;
const entry = entries.find(item => item.key === entryKey);
if (!entry) throw new Error(`Unknown relational article: ${entryKey}`);
const fragments = import.meta.glob('../../articles/relational-rebuild/*.astro', { eager: true, import: 'default' });
const Component = fragments[`../../articles/relational-rebuild/${entry.key}.astro`];
if (!Component) throw new Error(`Missing published relational article: ${entry.key}`);
const collection = relationalPublishedCollection;
const hrefFor = (key: string) => relationalRebuildHrefFor(key, entries, relationalPublishedHome);
---
<RelationalRebuild entry={entry} entries={entries} collection={collection} published>
  <Component entry={entry} entries={entries} collection={collection} hrefFor={hrefFor} />
</RelationalRebuild>
