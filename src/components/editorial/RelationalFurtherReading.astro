---
import { relationalCollection, relationalArticleHref } from '../../lib/relational-collection';
interface Props { slugs: string[]; }
const articles = Astro.props.slugs.map(slug => {
  const article = relationalCollection.flatMap(group => group.articles).find(article => article.slug === slug);
  if (!article) throw new Error(`Unknown relational article: ${slug}`);
  return article;
});
---
<p class="further-reading"><span>Further reading:</span> {articles.map((article,index)=><>{index > 0 && ' · '}<a href={relationalArticleHref(article.slug)}>{article.title}</a> <small>({article.status === 'draft' ? 'draft' : 'planned'})</small></>)}</p>
<style>
  .further-reading { margin:1rem 0 0; font:.78rem/1.7 var(--font-sans); color:var(--color-text-secondary); }
  .further-reading span { margin-right:.3rem; }
  a { text-underline-offset:.2em; }
</style>
