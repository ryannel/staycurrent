---
import { relationalCollection, relationalArticleHref } from '../../lib/relational-collection';
const label = (status?: string) => status === 'draft' ? 'Working draft' : 'Planned';
const groupStatus = (articles: typeof relationalCollection[number]['articles']) => {
  const drafts = articles.filter(article => article.status === 'draft').length;
  const planned = articles.length - drafts;
  return [drafts ? `${drafts} working ${drafts === 1 ? 'draft' : 'drafts'}` : '', planned ? `${planned} planned` : ''].filter(Boolean).join(' · ');
};
---
<nav class="collection-map" id="collection" aria-labelledby="collection-title">
  <h2 id="collection-title">The relational database collection</h2>
  <p>Each main deep dive develops a subject from its foundations to the decisions it helps you make. The articles beneath it go further into a particular mechanism or task. You can also enter through the question you have now: <a href="#reading-performance">understanding performance</a>, <a href="#reading-scaling">scaling a database</a>, or <a href="#reading-products">choosing a product</a>.</p>
  <p>For a tour through one checkout, read <a href="/learn/databases/relational/checkout/">The last blue mug</a>. This optional worked example uses a separate, simpler shop. To try the SQL yourself, <a href="/learn/databases/relational/practice/">start the practice setup</a>.</p>
  {relationalCollection.map(group => {
    const main = group.articles.find(article => article.slug === group.main);
    const children = group.articles.filter(article => article.slug !== group.main);
    return (
      <details id={`reading-${group.id}`} open={group.articles.some(article => article.status === 'draft')}>
        <summary>{group.title}<span>{groupStatus(group.articles)}</span></summary>
        {main && <div class="main-article">
          <p class="article-kind">Main deep dive · {label(main.status)}</p>
          <a href={relationalArticleHref(main.slug)}>{main.title}</a>
          <p>{main.description}</p>
        </div>}
        {children.length > 0 && <div class:list={['further-depth', {'nested': !!main}]}>
          <p class="article-kind">{main ? 'Further depth and practice' : 'Practical guides'}</p>
          <ul>{children.map(article => <li>
            <a href={relationalArticleHref(article.slug)}>{article.title}</a>
            <span class="article-status">{label(article.status)}</span>
            <p>{article.description}</p>
          </li>)}</ul>
        </div>}
      </details>
    );
  })}
</nav>
<style>
  .collection-map { margin:3rem 0; border-top:1px solid var(--color-rule-strong); padding-top:1rem; }
  .collection-map > p { font-size:1rem; }
  details { border-bottom:1px solid var(--color-rule); }
  summary { padding:1rem 0; cursor:pointer; font:500 1rem/1.5 var(--font-sans); }
  summary span { display:block; margin:.25rem 0 0 1rem; font:.75rem/1.5 var(--font-sans); color:var(--color-text-secondary); }
  .main-article,.further-depth { margin:0 0 1.2rem 1rem; }
  .nested { margin-left:1.6rem; padding-left:1rem; border-left:1px solid var(--color-rule); }
  .article-kind { font:.72rem/1.5 var(--font-sans); color:var(--color-text-secondary); margin:0 0 .5rem; }
  .article-status { display:block; font:.72rem/1.5 var(--font-sans); color:var(--color-text-secondary); margin:.2rem 0; }
  ul { list-style:none; padding:0; }
  li { margin:0 0 1.2rem; }
  .main-article a,li a { font:500 .95rem/1.5 var(--font-sans); text-underline-offset:.2em; }
  .main-article > p:last-child,li p { margin:.3rem 0 0; font:.85rem/1.6 var(--font-sans); color:var(--color-text-secondary); }
  summary:focus-visible,a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  @media(max-width:480px) { .nested { margin-left:1rem; padding-left:.7rem; } }
</style>
