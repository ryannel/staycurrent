---
import { relationalCollection, relationalArticleHref, relationalIntroduction } from '../../lib/relational-collection';
import { relationalJourneys } from '../../lib/relational-journeys';
import SwitcherLink from './SwitcherLink.astro';
interface Props { path?: string; showReadingPaths?: boolean }
const { path = Astro.url.pathname, showReadingPaths = true } = Astro.props;
const all = [relationalIntroduction, ...relationalCollection.flatMap(group => group.articles)];
const byId = (id: string) => all.find(article => article.id === id)!;
const label = (status?: string) => status === 'published' ? '' : status === 'draft' ? 'Working draft' : 'Planned';
const groupStatus = (articles: typeof relationalCollection[number]['articles']) => {
  const drafts = articles.filter(article => article.status === 'draft').length;
  const published = articles.filter(article => article.status === 'published').length;
  const planned = articles.length - drafts - published;
  return [published ? `${published} ${published === 1 ? 'article' : 'articles'}` : '', drafts ? `${drafts} working ${drafts === 1 ? 'draft' : 'drafts'}` : '', planned ? `${planned} planned` : ''].filter(Boolean).join(' · ');
};
---
<nav class="collection-map" id="collection" aria-labelledby="collection-title">
  <h2 id="collection-title">The relational database collection</h2>
  <p class="collection-position"><SwitcherLink href={relationalArticleHref('')} path={path}>Relational databases: introduction</SwitcherLink></p>
  <p>{showReadingPaths ? 'Start with the task you have now, or browse the subjects below.' : 'Browse the subjects below.'} The PostgreSQL and CockroachDB branches follow each product's behaviour; take the branch you use.</p>
  <p>The SQL examples use independent fixtures. Start each article in its own <a href="/learn/databases/relational/evidence/relational-fixtures.md">disposable database</a> unless it explicitly continues an earlier setup. You can also <a href="/learn/databases/relational/sandbox/">try SQL in the browser sandbox</a> or use the <a href="/learn/databases/relational/practice/">local PostgreSQL setup</a>. The optional <a href="/learn/databases/relational/checkout/">checkout tour</a> uses a separate, simpler shop.</p>
  {showReadingPaths && <><h3>Choose a reading path</h3>
  {relationalJourneys.map(journey => <details><summary>{journey.name}</summary>
    {journey.ids.length > 0 && <ol>{journey.ids.map(byId).map(article => <li><SwitcherLink href={relationalArticleHref(article.slug)} path={path}>{article.title}</SwitcherLink></li>)}</ol>}
    {journey.branches.map(branch => <div><p class="article-kind">{branch.name}</p><ul>{branch.ids.map(byId).map(article => <li><SwitcherLink href={relationalArticleHref(article.slug)} path={path}>{article.title}</SwitcherLink></li>)}</ul></div>)}
  </details>)}</>}
  <h3>Browse by subject</h3>
  {relationalCollection.map(group => {
    const main = group.articles.find(article => article.slug === group.main);
    const children = group.articles.filter(article => article.slug !== group.main);
    return (
      <details id={`reading-${group.id}`}>
        <summary><span class="subject-title">{group.title}</span><span class="subject-count">{groupStatus(group.articles)}</span></summary>
        {main && <div class="main-article">
          <p class="article-kind">Main deep dive{label(main.status) && ` · ${label(main.status)}`}</p>
          <SwitcherLink href={relationalArticleHref(main.slug)} path={path}>{main.title}</SwitcherLink>
          <p>{main.description}</p>
        </div>}
        {children.length > 0 && <div class:list={['further-depth', {'nested': !!main}]}>
          {main && <p class="article-kind">Further depth and practice</p>}
          <ul>{children.map(article => <li>
            <SwitcherLink href={relationalArticleHref(article.slug)} path={path}>{article.title}</SwitcherLink>
            {label(article.status) && <span class="article-status">{label(article.status)}</span>}
            <p>{article.description}</p>
          </li>)}</ul>
        </div>}
      </details>
    );
  })}
</nav>
<style>
  .collection-map { margin:2.75rem 0 0; border-top:1px solid var(--color-rule-strong); padding-top:1.5rem; }
  .collection-map > h2 { margin-top:0; padding-top:0; }
  .collection-map > p { max-width:62ch; font:.85rem/1.7 var(--font-sans); color:var(--color-text-secondary); }
  .collection-position :global(.switcher-link) { display:flex; align-items:center; flex-wrap:wrap; gap:.4rem .65rem; color:var(--color-text); }
  details { border-bottom:1px solid var(--color-rule); }
  summary { display:grid; grid-template-columns:minmax(0,1fr) auto .45rem; align-items:center; gap:.8rem; padding:.85rem 0; list-style:none; cursor:pointer; font:500 .9rem/1.5 var(--font-sans); }
  summary::-webkit-details-marker { display:none; }
  summary::after { content:''; grid-column:3; width:.4rem; height:.4rem; border-right:1.5px solid var(--color-text-secondary); border-bottom:1.5px solid var(--color-text-secondary); transform:rotate(-45deg); }
  details[open] > summary::after { transform:rotate(45deg); }
  .subject-count { font:.7rem/1.5 var(--font-sans); color:var(--color-text-secondary); white-space:nowrap; }
  .main-article,.further-depth { margin:.15rem 0 1.1rem .15rem; }
  .nested { margin-left:1.6rem; padding-left:1rem; border-left:1px solid var(--color-rule); }
  .article-kind { font:.72rem/1.5 var(--font-sans); color:var(--color-text-secondary); margin:0 0 .5rem; }
  .article-status { display:block; font:.72rem/1.5 var(--font-sans); color:var(--color-text-secondary); margin:.2rem 0; }
  ul { list-style:none; padding:0; }
  li { margin:0 0 1rem; }
  .main-article :global(.switcher-link),li :global(.switcher-link) { font:500 .95rem/1.5 var(--font-sans); text-underline-offset:.2em; }
  .collection-position :global(.current-marker) { display:inline-block; padding:.08rem .45rem; border-radius:1rem; background:color-mix(in srgb,var(--color-accent) 10%,transparent); color:var(--color-accent); font:500 .65rem/1.5 var(--font-sans); white-space:nowrap; }
  .main-article > p:last-child,li p { margin:.3rem 0 0; font:.85rem/1.6 var(--font-sans); color:var(--color-text-secondary); }
  summary:focus-visible,a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  @media(max-width:480px) { summary { gap:.5rem; font-size:.85rem; } .subject-count { font-size:.65rem; } .nested { margin-left:1rem; padding-left:.7rem; } }
</style>
