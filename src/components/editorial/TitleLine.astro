---
// The line under an article's title: what kind of article it is, how long it
// takes to read, and the version it describes. The reading time is filled in
// from the rendered page by src/middleware.ts. Links go in the slot.
interface Props { type: string; version?: string; class?: string }
const { type, version, class: className = 'essay-meta' } = Astro.props;
---
<div class={className}><span>{type}</span><span data-reading-time></span>{version && <span>{version}</span>}<slot /></div>
