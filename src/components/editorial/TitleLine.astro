---
// The line under an article's title: what kind of article it is, how long it
// takes to read, and the version or products it describes. The reading time is
// filled in from the rendered page by src/middleware.ts.
// The types are listed in src/lib/article-types.ts.
import { relationalCollection, relationalArticleHref } from '../../lib/relational-collection';
import { relationalHome } from '../../lib/reading';
import type { ArticleType } from '../../lib/article-types';

interface Props { type: ArticleType; version?: string; class?: string }
const { type, version, class: className = 'essay-meta' } = Astro.props;

// A companion names the deep dive it belongs to, from the collection's groups.
let main: { title: string; href: string } | undefined;
if (type === 'Companion') {
  const slug = Astro.url.pathname.replace(relationalHome, '').replace(/\/$/, '');
  const group = relationalCollection.find((g) => g.articles.some((a) => a.slug === slug));
  const article = group?.articles.find((a) => a.slug === group.main);
  if (!article || article.slug === slug) throw new Error(`TitleLine: no deep dive found for companion ${Astro.url.pathname}`);
  main = { title: article.title, href: relationalArticleHref(article.slug) };
}
---
<div class={className}>
  {main ? <span>Companion to <a href={main.href}>{main.title}</a></span> : <span>{type}</span>}<span data-reading-time></span>{version && <span>{version}</span>}<slot />
</div>
