---
// Previous and next links at the foot of every page in a collection, in the
// order the collection switcher lists them.
import { neighbours } from '../../lib/collection-order';
interface Props { path?: string }
const { path = Astro.url.pathname } = Astro.props;
const around = neighbours(path);
---
{around && (around.previous || around.next) && (
  <nav class:list={['collection-pager', { single: !around.previous || !around.next }]} data-pagefind-ignore aria-label="Previous and next in this collection">
    {around.previous && <a class="previous" href={around.previous.href}><span class="pager-label">Previous</span><span class="pager-title">{around.previous.title}</span></a>}
    {around.next && <a class="next" href={around.next.href}><span class="pager-label">Next</span><span class="pager-title">{around.next.title}</span></a>}
  </nav>
)}
<style>
  .collection-pager { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:1rem; margin:1.25rem 0 0; font:.9rem/1.5 var(--font-sans); }
  a { display:grid; gap:.2rem; padding:.85rem 1rem; border-radius:.35rem; background:var(--color-surface-alt); text-decoration:none; }
  a:hover .pager-title { text-decoration:underline; }
  .pager-label { font-size:.65rem; letter-spacing:.06em; text-transform:uppercase; color:var(--color-text-secondary); }
  .pager-title { overflow-wrap:anywhere; }
  .previous .pager-label::before { content:'← '; }
  .next { text-align: right; }
  .next .pager-label::after { content:' →'; }
  .single { grid-template-columns:minmax(0,1fr); }
  .single a { grid-template-columns:auto minmax(0,1fr); align-items:baseline; gap:1rem; text-align:left; }
  @media (max-width:540px) { .collection-pager { grid-template-columns:minmax(0,1fr); } .next { text-align:left; } .single a { grid-template-columns:minmax(0,1fr); gap:.2rem; } }
  @media print { .collection-pager { display: none; } }
</style>
