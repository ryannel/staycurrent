---
// Previous and next links at the foot of every page in a collection, in the
// order the collection switcher lists them.
import { neighbours } from '../../lib/collection-order';
interface Props { path?: string }
const { path = Astro.url.pathname } = Astro.props;
const around = neighbours(path);
---
{around && (around.previous || around.next) && (
  <nav class="collection-pager" data-pagefind-ignore aria-label="Previous and next in this collection">
    {around.previous ? <a class="previous" href={around.previous.href}><span>Previous</span>{around.previous.title}</a> : <span />}
    {around.next && <a class="next" href={around.next.href}><span>Next</span>{around.next.title}</a>}
  </nav>
)}
<style>
  .collection-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; border-top: 1px solid var(--color-rule); margin-top: 3.5rem; padding-top: 1.4rem; font: .95rem/1.5 var(--font-sans); }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
  span { display: block; font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; color: var(--color-text-secondary); margin-bottom: .2rem; }
  .previous span::before { content: '← '; }
  .next { text-align: right; }
  .next span::after { content: ' →'; }
  @media (max-width: 540px) { .collection-pager { grid-template-columns: 1fr; } .next { text-align: left; } }
  @media print { .collection-pager { display: none; } }
</style>
