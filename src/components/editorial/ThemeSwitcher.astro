<fieldset class="theme-switcher" data-theme-switcher hidden>
  <legend>Colour theme</legend>
  <label title="System theme">
    <input type="radio" name="colour-theme" value="system" checked />
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
    <span>System</span>
  </label>
  <label title="Dark theme">
    <input type="radio" name="colour-theme" value="dark" />
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 13.1A8.5 8.5 0 0 1 10.9 3.5a8.5 8.5 0 1 0 9.6 9.6Z"/></svg>
    <span>Dark</span>
  </label>
  <label title="Light theme">
    <input type="radio" name="colour-theme" value="light" />
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
    <span>Light</span>
  </label>
</fieldset>
<style>
  .theme-switcher { display: flex; align-items: center; gap: 2px; flex-shrink: 0; margin: 0; padding: 3px; border: 1px solid var(--color-rule); border-radius: 999px; }
  .theme-switcher[hidden] { display: none; }
  legend, input, span { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  label { position: relative; display: grid; place-items: center; width: 30px; height: 28px; border-radius: 999px; color: var(--color-text-secondary); cursor: pointer; }
  label:hover { color: var(--color-text); background: var(--color-surface-alt); }
  label:has(input:checked) { color: var(--color-accent); background: var(--color-surface-alt); }
  label:has(input:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>
