---
interface Props { id: string; title: string; headingLevel?: 3 | 4; }
const { id, title, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 4 ? 'h4' : 'h3';
---
<aside class="prediction" id={id} aria-labelledby={`${id}-title`}>
  <p class="eyebrow">Try a variation</p>
  <Heading class="prediction-title" id={`${id}-title`}>{title}</Heading>
  <slot />
  <p class="prediction-prompt">Make a prediction and explain which facts support it before opening the answer.</p>
  <details>
    <summary>Compare your reasoning</summary>
    <div class="prediction-answer"><slot name="answer" /></div>
  </details>
</aside>
<style>
  .prediction { margin:2rem 0; padding:1.2rem; border:1px solid var(--color-rule); border-left:3px solid var(--teal); background:var(--color-surface-alt); }
  .prediction .eyebrow { margin:0 0 .6rem; font:.7rem/1.5 var(--font-mono); color:var(--color-text-secondary); }
  .prediction-title { margin:0 0 .8rem; font:500 1.3rem/1.4 var(--font-serif); }
  .prediction :global(p) { font-size:1rem; }
  .prediction-prompt { color:var(--color-text-secondary); font:.85rem/1.6 var(--font-sans) !important; }
  summary { cursor:pointer; width:fit-content; max-width:100%; padding:.6rem .8rem; border:1px solid var(--color-accent); border-radius:6px; color:var(--color-accent); font:.85rem/1.5 var(--font-sans); }
  summary:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
  .prediction-answer { margin-top:1rem; border-top:1px solid var(--color-rule); }
  @media(max-width:550px) { .prediction { padding:.9rem; } }
</style>
