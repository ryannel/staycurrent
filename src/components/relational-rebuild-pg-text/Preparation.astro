<figure class="text-figure" data-preparation aria-labelledby="preparation-title">
  <figcaption id="preparation-title"><span class="figure-number">Figure 1</span> From source words to a match</figcaption>
  <label class="figure-option">Configuration <select data-config aria-label="Configuration"><option value="english">english · stem words</option><option value="simple">simple · keep word forms</option></select></label>
  <div class="preparation-scene">
    <p class="scene-label">Source text</p><p class="source-text">The blue mugs</p>
    <p class="flow-arrow" aria-hidden="true">↓</p>
    <p class="scene-label">Word positions → searchable lexemes</p>
    <div class="tokens" data-live>
      <div class="token" data-token="0"><small>1</small><strong>The</strong><span data-result="0">not prepared</span></div>
      <div class="token" data-token="1"><small>2</small><strong>blue</strong><span data-result="1">not prepared</span></div>
      <div class="token" data-token="2"><small>3</small><strong>mugs</strong><span data-result="2">not prepared</span></div>
    </div>
    <p class="representation" data-vector data-live>Source text has not been prepared.</p>
    <p class="query-check" data-match data-live>Request: mug → not checked</p>
  </div>
  <p class="step-explanation" data-explanation data-live aria-live="polite">The source has three words. The request is the singular mug.</p>
  <div class="player" role="group" aria-label="Figure 1 playback"><button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 4</span></div>
  <div class="hold" data-hold aria-hidden="true"><span></span></div>
  <p class="figure-note">A model of the checked SQL result. Position 1 remains a gap when English preparation removes The. Lexemes are displayed in sorted order in the vector.</p>
  <details><summary>All stages, as text</summary><p>English preparation removes The, keeps blue at position 2 and stems mugs to mug at 3. The request mug becomes mug and matches. The built-in simple configuration keeps the lower-case forms the, blue and mugs; the request mug then has no matching lexeme.</p></details>
</figure>
<script>
import {stepper} from '../figures/stepper.mjs';
for(const root of document.querySelectorAll<HTMLElement>('[data-preparation]')) {
  const config=root.querySelector<HTMLSelectElement>('[data-config]')!;
  const player=stepper(root,{steps:()=>4,draw(step:number){
    const english=config.value==='english';
    const values=english?['stop word · omitted','blue · position 2','mug · position 3']:['the · position 1','blue · position 2','mugs · position 3'];
    root.querySelectorAll<HTMLElement>('[data-result]').forEach((el,i)=>el.textContent=step===0?'not prepared':values[i]);
    root.querySelector('[data-token="0"]')!.classList.toggle('omitted',step>0&&english);
    root.querySelector('[data-vector]')!.textContent=step<2?'The lexemes have not yet been collected.':english?"'blue':2 'mug':3":"'blue':2 'mugs':3 'the':1";
    root.querySelector('[data-match]')!.textContent=step<3?'Request: mug → not checked':english?'Query mug is in the vector → match':'Query mug is absent from the vector → no match';
    const texts=["The source has three words. The request is the singular mug.",english?'English removes The as a stop word and reduces mugs to mug. The remaining positions are still 2 and 3.':'Simple lowercases the words. It keeps The as the and keeps mugs as mugs.', 'The tsvector collects the lexemes with their positions. It does not retain the original sentence.',english?'The query constructor also produces mug. The document contains it, so @@ is true.':'The query constructor produces mug, but this document contains mugs. @@ is false.'];
    root.querySelector('[data-explanation]')!.textContent=texts[step];
  }});
  config.addEventListener('change',()=>player.render());
}
</script>
