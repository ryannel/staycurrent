---
// Figure: the database's view of one stampede, through a pool of 20 connections.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import './stampedes.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="st-pool" title="What the database does with a stampede" controls="none"
  caption="Illustrative model: the key expires at time 0; requests for it arrive evenly; the rebuild query takes 200 ms; the application reaches the database through a pool of 20 connections, first come first served. One query for another page arrives 100 ms after the expiry. Queries do not slow each other down here, and nothing times out or retries; in a real database both make this worse.">
  <Slider slot="params" name="rate" label="Requests a second for the key" min={50} max={1000} step={50} value={500} />
  <Fragment slot="stats">
    <Readout name="misses" label="Queries for the key" kind="database" />
    <Readout name="stored" label="New copy stored after" kind="write" />
    <Readout name="busy" label="Database busy with them until" kind="database" />
    <Readout name="other" label="Another page's query waits" kind="client" />
  </Fragment>
  <Fragment slot="text">
    <p>The chart counts the pool's connections in use and the queries waiting for a connection, over the first two seconds after the expiry. At 500 requests a second, 100 requests miss in the 200 ms before the first result is stored. The first 20 take every connection; the other 80 wait in line. The first query stores the new copy at 200 ms, but the other 99 still run, 20 at a time, keeping every connection busy for about another second; the last of them finishes at 1.2 s. A query for another page that arrives at 100 ms waits about 0.32 s for a connection. At 100 requests a second the 20 misses just fit the pool and nothing waits; at 1,000 a second, 200 queries keep the pool busy until 2.2 s and the other page's query waits about 0.9 s.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { poolStampede, poolSeries } from './pool-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="st-pool"]').forEach(root => {
    const UNTIL = 2400;
    const chart = lineChart(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Connections in use and queries waiting for a connection, over time after the key expires',
      height: 240,
      x: { label: 'Seconds after the key expired', domain: [0, UNTIL], format: (v: number) => `${v / 1000} s` },
      y: { label: 'Queries', domain: [0, 'auto'] },
      series: [
        { id: 'busy', label: 'Using a connection', kind: 'database' },
        { id: 'waiting', label: 'Waiting for a connection', kind: 'miss' },
      ],
      rules: [{ y: 20, label: 'Pool size, 20', kind: 'neutral' }],
    });
    const s = (ms: number) => `${(ms / 1000).toFixed(ms < 1000 ? 2 : 1)} s`;
    let lastR: ReturnType<typeof poolStampede> | null = null;
    const drawMarks = () => {
      const r = lastR;
      if (!r) return;
      const narrow = root.clientWidth < 480;
      chart.mark('stored', r.firstStored, narrow ? 'stored' : 'New copy stored', 'write');
      chart.mark('other', 100, narrow ? 'other query' : 'Other page’s query arrives', 'client');
      chart.mark('served', r.otherWait < 1 ? null : 100 + r.otherWait, narrow ? 'gets connection' : 'and gets a connection', 'client');
    };
    new ResizeObserver(drawMarks).observe(root);
    bindParams(root, params => {
      const r = poolStampede({ rate: params.rate });
      const { busy, waiting } = poolSeries(r, UNTIL, 5);
      chart.set('busy', busy);
      chart.set('waiting', waiting);
      chart.render();
      lastR = r;
      drawMarks();
      setReadouts(root, { misses: String(r.misses), stored: s(r.firstStored), busy: s(r.busyUntil), other: r.otherWait < 1 ? 'no wait' : s(r.otherWait) });
    });
  });
</script>
