---
// Figure: a cold start, with and without one rebuild per key.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import './stampedes.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="st-coldstart" title="A cold start is a stampede on every key at once" controls="none"
  caption="Illustrative model, the scenario from Caching patterns, Figure 4: 500 requests a second over 1,000 keys where a few keys are very popular and most are rarely read (Zipf-like, as in that article), a database that answers queries one after another, a request that gives up after one second, and fills that are stored even when the request has given up. Redis starts empty. The two runs differ only in whether a miss for a key that is already being loaded sends another query or waits for that load.">
  <Slider slot="params" name="dbRate" label="Database capacity, queries a second" min={60} max={300} step={20} value={100} />
  <Fragment slot="stats">
    <Readout name="dup" label="Queries that duplicate one in progress" kind="miss" />
    <Readout name="waitEvery" label="Longest queue for the database, no coalescing" kind="miss" />
    <Readout name="waitPer" label="Longest queue, one query per key" kind="hit" />
    <Readout name="every" label="90% hit ratio after, no coalescing" kind="miss" />
    <Readout name="perkey" label="90% hit ratio after, one query per key" kind="hit" />
  </Fragment>
  <Fragment slot="text">
    <p>The upper chart shows how long a new query would wait for the database, each second after the restart; the lower one shows the hit ratio. With the database answering 100 queries a second and no coalescing, about 37% of the queries are for a key whose load is already under way. The hit ratio reaches 90% after about 10 seconds, the queue for the database peaks at about 4.4 seconds, and for those seconds most misses give up before their answer arrives. With one query per key there are no duplicates: 90% after about 7 seconds and a peak queue of about 1.5 seconds. At 60 queries a second the difference is larger (about 21 seconds against 10); at 150 or more the database keeps up and the two runs are nearly the same.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { coldStart } from './coldstart-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="st-coldstart"]').forEach(root => {
    const host = root.querySelector<HTMLElement>('[data-scene]')!;
    const top = document.createElement('div'), bottom = document.createElement('div');
    host.append(bottom, top);   // the queue first: it carries the lesson
    const UNTIL = 30;
    const seconds = (v: number) => `${v} s`;
    const ratio = lineChart(top, {
      label: 'Hit ratio each second after a cold start, for both runs', height: 200,
      x: { label: 'Seconds after the restart', domain: [0, UNTIL], format: seconds },
      y: { label: 'Hit ratio', domain: [0, 1], format: (v: number) => `${Math.round(v * 100)}%` },
      series: [{ id: 'every', label: 'No coalescing', kind: 'miss', dash: '' }, { id: 'perkey', label: 'One query per key', kind: 'hit', dash: '6 4' }],
      rules: [{ y: 0.9, label: '90%', kind: 'neutral' }],
    });
    const wait = lineChart(bottom, {
      label: 'How long a new database query would wait, each second after a cold start, for both runs', height: 200,
      x: { label: 'Seconds after the restart', domain: [0, UNTIL], format: seconds },
      y: { label: 'Queue wait (s)', domain: [0, 'auto'] },
      series: [{ id: 'every', label: 'No coalescing', kind: 'miss', dash: '' }, { id: 'perkey', label: 'One query per key', kind: 'hit', dash: '6 4' }],
      rules: [{ y: 1, label: 'Request gives up at 1 s', kind: 'neutral' }],
    });
    const runs = new Map<number, any>();
    const run = (dbRate: number) => {
      if (!runs.has(dbRate)) {
        const pair: any = {};
        for (const mode of ['every', 'perkey']) { const m = coldStart({ mode, dbRate }, 1); m.sim.advance(40000); pair[mode] = m; }
        runs.set(dbRate, pair);
      }
      return runs.get(dbRate);
    };
    bindParams(root, params => {
      const pair = run(params.dbRate);
      for (const mode of ['every', 'perkey']) {
        const samples = pair[mode].samples.filter((s: any) => s.t <= UNTIL);
        ratio.set(mode, [[0, 0], ...samples.map((s: any) => [s.t, s.hitRatio])]);
        wait.set(mode, [[0, 0], ...samples.map((s: any) => [s.t, s.wait / 1000])]);
      }
      ratio.render(); wait.render();
      const e = pair.every, p = pair.perkey;
      const peak = (m: any) => Math.max(...m.samples.map((s: any) => s.wait)) / 1000;
      const when = (m: any) => (m.recoveredAt == null ? 'not in 40 s' : `${m.recoveredAt} s`);
      setReadouts(root, {
        dup: `${Math.round((100 * e.totals.duplicates) / e.totals.queries)}%`,
        every: when(e),
        perkey: when(p),
        waitEvery: `${peak(e).toFixed(1)} s`,
        waitPer: `${peak(p).toFixed(1)} s`,
      });
    });
  });
</script>
