---
// Figure 7: what three tools said about the busiest node's keys, against the true request counts.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import './cluster.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="cluster-tools" title="Three ways to find the hot keys on one node" controls="none"
  caption="Measured on my laptop with Redis 8.10.3: three primaries, 10,000 keys of 300 bytes, 3,000 GETs a second for 180 seconds spread by a Zipf distribution (s = 1), maxmemory-policy allkeys-lfu. The keys are the eight busiest on the busiest node, port 7195, plus product:4976, which HOTKEYS ranked fifth by CPU time after 17 requests. One run; the CPU time charged to product:4976 is unexplained. Left out: SLOT-STATS, which reported the same CPU times per slot.">
  <Fragment slot="params">
    <Choice name="measure" label="Show" value="requests"
      options={[{ value: 'requests', label: 'true requests' }, { value: 'lfu', label: 'LFU counter' }, { value: 'bytes', label: 'HOTKEYS bytes' }, { value: 'cpu', label: 'HOTKEYS CPU' }]} />
  </Fragment>
  <div data-bars></div>
  <p class="cluster-verdict" data-note aria-live="polite"></p>
  <Fragment slot="text">
    <p>The load generator counted 55,126 requests for product:0 and 3,302 for product:16, a ratio of about 17 to 1. redis-cli --hotkeys, which reads the LFU counter, reported 107 and 29: the counter is logarithmic, so it ranks keys roughly but compresses the differences, and it put product:5 above product:4. HOTKEYS ranked by network bytes put the keys in exactly the order of the true counts. HOTKEYS ranked by CPU time put them in nearly the right order but placed product:4976, requested 17 times, fifth: it was charged about 430 microseconds a call, against under 1 microsecond for the other keys, for a reason I did not find.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams } from '../shared/player.mjs';
  import { barChart } from '../shared/chart.mjs';
  import { TOOL_ROWS } from './tools-data.mjs';

  const NOTES: Record<string, string> = {
    requests: 'The true counts, recorded by the clients: product:0 had about 17 times as many requests as product:16.',
    lfu: 'redis-cli --hotkeys reads the LFU counter, which grows logarithmically: 107 against 29, and product:5 above product:4. product:4976 was not listed.',
    bytes: 'HOTKEYS by network bytes: the same order as the true counts, and in proportion. product:4976 was not in its top ten.',
    cpu: 'HOTKEYS by CPU time: nearly the right order, but product:4976, with 17 requests, came fifth.',
  };
  document.querySelectorAll<HTMLElement>('[data-figure-id="cluster-tools"]').forEach(root => {
    let measure = 'requests';
    const fmt = (v: number) => v < 0 ? '—' : measure === 'bytes' ? `${(v / 1e6).toFixed(1)} MB` : measure === 'cpu' ? `${(v / 1000).toFixed(1)} ms` : v.toLocaleString('en-GB');
    const chart = barChart(root.querySelector<HTMLElement>('[data-bars]')!, {
      label: 'A value for each of nine keys on node 7195, by the chosen measure',
      bars: TOOL_ROWS.map(r => ({ id: r.key, label: r.key, kind: r.key === 'product:4976' ? 'error' : 'redis' })),
      x: { format: fmt },
      labels: 'beside',
    });
    const note = root.querySelector<HTMLElement>('[data-note]')!;
    bindParams(root, (params: any) => {
      measure = params.measure;
      chart.set(Object.fromEntries(TOOL_ROWS.map(r => [r.key, (r as any)[measure] ?? -1])));
      note.textContent = NOTES[measure];
    });
  });
</script>
