<figure class="cache-figure" data-negative>
 <p class="figure-title">An absent product can have a present cache entry</p>
 <label><input type="checkbox" data-policy checked /> Cache a successful “not found” result</label>
 <div class="negative-time"><span>Model time <strong data-time>0 s</strong></span><span>Source lookups <strong data-reads>0</strong></span></div>
 <div class="cache-copy-pair"><div class="cache-copy"><span>Source · product 99</span><strong class="negative-value" data-source>Absent</strong><small>The actual product record</small></div><div class="cache-copy" data-entry><span>Redis · lookup result</span><strong class="negative-value" data-cache>No entry</strong><small data-ttl>Next lookup is a miss</small><div class="negative-lifetime" aria-hidden="true"><i data-bar></i></div></div></div>
 <div class="cache-controls"><button data-action="read">Read product 99</button><button data-action="create">Create product</button><button data-action="advance">Advance 5 seconds</button><button data-action="delete">Invalidate result</button><button data-action="reset">Reset</button></div>
 <p class="explanation" data-explanation aria-live="polite">Product 99 does not exist. Read it to cache the absence.</p>
 <figcaption>Read twice, create the product, then read again. A full bar means ten seconds remain; each time step removes five. Ten seconds is an illustrative policy, not a recommended TTL. Disabling negative caching resets the experiment.</figcaption>
</figure>
<script>
import {negativeInitial,negativeStep} from '../../lib/caching/keys.mjs';
document.querySelectorAll<HTMLElement>('[data-negative]').forEach(root=>{
 let state=negativeInitial();const policy=root.querySelector<HTMLInputElement>('[data-policy]')!;
 const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
 const render=()=>{set('time',`${state.now} s`);set('reads',String(state.reads));set('source',state.source?'Exists':'Absent');set('cache',state.cached?(state.cached.found?'Found':'Not found'):'No entry');set('ttl',state.cached?`Entry present · expires in ${state.cached.expires-state.now} s`:'Next lookup is a miss');set('explanation',state.message);root.querySelector<HTMLElement>('[data-bar]')!.style.width=`${state.cached?(state.cached.expires-state.now)*10:0}%`;root.querySelector('[data-entry]')!.classList.toggle('key-wrong',!!state.cached&&state.cached.found!==state.source);root.querySelector<HTMLButtonElement>('[data-action="create"]')!.disabled=state.source;};
 root.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(b=>{b.onclick=()=>{state=negativeStep(state,b.dataset.action,{cacheAbsence:policy.checked});render();};});policy.onchange=()=>{state=negativeInitial();render();};render();
});
</script>
