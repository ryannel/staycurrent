---
// Figure: where an acknowledged write lives under each appendfsync policy.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import ActionButton from '../shared/ActionButton.astro';
import './repl.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="rp-aof" title="Where an acknowledged write lives" legend={[{ kind: 'write', label: 'Write, and its acknowledgement' }]} advance={1000}
  caption="Illustrative model: three writes a second, travel times slowed for watching. With 'no', the operating system is assumed to flush every 30 seconds, a common Linux default; the real interval depends on the kernel and how much is waiting. Redis restarts at once after each failure and replays what survived. A slow disk, which can make a crash lose writes with everysec, is not modelled.">
  <Choice slot="params" name="fsync" label="appendfsync" value="everysec" options={[{ value: 'always', label: 'always' }, { value: 'everysec', label: 'everysec (default)' }, { value: 'no', label: 'no' }]} />
  <ActionButton slot="actions" name="crash">Crash Redis</ActionButton>
  <ActionButton slot="actions" name="power">Cut the power</ActionButton>
  <Fragment slot="stats">
    <Readout name="acked" label="Writes acknowledged" kind="write" />
    <Readout name="cache" label="Acknowledged, not on disk" kind="neutral" />
    <Readout name="lost" label="Acknowledged writes lost" kind="error" />
  </Fragment>
  <p slot="after" class="rp-status" data-status aria-live="polite"></p>
  <Fragment slot="text">
    <p>Each write travels to Redis, which appends it to the append-only file with an ordinary write call. That puts it in the operating system’s page cache, in memory, and Redis replies. The write reaches the disk only when the file is fsynced.</p>
    <p>With everysec, Redis fsyncs about once a second, so at most about a second of acknowledged writes (three or so here) is only in the page cache. With no, Redis never fsyncs and the operating system flushes when it chooses, here every 30 seconds, so up to 30 seconds of writes wait in memory. With always, Redis fsyncs before every reply, so nothing acknowledged is ever only in memory, and every write waits for the disk.</p>
    <p>Crash Redis loses no acknowledged write here, because the page cache belongs to the operating system, which keeps running and writes it out. Cut the power loses whatever was only in the page cache: about a second’s writes with everysec, up to 30 seconds’ with no, none with always.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { createScene, spread } from '../shared/scene.mjs';
  import { create } from './aof-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="rp-aof"]').forEach(root => {
    const scene = createScene(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'An application writes to Redis, which appends to the AOF in the operating system page cache, which is later written to disk',
      nodes: [
        { id: 'app', kind: 'app', label: 'Application' },
        { id: 'redis', kind: 'redis', label: 'Redis' },
        { id: 'os', kind: 'neutral', label: 'Page cache', sublabel: 'operating system' },
        { id: 'disk', kind: 'neutral', label: 'Disk', sublabel: 'AOF file' },
      ],
      edges: [
        { id: 'app-redis', from: 'app', to: 'redis', label: 'SET' },
        { id: 'redis-os', from: 'redis', to: 'os', label: 'write()' },
        { id: 'os-disk', from: 'os', to: 'disk', label: 'fsync', dashed: true },
      ],
      layout: (width, compact) => {
        if (compact) {
          const [a, b] = spread(width, 2, 70);
          return { height: 280, positions: { app: [a, 70], redis: [b, 70], os: [b, 215], disk: [a, 215] } };
        }
        const xs = spread(width, 4, 80);
        return { height: 180, positions: { app: [xs[0], 90], redis: [xs[1], 90], os: [xs[2], 90], disk: [xs[3], 90] } };
      },
    });
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const report = (model: any) => {
      const e = model.lastEvent;
      if (!e) { status.textContent = ''; return; }
      const when = `${(e.at / 1000).toFixed(1)} s`;
      status.innerHTML = e.kind === 'crash'
        ? `At ${when} Redis crashed. The operating system kept the page cache and wrote it out: <strong>no acknowledged write was lost</strong>.`
        : `At ${when} the power was cut. The page cache was lost with the machine: <strong>${e.lost} acknowledged ${e.lost === 1 ? 'write' : 'writes'} lost</strong>.`;
    };
    mountSim(root, {
      seed: 2,
      create: params => create({ fsync: params.fsync }, 2),
      update: (model: any, params) => { model.setPolicy(params.fsync); return true; },
      actions: {
        crash: (model: any) => { model.fail('crash'); report(model); },
        power: (model: any) => { model.fail('power'); report(model); },
      },
      render(model: any) {
        scene.dots(model.movers.active());
        scene.node('os').set({ badge: `${model.inCache + model.pending} waiting`, badgeKind: 'neutral' });
        scene.node('disk').set({ badge: `${model.onDisk} stored`, badgeKind: 'neutral' });
        setReadouts(root, { acked: model.acknowledged.toLocaleString('en-GB'), cache: String(model.ackedInCache), lost: String(model.lost) });
        if (!model.lastEvent) report(model);
      },
    });
  });
</script>
