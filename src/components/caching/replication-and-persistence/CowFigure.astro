---
// Figure: a snapshot forks Redis; pages the parent writes during the save are copied.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import ActionButton from '../shared/ActionButton.astro';
import './repl.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="rp-cow" title="A snapshot and copy-on-write" advance={1000}
  legend={[{ kind: 'neutral', label: 'Page of Redis memory, no child' }, { kind: 'redis', label: 'Page shared by Redis and the child' }, { kind: 'write', label: 'Page copied after a write' }]}
  caption="Illustrative model, scaled down: 48 pages of memory, a snapshot that takes 12 seconds, a few writes a second. A real page is 4 KB, a real server has millions of them and takes thousands of writes a second; the proportions, not the numbers, carry over. The pause for the fork itself is drawn but not to scale.">
  <Choice slot="params" name="spread" label="Writes land" value="spread" options={[{ value: 'spread', label: 'all over memory' }, { value: 'hot', label: 'on a few hot keys' }]} />
  <Slider slot="params" name="rate" label="Writes" value={5} stops={[2, 5, 15]} labels={{ 2: '2 a second', 5: '5 a second', 15: '15 a second' }} />
  <ActionButton slot="actions" name="bgsave">Start a snapshot</ActionButton>
  <Fragment slot="stats">
    <Readout name="phase" label="Child process" kind="redis" />
    <Readout name="progress" label="Snapshot written" kind="redis" />
    <Readout name="extra" label="Extra memory now" kind="write" />
  </Fragment>
  <div class="rp-progress" slot="after"><span>Snapshot file</span><span class="rp-progress-bar"><span data-bar></span></span><span data-bar-text>0%</span></div>
  <p slot="after" class="rp-key">✓ already written to the snapshot file. <span class="rp-key-outline">Outlined</span>: the page the child is writing now.</p>
  <p slot="after" class="rp-status" data-status aria-live="polite"></p>
  <Fragment slot="text">
    <p>Before a snapshot, Redis’s memory belongs to Redis alone. At the start of a snapshot Redis forks. For a moment the main thread stops while the operating system copies the process's page tables; after that the child process sees exactly the memory Redis had at that instant, and walks through it writing the snapshot file. Redis carries on serving clients. Every page the parent writes to while the child is still running is copied first, so that the child keeps the old version: the page now exists twice.</p>
    <p>With five writes a second landing anywhere in memory, about 70% of the 48 pages are copied by the time the 12-second snapshot finishes, so memory use grows by about 70% of the dataset. With writes landing on a few hot keys, only those four pages are copied, about 8%. With 15 writes a second spread out, nearly every page is copied. When the child exits, the old copies are freed.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { cellGrid } from '../shared/grid.mjs';
  import { create, PAGES } from './cow-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="rp-cow"]').forEach(root => {
    const grid = cellGrid(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Redis memory as 48 pages; copied pages are marked', cell: { width: 44, height: 26, gap: 4 }, maxColumns: 12, minColumns: 6,
    });
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const barText = root.querySelector<HTMLElement>('[data-bar-text]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const start = (model: any) => { model.bgsave(); };
    mountSim(root, {
      seed: 3,
      create: params => { const m: any = create({ spread: params.spread, rate: params.rate }, 3); m.sim.after(1500, () => m.bgsave()); return m; },
      update: (model: any, params) => { model.params.spread = params.spread; model.params.rate = params.rate; return true; },
      actions: { bgsave: start },
      render(model: any) {
        const saving = model.phase === 'saving' || model.phase === 'forking';
        const childAt = model.phase === 'saving' ? Math.min(PAGES - 1, Math.floor(model.progress() * PAGES)) : -1;
        // Pages are shared only while a child exists; before the fork and after it exits they are Redis's alone.
        grid.render(model.pages.map((pg: any, i: number) => !saving
          ? { kind: 'neutral', fill: 'tint' }
          : pg.copied
            ? { kind: 'write', fill: 'solid', mark: true, highlight: i === childAt }
            : { kind: 'redis', fill: 'tint', text: pg.saved ? '✓' : '', highlight: i === childAt }));
        const progress = model.progress();
        bar.style.width = `${(100 * progress).toFixed(1)}%`;
        barText.textContent = `${Math.round(100 * progress)}%`;
        const copied = model.copied();
        setReadouts(root, {
          phase: model.phase === 'forking' ? 'forking' : model.phase === 'saving' ? 'writing' : model.phase === 'done' ? 'exited' : 'none',
          progress: `${Math.round(100 * progress)}%`,
          extra: `${Math.round((100 * copied) / PAGES)}%`,
        });
        if (model.phase === 'forking') status.textContent = 'Forking: the main thread is paused while the page tables are copied.';
        else if (saving) status.textContent = `The child is writing page ${childAt + 1} of ${PAGES} (outlined); ${copied} pages have been copied so far.`;
        else if (model.phase === 'done') status.textContent = `Snapshot finished. At its end ${model.peakCopied} of ${PAGES} pages had been copied: ${Math.round((100 * model.peakCopied) / PAGES)}% extra memory, now freed.`;
        else status.textContent = 'No snapshot running.';
      },
    });
  });
</script>
