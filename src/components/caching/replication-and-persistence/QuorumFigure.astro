---
// Figure: quorum decides detection; a majority decides whether a failover can happen.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import './repl.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="rp-quorum" title="Quorum and majority" controls="none" size="text"
  legend={[{ kind: 'neutral', label: 'Sentinel that can vote' }, { kind: 'error', label: 'Sentinel down or cut off' }]}
  caption="The rules as the Redis Sentinel documentation states them. A Sentinel that is cut off by a network partition counts as lost to the side doing the failover.">
  <Slider slot="params" name="n" label="Sentinels" min={2} max={7} value={3} />
  <Slider slot="params" name="quorum" label="Quorum" min={1} max={7} value={2} />
  <Slider slot="params" name="lost" label="Lost" min={0} max={7} value={1} />
  <div data-grid></div>
  <p slot="after" class="rp-verdict" data-detect aria-live="polite"></p>
  <p slot="after" class="rp-verdict" data-failover aria-live="polite"></p>
  <Fragment slot="text">
    <p>For the primary to be marked objectively down, at least quorum Sentinels must each have lost contact with it. For a failover to start, one Sentinel must also be elected leader by a majority of all the Sentinels configured, or by quorum of them if quorum is larger.</p>
    <p>With three Sentinels and a quorum of 2, losing one still allows a failover (two of three is a majority); losing two does not. With two Sentinels and a quorum of 1, a single Sentinel can notice the failure but can never fail over alone, because a majority of two is two. Five Sentinels survive the loss of two.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams } from '../shared/player.mjs';
  import { cellGrid } from '../shared/grid.mjs';
  import { sentinelPower } from './quorum-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="rp-quorum"]').forEach(root => {
    const grid = cellGrid(root.querySelector<HTMLElement>('[data-grid]')!, { label: 'Sentinels, with lost ones crossed out', cell: { width: 52, height: 34, gap: 8 }, maxColumns: 7 });
    const detect = root.querySelector<HTMLElement>('[data-detect]')!;
    const failover = root.querySelector<HTMLElement>('[data-failover]')!;
    const inputs = Object.fromEntries(['n', 'quorum', 'lost'].map(name => [name, root.querySelector<HTMLInputElement>(`[data-param="${name}"]`)!]));
    bindParams(root, params => {
      const n = params.n;
      // Quorum and losses cannot exceed the number of Sentinels.
      for (const name of ['quorum', 'lost']) {
        inputs[name].max = String(n);
        if (Number(inputs[name].value) > n) { inputs[name].value = String(n); inputs[name].dispatchEvent(new Event('input')); return; }
      }
      const s = sentinelPower({ n, quorum: params.quorum, lost: params.lost });
      grid.render(Array.from({ length: n }, (_, i) => i < n - params.lost ? { kind: 'neutral', fill: 'tint', text: `S${i + 1}` } : { kind: 'error', fill: 'dashed', mark: true }));
      detect.dataset.cacheKind = s.detect ? 'hit' : 'error';
      detect.innerHTML = `<strong>${s.detect ? 'Can' : 'Cannot'} mark the primary down.</strong> ${s.alive} of ${n} Sentinels can see that it has gone; the quorum is ${params.quorum}.`;
      failover.dataset.cacheKind = s.failover ? 'hit' : 'error';
      failover.innerHTML = `<strong>${s.failover ? 'Can' : 'Cannot'} fail over.</strong> Electing a leader needs ${s.needed} votes (${s.needed === s.majority ? `a majority of ${n}` : `the quorum, which is more than a majority of ${n}`}); ${s.alive} ${s.alive === 1 ? 'Sentinel is' : 'Sentinels are'} left.`;
    });
  });
</script>
