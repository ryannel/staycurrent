---
// Figure: Redis restarts empty, and the database takes the misses.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import ActionButton from '../shared/ActionButton.astro';
import './repl.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="rp-restart" title="Redis restarts empty" legend={[{ kind: 'database', label: 'Database reads a second' }]} advance={10000}
  caption="Illustrative model, not a measurement: 2,000 requests a second over 50,000 products with Zipf popularity (s = 0.9), cache-aside, every copy stored for the chosen TTL. It computes the expected reads a second; the database does not slow down under load in this model, and Redis restarts at once. Time runs ten times faster than real time at 1×.">
  <Slider slot="params" name="ttl" label="Copies live for" value={600} stops={[120, 300, 600, 1800]} labels={{ 120: '2 minutes', 300: '5 minutes', 600: '10 minutes', 1800: '30 minutes' }} />
  <ActionButton slot="actions" name="restart">Restart Redis</ActionButton>
  <Fragment slot="stats">
    <Readout name="hit" label="Hit ratio, last second" kind="hit" />
    <Readout name="reads" label="Database reads a second" kind="database" />
    <Readout name="times" label="Times normal load" kind="error" />
  </Fragment>
  <div slot="after" class="rp-chart" data-chart></div>
  <p slot="after" class="rp-status" data-status aria-live="polite"></p>
  <Fragment slot="text">
    <p>Before the restart, with copies kept for 10 minutes, the cache hits about 96.4% of requests and the database receives about 73 reads a second. Pressing Restart Redis empties the cache. In the first second the database receives about 1,330 reads, 18 times its normal load; after 10 seconds about 660; after a minute about 240, still more than three times normal. It falls below normal after about two and a half minutes, because every popular key has just been refilled, and ten minutes after the restart a second wave of about 260 reads a second arrives as those copies, stored together, expire together.</p>
    <p>Changing how long copies live changes the normal load (about 250 reads a second at 2 minutes, 26 at 30 minutes) but not the spike, which is the same 1,330 reads in the first second in every case. So the better the cache works, the larger the restart is as a multiple of what the database normally sees: about 5 times at 2 minutes and about 50 times at 30 minutes.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { create } from './restart-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="rp-restart"]').forEach(root => {
    const chart = lineChart(root.querySelector<HTMLElement>('[data-chart]')!, {
      label: 'Database reads a second over the last twelve and a half minutes', height: 220,
      x: { label: 'Simulated time (seconds)', window: 750 },
      y: { label: 'Reads a second', domain: [0, 1500] },
      series: [{ id: 'reads', label: 'Database reads a second', kind: 'database' }],
    });
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    let current: any = null;
    mountSim(root, {
      seed: 1, timeScale: 10,
      create: params => { const m: any = create({ ttl: params.ttl }); m.sim.advance(60000); return m; },
      update: () => false,
      actions: { restart: (model: any, api: any) => { if (!model.fail('empty')) return; chart.mark('restart', model.sim.now / 1000, 'Redis restarted, empty', 'redis'); if (!api.playing) api.play(); } },
      render(model: any) {
        if (model !== current) { current = model; chart.clear(); chart.mark('restart', null); }
        const pts = model.samples;
        for (let i = (model.drawn ?? 0); i < pts.length; i++) chart.push('reads', pts[i][0], pts[i][1]);
        model.drawn = pts.length;
        chart.render();
        const times = model.reads / model.normal;
        setReadouts(root, {
          hit: `${(100 * model.hitRatio).toFixed(1)}%`,
          reads: Math.round(model.reads).toLocaleString('en-GB'),
          times: `${times.toFixed(times < 10 ? 1 : 0)}×`,
        });
        if (!model.recovery) status.textContent = `Normal load: about ${Math.round(model.normal)} reads a second. Press Restart Redis when you are ready.`;
        else {
          const since = model.sim.now / 1000 - model.events[0].t;
          status.textContent = `${Math.round(since)} s since the restart. Peak so far ${Math.round(Math.max(...pts.filter((p: number[]) => p[0] > model.events[0].t).map((p: number[]) => p[1]), 0)).toLocaleString('en-GB')} reads a second against a normal ${Math.round(model.normal)}.`;
        }
      },
    });
  });
</script>
