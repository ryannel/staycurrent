---
// Figure: a Sentinel failover, in real time.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import ActionButton from '../shared/ActionButton.astro';
import './repl.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="rp-sentinel" title="A Sentinel failover" legend={[{ kind: 'client', label: 'Request or Sentinel ping' }, { kind: 'hit', label: 'Answered' }, { kind: 'error', label: 'Failed or unanswered' }]} advance={5000}
  caption="Runs in real time at 1×. The steps after detection use the delays I measured in two failovers on Redis 8.10.3 on my laptop (objectively down 0.1 s after the first Sentinel noticed, replica promoted 1.1 s after, clients back 1.15 s after); the clients send ten requests a second and ask Sentinel for the primary's address after each failure. Network partitions, slow replicas and clients that cache the old address are left out.">
  <Slider slot="params" name="downAfter" label="down-after-milliseconds" value={30000} stops={[5000, 10000, 30000]} labels={{ 5000: '5 seconds', 10000: '10 seconds', 30000: '30 seconds (default)' }} />
  <ActionButton slot="actions" name="kill">Kill the primary</ActionButton>
  <Fragment slot="stats">
    <Readout name="silent" label="Primary silent for" kind="error" />
    <Readout name="failed" label="Requests failed" kind="error" />
    <Readout name="phase" label="Sentinels" />
  </Fragment>
  <div slot="after" class="rp-chart" data-chart></div>
  <p slot="after" class="rp-status" data-status aria-live="polite"></p>
  <Fragment slot="text">
    <p>Three Sentinels watch a primary with two replicas, each pinging it once a second, and the clients send their requests to the primary. Pressing Kill the primary stops it. Every request and every ping then fails, and nothing else happens for the whole of down-after-milliseconds, 30 seconds by default: each Sentinel waits that long without a valid reply before it marks the primary subjectively down. Within about a tenth of a second, two Sentinels agree (the quorum), and the primary is objectively down. The Sentinels elect a leader, which promotes the first replica about a second later. The clients ask Sentinel for the primary's address, get the replica's, and succeed again; shortly after, the other replica is pointed at the new primary.</p>
    <p>With the default setting the clients fail for about 31 seconds, which is what I measured. With 5 seconds they fail for about 6.3 seconds.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { createScene, spread } from '../shared/scene.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { create, outageSeconds } from './sentinel-model.mjs';

  const STATE_TEXT: Record<string, string> = { watching: 'watching', sdown: 'sees it down', odown: 'agreed: down', leader: 'leader', voted: 'voted' };
  const PHASE_TEXT: Record<string, string> = { healthy: 'watching', dead: 'waiting', odown: 'agreed it is down', electing: 'electing a leader', promoted: 'replica promoted', clients: 'reconfiguring', done: 'failover complete' };

  document.querySelectorAll<HTMLElement>('[data-figure-id="rp-sentinel"]').forEach(root => {
    const scene = createScene(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Three Sentinels watch a primary with two replicas; clients send requests to the primary',
      nodes: [
        { id: 's1', kind: 'neutral', label: 'Sentinel 1' },
        { id: 's2', kind: 'neutral', label: 'Sentinel 2' },
        { id: 's3', kind: 'neutral', label: 'Sentinel 3' },
        { id: 'clients', kind: 'client', label: 'Clients', count: 3 },
        { id: 'p', kind: 'redis', label: 'Redis A' },
        { id: 'r1', kind: 'redis', label: 'Redis B' },
        { id: 'r2', kind: 'redis', label: 'Redis C' },
      ],
      edges: [
        { id: 'clients-p', from: 'clients', to: 'p' },
        { id: 'clients-r1', from: 'clients', to: 'r1', dashed: true },
        { id: 'p-r1', from: 'p', to: 'r1', dashed: true },
        { id: 'p-r2', from: 'p', to: 'r2', dashed: true },
        { id: 's1-p', from: 's1', to: 'p', dashed: true },
        { id: 's2-p', from: 's2', to: 'p', dashed: true },
        { id: 's3-p', from: 's3', to: 'p', dashed: true },
      ],
      layout: (width, compact) => {
        if (compact) {
          const xs = spread(width, 3, 52);
          return { height: 400, positions: { s1: [xs[0], 50], s2: [xs[1], 50], s3: [xs[2], 50], p: [xs[1], 175], clients: [xs[0], 300], r1: [xs[1], 320], r2: [xs[2], 300] } };
        }
        const xs = spread(width, 4, 80);
        const ss = spread(width, 3, 140);
        return { height: 320, positions: { s1: [ss[0], 50], s2: [ss[1], 50], s3: [ss[2], 50], clients: [xs[0], 200], p: [xs[1], 160], r1: [xs[2], 245], r2: [xs[3], 160] } };
      },
    });
    const chart = lineChart(root.querySelector<HTMLElement>('[data-chart]')!, {
      label: 'Requests a second that succeed and that fail, over the last minute', height: 200,
      x: { label: 'Seconds', window: 60 },
      y: { label: 'Requests a second', domain: [0, 24] },
      series: [{ id: 'ok', label: 'Succeeded', kind: 'hit' }, { id: 'failed', label: 'Failed', kind: 'error' }],
    });
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    let current: any = null;
    mountSim(root, {
      seed: 3, timeScale: 1,
      create: params => { const m: any = create({ downAfter: params.downAfter }, 3); m.sim.advance(15000); return m; },
      update: (model: any, params) => { if (model.killedAt !== null) return false; model.params.downAfter = params.downAfter; return true; },
      actions: { kill: (model: any, api: any) => { model.kill(); if (!api.playing) api.play(); } },
      render(model: any) {
        if (model !== current) { current = model; chart.clear(); for (const id of ['kill', 'sdown', 'odown', 'promoted']) chart.mark(id, null); }
        for (let i = model.drawn ?? 0; i < model.samples.length; i++) {
          const [t, ok, failed] = model.samples[i];
          chart.push('ok', t, ok); chart.push('failed', t, failed);
        }
        model.drawn = model.samples.length;
        for (const m of model.marks) chart.mark(m.type, m.t, m.label, m.type === 'promoted' ? 'redis' : 'error');
        chart.render();
        scene.dots(model.movers.active());
        for (const s of model.sentinels) scene.node(s.id).set({ sublabel: STATE_TEXT[s.state], highlight: s.state === 'leader' });
        const roleText = (id: string) => model.roles[id] === 'down' ? 'down' : model.roles[id];
        for (const id of ['p', 'r1', 'r2']) scene.node(id).set({ sublabel: roleText(id), badge: model.roles[id] === 'down' ? '✕' : '', badgeKind: 'error' });
        const silent = model.silentFor();
        setReadouts(root, {
          silent: silent === null ? '–' : `${silent.toFixed(1)} s`,
          failed: model.totals.failed.toLocaleString('en-GB'),
          phase: PHASE_TEXT[model.phase],
        });
        const wait = model.params.downAfter / 1000;
        if (silent === null) status.textContent = `Redis A is the primary. Each Sentinel will wait ${wait} seconds without a valid reply before it decides the primary is down. Press Kill the primary.`;
        else if (model.phase === 'dead') status.textContent = `Redis A has been silent for ${Math.floor(silent)} s. Every request fails; the Sentinels keep waiting until ${wait} s have passed.`;
        else if (model.phase !== 'done' && model.clientsOn === 'p') status.textContent = `The Sentinels agree the primary is down and are failing over. Requests are still failing.`;
        else status.textContent = `Redis B is the primary now${model.roles.r2 === 'replica of Redis B' ? ', and Redis C replicates from it' : ''}. The clients failed for about ${outageSeconds(model.params.downAfter).toFixed(1)} s.`;
      },
    });
  });
</script>
