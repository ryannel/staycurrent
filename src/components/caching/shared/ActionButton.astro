---
// A one-off action in a figure's controls bar, such as "Skip ahead 5 minutes" or
// "Restart Redis". Put it in <SimFigure slot="actions">.
//
//   advance  model time to skip, in the model's own unit; mountSim() pauses and advances.
//   name     an action for mountSim({ actions: { [name]: (model, api) => … } }).
//   label    an accessible name when the visible text is not enough.
// In a stepped or clockless figure, bind the click yourself: [data-cache-action="name"].
interface Props { name?: string; advance?: number; label?: string }
const { name, advance, label } = Astro.props;
---
<button type="button" class="cache-button cache-action" data-cache-action={name ?? 'advance'} data-cache-advance={advance} aria-label={label}><slot /></button>
