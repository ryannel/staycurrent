---
// A labelled set of options (radio buttons styled as a segmented control) for
// <SimFigure slot="params">. mountSim() reads the checked value as params[name].
interface Props { name: string; label: string; options: { value: string; label: string }[]; value: string }
const { name, label, options, value } = Astro.props;
const group = `${name}-${Math.random().toString(36).slice(2, 8)}`;
---
<fieldset class="cache-choice">
  <legend class="cache-param-label">{label}</legend>
  <div class="cache-segments">{options.map(option => <label><input type="radio" name={group} value={option.value} checked={option.value === value} data-param={name} /><span>{option.label}</span></label>)}</div>
</fieldset>
