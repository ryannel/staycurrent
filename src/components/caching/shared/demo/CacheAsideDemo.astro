---
// Test bench: a live cache-aside simulation built from the shared toolkit.
import SimFigure from '../SimFigure.astro';
import Slider from '../Slider.astro';
import Readout from '../Readout.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="bench-cache-aside" title="Cache-aside with a small cache" legend={['client', 'hit', 'miss', 'write']} advance={1000}
  caption="Illustrative model: 100 keys with Zipf popularity (s = 1), three requests a second, least-recently-used eviction. Travel times are slowed for watching; nothing here is measured.">
  <Slider slot="params" name="capacity" label="Redis holds" min={0} max={100} step={5} value={20} unit="keys" />
  <Fragment slot="stats">
    <Readout name="requests" label="Requests" value="0" />
    <Readout name="ratio" label="Hit ratio, last 200" value="–" kind="hit" />
    <Readout name="reads" label="Database reads a second" value="0" kind="database" />
  </Fragment>
  <Fragment slot="text">
    <p>Requests travel from the clients to the application, which asks Redis for the key. A hit returns straight away. A miss goes on to the database, and the application stores the value in Redis on the way back. With room for 20 of the 100 keys, a little over half the requests are hits (about 57% over a long run), because the most popular keys receive most requests. With 50 keys the hit ratio is about 82%; at 100 keys every request is a hit and the database receives no reads.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../player.mjs';
  import { createScene, spread } from '../scene.mjs';
  import { cacheAside, updateCacheAside } from './cache-aside-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="bench-cache-aside"]').forEach(root => {
    const scene = createScene(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Clients send requests to an application, which reads Redis and, on a miss, the database.',
      nodes: [
        { id: 'clients', kind: 'client', label: 'Clients', count: 3 },
        { id: 'app', kind: 'app', label: 'Application' },
        { id: 'redis', kind: 'redis', label: 'Redis' },
        { id: 'database', kind: 'database', label: 'Database' },
      ],
      edges: [
        { id: 'client-app', from: 'clients', to: 'app' },
        { id: 'app-redis', from: 'app', to: 'redis' },
        { id: 'app-database', from: 'app', to: 'database' },
      ],
      layout: (width, compact) => {
        const [left, middle, right] = spread(width, 3, compact ? 40 : 90);
        return { height: compact ? 250 : 240, positions: { clients: [left, compact ? 125 : 120], app: [middle, compact ? 125 : 120], redis: [right, compact ? 62 : 58], database: [right, compact ? 190 : 180] } };
      },
    });
    mountSim(root, {
      seed: 7,
      create: (params, seed) => cacheAside({ ...params, keys: 100, rate: 3 }, seed),
      update: updateCacheAside,
      render(model: any) {
        scene.dots(model.movers.active());
        const reads = model.databaseWindow.rate(model.sim.now);
        scene.node('redis').set({ badge: `${model.cache.size}/${model.params.capacity} keys` });
        scene.node('database').set({ meter: reads / 3, meterKind: 'database', sublabel: `${reads.toFixed(1)} reads/s` });
        setReadouts(root, {
          requests: model.stats.requests.toLocaleString('en-GB'),
          ratio: model.recent.count ? `${Math.round(model.recent.value * 100)}%` : '–',
          reads: reads.toFixed(1),
        });
      },
    });
  });
</script>
