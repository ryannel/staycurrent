---
// Test bench: threadTimeline, a microsecond clock (timeUnit and timeScale),
// Poisson arrivals in microseconds, and ActionButtons in the controls bar.
import SimFigure from '../SimFigure.astro';
import ActionButton from '../ActionButton.astro';
import Readout from '../Readout.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="bench-timeline" title="One thread, one slow command" timeUnit="us" advance={100} legend={[{ kind: 'redis', label: 'GET' }, { kind: 'error', label: 'Slow command' }, { kind: 'client', label: 'Client waiting' }]}
  caption="Illustrative model in microseconds, shown about ten thousand times slower than real time: GETs arrive at random, 50,000 a second, and each takes 8 µs of the main thread. The slow command takes 300 µs. Network time is left out.">
  <ActionButton slot="actions" name="slow">Run a slow command</ActionButton>
  <ActionButton slot="actions" advance={1000}>Skip ahead 1 ms</ActionButton>
  <Fragment slot="stats">
    <Readout name="done" label="Commands finished" value="0" kind="redis" />
    <Readout name="wait" label="Longest wait" value="0 µs" kind="client" />
  </Fragment>
  <Fragment slot="text">
    <p>Each GET occupies the main thread for 8 µs, so at 50,000 a second the thread is busy about 40% of the time and most requests start at once. A 300 µs command holds the thread for its whole duration: about 15 GETs arrive meanwhile and wait, the first for nearly the full 300 µs.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../player.mjs';
  import { threadTimeline } from '../timeline.mjs';
  import { formatDuration } from '../sim.mjs';
  import { eventLoop } from './timeline-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="bench-timeline"]').forEach(root => {
    const timeline = threadTimeline(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Timeline of the Redis main thread and waiting clients',
      lanes: [{ id: 'main', label: 'Main thread', short: 'Main' }, { id: 'clients', label: 'Clients waiting', short: 'Waiting' }],
      format: (v: number) => formatDuration(v, 'us'), axisLabel: 'Simulated time', tickStep: 100,
    });
    const span = 400;
    mountSim(root, {
      seed: 2,
      timeScale: 0.1,
      create: (_params: any, seed: number) => eventLoop({}, seed),
      actions: { slow: (model: any) => model.runSlow() },
      render(model: any) {
        const now = model.sim.now;
        const from = Math.max(0, now - span), to = Math.max(span, now);
        timeline.render({ from, to, now, blocks: model.blocks, spans: model.spans });
        setReadouts(root, { done: model.done.toLocaleString('en-GB'), wait: formatDuration(Math.round(model.longestWait), 'us') });
      },
    });
  });
</script>
