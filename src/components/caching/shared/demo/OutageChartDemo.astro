---
// Test bench: lineChart bands, event markers, chosen tick intervals and a log
// axis, with a Slider over uneven stops with custom labels.
import SimFigure from '../SimFigure.astro';
import Slider from '../Slider.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="bench-outage" title="Database load through a Redis outage" controls="none"
  caption="Illustrative curve, not a simulation: 200 requests a second with a 80% hit ratio, all reaching the database while Redis is down, and an empty cache refilling afterwards. The lower chart shows the same numbers on a logarithmic scale.">
  <Slider slot="params" name="outage" label="Redis is down for" value={60} stops={[10, 30, 60, 120]} labels={{ 10: '10 seconds', 30: '30 seconds', 60: 'a minute', 120: 'two minutes' }} />
  <div slot="after" data-log></div>
  <Fragment slot="text">
    <p>Before the outage the database receives about 40 reads a second. While Redis is down, every request reaches the database: 200 a second. When Redis returns it is empty, so reads fall back towards 40 over the next minute as popular keys are cached again. The log scale shows the slow tail of that recovery more clearly.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams } from '../player.mjs';
  import { lineChart } from '../chart.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="bench-outage"]').forEach(root => {
    const common = {
      height: 220,
      x: { label: 'Time (s)', domain: [0, 300], tickStep: 60 },
      series: [{ id: 'reads', label: 'Database reads a second', kind: 'database' }],
    };
    const linear = lineChart(root.querySelector<HTMLElement>('[data-scene]')!, {
      ...common, label: 'Database reads a second before, during and after a Redis outage',
      y: { label: 'Database reads a second', domain: [0, 250] },
      markers: [{ id: 'alert', x: 55, label: 'Alert fires', kind: 'error' }],
    });
    const log = lineChart(root.querySelector<HTMLElement>('[data-log]')!, {
      ...common, label: 'The same database reads on a logarithmic scale',
      y: { label: 'Reads a second (log scale)', scale: 'log', domain: [10, 1000] },
    });
    bindParams(root, ({ outage }) => {
      const start = 50, end = start + outage;
      const points: [number, number][] = [];
      for (let t = 0; t <= 300; t += 1) {
        const v = t < start ? 40 : t < end ? 200 : 40 + 160 * Math.exp(-(t - end) / 15);
        points.push([t, v]);
      }
      for (const chart of [linear, log]) {
        chart.set('reads', points);
        chart.band('outage', start, end, 'Redis down', 'error');
        chart.mark('back', end, 'Redis back, empty', 'redis');
        chart.render();
      }
    });
  });
</script>
