---
// Test bench: a stepped two-request race in the sequence renderer.
import SimFigure from '../SimFigure.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="bench-race" title="A slow reader puts back a stale value" controls="steps"
  caption="A sequence of steps, not a timed simulation. The pause could be a garbage-collection pause or a slow network; any delay between the database read and the cache write opens the same window.">
  <Fragment slot="text">
    <ol>
      <li>Redis has no copy of user:42; the database holds v1.</li>
      <li>The reader asks Redis for user:42 and misses.</li>
      <li>The reader reads v1 from the database.</li>
      <li>The reader pauses before writing to Redis.</li>
      <li>The writer updates the database to v2.</li>
      <li>The writer deletes user:42 from Redis, which has no copy yet.</li>
      <li>The reader resumes and stores v1 in Redis.</li>
      <li>Redis now serves v1, which is stale, until the key expires or is deleted again.</li>
    </ol>
  </Fragment>
</SimFigure>
<script>
  import { sequenceFigure } from '../sequence.mjs';
  document.querySelectorAll<HTMLElement>('[data-figure-id="bench-race"]').forEach(root => {
    sequenceFigure(root, {
      label: 'Sequence diagram of a reader and a writer racing on one cache key',
      intro: 'Redis has no copy of user:42. The database holds version v1.',
      lanes: [
        { id: 'reader', label: 'Reader', kind: 'client' },
        { id: 'writer', label: 'Writer', kind: 'write' },
        { id: 'redis', label: 'Redis', kind: 'redis' },
        { id: 'db', label: 'Database', kind: 'database' },
      ],
      initial: { redis: 'empty', db: 'v1' },
      steps: [
        { from: 'reader', to: 'redis', label: 'GET', kind: 'miss', explanation: 'The reader asks Redis for user:42. Redis has no copy, so this is a miss.' },
        { from: 'db', to: 'reader', label: 'v1', kind: 'database', state: { reader: 'v1' }, explanation: 'The reader reads the row from the database and receives v1.' },
        { at: 'reader', note: 'paused', kind: 'neutral', explanation: 'Before it can store v1 in Redis, the reader pauses.' },
        { from: 'writer', to: 'db', label: 'UPDATE', kind: 'write', state: { db: 'v2' }, explanation: 'Meanwhile the writer updates the row. The database now holds v2.' },
        { from: 'writer', to: 'redis', label: 'DEL', kind: 'write', state: { redis: 'empty' }, explanation: 'The writer deletes user:42 from Redis. There is nothing to delete yet.' },
        { from: 'reader', to: 'redis', label: 'SET v1', kind: 'stale', state: { redis: 'v1 stale' }, explanation: 'The reader resumes and stores the v1 it read earlier. Redis now holds an older value than the database.' },
        { at: 'redis', note: 'stale until expiry', kind: 'stale', explanation: 'Every later read is a hit that returns v1, until the key expires or another write deletes it.' },
      ],
    });
  });
</script>
