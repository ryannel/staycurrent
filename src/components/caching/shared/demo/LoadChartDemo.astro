---
// Test bench: a live line chart fed by a model that runs without animation.
import SimFigure from '../SimFigure.astro';
import Slider from '../Slider.astro';
import Readout from '../Readout.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="bench-load-chart" title="Database load while a cold cache warms up" advance={5000}
  caption="Illustrative model: 200 requests a second over 10,000 keys with Zipf popularity (s = 0.9). The cache starts empty. The dashed line is an assumed database capacity, not a measurement.">
  <Slider slot="params" name="capacity" label="Redis holds" min={0} max={5000} step={250} value={1000} unit="keys" />
  <Fragment slot="stats">
    <Readout name="ratio" label="Hit ratio, last 200" value="–" kind="hit" />
    <Readout name="reads" label="Database reads a second" value="0" kind="database" />
  </Fragment>
  <Fragment slot="text">
    <p>In the first second the database receives about 150 reads, above its assumed capacity of 120, because the empty cache misses on almost every key. As popular keys arrive in the cache, database reads fall below that line within a few seconds and settle near 85 a second with room for 1,000 keys. With 5,000 keys they settle near 40; with no cache the database receives all 200.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../player.mjs';
  import { lineChart } from '../chart.mjs';
  import { cacheAside, updateCacheAside } from './cache-aside-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="bench-load-chart"]').forEach(root => {
    const chart = lineChart(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Database reads per second over time',
      height: 220,
      x: { label: 'Simulated time (s)', window: 60 },
      y: { label: 'Database reads a second', domain: [0, 250] },
      series: [{ id: 'reads', label: 'Database reads a second', kind: 'database' }],
      rules: [{ y: 120, label: 'Assumed database capacity', kind: 'error' }],
    });
    let shown: any = null;
    let drawn = 0;
    mountSim(root, {
      seed: 3,
      create: (params, seed) => cacheAside({ ...params, keys: 10000, skew: 0.9, rate: 200, warm: false, animate: false }, seed),
      update: updateCacheAside,
      render(model: any) {
        if (model !== shown) { shown = model; drawn = 0; chart.clear(); }
        for (; drawn < model.samples.length; drawn++) chart.push('reads', model.samples[drawn].t, model.samples[drawn].databaseReads);
        chart.render();
        const last = model.samples.at(-1);
        setReadouts(root, { ratio: model.recent.count ? `${Math.round(model.recent.value * 100)}%` : '–', reads: last ? String(last.databaseReads) : '0' });
      },
    });
  });
</script>
