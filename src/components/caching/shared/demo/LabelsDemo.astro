---
// Test bench: histogram marker labels that would collide, and the barChart label
// positions, chosen with a Choice.
import SimFigure from '../SimFigure.astro';
import Choice from '../Choice.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="bench-labels" title="Close markers and bar labels" controls="none"
  caption="Illustrative numbers. Four percentile markers sit within a few milliseconds of each other; their labels take extra rows rather than overlapping.">
  <Choice slot="params" name="labels" label="Bar labels" value="beside" options={[{ value: 'above', label: 'Above' }, { value: 'beside', label: 'Beside' }, { value: 'inside', label: 'Inside' }]} />
  <div slot="after" data-bars></div>
  <Fragment slot="text">
    <p>A latency histogram with most requests between 1 and 3 ms, marked at the median (1.6 ms), mean (1.9 ms), 90th percentile (2.4 ms) and 99th percentile (3.1 ms). Below it, six bars compare mean latencies from 0.2 ms for a local cache to 9 ms for a cross-region database read.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams } from '../player.mjs';
  import { histogram, barChart } from '../chart.mjs';
  import { seededRandom, logNormal } from '../sim.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="bench-labels"]').forEach(root => {
    const hist = histogram(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Histogram of request latency with four close percentile markers', height: 200, kind: 'hit',
      bins: { min: 0, max: 6, count: 60 }, x: { label: 'Latency (ms)' }, y: { label: 'Requests' },
    });
    const random = seededRandom(5);
    hist.set(Array.from({ length: 3000 }, () => logNormal(random, 1.6, 0.25)));
    hist.mark('p50', 1.6, 'p50 1.6 ms');
    hist.mark('mean', 1.9, 'mean 1.9 ms');
    hist.mark('p90', 2.4, 'p90 2.4 ms');
    hist.mark('p99', 3.1, 'p99 3.1 ms');
    const bars = [
      { id: 'local', label: 'In-process cache', kind: 'hit' },
      { id: 'redis', label: 'Redis, same zone', kind: 'redis' },
      { id: 'redisx', label: 'Redis, other zone', kind: 'redis' },
      { id: 'db', label: 'Database, indexed', kind: 'database' },
      { id: 'scan', label: 'Database, scan', kind: 'database' },
      { id: 'region', label: 'Cross-region read', kind: 'miss' },
    ];
    const values = { local: 0.2, redis: 0.5, redisx: 1.2, db: 2.5, scan: 6, region: 9 };
    bindParams(root, ({ labels }) => {
      const chart = barChart(root.querySelector<HTMLElement>('[data-bars]')!, {
        label: 'Mean latency of six ways to read a value', bars, labels,
        x: { label: 'Milliseconds', domain: [0, 10], format: (v: number) => `${v} ms` },
      });
      chart.set(values);
    });
  });
</script>
