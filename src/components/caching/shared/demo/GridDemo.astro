---
// Test bench: cellGrid with text cells, row labels and shape marks, and a
// second grid of small cells; a Slider with custom labels drives both.
import SimFigure from '../SimFigure.astro';
import Slider from '../Slider.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="bench-grid" title="Keys in a small Redis" controls="none" legend={['redis', 'expiry']}
  caption="Illustrative: 24 slots of a tiny cache. Keys past their TTL stay in memory until Redis notices them; they are drawn dashed with the expiry ring.">
  <Slider slot="params" name="stored" label="Keys stored" min={0} max={24} step={4} value={16} unit="keys" labels={{ 0: 'none', 24: '24 (full)' }} />
  <div slot="after" data-pages></div>
  <Fragment slot="text">
    <p>Each cell is a slot that can hold one key. Stored keys are filled; every fifth one has expired but is still held in memory. Below, 160 small cells stand for memory pages, filled in proportion to the keys stored.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams } from '../player.mjs';
  import { cellGrid } from '../grid.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="bench-grid"]').forEach(root => {
    const keys = cellGrid(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Grid of 24 cache slots', cell: { width: 64, height: 26, gap: 4 }, maxColumns: 6,
      rowLabel: (row: number, columns: number) => `slots ${row * columns + 1}–${row * columns + columns}`, labelWidth: 84,
    });
    const pages = cellGrid(root.querySelector<HTMLElement>('[data-pages]')!, { label: 'Grid of 160 memory pages', cell: { width: 12, gap: 2 }, maxColumns: 40 });
    bindParams(root, ({ stored }) => {
      keys.render(Array.from({ length: 24 }, (_, i) => i >= stored ? { fill: 'empty' }
        : i % 5 === 4 ? { kind: 'expiry', fill: 'dashed', text: `user:${i + 1}`, mark: true }
        : { kind: 'redis', fill: 'tint', text: `user:${i + 1}`, highlight: i === stored - 1 }));
      const used = Math.round(stored / 24 * 160);
      pages.render(Array.from({ length: 160 }, (_, i) => (i < used ? { kind: 'redis', fill: 'solid' } : { fill: 'empty' })));
    });
  });
</script>
