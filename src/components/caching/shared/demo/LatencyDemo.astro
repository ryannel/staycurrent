---
// Test bench: a histogram with percentile markers and a bar comparison, driven
// by one parameter and no clock (controls="none").
import SimFigure from '../SimFigure.astro';
import Slider from '../Slider.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="bench-latency" title="Request latency as a distribution" controls="none"
  caption="Illustrative model: 4,000 requests. A hit costs about 0.7 ms; a miss adds a database read of about 6 ms, with log-normal spread. Values above 30 ms are counted in the last bin.">
  <Slider slot="params" name="hitRatio" label="Hit ratio" min={0} max={1} step={0.05} value={0.8} format="percent" />
  <div slot="after" data-bars></div>
  <Fragment slot="text">
    <p>Hits form a tall peak below 1 ms; misses form a wider hump around 7 ms. At an 80% hit ratio the median request is a hit, under 1 ms, while the 99th percentile is a miss of about 14 ms. The mean, about 2 ms, describes neither group.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams } from '../player.mjs';
  import { histogram, barChart } from '../chart.mjs';
  import { seededRandom, logNormal, quantile } from '../sim.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="bench-latency"]').forEach(root => {
    const hist = histogram(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Histogram of request latency, hits stacked under misses', height: 220,
      series: [{ id: 'hit', label: 'Hits', kind: 'hit' }, { id: 'miss', label: 'Misses', kind: 'miss' }],
      bins: { min: 0, max: 30, count: 60 },
      x: { label: 'Latency (ms)' }, y: { label: 'Requests (square-root scale)', scale: 'sqrt' },
    });
    const bars = barChart(root.querySelector<HTMLElement>('[data-bars]')!, {
      label: 'Mean latency of hits, misses and all requests',
      bars: [{ id: 'hit', label: 'Mean of hits', kind: 'hit' }, { id: 'miss', label: 'Mean of misses', kind: 'miss' }, { id: 'all', label: 'Mean of all requests', kind: 'client' }],
      x: { label: 'Milliseconds', domain: [0, 10], format: (v: number) => `${v.toFixed(1)} ms` },
    });
    bindParams(root, ({ hitRatio }) => {
      const random = seededRandom(11);
      const hits: number[] = [], misses: number[] = [];
      for (let i = 0; i < 4000; i++) {
        const base = logNormal(random, 0.6, 0.3) + 0.1;
        if (random() < hitRatio) hits.push(base); else misses.push(base + logNormal(random, 6, 0.5));
      }
      const all = [...hits, ...misses];
      const mean = (v: number[]) => (v.length ? v.reduce((a, b) => a + b, 0) / v.length : 0);
      hist.set({ hit: hits, miss: misses });
      hist.mark('p50', quantile(all, 0.5), `p50 ${quantile(all, 0.5).toFixed(1)} ms`);
      hist.mark('p99', quantile(all, 0.99), `p99 ${quantile(all, 0.99).toFixed(1)} ms`);
      bars.set({ hit: mean(hits), miss: mean(misses), all: mean(all) });
    });
  });
</script>
