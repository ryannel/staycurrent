---
// Test bench: sequence lanes with long labels, a `short` label for phones, and
// labels that wrap to fit their boxes.
import SimFigure from '../SimFigure.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="bench-lanes" title="Five lanes with long names" controls="steps"
  caption="A sequence of steps, not a timed simulation. It exists to check lane headings at phone width.">
  <Fragment slot="text">
    <ol>
      <li>The application server asks Redis for product:7 and misses.</li>
      <li>It reads the row from the read replica.</li>
      <li>It stores the value in Redis.</li>
      <li>A change arrives through the message relay, which deletes the key.</li>
    </ol>
  </Fragment>
</SimFigure>
<script>
  import { sequenceFigure } from '../sequence.mjs';
  document.querySelectorAll<HTMLElement>('[data-figure-id="bench-lanes"]').forEach(root => {
    sequenceFigure(root, {
      label: 'Sequence diagram with five lanes',
      lanes: [
        { id: 'app', label: 'Application server', short: 'App', kind: 'app' },
        { id: 'redis', label: 'Redis', kind: 'redis' },
        { id: 'replica', label: 'Read replica', kind: 'database' },
        { id: 'primary', label: 'Primary database', kind: 'database' },
        { id: 'relay', label: 'Message relay', kind: 'write' },
      ],
      initial: { redis: 'empty', replica: 'v1', primary: 'v1' },
      steps: [
        { from: 'app', to: 'redis', label: 'GET', kind: 'miss', explanation: 'The application server asks Redis for product:7 and misses.' },
        { from: 'replica', to: 'app', label: 'v1', kind: 'database', explanation: 'It reads the row from the read replica.' },
        { from: 'app', to: 'redis', label: 'SET v1', kind: 'write', state: { redis: 'v1' }, explanation: 'It stores the value in Redis.' },
        { from: 'relay', to: 'redis', label: 'DEL', kind: 'write', state: { redis: 'empty' }, explanation: 'A change arrives through the message relay, which deletes the key.' },
      ],
    });
  });
</script>
