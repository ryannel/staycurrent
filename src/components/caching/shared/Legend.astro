---
// A standalone legend of kinds with their shapes, for a figure built without
// <SimFigure> or a key placed in prose. SimFigure has its own `legend` prop.
import './tokens.css';
import './figure.css';
import { marker, KIND_LABELS } from './shapes.mjs';
interface Props { items: (string | { kind: string; label: string })[] }
const items = Astro.props.items.map(item => (typeof item === 'string' ? { kind: item, label: KIND_LABELS[item as keyof typeof KIND_LABELS] ?? item } : item));
---
<ul class="cache-legend" aria-label="Legend">{items.map(item => <li data-cache-kind={item.kind}><Fragment set:html={marker(item.kind, 11)} />{item.label}</li>)}</ul>
