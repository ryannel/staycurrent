---
// The frame for every caching figure: number and title, optional parameter
// controls, readouts and legend, the scene, a controls bar, a caption, and a
// closed text alternative. See README.md in this folder for the full contract.
//
// controls="live"  Play/Pause, Reset, Speed (and Step forward with `advance`), for mountSim() in player.mjs
// controls="steps" Play, Back, Next, Reset and a step counter, for stepper.mjs / sequenceFigure()
// controls="none"  no controls bar (a static figure, or one driven only by its parameters)
//
// slot="actions" adds one-off buttons (ActionButton.astro) to the live or steps controls bar.
import './tokens.css';
import './figure.css';
import { marker, KIND_LABELS } from './shapes.mjs';
import { formatDuration } from './sim.mjs';

interface Props {
  /** Figure number; numbers run 1, 2, 3 in page order. */
  number: number;
  title: string;
  /** Hook for the figure's script: document.querySelectorAll('[data-figure-id="…"]'). */
  id: string;
  controls?: 'live' | 'steps' | 'none';
  /** Live figures start when first on screen, unless the reader prefers reduced motion. */
  autoplay?: boolean;
  /** Simulated time for a "Step forward" button (live figures), in milliseconds or `timeUnit`. */
  advance?: number;
  /** The unit the model's clock counts: 'ms' (default), 'us' or 's'. Labels `advance` and the clock to match. */
  timeUnit?: 'ms' | 'us' | 's';
  /** Show the simulated clock in the controls bar (live figures). */
  clock?: boolean;
  /** Show the speed slider (live figures). */
  speed?: boolean;
  /** Kinds listed in a legend above the scene, e.g. ['hit', 'miss']; or { kind, label } pairs. */
  legend?: (string | { kind: string; label: string })[];
  /** Width: 'wide' breaks out of the text column on large screens. */
  size?: 'wide' | 'text';
  caption?: string;
}
const { number, title, id, controls = 'live', autoplay = true, advance, timeUnit, clock = true, speed = true, legend = [], size = 'wide', caption } = Astro.props;
const titleId = `${id}-title`;
const items = legend.map(item => (typeof item === 'string' ? { kind: item, label: KIND_LABELS[item as keyof typeof KIND_LABELS] ?? item } : item));
const advanceLabel = advance ? (timeUnit ? formatDuration(advance, timeUnit) : advance >= 1000 ? `${advance / 1000} s` : `${advance} ms`) : '';
---
<figure class:list={['cache-figure', size === 'wide' && 'cache-wide']} data-cache-figure data-figure-id={id} data-figure-name={`figure ${number}`} data-controls={controls} data-autoplay={controls === 'live' && autoplay ? 'true' : 'false'} data-time-unit={timeUnit} aria-labelledby={titleId}>
  <figcaption class="cache-head" id={titleId}><span>Figure {number}</span><strong>{title}</strong></figcaption>
  <div class="cache-panel">
    {Astro.slots.has('params') && <div class="cache-params"><slot name="params" /></div>}
    {(Astro.slots.has('stats') || items.length > 0) && <div class="cache-bar-row">
      {Astro.slots.has('stats') && <dl class="cache-stats"><slot name="stats" /></dl>}
      {items.length > 0 && <ul class="cache-legend" aria-label="Legend">{items.map(item => <li data-cache-kind={item.kind}><Fragment set:html={marker(item.kind, 11)} />{item.label}</li>)}</ul>}
    </div>}
    <div class="cache-scene" data-scene><slot /></div>
    {Astro.slots.has('after') && <div class="cache-after"><slot name="after" /></div>}
    {controls === 'steps' && <p class="cache-explanation" data-explanation data-live aria-live="polite"></p>}
  </div>
  {controls === 'live' && <div class="cache-controls" role="group" aria-label={`Figure ${number} controls`}>
    <button type="button" class="cache-button cache-primary" data-play data-state="paused" aria-label={`Play figure ${number}`}>
      <svg class="cache-icon cache-icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" /></svg>
      <svg class="cache-icon cache-icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" /></svg>
      <span data-play-label>Play</span>
    </button>
    <button type="button" class="cache-button" data-reset>
      <svg class="cache-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 6.2A5 5 0 1 1 3 9.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M2 2.8v4h4z" /></svg>
      <span>Reset</span>
    </button>
    {advance && <button type="button" class="cache-button" data-advance={advance} aria-label={`Step forward ${advanceLabel} of simulated time`}><span>Step {advanceLabel}</span></button>}
    {Astro.slots.has('actions') && <slot name="actions" />}
    {speed && <label class="cache-speed"><span>Speed</span><input type="range" min="0" max="4" step="1" value="2" data-speed /><output data-speed-output>1×</output></label>}
    {clock && <span class="cache-clock" aria-label="Simulated time"><span class="cache-clock-label">Time</span> <span data-clock>0.0 s</span></span>}
  </div>}
  {controls === 'steps' && <div class="cache-controls" role="group" aria-label={`Figure ${number} controls`}>
    <button type="button" class="cache-button cache-primary" data-play>Play</button>
    <button type="button" class="cache-button" data-back aria-disabled="true">Back</button>
    <button type="button" class="cache-button" data-next>Next</button>
    <button type="button" class="cache-button" data-reset>Reset</button>
    {Astro.slots.has('actions') && <slot name="actions" />}
    <span class="cache-step" data-step>1 / 1</span>
    <span class="cache-hold" data-hold aria-hidden="true"><span></span></span>
  </div>}
  {(caption || Astro.slots.has('caption')) && <p class="cache-caption">{caption}<slot name="caption" /></p>}
  <details class="cache-text">
    <summary>What this shows, as text</summary>
    <div class="cache-text-body"><slot name="text" /></div>
  </details>
</figure>
