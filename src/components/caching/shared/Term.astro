---
// An inline noun in prose, coloured to match the figures: <Term kind="hit">hit</Term>.
// `mark` adds the kind's shape before the word, so the link to the figure
// does not depend on colour alone. Use it at a term's first appearance.
import './tokens.css';
import { marker } from './shapes.mjs';
type Kind = 'client' | 'app' | 'redis' | 'database' | 'hit' | 'miss' | 'stale' | 'write' | 'error' | 'expiry';
interface Props { kind: Kind; mark?: boolean }
const { kind, mark = false } = Astro.props;
---
<style is:global>
  .cache-term { color: var(--kind); font-weight: 600; }
  .cache-term .cache-mark { margin: 0 .2em .08em 0; vertical-align: middle; }
  .cache-mark path { fill: currentColor; stroke: currentColor; stroke-width: 0; }
  .cache-mark[data-paint="ring"] path, .cache-mark[data-paint="dashed"] path { fill: none; stroke-width: 2; }
  .cache-mark[data-paint="dashed"] path { stroke-dasharray: 3 2.2; }
  .cache-mark[data-paint="cross"] path { fill: none; stroke-width: 2.4; stroke-linecap: round; }
</style>
<span class="cache-term" data-cache-kind={kind}>{mark && <Fragment set:html={marker(kind, 9)} />}<slot /></span>