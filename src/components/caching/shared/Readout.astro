---
// A live counter for <SimFigure slot="stats">: a label and a value that
// setReadouts(root, { [name]: text }) updates. `kind` colours the value.
interface Props { name: string; label: string; value?: string; kind?: string }
const { name, label, value = '–', kind } = Astro.props;
---
<div class="cache-readout" data-cache-kind={kind}><dt>{label}</dt><dd data-readout={name} aria-live="off">{value}</dd></div>
