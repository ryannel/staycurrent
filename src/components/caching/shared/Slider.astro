---
// A labelled parameter slider for <SimFigure slot="params">. mountSim() reads it
// as params[name] and shows the formatted value in its <output>.
//
// Optional:
//   labels  text for particular values, e.g. { 0: 'off', 1: 'one replica' }; other
//           values use `format` and `unit`. Screen readers hear the same text.
//   stops   uneven values to step through, e.g. [1000, 10000, 100000, 1000000];
//           the slider moves between them and params[name] is the stop. `value`
//           must be one of the stops; `min`, `max` and `step` are then ignored.
import { paramText } from './sim.mjs';
interface Props {
  name: string;
  label: string;
  min?: number;
  max?: number;
  step?: number;
  value: number;
  /** 'number' (with `unit`), 'percent' (0–1 shown as %), 'multiplier' or 'seconds'. */
  format?: 'number' | 'percent' | 'multiplier' | 'seconds';
  unit?: string;
  labels?: Record<string | number, string>;
  stops?: number[];
}
const { name, label, min = 0, max = 100, step = 1, value, format = 'number', unit = '', labels, stops } = Astro.props;
const text = paramText(value, { format, unit, labels });
const index = stops ? Math.max(0, stops.indexOf(value)) : 0;
---
<label class="cache-param">
  <span class="cache-param-label">{label}</span>
  {stops
    ? <input type="range" min={0} max={stops.length - 1} step={1} value={index} data-param={name} data-format={format} data-unit={unit} data-stops={JSON.stringify(stops)} data-labels={labels ? JSON.stringify(labels) : undefined} aria-valuetext={text} />
    : <input type="range" min={min} max={max} step={step} value={value} data-param={name} data-format={format} data-unit={unit} data-labels={labels ? JSON.stringify(labels) : undefined} aria-valuetext={labels ? text : undefined} />}
  <output data-param-output={name}>{text}</output>
</label>
