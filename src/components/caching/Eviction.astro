<figure class="cache-figure" data-eviction>
 <p class="figure-title">Which answer should make room for the next one?</p>
 <div class="cache-controls"><label>Requests <select data-pattern aria-label="Access pattern"><option value="hot">Hot pair, then a scan</option><option value="cycle">Three-key repeating cycle</option><option value="shift">The hot pair changes</option></select></label><label>Capacity <select data-capacity aria-label="Entry capacity"><option value="2">2 entries</option><option value="3">3 entries</option><option value="4">4 entries</option></select></label><label>Policy <select data-policy aria-label="Model eviction policy"><option value="lru">Least recently used</option><option value="lfu">Least frequently used</option></select></label></div>
 <div class="eviction-requests" data-requests></div>
 <div class="cache-controls"><button data-back>Back</button><button data-next>Next request</button><button data-all>Run all</button><button data-reset>Reset</button></div>
 <p class="key-flow-label">Saved entries · oldest access first</p>
 <div class="eviction-resident" data-resident></div>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <div class="cache-stat-row"><div><strong data-hits>0</strong><span>hits</span></div><div><strong data-misses>0</strong><span>source reads</span></div></div>
 <figcaption>Equal-size entries, no expiry. This is exact LRU or a simple LFU counter since admission, with recency breaking ties and no decay. Redis uses sampled approximations and a probabilistic, decaying LFU counter; it need not choose these exact victims. Changing an option restarts the trace.</figcaption>
</figure>
<script>
import {evictionTrace,accessPatterns} from '../../lib/caching/lifetimes.mjs';
document.querySelectorAll<HTMLElement>('[data-eviction]').forEach(root=>{
 let count=0;const pattern=root.querySelector<HTMLSelectElement>('[data-pattern]')!,capacity=root.querySelector<HTMLSelectElement>('[data-capacity]')!,policy=root.querySelector<HTMLSelectElement>('[data-policy]')!;
 const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
 const render=()=>{const s=evictionTrace(pattern.value,+capacity.value,policy.value,count);root.querySelector('[data-requests]')!.innerHTML=s.requests.map((key,i)=>`<div class="${i>=count?'pending':s.events[i].hit?'hit':'miss'}"><b>${key}</b><small>${i>=count?'·':s.events[i].hit?'hit':'miss'}</small></div>`).join('');
 root.querySelector('[data-resident]')!.innerHTML=Array.from({length:+capacity.value},(_,i)=>{const v=s.resident[i];return `<div class="${v?'':'empty'}">${v?`<b>${v.key}</b><small>${v.frequency} ${v.frequency===1?'access':'accesses'} since admission</small><small>Last: request ${v.last+1}</small>`:'Empty'}</div>`;}).join('');
 const e=s.events.at(-1);set('explanation',e?`Request ${count}: ${e.key} is a ${e.hit?'hit':'miss'}. ${e.evicted?`Evict ${e.evicted} to make room. `:''}${e.hit?'Its access record changes.':'Load it from the source and save it.'}`:'Step through the requests. Predict which entry will leave before adding C.');set('hits',String(s.hits));set('misses',String(s.misses));root.querySelector<HTMLButtonElement>('[data-back]')!.disabled=count===0;for(const q of ['next','all'])root.querySelector<HTMLButtonElement>(`[data-${q}]`)!.disabled=count===s.requests.length;
 };
 root.querySelectorAll('select').forEach(el=>el.onchange=()=>{count=0;render();});root.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>{count++;render();};root.querySelector<HTMLButtonElement>('[data-back]')!.onclick=()=>{count--;render();};root.querySelector<HTMLButtonElement>('[data-all]')!.onclick=()=>{count=accessPatterns[pattern.value].length;render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{count=0;render();};render();
});
</script>
