---
// Figure: a day of fifty keys; how much time race 1 left them stale, by the
// length of each stale stretch. Bar height is stale time, so a bar's size is
// honest about the share of time stale; the count above it is how many stretches.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './invalidation.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="inv-day" title="A day of fifty keys: stale time by stretch length" controls="none" legend={[{ kind: 'stale', label: 'Minutes stale after a race, by stretch length' }]}
  caption="Illustrative model, simulated for 24 hours per key: fifty keys, each read about twice a second, with writes arriving at random. Every miss starts its own fill (nothing coalesces them), and fill times vary at random around the mean, with a long tail. A write's delete lands 1 ms after its commit. Each bar is the total time, across all fifty keys, spent in stale stretches of that length; the number above it is how many stretches there were. The dashed outline is the default settings, for comparison. Only race-caused staleness is counted. Eviction, failed deletes and replicas are left out.">
  <Fragment slot="params">
    <Choice name="writes" label="Each key is written" value="60"
      options={[{ value: '6', label: 'every 10 minutes' }, { value: '60', label: 'every minute' }, { value: '600', label: 'every 6 seconds' }]} />
    <Slider name="fill" label="Mean fill time" min={10} max={300} step={10} value={50} unit="ms" />
    <Choice name="ttl" label="TTL" value="600"
      options={[{ value: '60', label: '1 minute' }, { value: '600', label: '10 minutes' }, { value: '3600', label: '1 hour' }]} />
    <button type="button" class="cache-button inv-action" data-defaults>Reset to defaults</button>
  </Fragment>
  <Fragment slot="stats">
    <Readout name="races" label="Old values stored" value="–" kind="stale" />
    <Readout name="share" label="Share of time stale" value="–" kind="stale" />
    <Readout name="predicted" label="Predicted, writes a second × fill time" value="–" />
    <Readout name="longest" label="Longest stale stretch" value="–" kind="stale" />
  </Fragment>
  <Fragment slot="text">
    <p>With each key written once a minute, a mean fill time of 50 ms and a 10-minute TTL, the fifty keys store an old value 73 times in the day. Together they spend about 55 minutes stale out of 72,000 key-minutes, 0.077% of the time, close to the predicted one write a minute × 50 ms = 0.083%. Most of that time is in stretches of 10 seconds to 3 minutes, each ending at the key's next write; the longest lasts about three minutes.</p>
    <p>A 1-minute TTL gives 104 stretches instead of 73, none longer than a minute, and the same 0.077%: the bars move left and the count rises, but the total stays the same. A 1-hour TTL gives the same picture as 10 minutes here, because the next write ends each stretch before either TTL does. Writing every 6 seconds gives about 6,000 stretches, almost all under a minute, and about 540 minutes stale (0.75%), so together the bars hold about ten times the stale time of the default outline. Writing every 10 minutes leaves one stretch in the day. Raising the fill time to 200 ms roughly quadruples the stale time.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { simulateKeys } from './race-model.mjs';
  import { svgEl } from '../shared/scene.mjs';
  import { niceTicks, niceMax } from '../shared/chart.mjs';

  const KEYS = 50;
  // Stretch-length buckets, in seconds: up to 1 s, 1–10 s, 10 s–1 min, 1–3 min, 3–10 min, longer.
  const EDGES = [1, 10, 60, 180, 600, Infinity];
  const LABELS = ['up to 1 s', '1–10 s', '10 s–1 min', '1–3 min', '3–10 min', 'over 10 min'];
  const SHORT = ['≤1 s', '1–10 s', '10–60 s', '1–3 m', '3–10 m', '>10 m'];
  const fmtShare = (v: number) => (v === 0 ? '0%' : v < 0.0001 ? '<0.01%' : `${(v * 100).toFixed(v < 0.01 ? 3 : 2)}%`);
  const fmtTime = (s: number) => (s < 90 ? `${Math.round(s)} s` : `${(s / 60).toFixed(s < 600 ? 1 : 0)} min`);
  const fmtMin = (m: number) => (m >= 1000 ? `${Math.round(m / 100) / 10}k` : String(Math.round(m * 10) / 10));

  const bucketise = (result: any) => {
    const count = EDGES.map(() => 0), minutes = EDGES.map(() => 0);
    for (const intervals of result.keys) for (const [a, b] of intervals) {
      const d = b - a;
      // A small tolerance keeps stretches cut off at exactly the TTL in the bucket the TTL names.
      const i = EDGES.findIndex(e => d <= e + 0.5);
      count[i]++; minutes[i] += d / 60;
    }
    return { count, minutes };
  };
  const defaults = bucketise(simulateKeys({ writesPerHour: 60, fillMs: 50, ttlSeconds: 600 }, KEYS, 1));

  document.querySelectorAll<HTMLElement>('[data-figure-id="inv-day"]').forEach(root => {
    const container = root.querySelector<HTMLElement>('[data-scene]')!;
    const svg = svgEl('svg', { class: 'cache-svg inv-day', role: 'img', 'aria-label': 'Bars of stale time for fifty keys over a day, grouped by how long each stale stretch lasted' }, container);
    let width = 0;
    let buckets: any = null;
    const draw = () => {
      if (!width || !buckets) return;
      const compact = width < 480;
      const height = 250, top = 34, bottom = 46;
      const peak = Math.max(...buckets.minutes, ...defaults.minutes, 1);
      const yMax = niceMax(peak);
      const ticks = niceTicks(0, yMax, 4);
      const left = 12 + 7.2 * Math.max(...ticks.map(t => fmtMin(t).length)), right = width - 6;
      const plotH = height - top - bottom;
      const y = (m: number) => top + plotH * (1 - m / yMax);
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('width', width); svg.setAttribute('height', height);
      svg.replaceChildren();
      svgEl('text', { class: 'cache-axis-label', x: 0, y: 12 }, svg).textContent = compact ? 'Minutes stale, all keys' : 'Minutes stale, all fifty keys, one day';
      // Key for the outline, top right.
      const key = svgEl('g', {}, svg);
      svgEl('rect', { class: 'inv-day-outline', x: right - (compact ? 74 : 110), y: 3, width: 12, height: 10 }, key);
      svgEl('text', { class: 'inv-day-label', x: right - (compact ? 58 : 94), y: 12 }, key).textContent = compact ? 'defaults' : 'default settings';
      for (const t of ticks) {
        svgEl('path', { class: 'inv-day-grid', d: `M${left} ${y(t)}H${right}` }, svg);
        svgEl('text', { class: 'cache-tick', x: left - 6, y: y(t) + 4, 'text-anchor': 'end' }, svg).textContent = fmtMin(t);
      }
      const band = (right - left) / EDGES.length;
      const barW = Math.min(64, band * 0.62);
      EDGES.forEach((_, i) => {
        const cx = left + band * (i + 0.5);
        const m = buckets.minutes[i], d = defaults.minutes[i];
        const g = svgEl('g', { 'data-cache-kind': 'stale' }, svg);
        if (m > 0) svgEl('rect', { class: 'inv-day-bar', x: cx - barW / 2, y: y(m), width: barW, height: Math.max(1, y(0) - y(m)) }, g);
        if (d > 0) svgEl('rect', { class: 'inv-day-outline', x: cx - barW / 2, y: y(d), width: barW, height: y(0) - y(d) }, svg);
        const n = buckets.count[i];
        svgEl('text', { class: 'inv-day-count', x: cx, y: Math.min(y(m), y(0)) - 5, 'text-anchor': 'middle' }, svg).textContent = n ? n.toLocaleString('en-GB') : '';
        svgEl('text', { class: 'cache-tick', x: cx, y: y(0) + 16, 'text-anchor': 'middle' }, svg).textContent = compact ? SHORT[i] : LABELS[i];
      });
      svgEl('path', { class: 'cache-axis', d: `M${left} ${y(0)}H${right}` }, svg);
      svgEl('text', { class: 'inv-day-label', x: (left + right) / 2, y: height - 6, 'text-anchor': 'middle' }, svg).textContent = compact ? 'Length of each stretch; count above' : 'Length of each stale stretch (the number above a bar is how many stretches)';
    };
    const check = () => { const w = Math.round(container.clientWidth); if (w && w !== width) { width = w; draw(); } };
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(check).observe(container);
    let timer: any;
    root.querySelector('[data-defaults]')!.addEventListener('click', () => {
      const inputs = [...root.querySelectorAll<HTMLInputElement>('[data-param]')];
      for (const input of inputs) {
        if (input.type === 'radio') input.checked = input.defaultChecked;
        else input.value = input.defaultValue;
      }
      inputs.forEach(input => input.dispatchEvent(new Event('input')));
    });
    bindParams(root, (params: any) => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const result = simulateKeys({ writesPerHour: Number(params.writes), fillMs: params.fill, ttlSeconds: Number(params.ttl) }, KEYS, 1);
        buckets = bucketise(result);
        setReadouts(root, {
          races: result.races.toLocaleString('en-GB'),
          share: fmtShare(result.staleShare),
          predicted: fmtShare(result.predictedShare),
          longest: result.longest ? fmtTime(result.longest) : 'none',
        });
        root.dataset.races = String(result.races);
        check(); draw();
      }, 60);
    });
  });
</script>
