---
// Figure: one change to product 42 against twelve cached pages; a tag set against a generation number.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './invalidation.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="inv-fanout" title="One change, twelve cached pages" advance={2000}
  legend={[{ kind: 'redis', label: 'Cached page' }, { kind: 'write', label: 'Just deleted' }, { kind: 'neutral', label: 'Unreachable, still in memory' }]}
  caption="Illustrative model with compressed time: a category has twelve cached listing pages (three sort orders, four pages each). Product 42 appears on one page of each sort order, marked ·42. Pages are read about six times a second in all, first pages most often; a miss refills a page at once with a 20-second TTL. Product 42 changes about every seven seconds. Each page has a fixed slot; an outline is a page not in Redis. Memory per key and the time each command takes are left out.">
  <Choice slot="params" name="mode" label="Invalidate with" value="tags"
    options={[{ value: 'tags', label: 'a tag set' }, { value: 'gens', label: 'a generation number' }]} />
  <Fragment slot="stats">
    <Readout name="keys" label="Page keys in Redis" value="0" kind="redis" />
    <Readout name="orphans" label="Unreachable" value="0" />
    <Readout name="discarded" label="Pages discarded per change" value="–" kind="write" />
    <Readout name="lookups" label="Redis lookups per read" value="–" />
  </Fragment>
  <Fragment slot="text">
    <p>With a tag set, every fill of a page that shows product 42 first adds the page's key to tag:product:42, then stores the page. When product 42 changes, one script reads the set and unlinks the pages in it and the set itself. Only the three pages that show product 42 are deleted, about 2.9 a change on average because some are not cached at the time; the other nine stay cached. Redis holds only reachable pages, at most twelve, and each read is one lookup.</p>
    <p>With a generation number, every read first fetches gen:category:7 and then the page's key built from it, so each read is two lookups. A change is a single INCR, and it discards every cached page of the category, about ten or eleven a change, including the nine that never showed product 42. The old pages are not deleted; they become unreachable and stay in memory until their 20-second TTL ends, so Redis typically holds three or four times as many page keys as it can serve.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { svgEl } from '../shared/scene.mjs';
  import { createFanout, SORTS, PAGES, KETTLE_PAGES } from './fanout-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="inv-fanout"]').forEach(root => {
    const container = root.querySelector<HTMLElement>('[data-scene]')!;
    const svg = svgEl('svg', { class: 'cache-svg', role: 'img', 'aria-label': 'The page keys held in Redis, marked as cached, just deleted, or unreachable' }, container);
    let width = 0;
    let lastModel: any = null;
    const draw = (model: any) => {
      lastModel = model;
      const w = Math.round(container.clientWidth);
      if (!w) return;
      width = w;
      const compact = width < 480;
      const v = model.view();
      const now = model.sim.now;
      const gens = model.mode === 'gens';
      // Each of the twelve pages has a fixed slot: one row per sort order, one column per page.
      const labelW = compact ? 44 : 56, gap = 6, boxH = 24;
      const boxW = Math.min(118, Math.floor((width - labelW - 3 * gap - 2) / 4));
      const current = new Map(v.entries.filter((e: any) => e.reachable).map((e: any) => [e.page, e]));
      const flashing = new Set(model.flash.filter((f: any) => now - f.t < 1200).map((f: any) => f.key.split(':').slice(-2).join(':')));
      const orphans = v.entries.filter((e: any) => !e.reachable).sort((a: any, b: any) => b.gen - a.gen || a.filledAt - b.filledAt);
      const headH = 28, gridH = SORTS.length * (boxH + gap);
      const orphanW = compact ? 74 : 92, perRow = Math.max(1, Math.floor((width - labelW + gap) / (orphanW + gap)));
      const orphanRows = gens ? Math.max(1, Math.ceil(orphans.length / perRow)) : 0;
      const height = headH + gridH + (gens ? 24 + orphanRows * (boxH + gap) : 0) + 4;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('width', width); svg.setAttribute('height', height);
      svg.replaceChildren();
      const head = gens
        ? `gen:category:7 = ${model.gen}`
        : `tag:product:42 holds ${v.tagNames} ${v.tagNames === 1 ? 'name' : 'names'}`;
      const tag = svgEl('g', { class: 'inv-tag' }, svg);
      svgEl('rect', { x: 1, y: 1, width: Math.min(width - 2, head.length * 7.2 + 18), height: 20, rx: 3 }, tag);
      svgEl('text', { x: 10, y: 15 }, tag).textContent = head;
      const box = (x: number, y: number, bw: number, cls: string, kind: string, text: string) => {
        const g = svgEl('g', { class: cls, 'data-cache-kind': kind }, svg);
        svgEl('rect', { x: x + 1, y, width: bw, height: boxH, rx: 3 }, g);
        svgEl('text', { x: x + 1 + bw / 2, y: y + 16, 'text-anchor': 'middle' }, g).textContent = text;
      };
      SORTS.forEach((sort: string, r: number) => {
        const y = headH + r * (boxH + gap);
        svgEl('text', { class: 'inv-grid-label', x: 0, y: y + 16 }, svg).textContent = sort;
        for (let c = 0; c < PAGES; c++) {
          const page = `${sort}:p${c + 1}`;
          const x = labelW + c * (boxW + gap);
          const mark = KETTLE_PAGES.includes(page) ? ' ·42' : '';
          const e: any = current.get(page);
          if (e) box(x, y, boxW, 'inv-key', 'redis', `${gens ? `g${e.gen} ` : ''}p${c + 1}${mark}`);
          else if (flashing.has(page)) box(x, y, boxW, 'inv-key is-flash', 'write', `p${c + 1}${mark}`);
          else box(x, y, boxW, 'inv-key is-empty', 'redis', `p${c + 1}${mark}`);
        }
      });
      if (gens) {
        const y0 = headH + gridH + 4;
        svgEl('text', { class: 'inv-grid-label', x: 0, y: y0 + 12 }, svg).textContent = `Unreachable, still in memory: ${orphans.length}`;
        orphans.forEach((e: any, i: number) => {
          const x = labelW + (i % perRow) * (orphanW + gap), y = y0 + 20 + Math.floor(i / perRow) * (boxH + gap);
          box(x, y, orphanW, 'inv-key is-orphan', 'redis', `g${e.gen} ${e.page}`);
        });
      }
      const s = model.stats;
      setReadouts(root, {
        keys: String(v.entries.length),
        orphans: String(v.orphaned),
        discarded: s.changes ? (s.pagesDiscarded / s.changes).toFixed(1) : '–',
        lookups: s.reads ? (s.lookups / s.reads).toFixed(0) : '–',
      });
    };
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(() => { if (lastModel && Math.round(container.clientWidth) !== width) draw(lastModel); }).observe(container);
    mountSim(root, {
      seed: 9,
      // Start after 20 seconds so Redis already holds pages on arrival.
      create: (params: any, seed: number) => { const m = createFanout({ mode: params.mode }, seed); m.sim.advance(20000); return m; },
      update: () => false,
      render: draw,
    });
  });
</script>
