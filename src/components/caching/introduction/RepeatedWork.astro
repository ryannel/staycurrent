---
// Figure: an application with no cache; the database computes the same few
// answers again and again. One control: visitors a second.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="intro-repeated-work" title="The same answers, computed again and again" legend={[{ kind: 'client', label: 'Request for a product page' }, { kind: 'database', label: 'Answer from the database' }]} advance={10000}
  caption="Illustrative model: 50 products, requested with Zipf-like popularity (s = 1, explained later in this article), so product:1 is the most popular. Every request makes the database compute its product's answer. Travel times are slowed for watching; nothing here is measured.">
  <Slider slot="params" name="rate" label="Visitors a second" min={1} max={8} step={1} value={3} />
  <Fragment slot="stats">
    <Readout name="queries" label="Database queries" value="0" kind="database" />
    <Readout name="distinct" label="Different products asked for" value="0" />
    <Readout name="repeats" label="Answers already computed before" value="–" />
  </Fragment>
  <div slot="after" data-bars></div>
  <Fragment slot="text">
    <p>Requests travel from visitors to the application and on to the database, which computes each product page's answer and sends it back. The bars count how many times the database has computed the answer for the six most requested products. After a minute at three visitors a second, the database has run about 170 queries for only about 40 different products: roughly three in four queries recomputed an answer it had already produced. product:1 alone is computed about 40 times. Doubling the visitors doubles the queries, to about 6 a second, but the number of different answers cannot grow much, because this small shop has only 50 products.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { createScene, spread } from '../shared/scene.mjs';
  import { barChart } from '../shared/chart.mjs';
  import { repeatedWork } from './model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="intro-repeated-work"]').forEach(root => {
    const scene = createScene(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Visitors send requests to an application, which asks the database for every product page.',
      nodes: [
        { id: 'clients', kind: 'client', label: 'Visitors', count: 3 },
        { id: 'app', kind: 'app', label: 'Application' },
        { id: 'database', kind: 'database', label: 'Database' },
      ],
      edges: [
        { id: 'client-app', from: 'clients', to: 'app' },
        { id: 'app-database', from: 'app', to: 'database' },
      ],
      layout: (width, compact) => {
        const [a, b, c] = spread(width, 3, compact ? 40 : 110);
        return { height: 150, positions: { clients: [a, 62], app: [b, 62], database: [c, 62] } };
      },
    });
    const ranks = [0, 1, 2, 3, 4, 5];
    const bars = barChart(root.querySelector<HTMLElement>('[data-bars]')!, {
      label: 'How many times the database computed each of the six most popular product pages',
      bars: ranks.map(k => ({ id: String(k), label: `product:${k + 1}`, kind: 'database' })),
      x: { label: 'Times the database computed this answer', format: (v: number) => String(Math.round(v)) },
    });
    let shown = '';
    mountSim(root, {
      seed: 6,
      create: (params, seed) => repeatedWork({ ...params }, seed),
      update: (model: any, params) => { Object.assign(model.params, params); return true; },
      render(model: any) {
        scene.dots(model.movers.active());
        const reads = model.reads.rate(model.sim.now);
        scene.node('database').set({ sublabel: `${reads.toFixed(1)} queries/s` });
        const key = model.computed.slice(0, 6).join(',');
        if (key !== shown) { shown = key; bars.set(Object.fromEntries(ranks.map(k => [String(k), model.computed[k]]))); }
        setReadouts(root, {
          queries: model.stats.queries.toLocaleString('en-GB'),
          distinct: String(model.stats.distinct),
          repeats: model.stats.queries ? `${Math.round(model.repeatShare() * 100)}%` : '–',
        });
      },
    });
  });
</script>
