---
// Figure: what the database sees when Redis goes away and comes back empty.
// One control: whether Redis is running.
import SimFigure from '../shared/SimFigure.astro';
import ArticleRef from '../shared/ArticleRef.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="intro-outage" title="The database when the cache goes away" advance={5000}>
  <Fragment slot="caption">Illustrative model: 100 requests a second over 400 products (Zipf-like, s = 1), answers expire after 60 seconds, giving a hit ratio near 95%. The database is assumed to serve at most 40 reads a second; reads beyond that fail at once and nothing is stored for them. While Redis is down, the application treats every lookup as a miss, and the shaded band on the chart marks the outage. A real overloaded database slows down for everyone rather than failing only the excess, which can be worse (<ArticleRef slug="operating-a-cache">article 11</ArticleRef>).</Fragment>
  <Choice slot="params" name="redis" label="Redis" options={[{ value: 'up', label: 'Running' }, { value: 'down', label: 'Down' }]} value="up" />
  <Fragment slot="stats">
    <Readout name="ratio" label="Hit ratio, last 2 seconds" value="–" kind="hit" />
    <Readout name="demand" label="Database reads needed a second" value="–" kind="database" />
    <Readout name="failed" label="Failed requests a second" value="–" kind="error" />
  </Fragment>
  <Fragment slot="text">
    <p>The model has already run for two minutes when the figure appears, so Redis is warm and its keys expire at scattered times, as in a cache that has been running for a while. With Redis running, about 5 of the 100 requests a second miss (the readouts move between about 3 and 9), so the database serves about 5 reads a second, far below its assumed capacity of 40.</p>
    <p>Set Redis to Down and a shaded band marks the outage on the chart. Every request needs the database: about 100 reads a second, twenty times as many. The database serves 40 of them and the other 60 or so fail every second for as long as Redis stays down.</p>
    <p>Set it back to Running and Redis returns empty. For the first two or three seconds, misses still exceed the database's capacity and some requests fail; as popular products are stored again, reads fall back under the line within about five seconds, and to a few a second after that.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { cacheAside, updateCacheAside } from './model.mjs';

  const PRERUN = 120000;
  document.querySelectorAll<HTMLElement>('[data-figure-id="intro-outage"]').forEach(root => {
    const chart = lineChart(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Database reads needed and failed requests per second over time',
      height: 240,
      x: { label: 'Simulated time (s)', window: 40 },
      y: { label: 'Per second', domain: [0, 150] },
      series: [
        { id: 'demand', label: 'Database reads needed', kind: 'database' },
        { id: 'failed', label: 'Failed requests', kind: 'error' },
      ],
      rules: [{ y: 40, label: 'Assumed database capacity', kind: 'neutral' }],
    });
    let shown: any = null;
    let drawn = 0;
    // Outages as [start, end] in simulated seconds (end null while Redis is still down),
    // drawn as a shaded band behind the lines. The chart has no band of its own, so the
    // band reads the plot's edges from the capacity rule the chart draws.
    let outages: [number, number | null][] = [];
    const scene = root.querySelector<HTMLElement>('[data-scene]')!;
    const HEIGHT = 240, TOP = 22, BOTTOM = HEIGHT - 40, WINDOW = 40;
    const drawBand = (model: any) => {
      const svg = scene.querySelector<SVGSVGElement>('svg.cache-chart-svg');
      const rule = svg?.querySelector('.cache-rule');
      const edges = /^M([\d.]+) [\d.-]+H([\d.]+)/.exec(rule?.getAttribute('d') ?? '');
      if (!svg || !edges) return;
      let band = svg.querySelector<SVGGElement>('.intro-outage-band');
      if (!band) {
        band = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        band.setAttribute('class', 'intro-outage-band');
        band.setAttribute('aria-hidden', 'true');
        svg.insertBefore(band, svg.querySelector(':scope > .cache-line'));
      }
      const left = Number(edges[1]), right = Number(edges[2]);
      const latest = model.samples.at(-1)?.t ?? 0;
      const x0 = Math.max(0, latest - WINDOW), x1 = Math.max(WINDOW, latest);
      const x = (t: number) => left + ((t - x0) / (x1 - x0)) * (right - left);
      band.replaceChildren();
      for (const [start, end] of outages) {
        const a = Math.max(left, x(start)), b = Math.min(right, x(end ?? latest));
        if (b <= a) continue;
        const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        Object.entries({ x: a, y: TOP, width: b - a, height: BOTTOM - TOP }).forEach(([k, v]) => rect.setAttribute(k, String(v)));
        rect.setAttribute('class', 'intro-outage-rect');
        band.append(rect);
        if (b - a > 60) {
          const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          Object.entries({ x: a + 5, y: BOTTOM - 6 }).forEach(([k, v]) => text.setAttribute(k, String(v)));
          text.setAttribute('class', 'intro-outage-label');
          text.textContent = 'Redis down';
          band.append(text);
        }
      }
    };
    const sim = mountSim(root, {
      seed: 5,
      create: (params, seed) => {
        const model = cacheAside({ keys: 400, skew: 1, rate: 100, ttl: 60000, dbCapacity: 40, animate: false, warm: 'staggered', sample: 500, prerun: PRERUN, redis: params.redis }, seed);
        outages = params.redis === 'down' ? [[0, null]] : [];
        return model;
      },
      update: (model: any, params) => {
        const wasDown = model.params.redis === 'down';
        const kept = updateCacheAside(model, params);
        const now = model.sim.now / 1000;
        if (!wasDown && model.params.redis === 'down') outages.push([now, null]);
        if (wasDown && model.params.redis !== 'down' && outages.length) outages[outages.length - 1][1] = now;
        return kept;
      },
      render(model: any) {
        // A new model has already run for PRERUN ms; show its last 40 s as history.
        if (model !== shown) { shown = model; chart.clear(); drawn = Math.max(0, model.samples.findIndex((s: any) => s.t * 1000 > PRERUN - 40000)); }
        // Plot one-second averages (two half-second samples) so the lines show the level, not each half-second's luck.
        for (; drawn < model.samples.length; drawn++) {
          const s = model.samples[drawn], prev = model.samples[drawn - 1] ?? s;
          chart.push('demand', s.t, (s.demand + prev.demand) / 2);
          chart.push('failed', s.t, (s.failed + prev.failed) / 2);
        }
        chart.render();
        drawBand(model);
        // Readouts average the last four half-second samples, the last two seconds,
        // so they settle near the steady state instead of jumping with each second's luck.
        const recent = model.samples.slice(-4);
        const avg = (name: string) => recent.reduce((sum: number, s: any) => sum + s[name], 0) / recent.length;
        setReadouts(root, recent.length ? {
          ratio: `${Math.round(avg('hitRatio') * 100)}%`,
          demand: String(Math.round(avg('demand'))),
          failed: String(Math.round(avg('failed'))),
        } : { ratio: '–', demand: '–', failed: '–' });
      },
    });
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(() => requestAnimationFrame(() => drawBand(sim.model))).observe(scene);
  });
</script>
<style is:global>
  .intro-outage-rect { fill: var(--cache-redis-tint); }
  .intro-outage-label { fill: var(--cache-redis); font: 600 11px var(--font-sans); }
</style>
