---
// Figure: a cached copy goes stale when the database changes, and stays stale
// until it expires.
import SimFigure from '../shared/SimFigure.astro';
import ArticleRef from '../shared/ArticleRef.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="intro-stale-copy" title="A cached copy goes stale" controls="steps" legend={['hit', 'stale', 'expiry', 'miss', { kind: 'write', label: 'Write to Redis' }]}>
  <Fragment slot="caption">A sequence of steps, not a timed simulation. The application here only reads; nothing in it deletes or updates the key when the price changes. <ArticleRef slug="caching-patterns">Article 2</ArticleRef> adds that step, and <ArticleRef slug="invalidation">article 5</ArticleRef> shows why even that leaves gaps.</Fragment>
  <Fragment slot="text">
    <ol>
      <li>Redis holds product:42 at £34, stored 20 seconds ago with a 60-second expiry. The database agrees.</li>
      <li>A member of staff changes the price in the database to £29. Nothing tells Redis.</li>
      <li>A visitor's request asks Redis for product:42 and hits.</li>
      <li>Redis returns £34. The answer is stale: it no longer matches the database.</li>
      <li>Forty seconds later, 60 seconds after it was stored, the key expires and Redis deletes it.</li>
      <li>The next request misses.</li>
      <li>The application queries the database.</li>
      <li>The database returns the current price, £29.</li>
      <li>It stores £29 in Redis with a new 60-second expiry. From here on, visitors see the new price.</li>
    </ol>
  </Fragment>
</SimFigure>
<script>
  import { sequenceFigure } from '../shared/sequence.mjs';
  document.querySelectorAll<HTMLElement>('[data-figure-id="intro-stale-copy"]').forEach(root => {
    sequenceFigure(root, {
      label: 'Sequence diagram: the database price changes while Redis keeps the old price until the key expires.',
      intro: 'Redis holds product:42 at £34, stored 20 seconds ago with EX 60. The database agrees. Press Next.',
      lanes: [
        { id: 'app', label: 'Application', kind: 'app' },
        { id: 'redis', label: 'Redis', kind: 'redis' },
        { id: 'db', label: 'Database', kind: 'database' },
        { id: 'staff', label: 'Staff', kind: 'neutral' },
      ],
      initial: { app: '', redis: '£34', db: '£34', staff: '' },
      steps: [
        { from: 'staff', to: 'db', label: 'UPDATE £29', kind: 'database', state: { db: '£29' }, explanation: 'A member of staff lowers the price. The database now says £29. Nothing tells Redis.' },
        { from: 'app', to: 'redis', label: 'GET', kind: 'hit', explanation: 'A visitor asks for the product page. The application asks Redis, and the key is there: a hit.' },
        { from: 'redis', to: 'app', label: '£34', kind: 'stale', state: { app: '£34' }, explanation: 'Redis returns £34. The answer is stale: it no longer matches the database, and every visitor until expiry sees it.' },
        { at: 'redis', note: 'expires', kind: 'expiry', state: { redis: 'empty', app: '' }, explanation: 'Forty seconds later, 60 seconds after it was stored, the key expires and Redis deletes it.' },
        { from: 'app', to: 'redis', label: 'GET', kind: 'miss', explanation: 'The next request misses.' },
        { from: 'app', to: 'db', label: 'SELECT …', kind: 'miss', explanation: 'On the miss, the application queries the database, as it would without a cache.' },
        { from: 'db', to: 'app', label: '£29', kind: 'database', state: { app: '£29' }, explanation: 'The database returns the current price, £29.' },
        { from: 'app', to: 'redis', label: 'SET … EX 60', kind: 'write', state: { redis: '£29' }, explanation: 'It stores £29 with a new 60-second expiry. The stale copy lasted 40 seconds here. A copy stored before the change could not have outlived it by more than 60 seconds.' },
      ],
    });
  });
</script>
