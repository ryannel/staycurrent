---
// Figure: the caches a request may pass on its way from a browser to the
// database's disk, to place Redis among them. Static.
import SimFigure from '../shared/SimFigure.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="intro-cache-layers" title="Caches along one request's path" controls="none"
  caption="A map, not a measurement. Not every application has every layer, and each layer is configured separately.">
  <Fragment slot="text">
    <p>From the reader's side to the data's side:</p>
    <ol>
      <li>Browser: keeps HTTP responses on one person's device.</li>
      <li>Content delivery network (CDN): keeps HTTP responses at servers near groups of users.</li>
      <li>Application: can keep objects in its own process memory, private to that process.</li>
      <li>Redis: keeps answers the application chooses, shared by every application process, one network hop away.</li>
      <li>Database: keeps recently used table and index pages in memory (its buffer pool) in front of its disk.</li>
    </ol>
  </Fragment>
</SimFigure>
<script>
  import { createScene, spread } from '../shared/scene.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="intro-cache-layers"]').forEach(root => {
    const ids = ['browser', 'cdn', 'app', 'redis', 'database'];
    createScene(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Five places a request can be answered from a copy: browser, CDN, application memory, Redis, and the database buffer pool.',
      nodes: [
        { id: 'browser', kind: 'client', label: 'Browser', sublabel: 'HTTP responses' },
        { id: 'cdn', kind: 'neutral', label: 'CDN', sublabel: 'copies near users' },
        { id: 'app', kind: 'app', label: 'Application', sublabel: 'its own memory' },
        { id: 'redis', kind: 'redis', label: 'Redis', sublabel: 'answers you choose' },
        { id: 'database', kind: 'database', label: 'Database', sublabel: 'buffer pool pages' },
      ],
      edges: ids.slice(1).map((id, i) => ({ id: `${ids[i]}-${id}`, from: ids[i], to: id })),
      layout: (width, compact) => {
        // On a phone, zigzag down the figure so each label sits clear of the lines.
        if (compact) return { height: 450, positions: Object.fromEntries(ids.map((id, i) => [id, [width * (i % 2 ? 0.74 : 0.26), 34 + i * 92]])) };
        const xs = spread(width, 5, 82);
        return { height: 130, positions: Object.fromEntries(ids.map((id, i) => [id, [xs[i], 46]])) };
      },
    });
  });
</script>
