---
// Figure: which products a small least-recently-used cache holds, drawn as a
// grid of every product from most to least popular. One control: how many
// keys Redis has room for.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="intro-small-cache" title="What a small cache holds" advance={2000}
  caption="Illustrative model: 2,500 products with Zipf-like popularity (s = 1), 500 requests a second, cache-aside with no expiry. When Redis is full, the least recently used key is removed to make room. The dashed outline marks the most popular products, which an ideal cache of the same size would hold. Each request is drawn independently; real traffic comes in bursts, which tends to suit LRU a little better. Not measured; the text compares it with a real Redis.">
  <Slider slot="params" name="capacity" label="Redis has room for" min={25} max={1000} step={25} value={250} unit="keys" />
  <Fragment slot="stats">
    <Readout name="share" label="Share of products" value="–" />
    <Readout name="ratio" label="Hit ratio, last 2,000" value="–" kind="hit" />
    <Readout name="ideal" label="Ideal for this size" value="–" />
  </Fragment>
  <ul slot="after" class="intro-grid-legend" aria-label="Legend">
    <li><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><rect x="1" y="1" width="10" height="10" fill="var(--cache-redis)" /></svg>Product held in Redis</li>
    <li><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><rect x="1" y="1" width="10" height="10" fill="var(--cache-grid)" /></svg>Not held</li>
    <li><svg viewBox="0 0 22 12" width="22" height="12" aria-hidden="true"><path d="M1 6H21" stroke="var(--color-text)" stroke-width="1.5" stroke-dasharray="4 3" /></svg>Most popular products (what an ideal cache would hold)</li>
  </ul>
  <Fragment slot="text">
    <p>Each small square is one product; the most popular is at the top left and popularity falls along each row and down the grid. A filled square is a product Redis currently holds.</p>
    <p>With room for 250 keys (10% of products), Redis holds most of the 50 most popular products, but only about half of the 250 inside the dashed outline. The rest of its room goes to a scatter of unpopular products further down, each requested once recently and kept until it becomes the least recently used. Those squares flicker as they come and go. The hit ratio is about 62%; a cache holding exactly the 250 most popular products would reach about 73%.</p>
    <p>With room for 25 keys (1%) the hit ratio is about 29% against an ideal of 45%; with room for 1,000 (40%) it is about 84% against 89%. Each extra key adds less than the one before, because each is less popular.</p>
  </Fragment>
</SimFigure>
<style>
  .intro-grid { display: block; width: 100%; height: auto; }
  .intro-grid-legend { display: flex; flex-wrap: wrap; gap: .35rem 1.1rem; margin: .6rem 0 0; padding: 0; list-style: none; font: .78rem/1.3 var(--font-sans); color: var(--color-text-secondary); }
  .intro-grid-legend li { display: inline-flex; align-items: center; gap: .4rem; }
  .intro-grid-legend svg { flex: none; }
</style>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { cacheAside } from './model.mjs';

  const KEYS = 2500;
  document.querySelectorAll<HTMLElement>('[data-figure-id="intro-small-cache"]').forEach(root => {
    const container = root.querySelector<HTMLElement>('[data-scene]')!;
    const canvas = document.createElement('canvas');
    canvas.className = 'intro-grid';
    canvas.setAttribute('role', 'img');
    container.append(canvas);
    const context = canvas.getContext('2d')!;
    let width = 0;
    // 100 columns on a wide figure, 50 on a phone, so the squares stay visible and the grid stays short.
    let COLUMNS = 100;
    const size = () => {
      width = Math.round(container.clientWidth);
      COLUMNS = width < 480 ? 50 : 100;
      const ratio = window.devicePixelRatio || 1;
      const height = Math.round((width * KEYS) / COLUMNS / COLUMNS);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      canvas.style.height = `${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    };
    const colour = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();
    const draw = (model: any) => {
      if (!width) return;
      const pitch = width / COLUMNS;
      const held = colour('--cache-redis'), empty = colour('--cache-grid'), outline = colour('--color-text');
      context.clearRect(0, 0, width, (KEYS / COLUMNS) * pitch);
      for (let k = 0; k < KEYS; k++) {
        context.fillStyle = model.cache.peek(k) ? held : empty;
        context.fillRect((k % COLUMNS) * pitch + 0.6, Math.floor(k / COLUMNS) * pitch + 0.6, pitch - 1.2, pitch - 1.2);
      }
      // Outline the most popular `capacity` products: what an ideal cache would hold.
      const c = model.params.capacity, full = Math.floor(c / COLUMNS), rest = c % COLUMNS;
      context.strokeStyle = outline; context.lineWidth = 1.5; context.setLineDash([4, 3]);
      context.beginPath();
      context.moveTo(0.75, 0.75); context.lineTo(width - 0.75, 0.75); context.lineTo(width - 0.75, full * pitch);
      if (rest) { context.lineTo(rest * pitch, full * pitch); context.lineTo(rest * pitch, (full + 1) * pitch); context.lineTo(0.75, (full + 1) * pitch); }
      else context.lineTo(0.75, full * pitch);
      context.closePath(); context.stroke(); context.setLineDash([]);
    };
    const percent = (v: number) => `${Math.round(v * 100)}%`;
    let current: any = null;
    const sim = mountSim(root, {
      seed: 2,
      create: (params, seed) => cacheAside({ keys: KEYS, skew: 1, rate: 500, capacity: params.capacity, animate: false, warm: true, prerun: 30000 }, seed),
      render(model: any) {
        current = model;
        draw(model);
        canvas.setAttribute('aria-label', `Grid of 2,500 products, most popular first. Redis holds ${model.cache.size.toLocaleString('en-GB')} of them; ${model.cache.keys().filter((k: number) => k < model.params.capacity).length.toLocaleString('en-GB')} of the ${model.params.capacity.toLocaleString('en-GB')} most popular are held.`);
        setReadouts(root, {
          share: percent(model.params.capacity / KEYS),
          ratio: percent(model.recent.value),
          ideal: percent(model.popularity.topShare(model.params.capacity)),
        });
      },
    });
    size();
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(() => { if (Math.round(container.clientWidth) !== width) { size(); draw(current ?? sim.model); } }).observe(container);
    draw(sim.model);
    // Redraw when the reader switches theme, since canvas colours are read once per frame.
    new MutationObserver(() => draw(current ?? sim.model)).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  });
</script>
