---
// Figure: the cache-aside read path, step by step: a miss that fills Redis,
// then a hit.
import SimFigure from '../shared/SimFigure.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="intro-read-path" title="The cache-aside read path: a miss, then a hit" controls="steps" legend={['miss', 'hit', { kind: 'write', label: 'Write to Redis' }]}
  caption="A sequence of steps, not a timed simulation. The commands are the ones the application sends; the key, value and 60-second expiry are examples.">
  <Fragment slot="text">
    <ol>
      <li>A visitor asks for product 42. Redis holds nothing yet; the database holds the product row.</li>
      <li>The application sends <code>GET product:42</code> to Redis. Redis has no such key and replies nil: a miss.</li>
      <li>The application queries the database for product 42.</li>
      <li>The database returns the row, and the application builds the answer.</li>
      <li>The application stores the answer with <code>SET product:42 … EX 60</code>, which also tells Redis to treat it as gone after 60 seconds, and returns the page.</li>
      <li>A second visitor asks for product 42. <code>GET product:42</code> finds the key: a hit.</li>
      <li>Redis returns the stored answer. The database does no work for this request.</li>
    </ol>
  </Fragment>
</SimFigure>
<script>
  import { sequenceFigure } from '../shared/sequence.mjs';
  document.querySelectorAll<HTMLElement>('[data-figure-id="intro-read-path"]').forEach(root => {
    sequenceFigure(root, {
      label: 'Sequence diagram of two requests for product 42: the first misses in Redis and reads the database, the second hits.',
      intro: 'A visitor asks for product 42. Redis holds nothing yet; the database holds the product row. Press Next.',
      lanes: [
        { id: 'app', label: 'Application', kind: 'app' },
        { id: 'redis', label: 'Redis', kind: 'redis' },
        { id: 'db', label: 'Database', kind: 'database' },
      ],
      initial: { app: '', redis: 'empty', db: 'product 42' },
      steps: [
        { from: 'app', to: 'redis', label: 'GET product:42', kind: 'client', explanation: 'The application asks Redis for the key product:42.' },
        { from: 'redis', to: 'app', label: 'nil', kind: 'miss', explanation: 'Redis has no such key and replies nil. That is a miss.' },
        { from: 'app', to: 'db', label: 'SELECT …', kind: 'miss', explanation: 'On a miss, the application does what it would have done without a cache: it queries the database.' },
        { from: 'db', to: 'app', label: 'row', kind: 'database', state: { app: 'answer' }, explanation: 'The database returns the row, and the application builds the answer for the page.' },
        { from: 'app', to: 'redis', label: 'SET … EX 60', kind: 'write', state: { redis: 'product:42' }, explanation: 'Before replying, the application stores the answer in Redis under product:42, with EX 60: after 60 seconds Redis will treat it as gone.' },
        { at: 'app', note: 'visitor 2', kind: 'client', state: { app: '' }, explanation: 'The first visitor has their page. A moment later a second visitor asks for the same product.' },
        { from: 'app', to: 'redis', label: 'GET product:42', kind: 'client', explanation: 'The application asks Redis again. This time the key is there.' },
        { from: 'redis', to: 'app', label: 'answer', kind: 'hit', state: { app: 'answer' }, explanation: 'Redis returns the stored answer: a hit. The database does no work at all for this request: one round trip instead of three.' },
      ],
    });
  });
</script>
