---
// Figure: request latency as a distribution. Hits and misses form two groups;
// the median and the 99th percentile fall in different groups.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
interface Props { number: number }
const { number } = Astro.props;
const options = [
  { value: '0.8', label: '80%' }, { value: '0.9', label: '90%' }, { value: '0.95', label: '95%' },
  { value: '0.98', label: '98%' }, { value: '0.995', label: '99.5%' },
];
---
<SimFigure number={number} id="intro-latency-spread" title="Where hits and misses land in the latency distribution" controls="none"
  caption="Illustrative model: 5,000 requests. A hit takes a median of 1 ms and a miss a median of 21 ms, the same assumed costs as the previous figure, each with random spread (log-normal). The spread is lopsided towards slow requests, so the mean miss is about 23 ms and the mean at 95% comes out at 2.2 ms rather than the 2.0 ms of the formula. Requests slower than 45 ms are counted in the last bar. The count axis is a square-root scale so the small group of misses stays visible.">
  <Choice slot="params" name="hitRatio" label="Hit ratio" options={options} value="0.95" />
  <Fragment slot="stats">
    <Readout name="p50" label="Median (p50)" value="–" />
    <Readout name="mean" label="Mean" value="–" />
    <Readout name="p99" label="99th percentile (p99)" value="–" />
  </Fragment>
  <Fragment slot="text">
    <p>Hits form a tall, narrow peak near 1 ms. Misses form a low, wide band from about 10 ms to 45 ms. The mean lies between the two groups, where few requests fall: at 95% it sits among the slowest hits.</p>
    <ul>
      <li>At 80%, 90% and 95% hit ratio the median is a hit, about 1 ms, but the 99th percentile is a miss of 30 ms or more.</li>
      <li>At 98% the 99th percentile is still a miss, about 22 ms.</li>
      <li>At 99.5% fewer than 1% of requests miss, so the 99th percentile drops into the hits, about 2.5 ms. The mean, 1.2 ms, now sits almost on the median, so the chart marks only p50 and p99.</li>
    </ul>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { histogram } from '../shared/chart.mjs';
  import { quantile } from '../shared/sim.mjs';
  import { latencySamples } from './model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="intro-latency-spread"]').forEach(root => {
    const hist = histogram(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Histogram of request latency, hits stacked under misses', height: 240,
      series: [{ id: 'hit', label: 'Hits', kind: 'hit' }, { id: 'miss', label: 'Misses', kind: 'miss' }],
      bins: { min: 0, max: 45, count: 90 },
      x: { label: 'Latency (ms)' }, y: { label: 'Requests (square-root scale)', scale: 'sqrt' },
    });
    const ms = (v: number) => `${v < 10 ? v.toFixed(1) : Math.round(v)} ms`;
    bindParams(root, ({ hitRatio }) => {
      const { hits, misses } = latencySamples(Number(hitRatio));
      const all = [...hits, ...misses];
      const p50 = quantile(all, 0.5), p99 = quantile(all, 0.99);
      const mean = all.reduce((a, b) => a + b, 0) / all.length;
      hist.set({ hit: hits, miss: misses });
      hist.mark('p50', p50, `p50 ${ms(p50)}`);
      // The histogram stacks at most two marker labels without overlap; when all three
      // fall within a few milliseconds the mean adds nothing visible, so only the readout shows it.
      hist.mark('mean', p99 - p50 < 5 ? null : mean, `mean ${ms(mean)}`);
      hist.mark('p99', p99, `p99 ${ms(p99)}`);
      setReadouts(root, { p50: ms(p50), mean: ms(mean), p99: ms(p99) });
    });
  });
</script>
