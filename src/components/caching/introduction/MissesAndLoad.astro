---
// Figure: what a hit ratio means for the database. 1,000 requests drawn as dots;
// misses are rings. Bars show mean latency and database reads a second.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
interface Props { number: number }
const { number } = Astro.props;
const options = [
  { value: '0', label: '0%' }, { value: '0.5', label: '50%' }, { value: '0.9', label: '90%' },
  { value: '0.95', label: '95%' }, { value: '0.99', label: '99%' }, { value: '0.999', label: '99.9%' },
];
---
<SimFigure number={number} id="intro-misses-load" title="One second of traffic at different hit ratios" controls="none" legend={['hit', 'miss']}
  caption="Arithmetic, not a simulation: 1,000 requests a second, an assumed 1 ms for a Redis read and 20 ms for a database read. The writes that fill Redis after a miss are left out. Which dots are misses is arbitrary; how many is exact.">
  <Choice slot="params" name="hitRatio" label="Hit ratio" options={options} value="0.95" />
  <Fragment slot="stats">
    <Readout name="misses" label="Misses in this second" value="50" kind="miss" />
    <Readout name="mean" label="Mean latency" value="2.0 ms" />
    <Readout name="reads" label="Database reads a second" value="50" kind="database" />
  </Fragment>
  <div slot="after" class="intro-pair">
    <div data-bars="mean"></div>
    <div data-bars="reads"></div>
  </div>
  <Fragment slot="text">
    <p>Each of the 1,000 dots is one request in one second. Hits are filled dots; misses are rings, and only the rings reach the database.</p>
    <ul>
      <li>0%: every request goes to the database. 1,000 database reads a second; mean latency 21 ms (the Redis check plus the database read).</li>
      <li>50%: 500 database reads a second; mean latency 11 ms.</li>
      <li>90%: 100 reads; 3.0 ms.</li>
      <li>95%: 50 reads; 2.0 ms.</li>
      <li>99%: 10 reads; 1.2 ms.</li>
      <li>99.9%: 1 read; 1.02 ms.</li>
    </ul>
    <p>From 95% to 99%, database reads fall fivefold, from 50 to 10, while mean latency improves from 2.0 ms to 1.2 ms.</p>
  </Fragment>
</SimFigure>
<style>
  .intro-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.25rem; }
  @media (max-width: 560px) { .intro-pair { grid-template-columns: minmax(0, 1fr); gap: .25rem; } }
</style>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { barChart } from '../shared/chart.mjs';
  import { svgEl } from '../shared/scene.mjs';
  import { dotShape } from '../shared/shapes.mjs';
  import { costOf, missPositions, COSTS } from './model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="intro-misses-load"]').forEach(root => {
    const container = root.querySelector<HTMLElement>('[data-scene]')!;
    const ms = (v: number) => `${v >= 10 ? v.toFixed(0) : v.toFixed(v < 1.1 ? 2 : 1)} ms`;
    const svg = svgEl('svg', { class: 'cache-svg', role: 'img' }, container);
    const mean = barChart(root.querySelector<HTMLElement>('[data-bars="mean"]')!, {
      label: 'Mean latency per request', bars: [{ id: 'mean', label: 'Mean latency', kind: 'client' }],
      x: { label: 'Milliseconds (0 to 21)', domain: [0, COSTS.cache + COSTS.database], format: ms },
    });
    const reads = barChart(root.querySelector<HTMLElement>('[data-bars="reads"]')!, {
      label: 'Database reads a second', bars: [{ id: 'reads', label: 'Database reads a second', kind: 'database' }],
      x: { label: 'Reads a second (0 to 1,000)', domain: [0, COSTS.rate], format: (v: number) => Math.round(v).toLocaleString('en-GB') },
    });
    let h = 0.95;
    let width = 0;
    const draw = () => {
      width = Math.round(container.clientWidth);
      if (!width) return;
      const columns = width < 480 ? 40 : 50;
      const rows = 1000 / columns;
      const pitch = width / columns;
      const height = Math.ceil(rows * pitch);
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('width', String(width)); svg.setAttribute('height', String(height));
      const misses = missPositions(h);
      svg.setAttribute('aria-label', `1,000 requests drawn as dots, of which ${misses.size.toLocaleString('en-GB')} are misses.`);
      svg.replaceChildren();
      const r = Math.min(5, pitch * 0.32);
      for (let i = 0; i < 1000; i++) {
        const kind = misses.has(i) ? 'miss' : 'hit';
        const { d, paint } = dotShape(kind, r);
        const x = (i % columns + 0.5) * pitch, y = (Math.floor(i / columns) + 0.5) * pitch;
        svgEl('path', { class: 'cache-dot', d, 'data-paint': paint, 'data-cache-kind': kind, transform: `translate(${x.toFixed(1)} ${y.toFixed(1)})` }, svg);
      }
    };
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(() => { if (Math.round(container.clientWidth) !== width) draw(); }).observe(container);
    bindParams(root, ({ hitRatio }) => {
      h = Number(hitRatio);
      const cost = costOf(h);
      draw();
      mean.set({ mean: cost.mean });
      reads.set({ reads: cost.databaseReads });
      setReadouts(root, {
        misses: Math.round(cost.missRatio * 1000).toLocaleString('en-GB'),
        mean: ms(cost.mean),
        reads: Math.round(cost.databaseReads).toLocaleString('en-GB'),
      });
    });
  });
</script>
