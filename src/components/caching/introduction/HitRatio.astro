---
// Figure: a live cache-aside system, counting hits and misses. No parameters,
// so the reader watches the hit ratio form.
import SimFigure from '../shared/SimFigure.astro';
import Readout from '../shared/Readout.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="intro-hit-ratio" title="Counting hits and misses" legend={['client', 'hit', 'miss', { kind: 'write', label: 'Write to Redis' }]} advance={10000}
  caption="Illustrative model: 100 products with Zipf-like popularity (s = 1), four requests a second, and every stored answer expires after 60 seconds of simulated time. Redis starts empty and has room for every product. Travel times are slowed for watching; nothing here is measured.">
  <button slot="params" type="button" class="cache-button intro-skip" data-skip aria-label="Skip ahead five minutes of simulated time">Skip ahead 5 minutes</button>
  <Fragment slot="stats">
    <Readout name="hits" label="Hits" value="0" kind="hit" />
    <Readout name="misses" label="Misses" value="0" kind="miss" />
    <Readout name="ratio" label="Hit ratio so far" value="–" kind="hit" />
    <Readout name="recent" label="Hit ratio, last 100" value="–" kind="hit" />
  </Fragment>
  <Fragment slot="text">
    <p>Redis starts empty, so the first requests are all misses: each goes on to the database, and the application stores the answer in Redis on the way back. Requests for popular products soon start to hit. After 30 seconds of simulated time, a little over half of all requests so far have been hits. After five minutes the hit ratio over the last 100 requests sits around three in four, wandering between about 65% and 80% from one hundred requests to the next. It never reaches 100%: requests for rarely viewed products keep missing, and every answer expires after 60 seconds, so even popular products miss once a minute.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { createScene, spread } from '../shared/scene.mjs';
  import { cacheAside } from './model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="intro-hit-ratio"]').forEach(root => {
    const scene = createScene(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Visitors send requests to an application, which reads Redis and, on a miss, the database.',
      nodes: [
        { id: 'clients', kind: 'client', label: 'Visitors', count: 3 },
        { id: 'app', kind: 'app', label: 'Application' },
        { id: 'redis', kind: 'redis', label: 'Redis' },
        { id: 'database', kind: 'database', label: 'Database' },
      ],
      edges: [
        { id: 'client-app', from: 'clients', to: 'app' },
        { id: 'app-redis', from: 'app', to: 'redis' },
        { id: 'app-database', from: 'app', to: 'database' },
      ],
      layout: (width, compact) => {
        const [left, middle, right] = spread(width, 3, compact ? 40 : 100);
        return { height: compact ? 260 : 250, positions: { clients: [left, 128], app: [middle, 128], redis: [right, 58], database: [right, 190] } };
      },
    });
    const percent = (v: number) => `${Math.round(v * 100)}%`;
    const sim = mountSim(root, {
      seed: 3,
      create: (_params, seed) => cacheAside({ keys: 100, skew: 1, rate: 4, ttl: 60000 }, seed),
      render(model: any) {
        scene.dots(model.movers.active());
        const reads = model.readsWindow.rate(model.sim.now);
        const held = model.cache.keys().filter((k: number) => model.cache.has(k, model.sim.now)).length;
        scene.node('redis').set({ badge: `${held} keys` });
        scene.node('database').set({ sublabel: `${reads.toFixed(1)} reads/s` });
        const { hits, misses, requests } = model.stats;
        setReadouts(root, {
          hits: hits.toLocaleString('en-GB'),
          misses: misses.toLocaleString('en-GB'),
          ratio: requests ? percent(hits / requests) : '–',
          recent: model.recent.count ? percent(model.recent.value) : '–',
        });
      },
    });
    // One press reaches the steady state the text describes, instead of thirty presses of Step 10 s.
    root.querySelector<HTMLButtonElement>('[data-skip]')?.addEventListener('click', () => { sim.pause(); sim.advance(300000); });
  });
</script>
