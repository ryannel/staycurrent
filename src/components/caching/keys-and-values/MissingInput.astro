---
// Figure: a key that leaves out the currency serves one shopper another's page.
import SimFigure from '../shared/SimFigure.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="kv-missing-input" title="A key that leaves out the currency" controls="steps"
  caption="A sequence of steps, not a timed simulation. The commands are the ones an application would send; the same thing happens with any input that changes the answer but is left out of the key, such as language, customer tier or permissions.">
  <Fragment slot="text">
    <ol>
      <li>Redis has no copy of the shoes listing. The application builds the key <code>listing:shoes:popular</code> from the category and sort order only.</li>
      <li>A shopper paying in pounds asks for the page. <code>GET listing:shoes:popular</code> misses.</li>
      <li>The application queries the database for the products and prices the rows in pounds.</li>
      <li>It stores the page with <code>SET listing:shoes:popular … EX 60</code>.</li>
      <li>A shopper paying in euros asks for the same category and sort order. The application builds <code>listing:shoes:popular</code> again, the same key, because the currency is not in it.</li>
      <li><code>GET listing:shoes:popular</code> hits.</li>
      <li>Redis returns the page it holds, priced in pounds.</li>
      <li>The euro shopper sees pounds. Nothing failed: the cache reported a hit, and every euro shopper gets pounds until the entry expires.</li>
    </ol>
  </Fragment>
</SimFigure>
<script>
  import { sequenceFigure } from '../shared/sequence.mjs';
  document.querySelectorAll<HTMLElement>('[data-figure-id="kv-missing-input"]').forEach(root => {
    sequenceFigure(root, {
      label: 'Sequence diagram: the application handles a request from a shopper paying in pounds and one paying in euros, and both use a cache key that leaves out the currency',
      intro: 'Redis has no copy of the shoes listing. The application builds the key listing:shoes:popular from the category and the sort order.',
      lanes: [
        { id: 'gbp', label: '£ request', kind: 'app' },
        { id: 'eur', label: '€ request', kind: 'app' },
        { id: 'redis', label: 'Redis', kind: 'redis' },
        { id: 'db', label: 'Database', kind: 'database' },
      ],
      initial: { redis: 'empty', db: 'products' },
      steps: [
        { from: 'gbp', to: 'redis', label: 'GET', kind: 'miss', explanation: 'A shopper paying in pounds opens the shoes listing. GET listing:shoes:popular misses.' },
        { from: 'gbp', to: 'db', label: 'SELECT', kind: 'database', explanation: 'The application asks the database for the products in the shoes category.' },
        { from: 'db', to: 'gbp', label: 'rows', kind: 'database', state: { gbp: 'page in £' }, explanation: 'The database returns the rows, and the application prices them in pounds.' },
        { from: 'gbp', to: 'redis', label: 'SET … EX 60', kind: 'write', state: { redis: 'page in £' }, explanation: 'It stores the finished page under listing:shoes:popular for 60 seconds.' },
        { at: 'eur', note: 'key: listing:shoes:popular', explanation: 'A shopper paying in euros opens the same listing. The application builds the key from the category and sort order only, so it builds listing:shoes:popular, exactly the key the pound shopper used.' },
        { from: 'eur', to: 'redis', label: 'GET', kind: 'hit', explanation: 'GET listing:shoes:popular finds the entry, so it is a hit.' },
        { from: 'redis', to: 'eur', label: 'page in £', kind: 'hit', state: { eur: 'page in £' }, explanation: 'Redis returns the page it holds: the one priced in pounds.' },
        { at: 'eur', note: 'wrong currency', kind: 'error', explanation: 'The euro shopper sees pounds. Nothing failed and nothing was logged: to the application this was a fast, successful hit. Every euro shopper gets pounds until the entry expires.' },
      ],
    });
  });
</script>
