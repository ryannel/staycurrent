---
// Figure: caching whole listing pages or the products on them, side by side.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import './kv.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="kv-granularity" title="Caching pages or caching products" advance={2000}
  legend={[{ kind: 'redis', label: 'Cached entry' }, { kind: 'neutral', label: 'Deleted, waiting for the next view' }, { kind: 'hit', label: 'Hit' }, { kind: 'miss', label: 'Miss, rebuilt from the database' }, { kind: 'write', label: 'Deleted by a product change' }]}
  caption="Illustrative model: 48 products in 4 categories, 24 listing pages of 12 products, six page views a second with Zipf-like popularity (s = 1). Both caches start full and have room for everything; nothing expires, so every miss follows a product change. A dashed cell has been deleted and waits for the next view to rebuild it. The product cache leaves the page to be assembled by the application, which this model does not charge for.">
  <Slider slot="params" name="changes" label="Product changes" min={0} max={120} step={6} value={12} unit="a minute" />
  <Fragment slot="stats">
    <Readout name="pageHit" label="Pages: hit ratio" kind="hit" />
    <Readout name="productHit" label="Products: hit ratio" kind="hit" />
    <Readout name="pageRows" label="Pages: database rows per view" kind="database" />
    <Readout name="productRows" label="Products: database rows per view" kind="database" />
  </Fragment>
  <Fragment slot="text">
    <p>The same page views and product changes go to two caches. The first stores each listing page whole: 24 entries, one for each category, sort order and currency. The second stores the 48 products and builds each page from 12 of them.</p>
    <p>With no product changes, both caches hit every time. The page cache answers a view with one lookup; the product cache needs 12 (one <code>MGET</code>) and must assemble the page.</p>
    <p>Each product change deletes one entry from the product cache but six from the page cache, because the product appears on its category's page in three sort orders and two currencies. At 12 changes a minute the page cache's hit ratio falls to roughly 85% while the product cache stays above 99%. At 120 changes a minute the page cache hits only around 45% of the time, swinging between about 40% and 50%, and reads six or seven database rows per view; the product cache still hits about 97% of lookups and reads about 0.3 rows per view. The readouts cover the last 300 views, so they move as changes arrive.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { granularity, summary, PAGES, CATEGORIES, SORTS, CURRENCIES } from './granularity-model.mjs';
  import { responsiveSvg, entryGrid, setCell, flashKind } from './draw.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="kv-granularity"]').forEach(root => {
    // The first two legend entries are cells, drawn as the grid draws them.
    root.querySelectorAll('.cache-legend li').forEach((li, i) => {
      if (i > 1) return;
      li.querySelector('svg')?.replaceWith(Object.assign(document.createElement('span'), {
        innerHTML: `<svg class="kv-svg" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect class="kv-cell" x="1" y="1" width="10" height="10" rx="2" data-state="${i === 0 ? 'full' : 'empty'}"/></svg>`,
        style: 'display:inline-flex',
      }));
    });
    let pageCells: any[] = [], productCells: any[] = [];
    const view = responsiveSvg(root.querySelector<HTMLElement>('[data-scene]')!,
      'Two grids of cache entries. Left: 24 listing pages. Right: 48 products. Cells empty when a product change deletes them and fill again when a view rebuilds them.',
      (svg, width, compact) => {
        const labelWidth = compact ? 54 : 62;
        const colGroups = SORTS.map(s => ({ label: s, span: CURRENCIES.length }));
        const colLabels = SORTS.flatMap(() => CURRENCIES);
        const gap = 3;
        if (compact) {
          const pageCell = Math.min(34, Math.floor((width - labelWidth - 5 * gap) / 6));
          const left = entryGrid(svg, { x: 0, y: 0, rows: 4, cols: 6, cell: pageCell, gap, labelWidth, rowLabels: CATEGORIES, colLabels, colGroups, title: 'Redis holding pages', subtitle: '1 lookup per view' });
          const productCell = Math.floor((width - labelWidth - 11 * 2) / 12);
          const right = entryGrid(svg, { x: 0, y: left.height + 22, rows: 4, cols: 12, cell: productCell, gap: 2, labelWidth, rowLabels: CATEGORIES, title: 'Redis holding products', subtitle: '12 lookups per view, one MGET' });
          pageCells = left.cells; productCells = right.cells;
          return left.height + 22 + right.height + 4;
        }
        const pageCell = 34, productCell = 24;
        const left = entryGrid(svg, { x: 0, y: 0, rows: 4, cols: 6, cell: pageCell, gap, labelWidth, rowLabels: CATEGORIES, colLabels, colGroups, title: 'Redis holding pages', subtitle: '1 lookup per view' });
        const rightX = Math.max(left.width + 40, width - (labelWidth + 12 * (productCell + gap)));
        const right = entryGrid(svg, { x: rightX, y: 31, rows: 4, cols: 12, cell: productCell, gap, labelWidth, rowLabels: CATEGORIES, title: 'Redis holding products', subtitle: '12 lookups per view, one MGET' });
        pageCells = left.cells; productCells = right.cells;
        return Math.max(left.height, right.height + 31) + 4;
      });

    const pct = (v: number) => (Number.isNaN(v) ? '–' : `${(v * 100).toFixed(v > 0.995 && v < 1 ? 1 : 0)}%`);
    mountSim(root, {
      seed: 11,
      create: (params: any, seed: number) => granularity({ changes: params.changes }, seed),
      update: (model: any, params: any) => { model.params.changes = params.changes; },
      render(model: any) {
        const now = model.sim.now;
        PAGES.forEach((_, i) => pageCells[i] && setCell(pageCells[i], model.pages[i], flashKind(model.flash.pages.get(i), now), 5));
        for (let i = 0; i < model.products.length; i++) if (productCells[i]) setCell(productCells[i], model.products[i], flashKind(model.flash.products.get(i), now), 4);
        const s = summary(model);
        setReadouts(root, {
          pageHit: pct(s.pageHitRatio),
          productHit: pct(s.productHitRatio),
          pageRows: model.totals.views ? s.pageRowsPerView.toFixed(1) : '–',
          productRows: model.totals.views ? s.productRowsPerView.toFixed(2) : '–',
        });
      },
    });
  });
</script>
