---
// Figure: how normalising the key merges names for the same answer.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import { STEPS } from './normalise-model.mjs';
import './kv.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="kv-normalise" title="One answer, many names" controls="none"
  caption="Illustrative model: 2,000 generated requests for 24 distinct listing pages (4 categories, 3 sort orders, 2 currencies). URLs vary the way real links do: parameter order, tracking parameters, defaults written out or left out, capitalised categories. The cache is unlimited and never expires, so each distinct key misses exactly once. Each option includes the ones before it.">
  <Choice slot="params" name="step" label="Build the key from" value="raw" options={STEPS} />
  <Fragment slot="stats">
    <Readout name="keys" label="Distinct keys (24 distinct pages)" kind="redis" />
    <Readout name="ratio" label="Hit ratio" kind="hit" />
    <Readout name="wrong" label="Requests given the wrong currency" kind="error" />
  </Fragment>
  <table class="kv-samples">
    <thead><tr><th scope="col">Request URL</th><th scope="col">Cache key</th><th scope="col">Same key as the first?</th></tr></thead>
    <tbody data-samples></tbody>
  </table>
  <Fragment slot="text">
    <p>Built from the raw URL, the 2,000 requests produce 1,620 different keys for 24 different pages, and only 19% of requests hit. Sorting the parameters merges URLs that differ only in order: 1,120 keys, 44%. Dropping tracking parameters such as <code>utm_source</code>, which do not change the page, leaves 121 keys and 94%. Filling in default values and lower-casing gives exactly 24 keys, one per page, and 98.8%: the best an unlimited cache can do, since each page must miss once.</p>
    <p>Dropping the currency as well raises the hit ratio to 99.4% with 12 keys, but 1,065 requests are then given a page priced in the other currency. The aim is not the highest hit ratio; it is one key per answer.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { requests, evaluate, keyFor, urlOf, SAMPLES } from './normalise-model.mjs';
  import { marker } from '../shared/shapes.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="kv-normalise"]').forEach(root => {
    const list = requests();
    const body = root.querySelector<HTMLElement>('[data-samples]')!;
    const rows = SAMPLES.map(params => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td data-label="URL"></td><td class="kv-key" data-label="Key"></td><td></td>`;
      (tr.children[0] as HTMLElement).textContent = urlOf(params);
      body.append(tr);
      return { tr, params, euro: params.some(([k, v]) => k === 'currency' && v === 'EUR') };
    });
    bindParams(root, ({ step }) => {
      const r = evaluate(list, step);
      setReadouts(root, {
        keys: r.keys.toLocaleString('en-GB'),
        ratio: `${(r.hitRatio * 100).toFixed(r.hitRatio > 0.95 ? 1 : 0)}%`,
        wrong: r.wrong.toLocaleString('en-GB'),
      });
      const first = keyFor(rows[0].params, step);
      rows.forEach((row, i) => {
        const key = keyFor(row.params, step);
        (row.tr.children[1] as HTMLElement).textContent = key;
        const cell = row.tr.children[2] as HTMLElement;
        if (i === 0) { cell.textContent = ''; return; }
        const same = key === first;
        const kind = same && row.euro ? 'error' : same ? 'hit' : 'miss';
        const text = same && row.euro ? 'Same key: wrong currency' : same ? 'Same key' : 'Different key';
        cell.innerHTML = `<span class="kv-tag" data-cache-kind="${kind}">${marker(kind, 10)}</span>`;
        cell.firstElementChild!.append(text);
      });
    });
  });
</script>
