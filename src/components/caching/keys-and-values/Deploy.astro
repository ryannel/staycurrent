---
// Figure: a rolling deploy changes the shape of a cached value.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './kv.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="kv-deploy" title="A deploy changes the shape of a cached value" advance={2000}
  legend={[{ kind: 'hit', label: 'Hit' }, { kind: 'miss', label: 'Miss, read from the database' }, { kind: 'stale', label: 'Hit on a stale copy' }, { kind: 'error', label: 'Failed request' }]}
  caption="Illustrative model: six application instances share one Redis and serve 60 requests a second for 300 products with Zipf-like popularity (s = 1). Two products change a second, popular ones more often, and each change deletes the cached copy. Every entry lives 30 seconds. From 8 s, one instance every 3 s is replaced by version 2, which stores products in a new shape. Redis starts in steady state with version 1 entries. The ring round an instance shows the outcome of its latest request. The model has no rollback and no races between reads and writes.">
  <Choice slot="params" name="mode" label="Version 2 uses" value="strict" options={[
    { value: 'strict', label: 'The same key, and fails on the old shape' },
    { value: 'tolerant', label: 'The same key, and treats the old shape as a miss' },
    { value: 'versioned', label: 'A new key; a change deletes its own version' },
    { value: 'versioned-all', label: 'A new key; a change deletes both versions' },
  ]} />
  <Fragment slot="stats">
    <Readout name="errors" label="Failed requests" kind="error" />
    <Readout name="stale" label="Stale reads" kind="stale" />
    <Readout name="reads" label="Database reads a second" kind="database" />
    <Readout name="held" label="Entries in Redis: v1 / v2" kind="redis" />
  </Fragment>
  <div slot="after" data-chart></div>
  <Fragment slot="text">
    <p>In every case the database serves about seven reads a second before the deploy, from entries expiring and from product changes.</p>
    <p>If version 2 uses the same key and cannot read the old shape, requests start failing as soon as the first instance is replaced, at up to about 30 a second. Old instances also fail on the entries new instances write. The failures do not stop when the deploy ends at 23 s: they continue until about 50 s, when the last version 1 entry expires, roughly one TTL later.</p>
    <p>If each version treats the other's shape as a miss, nothing fails, but the two versions keep overwriting each other's entries while both are running, and database reads rise to about 35 a second.</p>
    <p>If the version is part of the key, nothing fails and the versions never overwrite each other's entries. Version 2 starts with no entries, so database reads rise to about 18 a second and fall as its keys fill. For a while Redis holds both sets, and the version 1 entries stay until they expire.</p>
    <p>But if each product change deletes only the key of the version that handled it, a change handled by one version leaves the other version's copy in place, and instances running the other version keep serving the old product. About 100 reads are stale, up to about nine a second, and they go on until about 44 s, after the deploy ends, because those copies wait for their TTL. When each change deletes the key under both versions, there are no stale reads, for almost no extra database reads.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { svgEl } from '../shared/scene.mjs';
  import { deploy, held, upgraded, INSTANCES } from './deploy-model.mjs';
  import { responsiveSvg, flashKind } from './draw.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="kv-deploy"]').forEach(root => {
    let boxes: { rect: SVGElement; label: SVGElement; ring: SVGElement }[] = [];
    let note: SVGElement | null = null;
    responsiveSvg(root.querySelector<HTMLElement>('[data-scene]')!,
      'Six application instances in a row, each labelled with the version it runs. A ring shows the outcome of each instance\'s latest request.',
      (svg, width, compact) => {
        const gap = compact ? 6 : 14;
        const w = Math.min(84, (width - gap * (INSTANCES - 1)) / INSTANCES);
        const h = compact ? 34 : 40;
        const x0 = (width - (w * INSTANCES + gap * (INSTANCES - 1))) / 2;
        boxes = Array.from({ length: INSTANCES }, (_, i) => {
          const x = x0 + i * (w + gap);
          const ring = svgEl('rect', { class: 'kv-instance-ring', x: x - 3, y: 5, width: w + 6, height: h + 6, rx: 6, style: 'display:none' }, svg);
          const rect = svgEl('rect', { class: 'kv-instance', x, y: 8, width: w, height: h, rx: 4, 'data-version': '1' }, svg);
          const label = svgEl('text', { class: 'kv-instance-label', x: x + w / 2, y: 8 + h / 2 + 4, 'text-anchor': 'middle' }, svg);
          label.textContent = 'v1';
          return { rect, label, ring };
        });
        note = svgEl('text', { class: 'kv-caption', x: width / 2, y: h + 34, 'text-anchor': 'middle' }, svg);
        return h + 42;
      });

    const chart = lineChart(root.querySelector<HTMLElement>('[data-chart]')!, {
      label: 'Failed requests, database reads and stale reads a second over simulated time', height: 210,
      x: { label: 'Simulated time (s)', domain: [0, 60] },
      y: { label: 'A second', domain: [0, 50] },
      series: [{ id: 'errors', label: 'Failed requests a second', kind: 'error' }, { id: 'reads', label: 'Database reads a second', kind: 'database' }, { id: 'stale', label: 'Stale reads a second', kind: 'stale' }],
    });
    let lastSample = -1;
    // The chart ends at 60 s, so the simulation stops there too.
    let sim: any;
    sim = mountSim(root, {
      seed: 4,
      create: (params: any, seed: number) => { chart.clear(); lastSample = -1; return deploy({ mode: params.mode, start: 8000 }, seed); },
      render(model: any) {
        const now = model.sim.now;
        if (now >= 60000 && sim?.playing) sim.pause();
        const sample = Math.floor(now / 500);
        if (sample !== lastSample && now <= 60000) {
          lastSample = sample;
          chart.push('errors', now / 1000, model.windows.errors.rate(now));
          chart.push('reads', now / 1000, model.windows.reads.rate(now));
          chart.push('stale', now / 1000, model.windows.stale.rate(now));
          chart.render();
        }
        boxes.forEach((box, i) => {
          const v = model.versions[i];
          if (box.rect.getAttribute('data-version') !== String(v)) { box.rect.setAttribute('data-version', String(v)); box.label.textContent = `v${v}`; }
          const kind = flashKind(model.flashes[i], now, 350);
          if (kind) { box.ring.setAttribute('data-cache-kind', kind); box.ring.style.display = ''; } else box.ring.style.display = 'none';
        });
        const n = upgraded(model);
        if (note) note.textContent = n === 0 ? 'All instances run version 1' : n < INSTANCES ? `Deploy in progress: ${n} of ${INSTANCES} on version 2` : 'Deploy finished: every instance runs version 2';
        const h = held(model);
        setReadouts(root, {
          errors: model.totals.errors.toLocaleString('en-GB'),
          stale: model.totals.stale.toLocaleString('en-GB'),
          reads: model.windows.reads.rate(now).toFixed(0),
          held: `${h[1]} / ${h[2]}`,
        });
      },
    });
  });
</script>
