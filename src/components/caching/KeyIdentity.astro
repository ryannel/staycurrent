---
import { keyRequests } from '../../lib/caching/keys.mjs';
---
<figure class="cache-figure" data-key-identity>
  <p class="figure-title">Six requests. Which ones may share a saved answer?</p>
  <div class="key-requests">{keyRequests.map((r,i)=><div class="key-request" data-request={i}><b>{i+1} · {r.viewer}</b><span>{r.shop} · product 42</span><small>{r.language} · {r.currency}</small><span data-result>Not sent</span></div>)}</div>
  <fieldset class="key-options"><legend>Include in the key (product ID is always included)</legend><label><input type="checkbox" value="shop" /> Shop</label><label><input type="checkbox" value="language" /> Language</label><label><input type="checkbox" value="currency" /> Currency</label><label><input type="checkbox" value="viewer" /> Viewer</label></fieldset>
  <div class="cache-controls"><button data-next>Send next request</button><button data-all>Send all six</button><button data-reset>Start again</button></div>
  <p class="key-flow-label" aria-hidden="true">↓ Requests with the same key share one slot ↓</p>
  <div class="key-slots" data-slots></div>
  <p class="explanation" data-explanation aria-live="polite">Send the first two requests. Both shops call their product 42.</p>
  <div class="cache-stat-row"><div><strong data-hits>0</strong><span>hits</span></div><div><strong data-unsafe>0</strong><span>wrong answers</span></div><div><strong data-entries>0</strong><span>saved entries</span></div></div>
  <figcaption>Public product cards, with illustrative fixed prices. Harbour sells a blue mug; Hill sells a red bowl. Language and currency change the card; viewer identity does not. Changing a key option clears the cache and restarts the requests.</figcaption>
</figure>
<script>
import {keyRequests,keyFor,keyTrace} from '../../lib/caching/keys.mjs';
document.querySelectorAll<HTMLElement>('[data-key-identity]').forEach(root=>{
 let sent=0;
 const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
 const included=()=>Array.from(root.querySelectorAll<HTMLInputElement>('input:checked')).map(x=>x.value);
 const shape=(name:string)=>name==='mug'?'<svg viewBox="0 0 60 44" aria-hidden="true"><path d="M12 7h30v25q0 7-7 7H19q-7 0-7-7Z"/><path d="M42 13h8q9 11 0 16h-8" fill="none"/></svg>':'<svg viewBox="0 0 60 44" aria-hidden="true"><path d="M5 12h50q-3 27-25 27T5 12Z"/><path d="M5 12q25-12 50 0" fill="none"/></svg>';
 const render=()=>{
  const fields=included(), trace=keyTrace(fields,sent), groups=new Map<string,number[]>();
  keyRequests.forEach((r,i)=>{const key=keyFor(r,fields);groups.set(key,[...(groups.get(key)||[]),i]);});
  root.querySelector('[data-slots]')!.innerHTML=[...groups].map(([key,members])=>{
   const slot=trace.slots.find(s=>s.key===key);
   return `<div class="key-slot"><code>${key.replaceAll('&','&amp;').replaceAll('<','&lt;')}</code><div class="key-members">${members.map(i=>`<span class="${i<sent?'sent':''}">${i+1}</span>`).join('')}</div>${slot?`<div class="key-value">${shape(slot.value.shape)}<span><b>${slot.value.name} · ${slot.value.price}</b><small>Saved by request ${slot.writer+1}</small></span></div>`:'<p class="figure-note">Empty · waiting for the first request</p>'}</div>`;
  }).join('');
  root.querySelectorAll<HTMLElement>('[data-request]').forEach((card,i)=>{const r=trace.results[i];card.classList.toggle('key-wrong',!!r&&!r.correct);card.classList.toggle('key-current',i===sent-1);card.querySelector('[data-result]')!.textContent=r?`${r.hit?'Hit':'Miss'} · ${r.correct?'correct':'wrong answer'}`:'Not sent';});
  const hits=trace.results.filter(r=>r.hit).length,wrong=trace.results.filter(r=>!r.correct).length;
  set('hits',String(hits));set('unsafe',String(wrong));set('entries',String(trace.slots.length));
  const last=trace.results.at(-1);set('explanation',last?`Request ${sent} needs ${last.expected.name} at ${last.expected.price}. ${last.hit?'The saved entry returns':'Load and save'} ${last.actual.name} at ${last.actual.price}. ${last.correct?'The answer matches.':'The key merged different answers.'}`:'Send the first two requests. Both shops call their product 42.');
  root.querySelector<HTMLButtonElement>('[data-next]')!.disabled=sent===6;root.querySelector<HTMLButtonElement>('[data-all]')!.disabled=sent===6;
 };
 root.querySelectorAll('input').forEach(i=>i.addEventListener('change',()=>{sent=0;render();}));
 root.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>{sent=Math.min(6,sent+1);render();};root.querySelector<HTMLButtonElement>('[data-all]')!.onclick=()=>{sent=6;render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{sent=0;render();};render();
});
</script>
