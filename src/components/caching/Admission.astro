<figure class="cache-figure" data-admission>
 <p class="figure-title">One large value can evict several small ones</p>
 <label><input type="checkbox" data-admit checked /> Admit the large response L</label>
 <p class="figure-note">A, B and C cost 2 units each. L costs 6. The cache has 8 units. All entries use LRU.</p>
 <div class="eviction-requests" data-requests></div>
 <div class="cache-controls"><button data-back>Back</button><button data-next>Next request</button><button data-all>Run all</button><button data-reset>Reset</button></div>
 <div class="byte-ruler" aria-hidden="true"><span>0</span><span>8 units</span></div><div class="byte-memory" data-memory></div>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <div class="cache-stat-row"><div><strong data-hits>0</strong><span>hits</span></div><div><strong data-misses>0</strong><span>source reads</span></div></div>
 <figcaption>Run all, then disable admission of L and repeat. Bypassing a fill still returns the source’s answer to that request. These are invented allocation units, not Redis byte measurements. There is no expiry or source update.</figcaption>
</figure>
<script>
import {byteTrace} from '../../lib/caching/lifetimes.mjs';
document.querySelectorAll<HTMLElement>('[data-admission]').forEach(root=>{
 let count=0;const admit=root.querySelector<HTMLInputElement>('[data-admit]')!;const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
 const render=()=>{const s=byteTrace(admit.checked,count);root.querySelector('[data-requests]')!.innerHTML=s.requests.map((key,i)=>`<div class="${i>=count?'pending':s.events[i].hit?'hit':'miss'}"><b>${key}</b><small>${i>=count?'·':s.events[i].hit?'hit':'miss'}</small></div>`).join('');
 const used=s.resident.reduce((sum,v)=>sum+v.size,0);root.querySelector('[data-memory]')!.innerHTML=s.resident.map(v=>`<div style="width:${v.size/s.budget*100}%"><b>${v.key}</b><small>${v.size} units</small></div>`).join('')+(used<s.budget?`<div class="empty" style="width:${(s.budget-used)/s.budget*100}%"><small>Free<br>${s.budget-used}</small></div>`:'');
 const e=s.events.at(-1);set('explanation',e?`Request ${count}: ${e.key} ${e.hit?'hits.':`misses. ${e.admitted?`Save it${e.evicted.length?`, evicting ${e.evicted.join(' and ')}`:''}.`:'Return the answer without saving it.'}`}`:'Fill the cache with A, B and C, then see what making room for L costs.');set('hits',String(s.hits));set('misses',String(s.misses));root.querySelector<HTMLButtonElement>('[data-back]')!.disabled=count===0;for(const q of ['next','all'])root.querySelector<HTMLButtonElement>(`[data-${q}]`)!.disabled=count===7;
 };
 admit.onchange=()=>{count=0;render();};root.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>{count++;render();};root.querySelector<HTMLButtonElement>('[data-back]')!.onclick=()=>{count--;render();};root.querySelector<HTMLButtonElement>('[data-all]')!.onclick=()=>{count=7;render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{count=0;render();};render();
});
</script>
