<figure class="cache-figure" data-failure-capacity>
 <p class="figure-title">The cache disappears; the requests keep arriving</p>
 <p class="figure-note">1,000 requests/s · warm hit rate 95% · source budget 100 equal-cost loads/s. Rates show the last completed second.</p>
 <div class="cache-controls"><label><input type="checkbox" data-bounded /> Refuse source work beyond the budget</label><label><input type="checkbox" data-cold checked /> Redis returns empty</label></div>
 <div class="failure-flow"><div><small>Visitors</small><strong>1,000/s</strong></div><span aria-hidden="true">→</span><div><small data-cache-label>Redis: warm</small><strong data-hits>950 hits/s</strong></div><span aria-hidden="true">→</span><div><small>Need the source</small><strong data-demand>50/s</strong></div></div>
 <div class="failure-reservoir"><div class="failure-water" data-water></div><div><strong data-queue>0</strong><span>loads waiting</span></div></div>
 <p class="figure-note">Queue scale: 0–9,000 loads. The source can complete at most 100 each second.</p>
 <div class="cache-stat-row"><div><strong data-done>0</strong><span>source loads completed</span></div><div><strong data-rejected>0</strong><span>requests refused fallback</span></div><div><strong data-total-hits>0</strong><span>requests answered by cache</span></div></div>
 <div class="cache-controls"><button data-play>Play</button><button data-next>Next second</button><button data-reset>Replay</button><label>Elapsed time <input type="range" min="0" max="20" value="0" step="1" aria-label="Failure elapsed time" data-time /><output data-time-label>0 s</output></label></div>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>Redis fails at 2 s and returns at 7 s. An empty recovery uses an illustrative hit schedule of 0%, 20%, 40%, 60%, 80%, then 95%; this is not a warm-up prediction. The queue retains every admitted request, without deadlines, retries or overload slowdown. Bounded mode has no waiting queue. Replay both policies to see which requests get answers and which are refused.</figcaption>
</figure>
<script>
import {failureFlow} from '../../lib/caching/failures.mjs';
document.querySelectorAll<HTMLElement>('[data-failure-capacity]').forEach(root=>{
 const time=root.querySelector<HTMLInputElement>('[data-time]')!,bounded=root.querySelector<HTMLInputElement>('[data-bounded]')!,cold=root.querySelector<HTMLInputElement>('[data-cold]')!,play=root.querySelector<HTMLButtonElement>('[data-play]')!;
 let timer:ReturnType<typeof setInterval>|undefined;
 const set=(name:string,value:string)=>root.querySelector(`[data-${name}]`)!.textContent=value;
 const stop=()=>{clearInterval(timer);timer=undefined;play.textContent='Play';};
 const render=()=>{const t=+time.value,s=failureFlow({time:t,bounded:bounded.checked,cold:cold.checked}),last=s.history.at(-1);set('time-label',`${t} s`);set('queue',s.queued.toLocaleString());set('done',s.totalDone.toLocaleString());set('rejected',s.totalRejected.toLocaleString());set('total-hits',s.totalHits.toLocaleString());set('hits',`${last?.hits??950} hits/s`);set('demand',`${last?.demand??50}/s`);set('cache-label',!last||last.second<2?'Redis: warm':!last.available?'Redis: unavailable':`Redis: reachable · ${last.percentage}% hits`);root.querySelector<HTMLElement>('[data-water]')!.style.height=`${s.queued/9000*100}%`;set('explanation',t===0?'Start with a warm cache. After two seconds, all requests lose access to it.':`${s.totalArrivals.toLocaleString()} arrivals = ${s.totalHits.toLocaleString()} cache answers + ${s.totalDone.toLocaleString()} source answers + ${s.queued.toLocaleString()} waiting + ${s.totalRejected.toLocaleString()} refused. ${last?.available&&last.second>=7&&s.queued?'Restored connectivity has not erased the old queue.':''}`);root.querySelector<HTMLButtonElement>('[data-next]')!.disabled=t===20;if(t===20)stop();};
 const next=()=>{time.value=String(Math.min(20,+time.value+1));render();};
 play.onclick=()=>{if(timer)stop();else{if(+time.value===20)time.value='0';play.textContent='Pause';timer=setInterval(next,750);render();}};
 root.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>{stop();next();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{stop();time.value='0';render();};time.oninput=()=>{stop();render();};bounded.onchange=cold.onchange=()=>{stop();render();};document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});if(matchMedia('(prefers-reduced-motion: reduce)').matches)play.disabled=true;render();
});
</script>
