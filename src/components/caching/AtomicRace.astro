<figure class="cache-figure" data-atomic-race>
 <p class="figure-title">Two workers intend to change 10 into 12</p>
 <label class="cache-field">Operation <select aria-label="Increment protocol" data-mode><option value="plain">GET, then SET</option><option value="multi">GET, then MULTI / SET / EXEC</option><option value="watch">WATCH, GET, then MULTI / SET / EXEC</option><option value="incr">INCR</option></select></label>
 <div class="atomic-counter"><small>Redis generation counter</small><strong data-counter>10</strong><div class="atomic-dots" aria-hidden="true">{Array.from({length:12},(_,i)=><span data-dot={i}></span>)}</div></div>
 <div class="atomic-workers">{['A','B'].map((name,i)=><div class="cache-copy"><small>Worker {name} · local observation</small><strong data-read={i}>not read</strong><p data-stage={i}>read</p><button data-worker={i}>Advance {name}</button></div>)}</div>
 <div class="cache-controls"><button data-race>Both read, then both write</button><button data-reset>Reset increments</button></div>
 <ol class="atomic-events" data-events aria-label="Operation history"></ol>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>Try the shared schedule in each mode. In WATCH mode, advance the rejected worker twice more to reread and retry. Each click advances one logical operation; WATCH and GET are grouped for readability. The counter is deliberately persistent in this model: eviction, restart and source-database changes are excluded.</figcaption>
</figure>
<script>
import {raceInitial,raceStep} from '../../lib/caching/atomicity.mjs';
document.querySelectorAll<HTMLElement>('[data-atomic-race]').forEach(root=>{const select=root.querySelector<HTMLSelectElement>('[data-mode]')!;let state=raceInitial();const render=()=>{root.querySelector('[data-counter]')!.textContent=String(state.value);root.querySelectorAll<HTMLElement>('[data-dot]').forEach(el=>el.classList.toggle('filled',Number(el.dataset.dot)<state.value));state.workers.forEach((w,i)=>{root.querySelector(`[data-read="${i}"]`)!.textContent=w.read===null?'not read':`${w.read} → propose ${w.read+1}`;root.querySelector(`[data-stage="${i}"]`)!.textContent=w.stage==='retry'?'conflict · reread required':w.stage==='done'?'finished':state.mode==='incr'?'ready to INCR':w.stage==='write'?'ready to write':'ready to read';root.querySelector<HTMLButtonElement>(`[data-worker="${i}"]`)!.disabled=w.stage==='done';});root.querySelector('[data-explanation]')!.textContent=state.message;const events=root.querySelector('[data-events]')!;events.replaceChildren(...state.events.map(e=>{const li=document.createElement('li');li.textContent=e.text;return li;}));};root.querySelectorAll<HTMLButtonElement>('[data-worker]').forEach(b=>b.onclick=()=>{state=raceStep(state,Number(b.dataset.worker));render();});const reset=()=>{state=raceInitial(select.value);render();};select.onchange=reset;root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=reset;root.querySelector<HTMLButtonElement>('[data-race]')!.onclick=()=>{state=raceInitial(select.value);for(const i of[0,1,0,1])state=raceStep(state,i);render();};render();});
</script>
