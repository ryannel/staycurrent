<figure class="cache-figure" data-response-queue>
 <p class="figure-title">What is the small reply waiting behind?</p>
 <div class="cache-controls"><label>First command <select data-kind aria-label="First command cost"><option value="bytes">Large reply</option><option value="work">Expensive execution</option></select></label><label>Size of delay <input type="range" min="10" max="150" step="10" value="100" aria-label="First command delay" data-delay /><output data-delay-label>100 KB reply</output></label><label><input type="checkbox" data-separate /> Put the small request on another connection</label></div>
 <div class="response-lanes" data-lanes></div>
 <div class="pipeline-axis"><span>Both arrive at Redis: 5 ms</span><span data-end></span></div>
 <div class="pipeline-legend"><span>Reply transmission</span><span>Stream waiting</span><span>Execution</span></div>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>One shared serial execution lane. Each connection transmits at an illustrative 1 KB/ms; replies take another 5 ms to propagate. Separate streams have independent transmission budgets here. A real network can add shared bandwidth limits, congestion and scheduling, so this comparison isolates ordering rather than predicting speed.</figcaption>
</figure>
<script>
import {responseQueue} from '../../lib/caching/clients.mjs';
document.querySelectorAll<HTMLElement>('[data-response-queue]').forEach(root=>{const kind=root.querySelector<HTMLSelectElement>('[data-kind]')!,delay=root.querySelector<HTMLInputElement>('[data-delay]')!,separate=root.querySelector<HTMLInputElement>('[data-separate]')!;const render=()=>{const expensive=kind.value==='work',s=responseQueue({large:+delay.value,expensive,separate:separate.checked}),maximum=+delay.value+12;root.querySelector('[data-delay-label]')!.textContent=expensive?`${delay.value} ms execution`:`${delay.value} KB reply`;root.querySelector('[data-end]')!.textContent=`${maximum} ms`;root.querySelector('[data-lanes]')!.replaceChildren(...s.commands.map(c=>{const row=document.createElement('div');const title=document.createElement('b');title.textContent=c.id===1?'Large / expensive':'Small request';const track=document.createElement('div');track.className='pipeline-track';track.setAttribute('role','img');track.setAttribute('aria-label',`Command ${c.id}, execution ${c.execute}–${c.done} milliseconds, reply transmission ${c.send}–${c.sent}, reply arrives ${c.reply}`);for(const [start,end,klass]of [[c.execute,c.done,'execute'],[c.done,c.send,'queue'],[c.send,c.sent,'travel']]as[number,number,string][]){const bar=document.createElement('span');bar.className=klass;bar.style.left=`${start/maximum*100}%`;bar.style.width=`${(end-start)/maximum*100}%`;track.append(bar);}const result=document.createElement('small');result.textContent=`Reply ${c.reply} ms · stream wait ${c.wait} ms`;row.append(title,track,result);return row;}));root.querySelector('[data-explanation]')!.textContent=`The small reply arrives at ${s.small} ms. ${expensive?'It still waits for the first command to finish on the shared execution lane.':separate.checked?'Its own stream lets it avoid the large reply’s bytes in this model.':'Its reply bytes cannot overtake the earlier reply on the same connection.'}`;};kind.onchange=separate.onchange=delay.oninput=render;render();});
</script>
