<figure class="cache-figure" data-copy-on-write>
 <p class="figure-title">A snapshot shares pages until the parent changes them</p>
 <div class="cache-controls"><button data-fork>Start snapshot</button><button data-repeat>Write page 1 again</button><button data-spread>Write every page</button><button data-finish>Finish snapshot</button><button data-reset>Reset pages</button></div>
 <div class="cow-grid">{Array.from({length:12},(_,i)=><button data-page={i} aria-label={`Write page ${i+1}`}><span>Page {i+1}</span><span class="cow-old">current</span><span class="cow-new" hidden>new copy</span></button>)}</div>
 <div class="cache-stat-row"><div><strong data-pages>12</strong><span>physical pages in model</span></div><div><strong data-writes>0</strong><span>writes during this snapshot</span></div></div>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>Start a snapshot, then select pages to write. Write page 1 repeatedly and compare writing every page. Each tile represents one equally sized page, not a key or a measured OS page size. The fixed dataset excludes allocation, freeing, page tables and other process memory. Finishing removes snapshot-only copies; it does not promise an immediate fall in measured RSS.</figcaption>
</figure>
<script>
import {cowInitial,cowStep,cowPages} from '../../lib/caching/memory.mjs';
document.querySelectorAll<HTMLElement>('[data-copy-on-write]').forEach(root=>{let s=cowInitial();const render=()=>{root.querySelector('[data-pages]')!.textContent=String(cowPages(s));root.querySelector('[data-writes]')!.textContent=String(s.writes);root.querySelectorAll<HTMLButtonElement>('[data-page]').forEach(b=>{const dirty=s.dirty.includes(Number(b.dataset.page));b.disabled=!s.active;b.classList.toggle('copied',dirty);b.querySelector('.cow-old')!.textContent=dirty?'snapshot’s old page':s.active?'shared':'current';b.querySelector<HTMLElement>('.cow-new')!.hidden=!dirty;});root.querySelector<HTMLButtonElement>('[data-fork]')!.disabled=s.active;for(const k of['repeat','spread','finish'])root.querySelector<HTMLButtonElement>(`[data-${k}]`)!.disabled=!s.active;root.querySelector('[data-explanation]')!.textContent=s.active?`Parent and snapshot each refer to 12 pages. Changed pages: ${s.dirty.length}. The two views now need ${cowPages(s)} physical pages between them. Rewriting an already-private page adds no further copy in this model.`:s.started?'The snapshot finished. Only the parent’s 12 current pages remain in the model.':'The parent has 12 pages. Starting the snapshot will share them, not immediately duplicate all twelve.';};root.querySelector<HTMLButtonElement>('[data-fork]')!.onclick=()=>{s=cowStep(s,'fork');render();};root.querySelector<HTMLButtonElement>('[data-finish]')!.onclick=()=>{s=cowStep(s,'finish');render();};root.querySelector<HTMLButtonElement>('[data-repeat]')!.onclick=()=>{s=cowStep(s,'write',0);render();};root.querySelector<HTMLButtonElement>('[data-spread]')!.onclick=()=>{for(let i=0;i<12;i++)s=cowStep(s,'write',i);render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{s=cowInitial();render();};root.querySelectorAll<HTMLButtonElement>('[data-page]').forEach(b=>b.onclick=()=>{s=cowStep(s,'write',Number(b.dataset.page));render();});render();});
</script>
