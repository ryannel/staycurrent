<figure class="cache-figure" data-representation>
  <p class="figure-title">The saved answer inherits its dependencies</p>
  <div class="cache-controls"><label>Cache <select data-mode aria-label="Cache scope"><option value="response">The whole response</option><option value="entity">Only the product record</option></select></label><label>Change source <select data-change aria-label="Source change"><option value="none">Nothing</option><option value="category">Category: Kitchen → Gifts</option><option value="price">Price: £12 → £15</option></select></label></div>
  <div class="dependency-sources"><div data-source-product><small>Product record</small><b>Blue mug</b></div><div data-source-category><small>Category record</small><b>Kitchen</b></div><div data-source-price><small>Price record</small><b>£12</b></div></div>
  <svg class="dependency-arrows" viewBox="0 0 600 75" aria-hidden="true"><path data-dep="product" d="M100 0 L265 70"/><path data-dep="category" d="M300 0 L300 70"/><path data-dep="price" d="M500 0 L335 70"/></svg>
  <div class="dependency-cache"><span>Saved in Redis before the change</span><div data-saved>Blue mug · Kitchen · £12</div><small data-cache-state>Copy matches its dependencies</small></div>
  <p class="key-flow-label" data-assembly>↓ Use the saved response ↓</p>
  <div class="dependency-answer"><small>What the reader sees</small><strong data-answer>Blue mug · Kitchen · £12</strong></div>
  <p class="explanation" data-explanation aria-live="polite"></p>
  <figcaption>Lines show what was included in the saved value. Records without a line are read afresh when assembling the response. Each choice restarts from the same initial cache. Serial actions, no replica lag, and no automatic invalidation.</figcaption>
</figure>
<script>
import {representationState} from '../../lib/caching/keys.mjs';
document.querySelectorAll<HTMLElement>('[data-representation]').forEach(root=>{
 const mode=root.querySelector<HTMLSelectElement>('[data-mode]')!,change=root.querySelector<HTMLSelectElement>('[data-change]')!;
 const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
 const render=()=>{const s=representationState(mode.value,change.value);
  for(const field of ['product','category','price']){root.querySelector(`[data-source-${field}] b`)!.textContent=s.source[field];root.querySelector(`[data-source-${field}]`)!.classList.toggle('changed',change.value===field);root.querySelector(`[data-dep="${field}"]`)!.classList.toggle('fresh',!s.dependencies.includes(field));}
  set('saved',Object.values(s.cached).join(' · '));set('cache-state',s.stale?'Stale: a saved dependency has changed':'Copy matches its dependencies');root.querySelector('.dependency-cache')!.classList.toggle('key-wrong',s.stale);
  set('assembly',s.reads?'↓ Read category and price now, then assemble ↓':'↓ Use the saved response ↓');set('answer',Object.values(s.answer).join(' · '));
  set('explanation',`${s.reads} source reads on this hit. ${s.stale?'The page still uses the old value because it was part of the cached response.':s.reads?'The product is reused; category and price come from the current source.':'The entire answer is reused.'}`);
 };mode.onchange=render;change.onchange=render;render();
});
</script>
