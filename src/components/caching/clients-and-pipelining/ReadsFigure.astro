---
// Figure: a page reading its cached values one GET at a time.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import './clients.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="clients-reads" title="A page reading its values one at a time" advance={1000} clock={false}
  legend={[{ kind: 'client', label: 'Request' }, { kind: 'hit', label: 'Reply' }, { kind: 'redis', label: 'Redis working' }, { kind: 'app', label: 'Application writing or reading' }]}
  caption="Illustrative model, slowed down 500 times: one second on screen is 2 ms of real time. Assumed costs: a 0.5 ms network round trip; on Redis, 7 µs of socket work and 0.2 µs of execution per GET, the sizes measured on a laptop; on the client, 2 µs to write a command and 2 µs to read a reply. Left out: network jitter, bandwidth, and everything else the page does.">
  <Slider slot="params" name="n" label="Values the page needs" min={1} max={48} value={24} />
  <Fragment slot="stats">
    <Readout name="trips" label="Round trips" kind="client" />
    <Readout name="total" label="Page waits for Redis" />
    <Readout name="redis" label="Redis working, of that" kind="redis" />
  </Fragment>
  <div data-ladder></div>
  <Fragment slot="text">
    <p>A ladder diagram with time running left to right: the application above, Redis below. Each GET is a line down to Redis, and each reply a line back up; the next GET leaves only when the previous reply has arrived.</p>
    <p>With 24 values the page makes 24 round trips and waits about 12.3 ms. Redis's own work in that time is about 0.17 ms, about 1.4%: a thin block at each turn of the ladder. Each extra value adds the same 0.51 ms, almost all of it the network round trip, so 48 values take about 24.5 ms and one value takes 0.51 ms.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { Simulation } from '../shared/sim.mjs';
  import { schedule } from './ladder-model.mjs';
  import { ladder, fmtMs } from './ladder.mjs';

  const SLOW = 2; // µs of real time per millisecond on screen
  const HOLD = 4000; // ms on screen to show the finished page before the next one (four steps)

  document.querySelectorAll<HTMLElement>('[data-figure-id="clients-reads"]').forEach(root => {
    const step = root.querySelector<HTMLElement>('[data-advance]');
    if (step) { step.querySelector('span')!.textContent = 'Step 2 ms'; step.setAttribute('aria-label', 'Step forward 2 milliseconds of real time'); }
    const span = schedule({ n: 48, method: 'sequential' }).total;
    const view = ladder(root.querySelector<HTMLElement>('[data-ladder]')!, { label: 'Ladder diagram of one page reading its values from Redis one GET at a time' });
    mountSim(root, {
      seed: 1,
      create: (params: any) => ({ sim: new Simulation({ seed: 1 }), sched: schedule({ n: params.n, method: 'sequential' }), n: params.n }),
      render(model: any) {
        const cycle = model.sched.total + HOLD * SLOW;
        const real = model.sim.now * SLOW;
        const now = real % cycle;
        view.render({ sched: model.sched, span, now });
        const done = now >= model.sched.total;
        setReadouts(root, {
          trips: String(done ? model.sched.trips : model.sched.messages.filter((m: any) => m.dir === 'back' && m.t1 <= now).length),
          total: done ? fmtMs(model.sched.total) : fmtMs(now),
          redis: done ? `${fmtMs(model.sched.redisTime)} (${(100 * model.sched.redisTime / model.sched.total).toFixed(1)}%)` : '–',
        });
      },
    });
  });
</script>
