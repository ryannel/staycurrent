---
// Figure: what retries do while Redis is slow.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './clients.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="clients-retry" title="Retries while Redis is slow" advance={1000}
  caption="Illustrative model in small, made-up units, not a benchmark. The shaded area is Redis's work that went to replies nobody was waiting for. Redis serves one request at a time at 100 a second, or 20 a second while it is slow (from 10 s to 15 s). The application sends 60 new requests a second and times each attempt out after 1 s; in normal times 2% of attempts fail at once, as a dropped connection would. Retries wait a random 0–50, 0–100 and 0–200 ms (capped exponential backoff with full jitter). The budget lets retries add at most about a tenth to the requests sent. Left out: the network, users giving up, and anything that removes timed-out requests from Redis's queue.">
  <Choice slot="params" name="policy" label="When an attempt fails or times out, the client" value="none"
    options={[{ value: 'none', label: 'does not retry' }, { value: 'retry', label: 'retries up to 3 times' }, { value: 'budget', label: 'retries, within a budget' }]} />
  <Fragment slot="stats">
    <Readout name="per" label="Attempts per request" kind="client" />
    <Readout name="wasted" label="Replies nobody waited for" kind="error" />
    <Readout name="failed" label="Requests that failed" kind="error" />
    <Readout name="queue" label="Waiting in Redis" kind="redis" />
  </Fragment>
  <div data-chart></div>
  <Fragment slot="text">
    <p>The chart shows attempts sent to Redis each second, replies that reached a client still waiting for them, replies that went to a client that had already timed out (shaded), and Redis's capacity (a thin dashed line), over a minute in which Redis serves only a fifth of its normal rate between 10 and 15 seconds. The readouts cover the last five seconds.</p>
    <p>Without retries, about 2% of requests fail in normal times. During the slowdown requests queue up and time out, and more than half of Redis's work goes to replies nobody reads; about five seconds after the slowdown ends, the queue has drained and everything is normal again.</p>
    <p>With up to three retries, normal times have almost no failures. But once requests start timing out, each one is sent up to four times, the attempts rise to about four times the demand, well above even Redis's normal capacity, and the queue keeps growing after the slowdown has ended. Every reply goes to a client that has given up: the shaded area fills everything up to the capacity line, and the system does not recover by itself.</p>
    <p>With retries limited by a budget, normal times still have almost no failures, the attempts rise only about a tenth during the slowdown, and the system recovers a few seconds after it ends, about as quickly as with no retries.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { create } from './retry-model.mjs';

  const pct = (v: number) => `${Math.round(Math.min(1, v) * 100)}%`;

  document.querySelectorAll<HTMLElement>('[data-figure-id="clients-retry"]').forEach(root => {
    const container = root.querySelector<HTMLElement>('[data-chart]')!;
    const HEIGHT = 240, BOTTOM = 40; // the line chart's height and its bottom margin with an x-axis label
    const chart = lineChart(container, {
      label: 'Attempts sent, replies used and replies wasted each second, against Redis capacity', height: HEIGHT,
      x: { label: 'Simulated time (s)', window: 60, format: (v: number) => `${Math.round(v)}` },
      y: { label: 'Requests a second', domain: [0, 300] },
      series: [
        { id: 'sent', label: 'Attempts sent', kind: 'client', dash: '' },
        { id: 'used', label: 'Replies used', kind: 'hit', dash: '6 4' },
        { id: 'wasted', label: 'Replies nobody waited for (shaded)', kind: 'error', dash: '' },
        { id: 'capacity', label: 'Redis capacity', kind: 'redis', dash: '3 3' },
      ],
    });
    container.classList.add('retry-chart');
    // A local overlay: shade the area under "replies nobody waited for", so that when
    // it reaches the capacity line the reader sees all of Redis's work going to waste.
    const wastedLine = container.querySelector<SVGPathElement>('.cache-line[data-cache-kind="error"]')!;
    const area = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    area.setAttribute('class', 'retry-wasted-area');
    wastedLine.parentNode!.insertBefore(area, container.querySelector('.cache-chart-svg .cache-line'));
    const shade = () => {
      const d = wastedLine.getAttribute('d') ?? '';
      const xs = [...d.matchAll(/[ML]([\d.-]+) /g)].map(m => m[1]);
      area.setAttribute('d', xs.length ? `${d}L${xs[xs.length - 1]} ${HEIGHT - BOTTOM}L${xs[0]} ${HEIGHT - BOTTOM}Z` : '');
    };
    new MutationObserver(shade).observe(wastedLine, { attributes: true, attributeFilter: ['d'] });
    mountSim(root, {
      seed: 4,
      create: (params: any) => create({ policy: params.policy }, 4),
      render(model: any) {
        const pts = (key: string) => model.samples.map((s: any) => [s.t / 1000, s[key]]);
        for (const id of ['sent', 'used', 'wasted', 'capacity']) chart.set(id, pts(id));
        chart.render();
        const s = model.recentStats();
        const ready = model.sim.now > 2000;
        setReadouts(root, {
          per: ready ? `${s.perRequest.toFixed(2)}×` : '–',
          wasted: ready ? pct(s.wastedShare) : '–',
          failed: ready ? pct(s.failedShare) : '–',
          queue: String(s.queue),
        });
      },
    });
  });
</script>
