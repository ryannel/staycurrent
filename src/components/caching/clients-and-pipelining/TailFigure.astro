---
// Figure: one slow round trip in a hundred, and pages that wait for k of them.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './clients.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="clients-tail" title="One slow round trip in a hundred, and pages that wait for many" controls="none"
  legend={[{ kind: 'error', label: 'Slow round trip' }]}
  caption="Illustrative model with random numbers: 100 page views, each a row of round trips made one after another, in the order they happened. On average 1 round trip in 100 is slow, whether the slow ones are independent or come in bursts of 8 in a row. A page counts as slow if any of its round trips is. Left out: how slow a slow round trip is, and everything else the page does.">
  <Fragment slot="params">
    <Slider name="k" label="Round trips per page" min={1} max={100} value={24} />
    <Choice name="pattern" label="Slow round trips" value="independent"
      options={[{ value: 'independent', label: 'independent' }, { value: 'bursts', label: 'in bursts' }]} />
    <div class="tail-actions"><button type="button" class="cache-button" data-redraw>Draw 100 new pages</button></div>
  </Fragment>
  <Fragment slot="stats">
    <Readout name="trips" label="Round trips that were slow" kind="error" />
    <Readout name="pages" label="Pages with a slow round trip" kind="error" />
    <Readout name="predicted" label="1 − 0.99ᵏ" />
  </Fragment>
  <div data-wall></div>
  <Fragment slot="text">
    <p>Each of the 100 rows is one page view; each cell in a row is one of that page's round trips to Redis, and slow ones are marked. A row with any slow round trip is tinted and marked in a column at the right as a slow page.</p>
    <p>With one round trip per page, about 1 page in 100 is slow. With 24 round trips, about 21 pages in 100 are slow (the first drawing shows 21), close to 1 − 0.99²⁴ = 21.4%. With 100 round trips, about 63 in 100 are. The share of slow round trips stays at about 1% throughout.</p>
    <p>When the slow round trips come in bursts of 8, with the same 1% overall, fewer pages are hit (a few in 100 at 24 round trips; the first drawing shows 4) but each of those pages meets several slow round trips.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { svgEl } from '../shared/scene.mjs';
  import { wall, predicted } from './tail-model.mjs';

  const pct = (v: number) => `${(v * 100).toFixed(v < 0.1 ? 1 : 0)}%`;

  document.querySelectorAll<HTMLElement>('[data-figure-id="clients-tail"]').forEach(root => {
    const container = root.querySelector<HTMLElement>('[data-wall]')!;
    container.classList.add('tail-wall');
    const svg = svgEl('svg', { class: 'cache-svg', role: 'img', 'aria-label': 'One hundred page views drawn as rows of round trips, with slow round trips marked' }, container);
    let seed = 8; // a draw close to the expected 21 slow pages at 24 round trips, and 4 in bursts
    let params: any = { k: 24, pattern: 'independent' };
    let width = 0;

    const draw = () => {
      const result = wall({ k: params.k, pattern: params.pattern, seed });
      setReadouts(root, {
        trips: pct(result.slowTrips / result.trips),
        pages: `${result.slowPages} of 100`,
        predicted: pct(predicted(params.k)),
      });
      root.dataset.slowPages = String(result.slowPages);
      if (!width) return;
      const compact = width < 480;
      const top = 18, rowH = compact ? 3 : 3.2, gap = 1;
      // A column at the right marks each slow page, so slow pages can be counted
      // against slow cells. Rows are scaled so that 24 round trips fill the rest of
      // the width, and longer pages fill it more densely.
      const markW = compact ? 44 : 64;
      const cell = (width - 2 - markW) / Math.max(params.k, 24);
      const markX = width - markW + 6;
      const height = top + result.rows.length * (rowH + gap) + 2;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('width', width); svg.setAttribute('height', height);
      svg.replaceChildren();
      svgEl('text', { class: 'tail-head', x: 0, y: 12 }, svg).textContent = compact ? `100 pages × ${params.k} round trip${params.k === 1 ? '' : 's'} →` : `100 page views, each a row of ${params.k} round trip${params.k === 1 ? '' : 's'} →`;
      svgEl('text', { class: 'tail-head is-slow', x: width, y: 12, 'text-anchor': 'end' }, svg).textContent = 'slow page';
      result.rows.forEach((row, i) => {
        const y = top + i * (rowH + gap);
        if (row.some(Boolean)) {
          svgEl('rect', { class: 'tail-row-mark', x: 0, y: y - gap / 2, width: row.length * cell + 2, height: rowH + gap }, svg);
          svgEl('rect', { class: 'tail-page-mark', x: markX, y, width: markW - 6, height: rowH }, svg);
        }
        // One rectangle per round trip while they are wide enough to tell apart;
        // otherwise one per row. Slow ones are drawn on top.
        if (cell >= 6) row.forEach((_, j) => svgEl('rect', { class: 'tail-trip', x: 1 + j * cell, y, width: cell - 1.5, height: rowH }, svg));
        else svgEl('rect', { class: 'tail-trip', x: 1, y, width: Math.max(1, row.length * cell - 0.5), height: rowH }, svg);
        row.forEach((slow, j) => { if (slow) svgEl('rect', { class: 'tail-trip is-slow', x: 1 + j * cell, y: y - 0.6, width: Math.max(2, cell - 1.5), height: rowH + 1.2 }, svg); });
      });
    };

    bindParams(root, p => { params = p; draw(); });
    root.querySelector('[data-redraw]')!.addEventListener('click', () => { seed++; draw(); });
    const resize = () => { const w = Math.round(container.clientWidth); if (w && w !== width) { width = w; draw(); } };
    new ResizeObserver(resize).observe(container);
    resize();
  });
</script>
