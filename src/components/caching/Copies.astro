<figure class="cache-figure" data-cache-copies>
  <p class="figure-title">Changing the source does not change the copy</p>
  <div class="cache-copy-pair"><div class="cache-copy"><span>Database · current price</span><strong data-source>£12</strong><small>Authoritative product record</small></div><div class="cache-copy" data-cache-card><span>Redis · saved price</span><strong data-cache>£12</strong><small data-status>Matches the source</small></div></div>
  <div class="cache-controls"><button data-update>Change source to £15</button><button data-read>Read product page</button><button data-delete>Delete cached copy</button><button data-reset>Reset</button></div>
  <p class="explanation" data-explanation aria-live="polite">Both stores currently hold £12. Change the source, then read the page.</p>
  <figcaption>These actions run one at a time. A read uses cache-aside: use the copy if present, otherwise load and save the source value. This model deliberately has no automatic invalidation or expiry, so the stale copy remains until you delete it.</figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-cache-copies]').forEach(root=>{
    let source=12,cached:number|null=12;
    const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
    const render=(message:string)=>{set('source',`£${source}`);set('cache',cached===null?'Empty':`£${cached}`);set('status',cached===null?'Next read must load the source':cached===source?'Matches the source':'Stale: the source has changed');root.querySelector('[data-cache-card]')!.classList.toggle('stale',cached!==null&&cached!==source);set('explanation',message);root.querySelector<HTMLButtonElement>('[data-update]')!.disabled=source===15;};
    root.querySelector<HTMLButtonElement>('[data-update]')!.onclick=()=>{source=15;render('The database now holds £15. No request has told Redis about the change.');};
    root.querySelector<HTMLButtonElement>('[data-read]')!.onclick=()=>{const hit=cached!==null;if(!hit)cached=source;render(`The product page shows £${cached}. ${hit?'It was a cache hit; the database was not consulted.':'It was a miss; the application read the source and filled the cache.'}`);};
    root.querySelector<HTMLButtonElement>('[data-delete]')!.onclick=()=>{cached=null;render('The copy is gone. The database still has the product; deleting a cache entry does not delete its source.');};
    root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{source=12;cached=12;render('Both stores currently hold £12. Change the source, then read the page.');};
  });
</script>
