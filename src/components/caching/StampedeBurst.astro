<figure class="cache-figure" data-stampede-burst>
 <p class="figure-title">Twelve callers need one missing answer</p>
 <div class="cache-controls"><label>Coordination <select data-mode aria-label="Coalescing scope"><option value="none">None</option><option value="local">Within each process</option><option value="shared">Across all processes</option></select></label><label>Processes <select data-processes aria-label="Application processes"><option value="1">1</option><option value="3" selected>3</option><option value="6">6</option></select></label></div>
 <p class="figure-note">All twelve requests arrive together. A source load takes 500 ms; four loads can execute at once.</p>
 <div class="burst-processes" data-process-list></div>
 <p class="key-flow-label">↓ Source loads already admitted ↓</p>
 <div class="burst-slots" data-slots></div>
 <p class="figure-note" data-queue></p>
 <div class="cache-controls"><button data-play>Play</button><button data-next>Next completion</button><button data-reset>Replay</button><label>Time <input data-time aria-label="Burst time" type="range" min="0" max="1500" step="10" value="0"/><output data-now>0 ms</output></label></div>
 <div class="cache-stat-row"><div><strong data-jobs>12</strong><span>source loads</span></div><div><strong data-completed>0 / 12</strong><span>callers answered</span></div><div><strong data-end>1500 ms</strong><span>last completion</span></div></div>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>Numbered circles are callers, grouped by application process; filled circles have answers. Load bars show source work. Fixed-duration FIFO jobs, simultaneous arrivals, no cancellation of already-admitted duplicates. Shared coordination assumes one successful owner for the full load. These are illustrative capacities and times, not Redis measurements.</figcaption>
</figure>
<script>
import {burstState} from '../../lib/caching/stampedes.mjs';
document.querySelectorAll<HTMLElement>('[data-stampede-burst]').forEach(root=>{
 const mode=root.querySelector<HTMLSelectElement>('[data-mode]')!,processes=root.querySelector<HTMLSelectElement>('[data-processes]')!,time=root.querySelector<HTMLInputElement>('[data-time]')!,play=root.querySelector<HTMLButtonElement>('[data-play]')!;let playing=false,frame=0,last=0,clock=0,previousMessage='';
 const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
 const stop=()=>{playing=false;cancelAnimationFrame(frame);play.textContent='Play';};
 const render=()=>{const s=burstState({mode:mode.value,processes:+processes.value,time:+time.value});time.max=String(s.end);
 root.querySelector('[data-process-list]')!.innerHTML=Array.from({length:+processes.value},(_,p)=>`<div><small>Process ${p+1}</small><div>${s.requests.filter(r=>r.process===p).map(r=>`<span class="${r.done?'done':''}" title="Caller ${r.id+1}: ${r.done?'answered':'waiting'}">${r.id+1}</span>`).join('')}</div></div>`).join('');
 const active=s.loads.filter(j=>j.status==='active');root.querySelector('[data-slots]')!.innerHTML=Array.from({length:4},(_,i)=>{const j=active[i];return `<div><small>Slot ${i+1}</small><b>${j?`Load ${j.id+1}`:'Idle'}</b><i><em style="width:${j?j.progress*100:0}%"></em></i></div>`;}).join('');
 set('queue',s.queued?`Queued: ${s.loads.filter(j=>j.status==='queued').map(j=>`load ${j.id+1}`).join(', ')}`:'No source loads queued.');set('now',`${Math.round(+time.value)} ms`);set('jobs',String(s.jobs));set('completed',`${s.completed} / 12`);set('end',`${s.end} ms`);
 const message=`${s.active} source loads active. ${s.completed===12?'All callers have answers.':mode.value==='none'?'Each caller waits for its own duplicate load.':mode.value==='local'?'Callers in each process share that process’s load.':'All callers share one load.'}`;if(message!==previousMessage){set('explanation',message);previousMessage=message;}
 root.querySelector<HTMLButtonElement>('[data-next]')!.disabled=+time.value>=s.end;if(+time.value>=s.end)stop();
 };
 const tick=(now:number)=>{if(!playing)return;if(last){clock=Math.min(+time.max,clock+(now-last)*.5);time.value=String(Math.round(clock));}last=now;render();if(playing)frame=requestAnimationFrame(tick);};
 play.onclick=()=>{if(playing){stop();return;}if(+time.value>=+time.max)time.value='0';playing=true;last=0;clock=+time.value;play.textContent='Pause';frame=requestAnimationFrame(tick);};
 const reset=()=>{stop();time.value='0';render();};mode.onchange=reset;processes.onchange=reset;time.oninput=()=>{stop();render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=reset;root.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>{stop();time.value=String(Math.min(+time.max,(Math.floor(+time.value/500)+1)*500));render();};
 document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});if(matchMedia('(prefers-reduced-motion: reduce)').matches){play.disabled=true;play.title='Use Next completion or the time control with reduced motion.';}render();
});
</script>
