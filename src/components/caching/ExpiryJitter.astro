<figure class="cache-figure" data-expiry-jitter>
 <p class="figure-title">Spread many deadlines without extending the oldest answer</p>
 <div class="cache-controls"><label>Shorten lifetimes by up to <input type="range" min="0" max="20" value="0" data-spread aria-label="Expiry jitter"/><output data-value>0 s</output></label></div>
 <p class="figure-note">60 different keys, all saved at time 0. Each lifetime is at most 60 seconds.</p>
 <div class="jitter-chart" data-chart role="img" aria-label="Histogram of expiration deadlines"></div>
 <div class="jitter-axis" aria-hidden="true"><span>40 s</span><span>50 s</span><span>60 s</span></div>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>Each bar counts keys expiring in one second; the vertical scale is fixed at 60 keys. A fixed pseudo-random sample makes comparisons repeatable. This spreads many keys’ deadlines, not the callers waiting on one key. Expiry does not itself reload a key.</figcaption>
</figure>
<script>
import {jitterHistogram} from '../../lib/caching/stampedes.mjs';
document.querySelectorAll<HTMLElement>('[data-expiry-jitter]').forEach(root=>{const input=root.querySelector<HTMLInputElement>('[data-spread]')!;const render=()=>{const spread=+input.value,bins=jitterHistogram(spread),peak=Math.max(...bins.map(b=>b.count));root.querySelector('[data-value]')!.textContent=`${spread} s`;root.querySelector('[data-chart]')!.innerHTML=bins.map(b=>`<div><i style="height:${b.count/60*100}%" title="${b.time} s: ${b.count} keys"></i></div>`).join('');const description=`${spread?`Deadlines range from ${60-spread} to 60 seconds.`:'All deadlines are at 60 seconds.'} Largest one-second group: ${peak} keys. No lifetime exceeds 60 seconds.`;root.querySelector('[data-explanation]')!.textContent=description;root.querySelector('[data-chart]')!.setAttribute('aria-label',description);};input.oninput=render;render();});
</script>
