<figure class="cache-figure" data-cache-reuse>
  <p class="figure-title">Twenty requests: how many answers can be reused?</p>
  <label>Different products <input data-products type="range" min="1" max="20" value="4" /><output data-count>4</output></label>
  <div class="cache-request-strip" data-strip></div>
  <div class="cache-controls"><button data-next>Send next request</button><button data-all>Send all 20</button><button data-reset>Start again</button></div>
  <div class="cache-stat-row"><div><strong data-hits>0</strong><span>cache hits</span></div><div><strong data-reads>0</strong><span>database reads</span></div><div><strong data-rate>—</strong><span>hit rate</span></div></div>
  <p class="explanation" data-explanation aria-live="polite">The cache starts empty. Each letter is one product.</p>
  <figcaption>Read left to right. <strong>M</strong> means miss; <strong>H</strong> means hit. Requests cycle through the chosen number of products. Every saved value fits in memory and remains valid for the whole run. Moving the slider restarts the experiment.</figcaption>
</figure>
<script>
  import { reuseTrace } from '../../lib/caching/intro.mjs';
  document.querySelectorAll<HTMLElement>('[data-cache-reuse]').forEach(root=>{
    let sent=0; const input=root.querySelector<HTMLInputElement>('[data-products]')!;
    const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
    const render=()=>{
      const n=Number(input.value), trace=reuseTrace(Array.from({length:20},(_,i)=>String.fromCharCode(65+i%n)));
      const hits=trace.slice(0,sent).filter(x=>x.hit).length;
      root.querySelector('[data-strip]')!.innerHTML=trace.map((r,i)=>`<div class="cache-request ${i>=sent?'pending':r.hit?'hit':''}" aria-label="Request ${i+1}: product ${r.key}, ${i>=sent?'not sent':r.hit?'hit':'miss'}">${r.key}<small>${i>=sent?'·':r.hit?'H':'M'}</small></div>`).join('');
      set('count',String(n));set('hits',String(hits));set('reads',String(sent-hits));set('rate',sent?`${Math.round(hits/sent*100)}%`:'—');
      set('explanation',sent?`Request ${sent} asks for ${trace[sent-1].key}. ${trace[sent-1].hit?'A saved answer avoids another database read.':'No saved answer exists; load it and keep a copy.'}`:'The cache starts empty. Each letter is one product.');
      root.querySelector<HTMLButtonElement>('[data-next]')!.disabled=sent===20;
      root.querySelector<HTMLButtonElement>('[data-all]')!.disabled=sent===20;
    };
    input.oninput=()=>{sent=0;render();};
    root.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>{sent=Math.min(20,sent+1);render();};
    root.querySelector<HTMLButtonElement>('[data-all]')!.onclick=()=>{sent=20;render();};
    root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{sent=0;render();};render();
  });
</script>
