---
interface Props { guarded?:boolean }
const {guarded=false}=Astro.props;
---
<figure class="cache-figure" data-cache-race data-guarded={String(guarded)}>
 <p class="figure-title">{guarded?'An old reader needs permission to fill the current generation':'A successful deletion can be followed by a stale refill'}</p>
 {!guarded && <div class="cache-controls"><label>Writer order <select data-order aria-label="Invalidation order"><option value="after">Commit, then delete</option><option value="before">Delete, then commit</option></select></label></div>}
 <div class="cache-controls race-presets"><button data-preset="refill">Load stale-refill schedule</button><button data-preset="serial">Load serial schedule</button>{!guarded&&<button data-preset="early">Load early-delete schedule</button>}</div>
 <div class="race-state"><div><small>Source price</small><strong data-source>£12</strong></div><div data-cache-card><small>Saved in Redis</small><strong data-cache>Empty</strong></div><div><small>Reader is holding</small><strong data-held>Nothing</strong></div></div>
 {guarded&&<div class="generation-pair"><span>Reader’s token <b data-captured>—</b></span><span>Current generation <b data-generation>g1</b></span></div>}
 <div class="race-actors"><div><b>Reader</b><p data-reader-next>Look in cache</p><button data-reader>Advance reader</button></div><div><b>Writer</b><p data-writer-next>Commit £15</p><button data-writer>Advance writer</button></div></div>
 <div class="cache-controls"><button data-back>Back one step</button><button data-reset>Reset schedule</button></div>
 <p class="explanation" data-explanation aria-live="polite">Choose which actor takes the next step.</p>
 <div class="race-log-labels" aria-hidden="true"><span>Reader steps</span><span>Writer steps</span></div><ol class="race-log" data-log></ol>
 <figcaption>{guarded?'Generation capture happens before the source read. Rotation plus deletion, and token comparison plus fill, are each atomic Redis operations. The model covers one source write, one reader and one live Redis history; it does not model failover, lost invalidations or stale source replicas.':'Each button executes one indivisible step. No timeouts, expiry, eviction or replica lag: the only variable is order. The reader retains the value it read even when the source later changes. Commit-then-delete starts with an empty cache; delete-then-commit starts with a saved £12.'} Presets load completed schedules; Back lets you inspect them in reverse, then choose a different next actor.</figcaption>
</figure>
<script>
import {raceInitial,raceStep,racePresets} from '../../lib/caching/invalidation.mjs';
document.querySelectorAll<HTMLElement>('[data-cache-race]').forEach(root=>{
 const guarded=root.dataset.guarded==='true',order=root.querySelector<HTMLSelectElement>('[data-order]');let history=[raceInitial('after',guarded)];
 const set=(n:string,v:string)=>{const el=root.querySelector(`[data-${n}]`);if(el)el.textContent=v;};
 const render=()=>{const s=history.at(-1)!;set('source',`£${s.source}`);set('cache',s.cache===null?'Empty':`£${s.cache}`);set('held',s.held===null?'Nothing':`£${s.held}`);set('captured',s.captured||'—');set('generation',s.generation);root.querySelector('[data-cache-card]')!.classList.toggle('key-wrong',s.cache!==null&&s.cache!==s.source);
 set('reader-next',['Look in cache','Read source','Try to fill cache','Finished'][s.reader]);const writes=s.order==='after'?['Commit £15','Invalidate cache','Finished']:['Invalidate cache','Commit £15','Finished'];set('writer-next',writes[s.writer]);set('explanation',s.message);
 root.querySelector<HTMLButtonElement>('[data-reader]')!.disabled=s.reader===3;root.querySelector<HTMLButtonElement>('[data-writer]')!.disabled=s.writer===2;root.querySelector<HTMLButtonElement>('[data-back]')!.disabled=history.length===1;
 root.querySelector('[data-log]')!.innerHTML=s.log.map((e,i)=>`<li class="${e.actor}"><span><small>${i+1} · ${e.actor==='reader'?'Reader':'Writer'}</small>${e.action}</span></li>`).join('');
 };
 const reset=()=>{history=[raceInitial(order?.value||'after',guarded)];render();};if(order)order.onchange=reset;
 for(const actor of ['reader','writer'])root.querySelector<HTMLButtonElement>(`[data-${actor}]`)!.onclick=()=>{history.push(raceStep(history.at(-1)!,actor));render();};
 root.querySelector<HTMLButtonElement>('[data-back]')!.onclick=()=>{history.pop();render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=reset;
 root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(button=>button.onclick=()=>{const p=racePresets[button.dataset.preset!];if(order)order.value=p.order;history=[raceInitial(p.order,guarded)];for(const actor of p.schedule)history.push(raceStep(history.at(-1)!,actor));render();});render();
});
</script>
