<figure class="cache-figure" data-redis-pipeline>
 <p class="figure-title">Send the next command before waiting for the previous reply</p>
 <div class="cache-controls"><label>Commands per batch <select data-batch aria-label="Pipeline batch size"><option value="1">1 · sequential</option><option value="2">2</option><option value="6">6 · one pipeline</option></select></label><label>Network round trip <input type="range" min="2" max="50" step="2" value="20" aria-label="Network round trip" data-rtt /><output data-rtt-label>20 ms</output></label></div>
 <p class="figure-note">Six independent commands, 2 ms execution each. Time runs left to right on the same scale for all batch sizes.</p>
 <div class="pipeline-rows" data-rows></div>
 <div class="pipeline-axis"><span>0 ms</span><span data-axis-end>132 ms</span></div>
 <div class="pipeline-legend"><span>Network travel</span><span>Server queue</span><span>Execution</span></div>
 <div class="cache-stat-row"><div><strong data-end>132 ms</strong><span>last reply</span></div><div><strong>12 ms</strong><span>total server execution</span></div></div>
 <div class="cache-controls"><button data-play>Play</button><button data-next>Next reply</button><button data-reset>Replay</button><label>Time <input type="range" min="0" max="132" value="0" step="1" data-time aria-label="Pipeline time" /><output data-time-label>0 ms</output></label></div>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>Grey bars are outward and return travel; dashed bars are server waiting; solid green bars are execution. The marker is current time. Batches wait for their last reply before sending another batch. Request/reply transmission time, connection setup and other clients are omitted. The numbers illustrate serial waiting, not measured Redis command speed.</figcaption>
</figure>
<script>
import {pipelineSchedule,pipelineState} from '../../lib/caching/clients.mjs';
document.querySelectorAll<HTMLElement>('[data-redis-pipeline]').forEach(root=>{
 const batch=root.querySelector<HTMLSelectElement>('[data-batch]')!,rtt=root.querySelector<HTMLInputElement>('[data-rtt]')!,time=root.querySelector<HTMLInputElement>('[data-time]')!,play=root.querySelector<HTMLButtonElement>('[data-play]')!;let schedule=pipelineSchedule(),frame=0,clock=0,last=0,announced='';
 const set=(name:string,v:string)=>root.querySelector(`[data-${name}]`)!.textContent=v;
 const stop=()=>{cancelAnimationFrame(frame);frame=0;play.textContent='Play';};
 const render=()=>{const t=+time.value;set('time-label',`${t} ms`);root.querySelectorAll<HTMLElement>('[data-row]').forEach((row,i)=>{const state=pipelineState(schedule.commands[i],t);row.querySelector('[data-status]')!.textContent=state;row.classList.toggle('complete',state==='complete');row.querySelector<HTMLElement>('.pipeline-cursor')!.style.left=`${t/schedule.serialEnd*100}%`;});const done=schedule.commands.filter(c=>c.reply<=t).length;const message=`${done} of 6 replies received. ${done===6?'All six commands executed, regardless of batch size.':`Batch size ${batch.value}; ${schedule.serverWork} ms of server work in total.`}`;if(message!==announced){set('explanation',message);announced=message;}root.querySelector<HTMLButtonElement>('[data-next]')!.disabled=t>=schedule.end;};
 const rebuild=()=>{stop();schedule=pipelineSchedule({batch:+batch.value,rtt:+rtt.value});time.max=String(schedule.serialEnd);time.value='0';set('rtt-label',`${rtt.value} ms`);set('axis-end',`${schedule.serialEnd} ms`);set('end',`${schedule.end} ms`);root.querySelector('[data-rows]')!.replaceChildren(...schedule.commands.map(c=>{const row=document.createElement('div');row.dataset.row='';const label=document.createElement('span');label.className='pipeline-label';label.textContent=`Command ${c.id}`;const track=document.createElement('div');track.className='pipeline-track';track.setAttribute('role','img');track.setAttribute('aria-label',`Command ${c.id}: sent ${c.sent}, executes ${c.execute} to ${c.done}, reply ${c.reply} milliseconds`);for(const [start,end,kind]of [[c.sent,c.arrive,'travel'],[c.arrive,c.execute,'queue'],[c.execute,c.done,'execute'],[c.done,c.reply,'travel']]as [number,number,string][]){const bar=document.createElement('span');bar.className=kind;bar.style.left=`${start/schedule.serialEnd*100}%`;bar.style.width=`${(end-start)/schedule.serialEnd*100}%`;bar.title=`${kind}: ${end-start} ms`;track.append(bar);}const cursor=document.createElement('i');cursor.className='pipeline-cursor';track.append(cursor);const state=document.createElement('small');state.dataset.status='';row.append(label,track,state);return row;}));render();};
 const tick=(now:number)=>{clock+=(now-last)/25;last=now;time.value=String(Math.min(schedule.end,Math.round(clock)));render();if(clock>=schedule.end)stop();else frame=requestAnimationFrame(tick);};
 play.onclick=()=>{if(frame)stop();else{if(+time.value>=schedule.end)time.value='0';clock=+time.value;last=performance.now();play.textContent='Pause';frame=requestAnimationFrame(tick);}};
 root.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>{stop();time.value=String(schedule.commands.find(c=>c.reply>+time.value)?.reply??schedule.end);render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{stop();time.value='0';render();};time.oninput=()=>{stop();render();};batch.onchange=rtt.oninput=rebuild;document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});if(matchMedia('(prefers-reduced-motion: reduce)').matches)play.disabled=true;rebuild();
});
</script>
