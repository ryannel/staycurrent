<figure class="cache-figure" data-cache-aside>
  <p class="figure-title">One request, two possible paths</p>
  <svg class="cache-flow" viewBox="0 0 400 440" role="img" aria-label="The application looks in Redis. On a miss, the application reads the database and saves a copy in Redis.">
    <defs><marker id="cache-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10" fill="var(--color-rule-strong)" /></marker></defs>
    <path class="route" data-path="lookup" d="M120 145 L40 300" marker-end="url(#cache-arrow)" />
    <path class="route" data-path="cache-return" d="M100 300 L160 145" marker-end="url(#cache-arrow)" />
    <path class="route" data-path="load" d="M240 145 L290 300" marker-end="url(#cache-arrow)" />
    <path class="route" data-path="source-return" d="M350 300 L280 145" marker-end="url(#cache-arrow)" />
    <text x="45" y="200" text-anchor="middle" class="minor">GET / SET</text>
    <text x="352" y="200" text-anchor="middle" class="minor">Read source</text>
    <rect class="node" x="100" y="10" width="200" height="135" rx="8" />
    <text x="200" y="45" text-anchor="middle">Application</text>
    <text x="200" y="80" text-anchor="middle" class="minor">Product page</text>
    <text x="200" y="115" text-anchor="middle" data-answer>Waiting</text>
    <rect class="node" x="0" y="300" width="190" height="120" rx="8" />
    <text x="95" y="332" text-anchor="middle">Redis · copy</text>
    <text x="95" y="365" text-anchor="middle" data-cached>Empty</text>
    <text x="95" y="399" text-anchor="middle" class="minor">product:42</text>
    <rect class="node" x="210" y="300" width="190" height="120" rx="8" />
    <text x="305" y="332" text-anchor="middle">Database · source</text>
    <text x="305" y="365" text-anchor="middle">Blue mug · £12</text>
    <text x="305" y="399" text-anchor="middle" class="minor">Product 42</text>
    <circle class="packet" r="7" cx="120" cy="145" hidden />
  </svg>
  <div class="cache-controls">
    <button data-play>Play request</button><button data-back disabled>Back</button><button data-next>Next step</button><button data-repeat disabled>Request again</button><button data-reset>Empty cache</button>
  </div>
  <p class="explanation" aria-live="polite" data-explanation>The application needs the blue mug’s product details.</p>
  <figcaption>Follow the first request, then choose <strong>Request again</strong>. The second request takes the Redis path only. This is a serial teaching model; animation time is slowed down and does not represent Redis latency.</figcaption>
</figure>
<script>
  import { cacheAsideTrace } from '../../lib/caching/intro.mjs';
  document.querySelectorAll<HTMLElement>('[data-cache-aside]').forEach(root => {
    let trace=cacheAsideTrace(), step=0, timer:ReturnType<typeof setInterval>|undefined, animation:Animation|undefined;
    const button=(name:string)=>root.querySelector<HTMLButtonElement>(`[data-${name}]`)!;
    const text=(name:string,value:string)=>{root.querySelector(`[data-${name}]`)!.textContent=value;};
    const pause=()=>{clearInterval(timer);timer=undefined;button('play').textContent='Play request';};
    const render=()=>{
      const s=trace[step];
      text('cached',s.cached ?? 'Empty'); text('answer',s.answer ?? 'Waiting'); text('explanation',`${step+1}/${trace.length} · ${s.explanation}`);
      root.querySelectorAll<SVGPathElement>('[data-path]').forEach(p=>p.classList.toggle('active',p.dataset.path===(s.path==='fill'?'lookup':s.path)));
      button('back').disabled=step===0;button('next').disabled=step===trace.length-1;button('repeat').disabled=step!==trace.length-1;button('play').disabled=step===trace.length-1;
      animation?.cancel(); const packet=root.querySelector<SVGCircleElement>('.packet')!;
      const path=s.path && root.querySelector<SVGPathElement>(`[data-path="${s.path==='fill'?'lookup':s.path}"]`);
      packet.style.display=path?'block':'none';
      if(path){const end=path.getPointAtLength(path.getTotalLength());packet.setAttribute('cx',String(end.x));packet.setAttribute('cy',String(end.y));
        if(!matchMedia('(prefers-reduced-motion: reduce)').matches){const start=path.getPointAtLength(0);animation=packet.animate([{transform:`translate(${start.x-end.x}px,${start.y-end.y}px)`},{transform:'translate(0,0)'}],{duration:650,easing:'ease-in-out'});}}
    };
    const advance=()=>{if(step<trace.length-1)step++;if(step===trace.length-1)pause();render();};
    button('next').onclick=()=>{pause();advance();};button('back').onclick=()=>{pause();step=Math.max(0,step-1);render();};
    button('play').onclick=()=>{if(timer){pause();return;}advance();if(step<trace.length-1){button('play').textContent='Pause';timer=setInterval(advance,1200);}};
    button('repeat').onclick=()=>{pause();trace=cacheAsideTrace({cached:trace.at(-1)!.cached});step=0;render();};
    button('reset').onclick=()=>{pause();trace=cacheAsideTrace();step=0;render();};
    document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();});render();
  });
</script>
