---
// Figure: latency cache or capacity cache. Database load against read traffic, warm and empty.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import './operating.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="op-capacity" title="Which traffic the database survives, with and without the cache" controls="none"
  caption="Arithmetic, not a simulation, using Bronson and colleagues' own example: a database that can answer 300 queries a second receives the misses, R × (1 − h) a second while the cache is warm and all R reads when it is empty. The marker is the shop's traffic in this article, 1,000 product reads a second. Left out: the extra cost of an overloaded database, retries, and the queries that are not cache misses at all, such as writes.">
  <Slider slot="params" name="hit" label="Hit ratio" value={0.9} format="percent" stops={[0.5, 0.8, 0.9, 0.95, 0.99]} />
  <Fragment slot="stats">
    <Readout name="cold" label="Survives an empty cache up to" kind="miss" />
    <Readout name="warm" label="Survives a warm cache up to" kind="database" />
    <Readout name="today" label="1,000 reads a second is" kind="client" />
  </Fragment>
  <Fragment slot="text">
    <p>The database answers 300 queries a second. With an empty cache every read is a query, so it copes with up to 300 reads a second whatever the hit ratio. With a warm cache it receives only the misses, so it copes with up to 300 ÷ (1 − h) reads a second: 600 at a 50% hit ratio, 1,500 at 80%, 3,000 at 90%, 6,000 at 95% and 30,000 at 99%.</p>
    <p>Between 300 reads a second and that upper limit the system works only while the cache is warm. The shop's 1,000 reads a second fall in that range at every hit ratio above 70%, so its database would be overloaded more than three times over if the cache emptied.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { CAPACITY, TODAY, X_MAX, zones, classify, loadLines } from './capacity-model.mjs';

  const n = (v: number) => Math.round(v).toLocaleString('en-GB');
  document.querySelectorAll<HTMLElement>('[data-figure-id="op-capacity"]').forEach(root => {
    const chart = lineChart(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Database queries a second against read requests a second, with a warm cache and with an empty one, and the database capacity',
      height: 260,
      x: { label: 'Product reads a second', domain: [0, X_MAX], tickStep: 2000, format: (v: number) => n(v) },
      y: { label: 'Database queries a second', domain: [0, 1200], tickStep: 300, format: (v: number) => n(v) },
      series: [
        { id: 'warm', label: 'Database load, warm cache', kind: 'database', dash: '' },
        { id: 'cold', label: 'Database load, empty cache', kind: 'miss', dash: '6 4' },
      ],
      rules: [{ y: CAPACITY, label: 'Database capacity', kind: 'error' }],
      markers: [{ id: 'today', x: TODAY, label: 'The shop today', kind: 'client' }],
    });
    bindParams(root, params => {
      const h = Number(params.hit);
      const lines = loadLines(h);
      chart.set('warm', lines.warm);
      chart.set('cold', lines.cold);
      const { stable, vulnerable } = zones(h);
      chart.band('safe', 0, stable, 'Safe either way', 'database');
      chart.band('needs', stable, Math.min(vulnerable, X_MAX), 'Needs the cache', 'neutral');
      if (vulnerable < X_MAX) chart.band('over', vulnerable, X_MAX, 'Too much even when warm', 'error');
      else chart.band('over', null);
      chart.render();
      const where = classify(TODAY, h);
      setReadouts(root, {
        cold: `${n(stable)} a second`,
        warm: `${n(vulnerable)} a second`,
        today: where === 'stable' ? 'safe either way' : where === 'vulnerable' ? 'safe only while warm' : 'too much even warm',
      });
    });
  });
</script>
