---
// Figure: which diagnostic tool sees which part of one stall.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import './redis.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="redis-tools" title="One stall, five tools" controls="none"
  legend={[{ kind: 'redis', label: 'KEYS * running' }, { kind: 'neutral', label: 'Other requests' }, { kind: 'client', label: 'Request waiting' }]}
  caption="The timeline is schematic: one KEYS * of 107 ms, a GET from the application that arrives during it, and redis-cli --latency sending a PING, waiting for the reply and sleeping 10 ms. The outputs are copied from my runs on a laptop with Redis 8.10.3 and a million keys. SLOWLOG, LATENCY and INFO come from one run in which KEYS * executed for 107 ms; redis-cli --latency's output is from a separate run in which it executed for 97.7 ms, as each panel says. The latency monitor was switched on with a 10 ms threshold, because it is off by default.">
  <Choice slot="params" name="tool" label="Look with" value="app"
    options={[{ value: 'app', label: 'App timer' }, { value: 'slowlog', label: 'SLOWLOG' }, { value: 'latency', label: 'LATENCY' }, { value: 'cli', label: 'redis-cli --latency' }, { value: 'stats', label: 'INFO latencystats' }]} />
  <div data-strip></div>
  <div slot="after" class="redis-report" data-report aria-live="polite"></div>
  <Fragment slot="text">
    <p>A timeline of one stall: KEYS * holds Redis's main thread for about 100 ms; a GET from the application arrives during it and waits; redis-cli --latency's PINGs wait too. Each tool sees a different part.</p>
    <ul>
      <li>The application's own timer sees the victim: a GET that took almost as long as KEYS. It cannot tell why.</li>
      <li>SLOWLOG records the culprit: KEYS *, 106,972 µs of execution, with the client's address. It never lists the GET, whose execution took microseconds; the slow log measures execution only, not waiting.</li>
      <li>The latency monitor, once a threshold is set, records that a command event of 106 ms happened and when, but not which command.</li>
      <li>redis-cli --latency, which times PINGs from outside like any client, reported a maximum of 94.9 ms while its average stayed at 0.49 ms, in a separate run in which KEYS executed for 97.7 ms.</li>
      <li>INFO latencystats and commandstats summarise execution time per command: KEYS at about 107 ms; GET unchanged at a fraction of a microsecond per call.</li>
    </ul>
  </Fragment>
</SimFigure>
<script>
  import { bindParams } from '../shared/player.mjs';
  import { threadStrip } from './strip.mjs';

  const KEYS = { start: 20000, end: 127000 };
  const GET = { sent: 30000, served: 127000 };
  // Ordinary requests on the main thread, at fixed illustrative times.
  const others = Array.from({ length: 16 }, (_, i) => 2000 + i * 9700).filter(t => t < KEYS.start || t > KEYS.end + 400);
  // redis-cli --latency sends PING, waits for the reply, sleeps 10 ms, and repeats,
  // so only one PING is ever outstanding: the one that lands in the stall waits for all of it.
  const pings: number[] = [];
  for (let t = 6000; t < 160000;) {
    pings.push(t);
    const served = t >= KEYS.start && t < KEYS.end ? KEYS.end : t + 100;
    t = served + 10200;
  }
  const stuck = pings.find(t => t >= KEYS.start && t < KEYS.end)!;

  const REPORTS: Record<string, { kind: string; title: string; output: string; meaning: string; span: any }> = {
    app: {
      kind: 'client', title: 'Your application’s timer around GET',
      output: 'GET product:42 took 97 ms   (schematic; my probe client measured a 100.1 ms PING during a 99 ms KEYS)',
      meaning: 'It sees the victim, which is what users feel. It cannot tell you that the GET itself was fast and the wait was caused by someone else’s command.',
      span: { start: GET.sent, end: GET.served + 200, label: 'GET took 97 ms', kind: 'client' },
    },
    slowlog: {
      kind: 'redis', title: 'SLOWLOG GET 1',
      output: '2) 1793135872   3) 106972   4) 1) "keys" 2) "*"   5) "127.0.0.1:64812"',
      meaning: 'It names the culprit, how long it executed (106,972 µs), when, and which client sent it. It never lists the GET: the slow log times execution only, and the GET executed in microseconds.',
      span: { start: KEYS.start, end: KEYS.end, label: 'KEYS *: 106,972 µs', kind: 'redis' },
    },
    latency: {
      kind: 'redis', title: 'LATENCY LATEST (with latency-monitor-threshold 10)',
      output: '1) "command"   2) 1793135872   3) 106   4) 106',
      meaning: 'It records that a slow-command event of 106 ms happened, and when, but not which command. It is off by default (threshold 0) and also records non-command events such as fork and expire-cycle.',
      span: { start: KEYS.start, end: KEYS.end, label: 'event "command": 106 ms', kind: 'redis' },
    },
    cli: {
      kind: 'client', title: 'redis-cli --latency',
      output: 'min: 0.096, max: 94.949, avg: 0.487 (317 samples)   (a separate run, in which KEYS * executed for 97.7 ms)',
      meaning: 'It times PING from outside, so it sees what any client sees: a maximum near the stall’s length (94.9 ms against 97.7 ms of KEYS in that run). The average hides it completely. It says nothing about the cause.',
      span: { start: stuck, end: KEYS.end + 100, label: 'one PING waited for the rest of KEYS', kind: 'client' },
    },
    stats: {
      kind: 'redis', title: 'INFO latencystats, INFO commandstats',
      output: 'latency_percentiles_usec_keys:p50=107479.039,...\ncmdstat_get:...,usec_per_call=0.05',
      meaning: 'Execution time per command type, accumulated since the last reset. KEYS stands out; GET looks as fast as ever, because waiting is not execution.',
      span: { start: KEYS.start, end: KEYS.end, label: 'keys: p50 107 ms', kind: 'redis' },
    },
  };

  document.querySelectorAll<HTMLElement>('[data-figure-id="redis-tools"]').forEach(root => {
    const report = root.querySelector<HTMLElement>('[data-report]')!;
    const strip = threadStrip(root.querySelector<HTMLElement>('[data-strip]')!, {
      label: 'Timeline of one KEYS stall, with a waiting GET and waiting PINGs',
      lanes: [
        { id: 'app', label: 'Application', short: 'App' },
        { id: 'cli', label: 'redis-cli', short: 'cli' },
        { id: 'main', label: 'Main thread', short: 'Main' },
      ],
      laneHeight: 28,
      format: (v: number) => `${Math.round(v / 1000)} ms`,
      axisLabel: 'Time (ms)',
    });
    bindParams(root, (params: any) => {
      const r = REPORTS[params.tool];
      const waits: any[] = [{ lane: 'app', start: GET.sent, end: GET.served }];
      for (const t of pings) {
        const inside = t >= KEYS.start && t < KEYS.end;
        waits.push({ lane: 'cli', start: t, end: inside ? KEYS.end : t + 100 });
      }
      const blocks: any[] = [{ lane: 'main', start: KEYS.start, end: KEYS.end, kind: 'redis', label: 'KEYS *' }];
      for (const t of others) blocks.push({ lane: 'main', start: t, end: t + 7, kind: 'socket' });
      for (const t of pings) {
        const at = t >= KEYS.start && t < KEYS.end ? KEYS.end + 2 : t + 50;
        blocks.push({ lane: 'main', start: at, end: at + 7, kind: 'socket' });
      }
      blocks.push({ lane: 'main', start: GET.served + 9, end: GET.served + 16, kind: 'socket' });
      strip.render({ from: 0, to: 160000, blocks, waits, spans: [r.span] });
      report.dataset.cacheKind = r.kind;
      report.replaceChildren();
      const title = document.createElement('strong');
      title.textContent = r.title;
      const code = document.createElement('code');
      code.textContent = r.output;
      const meaning = document.createElement('p');
      meaning.style.margin = '.35rem 0 0';
      meaning.textContent = r.meaning;
      report.append(title, code, meaning);
    });
  });
</script>
