<figure class="cache-figure" data-replication-loss>
 <p class="figure-title">A deletion can be lost too</p>
 <div class="cache-controls"><button data-source>1. Change source to 15</button><button data-delete>2. Delete cached value</button><button data-deliver>Deliver deletion to replica</button><button data-fail>3. Fail primary</button><button data-promote>4. Promote replica</button><button data-reset>Reset replication</button></div>
 <div class="recovery-authority">Authoritative source <strong data-source-value>12</strong><small>Survives this Redis failure</small></div>
 <div class="recovery-pair"><div class="recovery-node" data-primary-box><b>Redis primary</b><strong data-primary-value>12</strong><small data-primary-state>Serving requests</small></div><div class="recovery-node" data-replica-box><b data-replica-role>Redis replica</b><strong data-replica-value>12</strong><small data-replica-state>Read-only copy</small></div></div>
 <div class="replication-stream" role="img" aria-label="Replication delivery" data-stream><span>Primary</span><div><i data-packet hidden>DEL →</i></div><span>Replica</span></div>
 <p class="recovery-receipt" data-receipt>No invalidation sent yet.</p>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>Change the source, delete its cached copy, then fail the primary before delivering the deletion. Reset and deliver it before failing. This is a controlled schedule with one replica, no expiry and no persistence; it does not model Sentinel’s replica-selection algorithm. “Empty” means a cache miss, not an empty authoritative record.</figcaption>
</figure>
<script>
import{replicationInitial,replicationStep}from'../../lib/caching/recovery.mjs';
document.querySelectorAll<HTMLElement>('[data-replication-loss]').forEach(root=>{let s=replicationInitial();const text=(k:string,v:string|number)=>root.querySelector(`[data-${k}]`)!.textContent=String(v);const render=()=>{text('source-value',s.source);text('primary-value',s.failed?'Offline':s.primary??'Empty');text('replica-value',s.replica??'Empty');text('primary-state',s.failed?'Its memory is unavailable':'Serving requests');text('replica-role',s.promoted?'New primary':'Redis replica');text('replica-state',s.promoted?'Now serving requests':'Read-only copy');root.querySelector('[data-primary-box]')!.classList.toggle('recovery-offline',s.failed);root.querySelector('[data-replica-box]')!.classList.toggle('recovery-promoted',s.promoted);root.querySelector('[data-stream]')!.classList.toggle('delivered',s.delivered);root.querySelector('[data-stream]')!.classList.toggle('lost',s.failed&&!s.delivered);root.querySelector<HTMLElement>('[data-packet]')!.hidden=!s.deleted;text('packet',s.delivered?'DEL ✓':s.failed?'DEL lost':'DEL →');text('receipt',s.deleted?`Primary replied: DEL = 1. Replica acknowledgements for that deletion: ${s.delivered?1:0}.`:'No invalidation sent yet.');text('explanation',s.promoted?s.delivered?'The promoted replica is empty. A cache miss can load the source’s current value, 15.':'The new primary still holds 12. A hit now returns the old value, although the earlier primary acknowledged deleting it.':s.failed?'The primary failed. Promote the surviving replica and inspect what it actually has.':s.delivered?'The replica has applied the deletion. Fail the primary and compare the result.':s.deleted?'The primary deleted 12 and replied. The replica still holds 12; its deletion has not arrived.':s.source===15?'The source now holds 15. Both cached copies still hold 12.':'Both Redis copies start with 12. First change the authoritative source.');const disabled={source:s.source===15,delete:s.source!==15||s.deleted||s.failed,deliver:!s.deleted||s.delivered||s.failed,fail:!s.deleted||s.failed,promote:!s.failed||s.promoted};for(const[k,v]of Object.entries(disabled))root.querySelector<HTMLButtonElement>(`[data-${k}]`)!.disabled=v;};for(const a of['source','delete','deliver','fail','promote'])root.querySelector<HTMLButtonElement>(`[data-${a}]`)!.onclick=()=>{s=replicationStep(s,a);render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{s=replicationInitial();render();};render();});
</script>
