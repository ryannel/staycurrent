---
// Figure: a crash between the two writes of write-through, in either order.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import './patterns.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="pattern-write-order" title="A failure between the two writes" controls="steps"
  caption="A sequence of steps, not a timed simulation. The failure could be a crash, a timeout or a rejected transaction; any of them leaves the second write undone. Both orders assume nothing else touches the key meanwhile.">
  <Choice slot="params" name="order" label="The writer updates" value="database"
    options={[{ value: 'database', label: 'the database first' }, { value: 'redis', label: 'Redis first' }]} />
  <Fragment slot="text">
    <p>Database first: the writer commits £35 to the database, then fails before updating Redis. Readers get £39 from Redis, a stale hit, until the cached copy expires or a later write replaces it. The next read after expiry misses, reads £35 and caches it, and the two agree again.</p>
    <p>Redis first: the writer puts £35 in Redis, then the database rejects or never receives the update and still holds £39. Readers get £35 from Redis, a price the database never accepted, until the copy expires. The next read after expiry caches £39 again. The time to live bounds both failures, but the second shows readers a value that was never true.</p>
  </Fragment>
</SimFigure>
<script>
  import { switchSequence } from './switch-sequence.mjs';
  const lanes = [
    { id: 'writer', label: 'Writer', kind: 'write' },
    { id: 'redis', label: 'Redis', kind: 'redis' },
    { id: 'db', label: 'Database', kind: 'database' },
    { id: 'reader', label: 'Reader', kind: 'client' },
  ];
  const initial = { redis: '£39', db: '£39' };
  const specs = {
    database: {
      label: 'Sequence: the writer updates the database, then fails before updating Redis',
      intro: 'Redis and the database both hold the price £39. A writer changes it to £35, writing the database first and Redis second.',
      lanes, initial,
      steps: [
        { from: 'writer', to: 'db', label: 'UPDATE £35', kind: 'write', state: { db: '£35' }, explanation: 'The writer commits £35 to the database. This is the write that counts: the database is the source of truth.' },
        { at: 'writer', note: 'fails', kind: 'error', explanation: 'Before it reaches Redis, the writer fails: the process dies, or its request to Redis times out.' },
        { from: 'redis', to: 'reader', label: '£39', kind: 'stale', state: { reader: '£39' }, explanation: 'A reader asks Redis and gets £39. It is a hit, but a stale one: the database says £35.' },
        { at: 'redis', note: 'expires', kind: 'expiry', state: { redis: 'none' }, explanation: 'Nothing corrects Redis until the cached copy expires or a later write replaces it. The time to live is the limit on how long the old price is served.' },
        { from: 'db', to: 'reader', label: '£35', kind: 'miss', state: { reader: '£35' }, explanation: 'The next read misses and reads £35 from the database.' },
        { from: 'reader', to: 'redis', label: 'SET £35', kind: 'write', state: { redis: '£35' }, explanation: 'It caches £35. Redis and the database agree again.' },
      ],
    },
    redis: {
      label: 'Sequence: the writer updates Redis, then the database write fails',
      intro: 'Redis and the database both hold the price £39. A writer changes it to £35, writing Redis first and the database second.',
      lanes, initial,
      steps: [
        { from: 'writer', to: 'redis', label: 'SET £35', kind: 'write', state: { redis: '£35' }, explanation: 'The writer puts £35 in Redis first.' },
        // Drawn as a note, like "fails" in the other order: an arrow would read as a delivered write.
        { at: 'db', note: 'UPDATE £35 fails', kind: 'error', explanation: 'The database write fails: a constraint rejects it, a deadlock aborts the transaction, or the writer dies before committing. The database still holds £39.' },
        { from: 'redis', to: 'reader', label: '£35', kind: 'stale', state: { reader: '£35' }, explanation: 'A reader asks Redis and gets £35, a price the database never accepted. The checkout, which reads the database, will charge £39.' },
        { at: 'redis', note: 'expires', kind: 'expiry', state: { redis: 'none' }, explanation: 'This lasts until the key expires. It is worse than an old value: it was never true.' },
        { from: 'db', to: 'reader', label: '£39', kind: 'miss', state: { reader: '£39' }, explanation: 'The next read misses and reads £39 from the database.' },
        { from: 'reader', to: 'redis', label: 'SET £39', kind: 'write', state: { redis: '£39' }, explanation: 'It caches £39, and Redis agrees with the database again.' },
      ],
    },
  };
  document.querySelectorAll<HTMLElement>('[data-figure-id="pattern-write-order"]').forEach(root => switchSequence(root, specs, 'order'));
</script>
