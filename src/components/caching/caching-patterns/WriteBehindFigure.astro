---
// Figure: write-behind view counters, a flush interval and a restart button.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import './patterns.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="pattern-write-behind" title="Write-behind trades database writes for exposure" legend={['client', 'write']} advance={1000}
  caption="Illustrative model: about eight page views a second spread over four product counters. Each view is acknowledged once Redis has counted it. The flusher takes each counter with GETDEL and adds it to the database in one write. Redis runs without persistence, so a restart loses every view not yet flushed. Travel times are slowed for watching.">
  <Slider slot="params" name="interval" label="Flush every" min={1} max={30} step={1} value={5} format="seconds" />
  <button slot="params" type="button" class="cache-button pattern-action" data-restart>Restart Redis</button>
  <Fragment slot="stats">
    <Readout name="views" label="Views acknowledged" value="0" kind="client" />
    <Readout name="pending" label="Only in Redis" value="0" kind="redis" />
    <Readout name="writes" label="Database writes" value="0" kind="database" />
    <Readout name="lost" label="Lost in restarts" value="0" kind="error" />
  </Fragment>
  <p slot="after" class="pattern-status" data-status aria-live="polite"></p>
  <Fragment slot="text">
    <p>Views travel from the clients to the application and on to Redis, which counts them; each is acknowledged at that point. Every few seconds the flusher moves each counter's total to the database in a single write. With a 5-second interval the database receives at most four writes every five seconds however many views arrive, and Redis holds on average about 20 views that exist nowhere else. Pressing Restart Redis loses those views. Stretching the interval to 30 seconds cuts the database's writes to four every 30 seconds but leaves about 120 views exposed on average; shrinking it to 1 second exposes about 4 but sends up to four writes a second.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { createScene, spread } from '../shared/scene.mjs';
  import { writeBehind, updateWriteBehind } from './write-behind-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="pattern-write-behind"]').forEach(root => {
    const scene = createScene(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Clients send page views to an application, which increments counters in Redis; a flusher moves the counts to the database',
      nodes: [
        { id: 'clients', kind: 'client', label: 'Visitors', count: 3 },
        { id: 'app', kind: 'app', label: 'Application' },
        { id: 'redis', kind: 'redis', label: 'Redis' },
        { id: 'database', kind: 'database', label: 'Database' },
      ],
      edges: [
        { id: 'client-app', from: 'clients', to: 'app' },
        { id: 'app-redis', from: 'app', to: 'redis', label: 'INCR' },
        { id: 'redis-database', from: 'redis', to: 'database', label: 'flush', dashed: true },
      ],
      layout: (width, compact) => {
        if (compact) {
          // A Z shape: the INCR edge runs diagonally, so it does not pass under Redis's badge.
          const [a, b] = spread(width, 2, 70);
          return { height: 270, positions: { clients: [a, 62], app: [b, 62], redis: [a, 200], database: [b, 200] } };
        }
        const xs = spread(width, 4, 70);
        return { height: 170, positions: { clients: [xs[0], 80], app: [xs[1], 80], redis: [xs[2], 80], database: [xs[3], 80] } };
      },
    });
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const sim = mountSim(root, {
      seed: 3,
      create: (params, seed) => writeBehind({ interval: params.interval, rate: 8 }, seed),
      update: updateWriteBehind,
      render(model: any) {
        scene.dots(model.movers.active());
        const pending = model.pending();
        const next = Math.max(0, (model.nextFlush - model.sim.now) / 1000);
        scene.node('redis').set({ badge: `${pending} waiting`, badgeKind: 'redis', sublabel: `flush in ${next.toFixed(1)} s` });
        scene.node('database').set({ badge: model.stats.flushed.toLocaleString('en-GB'), badgeKind: 'database', sublabel: 'views stored' });
        setReadouts(root, {
          views: model.stats.acknowledged.toLocaleString('en-GB'),
          pending: pending.toLocaleString('en-GB'),
          writes: model.stats.databaseWrites.toLocaleString('en-GB'),
          lost: model.stats.lost.toLocaleString('en-GB'),
        });
        if (!model.stats.restarts) status.textContent = '';
      },
    });
    root.querySelector<HTMLButtonElement>('[data-restart]')!.addEventListener('click', () => {
      const lost = sim.model.restart();
      status.textContent = `Redis restarted at ${(sim.model.sim.now / 1000).toFixed(1)} s and lost ${lost} acknowledged ${lost === 1 ? 'view' : 'views'} that had not reached the database.`;
      sim.advance(0);
    });
  });
</script>
