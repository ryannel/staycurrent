---
// Figure: a write-behind flusher writes an old value over a newer database write.
import SimFigure from '../shared/SimFigure.astro';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="pattern-flush-conflict" title="The flusher overwrites a newer write" controls="steps"
  caption="A sequence of steps, not a timed simulation. The product row holds a price and a description; the flusher writes the whole cached product, as a write-behind queue of whole objects does.">
  <Fragment slot="text">
    <ol>
      <li>Redis and the database both hold the product at £39 with its old description.</li>
      <li>A merchant edits the description. The shop application writes the whole product to Redis, acknowledges the edit and queues the product for the database.</li>
      <li>A pricing job, which writes the database directly, cuts the price to £35.</li>
      <li>The flusher writes the queued product to the database: the new description and the old price of £39.</li>
      <li>The price cut is lost, and nothing reported an error.</li>
    </ol>
  </Fragment>
</SimFigure>
<script>
  import { sequenceFigure } from '../shared/sequence.mjs';
  document.querySelectorAll<HTMLElement>('[data-figure-id="pattern-flush-conflict"]').forEach(root => {
    sequenceFigure(root, {
      label: 'Sequence: a write-behind flush overwrites a price change made directly in the database',
      intro: 'Redis and the database both hold product 42: £39, with its old description.',
      lanes: [
        { id: 'app', label: 'Shop app', kind: 'app' },
        { id: 'redis', label: 'Redis', kind: 'redis' },
        { id: 'job', label: 'Pricing job', kind: 'client' },
        { id: 'db', label: 'Database', kind: 'database' },
      ],
      initial: { redis: '£39 · old', db: '£39 · old' },
      steps: [
        { from: 'app', to: 'redis', label: 'SET product', kind: 'write', state: { redis: '£39 · new' }, explanation: 'A merchant edits the description. The shop app writes the whole product to Redis, tells the merchant it is saved, and queues it for the database.' },
        { from: 'job', to: 'db', label: 'UPDATE £35', kind: 'write', state: { db: '£35 · old' }, explanation: 'A pricing job cuts the price to £35. It writes the database directly and knows nothing of the queue.' },
        { from: 'redis', to: 'db', label: 'flush product', kind: 'stale', state: { db: '£39 · new' }, explanation: 'The flusher writes the queued product: the new description, and the £39 it was holding.' },
        { at: 'db', note: 'price cut lost', kind: 'error', explanation: 'The price cut is gone and no one saw an error. Until the flush, Redis was the owner of this row, but the pricing job did not know that.' },
      ],
    });
  });
</script>
