---
// Figure: what a write does to the cached copy (leave, delete or update).
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './patterns.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="pattern-write-policy" title="What a write does to the cached copy" legend={['hit', 'miss', 'stale', 'write', 'expiry']} advance={5000}
  caption="Illustrative model: six products read about three times a second, most often product:1, and repriced about once every three seconds, the popular products most often. Each cached copy lives for 12 seconds. Every option replays exactly the same reads and writes. Requests take no time here; what is left out is any delay between steps, which is where the races covered under invalidation live.">
  <Choice slot="params" name="policy" label="After writing the database, the application" value="leave"
    options={[{ value: 'leave', label: 'leaves Redis alone' }, { value: 'delete', label: 'deletes the key' }, { value: 'update', label: 'updates the key' }]} />
  <Fragment slot="stats">
    <Readout name="reads" label="Reads" value="0" />
    <Readout name="hit" label="Hit ratio" value="–" kind="hit" />
    <Readout name="stale" label="Stale reads" value="0" kind="stale" />
  </Fragment>
  <Fragment slot="text">
    <p>Each row is one product. The first box is the version in the database, the second the version cached in Redis, with a bar showing how much of its 12-second lifetime is left. Reads appear on the right as hits, misses or stale reads; price changes appear as writes.</p>
    <p>When the application leaves Redis alone, every write makes the database's version newer than the cached one, and every read of that product returns the old price until the copy expires. Whenever you look, roughly a quarter to two-fifths of the reads so far have been stale, while the hit ratio is about 88%. When the application deletes the key, no read is stale; the first read after each write misses and fetches the new version, and the hit ratio falls to about 85%. When it updates the key, no read is stale and no write causes a miss, so the hit ratio is about 91%, the highest of the three.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { eventStrips } from './strips.mjs';
  import { writePolicy, summary, PRODUCTS } from './write-policy-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="pattern-write-policy"]').forEach(root => {
    const strips = eventStrips(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Six products, each with its database version, its cached version in Redis, and its recent reads and writes',
      rows: Array.from({ length: PRODUCTS }, (_, i) => ({ id: String(i), label: `product:${i + 1}` })),
      cells: [{ id: 'db', label: 'Database', width: 76, compactWidth: 58 }, { id: 'redis', label: 'Redis', width: 76, compactWidth: 58 }],
      labelWidth: [96, 82],
    });
    mountSim(root, {
      seed: 11,
      create: (params, seed) => writePolicy({ policy: params.policy }, seed),
      // Rebuild on every change, so each option replays the same reads and writes.
      update: () => false,
      render(model: any) {
        const now = model.sim.now;
        const data: Record<string, any> = {};
        model.rows.forEach((row: any, i: number) => {
          const entry = row.redis && row.redis.expiresAt > now ? row.redis : null;
          const stale = entry && entry.version < row.db;
          data[String(i)] = {
            events: row.events,
            cells: {
              db: { text: `v${row.db}`, kind: 'database' },
              redis: entry
                ? { text: `v${entry.version}`, kind: stale ? 'stale' : 'redis', bar: (entry.expiresAt - now) / model.params.ttl }
                : { text: 'none', kind: 'neutral' },
            },
          };
        });
        strips.render(now, data);
        const s = summary(model);
        setReadouts(root, {
          reads: model.stats.reads.toLocaleString('en-GB'),
          hit: model.stats.reads ? `${Math.round(s.hitRatio * 100)}%` : '–',
          stale: model.stats.reads ? `${model.stats.stale} (${Math.round(s.staleShare * 100)}%)` : '0',
        });
      },
    });
  });
</script>
