---
// Figure: each write costs the next read a miss (delete versus update on one key).
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import './patterns.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="pattern-ceiling" title="Each write costs the next read a miss" legend={['hit', 'miss', 'write']} advance={5000}
  caption="Illustrative model: one key read about twice a second, with reads and writes arriving at random. Both rows receive exactly the same reads and writes; the top row deletes the cached copy on each write, the bottom row replaces it. Nothing expires or is evicted, so writes are the only cause of misses.">
  <Slider slot="params" name="perWrite" label="Reads per write" min={1} max={20} step={1} value={4} />
  <Fragment slot="stats">
    <Readout name="deleteHit" label="Delete: hit ratio so far" value="–" kind="hit" />
    <Readout name="expected" label="Delete: expected, k ÷ (k + 1)" value="80%" />
    <Readout name="unread" label="Update: cache writes never read" value="–" kind="write" />
  </Fragment>
  <Fragment slot="text">
    <p>Both rows show the same stream of reads and writes to one key. In the delete row, every write is followed by exactly one miss, the first read after it; later reads hit until the next write. Within a minute or so, the hit ratio settles near 80% with four reads per write, near 50% with one read per write, and near 95% with nineteen. In the update row no read ever misses, but when two writes arrive with no read between them, the first cache write was wasted: about one write in five at four reads per write, one in two at one read per write.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { eventStrips } from './strips.mjs';
  import { ceiling, deleteHitRatio } from './ceiling-model.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="pattern-ceiling"]').forEach(root => {
    const strips = eventStrips(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'One key under the same reads and writes, deleted on write in the top row and updated on write in the bottom row',
      rows: [{ id: 'delete', label: 'Delete' }, { id: 'update', label: 'Update' }],
      cells: [{ id: 'ratio', label: 'Hit ratio', width: 84, compactWidth: 66 }],
      labelWidth: [72, 60],
      // Wider spacing on phones, so the miss after each write stays visible.
      pxPerSecond: [24, 22],
    });
    const pct = (a: number, b: number) => (b ? `${Math.round((a / b) * 100)}%` : '–');
    mountSim(root, {
      seed: 29,
      create: (params, seed) => ceiling({ perWrite: params.perWrite, reads: 2 }, seed),
      update: () => false,
      render(model: any) {
        const { delete: del, update: upd } = model.rows;
        strips.render(model.sim.now, {
          delete: { events: del.events, cells: { ratio: { text: pct(del.hits, del.reads), kind: 'hit' } } },
          update: { events: upd.events, cells: { ratio: { text: pct(upd.hits, upd.reads), kind: 'hit' } } },
        });
        setReadouts(root, {
          deleteHit: pct(del.hits, del.reads),
          expected: `${Math.round(deleteHitRatio(model.params.perWrite) * 100)}%`,
          unread: upd.cacheWrites > 1 ? `${upd.unread} of ${upd.cacheWrites}` : '–',
        });
      },
    });
  });
</script>
