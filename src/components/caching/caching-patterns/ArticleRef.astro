---
// A link to another article in the caching collection that is a link only when
// that article can be read: published, or a draft under CACHING_DRAFT_PREVIEW=1.
// Otherwise it renders the text alone, so a published article never links to
// an unbuilt page. A local helper; reported as a toolkit gap; now superseded by shared/ArticleRef.astro.
import { cachingCollection, cachingHref } from '../../../lib/caching-collection';
interface Props { slug: string; hash?: string }
const { slug, hash } = Astro.props;
const entry = cachingCollection.find(item => item.slug === slug);
if (!entry) throw new Error(`Unknown caching article: ${slug}`);
const files = import.meta.glob('../../../articles/caching/*.astro');
const hasFile = `../../../articles/caching/${slug || 'introduction'}.astro` in files;
const preview = process.env.CACHING_DRAFT_PREVIEW === '1';
const linked = entry.status === 'published' || (preview && hasFile);
const href = `${cachingHref(slug)}${hash ? `#${hash}` : ''}`;
---
{linked ? <a href={href}><slot /></a> : slug ? <cite><slot /></cite> : <slot />}
