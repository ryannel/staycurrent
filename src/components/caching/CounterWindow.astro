<figure class="cache-figure" data-counter-window>
 <p class="figure-title">Old successes can hide a new miss storm</p>
 <div class="cache-controls"><label>Between samples <select data-case><option value="recent">20 hits and 80 misses</option><option value="reset">Counters reset</option><option value="idle">No new lookups</option><option value="moved">A different Redis process</option></select></label></div>
 <div class="recovery-pair"><div class="recovery-node"><b>Earlier sample</b><strong>900 / 100</strong><span>hits / misses · process A</span></div><div class="recovery-node"><b>Later sample</b><strong data-later></strong><span data-identity></span></div></div>
 <p data-equation class="cluster-command"></p>
 <div class="ops-lookups" data-lookups aria-hidden="true"></div>
 <p data-explanation class="explanation" aria-live="polite"></p>
 <figcaption>Invented cumulative key-lookup counters. Each square represents one lookup in the recent interval: solid means hit, striped means miss. Order within the grid has no timing meaning. A reset or changed process breaks the comparison; no new lookups gives no hit-rate estimate.</figcaption>
</figure>
<script>
import{counterSamples,counterWindow}from'../../lib/caching/operations.mjs';
document.querySelectorAll<HTMLElement>('[data-counter-window]').forEach(root=>{const select=root.querySelector<HTMLSelectElement>('[data-case]')!;const render=()=>{const{before,after}=counterSamples[select.value],s=counterWindow(before,after);root.querySelector('[data-later]')!.textContent=`${after.hits} / ${after.misses}`;root.querySelector('[data-identity]')!.textContent=`hits / misses · process ${after.id}`;root.querySelector('[data-equation]')!.textContent=s.valid&&s.total?`(920 − 900) / [(920 − 900) + (180 − 100)] = 20%`:'No valid hit-rate estimate for this interval';root.querySelector('[data-lookups]')!.innerHTML=s.valid&&s.total?Array.from({length:s.total},(_,i)=>`<i class="${i<s.hits?'hit':'miss'}"></i>`).join(''):'';root.querySelector('[data-explanation]')!.textContent=s.valid&&s.total?`The lifetime ratio is ${(after.hits/(after.hits+after.misses)*100).toFixed(1)}%, but only ${s.hits} of the ${s.total} recent lookups hit. Use deltas from the same process and interval.`:s.reason;};select.onchange=render;render();});
</script>
