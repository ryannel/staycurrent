---
// Figure: the database budget, and how each cache decision spends it.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './designing.css';
import { budget } from './budget-model.mjs';
interface Props { number: number }
const { number } = Astro.props;
const ttls = [60, 600, 3600, 21600, 86400];
const ttlLabels = { 60: '1 minute', 600: '10 minutes', 3600: '1 hour', 21600: '6 hours', 86400: '24 hours' };
const rows = [
  { label: 'Expire only, 1 minute, 2 GB', d: { fresh: 'ttl', ttl: 60, maxmemory: 2 } },
  { label: 'Expire only, 24 hours, 4 GB', d: { fresh: 'ttl', ttl: 86400, maxmemory: 4 } },
  { label: 'Delete on change, 10 minutes, 4 GB', d: { fresh: 'delete', ttl: 600, maxmemory: 4 } },
  { label: 'Delete on change, 24 hours, 2 GB', d: { fresh: 'delete', ttl: 86400, maxmemory: 2 } },
  { label: 'Delete on change, 24 hours, 3 GB', d: { fresh: 'delete', ttl: 86400, maxmemory: 3 } },
  { label: 'Delete on change, 24 hours, 3.5 GB', d: { fresh: 'delete', ttl: 86400, maxmemory: 3.5 } },
  { label: 'Delete on change, 24 hours, 4 GB (the design)', d: { fresh: 'delete', ttl: 86400, maxmemory: 4 } },
  { label: 'The design, checkout reading Redis', d: { fresh: 'delete', ttl: 86400, maxmemory: 4, checkout: 'cache' } },
  { label: 'The design, popularity exponent 0.8', d: { fresh: 'delete', ttl: 86400, maxmemory: 4, skew: 0.8 } },
  { label: 'The design, twice the traffic', d: { fresh: 'delete', ttl: 86400, maxmemory: 4, traffic: 2 } },
  { label: 'Twice the traffic, 3.5 GB', d: { fresh: 'delete', ttl: 86400, maxmemory: 3.5, traffic: 2 } },
].map(r => ({ ...r, b: budget(r.d as any) }));
const n = (v: number) => Math.round(v).toLocaleString('en-GB');
---
<SimFigure number={number} id="dc-budget" title="One database, four decisions" controls="none"
  caption="Model, not measurement. Illustrative shop: 2,000,000 products with Zipf-like popularity (exponent 0.9 unless you change it), 1,000 product page views a second, each reading the product's details and its stock level with one MGET; 20 orders a second, each changing one product's stock; one price edit a second; a database that answers 300 queries a second, with an alert line at 210. The hit ratio needed is the share of page reads that must hit for misses to fit in what the alert line leaves after checkout. Traffic multiplies page views and orders. Details and stock levels share one Redis with one maxmemory and allkeys-lru. Each key hits rT ÷ (1 + rT) of its reads under a TTL, or 1 − e^(−ra) under LRU eviction (Che's approximation), whichever is smaller; the approximation agreed with a simulation to within one point, and its LRU part with Redis 8.10.3 to within half a point. Bytes per entry are measured: 2,131 for a product, 98 for a stock level; the model gives all of maxmemory to entries. Every query counts the same. Left out: listing pages, the trending panel (one query a minute), writes other than orders.">
  <Choice slot="params" name="fresh" label="Copies stay fresh by" value="ttl"
    options={[{ value: 'ttl', label: 'expiring' }, { value: 'delete', label: 'being deleted on change' }]} />
  <Slider slot="params" name="ttl" label="Product TTL" value={60} stops={ttls} labels={ttlLabels} />
  <Slider slot="params" name="maxmemory" label="maxmemory (details and stock)" value={2} stops={[2, 3, 3.5, 4, 5]} labels={{ 2: '2 GB', 3: '3 GB', 3.5: '3.5 GB', 4: '4 GB', 5: '5 GB' }} />
  <Choice slot="params" name="checkout" label="Checkout reads the price from" value="database"
    options={[{ value: 'database', label: 'the database' }, { value: 'cache', label: 'Redis' }]} />
  <Choice slot="params" name="skew" label="What if: popularity exponent" value="0.9"
    options={[{ value: '0.9', label: '0.9 (measured)' }, { value: '0.8', label: '0.8' }]} />
  <Choice slot="params" name="traffic" label="What if: traffic" value="1"
    options={[{ value: '1', label: 'today’s peak' }, { value: '2', label: 'twice the peak' }]} />
  <div class="dc-budget" data-budget role="img" aria-label="Database queries a second by source, against the database's capacity"></div>
  <ul class="dc-rows" data-rows></ul>
  <Fragment slot="stats">
    <Readout name="load" label="Database queries a second" kind="database" />
    <Readout name="hit" label="Page reads that hit, and the share the budget needs" kind="hit" />
    <Readout name="lag" label="Longest a page shows an old price" kind="stale" />
    <Readout name="charged" label="Price charged at checkout" kind="client" />
    <Readout name="memory" label="Memory used" kind="redis" />
  </Fragment>
  <Fragment slot="text">
    <p>A horizontal bar shows the database's queries a second, split into product details missed in Redis, stock levels missed in Redis, and checkout's own queries, against a dashed line at the database's capacity of 300 and another at the alert level of 210. Some settings, with the queries each sends:</p>
    <div class="dc-table-wrap"><table class="dc-table">
      <thead><tr><th>Decisions</th><th class="num">Product details</th><th class="num">Stock</th><th class="num">Checkout</th><th class="num">Total</th><th class="num">Page reads that hit</th><th class="num">Needed</th></tr></thead>
      <tbody>{rows.map(r => <tr><td>{r.label}</td><td class="num">{n(r.b.rows.product)}</td><td class="num">{n(r.b.rows.stock)}</td><td class="num">{n(r.b.rows.checkout)}</td><td class="num">{n(r.b.total)} ({Math.round(r.b.load * 100)}%)</td><td class="num">{(r.b.hit * 100).toFixed(1)}%</td><td class="num">{(r.b.need * 100).toFixed(1)}%</td></tr>)}</tbody>
    </table></div>
    <p>With copies that only expire, a page shows a price up to one TTL old, and stock levels need a 5-second TTL, so no setting meets both the staleness targets and the database's capacity. With deletes on change, the TTL is a backstop: a page shows a new price within about a second, unless a delete is lost, when it can be up to one TTL old. Below 4 GB, memory rather than the TTL limits the hit ratio; from 4 GB on, nothing changes. The hit ratio needed is what the alert line of 210 leaves after checkout's queries, shared over every page read: 92.5% at today's peak, 90.5% if checkout reads Redis, and 97.8% at twice the peak, which 4 GB just meets and 3.5 GB does not. Reading checkout's price from Redis saves 40 queries a second and charges a price that can be as old as the one on the page. At 4 GB a flatter popularity curve costs about 1 query a second; twice the traffic doubles checkout's queries, which no amount of memory reduces.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { svgEl } from '../shared/scene.mjs';
  import { budget, saleMisses, SHOP, GB } from './budget-model.mjs';

  const duration = (s: number) => (s >= 3600 ? `${s / 3600} ${s === 3600 ? 'hour' : 'hours'}` : s >= 60 ? `${s / 60} ${s === 60 ? 'minute' : 'minutes'}` : `${s} seconds`);
  const adjective = (s: number) => (s >= 3600 ? `${s / 3600}-hour` : s >= 60 ? `${s / 60}-minute` : `${s}-second`);
  const whole = (v: number) => Math.round(v).toLocaleString('en-GB');
  const SEGMENTS = [
    { id: 'product', label: 'Product details missed', kind: 'miss', fill: 'is-solid' },
    { id: 'stock', label: 'Stock levels missed', kind: 'miss', fill: 'is-tint' },
    { id: 'checkout', label: 'Checkout’s own queries', kind: 'database', fill: 'is-solid' },
  ];

  document.querySelectorAll<HTMLElement>('[data-figure-id="dc-budget"]').forEach(root => {
    const host = root.querySelector<HTMLElement>('[data-budget]')!;
    const list = root.querySelector<HTMLElement>('[data-rows]')!;
    let latest: any = null;

    // A fixed axis, so the capacity and alert lines never move; a total past the
    // axis is cut at its end and labelled with its value.
    const MAX = 600;
    const drawBar = () => {
      const b = latest; if (!b) return;
      const width = Math.round(host.clientWidth); if (!width) return;
      host.replaceChildren();
      const height = 96, left = 2, right = 54, top = 26, barH = 30;
      const svg = svgEl('svg', { viewBox: `0 0 ${width} ${height}`, width, height, 'aria-hidden': 'true' }, host);
      const x = (v: number) => left + (Math.min(v, MAX) / MAX) * (width - left - right);
      const placed: { x: number; text: string; solid: boolean; kind: string; fill: string }[] = [];
      let at = 0;
      for (const seg of SEGMENTS) {
        const v = b.rows[seg.id];
        const x0 = x(at), x1 = x(at + v);
        if (x1 > x0) svgEl('rect', { class: `dc-seg ${seg.fill}`, 'data-cache-kind': seg.kind, x: x0, y: top, width: x1 - x0, height: barH }, svg);
        if (x1 - x0 > 30) placed.push({ x: (x0 + x1) / 2, text: whole(v), solid: seg.fill === 'is-solid', kind: seg.kind, fill: seg.fill });
        at += v;
      }
      if (b.total > MAX) {
        const end = x(MAX);
        svgEl('path', { class: 'dc-overflow', d: `M${end - 6} ${top - 3}l8 ${barH / 2 + 3}l-8 ${barH / 2 + 3}` }, svg);
        svgEl('text', { class: 'dc-rule-label is-over', x: end + 6, y: top + barH / 2 + 4 }, svg).textContent = `${whole(b.total)} →`;
      }
      svgEl('path', { class: 'dc-axis', d: `M${left} ${top + barH + 4}H${x(MAX)}` }, svg);
      for (let v = 0; v <= MAX; v += 150) {
        svgEl('path', { class: 'dc-axis', d: `M${x(v)} ${top + barH + 4}v4` }, svg);
        svgEl('text', { class: 'dc-tick', x: x(v), y: top + barH + 20, 'text-anchor': v === 0 ? 'start' : 'middle' }, svg).textContent = String(v);
      }
      svgEl('text', { class: 'dc-tick', x: x(MAX), y: height - 2, 'text-anchor': 'end' }, svg).textContent = 'database queries a second';
      const alert = SHOP.capacity * SHOP.alert;
      svgEl('path', { class: 'dc-rule is-alert', d: `M${x(alert)} ${top - 6}V${top + barH + 4}` }, svg);
      svgEl('text', { class: 'dc-rule-label', x: x(alert) - 4, y: top - 10, 'text-anchor': 'end' }, svg).textContent = `alert ${alert}`;
      svgEl('path', { class: 'dc-rule', 'data-cache-kind': 'error', d: `M${x(SHOP.capacity)} ${top - 6}V${top + barH + 4}` }, svg);
      svgEl('text', { class: 'dc-rule-label', 'data-cache-kind': 'error', x: x(SHOP.capacity) + 4, y: top - 10 }, svg).textContent = `capacity ${SHOP.capacity}`;
      // Segment values last, with a halo in the segment's own fill, so a dashed rule never runs through a number.
      for (const l of placed) svgEl('text', { class: `dc-seg-label ${l.fill}${l.solid ? ' is-on-solid' : ''}`, 'data-cache-kind': l.kind, x: l.x, y: top + barH / 2 + 4, 'text-anchor': 'middle' }, svg).textContent = l.text;
    };

    const swatch = (seg: typeof SEGMENTS[number]) =>
      `<svg width="14" height="12" aria-hidden="true"><rect class="dc-seg ${seg.fill}" data-cache-kind="${seg.kind}" x="1" y="1" width="12" height="10"></rect></svg>`;

    bindParams(root, params => {
      const fresh = String(params.fresh), ttl = Number(params.ttl), maxmemory = Number(params.maxmemory), checkout = String(params.checkout);
      const skew = Number(params.skew), traffic = Number(params.traffic);
      const b = budget({ fresh, ttl, maxmemory, checkout, skew, traffic });
      latest = b;
      drawBar();
      const stockTtl = fresh === 'ttl' ? SHOP.stockTtlOnly : ttl;
      const notes = {
        product: `${(b.product.hit * 100).toFixed(1)}% of ${whole(b.reads)} reads hit; limited by ${b.limit === 'ttl' ? 'the TTL' : 'memory'}`,
        stock: fresh === 'ttl' ? `${(b.stock.hit * 100).toFixed(1)}% hit; a ${stockTtl}-second TTL, so stock is never more than ${stockTtl} seconds old` : `${(b.stock.hit * 100).toFixed(1)}% hit; a ${adjective(ttl)} TTL, plus about ${whole(saleMisses({ reads: b.reads, sales: b.sales, s: skew }))} a second re-read after a sale deletes them`,
        checkout: checkout === 'database' ? `${whole(b.sales)} orders × ${SHOP.checkoutQueries}: price, stock, the order` : `${whole(b.sales)} orders × 1: the order; price and stock come from Redis`,
      };
      list.innerHTML = SEGMENTS.map(seg => `<li>${swatch(seg)}<span>${seg.label}: <strong>${whole(b.rows[seg.id])}</strong> a second <span class="dc-row-note">(${notes[seg.id as keyof typeof notes]})</span></span></li>`).join('');
      const over = b.overCapacity, overAlert = b.overAlert, short = b.hit < b.need;
      const lag = fresh === 'ttl' ? duration(ttl) : 'about a second';
      setReadouts(root, {
        load: `${whole(b.total)} (${Math.round(b.load * 100)}%)${over ? ', overloaded' : overAlert ? ', over the alert line' : ''}`,
        hit: `${(b.hit * 100).toFixed(1)}%; need ${(b.need * 100).toFixed(1)}%${short ? ', not met' : ''}`,
        lag: fresh === 'ttl' ? `${lag}${ttl > SHOP.priceTarget ? ' (target: 1 minute)' : ''}` : `${lag}; ${duration(ttl)} if a delete is lost`,
        charged: checkout === 'database' ? 'current' : `up to ${fresh === 'ttl' ? duration(ttl) : 'a second'} old${fresh === 'ttl' ? '' : `, ${duration(ttl)} if a delete is lost`}`,
        memory: `${(b.memoryBytes / GB).toFixed(2)} GB of ${maxmemory} GB`,
      });
      const load = root.querySelector<HTMLElement>('[data-readout="load"]')?.closest<HTMLElement>('.cache-readout');
      if (load) load.dataset.cacheKind = over || overAlert ? 'error' : 'database';
      const hit = root.querySelector<HTMLElement>('[data-readout="hit"]')?.closest<HTMLElement>('.cache-readout');
      if (hit) hit.dataset.cacheKind = short ? 'error' : 'hit';
    });
    if (typeof ResizeObserver !== 'undefined') { let w = 0; new ResizeObserver(() => { const nw = Math.round(host.clientWidth); if (nw !== w) { w = nw; drawBar(); } }).observe(host); }
  });
</script>
