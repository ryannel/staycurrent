---
// Figure: the shop's popularity curve against a TTL. Why a short TTL caps the hit
// ratio of a long-tailed catalogue whatever the memory.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './designing.css';
import { ttlCurve } from './budget-model.mjs';
interface Props { number: number }
const { number } = Astro.props;
const ttls = [60, 600, 3600, 21600, 86400];
const ttlLabels = { 60: '1 minute', 600: '10 minutes', 3600: '1 hour', 21600: '6 hours', 86400: '24 hours' };
const rows = ttls.map(t => ({ label: ttlLabels[t as keyof typeof ttlLabels], c: ttlCurve(t), flat: ttlCurve(t, { s: 0.8 }) }));
const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
const n = (v: number) => Math.round(v).toLocaleString('en-GB');
---
<SimFigure number={number} id="dc-popularity" title="Two million products against one TTL" controls="none"
  caption="Model, not measurement. The illustrative shop's popularity: 2,000,000 products sharing 1,000 product page views a second, Zipf-like with an exponent of 0.9 (or 0.8). Both axes are logarithmic. Products to the right of the shaded boundary are read less than once per TTL. The hit ratio adds up rT ÷ (1 + rT) over every product, weighted by its share of reads, with unlimited memory and nothing deleted, so it is the best the TTL can do. Left out: memory limits, deletes and stock levels, which Figure 2 adds.">
  <Slider slot="params" name="ttl" label="TTL" value={60} stops={ttls} labels={ttlLabels} />
  <Choice slot="params" name="skew" label="Popularity exponent" value="0.9"
    options={[{ value: '0.9', label: '0.9 (the shop)' }, { value: '0.8', label: '0.8 (flatter)' }]} />
  <Fragment slot="stats">
    <Readout name="hit" label="Product reads that hit, any memory" kind="hit" />
    <Readout name="above" label="Products read at least once per TTL" kind="client" />
    <Readout name="below" label="Reads that go to all the others" kind="miss" />
  </Fragment>
  <div class="dc-popularity" data-chart="popularity"></div>
  <Fragment slot="text">
    <p>A line falls from about 30 reads a second for the most popular product to about one read every 4.3 hours for the least popular, a straight line on logarithmic axes. A dashed horizontal line marks one read per TTL; products below it, to its right, are shaded. With an exponent of 0.9 and unlimited memory:</p>
    <div class="dc-table-wrap"><table class="dc-table">
      <thead><tr><th>TTL</th><th class="num">Products read at least once per TTL</th><th class="num">Reads of all the others</th><th class="num">Product reads that hit</th><th class="num">Hit, exponent 0.8</th></tr></thead>
      <tbody>{rows.map(r => <tr><td>{r.label}</td><td class="num">{n(r.c.above)}</td><td class="num">{pct(r.c.belowReads)}</td><td class="num">{pct(r.c.hit)}</td><td class="num">{pct(r.flat.hit)}</td></tr>)}</tbody>
    </table></div>
    <p>With a one-minute TTL, the 4,152 products above the line get 41% of reads and nearly all of them hit; the other 1,995,848 get 59% and most of those miss, so the hit ratio cannot pass 42%, whatever the memory. A flatter curve puts more reads in the tail and lowers every figure.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { ttlCurve, rateAt, rankAt, SHOP } from './budget-model.mjs';

  const TICKS = [1 / 86400, 1 / 3600, 1 / 60, 1, 10];
  const tickText = (v: number) => (v >= 10 ? '10 a second' : v >= 1 ? '1 a second' : v >= 1 / 60 ? '1 a minute' : v >= 1 / 3600 ? '1 an hour' : '1 a day');
  const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
  const whole = (v: number) => Math.round(v).toLocaleString('en-GB');

  document.querySelectorAll<HTMLElement>('[data-figure-id="dc-popularity"]').forEach(root => {
    const host = root.querySelector<HTMLElement>('[data-chart="popularity"]')!;
    const chart = lineChart(host, {
      label: 'Reads a second of each product by popularity rank, against one read per TTL',
      height: 260,
      x: { label: 'Products, most popular first (rank)', scale: 'log', domain: [1, SHOP.products] },
      y: { label: 'Reads of one product', scale: 'log', domain: [1e-5, 100], ticks: TICKS, format: tickText },
      series: [{ id: 'curve', label: 'Reads a second of each product', kind: 'client', dash: '' }, { id: 'ttl', label: 'One read per TTL', kind: 'expiry', dash: '6 4' }],
    });
    let redraw = () => {}, drawnWide: boolean | null = null;
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(() => { if (drawnWide !== null && (host.clientWidth >= 480) !== drawnWide) redraw(); }).observe(host);
    bindParams(root, params => {
      redraw = () => draw(params);
      draw(params);
    });
    function draw(params: Record<string, unknown>) {
      const ttl = Number(params.ttl), s = Number(params.skew);
      const points: [number, number][] = [];
      for (let i = 0; i <= 64; i++) { const rank = Math.min(SHOP.products, Math.pow(SHOP.products, i / 64)); points.push([rank, rateAt(rank, { s })]); }
      chart.set('curve', points);
      chart.set('ttl', [[1, 1 / ttl], [SHOP.products, 1 / ttl]]);
      const edge = rankAt(1 / ttl, { s });
      chart.band('tail', null);
      // The full label does not fit on a phone; the short one still names the shading.
      const narrow = host.clientWidth < 480;
      drawnWide = !narrow;
      if (edge < SHOP.products) chart.band('tail', Math.max(1, edge), SHOP.products, narrow ? 'Read less than once per TTL' : 'Read less than once per TTL: mostly misses', 'miss');
      chart.render();
      const c = ttlCurve(ttl, { s });
      setReadouts(root, {
        hit: pct(c.hit),
        above: `${whole(c.above)} of 2,000,000`,
        below: pct(c.belowReads),
      });
    }
  });
</script>
