<figure class="cache-figure" data-cache-latency>
  <p class="figure-title">A faster average can hide slow misses</p>
  <div class="cache-controls"><label>Hit rate <input data-hit type="range" min="0" max="100" value="90" /><output data-hit-label>90%</output></label><label>Source work <select data-source><option value="40">40 ms</option><option value="2">2 ms</option><option value="100">100 ms</option></select></label></div>
  <p class="figure-note">Each circle is one of 100 requests. Green circles are hits; grey circles are misses.</p>
  <svg viewBox="0 0 620 220" role="img" aria-label="One hundred requests placed by latency: cache hits on the left and misses further right.">
    <line x1="48" y1="190" x2="585" y2="190" stroke="var(--color-rule-strong)" />
    <g data-dots></g>
    <text x="48" y="214" text-anchor="middle">0</text><text x="585" y="214" text-anchor="middle" data-axis>50 ms</text>
    <line data-origin-line x1="478" x2="478" y1="35" y2="190" stroke="var(--color-text-secondary)" stroke-dasharray="4 4" />
  </svg>
  <p class="figure-note" data-origin-label>Without caching: every request takes 40 ms (dashed line)</p>
  <div class="cache-stat-row"><div><strong data-mean>6.2 ms</strong><span>mean with caching</span></div><div><strong data-p99>44 ms</strong><span>99th percentile</span></div><div><strong data-source-count>10</strong><span>source reads per 100 requests</span></div></div>
  <p class="explanation" data-explanation aria-live="polite"></p>
  <figcaption>Fixed illustrative costs: cache lookup 2 ms, cache fill 2 ms, source work as selected. The application waits for a fill before responding. All hits have one latency and all misses another; real measurements have a wider distribution. The percentile uses the nearest-rank definition.</figcaption>
</figure>
<script>
  import { latencyModel } from '../../lib/caching/intro.mjs';
  document.querySelectorAll<HTMLElement>('[data-cache-latency]').forEach(root=>{
    const hit=root.querySelector<HTMLInputElement>('[data-hit]')!, source=root.querySelector<HTMLSelectElement>('[data-source]')!;
    const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
    const render=()=>{const h=Number(hit.value),d=Number(source.value),m=latencyModel(h,d),max=d+10;
      const x=(v:number)=>48+v/max*537;
      root.querySelector('[data-dots]')!.innerHTML=Array.from({length:100},(_,i)=>{const isHit=i<h,j=isHit?i:i-h;return `<circle cx="${x(isHit?m.hit:m.miss)+(j%5-2)*5}" cy="${178-Math.floor(j/5)*7}" r="2.7" fill="var(${isHit?'--color-accent':'--color-text-secondary'})" />`;}).join('');
      const line=root.querySelector('[data-origin-line]')!;line.setAttribute('x1',String(x(d)));line.setAttribute('x2',String(x(d)));
      set('axis',`${max} ms`);set('origin-label',`Without caching: every request takes ${d} ms (dashed line)`);set('hit-label',`${h}%`);set('mean',`${m.mean.toFixed(2)} ms`);set('p99',`${m.p99} ms`);set('source-count',String(m.sourceReads));
      set('explanation',`Hits take ${m.hit} ms; misses take ${m.miss} ms. ${m.mean<d?'The average is faster than reading the source directly.':m.mean===d?'The average equals a direct source read.':'The cache makes the average slower.'} ${m.breakEven===1?'Even a 100% hit rate can only match the source here.':`More than ${(m.breakEven*100).toFixed(1)}% hits are needed to beat the source on average.`}`);
    };hit.oninput=render;source.onchange=render;render();
  });
</script>
