---
// Figure: Redis's 8-bit logarithmic LFU counter against the number of accesses.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './figures.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="ee-lfu-counter" title="A counter that slows down as it climbs" controls="none"
  caption="The solid line is the expected counter from the increment rule derived above. The circles are values measured on Redis 8.10.3 by sending one key 100, 1,000, 10,000, 100,000 and 1,000,000 INCR commands and reading OBJECT FREQ, one run each, so they scatter around the expectation. The horizontal axis is logarithmic: each step is ten times more accesses.">
  <Choice slot="params" name="factor" label="lfu-log-factor" value="10"
    options={[{ value: '1', label: '1' }, { value: '10', label: '10 (default)' }, { value: '100', label: '100' }]} />
  <Fragment slot="stats">
    <Readout name="hundred" label="Counter after 100 accesses" />
    <Readout name="saturate" label="Accesses to reach 255" />
  </Fragment>
  <Fragment slot="text">
    <p>The counter starts at 5 for a new key. With the default factor of 10 it reaches about 10 after 100 accesses, about 20 after 1,000, about 147 after 100,000, and its ceiling of 255 after about 311,000. Measured values on a real server were 10, 22, 44, 147 and 255 after 100, 1,000, 10,000, 100,000 and 1,000,000 accesses. A factor of 1 climbs faster and saturates after about 31,000 accesses; a factor of 100 climbs slower and saturates after about 3.1 million. Either way, the counter tells a key read a handful of times from one read thousands of times, which is the distinction eviction needs.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { counterCurve, expectedCounter, expectedAccesses, MEASURED } from './lfu-model.mjs';
  import { chartPoints, onWidth } from './draw.mjs';

  const power = (v: number) => ['1', '10', '100', '1k', '10k', '100k', '1M', '10M'][Math.round(v)] ?? '';
  document.querySelectorAll<HTMLElement>('[data-figure-id="ee-lfu-counter"]').forEach(root => {
    const chart = lineChart(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'LFU counter against number of accesses',
      height: 240,
      x: { label: 'Accesses to the key (log scale)', domain: [0, 7], format: power },
      y: { label: 'Counter (OBJECT FREQ)', domain: [0, 260] },
      series: [{ id: 'expected', label: 'Expected counter', kind: 'redis' }],
    });
    const container = root.querySelector<HTMLElement>('[data-scene]')!;
    let factor = 10;
    const points = () => chartPoints(container, { id: 'measured', sets: [{ kind: 'neutral', points: (MEASURED as any)[factor] }], xDomain: [0, 7], yDomain: [0, 260], key: 'Measured on Redis 8.10.3' });
    onWidth(container, () => requestAnimationFrame(points));
    bindParams(root, params => {
      const f = Number(params.factor);
      factor = f;
      chart.set('expected', counterCurve(f, 7));
      chart.render();
      points();
      setReadouts(root, {
        hundred: expectedCounter(100, f).toFixed(0),
        saturate: Math.round(expectedAccesses(255, f)).toLocaleString('en-GB'),
      });
    });
  });
</script>
