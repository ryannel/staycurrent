---
// Figure: hit ratio against cache size for Redis's allkeys policies, at a benchmark's pace and at a steadier one.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import { SIZES, KEYS, MEASURED, MODEL, ORACLE } from './size-data.mjs';
import './figures.css';
interface Props { number: number }
const { number } = Astro.props;
const pct = (v: number) => `${(Math.round(v * 1000) / 10).toFixed(1)}%`;
const share = (s: number) => `${((s / KEYS) * 100).toLocaleString('en-GB', { maximumFractionDigits: 1 })}%`;
const rows: [string, number[]][] = [
  ['Most popular keys (calculated, best possible)', ORACLE],
  ['80,000 a second, measured: allkeys-lfu', MEASURED['allkeys-lfu']],
  ['80,000 a second, measured: allkeys-lru', MEASURED['allkeys-lru']],
  ['80,000 a second, calculated: exact LRU', MEASURED.exact],
  ['80,000 a second, measured: allkeys-random', MEASURED['allkeys-random']],
  ['5,000 a second, model: allkeys-lfu', MODEL[5000]['allkeys-lfu']],
  ['5,000 a second, model: allkeys-lfu, lfu-decay-time 10', MODEL[5000]['allkeys-lfu-decay10']],
  ['5,000 a second, model: allkeys-lru', MODEL[5000]['allkeys-lru']],
  ['5,000 a second, model: exact LRU', MODEL[5000].exact],
  ['5,000 a second, model: allkeys-random', MODEL[5000]['allkeys-random']],
];
---
<SimFigure number={number} id="ee-size-curve" title="Hit ratio against cache size, fast and steady" controls="none"
  caption="Cache-aside reads over 4,000,000 keys with Zipf-like popularity, exponent 0.8. Lines come from this article's model of Redis's eviction (5 samples, a pool of 16, the one-second LRU clock, the LFU counter with its decay); circles are Redis 8.10.3 measured at about 80,000 requests a second, one run per point lasting about a minute, which the model matches to within 0.6 points. The 5,000-a-second lines are the model alone, after an hour of simulated traffic; a scaled-down version was checked on a real server (see text). The dotted line is calculated: a cache that always holds the most popular keys. Sizes are the share of all keys the cache can hold, in uneven steps. Not modelled: changes in popularity over time, values of different sizes.">
  <Choice slot="params" name="setting" label="Traffic" value="benchmark"
    options={[{ value: 'benchmark', label: '80,000 a second (benchmark)' }, { value: 'steady', label: '5,000 a second' }, { value: 'decay10', label: '5,000, lfu-decay-time 10' }]} />
  <Fragment slot="stats">
    <Readout name="pace" label="Requests a minute per cached key" />
    <Readout name="small" label="allkeys-lfu minus allkeys-lru, 0.5% cache" kind="hit" />
    <Readout name="large" label="Same, 30% cache" kind="hit" />
  </Fragment>
  <Fragment slot="text">
    <p>Hit ratio by cache size as a share of the 4,000,000 keys. At 80,000 requests a second, allkeys-lfu leads allkeys-lru by 10 points at the smallest size and under 1 point at the largest, and allkeys-lru trails an exact LRU by 1.6 points at the smallest size. At 5,000 a second, allkeys-lru matches an exact LRU to within 0.2 points at every size, and allkeys-lfu's lead falls to 5 points at the smallest size, nothing at 10% and minus 2 points at 30%. Raising lfu-decay-time to 10 minutes puts allkeys-lfu ahead at every size.</p>
    <div class="ee-table-wrap"><table class="ee-table">
      <thead><tr><th>Policy</th>{SIZES.map(s => <th class="num">{share(s)}</th>)}</tr></thead>
      <tbody>{rows.map(([label, values]) => <tr><td>{label}</td>{values.map(v => <td class="num">{pct(v)}</td>)}</tr>)}</tbody>
    </table></div>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { points, sizeLabel, SIZES, ORACLE, SETTINGS, perKeyPerMinute } from './size-data.mjs';
  import { chartPoints, onWidth } from './draw.mjs';

  const Y = [0, 0.8];
  document.querySelectorAll<HTMLElement>('[data-figure-id="ee-size-curve"]').forEach(root => {
    const container = root.querySelector<HTMLElement>('[data-scene]')!;
    const chart = lineChart(container, {
      label: 'Hit ratio against cache size for allkeys-lfu, allkeys-lru and allkeys-random, with the best possible',
      height: 270,
      x: { label: 'Cache size, share of all keys (uneven steps)', domain: [0, SIZES.length - 1], format: (v: number) => (Number.isInteger(v) ? sizeLabel(v) : '') },
      y: { label: 'Hit ratio', domain: Y, format: (v: number) => `${Math.round(v * 100)}%` },
      series: [
        { id: 'oracle', label: 'Most popular keys (calculated)', kind: 'neutral', dash: '2 4' },
        { id: 'allkeys-lfu', label: 'allkeys-lfu', kind: 'hit', dash: '' },
        { id: 'allkeys-lru', label: 'allkeys-lru', kind: 'redis', dash: '8 4' },
        { id: 'allkeys-random', label: 'allkeys-random', kind: 'neutral', dash: '' },
      ],
    });
    let setting: any = SETTINGS.benchmark;
    const measured = () => chartPoints(container, {
      id: 'measured', xDomain: [0, SIZES.length - 1], yDomain: Y,
      key: setting.measured ? 'Measured on Redis 8.10.3' : undefined,
      sets: setting.measured ? [
        { kind: 'hit', points: points(setting.measured['allkeys-lfu']) },
        { kind: 'redis', points: points(setting.measured['allkeys-lru']) },
        { kind: 'neutral', points: points(setting.measured['allkeys-random']) },
      ] : [],
    });
    onWidth(container, () => requestAnimationFrame(measured));
    bindParams(root, params => {
      setting = (SETTINGS as any)[params.setting] ?? SETTINGS.benchmark;
      chart.set('oracle', points(ORACLE));
      chart.set('allkeys-lfu', points(setting.lfu));
      chart.set('allkeys-lru', points(setting.series['allkeys-lru']));
      chart.set('allkeys-random', points(setting.series['allkeys-random']));
      chart.render();
      measured();
      const lead = (i: number) => {
        const d = (setting.lfu[i] - setting.series['allkeys-lru'][i]) * 100;
        return `${d >= 0 ? '+' : '−'}${Math.abs(d).toFixed(1)} points`;
      };
      const pace = (i: number) => {
        const v = perKeyPerMinute(setting.rate, SIZES[i]);
        return v < 1 ? v.toFixed(2) : String(Math.round(v));
      };
      setReadouts(root, { pace: `${pace(SIZES.length - 1)} to ${pace(0)}`, small: lead(0), large: lead(SIZES.length - 1) });
    });
  });
</script>
