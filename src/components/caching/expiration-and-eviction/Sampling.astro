---
// Figure: approximated LRU. Sample a few keys, keep the oldest candidates in a pool of 16, evict the best.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import './figures.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="ee-sampling" title="Sampling for an old key" advance={1000} speed={true}
  caption="Illustrative model of Redis's algorithm, not a measurement: 100 keys; each second six random keys are read and one new key arrives, so one key must be evicted. Squares with a stronger shade have gone longer without a read. Redis samples neighbouring hash-table buckets from a random starting point; this model samples uniformly at random. Idle time is kept in whole seconds, as in Redis.">
  <Slider slot="params" name="samples" label="maxmemory-samples" min={1} max={20} step={1} value={5} />
  <Fragment slot="stats">
    <Readout name="share" label="Evictions from the oldest tenth" />
    <Readout name="count" label="Evictions" />
    <Readout name="last" label="Last evicted, idle" />
  </Fragment>
  <Fragment slot="text">
    <p>A grid of 100 keys is shaded by how long each has gone without a read. Every second Redis needs room for one new key. It samples the chosen number of keys (outlined), adds the ones that have been idle longest to a pool of up to 16 candidates that it keeps between evictions, and evicts the most idle candidate in the pool (marked with a cross). With one sample the evicted key is effectively random: about 9% of evictions come from the oldest tenth of keys, which is what chance gives. With 5 samples about half do, with 10 about 70%, and with 20 about three quarters. The cost is time: each eviction examines that many keys.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { svgEl } from '../shared/scene.mjs';
  import { samplingModel, slotIdle, poolSlots } from './sampling-model.mjs';
  import { svgIn, onWidth } from './draw.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="ee-sampling"]').forEach(root => {
    const container = root.querySelector<HTMLElement>('[data-scene]')!;
    const { svg, size } = svgIn(container, 'A grid of 100 keys shaded by idle time, the sampled keys, and the eviction pool', 300);
    const layer = svgEl('g', {}, svg);
    let width = 0;
    const getWidth = onWidth(container, w => { width = w; });
    mountSim(root, {
      seed: 2,
      create: (params, seed) => samplingModel(params, seed),
      update: () => false,
      render(model: any) {
        width = getWidth() || width;
        const compact = width < 560;
        const cell = compact ? Math.floor((width - 2 - 9 * 3) / 10) : 24, gap = compact ? 3 : 4;
        const gridW = 10 * (cell + gap) - gap;
        const top = 22;
        const poolX = compact ? 0 : gridW + 36;
        const poolY = compact ? top + 10 * (cell + gap) + 34 : top;
        // On a phone the pool wraps to two rows of eight, with each candidate's idle time beneath it.
        const poolPitch = compact ? Math.floor(width / 8) : 0;
        const poolCell = compact ? Math.min(26, poolPitch - 10) : 26;
        const height = compact ? poolY + 2 * (poolCell + 20) + 22 : top + 10 * (cell + gap) + 8;
        size(width, height);
        layer.replaceChildren();
        const idle = slotIdle(model);
        const maxIdle = Math.max(30, ...idle);
        svgEl('text', { class: 'ee-grid-label', x: 0, y: 14 }, layer).textContent = '100 keys; stronger shade = idle longer';
        const at = (slot: number) => [(slot % 10) * (cell + gap) + 1, top + Math.floor(slot / 10) * (cell + gap)];
        idle.forEach((v: number, slot: number) => {
          const [x, y] = at(slot);
          svgEl('rect', { class: 'ee-cell-frame', x, y, width: cell, height: cell, rx: 2 }, layer);
          svgEl('rect', { class: 'ee-cell-age', x, y, width: cell, height: cell, rx: 2, opacity: (0.06 + 0.8 * Math.min(1, v / maxIdle)).toFixed(2) }, layer);
        });
        const last = model.last;
        if (last) {
          for (const slot of last.sampled) {
            if (slot === undefined || slot === null) continue;
            const [x, y] = at(slot);
            svgEl('rect', { class: 'ee-cell is-sampled', x: x - 2, y: y - 2, width: cell + 4, height: cell + 4, rx: 3 }, layer);
          }
          const [x, y] = at(last.slot);
          svgEl('path', { class: 'ee-victim-mark', d: `M${x + 4} ${y + 4}L${x + cell - 4} ${y + cell - 4}M${x + cell - 4} ${y + 4}L${x + 4} ${y + cell - 4}` }, layer);
        }
        // The pool: up to 16 candidates, best first, each with the idle time recorded when it was sampled.
        const pool = poolSlots(model);
        svgEl('text', { class: 'ee-pool-label', x: poolX, y: compact ? poolY - 10 : 14 }, layer).textContent = 'Eviction pool (best candidate first)';
        for (let k = 0; k < 16; k++) {
          const p = pool[k];
          const x = compact ? poolX + (k % 8) * poolPitch : poolX + (k % 4) * (poolCell + 30);
          const y = compact ? poolY + Math.floor(k / 8) * (poolCell + 20) : poolY + Math.floor(k / 4) * (poolCell + 12);
          if (!p) { svgEl('rect', { class: 'ee-pool-empty', x, y, width: poolCell, height: poolCell, rx: 2 }, layer); continue; }
          svgEl('rect', { class: 'ee-cell-frame', x, y, width: poolCell, height: poolCell, rx: 2 }, layer);
          svgEl('rect', { class: 'ee-cell-age', x, y, width: poolCell, height: poolCell, rx: 2, opacity: (0.06 + 0.8 * Math.min(1, p.idle / maxIdle)).toFixed(2) }, layer);
          if (compact) svgEl('text', { class: 'ee-pool-value', x: x + poolCell / 2, y: y + poolCell + 13, 'text-anchor': 'middle' }, layer).textContent = `${p.idle}s`;
          else svgEl('text', { class: 'ee-pool-value', x: x + poolCell + 4, y: y + poolCell / 2 + 4 }, layer).textContent = `${p.idle}s`;
        }
        svgEl('text', { class: 'ee-note', x: poolX, y: compact ? poolY + 2 * (poolCell + 20) + 12 : poolY + 4 * (poolCell + 12) + 10 }, layer).textContent = 'Numbers: idle time when sampled';
        setReadouts(root, {
          share: model.evictions ? `${Math.round((model.fromOldestTenth / model.evictions) * 100)}%` : '–',
          count: String(model.evictions),
          last: last ? `${last.idle} s (oldest ${last.oldestIdle} s)` : '–',
        });
      },
    });
  });
</script>
