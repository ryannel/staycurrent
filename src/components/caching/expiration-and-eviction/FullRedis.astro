---
// Figure: the same write stream into a full Redis under three maxmemory policies.
import SimFigure from '../shared/SimFigure.astro';
import Choice from '../shared/Choice.astro';
import Readout from '../shared/Readout.astro';
import './figures.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="ee-full-redis" title="When Redis is full" advance={5000}
  legend={[{ kind: 'redis', label: 'Key with a TTL' }, { kind: 'neutral', label: 'Key without a TTL (never expires)' }, { kind: 'error', label: 'Write refused' }]}
  caption="Illustrative model, not a measurement: room for 48 keys; three writes a second of cache keys with a TTL (long enough not to expire here) and one write every 1.3 seconds of a key without a TTL; four reads a second refresh random keys' recency. Eviction takes the exact least recently used candidate, where Redis samples (Figure 6).">
  <Choice slot="params" name="policy" label="maxmemory-policy" value="noeviction"
    options={[{ value: 'noeviction', label: 'noeviction' }, { value: 'volatile-lru', label: 'volatile-lru' }, { value: 'allkeys-lru', label: 'allkeys-lru' }]} />
  <Fragment slot="stats">
    <Readout name="refused" label="Writes refused" kind="error" />
    <Readout name="evicted" label="Keys evicted" />
    <Readout name="plain" label="Keys without a TTL evicted" />
  </Fragment>
  <Fragment slot="text">
    <p>Each square is a slot of memory; pale red squares hold keys with a TTL and solid grey squares hold keys without one. Under noeviction, the first write after memory fills is refused, and so is every write after it (crosses gather at the right), while reads keep working. Under volatile-lru, Redis evicts keys that have a TTL, so writes succeed, but keys without a TTL are never removed; they slowly take over memory, and after about a minute the policy has nothing left to evict and refuses writes as noeviction does. Under allkeys-lru no write is refused, and keys without a TTL are evicted like any other when they are the least recently used.</p>
  </Fragment>
</SimFigure>
<script>
  import { mountSim, setReadouts } from '../shared/player.mjs';
  import { svgEl } from '../shared/scene.mjs';
  import { memoryModel } from './memory-model.mjs';
  import { svgIn, onWidth, dot } from './draw.mjs';

  document.querySelectorAll<HTMLElement>('[data-figure-id="ee-full-redis"]').forEach(root => {
    const container = root.querySelector<HTMLElement>('[data-scene]')!;
    const { svg, size } = svgIn(container, 'Memory slots in Redis and the writes it refuses', 200);
    const layer = svgEl('g', {}, svg);
    let width = 0;
    const getWidth = onWidth(container, w => { width = w; });
    mountSim(root, {
      seed: 5,
      create: (params, seed) => memoryModel(params, seed, { plainRate: 0.75 }),
      // A new policy starts again from an empty Redis, so the three runs compare cleanly.
      update: () => false,
      render(model: any) {
        width = getWidth() || width;
        const compact = width < 520;
        const cols = compact ? 8 : 12;
        const cell = compact ? 22 : 26, gap = 5;
        const gridW = cols * (cell + gap) - gap;
        const rows = Math.ceil(model.slots / cols);
        const top = 26;
        const trayX = compact ? 4 : gridW + 40;
        const trayY = compact ? top + rows * (cell + gap) + 30 : top;
        const height = compact ? trayY + 4 * 16 + 24 : top + rows * (cell + gap) + 10;
        size(width, height);
        layer.replaceChildren();
        const now = model.sim.now;
        const recent = new Map<number, any>();
        for (const e of model.events) if (e.slot >= 0) recent.set(e.slot, e);
        svgEl('text', { class: 'ee-grid-label', x: 0, y: 14 }, layer).textContent = `Redis memory, room for ${model.slots} keys`;
        model.cells.forEach((c: any, i: number) => {
          const x = (i % cols) * (cell + gap) + 1, y = top + Math.floor(i / cols) * (cell + gap);
          const e = recent.get(i);
          const cls = !c ? 'is-empty' : c.ttl ? 'is-ttl' : 'is-plain';
          const flash = e && now - e.t < 700 ? (e.kind === 'evicted' ? ' is-evicted' : ' is-stored') : '';
          svgEl('rect', { class: `ee-cell ${cls}${flash}`, x, y, width: cell, height: cell, rx: 3 }, layer);
        });
        // Refused writes: a tray of crosses, with a count.
        svgEl('text', { class: 'ee-grid-label', x: trayX, y: compact ? trayY - 10 : 14 }, layer).textContent = 'Writes refused';
        const trayCols = compact ? 12 : Math.max(4, Math.floor((width - trayX - 10) / 16));
        const shown = Math.min(model.stats.refused, trayCols * 4);
        for (let k = 0; k < shown; k++) dot(layer, 'error', trayX + 8 + (k % trayCols) * 16, trayY + 8 + Math.floor(k / trayCols) * 16, 5);
        if (model.stats.refused > shown) svgEl('text', { class: 'ee-count', x: trayX, y: trayY + 4 * 16 + 14 }, layer).textContent = `+${model.stats.refused - shown} more`;
        setReadouts(root, {
          refused: String(model.stats.refused),
          evicted: String(model.stats.evicted),
          plain: String(model.stats.evictedPlain),
        });
      },
    });
  });
</script>
