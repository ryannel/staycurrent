---
// Figure: keys filled together with one TTL expire together; jitter spreads them.
import SimFigure from '../shared/SimFigure.astro';
import Slider from '../shared/Slider.astro';
import Readout from '../shared/Readout.astro';
import './figures.css';
interface Props { number: number }
const { number } = Astro.props;
---
<SimFigure number={number} id="ee-jitter" title="Keys cached together expire together" controls="none"
  caption="Illustrative model, not a measurement: 10,000 keys all filled at time 0 with a 10-minute TTL, each refilled the moment it expires (as a popular key would be) with a new random TTL. Counts are grouped into 10-second bins, and the vertical axis stops at 200 a second, so the waves without jitter run off the top.">
  <Slider slot="params" name="jitter" label="TTL jitter, ±" min={0} max={0.3} step={0.05} value={0} format="percent" />
  <Fragment slot="stats">
    <Readout name="first" label="First wave, refills a second in its busiest 10 s" kind="expiry" />
    <Readout name="fourth" label="Fourth wave, busiest 10 s" kind="expiry" />
    <Readout name="average" label="Long-run average" />
  </Fragment>
  <Fragment slot="text">
    <p>The chart counts refills a second over about 40 minutes. With no jitter, all 10,000 keys expire in the same instant at 10, 20, 30 and 40 minutes, and the database receives all 10,000 refills at once each time. With ±10% jitter the first wave spreads over two minutes, about 83 refills a second on average and 90 in its busiest 10 seconds, and each later wave is lower and wider, about 56 a second by the fourth. With ±30% the first wave peaks near 33 a second. The long-run average is 16.7 refills a second whatever the jitter.</p>
  </Fragment>
</SimFigure>
<script>
  import { bindParams, setReadouts } from '../shared/player.mjs';
  import { lineChart } from '../shared/chart.mjs';
  import { refreshRates, peakBetween } from './jitter-model.mjs';

  import { plotArea, onWidth } from './draw.mjs';
  import { svgEl } from '../shared/scene.mjs';

  const KEYS = 10000, TTL = 600, HORIZON = 2500, TOP = 200;
  document.querySelectorAll<HTMLElement>('[data-figure-id="ee-jitter"]').forEach(root => {
    const chart = lineChart(root.querySelector<HTMLElement>('[data-scene]')!, {
      label: 'Refills a second over time after 10,000 keys were filled together',
      height: 240,
      x: { label: 'Minutes after the keys were filled', domain: [0, HORIZON / 60], format: (v: number) => String(Math.round(v)) },
      y: { label: 'Refills a second', domain: [0, TOP] },
      series: [{ id: 'rate', label: 'Refills a second', kind: 'expiry' }],
      rules: [{ y: KEYS / TTL, label: 'Long-run average, 16.7 a second', kind: 'neutral' }],
    });
    const container = root.querySelector<HTMLElement>('[data-scene]')!;
    let jitter = 0;
    // Waves taller than the axis are drawn to the top and labelled with what really happens.
    const note = () => {
      const svg = container.querySelector('svg.cache-chart-svg');
      const area = plotArea(container);
      if (!svg || !area) return;
      let g = svg.querySelector('g[data-note]');
      if (!g) g = svgEl('g', { 'data-note': '' }, svg);
      g.replaceChildren();
      if (jitter > 0) return;
      const x = area.left + (10 / (HORIZON / 60)) * (area.right - area.left);
      svgEl('text', { class: 'ee-band-label', x: x + 6, y: area.top + 12 }, g).textContent = '10,000 at once, off the scale';
    };
    onWidth(container, () => requestAnimationFrame(note));
    bindParams(root, params => {
      jitter = params.jitter;
      const rates = refreshRates({ keys: KEYS, ttl: TTL, jitter, horizon: HORIZON, bin: 10 }, 7);
      chart.set('rate', rates.map(r => [(r.t + 5) / 60, Math.min(TOP, r.rate)]));
      chart.render();
      note();
      const wave = (from: number, to: number) => (jitter > 0 ? `${Math.round(peakBetween(rates, from, to))} a second` : 'all 10,000 at once');
      setReadouts(root, {
        first: wave(300, 900),
        fourth: wave(2100, 2500),
        average: `${(KEYS / TTL).toFixed(1)} a second`,
      });
    });
  });
</script>
