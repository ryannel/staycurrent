<figure class="cache-figure" data-cluster-migration>
 <p class="figure-title">Moving keys is not the same as changing slot ownership</p>
 <div class="cache-controls"><button data-back>Previous migration step</button><button data-next>Next migration step</button><button data-reset>Reset migration</button></div>
 <p class="cluster-stage" data-stage></p>
 <div class="cluster-map"><span>Slot 8,000 owner: <b data-owner>B</b></span><span>Client’s cached owner: <b data-map>B</b></span></div>
 <div class="recovery-pair"><div class="recovery-node"><b>Primary B</b><small data-b-state></small><div class="cluster-key-box" data-keys-b></div></div><div class="recovery-node"><b>Primary C</b><small data-c-state></small><div class="cluster-key-box" data-keys-c></div></div></div>
 <p class="cluster-command" data-route></p>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>Keys <code>card:&#123;42&#125;:a</code> and <code>card:&#123;42&#125;:b</code> share slot 8,000. Tiles show where their values are stored. Follow a GET of key a through the classic Redis 8.2 migration protocol. The sequence fixes the order for teaching; real migration interleaves many requests and keys, and clients must bound retries. ASK is temporary; MOVED indicates changed ownership.</figcaption>
</figure>
<script>
import{migrationSteps}from'../../lib/caching/cluster.mjs';
document.querySelectorAll<HTMLElement>('[data-cluster-migration]').forEach(root=>{let step=0;const render=()=>{const s=migrationSteps[step];root.querySelector('[data-stage]')!.textContent=`${step+1} / ${migrationSteps.length} · ${s.title}`;root.querySelector('[data-owner]')!.textContent=s.owner;root.querySelector('[data-map]')!.textContent=s.map;root.querySelector('[data-b-state]')!.textContent=step===0?'Slot owner':step<5?'MIGRATING to C':'No longer owns slot';root.querySelector('[data-c-state]')!.textContent=step===0?'Another primary':step<5?'IMPORTING from B':'New slot owner';for(const node of['B','C']){const box=root.querySelector(`[data-keys-${node.toLowerCase()}]`)!;box.replaceChildren();for(const key of['a','b'] as const)if(s[key]===node){const tile=document.createElement('span');tile.textContent=`${key} · ${key==='a'?'12':'stock'}`;box.append(tile);}if(!box.children.length)box.textContent='No keys in this slot';}root.querySelector('[data-route]')!.textContent=s.route;root.querySelector('[data-explanation]')!.textContent=s.note;root.querySelector<HTMLButtonElement>('[data-back]')!.disabled=step===0;root.querySelector<HTMLButtonElement>('[data-next]')!.disabled=step===migrationSteps.length-1;};root.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>{step=Math.min(step+1,migrationSteps.length-1);render();};root.querySelector<HTMLButtonElement>('[data-back]')!.onclick=()=>{step=Math.max(0,step-1);render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{step=0;render();};render();});
</script>
