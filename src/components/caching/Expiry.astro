<figure class="cache-figure" data-expiry>
 <p class="figure-title">Renewing a lifetime does not renew the answer</p>
 <div class="cache-controls"><label>TTL <select data-ttl aria-label="Cache TTL"><option value="3">3 seconds</option><option value="6" selected>6 seconds</option><option value="12">12 seconds</option></select></label><label><input type="checkbox" data-sliding /> Renew TTL on every hit</label></div>
 <p class="figure-note">Save £12 at 0 s. The source changes to £15 at 1 s. Read every 3 seconds.</p>
 <div class="expiry-track"><span>Source</span><div><i class="source-old">£12</i><i class="source-new">£15 from 1 s</i></div></div>
 <div class="expiry-requests" data-events></div>
 <p class="figure-note">Each tile is a read: M = miss, H = hit, dashed border = stale answer. Future reads are faded.</p>
 <div class="cache-controls"><label>Time <input data-time aria-label="Model time" type="range" min="0" max="24" step="1" value="0"/><output data-now>0 s</output></label><button data-next>Next event</button><button data-reset>Start again</button></div>
 <div class="cache-copy-pair"><div class="cache-copy"><small>Current source</small><strong data-source>£12</strong></div><div class="cache-copy" data-copy><small>Saved answer</small><strong data-value>£12</strong><small data-age>Loaded 0 s ago</small><div class="negative-lifetime"><i data-bar></i></div><small data-remaining>6 s until expiry</small></div></div>
 <p class="explanation" data-explanation aria-live="polite"></p>
 <figcaption>Scrub past 6 seconds, then enable renewal and compare. This serial model reloads immediately from an up-to-date source on each miss. No eviction, invalidation, loading delay or concurrent requests. Read frequency and prices are illustrative.</figcaption>
</figure>
<script>
import {expiryTrace} from '../../lib/caching/lifetimes.mjs';
document.querySelectorAll<HTMLElement>('[data-expiry]').forEach(root=>{
 const ttl=root.querySelector<HTMLSelectElement>('[data-ttl]')!,sliding=root.querySelector<HTMLInputElement>('[data-sliding]')!,time=root.querySelector<HTMLInputElement>('[data-time]')!;
 const set=(n:string,v:string)=>{root.querySelector(`[data-${n}]`)!.textContent=v;};
 const render=()=>{const t=+time.value,T=+ttl.value,s=expiryTrace(T,sliding.checked,t),full=expiryTrace(T,sliding.checked,24);
 root.querySelector('[data-events]')!.innerHTML=full.events.map(e=>`<div class="${e.time>t?'pending ':''}${e.time<=t&&e.stale?'key-wrong':''}"><small>${e.time} s</small><b>${e.time>t?'read':`${e.hit?'H':'M'} · £${e.value}`}</b></div>`).join('');
 set('now',`${t} s`);set('source',`£${s.source}`);set('value',s.cached?`£${s.cached.value}`:'No entry');set('age',s.cached?`Loaded ${t-s.cached.loaded} s ago`:'Next read will miss');set('remaining',s.cached?`Expires at ${s.cached.expires} s · ${s.cached.expires-t} s left`:'Expired');
 root.querySelector('[data-copy]')!.classList.toggle('stale',!!s.cached&&s.cached.value!==s.source);root.querySelector<HTMLElement>('[data-bar]')!.style.width=`${s.cached?(s.cached.expires-t)/T*100:0}%`;
 set('explanation',`${s.reads} source ${s.reads===1?'read':'reads'}, ${s.hits} ${s.hits===1?'hit':'hits'} so far. ${s.cached&&s.cached.value!==s.source?(sliding.checked?'The old price is still served. Renewing expiry has not read the source.':'The price is stale until a miss reloads it.'):s.cached?'The saved price matches the current source.':'The expired entry cannot serve the next read.'}`);
 root.querySelector<HTMLButtonElement>('[data-next]')!.disabled=t===24;
 };
 time.oninput=render;ttl.onchange=render;sliding.onchange=render;root.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>{const t=+time.value;time.value=String(t===0?1:Math.min(24,(Math.floor(t/3)+1)*3));render();};root.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{time.value='0';render();};render();
});
</script>
