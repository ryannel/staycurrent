---
import MotionFigure from '../relational-motion/MotionFigure.astro';
import { lines, groups, money } from './facts.mjs';
const { kind, number, title } = Astro.props;
const id = `aggregation-${kind}`;
---
{kind === 'group' || kind === 'frame' ? <MotionFigure collection="foundations/queries" kind={kind} number={number} /> : <figure class="agg-figure" data-agg={kind} aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`}><span class="fig-number">Figure {number}</span> {title}</figcaption>
  {kind === 'group' && <>
    <label class="agg-option">Group by <select data-grouping aria-label="Grouping columns"><option value="product">Product</option><option value="status">Product and status</option></select></label>
    <div class="agg-transform">
      <div><p class="agg-label">Input · five order lines</p><div class="agg-line-list">{lines.map((row,i)=><div class="agg-line" data-source={i}><span class="line-key">{row.order}/{row.line}</span><strong>{row.product}</strong><span>{row.quantity} {row.quantity===1?'unit':'units'}</span><small>{row.status}</small></div>)}</div></div>
      <div class="agg-arrow" aria-hidden="true">→<small>GROUP BY</small></div>
      <div><p class="agg-label" data-result-label data-live>Result · one row per product</p><div class="agg-buckets" data-buckets data-live>{groups(false).map(g=><div class="agg-bucket"><strong>{g.key}</strong><span>{g.rows.map(r=>r.quantity).join(' + ')} = <b>{g.units} {g.units===1?'unit':'units'}</b></span><small>{g.rows.length} order {g.rows.length===1?'line':'lines'}</small></div>)}</div></div>
    </div>
    <p class="agg-explanation" data-explanation data-live aria-live="polite">Follow each product’s lines into one summary row.</p>
  </>}
  {kind === 'population' && <>
    <label class="agg-option">Condition <select data-population aria-label="Condition to compare"><option value="where">WHERE status = 'paid'</option><option value="having">HAVING SUM(quantity) ≥ 3</option><option value="filter">FILTER (WHERE status = 'paid')</option></select></label>
    <div class="agg-transform">
      <div><p class="agg-label">The same five input lines</p><div class="agg-line-list">{lines.map((row,i)=><div class="agg-line" data-pop-source={i}><span class="line-key">{row.order}/{row.line}</span><strong>{row.product} × {row.quantity}</strong><span>{row.status}</span><small data-disposition data-live>Kept</small></div>)}</div></div>
      <div class="agg-arrow" aria-hidden="true">→<small data-operation data-live>SUM</small></div>
      <div><p class="agg-label" data-pop-result-label data-live>Product summaries</p><div class="agg-buckets" data-pop-result data-live></div></div>
    </div>
    <p class="agg-explanation" data-pop-explanation data-live aria-live="polite">WHERE removes pending lines before any group is calculated.</p>
  </>}
  {kind === 'window' && <>
    <p class="agg-label">One partition per product · one result per order line</p>
    <div class="agg-partitions">{groups(false).map(g=><div class:list={['agg-partition', { 'is-current': g.key === 'P3' }]} data-partition={g.key}>
      <div class="agg-partition-top"><strong>{g.key}</strong><span>Partition total: <b>{g.units}</b></span></div>
      <div class="agg-partition-rows">{g.rows.map(row=><div class="agg-window-row"><span><b>{row.order}/{row.line}</b><small>{row.quantity} {row.quantity===1?'unit':'units'}</small></span><span class="agg-copy-arrow" aria-hidden="true">←</span><span class="agg-attached">{g.units}<small>product_units</small></span><span>{(100*row.quantity/g.units).toFixed(1)}%<small>of this product</small></span></div>)}</div>
    </div>)}</div>
    <p class="agg-explanation" data-explanation data-live aria-live="polite">P3 has two lines. Both keep their identity and receive the total of three units.</p>
  </>}
  {kind === 'frame' && <>
    <label class="agg-option">Window <select data-frame aria-label="Window frame"><option value="default">ORDER BY placed_at · default frame</option><option value="rows">Complete order · cumulative ROWS frame</option><option value="whole">Complete order · whole-partition frame</option></select></label>
    <div class="agg-frame-scene">
      <p class="agg-label">One partition · all five lines · October 2026, UTC</p>
      <p class="agg-frame-definition" data-frame-definition data-live>RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW</p>
      <div class="agg-frame-lines">{lines.map((row,i)=><div class="agg-frame-row" data-frame-row={i}>
        <span class="agg-current" data-current data-live>{i===0?'▶':' '}</span><span class="line-key">{row.order}/{row.line}<small>{row.product}</small></span><span>{row.stamp}</span><strong>{money(row.cents)}</strong><small data-membership data-live>{i<2?'In frame':'Outside frame'}</small>
      </div>)}</div>
      <div class="agg-frame-answer" data-live><span>SUM for the current row</span><strong data-frame-sum>39.50</strong><small data-equation>4.50 + 35.00</small></div>
    </div>
    <p class="agg-explanation" data-explanation data-live aria-live="polite">The current row is 101/1. Its timestamp peer, 101/2, is in the default frame too.</p>
  </>}
  {(kind === 'group' || kind === 'frame') && <div class="agg-controls" role="group" aria-label={`Figure ${number} controls`}>
    <button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step data-live>1 / 4</span><div class="agg-hold" data-hold aria-hidden="true"><span></span></div>
  </div>}
  {kind === 'group' && <><p class="agg-caption">Line labels are order ID/line number. The drawing follows which rows contribute, rather than the engine’s execution. Add status to the grouping columns and watch the two mixed-status products split.</p><details><summary>Both grouped results, as text</summary><p>By product: P3 has 2 lines and 3 units; P7 has 2 lines and 3 units; P9 has 1 line and 1 unit. By product and status: P3 paid 1, P3 pending 2, P7 paid 2, P7 pending 1, P9 paid 1. Each is a separate result row.</p></details></>}
  {kind === 'population' && <><p class="agg-caption">“Removed” means the line reaches no aggregate. FILTER retains the line for the all-units sum while excluding it from the paid-units sum. HAVING rejects summary rows after their sums are formed.</p><details><summary>All three results, as text</summary><p>WHERE paid: P3 1 unit, P7 2, P9 1. HAVING at least 3 units: P3 3 and P7 3; P9’s group is rejected. FILTER paid alongside all units: P3 all 3/paid 1, P7 all 3/paid 2, P9 all 1/paid 1.</p></details></>}
  {kind === 'window' && <p class="agg-caption">Read each bracketed partition separately. The total is attached to each of its lines; adding those repeated totals would count it twice for P3 and P7. The percentages use quantity divided by that product’s total.</p>}
  {kind === 'frame' && <><p class="agg-caption">The arrow marks the current row; a solid left border and “In frame” mark contributors. Each pair of lines in order 101 or 103 shares a timestamp. The complete order adds order ID and line number.</p><details><summary>All frame results, as text</summary><p>In line order 101/1, 101/2, 102/1, 103/1, 103/2, the default ordered sums are 39.50, 39.50, 79.50, 108.50, 108.50. The cumulative ROWS sums are 4.50, 39.50, 79.50, 99.50, 108.50. The whole-partition sum is 108.50 for every line.</p></details></>}
</figure>}
<script>
import { stepper } from '../figures/stepper.mjs';
import { lines, products, groups, money, frameIndices } from './facts.mjs';
for (const root of document.querySelectorAll<HTMLElement>('[data-agg]')) {
  const text = (selector:string, value:string) => { const node=root.querySelector(selector); if(node) node.textContent=value; };
  const kind=root.dataset.agg;
  if(kind==='group') {
    const choice=root.querySelector<HTMLSelectElement>('[data-grouping]')!;
    const draw=(step:number)=>{
      const split=choice.value==='status', buckets=groups(split), active=buckets[step-1];
      root.querySelectorAll<HTMLElement>('[data-source]').forEach((node,i)=>node.classList.toggle('is-contributor',!!active?.rows.includes(lines[i])));
      text('[data-result-label]',split?'Result · one row per product and status':'Result · one row per product');
      root.querySelector('[data-buckets]')!.innerHTML=buckets.map((g,i)=>`<div class="agg-bucket ${i===step-1?'is-current':''}"><strong>${g.key}</strong><span>${i<step?`${g.rows.map(r=>r.quantity).join(' + ')} = <b>${g.units} ${g.units===1?'unit':'units'}</b>`:'—'}</span><small>${i<step?`${g.rows.length} order ${g.rows.length===1?'line':'lines'}`:'Group waiting'}</small></div>`).join('');
      text('[data-explanation]',!active?`Five input lines. ${split?'Product and status make five groups.':'Product makes three groups.'} Step through to follow each group’s contributors.`:`${active.key}: ${active.rows.length===1?'line':'lines'} ${active.rows.map(r=>`${r.order}/${r.line}`).join(' and ')} ${active.rows.length===1?'contributes':'contribute'} ${active.rows.map(r=>r.quantity).join(' + ')} = ${active.units} ${active.units===1?'unit':'units'}. ${active.rows.length===1?'This line becomes':'These lines become'} one result row.`);
    };
    const player=stepper(root,{steps:()=>groups(choice.value==='status').length+1,draw});
    choice.addEventListener('change',()=>{root.querySelector<HTMLButtonElement>('[data-reset]')!.click(); player.render();});
  }
  if(kind==='population') {
    const choice=root.querySelector<HTMLSelectElement>('[data-population]')!;
    const draw=()=>{
      const mode=choice.value;
      root.querySelectorAll<HTMLElement>('[data-pop-source]').forEach((node,i)=>{
        node.classList.toggle('is-removed',mode==='where'&&lines[i].status==='pending');
        node.classList.toggle('is-contributor',mode!=='where'||lines[i].status==='paid');
        node.querySelector('[data-disposition]')!.textContent=mode==='where'?(lines[i].status==='paid'?'Kept':'Removed'):mode==='filter'?(lines[i].status==='paid'?'Both sums':'All-units sum only'):'Kept for grouping';
      });
      text('[data-operation]',mode==='having'?'SUM → HAVING':mode==='filter'?'TWO SUMS':'WHERE → SUM');
      root.querySelector('[data-pop-result]')!.innerHTML=groups(false).map(g=>{
        const paid=g.rows.filter(r=>r.status==='paid').reduce((sum,r)=>sum+r.quantity,0);
        const rejected=mode==='having'&&g.units<3;
        return `<div class="agg-bucket ${rejected?'is-removed':''}"><strong>${g.key}</strong><span>${mode==='filter'?`All <b>${g.units}</b> · paid <b>${paid}</b>`:`${mode==='where'?paid:g.units} ${(mode==='where'?paid:g.units)===1?'unit':'units'}`}</span><small>${rejected?'Group rejected':'Result row'}</small></div>`;
      }).join('');
      text('[data-pop-explanation]',mode==='where'?'WHERE removes both pending lines before grouping. The sums know only paid lines: tea 1, mugs 2, teapot 1.':mode==='having'?'All five lines reach grouping. HAVING keeps the two groups with at least three units and removes the teapot’s one-unit group.':'All five lines reach grouping. FILTER gives only the paid lines to paid_units; all_units still receives every line.');
    }; choice.addEventListener('change',draw); draw();
  }

  if(kind==='frame') {
    const choice=root.querySelector<HTMLSelectElement>('[data-frame]')!;
    const draw=(step:number)=>{
      const mode=choice.value, indices=frameIndices(mode,step), row=lines[step];
      root.querySelectorAll<HTMLElement>('[data-frame-row]').forEach((node,i)=>{
        node.classList.toggle('is-contributor',indices.includes(i)); node.classList.toggle('is-current',i===step);
        node.querySelector('[data-current]')!.textContent=i===step?'▶':'';
        node.querySelector('[data-membership]')!.textContent=indices.includes(i)?'In frame':'Outside frame';
      });
      text('[data-frame-definition]',mode==='default'?'RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW':mode==='rows'?'ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW':'ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING');
      text('[data-frame-sum]',money(indices.reduce((sum,i)=>sum+lines[i].cents,0)));
      text('[data-equation]',indices.map(i=>money(lines[i].cents)).join(' + '));
      text('[data-explanation]',`Current row: ${row.order}/${row.line}. ${mode==='default'?`The frame reaches the last peer at ${row.stamp}, including ${indices.length} lines.`:mode==='rows'?`The complete order makes this line’s position unambiguous. The frame stops here, after ${indices.length} ${indices.length===1?'line':'lines'}.`:'The frame reaches both ends of the partition. All five lines contribute, whichever row is current.'}`);
    }; const player=stepper(root,{steps:()=>5,draw}); choice.addEventListener('change',()=>player.render());
  }
}
</script>
<style is:global>
.agg-figure { margin:2rem -2rem; font:.86rem/1.55 var(--font-sans); }
.agg-figure figcaption { font:1.15rem/1.4 var(--font-serif); margin-bottom:.8rem; }
.agg-figure .fig-number { color:var(--color-text-secondary); font:.65rem var(--font-sans); text-transform:uppercase; letter-spacing:.12em; margin-right:.6rem; white-space:nowrap; }
.agg-figure .agg-option { display:flex; align-items:center; flex-wrap:wrap; gap:.6rem; font:.8rem/1.5 var(--font-sans); padding:.8rem 1rem; background:var(--color-surface-alt); border:1px solid var(--color-rule); }
.agg-figure select { max-width:100%; padding:.4rem; color:var(--color-text); background:var(--color-surface); border:1px solid var(--color-rule-strong); font:inherit; }
.agg-figure .agg-transform { display:grid; grid-template-columns:minmax(0,1fr) 60px minmax(0,1fr); padding:1rem; border:1px solid var(--color-rule-strong); gap:.65rem; background:var(--color-surface); }
.agg-figure .agg-label { font:.72rem/1.5 var(--font-sans); text-transform:uppercase; letter-spacing:.05em; color:var(--color-text-secondary); margin:0 0 .8rem; }
.agg-figure .agg-line-list,.agg-figure .agg-buckets { display:grid; gap:.45rem; }
.agg-figure .agg-line { display:grid; grid-template-columns:1fr 1fr; padding:.55rem .65rem; gap:.1rem .5rem; border:1px solid var(--color-rule); border-left:3px solid var(--color-rule-strong); background:var(--color-surface); }
.agg-figure small { display:block; color:var(--color-text-secondary); font:.72rem/1.5 var(--font-sans); }
.agg-figure .line-key { font:.8rem/1.5 var(--font-mono); }
.agg-figure .agg-bucket { display:grid; gap:.2rem; padding:.65rem .75rem; border:1px solid var(--color-rule-strong); border-left:3px solid var(--color-rule-strong); min-height:70px; background:var(--color-surface); }
.agg-figure .agg-arrow { display:flex; justify-content:center; align-items:center; flex-direction:column; font-size:1.6rem; color:var(--teal); }
.agg-figure .agg-arrow small { font-size:.6rem; text-align:center; }
.agg-figure .is-contributor { border-left-color:var(--teal); background:color-mix(in srgb, var(--teal) 10%, var(--color-surface)); }
.agg-figure .is-current { outline:2px solid var(--teal); outline-offset:1px; }
.agg-figure .is-removed { border-style:dashed; border-color:var(--coral); background:var(--color-surface-alt); }
.agg-figure .is-removed small { color:var(--color-text-secondary); }
.agg-figure .agg-explanation { font:.85rem/1.65 var(--font-sans); margin:0; padding:1rem 1.1rem; min-height:5.6rem; border:1px solid var(--color-rule-strong); border-top:0; background:var(--color-surface-alt); }
.agg-figure .agg-controls { display:flex; align-items:center; flex-wrap:wrap; gap:.4rem; padding:.65rem .8rem; background:var(--color-surface-alt); border:1px solid var(--color-rule-strong); border-top:0; }
.agg-figure button { color:var(--color-text); background:var(--color-surface); border:1px solid var(--color-rule-strong); border-radius:3px; min-height:38px; padding:.4rem .65rem; font:.75rem var(--font-sans); cursor:pointer; }
.agg-figure button[data-play] { color:var(--color-surface); background:var(--color-text); }
.agg-figure button[aria-disabled="true"] { color:var(--color-text-secondary); cursor:default; }
.agg-figure button:focus-visible,.agg-figure select:focus-visible,.agg-figure summary:focus-visible { outline:2px solid var(--teal); outline-offset:3px; }
.agg-figure [data-step] { margin-left:auto; font:.7rem var(--font-mono); color:var(--color-text-secondary); }
.agg-figure .agg-hold { flex-basis:100%; height:2px; overflow:hidden; background:var(--color-rule); }
.agg-figure .agg-hold span { display:block; height:100%; width:0; background:var(--teal); }
.agg-figure[data-agg="window"] .agg-attached { color:var(--color-accent); }
.agg-figure .agg-caption { font:.78rem/1.65 var(--font-sans); color:var(--color-text-secondary); margin:.7rem 0 0; }
.agg-figure details { font:.78rem/1.65 var(--font-sans); margin:.7rem 0 0; }
.agg-figure summary { cursor:pointer; text-decoration:underline; text-underline-offset:3px; }
.agg-figure details p { font:inherit; }
.agg-figure .agg-partitions { display:grid; gap:.85rem; border:1px solid var(--color-rule-strong); padding:1rem; }
.agg-figure .agg-partition { border:1px dashed var(--color-text-secondary); padding:.5rem .65rem; }
.agg-figure .agg-partition-top { display:flex; justify-content:space-between; font-size:.75rem; margin-bottom:.35rem; }
.agg-figure .agg-window-row { display:grid; grid-template-columns:1fr 20px 1fr 1fr; gap:.4rem; padding:.5rem .2rem; border-top:1px solid var(--color-rule); align-items:center; }
.agg-figure .agg-attached { color:var(--teal); font-size:1.15rem; }
.agg-figure .agg-copy-arrow { color:var(--teal); }
.agg-figure .agg-frame-scene { padding:1rem; border:1px solid var(--color-rule-strong); }
.agg-figure .agg-frame-definition { font:.7rem/1.7 var(--font-mono); min-height:2.8em; margin:0 0 .7rem; overflow-wrap:anywhere; }
.agg-figure .agg-frame-lines { display:grid; gap:.35rem; }
.agg-figure .agg-frame-row { display:grid; grid-template-columns:12px 66px 1fr 55px 84px; align-items:center; gap:.45rem; padding:.55rem .5rem; border:1px solid var(--color-rule); border-left:3px solid var(--color-rule-strong); }
.agg-figure .agg-frame-row.is-contributor { border-left:3px solid var(--teal); background:color-mix(in srgb, var(--teal) 10%, var(--color-surface)); }
.agg-figure .agg-frame-row strong { text-align:right; font-variant-numeric:tabular-nums; }
.agg-figure .agg-current { color:var(--teal); font-size:.7rem; }
.agg-figure .agg-frame-answer { display:grid; grid-template-columns:1fr auto; gap:.3rem 1rem; border-top:1px solid var(--color-rule-strong); padding-top:.9rem; margin-top:.9rem; align-items:baseline; }
.agg-figure .agg-frame-answer strong { font:1.8rem/1.2 var(--font-serif); color:var(--teal); }
.agg-figure .agg-frame-answer small { grid-column:1 / -1; font-family:var(--font-mono); }
@media(max-width:800px) { .agg-figure { margin:2rem 0; } }
@media(max-width:550px) {
  .agg-figure .agg-transform { grid-template-columns:1fr; padding:.8rem; }
  .agg-figure .agg-line-list { grid-template-columns:1fr 1fr; }
  .agg-figure .agg-line { font-size:.74rem; padding:.45rem; }
  .agg-figure .agg-line-list .agg-line:last-child { grid-column:1 / -1; }
  .agg-figure .agg-arrow { transform:none; font-size:0; gap:.25rem; }
  .agg-figure .agg-arrow:before { content:'↓'; font-size:1.4rem; }
  .agg-figure .agg-buckets { grid-template-columns:1fr; }
  .agg-figure .agg-bucket { min-height:0; grid-template-columns:1fr 1fr; gap:.1rem .5rem; font-size:.8rem; }
  .agg-figure .agg-bucket small { grid-column:1 / -1; }
  .agg-figure .agg-frame-row { grid-template-columns:10px 52px 1fr 48px; gap:.3rem; font-size:.74rem; }
  .agg-figure .agg-frame-row > small { grid-column:3 / -1; }
  .agg-figure .agg-frame-scene { padding:.65rem; }
  .agg-figure .agg-partition-top { flex-wrap:wrap; gap:.2rem; }
  .agg-figure .agg-partitions { padding:.7rem; }
  .agg-figure .agg-window-row { grid-template-columns:1fr 12px 1fr 1fr; gap:.25rem; font-size:.75rem; }
  .agg-figure .agg-window-row small { font-size:.7rem; overflow-wrap:anywhere; }
}
</style>
