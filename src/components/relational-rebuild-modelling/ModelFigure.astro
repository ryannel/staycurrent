---
import MotionFigure from '../relational-motion/MotionFigure.astro';
import { models } from './models.mjs';
import './figures.css';
const { model, number } = Astro.props;
const data = models[model];
const titleId = `mf-${model}-title`;
---
{data.steps.length > 1 ? <MotionFigure collection="foundations/modelling" kind={model} number={number} id={titleId} /> : <figure class="mf" data-model={model} aria-labelledby={titleId}>
  <figcaption id={titleId}><span class="mf-number">Figure {number}</span> {data.title}</figcaption>
  <div class="mf-stage" data-scene data-live set:html={data.steps[0].html} />
  <p class="mf-explanation" data-live data-explanation aria-live="polite">{data.steps[0].explanation}</p>
  {data.steps.length > 1 && <>
    <div class="mf-controls" role="group" aria-label={`Figure ${number} controls`}>
      <button type="button" data-play>Play</button>
      <button type="button" data-back>Back</button>
      <button type="button" data-next>Next</button>
      <button type="button" data-reset>Reset</button>
      <span data-step>1 / {data.steps.length}</span>
    </div>
    <div class="mf-hold" data-hold aria-hidden="true"><span></span></div>
  </>}
  <p class="mf-caption">{data.caption}</p>
  {data.steps.length > 1 && <details class="mf-alt"><summary>All steps as text</summary><ol>{data.steps.map(s => <li>{s.explanation}</li>)}</ol></details>}
</figure>}
<script>
  import { models } from './models.mjs';
  import { stepper } from '../figures/stepper.mjs';
  document.querySelectorAll<HTMLElement>('.mf[data-model]').forEach(root => {
    const model = models[root.dataset.model];
    if (!model || model.steps.length < 2) return;
    const scene = root.querySelector<HTMLElement>('[data-scene]');
    const explanation = root.querySelector<HTMLElement>('[data-explanation]');
    stepper(root, { steps: () => model.steps.length, draw: index => {
      scene.innerHTML = model.steps[index].html;
      explanation.textContent = model.steps[index].explanation;
    }});
  });
</script>
