---
import { frames } from './models.mjs';
interface Props { kind: string; number: number; title: string; caption: string; }
const {kind,number,title,caption}=Astro.props;
const choice=kind==='versions'?'pg':kind==='crash'?'durable':'';
const initial=frames(kind,choice)[0];
---
<figure class="sd-figure" data-storage-journey={kind} aria-labelledby={`sd-title-${kind}`}>
 <figcaption id={`sd-title-${kind}`}><span>Figure {number}</span> {title}</figcaption>
 {kind==='versions'&&<label class="sd-option">Engine <select data-choice aria-label="Engine for figure 2"><option value="pg">PostgreSQL</option><option value="innodb">InnoDB</option></select></label>}
 {kind==='crash'&&<label class="sd-option">Power fails <select data-choice aria-label="Crash cut for figure 4"><option value="durable">After durable commit, before reply</option><option value="before">Before durable commit</option><option value="reply">After durable reply</option><option value="early">After an early asynchronous reply</option></select></label>}
 <div class="sd-scene" data-scene data-live set:html={initial.scene}></div>
 <p class="sd-action" data-action data-live>{initial.action}</p>
 <p class="sd-explanation" data-explanation data-live aria-live="polite">{initial.note}</p>
 <div class="sd-controls" role="group" aria-label={`Controls for figure ${number}`}><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step data-live></span></div>
 <div class="sd-hold" data-hold aria-hidden="true"><span></span></div>
 <p class="sd-caption">{caption}</p>
 <details><summary>Figure as text</summary>
  {kind==='buffers'&&<ol><li>A query needs the page holding P7.</li><li>A miss loads the page into a buffer; an operating-system cache can satisfy the file read.</li><li>P7 and P3 can then be read from that cached page.</li><li>When the finite pool fills, another miss needs a reusable slot.</li></ol>}
  {kind==='versions'&&<ol><li>An earlier snapshot sees P7 at 20.00.</li><li>PostgreSQL adds a version in the table; InnoDB retains undo information for reconstruction.</li><li>After the writer commits, a later query reads 22.00 while the earlier report still reads 20.00.</li><li>When nothing requires the old material, cleanup may reclaim it for reuse.</li></ol>}
  {kind==='wal'&&<ol><li>P7 starts at 20.00.</li><li>The update changes a buffered page and generates change record U.</li><li>COMMIT adds outcome record C.</li><li>The required log is flushed to durable storage.</li><li>The application receives success while the table file may still be older.</li><li>The page is written later, after its WAL is durable.</li></ol>}
  {kind==='crash'&&<ul><li>Before a durable commit survives: recovered price 20.00; no successful durable reply.</li><li>After durable commit but before reply: recovered price 22.00; application uncertain.</li><li>After durable reply: recovered price 22.00; application heard success.</li><li>After an early asynchronous reply, before durable WAL: recovered price can be 20.00 despite reported success.</li></ul>}
 </details>
</figure>
<script>
 import { stepper } from '../figures/stepper.mjs';
 import { frames } from './models.mjs';
 document.querySelectorAll('[data-storage-journey]').forEach(root=>{
  if(!(root instanceof HTMLElement))return;
  const kind=root.dataset.storageJourney;
  const choice=root.querySelector('select');
  const current=()=>frames(kind,choice?.value);
  const player=stepper(root,{steps:()=>current().length,draw:i=>{
   const f=current()[i]; root.querySelector('[data-scene]').innerHTML=f.scene;
   root.querySelector('[data-action]').textContent=f.action;
   root.querySelector('[data-explanation]').textContent=f.note;
  }});
  choice?.addEventListener('change',()=>player.render());
 });
</script>
<style is:global>
.sd-figure{margin:2rem -3.75rem;padding:0;font-family:var(--font-sans);font-size:.86rem;line-height:1.6}
.sd-figure figcaption{margin-bottom:.7rem;font:1.1rem/1.5 var(--font-serif)}
.sd-figure figcaption>span{font: .7rem var(--font-sans);text-transform:uppercase;letter-spacing:.1em;color:var(--color-text-secondary);margin-right:.7rem}
.sd-scene{border:1px solid var(--color-rule-strong);padding:1rem;background:var(--color-surface-alt)}
.sd-lane{border:1px solid var(--color-rule);padding:.65rem;margin-bottom:.65rem}.sd-lane:last-child{margin-bottom:0}
.sd-columns{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.sd-lane>.sd-columns:has(>.sd-page:only-child){grid-template-columns:1fr}
.sd-label{display:block;font:.74rem/1.5 var(--font-sans);color:var(--color-text-secondary);margin:0 0 .45rem!important}
.sd-page{padding:.55rem;border:1px solid var(--color-rule-strong);background:var(--color-surface);min-width:0}.sd-page>b{display:block;font:.74rem/1.5 var(--font-sans);margin-bottom:.4rem}
.sd-row{display:flex;justify-content:space-between;gap:.4rem;padding:.26rem .35rem;font:.75rem/1.65 var(--font-mono);border-bottom:1px solid var(--color-rule)}.sd-row strong{font-weight:600}.sd-focus{border-left:3px solid var(--teal);background:var(--color-surface-alt)}
.sd-dirty{border:2px solid var(--coral)}.sd-empty{border:1px dashed var(--color-rule-strong);padding:1rem .5rem;min-height:3rem;color:var(--color-text-secondary);font-size:.76rem}
.sd-record{border:1px solid var(--teal);padding:.5rem;margin:.4rem 0;font:.75rem/1.6 var(--font-mono);overflow-wrap:anywhere}.sd-muted{border-style:dashed;color:var(--color-text-secondary)}
.sd-action{margin:0!important;padding:.75rem 1rem;border:1px solid var(--color-rule-strong);border-top:0;font-weight:600;background:var(--color-surface-alt)}
.sd-explanation{padding:.8rem 1rem;margin:0!important;border-left:3px solid var(--teal);min-height:4.6rem;font:.86rem/1.65 var(--font-sans)}
.sd-controls{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;background:var(--color-surface-alt);padding:.7rem;border:1px solid var(--color-rule)}
.sd-controls button,.sd-option select{font:.8rem/1.4 var(--font-sans);padding:.45rem .65rem;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-rule-strong);border-radius:3px}
.sd-controls button{cursor:pointer}.sd-controls button[aria-disabled=true]{color:var(--color-text-secondary);cursor:default}.sd-controls [data-step]{margin-left:auto;font:.75rem var(--font-mono)}
.sd-option{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;margin:.6rem 0}.sd-option select{max-width:100%}
.sd-hold{height:3px;background:var(--color-rule)}.sd-hold>span{display:block;height:100%;width:0;background:var(--teal)}
.sd-caption{font:.78rem/1.65 var(--font-sans);color:var(--color-text-secondary);margin:.6rem 0!important}.sd-figure details{font:.8rem/1.7 var(--font-sans)}.sd-figure summary{cursor:pointer}.sd-figure details li{margin:.4rem 0}
.sd-readers{display:flex;justify-content:space-between;gap:.7rem;flex-wrap:wrap;border-top:1px solid var(--color-rule);padding-top:.6rem}.sd-free{border:1px dashed var(--teal);padding:.4rem;margin-top:.4rem;color:var(--color-text-secondary);font-size:.76rem}.sd-reply{margin:.7rem 0 0!important;font-size:.82rem}
.sd-static{margin:2rem -3.75rem;font:.85rem/1.7 var(--font-sans)}.sd-static figcaption{font:1.1rem/1.5 var(--font-serif);margin-bottom:.7rem}.sd-static figcaption span{font:.7rem var(--font-sans);text-transform:uppercase;letter-spacing:.1em;color:var(--color-text-secondary);margin-right:.7rem}
.sd-timeline{display:flex;gap:.35rem;align-items:stretch;margin:.7rem 0}.sd-timeline>div{flex:1;border:1px solid var(--color-rule-strong);padding:.7rem;background:var(--color-surface-alt)}.sd-timeline .sd-needed{border-top:3px solid var(--teal)}.sd-timeline b,.sd-timeline small{display:block}.sd-timeline small{color:var(--color-text-secondary)}
.sd-work{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;border:1px solid var(--color-rule);padding:1rem;background:var(--color-surface-alt)}.sd-work>div{padding:.6rem;border:1px solid var(--color-rule-strong);background:var(--color-surface)}.sd-work b{display:block}.sd-work small{display:block;color:var(--color-text-secondary)}
.sd-controls button:focus-visible,.sd-option select:focus-visible,.sd-figure summary:focus-visible{outline:2px solid var(--teal);outline-offset:3px}
@media(max-width:850px){.sd-figure,.sd-static{margin:2rem 0}}
@media(max-width:550px){.sd-columns,.sd-work{grid-template-columns:1fr}.sd-scene{padding:.5rem}.sd-timeline{flex-direction:column}.sd-explanation{min-height:0}.sd-row{font-size:.73rem}}
</style>
