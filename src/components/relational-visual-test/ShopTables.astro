---
import { customers, orders } from './shop';
import './tables.css';
interface Props { linked?: boolean }
const { linked = false } = Astro.props;
const id = linked ? 'follow-order' : 'read-customer';
const title = linked ? 'From an order to its customer' : 'Three customers, two facts about each';
---
<figure class="rv-figure" aria-labelledby={`${id}-title`}>
  <div class="rv-heading"><span>Figure {linked ? 2 : 1}</span><p id={`${id}-title`}>{title}</p></div>
  <div class="rv-board paper-surface" data-order-tables={linked ? '' : undefined}>
    <div class:list={['rv-tables', { 'rv-linked': linked }]}>
      {linked && <>
        <div class="rv-table-wrap">
          <table>
            <caption><code>orders</code><span>One row per order</span></caption>
            <thead><tr><th scope="col"><code>order_id</code></th><th scope="col"><code>customer_id</code></th></tr></thead>
            <tbody>{orders.map(order => <tr data-order={order.order_id} class:list={{'rv-selected': order.order_id === 103}}><th scope="row">{order.order_id}</th><td><span class="rv-identifier">{order.customer_id}</span></td></tr>)}</tbody>
          </table>
        </div>
        <div class="rv-connection" aria-hidden="true"><span>match</span><svg class="rv-across"><path data-link-path /></svg><svg class="rv-down" viewBox="0 0 22 44"><path d="M11 2V38M3 30l8 8 8-8"/></svg></div>
      </>}
      <div class="rv-table-wrap">
        <table>
          <caption><code>customers</code><span>One row per customer</span></caption>
          <thead><tr><th scope="col"><code>customer_id</code></th><th scope="col"><code>name</code></th></tr></thead>
          <tbody>{customers.map(customer => <tr data-customer={customer.customer_id} class:list={{'rv-selected': customer.customer_id === 1}}><th scope="row"><span class="rv-identifier">{customer.customer_id}</span></th><td>{customer.name}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
    {linked && <p class="rv-result" aria-live="polite" data-result>Order 103 stores customer_id 1. In customers, 1 belongs to Mina Shah.</p>}
  </div>
  {linked && <div class="rv-controls" data-order-controls hidden role="group" aria-label="Choose an order to follow"><span>Follow order</span>{orders.map(order => <button type="button" data-choose-order={order.order_id} aria-pressed={String(order.order_id === 103)}>{order.order_id}</button>)}</div>}
  <figcaption>{linked ? <>The outlined rows belong together because their <code>customer_id</code> values match. The shop data is invented.</> : <>Read across the outlined row: customer <code>1</code> is named Mina Shah. Read down <code>name</code>: every value in that column is a customer’s name.</>}</figcaption>
  {linked && <details class="rv-text"><summary>Every order’s customer, as text</summary><ul>{orders.map(order => <li>Order {order.order_id} → customer {order.customer_id} → {customers.find(customer => customer.customer_id === order.customer_id)!.name}.</li>)}</ul></details>}
</figure>
<script>
  import { customers, orders } from './shop';
  document.querySelectorAll<HTMLElement>('[data-order-tables]').forEach(board => {
    const controls = board.parentElement!.querySelector<HTMLElement>('[data-order-controls]')!;
    const buttons = controls.querySelectorAll<HTMLButtonElement>('[data-choose-order]');
    const drawLink = () => {
      const connector = board.querySelector<HTMLElement>('.rv-connection')!;
      const source = board.querySelector('[data-order].rv-selected')!.getBoundingClientRect();
      const target = board.querySelector('[data-customer].rv-selected')!.getBoundingClientRect();
      const bounds = connector.getBoundingClientRect();
      const from = source.top + source.height / 2 - bounds.top;
      const to = target.top + target.height / 2 - bounds.top;
      const end = bounds.width - 6;
      board.querySelector('[data-link-path]')!.setAttribute('d', `M4 ${from} C${bounds.width / 2} ${from},${bounds.width / 2} ${to},${end} ${to} M${end - 7} ${to - 6} L${end} ${to} L${end - 7} ${to + 6}`);
    };
    buttons.forEach(button => button.addEventListener('click', () => {
      const order = orders.find(order => order.order_id === Number(button.dataset.chooseOrder))!;
      const customer = customers.find(customer => customer.customer_id === order.customer_id)!;
      board.querySelectorAll<HTMLElement>('[data-order]').forEach(row => row.classList.toggle('rv-selected', Number(row.dataset.order) === order.order_id));
      board.querySelectorAll<HTMLElement>('[data-customer]').forEach(row => row.classList.toggle('rv-selected', Number(row.dataset.customer) === customer.customer_id));
      buttons.forEach(option => option.setAttribute('aria-pressed', String(option === button)));
      board.querySelector('[data-result]')!.textContent = `Order ${order.order_id} stores customer_id ${order.customer_id}. In customers, ${customer.customer_id} belongs to ${customer.name}.`;
      drawLink();
    }));
    controls.hidden = false;
    new ResizeObserver(drawLink).observe(board);
    drawLink();
  });
</script>
