---
import './figures.css';
import Controls from './Controls.astro';
import { raceSteps } from './shop.mjs';
---
<div class="rf-figure" data-rf-race>
 <figure aria-labelledby="rf-race-title">
  <div class="rf-head"><span class="rf-number">Figure 4</span><p class="rf-name" id="rf-race-title">Who gets the last blue mug?</p></div>
  <div class="rf-board">
   <div class="rf-stat-row" data-live><p><strong data-race-stock>1</strong><span>P7’s committed stock</span></p><p><strong data-race-orders>neither</strong><span>Orders committed in this race</span></p></div>
   <ol class="rf-schedule" data-race-schedule data-live><li><span class="rf-who">Start</span><span class="rf-event">P7 has one mug left.<small>Orders 103 and 104 have not committed.</small></span></li></ol>
   <p class="rf-explanation" data-explanation data-live aria-live="polite">Start with stock 1. Both applications want one mug.</p>
  </div>
  <div class="rf-controls rf-js-controls">
   <fieldset class="rf-options"><legend>Stock change</legend><button type="button" data-race-mode="unsafe" aria-pressed="true">Read, then write 0</button><button type="button" data-race-mode="guarded" aria-pressed="false">Conditional UPDATE</button></fieldset>
   <Controls label="Playback for figure 4" />
  </div>
  <figcaption>Two chosen schedules, illustrating PostgreSQL at Read Committed. Each buyer uses a transaction for their stock change and order. Only the mug is drawn; Mina’s tea lines and stock change belong to order 103’s same transaction. The steps are an explanation, not a recorded database run.</figcaption>
  <details><summary>Both schedules, as text</summary>{[false, true].map(guarded => <Fragment><p class="rf-state-title">{guarded ? 'With the conditional UPDATE' : 'With a separate read and saved value'}</p><ol>{raceSteps(guarded).map(s => <li>{s.who}: {s.action} {s.effect}</li>)}</ol></Fragment>)}</details>
 </figure>
</div>
<script>
 import { stepper } from '../figures/stepper.mjs';
 import { raceSteps } from './shop.mjs';
 document.querySelectorAll<HTMLElement>('[data-rf-race]').forEach(root => {
  let guarded = false;
  const player = stepper(root, { steps: () => raceSteps(guarded).length, draw: (step: number) => {
   const schedule = raceSteps(guarded);
   const current = schedule[step];
   root.querySelector('[data-race-stock]')!.textContent = String(current.stock);
   root.querySelector('[data-race-orders]')!.textContent = current.committed;
   root.querySelector('[data-race-schedule]')!.innerHTML = schedule.slice(0, step + 1).map((event, index) => `<li ${index === step ? 'aria-current="step"' : ''}><span class="rf-who">${event.who}</span><span class="rf-event">${event.action}<small>${event.effect}</small></span></li>`).join('');
   root.querySelector('[data-explanation]')!.textContent = step === 0 ? 'Start with stock 1. Both applications want one mug.' : current.effect;
  }});
  root.querySelectorAll<HTMLButtonElement>('[data-race-mode]').forEach(button => button.addEventListener('click', () => {
   guarded = button.dataset.raceMode === 'guarded';
   root.querySelectorAll<HTMLButtonElement>('[data-race-mode]').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
   player.render();
  }));
  root.dataset.ready = 'true';
 });
</script>
