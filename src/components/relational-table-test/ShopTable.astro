---
interface Props { table: 'customers' | 'orders' }
const { table } = Astro.props;
const customers = [
  { customer_id: 1, name: 'Mina Shah' },
  { customer_id: 2, name: 'Tariq Aziz' },
  { customer_id: 3, name: 'Edda Berg' },
];
const orders = [
  { order_id: 101, customer_id: 1 },
  { order_id: 102, customer_id: 2 },
  { order_id: 103, customer_id: 1 },
];
const isCustomers = table === 'customers';
const title = isCustomers ? 'Three customers' : 'Three orders';
const titleId = `shop-${table}-title`;
---
<figure class="shop-table" aria-labelledby={titleId}>
  <div class="shop-table-heading">
    <span class="shop-table-number">Figure {isCustomers ? 1 : 2}</span>
    <p id={titleId}>{title}</p>
  </div>
  <div class="shop-table-paper">
    <table>
      <caption><code>{table}</code></caption>
      <thead>
        <tr>
          <th scope="col"><code>{isCustomers ? 'customer_id' : 'order_id'}</code></th>
          <th scope="col"><code>{isCustomers ? 'name' : 'customer_id'}</code></th>
        </tr>
      </thead>
      <tbody>
        {isCustomers
          ? customers.map((customer) => <tr><td>{customer.customer_id}</td><td>{customer.name}</td></tr>)
          : orders.map((order) => <tr><td>{order.order_id}</td><td>{order.customer_id}</td></tr>)}
      </tbody>
    </table>
  </div>
  <figcaption>{isCustomers
    ? 'One row per customer. The column headings name the two facts kept about each one.'
    : 'One row per order. Read customer_id against the same column in Figure 1 to find who placed it.'}</figcaption>
</figure>

<style>
  .shop-table { max-width: 32rem; margin: 2rem auto; }
  .shop-table-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: .65rem; margin-bottom: .55rem; }
  .shop-table-heading p { margin: 0; font: 1.15rem/1.4 var(--font-serif); color: var(--color-text); }
  .shop-table-number { color: var(--color-text-secondary); font: .68rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .shop-table-paper { padding: 1rem 1.2rem; border: 1px solid var(--color-text-secondary); background: var(--color-surface-alt); }
  .shop-table table { display: table; width: 100%; margin: 0; border-collapse: collapse; font: .95rem/1.5 var(--font-sans); color: var(--color-text); }
  .shop-table caption { margin: 0 0 .8rem; text-align: left; color: var(--color-text); }
  .shop-table th, .shop-table td { padding: .6rem .7rem; border: 0; border-bottom: 1px solid var(--color-text-secondary); text-align: left; }
  .shop-table th { font-weight: 600; background: none; }
  .shop-table td { font-variant-numeric: tabular-nums; }
  .shop-table tbody tr:last-child td { border-bottom: 0; }
  .shop-table code { padding: 0; background: none; font: .82rem/1.4 var(--font-mono); color: inherit; white-space: nowrap; }
  .shop-table caption code { font-size: .92rem; font-weight: 600; }
  .shop-table figcaption { margin-top: .65rem; color: var(--color-text-secondary); font: .8rem/1.5 var(--font-sans); }
  @media (max-width: 480px) {
    .shop-table-paper { padding: .8rem .45rem; }
    .shop-table th, .shop-table td { padding: .6rem .4rem; }
  }
</style>
