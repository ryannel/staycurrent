<figure class="boundary-figure" data-loading>
  <figcaption><span class="figure-number">Figure 3</span><strong>Loading Mina’s two orders and four lines</strong></figcaption>
  <label class="choice">Load the lines <select data-strategy aria-label="Order loading strategy"><option value="loop">One query per order</option><option value="batch">One batched query</option><option value="join">One joined query</option></select></label>
  <div class="loading-scene">
    <div class="calls" data-live><p class="panel-label">Application → database → application</p><ol data-calls></ol></div>
    <div class="loaded" data-live><p class="panel-label">Result assembled so far</p><div data-orders></div></div>
  </div>
  <p class="counts" data-live data-counts></p>
  <p class="step-explanation" data-explanation data-live aria-live="polite"></p>
  <div class="figure-controls"><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step></span></div>
  <div class="hold" data-hold aria-hidden="true"><span></span></div>
  <details><summary>Loading, as text</summary><p>One query per order: read orders 103 and 101, then two lines for 103, then two for 101. Three queries return six rows. Batched: read the two orders, then all four lines using their order IDs. Two queries return six rows. Joined: one query returns four joined rows, with order 103 repeated twice and order 101 repeated twice. Assemble each pair into one order with two lines.</p></details>
</figure>

<script>
  import { stepper } from '../figures/stepper.mjs';
  document.querySelectorAll('[data-loading]').forEach(root => {
    const select = root.querySelector('[data-strategy]');
    const orders = [{id:103, date:'20 Oct · pending',lines:['1 · P7 × 1 · 20.00','2 · P3 × 2 · 4.50']},{id:101,date:'12 Oct · paid',lines:['1 · P3 × 1 · 4.50','2 · P9 × 1 · 35.00']}];
    const states = {
      loop:[['No query sent yet.',0,0,0],['Read the two order rows. Their lines have not been loaded.',1,2,0],['Read order 103’s two lines. Order 101 still needs another query.',2,4,1],['Read order 101’s two lines. All four lines are now attached to their orders.',3,6,2]],
      batch:[['No query sent yet.',0,0,0],['Read the same two order rows. Keep their IDs: 103 and 101.',1,2,0],['Read all four lines for IDs 103 and 101. Group them by order_id and attach them to the two orders.',2,6,2]],
      join:[['No query sent yet.',0,0,0],['One joined query returns four rows. Each order’s columns travel twice; group the rows into the same two orders.',1,4,2]]
    };
    const calls = {
      loop:['Orders for customer 1 → 2 rows','Lines for order 103 → 2 rows','Lines for order 101 → 2 rows'],
      batch:['Orders for customer 1 → 2 rows','Lines for IDs [103, 101] → 4 rows'],
      join:['Orders joined to lines → 4 rows']
    };
    const player = stepper(root,{steps:()=>states[select.value].length,draw:step=>{
      const mode=select.value; const [text,queries,rows,complete]=states[mode][step];
      root.querySelector('[data-explanation]').textContent=text;
      root.querySelector('[data-calls]').replaceChildren(...calls[mode].map((text,i)=>{const li=document.createElement('li');li.textContent=text;li.className=i<queries?'done':'';return li;}));
      root.querySelector('[data-orders]').replaceChildren(...orders.map((order,i)=>{const card=document.createElement('div');card.className='order-card';const title=document.createElement('b');title.textContent=`Order ${order.id}`;const date=document.createElement('small');date.textContent=order.date;const lines=document.createElement('p');lines.textContent=queries===0?'Not loaded':i<complete?order.lines.join('\n'):'Lines not loaded';card.append(title,date,lines);return card;}));
      root.querySelector('[data-counts]').textContent=`${queries} ${queries===1?'query':'queries'} · ${rows} returned rows · ${complete===2?4:complete*2} lines loaded`;
    }});
    select.addEventListener('change',()=>root.querySelector('[data-reset]').click());
  });
</script>

<style is:global>
  [data-loading] .loading-scene { display:grid;grid-template-columns:1.1fr 1fr;gap:1.4rem;margin:1rem 0; }
  [data-loading] .calls ol { padding-left:1.4rem;margin:.6rem 0; }
  [data-loading] .calls li { padding:.6rem;color:var(--color-text-secondary);border-left:2px dotted var(--color-rule-strong); }
  [data-loading] .calls li.done { color:var(--color-text);border-left:3px solid var(--teal);background:color-mix(in srgb,var(--teal) 8%,var(--color-surface)); }
  [data-loading] .order-card { border:1px solid var(--color-rule-strong);padding:.65rem .8rem;margin:.6rem 0;background:var(--color-surface); }
  [data-loading] .order-card small { display:block;color:var(--color-text-secondary); }
  [data-loading] .order-card p { white-space:pre-line;font:.76rem/1.8 var(--font-mono);margin:.5rem 0 0; }
  @media(max-width:600px) { [data-loading] .loading-scene { grid-template-columns:1fr;gap:.3rem; } }
</style>
