---
interface Props { kind: 'commit' | 'refresh' | 'retry'; number: number; title: string; }
const { kind, number, title } = Astro.props;
---
<figure class="crdb-walk" data-crdb-walk={kind} aria-label={title}>
  <figcaption><span>Figure {number}</span> {title}</figcaption>
  {kind === 'commit' && <label class="walk-option">After the successful reply
    <select data-option><option value="continues">Coordinator continues</option><option value="disappears">Coordinator disappears</option></select>
  </label>}
  {kind === 'refresh' && <label class="walk-option">Between the two timestamps
    <select data-option><option value="unchanged">Earlier read stays unchanged</option><option value="changed">Earlier read is invalidated</option></select>
  </label>}
  {kind === 'retry' && <p class="fixed-request">Every attempt: customer 1 · purchase · <strong>purchase-103</strong><br/>P7 × 1 at 20.00 · P3 × 2 at 4.50</p>}
  <div class="walk-scene" data-scene data-live></div>
  <p class="walk-explanation" data-explanation data-live aria-live="polite"></p>
  <div class="walk-controls" role="group" aria-label={`Playback for figure ${number}`}>
    <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step></span>
    <div data-hold aria-hidden="true"><span></span></div>
  </div>
  <p class="walk-caption"><slot /></p>
  <details><summary>Figure as text</summary><div data-alternative></div></details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  import { walks } from './walks.mjs';
  document.querySelectorAll('[data-crdb-walk]').forEach(root => {
    const kind = root.getAttribute('data-crdb-walk');
    const option = root.querySelector('select');
    const all = walks[kind];
    const entries = () => all(option?.value);
    const scene = root.querySelector('[data-scene]');
    const explanation = root.querySelector('[data-explanation]');
    const alternative = root.querySelector('[data-alternative]');
    const asText = () => {
      const options = option ? [...option.options].map(item => [item.text, item.value]) : [['The complete walk', undefined]];
      alternative.replaceChildren();
      options.forEach(([name, value]) => {
        const p = document.createElement('p'); p.textContent = name; alternative.append(p);
        const list = document.createElement('ol');
        all(value).forEach(item => { const li = document.createElement('li'); li.textContent = item.text; list.append(li); });
        alternative.append(list);
      });
    };
    const player = stepper(root, {steps: () => entries().length, draw: index => {
      const item = entries()[index];
      scene.innerHTML = item.scene;
      explanation.textContent = item.text;
    }});
    option?.addEventListener('change', () => player.render());
    asText();
  });
</script>
<style>
.crdb-walk { margin: 2rem 0; font: .9rem/1.55 var(--font-sans); }
figcaption { font: 500 1.1rem/1.4 var(--font-serif); margin-bottom: .7rem; }
figcaption span { font: .68rem var(--font-sans); text-transform: uppercase; letter-spacing: .07em; color: var(--color-text-secondary); margin-right: .5rem; }
.walk-scene { padding: 1rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface-alt); min-height: 15.5rem; }
.walk-scene :global(.walk-grid) { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .8rem; }
.walk-scene :global(.walk-box) { border: 1px solid var(--color-text-secondary); padding: .7rem; background: var(--color-surface); overflow-wrap: anywhere; }
.walk-scene :global(.walk-box strong) { display: block; margin-bottom: .35rem; }
.walk-scene :global(.walk-box p) { margin: .25rem 0; }
.walk-scene :global(.walk-wide) { grid-column: 1 / -1; }
.walk-scene :global(.walk-status) { margin: .8rem 0 0; border-left: 3px solid var(--color-accent); padding-left: .7rem; font-weight: 600; }
.walk-scene :global(.walk-arrow) { text-align: center; padding: .45rem 0; color: var(--color-text-secondary); }
.walk-explanation { margin: 0; padding: .9rem 1rem; border: 1px solid var(--color-rule-strong); border-top: 0; min-height: 6rem; }
.walk-option { display: flex; gap: .5rem 1rem; align-items: center; flex-wrap: wrap; margin-bottom: .75rem; color: var(--color-text-secondary); }
select,button { font: inherit; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-text-secondary); border-radius: .2rem; padding: .4rem .6rem; }
button { cursor: pointer; min-height: 2.6rem; }
button[aria-disabled="true"] { border-style: dashed; color: var(--color-text-secondary); }
button:focus-visible,select:focus-visible,summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
.walk-controls { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; padding: .7rem; background: var(--color-surface-alt); border: 1px solid var(--color-rule-strong); border-top: 0; }
[data-step] { margin-left: auto; font-variant-numeric: tabular-nums; }
[data-hold] { flex: 0 0 100%; height: 3px; background: var(--color-rule-strong); }
[data-hold] span { display: block; height: 3px; width: 0; background: var(--color-accent); }
.walk-caption { margin: .7rem 0; color: var(--color-text-secondary); font-size: .8rem; }
.fixed-request { padding: .6rem .8rem; border-left: 3px solid var(--color-accent); }
summary { color: var(--color-accent); cursor: pointer; }
details { font-size: .8rem; }
details div { padding-top: .6rem; }
@media(max-width:500px) { .walk-scene :global(.walk-grid) { grid-template-columns: 1fr; } .walk-scene { min-height: 0; padding: .7rem; } .walk-explanation { min-height: 0; } }
</style>
