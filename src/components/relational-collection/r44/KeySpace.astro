---
import core from '../../../lib/relational-collection/core.json';
const rows = core.orders;
const customerRows = [...rows].sort((a,b)=>a.customer_id-b.customer_id || a.order_id-b.order_id);
---
<figure class="keys" data-r44-keys aria-labelledby="r44-key-title">
 <figcaption id="r44-key-title"><span>Figure 1</span> Two orders for the same orders</figcaption>
 <div class="controls"><label>Layout <select data-layout><option value="whole">Before primary split</option><option value="split">After split at (10, 103)</option></select></label><label>Read <select data-read><option value="order">Order 103 by primary key</option><option value="customer">Mina’s orders by customer index</option></select></label></div>
 <p class="route" data-route aria-live="polite">Read (10, 103) in the primary index.</p>
 <section><p class="panel-title">Primary index · (shop, order)</p><div class="entries">
 {rows.map(row=><div class="entry" data-order={row.order_id} data-customer={row.customer_id}><code>10 / {row.order_id}</code><small>customer {row.customer_id} · {row.status}</small></div>)}
 </div><p class="range-label" data-ranges>R1 contains all three primary entries</p></section>
 <section><p class="panel-title">Secondary index · (shop, customer, order)</p><div class="entries secondary">
 {customerRows.map(row=><div class="entry" data-index-order={row.order_id} data-index-customer={row.customer_id}><code>10 / {row.customer_id} / {row.order_id}</code><small>locates primary (10, {row.order_id})</small></div>)}
 </div><p class="range-label">A separate run of keys · unchanged by this primary split</p></section>
 <p class="explanation" data-explanation aria-live="polite">The primary lookup reaches order 103 directly. It does not read the customer index.</p>
 <p class="caption">Symbolic keys, invented range labels and boundaries. Actual byte prefixes contain table and index IDs; families and versions are omitted. Highlighted entries are used by the selected read. A primary split changes ownership units, while the rows and the secondary ordering stay the same.</p>
</figure>
<script>
 const root=document.querySelector('[data-r44-keys]');
 if(root){
 const layout=root.querySelector('[data-layout]') as HTMLSelectElement;
 const read=root.querySelector('[data-read]') as HTMLSelectElement;
 const draw=()=>{
 const split=layout.value==='split', customer=read.value==='customer';
 root.querySelector('[data-route]').textContent=customer?'Scan secondary prefix (10, 1), then fetch primary orders 101 and 103.':'Read (10, 103) in the primary index.';
 root.querySelector('[data-ranges]').textContent=split?'R1: keys below (10, 103) · R2: keys from (10, 103)':'R1 contains all three primary entries';
 root.querySelectorAll<HTMLElement>('[data-order]').forEach(el=>{el.classList.toggle('used',customer?el.dataset.customer==='1':el.dataset.order==='103');el.classList.toggle('boundary',split&&el.dataset.order==='103');});
 root.querySelectorAll<HTMLElement>('[data-index-order]').forEach(el=>el.classList.toggle('used',customer&&el.dataset.indexCustomer==='1'));
 root.querySelector('[data-explanation]').textContent=customer?(split?'The secondary run finds two keys for Mina. Fetching their rows now spans R1 and R2; their relative order in the secondary index has not changed.':'The secondary run finds two keys for Mina. Both row fetches are in R1 in this layout.'):split?'Order 103 is now in R2, whose lower bound includes (10, 103). The application still supplies the same SQL key.':'The primary lookup reaches order 103 directly. It does not read the customer index.';
 };layout.addEventListener('change',draw);read.addEventListener('change',draw);draw();
 }
</script>
<style>
.keys{margin:2.5rem 0;font-family:var(--font-sans)}figcaption{font:1.25rem/1.4 var(--font-serif);margin-bottom:.9rem}figcaption>span{font:.75rem var(--font-sans);text-transform:uppercase;color:var(--color-text-secondary);margin-right:.5rem}.controls{display:flex;gap:.8rem;flex-wrap:wrap;padding:.8rem;background:var(--color-surface)}label{display:grid;gap:.35rem;font-size:.85rem;flex:1}select{font:inherit;color:var(--color-text);background:var(--color-surface-alt);border:1px solid var(--color-text-secondary);padding:.55rem;max-width:100%}section{border:1px solid var(--color-text-secondary);padding:1rem;margin-top:.7rem}.panel-title{font:600 .9rem/1.4 var(--font-sans);margin:0 0 .8rem}.entries{display:flex;gap:.4rem}.entry{border:1px solid var(--color-text-secondary);padding:.7rem;flex:1;min-width:0}.entry code{font-size:.85rem}.entry small{display:block;margin-top:.5rem;font-size:.75rem;line-height:1.45}.entry.used{border:2px solid var(--color-accent);background:var(--color-surface)}.entry.boundary{border-left:5px double var(--color-accent)}.route,.range-label{font:.85rem/1.5 var(--font-sans)}.range-label{margin:.7rem 0 0}.explanation{border-left:3px solid var(--color-accent);padding:.6rem .8rem;font:.9rem/1.55 var(--font-sans)}.caption{font:.8rem/1.5 var(--font-sans);color:var(--color-text-secondary)}@media(max-width:550px){.entries{flex-direction:column}.entry.boundary{border-left:1px solid var(--color-text-secondary);border-top:5px double var(--color-accent)}.controls{flex-direction:column}}
</style>
