.progress{margin:2rem 0}.progress figcaption{font-size:1.12rem;margin-bottom:.7rem}.progress figcaption span{font:.75rem var(--font-mono);text-transform:uppercase;margin-right:.6rem}.key{font-size:.85rem}.rows{background:var(--color-surface);border:1px solid var(--color-rule);padding:1rem;display:grid;gap:1rem}.rows>div{display:grid;grid-template-columns:11rem 1fr;gap:.75rem;align-items:center}.rows b{font-size:.85rem}.rail{display:flex;gap:.4rem}.rail :global(span){border:1px solid var(--color-text-secondary);padding:.4rem .7rem;font: .9rem var(--font-mono)}.rail :global(span.reached){background:var(--color-surface-alt);border:2px solid var(--color-accent);font-weight:700}.answer{display:flex;gap:1rem;justify-content:space-between;padding:.8rem;border:1px solid var(--color-rule)}.answer b{font-size:.85rem}.answer p{margin:0;font-size:.9rem}.progress>[data-explanation]{min-height:6rem;border-left:3px solid var(--color-accent);padding:.5rem .8rem}.controls{display:flex;gap:.5rem;flex-wrap:wrap;border:1px solid var(--color-rule);padding:.8rem;background:var(--color-surface)}.controls button{font:inherit;background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-text-secondary);padding:.4rem .7rem;cursor:pointer}.controls button:focus-visible{outline:3px solid var(--color-accent);outline-offset:2px}.controls [aria-disabled=true]{opacity:.55}[data-step]{margin-left:auto;align-self:center;font:.8rem var(--font-mono)}[data-hold]{height:3px;flex-basis:100%;background:var(--color-rule)}[data-hold] span{display:block;height:100%;width:0;background:var(--color-accent)}.caption{font-size:.85rem;color:var(--color-text-secondary)}details{margin:.8rem 0}summary{cursor:pointer}@media(max-width:500px){.rows{padding:.7rem}.rows>div{grid-template-columns:1fr;gap:.4rem}.answer{display:block}.answer p{margin-top:.5rem}.progress>[data-explanation]{min-height:8rem}}
</style>
<script>
import {stepper} from '../../figures/stepper.mjs';
document.querySelectorAll('[data-r20-progress]').forEach(root=>{
 const labels=['Primary durable log','Replica received','Replica durable log','Replica replayed'];
 const selectors=['[data-primary]','[data-received]','[data-durable]','[data-replayed]'];
 const messages=["Both copies start before Mina's purchase. The replica can answer queries from its earlier consistent state.",'The primary has durably committed through position 2. With asynchronous replication, success need not wait for this replica at all.','The replica has received the commit bytes. Receipt alone does not establish durable storage or visibility to queries.','The replica has flushed through the commit. Its replay is still behind, so a fresh query still cannot find order 103.','Replay has applied the committed purchase. A new snapshot now finds 103 and both stock changes; an old retained snapshot can still show the earlier state.'];
 stepper(root,{steps:()=>5,draw(s:number){selectors.forEach((sel,i)=>{const el=root.querySelector(sel) as HTMLElement;const end=s>i?2:0;el.replaceChildren(...[0,1,2].map(n=>{const span=document.createElement('span');span.textContent=n<=end?`${n} ✓`:`${n} —`;span.classList.toggle('reached',n<=end);return span;}));el.setAttribute('aria-label',`${labels[i]} through position ${end}`);});(root.querySelector('[data-answer]') as HTMLElement).textContent=s===4?'Order 103 present':'No order 103';(root.querySelector('[data-explanation]') as HTMLElement).textContent=messages[s];}});
});
</script>
