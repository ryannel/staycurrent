---
import core from '../../../lib/relational-collection/core.json';
const lines=core.order_items.filter(x=>x.order_id===101);
const payments=core.payments.filter(x=>x.order_id===101);
const total=core.report_totals.find(x=>x.order_id===101);
const amount=(x)=>((Number(x.unit_price)*100*x.quantity)/100).toFixed(2);
---
<figure class="join-figure" data-multiplication aria-labelledby="r05-multiply-title">
  <figcaption id="r05-multiply-title"><span>Figure 1</span> Two lines meet two payments</figcaption>
  <div class="inputs">
    <div><p class="panel-label"><strong>Order 101’s lines</strong></p>{lines.map(x=><p><strong>Line {x.line_no}</strong><br />{x.product_id} · {amount(x)}</p>)}</div>
    <div><p class="panel-label"><strong>Order 101’s payments</strong></p>{payments.map(x=><p><strong>Payment {x.payment_id}</strong><br />{x.method} · {x.amount}</p>)}</div>
  </div>
  <div class="choice" role="group" aria-label="Rows to combine">
    <button type="button" data-choice="pairs" aria-pressed="true">Join the details</button>
    <button type="button" data-choice="totals" aria-pressed="false">Total each side first</button>
  </div>
  <div data-pairs>
    <p class="meaning"><strong>One result row = one line–payment pair.</strong></p>
    <table><caption>Order 101 · four matching pairs</caption><thead><tr><th scope="col">Line</th><th scope="col">Line amount</th><th scope="col">Payment</th><th scope="col">Payment amount</th></tr></thead><tbody>{lines.flatMap(i=>payments.map(p=><tr><td>{i.line_no}</td><td>{amount(i)}</td><td>{p.payment_id}</td><td>{p.amount}</td></tr>))}</tbody></table>
    <p class="result">4 pairs → line sum <strong>79.00</strong>; payment sum <strong>79.00</strong></p>
  </div>
  <div data-totals hidden>
    <p class="meaning"><strong>One result row = one order.</strong></p>
    <table><caption>One matching pair of totals</caption><thead><tr><th scope="col">Order</th><th scope="col">Line total</th><th scope="col">Payment total</th></tr></thead><tbody><tr><th scope="row">101</th><td>{total.total}</td><td>{total.paid}</td></tr></tbody></table>
    <p class="result">1 pair of totals → still due <strong>{total.due}</strong></p>
  </div>
  <p class="explanation" data-explanation aria-live="polite">Every line matches both payments on order_id. Read down either amount: each original contribution appears twice.</p>
  <details><summary>The matches as text</summary><p>Line 1, amount 4.50, matches payments 501 (30.00) and 502 (9.50). Line 2, amount 35.00, matches those same two payments. Totalling each side separately gives 39.50 and 39.50, then one joined row. This is a model of the result’s meaning, not an execution plan.</p></details>
</figure>
<script>
  document.querySelectorAll('[data-multiplication]').forEach(root=>{
    root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button=>button.addEventListener('click',()=>{
      const totals=button.dataset.choice==='totals';
      root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
      (root.querySelector('[data-pairs]') as HTMLElement).hidden=totals;
      (root.querySelector('[data-totals]') as HTMLElement).hidden=!totals;
      root.querySelector('[data-explanation]')!.textContent=totals?'Two line amounts become one line total; two payments become one payment total. Joining on order_id now pairs one row with one row.':'Every line matches both payments on order_id. Read down either amount: each original contribution appears twice.';
    }));
  });
</script>
<style>
.join-figure{margin:2.5rem 0;font-family:var(--font-sans);font-size:.92rem;border:1px solid var(--color-rule-strong);padding:1rem;background:var(--color-surface-alt)}
figcaption{font-size:1.08rem;margin-bottom:1rem}figcaption span{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;margin-right:.6rem;color:var(--color-text-secondary)}
.panel-label{font-size:.92rem;margin:0 0 .65rem}.inputs{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-bottom:1rem}.inputs>div{border:1px solid var(--color-rule-strong);padding:.75rem}.inputs p{margin:.6rem 0 0;padding-left:.6rem;border-left:3px solid var(--color-accent)}
.choice{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0}.choice button{font:inherit;color:var(--color-text);background:var(--color-surface-alt);border:1px solid var(--color-rule-strong);border-radius:.25rem;padding:.6rem .7rem;cursor:pointer}.choice button[aria-pressed="true"]{background:var(--color-accent);color:var(--color-surface);border-color:var(--color-accent)}.choice button:focus-visible{outline:3px solid var(--color-accent);outline-offset:3px}
table{display:table;width:100%;table-layout:fixed;border-collapse:collapse;margin:.8rem 0}th,td{padding:.55rem .35rem;text-align:left;border-bottom:1px solid var(--color-rule-strong)}th{font-size:.8rem;overflow-wrap:normal}td{font-variant-numeric:tabular-nums}caption{text-align:left;font-size:.8rem;color:var(--color-text-secondary)}.result{padding:.7rem;border-block:1px solid var(--color-rule-strong)}.meaning{margin:.7rem 0}.explanation{min-height:4.5em;border-left:3px solid var(--color-accent);padding-left:.7rem}.join-figure details{font-size:.85rem}.join-figure [hidden]{display:none}
@media(max-width:430px){.join-figure{padding:.7rem}.inputs{gap:.4rem}.inputs>div{padding:.4rem}.inputs p{padding-left:.35rem}.explanation{min-height:6em}}
</style>
