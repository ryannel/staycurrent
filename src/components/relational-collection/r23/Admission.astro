--color-surface-alt)}[data-hold] span{display:block;height:100%;background:var(--color-accent);width:0}.caption{margin:.7rem 0}.admission details{font:.9rem/1.5 var(--font-sans)}@media(max-width:550px){.lanes{grid-template-columns:1fr}.lanes section{padding:.65rem}.explanation{min-height:0}.controls label{width:100%}}
</style>
