---
import core from '../../../lib/relational-collection/core.json';
const tea=core.products.find(p=>p.product_id==='P3');
const mug=core.products.find(p=>p.product_id==='P7');
---
<figure class="migration-transfer" aria-labelledby="transfer-title" data-tea-before={tea.stock_before_103} data-tea-after={tea.stock_after_103} data-mug-before={mug.stock_before_103} data-mug-after={mug.stock_after_103}>
<figcaption id="transfer-title">Figure 1 · Move the authority with its accepted history</figcaption>
<div class="paper-surface transfer-board"><div class="copies">{['PostgreSQL','CockroachDB'].map((name,i)=><div class="copy"><strong>{name}</strong><p class="authority" data-live data-authority={i}></p><dl><dt>Order 103</dt><dd data-live data-order={i}></dd><dt>Request outcome</dt><dd data-live data-request={i}></dd><dt>P7 · P3 stock</dt><dd data-live data-stock={i}></dd></dl></div>)}</div><p class="action" data-live data-action></p><p data-live data-explanation aria-live="polite"></p></div>
<div class="transport" role="group" aria-label="Migration illustration controls"><button data-play>Play</button><button data-back>Back</button><button data-next>Next</button><button data-reset>Reset</button><span data-step></span></div><div data-hold aria-hidden="true"><span></span></div>
<details><summary>Migration and return as text</summary><ol><li>PostgreSQL alone serves writes, before order 103. CockroachDB has no copied business rows.</li><li>Fence PostgreSQL and settle admissions; copy and compare the closed history. Both copies have P7 stock 1, P3 stock 12 and no order 103.</li><li>Open CockroachDB only. Mina's request creates order 103 there, with request outcome 103, P7 stock 0 and P3 stock 10. PostgreSQL remains fenced at the earlier state.</li><li>Before a return, fence CockroachDB and enumerate its closed accepted history. Both write gates are closed.</li><li>Reconcile Mina's complete operation on still-fenced PostgreSQL. Repeating its request preserves one order, P7 stock 0 and P3 stock 10. Compare both complete states.</li><li>Open PostgreSQL only after acceptance. CockroachDB remains fenced; the same request still resolves to 103 on PostgreSQL.</li></ol></details>
<p class="caption">Conceptual authority sequence using the fixture's accepted results. A fence means the declared write protocol refuses new admissions; it does not mean a browser illustration can stop a real database. No provider or message effect is generated.</p>
</figure>
<script>
import {stepper} from '../../figures/stepper.mjs';
const root=document.querySelector('.migration-transfer');
if(root){const before=`${root.dataset.mugBefore} · ${root.dataset.teaBefore}`,after=`${root.dataset.mugAfter} · ${root.dataset.teaAfter}`;const states=[
[['Serving writes','Closed; empty'],['Absent','Not copied'],['Absent','Not copied'],[before,'—'],'PostgreSQL owns the current history','The migration rehearsal starts before Mina’s purchase. Only PostgreSQL may accept application writes.'],
[['Fenced','Closed; validated copy'],['Absent','Absent'],['Absent','Absent'],[before,before],'Fence → copy → compare','Resolve in-flight work before the final copy. Both gates stay closed while all intended rows and application meanings are checked.'],
[['Fenced','Serving writes'],['Absent','Present'],['Absent','103'],[before,after],'CockroachDB accepts purchase-mina-103','Its order, both stock deductions and request outcome commit together. The old PostgreSQL copy is now missing accepted work.'],
[['Fenced','Fenced'],['Absent','Present'],['Absent','103'],[before,after],'Close the new history before planning the return','The racing admission is refused. Enumerate accepted operations only after the CockroachDB fence has settled.'],
[['Fenced; reconciled','Fenced'],['Present','Present'],['103','103'],[after,after],'Apply the complete operation → repeat safely → compare','Controlled reconciliation uses the same identity and payload. Repetition does not create a second order or deduct stock again.'],
[['Serving writes','Fenced'],['Present','Present'],['103','103'],[after,after],'PostgreSQL owns the accepted history again','Open the returned authority only after complete-state and application acceptance. Keep CockroachDB fenced.']];stepper(root,{steps:()=>states.length,draw:i=>{const s=states[i];['authority','order','request','stock'].forEach((field,k)=>root.querySelectorAll(`[data-${field}]`).forEach((e,j)=>e.textContent=s[k][j]));root.querySelector('[data-action]').textContent=s[4];root.querySelector('[data-explanation]').textContent=s[5];}});}
</script>
<style>
.migration-transfer{margin:2.5rem 0}.migration-transfer figcaption{font-size:1.15rem;margin-bottom:.7rem}.transfer-board{padding:1rem}.copies{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.copy{border:1px solid var(--color-text);padding:.7rem;min-width:0}.copy strong{font-size:1.05rem}.authority{border-left:3px solid var(--teal);padding-left:.5rem;min-height:3em}.copy dl{display:grid;grid-template-columns:1.25fr 1fr;gap:.4rem;font-size:.9rem}.copy dt,.copy dd{margin:0}.copy dd{font-weight:600}.action{border-top:2px solid var(--teal);padding-top:.8rem;font-weight:600}.transport{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin:.8rem 0}.transport button{font:inherit;color:var(--color-text);background:transparent;border:1px solid currentColor;border-radius:.25rem;padding:.5rem .75rem;cursor:pointer}.transport button:focus-visible{outline:3px solid var(--teal);outline-offset:2px}.transport [aria-disabled="true"]{opacity:.55}[data-hold]{height:3px}[data-hold] span{height:100%;display:block;width:0;background:var(--teal)}.caption{font-size:.9rem}.migration-transfer details{margin:.8rem 0}@media(max-width:500px){.copies{grid-template-columns:1fr}.authority{min-height:0}.copy dl{grid-template-columns:1.2fr 1fr}}
</style>
