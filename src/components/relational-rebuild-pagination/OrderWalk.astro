---
import { startingRows, mutations } from './data.mjs';
interface Props { mode:'offset'|'keyset'; number:number; }
const {mode,number} = Astro.props;
const id=`${mode}-walk`;
const keys=mode==='offset'?['insert','delete']:['delete','insert','forward','backward'];
---
<figure class="pgn-figure pgn-walk" id={id} data-mode={mode} aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`}><span class="pgn-number">Figure {number}</span>{mode==='offset'?'A numbered boundary moves':'The key stays fixed; the rows can move'}</figcaption>
  <div class="pgn-scene">
    <div class="pgn-options"><label for={`${id}-change`}>Between requests</label><select id={`${id}-change`} data-mutation>{keys.map(k=><option value={k}>{mutations[k].label}</option>)}</select></div>
    <p class="pgn-key">{mode==='offset'?'Next request: OFFSET 2 LIMIT 2':'Saved key: (20 Oct 10:15 UTC, 201)'}</p>
    <div class="pgn-columns">
      <div><p class="pgn-panel-label">First read · 202, 201 returned</p><div>{startingRows.map((r,i)=><div class="pgn-row" data-mark={i<2?'take':''}><span class="pgn-rank">{i+1}</span><span><strong>{r.id}</strong><small>{r.short} UTC</small></span><span class="pgn-tag">{i<2?'page 1':''}</span></div>)}</div></div>
      <div><p class="pgn-panel-label" data-phase data-live>Before the change</p><div data-rows data-live>{startingRows.map((r,i)=><div class="pgn-row"><span class="pgn-rank">{i+1}</span><span><strong>{r.id}</strong><small>{r.short} UTC</small></span></div>)}</div></div>
    </div>
    <div class="pgn-result"><span>Next page returns</span><strong data-result data-live>Not requested yet</strong></div>
    <p class="pgn-explanation" data-explanation data-live aria-live="polite">The first read returned 202 and 201. Keep that page while the list changes.</p>
  </div>
  <div class="pgn-controls" role="group" aria-label={`Figure ${number} controls`}><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span class="pgn-counter" data-step>1 / 3</span><div class="pgn-hold" data-hold aria-hidden="true"><span></span></div></div>
  <p class="pgn-caption">Each option starts again from the same five rows. The drawings show query results at successive reads, with all times in UTC; they do not animate the engine’s execution.</p>
  <details><summary>All outcomes, as text</summary>{keys.map(k=><p><strong>{mutations[k].label}.</strong> {mutations[k][mode]}</p>)}</details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  import { startingRows, mutations, isAfter, nextIds } from './data.mjs';
  document.querySelectorAll('.pgn-walk').forEach(root=>{
    const mode=root.getAttribute('data-mode');
    const select=root.querySelector('select');
    const draw=step=>{
      const scenario=mutations[select.value];
      const rows=step===0?startingRows:scenario.rows;
      const ids=nextIds(rows,mode);
      root.querySelector('[data-phase]').textContent=step===0?'Before the change':step===1?'The changed list':'Next request · fresh read';
      root.querySelector('[data-rows]').innerHTML=rows.map((r,i)=>{
        const take=step===2&&ids.includes(r.id);
        const skip=step===2&&(mode==='offset'?i<2:!isAfter(r));
        const label=take?'return':skip?(mode==='offset'?'skip':'before key'):'';
        const cut=mode==='keyset'&&step===2&&isAfter(r)&&(i===0||!isAfter(rows[i-1]));
        return `${cut?'<div class="pgn-boundary">↓ after the saved key</div>':''}<div class="pgn-row" data-mark="${take?'take':skip?'skip':''}"><span class="pgn-rank">${i+1}</span><span><strong>${r.id}</strong><small>${r.short} UTC</small></span><span class="pgn-tag">${label}</span></div>`;
      }).join('');
      root.querySelector('[data-result]').textContent=step===2?ids.join(', '):'Not requested yet';
      root.querySelector('[data-explanation]').textContent=step===0?'The first read returned 202 and 201. Keep that page while the list changes.':step===1?scenario.change:scenario[mode];
    };
    const player=stepper(root,{steps:()=>3,draw});
    select.addEventListener('change',()=>player.render());
  });
</script>
