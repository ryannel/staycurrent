---
import { render } from 'astro:content';
import { getProvenance } from '../lib/content';

interface Props {
  slug: string;
  version: number;
}
const { slug, version } = Astro.props;
const entry = await getProvenance(slug, version);
const rendered = entry ? await render(entry) : null;
---
{rendered && (
  <section class="provenance" aria-labelledby="provenance-heading">
    <p class="section-label" id="provenance-heading">Provenance for v{version}</p>
    <rendered.Content />
  </section>
)}
