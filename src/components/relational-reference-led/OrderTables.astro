---
import ResultTable from '../explainers/querying/ResultTable.astro';
interface Props { part: 'customers' | 'items'; }
const { part } = Astro.props;
const first = part === 'customers';
const number = first ? 1 : 2;
const title = first ? 'Who placed each order' : 'What order 103 contains';
// Let narrow headers wrap at the word boundary, preserving the column name.
const breakColumn = (name: string) => name.replaceAll('_', '_\u200b');
---

<figure class="shop-tables" aria-labelledby={`shop-figure-${number}`}>
  <div class="shop-title"><span>Figure {number}</span><p id={`shop-figure-${number}`}>{title}</p></div>
  <div class="shop-board">
    {first ? <>
      <ResultTable caption="customers · one row per customer" columns={['customer_id', 'name']} rows={[[1, 'Mina Shah'], [2, 'Tariq Aziz'], [3, 'Edda Berg']]} />
      <ResultTable caption="orders · one row per order" columns={['order_id', 'customer_id', 'status']} rows={[[101, 1, 'paid'], [102, 2, 'paid'], [103, 1, 'pending']]} />
    </> : <>
      <ResultTable caption="order_items · one row per order line" columns={['order_id', 'line_no', 'product_id', 'quantity', 'unit_price'].map(breakColumn)} rows={[[103, 1, 'P7', 1, '20.00'], [103, 2, 'P3', 2, '4.50']]} />
      <ResultTable caption="products · one row per product" columns={['product_id', 'name', 'price']} rows={[[ 'P7', 'Blue mug', '20.00'], ['P3', 'Green tea, 50 g', '4.50']]} />
    </>}
  </div>
  <figcaption>{first
    ? 'Match an order’s customer_id to customer_id in customers. Orders 101 and 103 both refer to Mina’s row. Only the columns needed here are shown.'
    : 'Two lines of one order, followed by the products they refer to. Other orders, products and columns are left out. The price on an order line is per unit, so two teas at 4.50 cost 9.00.'}</figcaption>
</figure>

<style>
  .shop-tables { margin: 1.6rem 0 1.8rem; }
  .shop-title { display: flex; align-items: baseline; gap: .75rem; padding-bottom: .6rem; }
  .shop-title > span { flex-shrink: 0; font: .68rem/1.4 var(--font-sans); letter-spacing: .11em; text-transform: uppercase; color: var(--color-text-secondary); }
  .shop-title > p { margin: 0; font: 1.1rem/1.4 var(--font-serif); }
  .shop-board { padding: 1.1rem 1.1rem .2rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface-alt); }
  .shop-board :global(caption) { text-align: left; padding-bottom: .5rem; font: 500 .82rem/1.5 var(--font-sans); color: var(--color-text); }
  .shop-board :global(table) { display: table; width: 100%; margin: 0 0 1.15rem; font: .81rem/1.55 var(--font-sans); }
  .shop-board :global(th), .shop-board :global(td) { padding: .45rem .55rem; }
  .shop-board :global(th) { font: 500 .75rem/1.5 var(--font-mono); }
  .shop-board :global(td:first-child) { font-family: var(--font-mono); }
  .shop-board :global(.table-scroll) { overflow-x: auto; }
  figcaption { margin: .65rem 0 0; color: var(--color-text-secondary); font: .8rem/1.65 var(--font-sans); }
  @media (max-width: 600px) {
    .shop-board { padding: .85rem .6rem .1rem; }
    .shop-board :global(table) { font-size: .75rem; }
    .shop-board :global(th) { font-size: .69rem; overflow-wrap: normal; }
    .shop-board :global(th), .shop-board :global(td) { padding: .4rem .3rem; }
  }
</style>
