---
import { models } from './model.mjs';
interface Props { kind: 'progress' | 'routing' | 'switching'; }
const { kind } = Astro.props;
const model = models[kind];
const initial = Object.values(model.states)[0][kind === "switching" ? 2 : 0];
const id = `replicas-${kind}`;
---
<figure class="replica-figure" data-replica-figure data-kind={kind} aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`}><span>Figure {model.number}</span> {model.title}</figcaption>
  <div class="figure-body">
    {model.options.length > 0 && <label class="option">{model.label}<select data-mode aria-label={`${model.label} for figure ${model.number}`}>{model.options.map(([value,label]) => <option value={value}>{label}</option>)}</select></label>}
    {kind === 'progress' && <div class="progress-drawing">
      <div class="primary-card"><span class="label">Primary · history H</span><strong data-live data-primary>{initial.primary}</strong><span>P7 in a new snapshot</span><p data-live data-primary-history>Earlier committed history</p></div>
      <div class="copy-arrow" aria-hidden="true">↓ copy history</div>
      <div class="replica-card"><p class="label">Replica A · three progress points</p>
        {['received', 'durable', 'replayed'].map((stage, i) => <div class="history-row"><span class="stage-name">{['Received','Durable','Replayed'][i]}<small data-stage-status={stage} data-live>Before U</small></span><div class="history-track" data-stage={stage}><span class="earlier">Earlier</span><span data-record="1">U <small>P7 → 22.00</small></span><span data-record="2">C <small>commit</small></span></div></div>)}
      </div>
      <div class="read-result"><span class="label">New snapshot on A</span><strong data-live data-price>{initial.price}</strong><span>P7 catalogue price</span></div>
    </div>}
    {kind === 'routing' && <div class="routing-drawing">
      <div class="requirement"><span class="label">Required history</span><strong>H : C</strong><span>Include the acknowledged write</span></div>
      <div class="targets"><div class="target"><span class="label">Replica A</span><strong data-live data-a>{initial.a}</strong></div><div class="target"><span class="label">Primary</span><strong data-live data-primary-state>{initial.primary}</strong></div></div>
      <div class="read-action"><span class="label" data-live data-action>{initial.action}</span><span data-live data-target>{initial.target}</span><strong data-live data-result>{initial.result}</strong></div>
    </div>}
    {kind === 'switching' && <div class="switch-drawing">
      <p class="route-reader">One reader · two successive requests</p>
      <div class="read-history">
        <div class="read-route"><span class="read-number">1</span><span class="request">First read</span><span class="route-arrow" aria-hidden="true">→</span><div class="route-copy"><span>Replica A · includes C</span><strong>22.00</strong></div></div>
        <div class="read-route" data-second-route><span class="read-number">2</span><span class="request">Next read</span><span class="route-arrow" data-route-arrow aria-hidden="true">→</span><div class="route-copy"><span>Replica B · before C</span><strong data-route-price>20.00</strong><span class="route-refusal" data-route-refusal hidden>Cannot answer yet</span></div></div>
      </div>
      <div class="session"><strong data-live data-session>{initial.session}</strong><span data-live data-eligibility>{initial.eligibility}</span></div>
    </div>}
    <div class="explanation" data-explanation aria-live="polite">{kind !== "switching" && <strong data-live data-headline>{initial.headline || initial.action || 'The same two copies'}</strong>}<p data-live data-explanation-text>{initial.explanation}</p></div>
  </div>
  {kind !== "switching" && <div class="controls" role="group" aria-label={`Controls for figure ${model.number}`}>
    <button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / {Object.values(model.states)[0].length}</span>
    <div class="hold" data-hold aria-hidden="true"><span></span></div>
  </div>}
  <p class="caption">{model.caption}</p>
  <details><summary>Figure as text</summary>{Object.entries(model.states).map(([key,states]) => <div>{model.options.length > 0 && <p class="alternative-title">{model.options.find(([value]) => value === key)?.[1]}</p>}<ol>{states.map(state => <li>{state.explanation}</li>)}</ol></div>)}</details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  import { models } from './model.mjs';
  document.querySelectorAll<HTMLElement>('[data-replica-figure]').forEach(root => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const kind = root.dataset.kind as keyof typeof models;
    const model = models[kind];
    const mode = root.querySelector<HTMLSelectElement>('[data-mode]');
    const states = () => model.states[mode?.value || 'default'];
    const put = (name: string, value: string) => { const el = root.querySelector(`[data-${name}]`); if(el) el.textContent = value; };
    const draw = (index: number) => {
      const state = states()[index];
      Object.entries(state).forEach(([key,value]) => {
        if (key === 'explanation') put('explanation-text', value as string);
        else if (key === 'primary' && kind === 'routing') put('primary-state', value as string);
        else put(key.replace(/[A-Z]/g, c => `-${c.toLowerCase()}`), value as string);
      });
      put('headline', state.headline || state.action || (index === 0 ? 'Before the first read' : `Read ${index} of 2`));
      if (kind === 'progress') {
        put('primary-history', index ? 'Durable history: earlier → U → C' : 'Earlier committed history');
        root.querySelectorAll<HTMLElement>('[data-stage]').forEach(track => {
          const level = state[track.dataset.stage!];
          track.querySelectorAll<HTMLElement>('[data-record]').forEach(record => { record.dataset.included = String(Number(record.dataset.record) <= level); });
          root.querySelector(`[data-stage-status="${track.dataset.stage}"]`)!.textContent = level === 2 ? 'Through C' : level === 1 ? 'Through U' : 'Before U';
          track.setAttribute('aria-label', `${track.dataset.stage}: ${level === 2 ? 'through C' : level === 1 ? 'through U, before C' : 'earlier history, before U'}`);
        });
      }
      if (kind === 'switching') {
        const retained = mode?.value === 'retain';
        root.querySelector('[data-second-route]')!.setAttribute('data-blocked',String(retained));
        put('route-arrow',retained ? '×' : '→');
        put('route-price', retained ? '20.00 · excluded' : '20.00');
        root.querySelector<HTMLElement>('[data-route-refusal]')!.hidden = !retained;
      }
    };
    if (kind === 'switching') {
      draw(2); mode?.addEventListener('change',()=>draw(2));
    } else {
      const player=stepper(root,{steps:()=>states().length,draw});
      mode?.addEventListener('change',()=>player.render());
    }
  });
</script>
<style>
  .route-reader { margin:0 0 .7rem; font: .82rem/1.5 var(--font-sans); }
  .read-history { position:relative; display:grid; gap:1rem; margin:.5rem 0 1rem; }
  .read-history::before { content:""; position:absolute; left:.85rem; top:2rem; bottom:2rem; border-left:1px solid var(--color-text-secondary); }
  .read-route { display:grid; grid-template-columns:1.7rem 5rem 2rem minmax(0,1fr); align-items:center; gap:.6rem; }
  .read-number { z-index:1; border:1px solid var(--color-text-secondary); border-radius:50%; width:1.7rem; height:1.7rem; display:grid; place-items:center; background:var(--color-surface); font-size:.75rem; }
  .request { font-size:.8rem; }
  .route-arrow { text-align:center; font-size:1.7rem; color:var(--color-text); }
  .route-copy { padding:.6rem .8rem; border-left:3px solid var(--teal); background:var(--color-surface); }
  .route-copy span { display:block; font-size:.76rem; }
  .route-copy strong { display:block; margin-top:.2rem; font:1.3rem/1.3 var(--font-serif); }
  [data-blocked="true"] .route-copy { border-left-color:var(--color-text-secondary); border-left-style:dashed; }
  [data-blocked="true"] .route-copy strong { font-size:1rem; color:var(--color-text-secondary); }
  .route-copy .route-refusal { margin-top:.3rem; font-weight:600; }
  .route-copy [hidden] { display:none; }
  .switch-drawing + .explanation { min-height:0; }
  @media(max-width:500px) { .read-route { grid-template-columns:1.7rem 3.4rem 1rem minmax(0,1fr); gap:.35rem; }.route-copy{padding:.5rem;}.route-copy strong{font-size:1.15rem;} }
  .replica-figure { margin:2.4rem -2rem; font: .87rem/1.55 var(--font-sans); color:var(--color-text); }
  figcaption { margin:0 0 .65rem; font:1.1rem/1.45 var(--font-serif); }
  figcaption > span { display:inline-block; margin-right:.65rem; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:.1em; font:.65rem/1.5 var(--font-sans); }
  .figure-body { padding:1.1rem; background:var(--color-surface-alt); border:1px solid var(--color-rule-strong); }
  .label { display:block; color:var(--color-text-secondary); font:.72rem/1.5 var(--font-sans); letter-spacing:.035em; }
  .primary-card { display:grid; grid-template-columns:1fr auto; align-items:center; padding:.8rem 1rem; border:1px solid var(--color-rule-strong); background:var(--color-surface); }
  .primary-card > strong { grid-column:2; grid-row:1 / 3; font:1.7rem/1.1 var(--font-serif); }
  .primary-card p { grid-column:1/-1; margin:.5rem 0 0; font:.78rem/1.5 var(--font-mono); }
  .copy-arrow { text-align:center; padding:.45rem; color:var(--color-text-secondary); }
  .replica-card { border:1px solid var(--color-rule-strong); padding:.9rem; }
  .replica-card > p { margin:0 0 .7rem; }
  .history-row { display:grid; grid-template-columns:6rem 1fr; align-items:center; margin:.45rem 0; gap:.5rem; }
  .stage-name { font-size:.8rem; }
  .stage-name small { display:block; color:var(--color-text-secondary); font-size:.65rem; }
  .history-track { display:grid; grid-template-columns:.8fr 1.35fr 1fr; gap:.3rem; }
  .history-track > span { border:1px dashed var(--color-text-secondary); padding:.4rem .5rem; text-align:center; color:var(--color-text-secondary); }
  .history-track .earlier,.history-track > [data-included="true"] { border:1px solid var(--color-text-secondary); background:var(--color-surface); color:var(--color-text); }
  .history-track > [data-included="true"] { box-shadow:inset 0 -.2rem var(--teal); }
  .history-track small { display:block; font-size:.65rem; }
  .read-result { display:grid; grid-template-columns:1fr auto; margin-top:.8rem; padding:.75rem 1rem; border-left:3px solid var(--teal); background:var(--color-surface); }
  .read-result strong { grid-column:2; grid-row:1 / 3; font:1.7rem/1.2 var(--font-serif); }
  .read-result > span:last-child { font-size:.78rem; }
  .option { display:flex; flex-wrap:wrap; gap:.6rem; align-items:center; margin-bottom:1rem; font-size:.78rem; }
  select { min-width:0; max-width:100%; padding:.45rem .6rem; border:1px solid var(--color-text-secondary); color:var(--color-text); background:var(--color-surface); border-radius:3px; font:inherit; }
  .requirement,.session { padding:.8rem 1rem; border:1px solid var(--color-text-secondary); background:var(--color-surface); }
  .requirement { display:grid; grid-template-columns:1fr auto; }
  .requirement strong { grid-column:2; grid-row:1 / 3; align-self:center; font:1.1rem/1.4 var(--font-mono); }
  .targets { display:grid; grid-template-columns:1fr 1fr; gap:.75rem; margin:.8rem 0; }
  .target { display:flex; flex-direction:column; gap:.6rem; padding:1rem; border:1px solid var(--color-rule-strong); background:var(--color-surface); min-width:0; }
  .target strong { font-weight:500; font-size:1rem; }
  .switch-drawing .target strong { font:1.8rem/1.1 var(--font-serif); }
  .read-action { display:flex; flex-direction:column; gap:.55rem; min-height:7rem; padding:.8rem 1rem; border-left:3px solid var(--teal); background:var(--color-surface); }
  .read-action strong { font:1.25rem/1.5 var(--font-serif); }
  .session strong,.session > span:last-child { display:block; margin-top:.5rem; }
  .explanation { border-left:3px solid var(--teal); padding-left:.8rem; margin-top:1rem; min-height:7.8rem; }
  .explanation > strong { font-weight:500; }
  .explanation p { margin:.4rem 0 0; font:inherit; }
  .controls { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; padding:.7rem; border:1px solid var(--color-rule-strong); border-top:0; position:relative; }
  button { background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-text-secondary); border-radius:3px; padding:.45rem .7rem; font:.78rem/1.5 var(--font-sans); cursor:pointer; }
  button[aria-disabled="true"] { color:var(--color-text-secondary); border-color:var(--color-rule-strong); }
  button:focus-visible,select:focus-visible,summary:focus-visible { outline:2px solid var(--teal); outline-offset:3px; }
  [data-step] { margin-left:auto; color:var(--color-text-secondary); font:.7rem/1.5 var(--font-mono); }
  .hold { height:2px; position:absolute; bottom:0; left:0; right:0; }
  .hold span { display:block; height:100%; width:0; background:var(--teal); }
  .caption { color:var(--color-text-secondary); margin:.65rem 0; font:.78rem/1.65 var(--font-sans); }
  details { font:.8rem/1.65 var(--font-sans); }
  summary { cursor:pointer; color:var(--color-text-secondary); }
  .alternative-title { margin:.7rem 0 0; font-weight:600; }
  details ol { padding-left:1.4rem; }
  details li { margin:.5rem 0; }
  @media(max-width:750px) { .replica-figure { margin:2rem 0; } }
  @media(max-width:500px) { .figure-body { padding:.7rem; } .history-row { grid-template-columns:1fr; gap:.2rem; margin:.7rem 0; } .history-track > span { padding:.4rem .2rem; } .replica-card { padding:.65rem; } .targets { grid-template-columns:1fr; gap:.5rem; } .target { padding:.7rem; gap:.3rem; } .explanation { min-height:11rem; } .primary-card,.read-result { padding:.6rem; } .primary-card p { font-size:.7rem; } button { padding:.4rem .55rem; } .requirement { grid-template-columns:1fr; } .requirement strong { grid-column:1; grid-row:auto; margin:.3rem 0; } }
</style>
