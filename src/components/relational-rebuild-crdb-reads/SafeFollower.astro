lor-rule);margin-top:.8rem}.crf-hold span{display:block;height:100%;background:var(--color-accent);width:0}.crf-caption{font-size:.8rem;color:var(--color-text-secondary);margin:.65rem 0}details{font-size:.8rem}summary{cursor:pointer}@media(max-width:500px){.crf-frame{padding:.8rem}.crf-replicas{grid-template-columns:1fr}.crf-explanation{min-height:7.5em}}
