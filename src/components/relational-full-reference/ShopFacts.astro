---
import { customers, productsAfter103, orders, items } from './data.mjs';
const mina = customers.find(([id]) => id === 1);
const mug = productsAfter103.find(([id]) => id === 'P7');
---
<figure class="shop-facts" aria-labelledby="facts-title">
 <figcaption id="facts-title"><span>Figure 2</span> Matching identifiers connect the facts</figcaption>
 <div class="fact-path">
  <div class="path-stop">
   <div class="table-scroll" role="region" tabindex="0" aria-label="Mina’s customer row"><table><caption>customers · one row per customer</caption><thead><tr><th scope="col">customer_id</th><th scope="col">name</th></tr></thead><tbody><tr><td><strong class="match">1</strong></td><td>{mina[1]}</td></tr></tbody></table></div>
  </div>
  <p class="connection"><span aria-hidden="true">↓</span> Match <code>customer_id</code>: <strong>1 → 1</strong><small>Both of these orders belong to Mina.</small></p>
  <div class="path-stop">
   <div class="table-scroll" role="region" tabindex="0" aria-label="Mina’s two orders"><table><caption>orders · one row per order</caption><thead><tr><th scope="col">order_id</th><th scope="col">customer_id</th><th scope="col">status</th></tr></thead><tbody>{orders.filter(([,customer])=>customer===1).map(([id,customer,status])=><tr><td>{id===103?<strong class="match">{id}</strong>:id}</td><td><strong>{customer}</strong></td><td>{status}</td></tr>)}</tbody></table></div>
  </div>
  <p class="connection"><span aria-hidden="true">↓</span> Follow <code>order_id</code>: <strong>103 → 103</strong><small>These two lines make up order 103.</small></p>
  <div class="path-stop">
   <div class="table-scroll" role="region" tabindex="0" aria-label="The two numbered lines in order 103"><table><caption>order_items · one row per numbered order line</caption><thead><tr><th scope="col">order_id</th><th scope="col">line_no</th><th scope="col">product_id</th><th scope="col">quantity</th><th scope="col">unit_price</th></tr></thead><tbody>{items.filter(([order])=>order===103).map(([order,line,product,quantity,price])=><tr><td><strong>{order}</strong></td><td>{line}</td><td>{product==='P7'?<strong class="match">{product}</strong>:product}</td><td>{quantity}</td><td>{price}</td></tr>)}</tbody></table></div>
  </div>
  <p class="connection"><span aria-hidden="true">↓</span> Follow line 1’s <code>product_id</code>: <strong>P7 → P7</strong><small>That line bought one blue mug at 20.00.</small></p>
  <div class="path-stop">
   <div class="table-scroll" role="region" tabindex="0" aria-label="The blue mug’s current offer and stock after order 103"><table><caption>products · the same P7 row as Figure 1, with its offered price</caption><thead><tr><th scope="col">product_id</th><th scope="col">name</th><th scope="col">price</th><th scope="col">stock</th></tr></thead><tbody><tr><td><strong class="match">{mug[0]}</strong></td><td>{mug[1]}</td><td>{mug[2]}</td><td>{mug[3]}</td></tr></tbody></table></div>
  </div>
 </div>
 <p class="figure-note">Selected rows and columns after order 103 has been accepted. Each arrow follows the named column and its matching value into the next table. The order is recorded, its stock has been taken, and it has not yet been paid.</p>
</figure>
<style>
 .shop-facts{margin:2.5rem 0;font-family:var(--font-sans)}figcaption{font:1.1rem var(--font-serif);margin-bottom:1rem}figcaption>span{font:.7rem var(--font-mono);text-transform:uppercase;margin-right:.7rem;color:var(--color-text-secondary)}.fact-path{border-left:2px solid var(--color-rule-strong);padding-left:1rem}.path-stop{padding:.2rem .8rem .7rem;border:1px solid var(--color-rule-strong);background:var(--color-surface-alt)}.shop-facts .table-scroll{margin:0!important;overflow-x:auto}.shop-facts table{display:table;overflow:visible;min-width:max-content;font:.78rem/1.6 var(--font-mono);width:100%;margin:0}caption{text-align:left;font:.76rem/1.5 var(--font-sans);padding:.5rem 0;color:var(--color-text-secondary)}th,td{padding:.45rem .55rem!important;white-space:nowrap}th{text-align:left}.match{display:inline-block;outline:2px solid var(--teal);outline-offset:3px}.connection{font:.8rem/1.7 var(--font-sans);margin:0;padding:.7rem .4rem}.connection>span{font-size:1.2rem;margin-right:.5rem}.connection small{display:block;margin-left:1.45rem;font-size:.76rem;color:var(--color-text-secondary)}.connection code{font-size:.75rem}.figure-note{font:.77rem/1.65 var(--font-sans);color:var(--color-text-secondary)}@media(max-width:450px){.fact-path{padding-left:.65rem}.path-stop{padding:.2rem .6rem .6rem}.shop-facts table{font-size:.73rem}th,td{padding:.45rem .5rem!important}.connection{font-size:.77rem}.connection small{margin-left:1.4rem}}
</style>
