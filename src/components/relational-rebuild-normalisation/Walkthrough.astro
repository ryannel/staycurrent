---
import { figures } from './scenes.mjs';
const { name } = Astro.props;
const f = figures[name];
---
<figure class="nf-figure" data-nf-figure aria-labelledby={`nf-${name}-title`}>
  <figcaption id={`nf-${name}-title`}><span>Figure {f.number}</span> {f.title}</figcaption>
  {f.cases.length > 1 && <label class="nf-choice">{name === 'closure' ? 'Starting attributes' : 'Declared policy'}<select data-variant aria-label={name === 'closure' ? 'Starting attributes' : 'Declared policy'}>{f.cases.map((c,i)=><option value={i}>{c.label}</option>)}</select></label>}
  <div class="nf-stage">{f.cases.map((c, ci) => c.stages.map((stage, si) => <div data-case={ci} data-scene={si} hidden={ci !== 0 || si !== 0}>
    <div class="nf-drawing" set:html={stage.html} />
    <p class="nf-explanation" data-explanation aria-live="polite">{stage.explanation}</p>
  </div>))}</div>
  <div class="nf-controls" role="group" aria-label={`Figure ${f.number} controls`}>
    <button type="button" data-play data-live>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step data-live>1 / {f.cases[0].stages.length}</span>
  </div>
  <div class="nf-hold" data-hold aria-hidden="true"><span></span></div>
  <p class="nf-caption">{f.caption}</p>
  <details class="nf-alternative"><summary>All steps as text</summary>{f.cases.map(c => <div><p><strong>{c.label}</strong></p><ol>{c.stages.map(s => <li>{s.explanation}</li>)}</ol></div>)}</details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  document.querySelectorAll<HTMLElement>('[data-nf-figure]').forEach(root => {
    const scenes = [...root.querySelectorAll<HTMLElement>('[data-scene]')];
    const choice = root.querySelector<HTMLSelectElement>('[data-variant]');
    const current = () => scenes.filter(s => s.dataset.case === (choice?.value || '0'));
    const player = stepper(root, { steps: () => current().length, draw: step => {
      scenes.forEach(s => { s.hidden = true; });
      current()[step].hidden = false;
      root.querySelectorAll('[data-scene][data-live]').forEach(el => el.removeAttribute('data-live'));
      current()[step].setAttribute('data-live', '');
      // The shared player reads the currently visible explanation when playing.
      scenes.forEach(s => { s.querySelector('.nf-explanation')?.removeAttribute('data-explanation'); });
      current()[step].querySelector('.nf-explanation')?.setAttribute('data-explanation', '');
    }});
    choice?.addEventListener('change', () => { root.querySelector<HTMLButtonElement>('[data-reset]')!.click(); player.render(); });
  });
</script>
<style is:global>
  .nf-figure { margin:2.6rem 0; }
  .nf-figure > figcaption { margin:0 0 .7rem; font:1.05rem/1.5 var(--font-serif); }
  .nf-figure > figcaption > span { margin-right:.65rem; font:.68rem/1.5 var(--font-sans); text-transform:uppercase; letter-spacing:.09em; color:var(--color-text-secondary); }
  .nf-stage { border:1px solid var(--color-rule-strong); background:var(--color-surface-alt); padding:1rem; }
  .nf-stage [hidden] { display:none !important; }
  .nf-drawing { font:.82rem/1.7 var(--font-sans); }
  .nf-drawing p { margin:.6rem 0; font:inherit; }
  .nf-drawing code { font-size:.75rem; overflow-wrap:anywhere; }
  .nf-table { overflow:auto; max-width:100%; margin:.3rem 0 1rem; }
  .nf-table table { width:100%; display:table; border-collapse:collapse; margin:0; font:inherit; }
  .nf-table caption { text-align:left; font-weight:600; margin-bottom:.55rem; }
  .nf-table th,.nf-table td { text-align:left; padding:.55rem .5rem; border-bottom:1px solid var(--color-rule); white-space:nowrap; }
  .nf-table th { font-weight:600; }
  .nf-mark { background:var(--color-surface); outline:2px solid var(--coral); outline-offset:-2px; }
  .nf-required { display:inline-block; padding:.1rem .25rem; border:2px solid var(--coral); font-weight:500; }
  .nf-boxes { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:.8rem; }
  .nf-box { border:1px solid var(--color-rule-strong); border-top:3px solid var(--teal); padding:.65rem .85rem; background:var(--color-surface); }
  .nf-drawing .nf-label { font-weight:600; color:var(--color-text); }
  .nf-arrow { text-align:center; color:var(--color-text-secondary); }
  .nf-chips { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:.55rem; margin:1rem 0; }
  .nf-chips > span { border:1px dashed var(--color-rule-strong); padding:.55rem; overflow-wrap:anywhere; }
  .nf-chips small { display:block; font:.7rem/1.5 var(--font-sans); color:var(--color-text-secondary); }
  .nf-chips .nf-known { border:2px solid var(--teal); padding:calc(.55rem - 1px); background:var(--color-surface); }
  .nf-drawing .nf-result { font-weight:600; margin-top:1rem; }
  .nf-explanation { border-left:3px solid var(--teal); padding-left:.75rem; margin:1rem 0 0; font:.85rem/1.7 var(--font-sans); }
  .nf-controls { display:flex; gap:.4rem; flex-wrap:wrap; align-items:center; border:1px solid var(--color-rule-strong); border-top:0; padding:.7rem; background:var(--color-surface); font:.75rem/1.4 var(--font-sans); }
  .nf-controls button,.nf-choice select { border:1px solid var(--color-text-secondary); padding:.45rem .7rem; border-radius:3px; color:var(--color-text); background:var(--color-surface-alt); font:inherit; cursor:pointer; }
  .nf-controls [aria-disabled="true"] { opacity:.55; cursor:default; }
  .nf-controls [data-step] { margin-left:auto; }
  .nf-choice { display:flex; gap:.7rem; flex-wrap:wrap; align-items:center; margin-bottom:.6rem; font:.8rem/1.5 var(--font-sans); }
  .nf-hold { height:3px; background:var(--color-rule); }
  .nf-hold span { display:block; height:100%; width:0; background:var(--teal); }
  .nf-caption { font:.8rem/1.65 var(--font-sans); color:var(--color-text-secondary); margin:.6rem 0; }
  .nf-alternative { font:.8rem/1.7 var(--font-sans); color:var(--color-text-secondary); }
  .nf-alternative summary { cursor:pointer; }
  .nf-controls button:focus-visible,.nf-choice select:focus-visible,.nf-table:focus-visible,.nf-alternative summary:focus-visible { outline:2px solid var(--teal); outline-offset:3px; }
  @media(max-width:550px) { .nf-stage { padding:.65rem; } .nf-table th,.nf-table td { padding:.45rem .4rem; } .nf-chips { grid-template-columns:repeat(2,minmax(0,1fr)); } }
</style>
