---
import { figures, historyMarkup } from './model.mjs';
interface Props { kind: 'purchase' | 'stock' | 'snapshots' | 'payments' }
const {kind} = Astro.props;
const config = figures[kind];
const variants = Object.entries(config.variants);
const first = variants[0][1];
const step = first.steps[0];
---
<figure class="tx-figure" data-tx-figure={kind} aria-labelledby={`tx-title-${kind}`}>
  <figcaption id={`tx-title-${kind}`}><span>Figure {config.number}</span> {config.title}</figcaption>
  <div class="tx-scene">
    {(kind === 'stock' || kind === 'snapshots') ? <div data-history data-live set:html={historyMarkup(kind, variants[0][0], 0)} /> : <div class="tx-lanes">
      <div class="tx-lane"><p class="tx-lane-title" data-left-title>{first.leftTitle}</p><ol data-left data-live>{step.left.map(line=><li>{line}</li>)}</ol></div>
      <div class="tx-lane"><p class="tx-lane-title" data-right-title>{first.rightTitle}</p><ol data-right data-live>{step.right.map(line=><li>{line}</li>)}</ol></div>
    </div>}
    {kind === 'payments' && <div class="tx-meter"><p><strong data-paid data-live>0</strong> <span>committed payments</span></p><div class="tx-track" aria-hidden="true"><span data-fill></span><i></i></div><p class="tx-limit">↑ Line value 29.00</p></div>}
    <p class="tx-state" data-state data-live>{step.state}</p>
    <p class="tx-explanation" data-explanation data-live aria-live="polite">{step.explanation}</p>
  </div>
  <div class="tx-controls" role="group" aria-label={`Controls for figure ${config.number}`}>
    <label>{config.prompt}<select data-variant aria-label={`${config.prompt} for figure ${config.number}`}>{variants.map(([key,value])=><option value={key}>{value.label}</option>)}</select></label>
    <div class="tx-buttons"><button data-play type="button">Play</button><button data-back type="button" aria-disabled="true">Back</button><button data-next type="button">Next</button><button data-reset type="button">Reset</button><span data-step>1 / {first.steps.length}</span></div>
    <div class="tx-hold" data-hold aria-hidden="true"><span></span></div>
  </div>
  <p class="tx-caption">{config.caption}</p>
  <details><summary>Figure as text</summary>{variants.map(([,variant])=><div><p><strong>{variant.label}</strong></p><ol>{variant.steps.map(s=><li>{s.explanation}</li>)}</ol></div>)}</details>
</figure>

<script>
  import { stepper } from '../figures/stepper.mjs';
  import { figures, historyMarkup } from './model.mjs';
  function initialiseTransactionFigures() {
    document.querySelectorAll<HTMLElement>('[data-tx-figure]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const config = figures[root.dataset.txFigure! as keyof typeof figures];
      const select = root.querySelector<HTMLSelectElement>('[data-variant]')!;
      const variant = () => config.variants[select.value as keyof typeof config.variants] as any;
      const lines = (selector: string, values: string[]) => {
        root.querySelector(selector)!.replaceChildren(...values.map(value => { const li = document.createElement('li'); li.textContent = value; return li; }));
      };
      const player = stepper(root, {steps:()=>variant().steps.length,draw:(index:number)=>{
        const active = variant();
        const step = active.steps[index];
        const history = root.querySelector('[data-history]');
        if (history) history.innerHTML = historyMarkup(root.dataset.txFigure, select.value, index);
        else {
          root.querySelector('[data-left-title]')!.textContent=active.leftTitle;
          root.querySelector('[data-right-title]')!.textContent=active.rightTitle;
          lines('[data-left]',step.left); lines('[data-right]',step.right);
        }
        root.querySelector('[data-state]')!.textContent=step.state;
        root.querySelector('[data-explanation]')!.textContent=step.explanation;
        const paid = root.querySelector('[data-paid]');
        if (paid) { paid.textContent=step.paid===0?'0':step.paid.toFixed(2); (root.querySelector('[data-fill]') as HTMLElement).style.width=`${step.paid/40*100}%`; }
      }});
      select.addEventListener('change',()=>player.render());
    });
  }
  initialiseTransactionFigures();
  document.addEventListener('astro:page-load',initialiseTransactionFigures);
</script>

<style>
  .tx-figure { margin:2.5rem 0; }
  figcaption { font:1.2rem/1.5 var(--font-serif); margin:0 0 .75rem; }
  figcaption > span { font:.7rem/1.5 var(--font-sans); text-transform:uppercase; letter-spacing:.1em; margin-right:.8rem; color:var(--color-text-secondary); }
  .tx-scene { border:1px solid var(--color-rule-strong); background:var(--color-surface-alt); padding:1.1rem; }
  .tx-scene :global(.tx-history) { display:table; width:100%; margin:0; table-layout:fixed; border-collapse:collapse; font:.82rem/1.55 var(--font-sans); }
  .tx-scene :global(.tx-history caption) { text-align:left; font:.75rem/1.5 var(--font-sans); color:var(--color-text-secondary); margin-bottom:.6rem; }
  .tx-scene :global(.tx-history th),.tx-scene :global(.tx-history td) { padding:.65rem .45rem; text-align:left; vertical-align:top; border-bottom:1px solid var(--color-rule-strong); overflow-wrap:anywhere; }
  .tx-scene :global(.tx-history th:first-child) { width:24%; font-weight:400; }
  .tx-scene :global(.tx-now) { background:color-mix(in srgb,var(--teal) 10%,var(--color-surface)); }
  .tx-scene :global(.tx-commit) { border-top:2px solid var(--color-text-secondary); border-bottom:2px solid var(--color-text-secondary); }
  .tx-scene :global(.tx-snapshot) { display:block; font:.72rem/1.5 var(--font-sans); color:var(--color-text-secondary); margin-top:.3rem; border-left:2px solid var(--teal); padding-left:.4rem; }
  .tx-lanes { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:.8rem; }
  .tx-lane { border:1px solid var(--color-rule-strong); background:var(--color-surface); min-height:12rem; }
  .tx-lane-title { font:600 .82rem/1.5 var(--font-sans); margin:0; padding:.6rem .75rem; border-bottom:1px solid var(--color-rule-strong); }
  ol { font:.86rem/1.65 var(--font-sans); }
  .tx-lane ol { list-style:none; padding:.7rem; margin:0; }
  .tx-lane ol :global(li) { padding:.35rem 0; margin:0; overflow-wrap:anywhere; border-bottom:1px solid var(--color-rule); }
  .tx-state { margin:1rem 0 .7rem; font:600 .85rem/1.6 var(--font-sans); }
  .tx-explanation { border-left:3px solid var(--color-accent); padding-left:.8rem; margin:0; min-height:5rem; font:.9rem/1.65 var(--font-sans); }
  .tx-controls { border:1px solid var(--color-rule-strong); border-top:0; padding:.85rem 1rem .5rem; background:var(--color-surface); font:.8rem/1.5 var(--font-sans); }
  label { display:flex; gap:.6rem; align-items:center; flex-wrap:wrap; }
  select,button { color:var(--color-text); background:var(--color-surface-alt); border:1px solid var(--color-rule-strong); border-radius:3px; padding:.45rem .65rem; font:inherit; cursor:pointer; max-width:100%; }
  button:hover { border-color:var(--color-accent); }
  button[aria-disabled="true"] { color:var(--color-text-secondary); }
  button:focus-visible,select:focus-visible,summary:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
  .tx-buttons { display:flex; align-items:center; gap:.45rem; margin-top:.7rem; flex-wrap:wrap; }
  .tx-buttons > span { margin-left:auto; white-space:nowrap; color:var(--color-text-secondary); }
  .tx-hold { height:2px; margin-top:.7rem; background:var(--color-rule); }
  .tx-hold span { display:block; height:100%; width:0; background:var(--color-accent); }
  .tx-caption { font:.8rem/1.65 var(--font-sans); color:var(--color-text-secondary); margin:.7rem 0; }
  details { font:.82rem/1.6 var(--font-sans); margin:.75rem 0; }
  details p { font:inherit; margin:.8rem 0; }
  summary { cursor:pointer; }
  .tx-meter { margin-top:1rem; font:.8rem/1.5 var(--font-sans); }
  .tx-meter p { font:inherit; margin:.3rem 0; }
  .tx-meter strong { font:1.4rem/1.4 var(--font-serif); margin-right:.3rem; }
  .tx-track { height:1.1rem; border:1px solid var(--color-rule-strong); position:relative; background:var(--color-surface); }
  .tx-track > span { display:block; height:100%; width:0; background:var(--color-accent); }
  .tx-track > i { position:absolute; left:72.5%; top:-4px; bottom:-4px; border-left:2px solid var(--color-text); }
  .tx-limit { padding-left:calc(72.5% - 4rem); }
  @media(max-width:550px) { .tx-scene { padding:.65rem; } .tx-lanes { gap:.5rem; } .tx-lane-title { font-size:.75rem; padding:.5rem; } .tx-lane ol { padding:.5rem; font-size:.78rem; } .tx-lane { min-height:14rem; } .tx-explanation { min-height:8rem; } .tx-controls { padding:.7rem .65rem .5rem; } .tx-buttons { gap:.35rem; } button { padding:.45rem .55rem; } }
</style>
