---
const stages = [
  { holder: 'H holds ACCESS EXCLUSIVE', clients: ['Free', 'Free', 'Free'], queue: 'No queued callers', edge: 'No history query has started', explanation: 'A separate session H acquires the orders table lock inside a transaction. The lock statement returns; H leaves that transaction open.' },
  { holder: 'H idle in its transaction', clients: ['History read · waits for H', 'History read · waits for H', 'History read · waits for H'], queue: 'No queued callers', edge: '3 readers → orders lock → H', explanation: 'Three application requests borrow the three clients. Each ordinary history SELECT waits for the table lock. All clients are occupied, even though no history rows have been returned.' },
  { holder: 'H still holds the lock', clients: ['History read · waits for H', 'History read · waits for H', 'History read · waits for H'], queue: '2 later callers wait for clients', edge: '2 callers → pool clients → readers → H', explanation: 'Two later callers arrive. They cannot borrow a client, so neither has sent its history SELECT to the database. The same holder now explains two different places of waiting.' },
  { holder: 'H still holds the lock', clients: ['History read · waits for H', 'History read · waits for H', 'History read · waits for H'], queue: '1 later caller waits for a client', edge: 'One pool waiter leaves; the lock remains', explanation: 'One queued caller gives up before borrowing. Its queue entry is removed. That reduces the queue from two to one, but releases no borrowed client and no database lock.' },
  { holder: 'H ends: ROLLBACK', clients: ['History read · can proceed', 'History read · can proceed', 'History read · can proceed'], queue: '1 later caller still waiting', edge: 'Table lock released → readers can run', explanation: 'The identified lock-only holder rolls back. Its table lock is released. The three blocked statements can now proceed; their clients are not yet free merely because the lock disappeared.' },
  { holder: 'No blocking transaction', clients: ['Released to pool', 'Released to pool', 'Released to pool'], queue: 'Later caller can borrow and read', edge: 'Reads finish → clients return → queue drains', explanation: 'The readers receive and consume their results, finish any transaction and return their clients. The remaining caller can borrow one. Recovery includes that drainage, not just the release of H.' }
];
---
<figure class="incident-figure" id="incident-chain" aria-labelledby="incident-chain-title" data-incident-chain data-stages={JSON.stringify(stages)}>
  <figcaption id="incident-chain-title"><span class="figure-number">Figure 2</span> A database wait becomes a pool queue</figcaption>
  <div class="incident-scene">
    <p class="scene-note">Illustrative PostgreSQL schedule · pool capacity 3</p>
    <div class="chain-holder"><span>Separate holder H</span><strong data-holder data-live>{stages[0].holder}</strong></div>
    <div class="dependency-arrow" data-edge data-live>{stages[0].edge}</div>
    <div class="client-pool" aria-label="Three application pool clients">
      {stages[0].clients.map((client, i) => <div class="client"><span>Client {i + 1}</span><strong data-client data-live>{client}</strong></div>)}
    </div>
    <div class="chain-queue" data-queue data-live>{stages[0].queue}</div>
    <p class="figure-explanation" data-explanation data-live aria-live="polite">{stages[0].explanation}</p>
  </div>
  <div class="incident-controls" role="group" aria-label="Controls for figure 2">
    <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / 6</span>
    <div data-hold class="incident-hold" aria-hidden="true"><span></span></div>
  </div>
  <p class="incident-caption">Independent lock-only branch. H changes no rows. All three clients belong to this one illustrative pool; H is a separate connection. Arrows point towards what the request needs, rather than showing messages or elapsed time.</p>
  <details><summary>All stages, as text</summary><ol>{stages.map(stage => <li>{stage.explanation}</li>)}</ol></details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  document.querySelectorAll<HTMLElement>('[data-incident-chain]').forEach(root => {
    const stages = JSON.parse(root.dataset.stages!);
    stepper(root, { steps: () => stages.length, draw: (index: number) => {
      const stage = stages[index];
      root.querySelector('[data-holder]')!.textContent = stage.holder;
      root.querySelector('[data-edge]')!.textContent = stage.edge;
      root.querySelector('[data-queue]')!.textContent = stage.queue;
      root.querySelector('[data-explanation]')!.textContent = stage.explanation;
      root.querySelectorAll('[data-client]').forEach((client, i) => { client.textContent = stage.clients[i]; });
      root.dataset.phase = String(index);
    }});
  });
</script>
