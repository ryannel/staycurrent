---
import { scenes, classes, instructors } from './model.mjs';
const { scene, number } = Astro.props;
const definition = scenes[scene];
const row = classes[scene === 'atomicity' ? 1 : 0];
---
<figure class="transaction-figure" data-transaction-scene={scene}>
 <figcaption><strong>Figure {number}. {definition.title}</strong><span>Illustrative model of selected PostgreSQL schedules.</span></figcaption>
 <label>Protection <select data-option>{definition.options.map(([value,label])=><option value={value}>{label}</option>)}</select></label>
 <div class="lanes"><div><strong>{scene==='staffing'?'Lena’s transaction':scene==='atomicity'?'Mina’s first request · R10':'Mina’s request'}</strong><p data-a data-live></p></div><div><strong>{scene==='staffing'?'Ravi’s transaction':scene==='atomicity'?'Mina’s second request · R11':'Tariq’s request'}</strong><p data-b data-live></p></div></div>
 {scene==='staffing'?<div class="data-table"><table><caption>Committed instructors</caption><thead><tr><th>class_id · FK</th><th>person · PK with class</th><th>available</th></tr></thead><tbody>{instructors.map(([id,person])=><tr><td>{id}</td><td>{person}</td><td data-person={person} data-live>true</td></tr>)}</tbody></table></div>:<div class="tables"><div class="data-table"><table><caption>Committed classes</caption><thead><tr><th>class_id · PK</th><th>capacity</th><th>remaining</th></tr></thead><tbody><tr><td>{row[0]}</td><td>{row[2]}</td><td data-remaining data-live>{row[3]}</td></tr></tbody></table></div><p class="relationship">classes.class_id ← reservations.class_id</p><div class="data-table"><table><caption>Committed reservations</caption><thead><tr><th>request_id · PK</th><th>class_id · FK</th><th>owner_id · FK</th></tr></thead><tbody data-reservations data-live></tbody></table></div></div>}
 <p data-explanation data-live aria-live="polite"></p>
 <div class="controls"><button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step></span></div><div data-hold class="hold"><span></span></div>
 <p class="boundary">The tables show committed state; the lanes describe pending work. Fixed steps omit timing, storage and other requests. This figure runs a model, not a database.</p>
 <details><summary>Read this figure as text</summary><p>{definition.text}</p></details>
</figure>
<script>
 import { stepper } from '../../figures/stepper.mjs';
 import { scenes } from './model.mjs';
 document.querySelectorAll<HTMLElement>('[data-transaction-scene]').forEach(root=>{
  const scene = root.dataset.transactionScene!;
  const definition = scenes[scene];
  const option = root.querySelector<HTMLSelectElement>('[data-option]')!;
  const frames = ()=>definition.steps(option.value);
  let lastValues = new Map();
  const paint=(selector,value)=>{const el=root.querySelector<HTMLElement>(selector);if(!el)return; const text=String(value);el.classList.toggle('changed',lastValues.has(selector)&&lastValues.get(selector)!==text);el.textContent=text;lastValues.set(selector,text);};
  const player=stepper(root,{steps:()=>frames().length,draw(index){
   const frame=frames()[index];
   paint('[data-a]',frame.a);paint('[data-b]',frame.b);paint('[data-explanation]',frame.explanation);
   if(scene==='staffing'){paint('[data-person="Lena"]',frame.available[0]);paint('[data-person="Ravi"]',frame.available[1]);}
   else {paint('[data-remaining]',frame.remaining);const body=root.querySelector('[data-reservations]')!;body.replaceChildren();for(const request of frame.bookings){const tr=document.createElement('tr');const classId=scene==='atomicity'?22:21;const owner=['R7','R9'].includes(request)?2:1;for(const value of [request,classId,owner]){const td=document.createElement('td');td.textContent=String(value);tr.append(td);}body.append(tr);}if(!frame.bookings.length){const tr=document.createElement('tr');const td=document.createElement('td');td.colSpan=3;td.textContent='No reservations';tr.append(td);body.append(tr);}}
  }});
  option.addEventListener('change',()=>{lastValues=new Map();root.querySelector<HTMLButtonElement>('[data-reset]')!.click();player.render();});
 });
</script>
<style>
 .transaction-figure{margin:2rem 0;border:1px solid var(--color-rule);padding:1rem;background:var(--color-surface);border-radius:.6rem;min-width:0;}
 figcaption strong,figcaption span{display:block;}figcaption span,.boundary{font-size:.82rem;color:var(--color-text-secondary);}
 label{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin:1rem 0;}select,button{font:inherit;color:var(--color-text);background:var(--color-surface-alt);border:1px solid var(--color-rule);border-radius:.3rem;padding:.45rem .6rem;}
 .lanes{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.lanes>div{border:1px solid var(--color-rule);padding:.7rem;min-height:7rem;}.lanes p{font-size:.9rem;margin:.4rem 0;}
 .data-table{overflow:auto;margin:.8rem 0;}table{width:100%;font:.78rem/1.5 var(--font-mono);border-collapse:collapse;}caption{text-align:left;font-family:var(--font-body);font-weight:600;}th,td{text-align:left;white-space:nowrap;padding:.4rem;border-bottom:1px solid var(--color-rule);}th{font-size:.7rem;}.relationship{font:.7rem/1.6 var(--font-mono);overflow-wrap:anywhere;}
 .changed{font-weight:700;text-decoration:underline;text-underline-offset:.2em;}.controls{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;}button{cursor:pointer;}button[aria-disabled="true"]{color:var(--color-text-secondary);}.hold{height:3px;background:var(--color-rule);margin:.7rem 0;}.hold span{display:block;height:100%;width:0;background:var(--color-text);}
 @media(max-width:600px){.lanes{grid-template-columns:1fr}.lanes>div{min-height:0}.transaction-figure{padding:.65rem}table{font-size:.68rem}th,td{padding:.3rem .2rem}th{font-size:.62rem}}
</style>
