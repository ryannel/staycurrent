---
const modules = import.meta.glob('./{foundations,postgresql,distributed}/*.mjs', { eager: true });
const { collection, kind, number, id, title, caption } = Astro.props;
const scene = (modules[`./${collection}.mjs`] as any)?.scenes?.[kind];
if (!scene) throw new Error(`Unknown relational motion scene: ${collection}/${kind}`);
const variant = scene.defaultVariant ?? 'story';
---
<figure class="relational-motion wide" id={id} data-relational-motion data-collection={collection} data-kind={kind} data-variant={variant}>
  <div class="motion-title">{title ?? scene.title}</div>
  <div class="delight-stage" role="img" aria-label={scene.altFor?.(variant) ?? scene.alt} set:html={scene.render(1, variant)}></div>
  <div class="delight-controls" hidden>
    {scene.choices?.map((choice: any) => <label class="motion-choice">{choice.label}<select data-scene-choice aria-label={`${choice.label}: ${scene.title}`}>{choice.options.map((option: any) => <option value={option.value} selected={option.value === choice.value}>{option.label}</option>)}</select></label>)}
    {scene.actions?.map((action: {value: string; label: string}) => <button type="button" data-variant-action={action.value} aria-pressed={action.value === variant}>{action.label}</button>)}
    <span class="motion-playback">
      <button type="button" data-pause aria-label={`Pause animation: ${scene.title}`}>Pause</button>
      <button type="button" data-replay aria-label={`Replay animation: ${scene.title}`}>Replay</button>
    </span>
  </div>
  <figcaption>{number && <span>Figure {number}. </span>}<slot>{caption ?? scene.caption}</slot></figcaption>
  <details class="motion-alternative"><summary>Figure as text</summary><p>{scene.alt}</p></details>
</figure>
<script>
  import { mountScene } from '../application-caching/delight/player.mjs';
  const modules = import.meta.glob('./{foundations,postgresql,distributed}/*.mjs');
  const cleanups: Array<() => void> = [];
  let disposed = false;
  document.querySelectorAll<HTMLElement>('[data-relational-motion]').forEach(async root => {
    const module = await modules[`./${root.dataset.collection}.mjs`]();
    if (disposed) return;
    const scene = (module as any).scenes[root.dataset.kind!];
    const unmount = mountScene(root, scene);
    const selection = () => root.querySelectorAll<HTMLButtonElement>('[data-variant-action]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.variantAction === root.dataset.variant)));
    root.addEventListener('click', selection);
    cleanups.push(() => { root.removeEventListener('click', selection); unmount(); });
  });
  document.addEventListener('astro:before-swap', () => { disposed = true; cleanups.forEach(fn => fn()); }, { once: true });
</script>
<style is:global>
  .visual-essay .relational-motion { width:100%; max-width:none; margin:2rem 0 2.5rem; transform:none; font-family:var(--font-sans); }
  .relational-motion .motion-title { text-align:center; font:400 1.25rem/1.4 var(--font-sans); margin:0 0 .5rem; color:var(--color-text); }
  .relational-motion svg { display:block; width:100%; height:auto; overflow:visible; }
  .relational-motion .motion-portrait { display:none; }
  .relational-motion .delight-controls { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; margin-top:.5rem; }
  .relational-motion .motion-playback { display:flex; gap:.5rem; margin-left:auto; }
  .relational-motion .delight-controls[hidden], .relational-motion button[hidden] { display:none; }
  .relational-motion button { min-height:44px; padding:.4rem .7rem; border:0; background:transparent; font:.8rem var(--font-sans); color:var(--color-text-secondary); text-decoration:underline; text-underline-offset:4px; cursor:pointer; }
  .relational-motion button[aria-pressed="true"] { color:var(--color-text); text-decoration-thickness:2px; }
  .relational-motion .motion-choice { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; font:.8rem var(--font-sans); color:var(--color-text-secondary); }
  .relational-motion select { max-width:100%; min-height:44px; font:inherit; padding:.3rem .5rem; color:var(--color-text); border:1px solid var(--color-rule-strong); border-radius:4px; background:var(--color-surface); }
  .relational-motion button:hover { color:var(--color-accent); }
  .relational-motion button:focus-visible, .relational-motion summary:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; border-radius:3px; }
  .relational-motion figcaption { display:block; max-width:640px; margin:.9rem 0 0; color:var(--color-text-secondary); font:.83rem/1.6 var(--font-sans); }
  .relational-motion .motion-alternative { font:.78rem/1.6 var(--font-sans); color:var(--color-text-secondary); margin:.5rem 0 0; }
  .relational-motion .motion-alternative summary { cursor:pointer; width:fit-content; text-decoration:underline; text-underline-offset:3px; }
  .relational-motion .motion-alternative p { font:inherit; max-width:640px; margin:.5rem 0; }
  @media(min-width:900px) { .visual-essay .relational-motion { width:800px; margin-left:calc((100% - 800px)/2); } }
  @media(max-width:600px) { .relational-motion .motion-landscape { display:none; } .relational-motion .motion-portrait { display:block; } }
</style>
