---
interface Props { direction: 'forward'|'return'; }
const { direction } = Astro.props;
const forward = direction === 'forward';
const title = forward ? 'Close PostgreSQL before opening CockroachDB' : 'Bring the accepted purchase back with you';
const steps = forward ? [
 {name:'Prepare an excluded candidate',leftGate:'Open · sole writer',rightGate:'Closed',left:'Stock 12 / 1 / 4',right:'Empty target',leftDetail:'Orders 101 and 102; no 103',rightDetail:'Reviewed schema; no shop callers',arrow:'No final copy yet',authority:'PostgreSQL owns new work',text:'The source serves the shop. The target has the reviewed schema, but neither application writers nor dispatch workers may use it.'},
 {name:'Close admission and drain',leftGate:'Closing → closed',rightGate:'Closed',left:'Final source state',right:'Still excluded',leftDetail:'Resolve admitted transactions and outside calls',rightDetail:'No accepted target work',arrow:'Writers must be excluded',authority:'Neither side admits new work',text:'Stop purchases, imports and jobs. Account for work already in flight, exclude old writing paths and test a stale source caller. Changing its destination alone does not stop an existing connection.'},
 {name:'Copy one final snapshot',leftGate:'Closed',rightGate:'Closed',left:'Stock 12 / 1 / 4',right:'Stock 12 / 1 / 4',leftDetail:'101 and 102; request/outbox tables included',rightDetail:'Related tables loaded in dependency order',arrow:'One snapshot → CSV → load',authority:'Copying grants no authority',text:'Export the closed source through one PostgreSQL Repeatable Read snapshot. Load the complete related state into the empty target. Keep both application writing paths closed.'},
 {name:'Accept the copy and the application',leftGate:'Closed',rightGate:'Closed · under acceptance',left:'Retained original',right:'Complete values match',leftDetail:'Usable source, still excluded',rightDetail:'Keys, references, requests, work and access',arrow:'Compare full state',authority:'A failed check keeps the target closed',text:'Compare every required key and value, then test the application under controlled runtime access. Rehearsal work is isolated; any retained target change or outside effect counts towards the return decision.'},
 {name:'Record the decision; move callers',leftGate:'Closed · stale writes refused',rightGate:'Open · sole writer',left:'Stock 12 / 1 / 4',right:'Stock 12 / 1 / 4',leftDetail:'Old pools and restart paths excluded',rightDetail:'New connections checked at target',arrow:'Write authority →',authority:'CockroachDB owns new work',text:'Persist the target as the chosen authority. Replace old pooled connections and verify each caller’s destination before admitting target work. A controller restart must recover this decision instead of reopening both sides.'},
 {name:'Accept purchase-103',leftGate:'Closed · now stale',rightGate:'Open · sole writer',left:'Stock 12 / 1 / 4',right:'Stock 10 / 0 / 4',leftDetail:'No order 103; no retained request or acknowledgement',rightDetail:'103 pending · two lines · 29.00 · no payment',arrow:'First accepted target work',authority:'Simple return to the old copy has ended',text:'The target commits the purchase, its retained request result and work identity order-103-ack. PostgreSQL does not contain them. Reopening it would lose accepted work.'}
] : [
 {name:'Compare the two histories',leftGate:'Closed · stale original',rightGate:'Open · sole writer',left:'Stock 12 / 1 / 4',right:'Stock 10 / 0 / 4',leftDetail:'No order 103 or purchase-103 result',rightDetail:'103 pending · 29.00 · order-103-ack ready',arrow:'Old copy cannot take over',authority:'CockroachDB contains accepted new work',text:'Both engines can be healthy while their facts disagree. The original PostgreSQL database cannot answer Mina’s repeated purchase correctly because it predates her accepted request.'},
 {name:'Close CockroachDB and drain',leftGate:'Closed · stale original',rightGate:'Closing → closed',left:'Keep for evidence',right:'Final target state',leftDetail:'Do not overwrite the original',rightDetail:'All admitted outcomes accounted for',arrow:'Stop new work and dispatch',authority:'Neither side admits new work',text:'Stop target admission and dispatch, drain admitted work and exclude stale target callers. Establish the finite state to bring back. Already accepted external effects remain obligations.'},
 {name:'Load a fresh PostgreSQL candidate',leftGate:'Closed · new candidate',rightGate:'Closed',left:'Stock 10 / 0 / 4',right:'Stock 10 / 0 / 4',leftDetail:'103 + lines + request result + acknowledgement',rightDetail:'Final compatible state retained',arrow:'← Complete CSV copy',authority:'The old PostgreSQL database stays separate',text:'Export CockroachDB’s complete compatible final state and load a fresh PostgreSQL database. Include operation payloads, terminal results and durable work, as well as the five business tables.'},
 {name:'Accept before reopening',leftGate:'Closed · accepted candidate',rightGate:'Closed',left:'purchase-103 → 103',right:'purchase-103 → 103',leftDetail:'Same payload, pending result and order-103-ack',rightDetail:'Same complete keys and values',arrow:'Compare and recover repeat',authority:'No new purchase or dispatch',text:'Compare the full state and verify the repeat through PostgreSQL’s runtime identity. The retained result resolves the request; do not reconstruct it by purchasing again.'},
 {name:'Transfer authority again',leftGate:'Open · sole writer',rightGate:'Closed · stale callers refused',left:'103 pending · 29.00',right:'Retained final source',leftDetail:'Stock 10 / 0 / 4; no payment',rightDetail:'Preserve until recovery obligations are settled',arrow:'← Write authority',authority:'The fresh PostgreSQL candidate owns new work',text:'Record the new authority, move and verify callers, then resume admitted work. Resume dispatch only with its original identities and accounted-for external outcomes.'}
];
---
<figure class="migration-figure wide" data-migration-player data-direction={direction} data-steps={JSON.stringify(steps)} aria-label={title}>
  <figcaption class="migration-heading"><span>Figure {forward ? 2 : 3}</span><strong>{title}</strong></figcaption>
  <div class="migration-paper">
    <div class="migration-stage">
      <div class="migration-system" data-system="left"><strong data-left-name data-live>{forward ? 'PostgreSQL · source' : 'PostgreSQL · return'}</strong><span class="gate" data-left-gate data-live></span><b data-left data-live></b><span data-left-detail data-live></span></div>
      <div class="migration-transfer" data-arrow data-live></div>
      <div class="migration-system" data-system="right"><strong data-right-name data-live>CockroachDB · {forward ? 'candidate' : 'source'}</strong><span class="gate" data-right-gate data-live></span><b data-right data-live></b><span data-right-detail data-live></span></div>
    </div>
    <p class="migration-authority" data-authority data-live></p>
    <div class="migration-explanation" data-explanation aria-live="polite"><strong data-name data-live></strong><p data-text data-live></p></div>
  </div>
  <div class="migration-controls" role="group" aria-label={`Playback for figure ${forward ? 2 : 3}`}>
    <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step></span><div class="migration-hold" data-hold aria-hidden="true"><span></span></div>
  </div>
  <p class="migration-caption">{forward ? 'A deliberately paused handover model, starting before purchase 103. The stages show required ordering, not elapsed time. Controlled acceptance does not authorise two live application writers.' : 'A return after the target accepts purchase 103. At the copy stage, the left-hand box becomes a fresh PostgreSQL candidate; the original source remains separate and stale. This model assumes the target is readable and its final state fits the reviewed PostgreSQL contract.'}</p>
  <details class="migration-alt"><summary>Figure as text</summary><ol>{steps.map(s=><li><strong>{s.name}.</strong> {s.text} {s.authority}.</li>)}</ol></details>
</figure>
<script>
  import { stepper } from '../figures/stepper.mjs';
  document.querySelectorAll<HTMLElement>('[data-migration-player]').forEach(root=>{
    if(root.dataset.ready)return;root.dataset.ready='true';
    const steps=JSON.parse(root.dataset.steps||'[]');
    const field=(key:string,value:string)=>{const el=root.querySelector(`[data-${key}]`);if(el)el.textContent=value;};
    stepper(root,{steps:()=>steps.length,draw:(i:number)=>{const s=steps[i];field('left-name',root.dataset.direction==='forward'?'PostgreSQL · source':i<2?'PostgreSQL · original':i<4?'PostgreSQL · candidate':'PostgreSQL · authority');field('right-name',root.dataset.direction==='forward'?(i<4?'CockroachDB · candidate':'CockroachDB · authority'):'CockroachDB · source');for(const [key,value] of Object.entries(s))field(key.replace(/[A-Z]/g,m=>`-${m.toLowerCase()}`),String(value));}});
  });
</script>
<style>
.migration-figure{margin-top:2rem;margin-bottom:2rem;max-width:880px;font: .83rem/1.5 var(--font-sans)}
.migration-heading{display:flex;gap:.7rem;align-items:baseline;margin:0 0 .6rem}.migration-heading span{font:.65rem var(--font-mono);text-transform:uppercase;color:var(--color-text-secondary)}.migration-heading strong{font:500 1.15rem var(--font-serif)}
.migration-paper{padding:1.2rem;border:1px solid var(--color-rule-strong);background:var(--color-surface-alt)}
.migration-stage{display:grid;grid-template-columns:minmax(0,1fr) minmax(7rem,.6fr) minmax(0,1fr);gap:.8rem;align-items:center}.migration-system{padding:.9rem;border:1px solid var(--color-text-secondary);background:var(--color-surface);min-height:195px;display:flex;flex-direction:column;gap:.65rem;overflow-wrap:anywhere}.migration-system strong{font-size:.85rem}.migration-system b{font:500 1rem/1.5 var(--font-mono)}.migration-system>span:last-child{color:var(--color-text-secondary);font-size:.78rem}.gate{border-bottom:2px solid var(--teal);padding-bottom:.45rem;font-size:.75rem}.migration-transfer{text-align:center;font:.78rem/1.6 var(--font-sans);color:var(--color-text-secondary);overflow-wrap:anywhere}.migration-authority{border-top:1px solid var(--color-rule-strong);padding-top:.7rem;margin:.9rem 0 0;font-weight:600}.migration-explanation{border-left:3px solid var(--teal);padding-left:.8rem;margin-top:1.3rem;min-height:8em}.migration-explanation p{margin:.4rem 0 0}.migration-controls{display:flex;flex-wrap:wrap;gap:.45rem;align-items:center;padding:.7rem;background:var(--control-tint);border:1px solid var(--control);border-top:0}.migration-controls button{font:.8rem var(--font-sans);color:var(--control);background:var(--color-surface);border:1px solid var(--control);border-radius:4px;min-height:42px;padding:.4rem .7rem;cursor:pointer}.migration-controls button[aria-disabled="true"]{border-style:dashed}.migration-controls :focus-visible{outline:3px solid var(--control);outline-offset:3px}.migration-controls>span{margin-left:auto;color:var(--color-text);font:.75rem var(--font-mono)}.migration-hold{height:3px;flex-basis:100%;background:var(--color-rule)}.migration-hold span{display:block;width:0;height:100%;background:var(--control)}.migration-caption{color:var(--color-text-secondary);font:.76rem/1.6 var(--font-sans);margin:.6rem 0}.migration-alt{font:.78rem/1.6 var(--font-sans)}.migration-alt summary{cursor:pointer;color:var(--color-text-secondary)}.migration-alt li{margin:.6rem 0}
@media(max-width:620px){.migration-stage{grid-template-columns:1fr}.migration-system{min-height:0;gap:.35rem}.migration-transfer{padding:.2rem}.migration-paper{padding:.85rem}.migration-explanation{min-height:10em}.migration-heading{flex-wrap:wrap;gap:.3rem .7rem}.migration-heading strong{font-size:1rem}}
</style>
