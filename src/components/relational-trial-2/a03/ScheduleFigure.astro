---
// A two-session (or one-session) history, replayed step by step from the
// schedules in model.mjs that verify.mjs checks against PostgreSQL 18.
// Controls follow src/components/figures/stepper.mjs.
import { figures } from './model.mjs';
import { boardHtml, textAlternative } from './render.mjs';

interface Props { figure: string; number: number; caption: string; options?: string[]; initial?: string }
const { figure: id, number, caption, options: only, initial } = Astro.props;
const figure = figures[id as keyof typeof figures];
if (!figure) throw new Error(`Unknown schedule figure: ${id}`);
const options = only ? figure.options.filter(o => only.includes(o.id)) : figure.options;
const first = options.find(o => o.id === (initial ?? figure.initial)) ?? options[0];
const alternative = textAlternative({ ...figure, options });
const dom = `sched-${number}`;
---
<schedule-figure data-figure={id} data-options={options.map(o => o.id).join(' ')} data-initial={first.id}>
  <figure class="sched" aria-labelledby={`${dom}-title`}>
    <div class="sched-head"><span class="sched-number">Figure {number}</span><p class="sched-title" id={`${dom}-title`}>{figure.title}</p></div>
    <p class="sched-kind">Replays a schedule recorded on PostgreSQL 18.6. The figure animates those results; it does not run a database.</p>
    {options.length > 1 && <div class="sched-options" role="group" aria-label={`Choose the protocol for figure ${number}`}>
      {options.map(o => <button type="button" data-option={o.id} aria-pressed={String(o.id === first.id)}>{o.label}</button>)}
    </div>}
    <div class="sched-board" data-board set:html={boardHtml(figure, first, 0)} />
    <p class="sched-explanation" data-explanation data-live aria-live="polite">{first.steps[0].text}</p>
    <div class="sched-controls" role="group" aria-label={`Step controls for figure ${number}`}>
      <button type="button" data-play>Play</button>
      <button type="button" data-back aria-disabled="true">Back</button>
      <button type="button" data-next>Next</button>
      <button type="button" data-reset>Reset</button>
      <span class="sched-count" data-step aria-live="off">1 / {first.steps.length}</span>
      <span class="sched-hold" data-hold aria-hidden="true"><span></span></span>
    </div>
    <details class="sched-text">
      <summary>Read this figure as text</summary>
      {alternative.map(a => <div class="alt-option">
        <p><strong>{a.label}.</strong> {a.outcome}</p>
        <ol>{a.steps.map(t => <li>{t}</li>)}</ol>
      </div>)}
    </details>
    <figcaption>{caption}</figcaption>
  </figure>
</schedule-figure>

<script>
  import { stepper } from '../../figures/stepper.mjs';
  import { figures } from './model.mjs';
  import { boardHtml } from './render.mjs';

  class ScheduleFigure extends HTMLElement {
    connectedCallback() {
      const figure = figures[this.dataset.figure as keyof typeof figures];
      const allowed = (this.dataset.options ?? '').split(' ');
      let option = figure.options.find(o => o.id === this.dataset.initial)!;
      const board = this.querySelector<HTMLElement>('[data-board]')!;
      const explanation = this.querySelector<HTMLElement>('[data-explanation]')!;
      const controls = stepper(this, {
        steps: () => option.steps.length,
        draw: (step: number) => {
          board.innerHTML = boardHtml(figure, option, step);
          explanation.textContent = option.steps[step].text;
        },
      });
      this.querySelectorAll<HTMLButtonElement>('[data-option]').forEach(button => button.addEventListener('click', () => {
        if (!allowed.includes(button.dataset.option!)) return;
        option = figure.options.find(o => o.id === button.dataset.option)!;
        this.querySelectorAll('[data-option]').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
        controls.render();
      }));
    }
  }
  if (!customElements.get('schedule-figure')) customElements.define('schedule-figure', ScheduleFigure);
</script>

<style>
  schedule-figure { display: block; margin: 2.2rem 0; }
  .sched { margin: 0; padding: 1.1rem; border: 1px solid var(--color-rule-strong); background: var(--color-surface-alt); }
  .sched-head { display: flex; flex-wrap: wrap; gap: .2rem .7rem; align-items: baseline; }
  .sched-number { font: 600 .72rem var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--color-text-secondary); }
  .sched-title { margin: 0; font: 600 1rem/1.4 var(--font-sans); }
  .sched-kind { margin: .35rem 0 .9rem; font: .76rem/1.5 var(--font-sans); color: var(--color-text-secondary); }
  .sched-options { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0 0 1rem; }
  .sched button { font: .8rem/1.3 var(--font-sans); padding: .45rem .7rem; border: 1px solid var(--control); border-radius: 6px; color: var(--control); background: var(--color-surface); cursor: pointer; }
  .sched button[aria-pressed="true"] { background: var(--control); color: var(--control-ink); }
  .sched button[aria-disabled="true"] { opacity: .5; cursor: default; }
  .sched button:focus-visible { outline: 3px solid var(--control); outline-offset: 3px; }

  .sched-board { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  .sched-board :global(.history) { min-width: 0; }
  .sched-board :global(.lane-heads), .sched-board :global(.hrow) { display: grid; gap: .5rem; }
  .sched-board :global(.lanes-2 .lane-heads), .sched-board :global(.lanes-2 .hrow) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .sched-board :global(.lane-head) { padding: .45rem .55rem; border-bottom: 2px solid var(--color-rule-strong); }
  .sched-board :global(.lane-name) { display: block; font: 600 .8rem var(--font-sans); }
  .sched-board :global(.pending) { display: block; margin-top: .2rem; font: .72rem/1.4 var(--font-sans); color: var(--color-text-secondary); min-height: 2.1em; }
  .sched-board :global(.hrows) { list-style: none; margin: .4rem 0 0; padding: 0; }
  .sched-board :global(.hrow) { margin: 0 0 .35rem; }
  .sched-board :global(.hcell) { padding: .4rem .55rem; border-left: 3px solid transparent; font: .74rem/1.45 var(--font-sans); min-width: 0; }
  .sched-board :global(.hcell code) { display: block; font: .72rem/1.4 var(--font-mono); background: none; padding: 0; overflow-wrap: anywhere; color: var(--color-text); }
  .sched-board :global(.hcell .out) { display: block; color: var(--color-text-secondary); }
  .sched-board :global(.hcell.st-ok), .sched-board :global(.hcell.st-refused), .sched-board :global(.hcell.st-error), .sched-board :global(.hcell.st-wait) { background: var(--color-surface); border-left-color: var(--color-rule-strong); }
  .sched-board :global(.hcell.st-wait) { border-left-color: var(--gold); border-left-style: dashed; }
  .sched-board :global(.hcell.resumed code) { color: var(--color-text-secondary); }
  .sched-board :global(.hcell.st-error) { border-left-color: var(--coral); }
  .sched-board :global(.hcell.st-refused) { border-left-color: var(--teal); }
  .sched-board :global(.hcell.current) { outline: 2px solid var(--control); outline-offset: -2px; }
  .sched-board :global(.hcell.current .out) { color: var(--color-text); font-weight: 600; }
  .sched-board :global(.hcell.blocked) { border-left: 3px dashed var(--gold); color: var(--color-text-secondary); font-style: italic; }
  .sched-board :global(.hcell.start) { color: var(--color-text-secondary); }

  .sched-board :global(.committed) { min-width: 0; padding-top: .8rem; border-top: 1px solid var(--color-rule); }
  .sched-board :global(.tables) { display: flex; flex-wrap: wrap; gap: 0 1rem; align-items: flex-start; }
  .sched-board :global(.tables table.rows) { flex: 0 1 auto; max-width: 100%; }
  .sched-board :global(.panel-name) { margin: 0 0 .4rem; font: 600 .76rem/1.4 var(--font-sans); }
  .sched-board :global(table.rows) { display: table; width: auto; margin: 0 0 .7rem; border-collapse: collapse; font: .74rem/1.4 var(--font-sans); background: var(--color-surface); }
  .sched-board :global(table.rows caption) { caption-side: top; text-align: left; font: 600 .72rem var(--font-mono); padding: 0 0 .2rem; color: var(--color-text); }
  .sched-board :global(table.rows th), .sched-board :global(table.rows td) { padding: .25rem .4rem; border: 1px solid var(--color-rule); white-space: nowrap; }
  .sched-board :global(table.rows th) { font-weight: 600; background: var(--color-surface-alt); }
  .sched-board :global(table.rows abbr) { font-size: .62rem; text-decoration: none; color: var(--color-text-secondary); }
  .sched-board :global(table.rows .who) { color: var(--color-text-secondary); }
  .sched-board :global(.changed) { box-shadow: inset 0 -3px var(--gold); font-weight: 700; }
  .sched-board :global(tr.changed) { box-shadow: none; }
  .sched-board :global(tr.changed td) { box-shadow: inset 0 -3px var(--gold); }
  .sched-board :global(.rule-check) { list-style: none; margin: 0; padding: 0; font: .76rem/1.45 var(--font-sans); }
  .sched-board :global(.rule-check li) { padding: .35rem .5rem; margin: 0 0 .3rem; background: var(--color-surface); border-left: 3px solid var(--teal); }
  .sched-board :global(.rule-check li.broken) { border-left-color: var(--coral); font-weight: 600; }
  .sched-board :global(.rule-check .mark) { font-weight: 700; }

  .sched-explanation { margin: 1rem 0 .6rem; padding: .6rem .8rem; min-height: 3.2em; border-left: 3px solid var(--control); background: var(--color-surface); font: .9rem/1.55 var(--font-sans); }
  .sched-controls { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
  .sched .sched-count[data-step] { padding: 0 .3rem; margin: 0; border: 0; min-width: 3.5rem; font: .78rem var(--font-mono); color: var(--color-text-secondary); text-align: left; }
  .sched-hold { flex: 1 1 4rem; height: 3px; background: var(--color-rule); }
  .sched-hold span { display: block; width: 0; height: 100%; background: var(--control); }
  .sched-text { margin-top: .9rem; font: .82rem/1.55 var(--font-sans); }
  .sched-text summary { color: var(--control); }
  .sched-text ol { margin: .3rem 0 .8rem; padding-left: 1.3rem; }
  .sched figcaption { margin-top: .9rem; font: .82rem/1.55 var(--font-sans); color: var(--color-text-secondary); }

  @media (max-width: 420px) {
    .sched { padding: .7rem; }
    .sched-board :global(.hcell) { padding: .35rem .4rem; font-size: .7rem; }
    .sched-board :global(.hcell code) { font-size: .68rem; }
    .sched-board :global(table.rows th), .sched-board :global(table.rows td) { padding: .2rem .3rem; }
    .sched-board :global(table.rows) { font-size: .7rem; }
  }
</style>
