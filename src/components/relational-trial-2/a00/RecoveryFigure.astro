---
// Figure 6: three failures against three recovery mechanisms.
import { failures, mechanisms, recoveryMatrix } from './model.mjs';
import './figures.css';
interface Props { number: number; }
const { number } = Astro.props;
const word: Record<string, string> = { present: 'present', gone: 'missing', lost: 'missing', replica: 'only if the replica had received it', archived: 'only if its log had been archived' };
const verdict: Record<string, string> = { fits: 'The right tool', possible: 'Works, at a cost', wrong: 'The wrong tool' };
const first = 'deletion';
const cards = (failure: string) => Object.entries(mechanisms).map(([id, mech]) => ({ id, ...mech, ...(recoveryMatrix as any)[failure][id] }));
const data = JSON.stringify({ failures, cards: Object.fromEntries(Object.keys(failures).map(f => [f, cards(f)])), word, verdict });
---
<figure class="t2-figure" data-recovery-figure data-model={data} id={`figure-${number}`} aria-labelledby={`figure-${number}-title`}>
  <figcaption>
    <span class="t2-num">Figure {number}</span>
    <strong id={`figure-${number}-title`}>Which recovery fits which failure?</strong>
    <span class="t2-kind">Illustrative model. Crash recovery and a restore to an earlier point were run on PostgreSQL 18.6; replica promotion was not.</span>
  </figcaption>
  <fieldset class="t2-options">
    <legend>What went wrong</legend>
    {Object.entries(failures).map(([id, f]) => <label><input type="radio" name={`figure-${number}-failure`} value={id} checked={id === first} />{f.label}</label>)}
  </fieldset>
  <p class="t2-happened" data-happened aria-live="polite">{failures[first].happened}</p>
  <div class="t2-cards" data-cards>
    {cards(first).map(card => <div class="t2-card" data-verdict={card.verdict}>
      <p class="t2-card-title">{card.label}</p>
      <p class="how">{card.how}</p>
      <dl><dt>Order 101</dt><dd>{word[card.order101]}</dd><dt>Order 103</dt><dd>{word[card.order103]}</dd></dl>
      <p class="verdict">{verdict[card.verdict]}</p>
      <p class="why">{card.note}</p>
    </div>)}
  </div>
  <p class="t2-note">Order 101 is Mina’s paid order from 12 October; order 103 is her order placed at 10:15 on 20 October. The mistaken deletion of order 101 commits at 10:10. A replica here is a standby copy that applies the writer’s log on another machine.</p>
  <details>
    <summary>Read this figure as text</summary>
    {Object.entries(failures).map(([id, f]) => <Fragment>
      <p><strong>{f.label}.</strong> {f.happened}</p>
      <ul>{cards(id).map(card => <li>{card.label}: order 101 {word[card.order101]}, order 103 {word[card.order103]}. {verdict[card.verdict]}. {card.note}</li>)}</ul>
    </Fragment>)}
  </details>
</figure>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-recovery-figure]')) {
    if (root.dataset.ready) continue;
    root.dataset.ready = 'true';
    const model = JSON.parse(root.dataset.model!);
    const show = (failure: string) => {
      root.querySelector('[data-happened]')!.textContent = model.failures[failure].happened;
      root.querySelectorAll<HTMLElement>('.t2-card').forEach((el, i) => {
        const card = model.cards[failure][i];
        el.dataset.verdict = card.verdict;
        el.querySelectorAll('dd')[0].textContent = model.word[card.order101];
        el.querySelectorAll('dd')[1].textContent = model.word[card.order103];
        el.querySelector('.verdict')!.textContent = model.verdict[card.verdict];
        el.querySelector('.why')!.textContent = card.note;
      });
    };
    root.querySelectorAll<HTMLInputElement>('.t2-options input').forEach(input => input.addEventListener('change', () => show(input.value)));
  }
</script>
