---
// A stepped figure from scenes.mjs, driven by the shared stepper.
import { scenes } from './scenes.mjs';
import { renderFrame, frameText } from './render.mjs';
import './figures.css';
interface Props { scene: 'separate' | 'due' | 'race' | 'lost'; number: number; }
const { scene, number } = Astro.props;
const config = scenes[scene];
const options = config.options.length ? config.options : [{ value: '', label: '' }];
const firstOption = options[0].value;
const frames = config.frames(firstOption);
const first = frames[0];
const name = `figure-${number}-option`;
const queries = (config as { queries?: Record<string, string> }).queries;
---
<figure class="t2-figure" data-shop-figure data-scene={scene} id={`figure-${number}`} aria-labelledby={`figure-${number}-title`}>
  <figcaption>
    <span class="t2-num">Figure {number}</span>
    <strong id={`figure-${number}-title`}>{config.title}</strong>
    <span class="t2-kind">{config.kind}</span>
  </figcaption>
  {config.options.length > 0 && <fieldset class="t2-options">
    <legend>{config.optionLabel}</legend>
    {config.options.map((option, i) => <label><input type="radio" name={name} value={option.value} checked={i === 0} />{option.label}</label>)}
  </fieldset>}
  {queries && <pre class="t2-query" data-query><code>{queries[firstOption]}</code></pre>}
  <p class="t2-explanation" data-explanation data-live aria-live="polite">{first.explanation}</p>
  <div class="t2-frame" data-live data-frame set:html={renderFrame(first)} />
  <div class="t2-transport" role="group" aria-label={`Figure ${number} steps`}>
    <button type="button" data-play>Play</button>
    <button type="button" data-back aria-disabled="true">Back</button>
    <button type="button" data-next>Next</button>
    <button type="button" data-reset>Reset</button>
    <span class="t2-count" data-step>1 / {frames.length}</span>
    <span class="t2-hold" data-hold aria-hidden="true"><span></span></span>
  </div>
  <p class="t2-note">{config.note}</p>
  <details>
    <summary>Read this figure as text</summary>
    {options.map(option => <Fragment>
      {option.label && <p><strong>{config.optionLabel}: {option.label}</strong></p>}
      {queries && <pre class="t2-query"><code>{queries[option.value]}</code></pre>}
      <ol>{config.frames(option.value).map(frame => <li>{frameText(frame)}</li>)}</ol>
    </Fragment>)}
  </details>
</figure>
<script>
  import { scenes } from './scenes.mjs';
  import { renderFrame } from './render.mjs';
  import { stepper } from '../../figures/stepper.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('[data-shop-figure]')) {
    if (root.dataset.ready) continue;
    root.dataset.ready = 'true';
    const scene = scenes[root.dataset.scene as keyof typeof scenes];
    const option = () => root.querySelector<HTMLInputElement>('.t2-options input:checked')?.value ?? '';
    let frames = scene.frames(option());
    const explanation = root.querySelector<HTMLElement>('[data-explanation]')!;
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const draw = (step: number) => {
      explanation.textContent = frames[step].explanation;
      frame.innerHTML = renderFrame(frames[step]);
    };
    const player = stepper(root, { steps: () => frames.length, draw });
    const query = root.querySelector<HTMLElement>('[data-query] code');
    root.querySelectorAll('.t2-options input').forEach(input => input.addEventListener('change', () => {
      frames = scene.frames(option());
      const queries = (scene as { queries?: Record<string, string> }).queries;
      if (query && queries) query.textContent = queries[option()];
      player.render();
    }));
  }
</script>
