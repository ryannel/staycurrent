---
// Figure 2: the shop's five tables, their keys drawn as links, and the rows a
// chosen order reaches through those keys.
import { schemaTables } from './model.mjs';
import { keysView } from './scenes.mjs';
import { renderTable } from './render.mjs';
import './figures.css';
interface Props { number: number; }
const { number } = Astro.props;
const view = keysView(103);

const W = 170, HEAD = 26, ROW = 22;
const boxHeight = (t: typeof schemaTables[number]) => HEAD + t.columns.length * ROW;
type Place = Record<string, [number, number]>;
const rowY = (place: Place, table: string, column: string) => {
  const t = schemaTables.find(x => x.name === table)!;
  return place[table][1] + HEAD + t.columns.findIndex(c => c.name === column) * ROW + ROW / 2;
};
const head = (x: number, y: number, dir: 1 | -1) => `M${x},${y} l${-8 * dir},-4.5 v9 z`;

function drawing(place: Place, links: { d: string; tip: [number, number, 1 | -1] }[], width: number) {
  const height = Math.max(...schemaTables.map(t => place[t.name][1] + boxHeight(t))) + 10;
  const boxes = schemaTables.map(t => {
    const [x, y] = place[t.name];
    const rows = t.columns.map((c, i) => `<text x="${x + 8}" y="${y + HEAD + i * ROW + 15}">${c.name}</text>${c.key ? `<text class="keymark" x="${x + W - 8}" y="${y + HEAD + i * ROW + 15}" text-anchor="end">${c.key}</text>` : ''}`).join('');
    return `<rect class="box" x="${x}" y="${y}" width="${W}" height="${boxHeight(t)}" rx="4"/><rect class="head" x="${x}" y="${y}" width="${W}" height="${HEAD}" rx="4"/><text class="title" x="${x + 8}" y="${y + 17}">${t.name}</text>${rows}`;
  }).join('');
  const lines = links.map(l => `<path class="link" d="${l.d}"/><path class="arrow" d="${head(...l.tip)}"/>`).join('');
  return { svg: boxes + lines, width, height };
}

// Wide: customers | orders | payments above, order_items | products below.
const wp: Place = { customers: [10, 10], orders: [245, 10], payments: [480, 10], order_items: [245, 170], products: [480, 170] };
const wide = drawing(wp, [
  { d: `M245,${rowY(wp, 'orders', 'customer_id')} H213 V${rowY(wp, 'customers', 'customer_id')} H182`, tip: [181, rowY(wp, 'customers', 'customer_id'), -1] },
  { d: `M480,${rowY(wp, 'payments', 'order_id')} H446 V${rowY(wp, 'orders', 'order_id')} H417`, tip: [416, rowY(wp, 'orders', 'order_id'), -1] },
  { d: `M415,${rowY(wp, 'order_items', 'order_id')} H446 V${rowY(wp, 'payments', 'order_id')}`, tip: [416, rowY(wp, 'orders', 'order_id'), -1] },
  { d: `M415,${rowY(wp, 'order_items', 'product_id')} H462 V${rowY(wp, 'products', 'product_id')} H478`, tip: [479, rowY(wp, 'products', 'product_id'), 1] },
], 660);

// Narrow: one column, links down the sides.
const np: Place = { customers: [70, 8], orders: [70, 98], payments: [70, 232], order_items: [70, 366], products: [70, 522] };
const narrow = drawing(np, [
  { d: `M70,${rowY(np, 'orders', 'customer_id')} H44 V${rowY(np, 'customers', 'customer_id')} H68`, tip: [69, rowY(np, 'customers', 'customer_id'), 1] },
  { d: `M240,${rowY(np, 'payments', 'order_id')} H272 V${rowY(np, 'orders', 'order_id')} H242`, tip: [241, rowY(np, 'orders', 'order_id'), -1] },
  { d: `M240,${rowY(np, 'order_items', 'order_id')} H272 V${rowY(np, 'payments', 'order_id')}`, tip: [241, rowY(np, 'orders', 'order_id'), -1] },
  { d: `M70,${rowY(np, 'order_items', 'product_id')} H44 V${rowY(np, 'products', 'product_id')} H68`, tip: [69, rowY(np, 'products', 'product_id'), 1] },
], 310);
---
<figure class="t2-figure" data-keys-figure id={`figure-${number}`} aria-labelledby={`figure-${number}-title`}>
  <figcaption>
    <span class="t2-num">Figure {number}</span>
    <strong id={`figure-${number}-title`}>The shop’s tables and the keys that connect them</strong>
    <span class="t2-kind">The schema and rows used throughout this article. Row values were loaded and joined on PostgreSQL 18.6.</span>
  </figcaption>
  <div class="t2-schema">
    <svg class="wide" viewBox={`0 0 ${wide.width} ${wide.height}`} role="img" aria-label="Five tables. orders.customer_id refers to customers. payments.order_id and order_items.order_id refer to orders. order_items.product_id refers to products." set:html={wide.svg} />
    <svg class="narrow" viewBox={`0 0 ${narrow.width} ${narrow.height}`} role="img" aria-label="Five tables. orders.customer_id refers to customers. payments.order_id and order_items.order_id refer to orders. order_items.product_id refers to products." set:html={narrow.svg} />
  </div>
  <fieldset class="t2-options">
    <legend>Follow the keys from</legend>
    {[101, 102, 103].map(id => <label><input type="radio" name={`figure-${number}-order`} value={id} checked={id === 103} />Order {id}</label>)}
  </fieldset>
  <p class="t2-summary" data-summary aria-live="polite">{view.summary}</p>
  <div class="t2-tables" data-tables set:html={view.tables.map(renderTable).join('')} />
  <p class="t2-note">PK marks a primary key, FK a foreign key; each arrow runs from a foreign key to the key it refers to. The order_items key is the pair (order_id, line_no). Stock is shown after order 103. Times are UTC.</p>
  <details>
    <summary>Read this figure as text</summary>
    <p>Five tables. customers is keyed by customer_id; orders by order_id, with customer_id referring to customers; payments by payment_id, with order_id referring to orders; order_items by the pair order_id and line_no, with order_id referring to orders and product_id referring to products; products by product_id.</p>
    <ol>{[101, 102, 103].map(id => <li>{keysView(id).summary}</li>)}</ol>
    <p>Customer 3, Edda Berg, has no orders, so no orders row refers to her.</p>
  </details>
</figure>
<script>
  import { keysView } from './scenes.mjs';
  import { renderTable } from './render.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('[data-keys-figure]')) {
    if (root.dataset.ready) continue;
    root.dataset.ready = 'true';
    root.querySelectorAll<HTMLInputElement>('.t2-options input').forEach(input => input.addEventListener('change', () => {
      const view = keysView(Number(input.value));
      root.querySelector('[data-summary]')!.textContent = view.summary;
      root.querySelector('[data-tables]')!.innerHTML = view.tables.map(renderTable).join('');
    }));
  }
</script>
