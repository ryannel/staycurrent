---
interface Props { kind:'guard'|'replay'|'batch'; number:number; title:string; caption:string; }
const {kind,number,title,caption} = Astro.props;
---
<figure class="wf" data-writes-figure={kind} aria-labelledby={`wf-${kind}-title`}>
  <figcaption id={`wf-${kind}-title`}><span>Figure {number}</span> {title}</figcaption>
  <div class="wf-frame">
    {kind === 'guard' && <label class="wf-option">P7’s price before the statement <select data-option aria-label="P7’s price before the statement"><option value="20">20.00</option><option value="22">22.00</option></select></label>}
    {kind === 'replay' && <label class="wf-option">Repeated change <select data-option aria-label="Repeated change"><option value="replace">Replace price with 22.00</option><option value="add">Add 2 to stock</option></select></label>}
    <div data-scene data-live></div>
    <p class="wf-explanation" data-explanation data-live aria-live="polite"></p>
    <div class="wf-controls" role="group" aria-label={`Figure ${number} controls`}>
      <button type="button" data-play>Play</button><button type="button" data-back>Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step></span>
    </div>
    <div class="wf-hold" data-hold aria-hidden="true"><span></span></div>
  </div>
  <p class="wf-caption">{caption}</p>
  <details><summary>All steps as text</summary>
    {kind === 'guard' && <ol><li>Start with P3 at 4.50, P7 at the selected price, and P9 at 35.00.</li><li>The product key selects only P7.</li><li>The old-price condition admits P7 only if its price is 20.00.</li><li>If admitted, P7 is set to 22.00 and returned. Otherwise no row changes and no row returns.</li></ol>}
    {kind === 'replay' && <ol><li>P7 begins at price 20.00 and stock 1.</li><li>The first replacement gives price 22.00; the first addition gives stock 3.</li><li>Repeating replacement leaves price 22.00. Repeating addition gives stock 5.</li></ol>}
    {kind === 'batch' && <ol><li>Receive B17: P7 at 22.00; new P11 at 8.00; P3 at −4.50; P9 at 36.00.</li><li>Reject row 3 for a negative price; the other three rows are pending.</li><li>Commit P7 and P11 with applied records for rows 1 and 2.</li><li>Stop before row 4’s chunk starts: two applied, one rejected, one pending.</li><li>Resume pending row 4; commit P9 at 36.00 with its applied record.</li><li>Replay B17: no pending rows, no further writes. Three applied plus one rejected account for all four source rows.</li></ol>}
  </details>
</figure>
<script>
import { stepper } from '../figures/stepper.mjs';
import { sourceRows, batchStates, batchStatus } from './models.mjs';
const table = (caption,heads,rows) => `<div class="wf-table"><table><caption>${caption}</caption><thead><tr>${heads.map(x=>`<th scope="col">${x}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map(x=>`<td>${x}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
const chip = (text,active=false) => `<span class="wf-chip${active?' wf-active':''}">${text}</span>`;
for (const root of document.querySelectorAll('[data-writes-figure]')) {
  const kind = root.getAttribute('data-writes-figure');
  const scene = root.querySelector('[data-scene]');
  const explanation = root.querySelector('[data-explanation]');
  const option = root.querySelector('select');
  const player = stepper(root, {steps:()=>kind==='batch'?6:kind==='guard'?4:3, draw(step) {
    if (kind==='guard') {
      const before = option.value==='20'?'20.00':'22.00';
      const matches = before==='20.00';
      scene.innerHTML = `<div class="wf-path">${chip('product_id = P7',step>=1)}<span>and</span>${chip('price = 20.00',step>=2)}<span>→</span>${chip('SET price = 22.00',step===3&&matches)}</div>` + table('products · after the selected step',['Key','Price','Eligibility'],[
        ['P3','4.50',step?'Different key':'—'],['P7',step===3&&matches?'22.00':before,step<2?(step?'Key matches':'—'):(matches?(step===3?'Matched before SET':'Both conditions match'):'Old price differs')],['P9','35.00',step?'Different key':'—']
      ]) + `<div class="wf-result">RETURNING: ${step===3?(matches?'P7 · 22.00 (1 row)':'0 rows'):'statement not finished'}</div>`;
      explanation.textContent = [
        'The statement proposes 22.00 for P7, provided P7 still has the expected price of 20.00. Other products have different keys.',
        'The key condition narrows the change to P7. A key alone says which product, but places no condition on its current price.',
        matches?'P7 also has price 20.00. Both conditions are true, so it is eligible for the change.':'P7 already has price 22.00. The old-price condition is false, so it is not eligible.',
        matches?'P7 changes from 20.00 to 22.00 and RETURNING gives its new price. Stock and agreed order-line prices are untouched.':'The statement succeeds with no update and no returned row. A later read may help explain why, but zero alone does not identify the failed condition.'
      ][step];
    } else if (kind==='replay') {
      const add = option.value==='add';
      const values = add?['1','3','5']:['20.00','22.00','22.00'];
      scene.innerHTML = `<p class="wf-stage">${['Before the first change','After one application','After the same change again'][step]}</p><div class="wf-path">${chip(add?'stock = stock + 2':'price = 22.00',true)}<span>→</span>${chip('P7',true)}</div><div class="wf-pair"><div class="wf-record"><strong>Catalogue price</strong><b>${add?'20.00':values[step]}</b><span>${add?'untouched':'assigned value'}</span></div><div class="wf-record"><strong>Stock</strong><b>${add?values[step]:'1'}</b><span>${add?'stored value + delta':'untouched'}</span></div></div><p class="wf-result">Order 103 / line 1: agreed unit price 20.00 throughout</p>`;
      explanation.textContent = add ? ['This separate example starts with one mug in stock. The proposed change adds two; it is not the catalogue feed.', 'The addition reads the stored stock of 1 and writes 3. The delta has been applied once.', 'The repeated addition reads 3 and writes 5. The same product key does not identify whether this delivery was already counted.'][step] : ['P7 starts at catalogue price 20.00, stock 1. The change assigns a new catalogue price.', 'The assignment writes 22.00. Stock stays 1 and the existing order line keeps its agreement.', 'Repeating the same assignment leaves the price at 22.00. PostgreSQL can still count it as an update. This says nothing about whether a later, different price should be overwritten.'][step];
    } else {
      const state=batchStates[step];
      scene.innerHTML = `<p class="wf-stage">${state.title}</p>` + table('B17 · immutable source and durable progress',['Row / product','Proposed price','Recorded state'],sourceRows.map(r=>[`${r.row} · ${r.id}`,r.price,`<span class="wf-status wf-${batchStatus(state,r.row).toLowerCase()}">${batchStatus(state,r.row)}</span>${r.row===3&&state.validated?'<small>negative price</small>':''}`])) + `<div class="wf-path">${chip('4 received',true)}<span>=</span>${chip(`${state.applied.length} applied`)}<span>+</span>${chip(`${state.validated?1:0} rejected`)}<span>+</span>${chip(`${state.validated?3-state.applied.length:4} ${state.validated?'pending':'unvalidated'}`)}</div>` + table('products · committed catalogue',['Product','Price','Stock'],[
        ['P3','4.50','12'],['P7',state.applied.includes(1)?'22.00':'20.00','1'],['P9',state.applied.includes(4)?'36.00':'35.00','4'],...(state.applied.includes(2)?[['P11','8.00','0']]:[])
      ]);
      explanation.textContent=state.note;
    }
  }});
  option?.addEventListener('change',()=>player.render());
}
</script>
<style is:global>
.wf { margin:2rem 0; font:.85rem/1.6 var(--font-sans); }
.wf > figcaption { margin-bottom:.7rem; font:1.08rem/1.5 var(--font-serif); }
.wf > figcaption > span { font:.65rem var(--font-sans); text-transform:uppercase; letter-spacing:.1em; color:var(--color-text-secondary); margin-right:.5rem; }
.wf-frame { border:1px solid var(--color-rule-strong); background:var(--color-surface-alt); padding:1rem; }
.wf-option { display:flex; align-items:center; flex-wrap:wrap; gap:.6rem; margin-bottom:1rem; }
.wf select,.wf button { color:var(--color-text); background:var(--color-surface); border:1px solid var(--color-rule-strong); border-radius:3px; padding:.45rem .65rem; font:inherit; }
.wf button { cursor:pointer; min-height:2.6rem; }
.wf button[aria-disabled="true"] { color:var(--color-text-secondary); cursor:default; }
.wf button:focus-visible,.wf select:focus-visible,.wf summary:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
.wf-path { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; margin:1rem 0; font:.78rem/1.6 var(--font-mono); }
.wf-chip { border:1px solid var(--color-rule-strong); padding:.3rem .45rem; border-radius:3px; }
.wf-active { border-color:var(--color-accent); box-shadow:inset 3px 0 var(--color-accent); }
.wf-table { overflow-x:auto; }
.wf table { display:table !important; border-collapse:collapse; width:100%; margin:.5rem 0 1rem !important; font:.8rem/1.6 var(--font-sans); }
.wf table caption { text-align:left; color:var(--color-text-secondary); margin-bottom:.4rem; }
.wf th,.wf td { text-align:left; padding:.5rem .35rem; border-bottom:1px solid var(--color-rule-strong); vertical-align:top; }
.wf th { font-weight:600; }
.wf small { display:block; color:var(--color-text-secondary); }
.wf-stage { font-weight:600; margin:0 0 .8rem !important; font-family:var(--font-sans); font-size:.95rem !important; }
.wf-result { padding:.7rem; border:1px solid var(--color-rule-strong); font:.8rem/1.6 var(--font-mono); margin:.8rem 0 !important; }
.wf-explanation { border-left:3px solid var(--color-accent); padding-left:.8rem; margin:1.2rem 0 !important; font:.85rem/1.7 var(--font-sans) !important; min-height:5.6rem; }
.wf-controls { display:flex; flex-wrap:wrap; gap:.4rem; align-items:center; }
.wf-controls > span { margin-left:auto; color:var(--color-text-secondary); font-size:.75rem; }
.wf-hold { height:3px; margin-top:.8rem; }
.wf-hold span { display:block; width:0; height:100%; background:var(--color-accent); }
.wf-caption { margin:.7rem 0 !important; color:var(--color-text-secondary); font:.8rem/1.65 var(--font-sans) !important; }
.wf details { font:.8rem/1.7 var(--font-sans); }
.wf summary { cursor:pointer; }
.wf details ol { padding-left:1.5rem; }
.wf-pair { display:grid; grid-template-columns:1fr 1fr; gap:.7rem; }
.wf-record { display:flex; flex-direction:column; gap:.3rem; border:1px solid var(--color-rule-strong); padding:.8rem; }
.wf-record b { font:1.8rem/1.5 var(--font-mono); }
.wf-record span { color:var(--color-text-secondary); }
.wf-status { font-weight:600; }
.wf-applied { color:var(--color-accent); }
@media(max-width:500px) { .wf-frame { padding:.7rem; } .wf th,.wf td { padding:.45rem .25rem; font-size:.75rem; } .wf-option select { width:100%; } .wf-explanation { min-height:0; } }
</style>
