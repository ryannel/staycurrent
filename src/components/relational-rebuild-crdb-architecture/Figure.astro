---
import MotionFigure from '../relational-motion/MotionFigure.astro';
import { models, framesFor } from './models.mjs';
import './figures.css';
const { kind, number, title } = Astro.props;
const model = models[kind];
const frames = framesFor(kind);
---
{kind !== 'keys' ? <MotionFigure collection="distributed/cockroach" kind={kind} number={number} id={`cr-title-${kind}`} /> : <><figure class="cr-figure wide" data-cr-model={kind} aria-labelledby={`cr-title-${kind}`}>
  <figcaption id={`cr-title-${kind}`}><span>Figure {number}</span> {title}</figcaption>
  <div class="cr-paper">
    <div class="cr-scene" data-scene data-live set:html={frames[0].html} />
    <p class="cr-explanation" data-explanation data-live aria-live="polite">{frames[0].explanation}</p>
  </div>
  {!model.static && <div class="cr-controls" role="group" aria-label={`Figure ${number} controls`}>
    {model.options && <label>Demand <select data-choice aria-label={`Demand for figure ${number}`}>{model.options.map(o => <option value={o.value}>{o.label}</option>)}</select></label>}
    <div class="cr-buttons"><button type="button" data-play>Play</button><button type="button" data-back aria-disabled="true">Back</button><button type="button" data-next>Next</button><button type="button" data-reset>Reset</button><span data-step>1 / {frames.length}</span></div>
    <div class="cr-hold" data-hold aria-hidden="true"><span /></div>
  </div>}
  <p class="cr-note">{model.note}</p>
  <details class="cr-text"><summary>Figure as text</summary><ol>{frames.map(f => <li>{f.explanation}</li>)}</ol>{model.options && <p>With all demand on P7, the same boundary and placement changes leave all that demand on the right range. There is still only one P7 key.</p>}</details>
</figure>
</>}
<script>
  import { stepper } from '../figures/stepper.mjs';
  import { framesFor } from './models.mjs';
  document.querySelectorAll('[data-cr-model]').forEach(root => {
    const kind = root.getAttribute('data-cr-model');
    if (kind === 'keys') return;
    const choice = root.querySelector('select');
    const scene = root.querySelector('[data-scene]');
    const explanation = root.querySelector('[data-explanation]');
    let frames = framesFor(kind, choice?.value);
    const player = stepper(root, { steps: () => frames.length, draw: step => {
      scene.innerHTML = frames[step].html;
      explanation.textContent = frames[step].explanation;
    }});
    choice?.addEventListener('change', () => { frames = framesFor(kind, choice.value); player.render(); });
  });
</script>
