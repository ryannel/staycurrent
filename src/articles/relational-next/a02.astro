       shipped_at = NULL AS wrong_test
FROM orders WHERE order_id IN (101, 102)
ORDER BY order_id;
-- 101 | true  | NULL
-- 102 | false | NULL
SELECT 5 / 2 AS integer_result, 5::numeric / 2 AS decimal_result;
-- 2 | 2.5000000000000000`;
const having = `SELECT order_id, SUM(amount) AS order_value
FROM order_lines
GROUP BY order_id
HAVING SUM(amount) >= 30
ORDER BY order_id;
-- 101: 30; 103: 40; 104: 50; 105: 60`;
const fanout = `SELECT o.order_id, SUM(l.amount) AS order_value, SUM(p.amount) AS paid
FROM orders AS o
JOIN order_lines AS l ON l.order_id = o.order_id
JOIN payments AS p ON p.order_id = o.order_id
WHERE o.order_id = 101
GROUP BY o.order_id;
-- Wrong: 101 | 60 | 30. Expected: 101 | 30 | 15.`;
