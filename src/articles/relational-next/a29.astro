npm install --ignore-scripts pg@8.23.1 node-pg-migrate@9.0.0
# Save the downloaded rehearse.mjs here. Node.js 22 or later is required.
export PG_URL='postgresql://YOUR_ROLE@YOUR_HOST:YOUR_PORT/postgres'
EVIDENCE=./schema-evidence.json node rehearse.mjs`;
