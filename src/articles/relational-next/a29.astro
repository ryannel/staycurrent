       clock_timestamp() - xact_start AS transaction_age,
       wait_event_type, wait_event, pg_blocking_pids(pid) AS blockers
FROM pg_stat_activity
WHERE datname = current_database();

SELECT pid, mode, granted
FROM pg_locks
WHERE relation = 'orders'::regclass;`;
const bounded=`BEGIN;
SET LOCAL lock_timeout = '250ms';
SET LOCAL statement_timeout = '5s';
ALTER TABLE orders ADD COLUMN amount_v2 bigint;
COMMIT;
-- On an error inside BEGIN: ROLLBACK before reusing the session.`;
const migration=`// 1760000000000-expand.cjs
exports.up = pgm => {
  pgm.sql("SET LOCAL lock_timeout = '250ms'");
  pgm.sql("SET LOCAL statement_timeout = '5s'");
  pgm.sql('ALTER TABLE orders ADD COLUMN amount_v2 bigint');
};

// Separate migration: concurrent operations cannot use the default transaction.
// Configure session timeouts on the connection, not SET LOCAL here.
exports.up = pgm => {
  pgm.noTransaction();
  pgm.sql('CREATE INDEX CONCURRENTLY orders_amount_v2 ON orders(amount_v2)');
};`;
const check=`-- Separate short installation transaction; writers already accept this rule.
ALTER TABLE orders ADD CONSTRAINT orders_amount_ok
  CHECK (amount >= 0) NOT VALID;

-- After repairing historical violations; separately bounded transaction:
ALTER TABLE orders VALIDATE CONSTRAINT orders_amount_ok;

SELECT conname, convalidated, conenforced, pg_get_constraintdef(oid)
FROM pg_constraint
WHERE conrelid = 'orders'::regclass;`;
const indexes=`-- Each concurrent command is a top-level statement, outside BEGIN.
CREATE UNIQUE INDEX CONCURRENTLY orders_ref_uq ON orders(reference);

SELECT indexrelid::regclass, indisvalid, indisready, indislive,
       pg_get_indexdef(indexrelid)
FROM pg_index WHERE indrelid = 'orders'::regclass;

-- Only after the intended eligible index is valid:
ALTER TABLE orders ADD CONSTRAINT orders_reference_key
  UNIQUE USING INDEX orders_ref_uq;

SELECT conname, conindid::regclass, pg_get_constraintdef(oid)
FROM pg_constraint WHERE conrelid = 'orders'::regclass;`;
const staged=`-- Each ALTER is separately bounded and committed.
ALTER TABLE orders ADD COLUMN amount_v2 bigint;
-- Gate: every writer maintains amount_v2 from the current authoritative amount.
-- Gate: resumable backfill and reconciliation complete under that writer rule.
ALTER TABLE orders ADD CONSTRAINT orders_v2_ok
  CHECK (amount_v2 IS NOT NULL AND amount_v2 >= 0) NOT VALID;
ALTER TABLE orders VALIDATE CONSTRAINT orders_v2_ok;
-- Outside a transaction block:
CREATE INDEX CONCURRENTLY orders_amount_v2 ON orders(amount_v2);

-- A reconciliation query; its zero result must remain stable under writers.
SELECT count(*) AS mismatches FROM orders
WHERE amount_v2 IS DISTINCT FROM amount::bigint;`;
