---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import '../styles/explorables.css';
import '../styles/object-storage.css';
const { frontmatter } = Astro.props;
const { title, description, lesson } = frontmatter;
---
<Base title={title} description={description}>
 <article class="visual-essay object-article">
  <header class="essay-header"><p class="eyebrow">Object storage · Amazon S3</p><h1>{title}</h1><TitleLine type="Object storage deep dive"><span>Sources checked 16 October 2026</span><a href="/learn/databases/object-storage/">The collection ↗</a></TitleLine></header>
  <ArticleBody><slot /></ArticleBody>
  {lesson && <aside class="practice-note"><h2>Try the idea</h2><p><a href={`/learn/databases/object-storage/sandbox/?lesson=${lesson}`}>Open the matching sandbox lesson →</a></p><p>The sandbox executes a small local teaching model. It does not call Amazon S3. You can change requests, inspect state and reset the lesson without an account.</p></aside>}
  <nav class="series-reading" aria-label="Continue reading"><a href="/learn/databases/object-storage/#collection">Browse the object-storage collection →</a>{Astro.url.pathname !== '/learn/databases/object-storage/practice/' && <a href="/learn/databases/object-storage/practice/">Try requests against real S3 →</a>}</nav>
 </article>
</Base>
