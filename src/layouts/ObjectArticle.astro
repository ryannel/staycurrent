---
import Base from './Base.astro';
import '../styles/explorables.css';
import '../styles/object-storage.css';
const { frontmatter, headings = [] } = Astro.props;
const { title, description, lesson } = frontmatter;
---
<Base title={title} description={description}>
 <article class="visual-essay object-article">
  <header class="essay-header"><p class="eyebrow">Object storage · Amazon S3</p><h1>{title}</h1><div class="essay-meta"><span>Sources checked 16 October 2026</span><a href="/learn/databases/object-storage/">The collection ↗</a></div></header>
  <nav class="article-contents" aria-label="In this article"><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
  <slot />
  {lesson && <aside class="practice-note"><h2>Try the idea</h2><p><a href={`/learn/databases/object-storage/sandbox/?lesson=${lesson}`}>Open the matching sandbox lesson →</a></p><p>The sandbox executes a small local teaching model. It does not call Amazon S3. You can change requests, inspect state and reset the lesson without an account.</p></aside>}
  <nav class="series-reading" aria-label="Continue reading"><a href="/learn/databases/object-storage/#collection">Browse the object-storage collection →</a><a href="/learn/databases/object-storage/practice/">Try requests against real S3 →</a></nav>
 </article>
</Base>
