---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import StorageDefs from '../components/explainers/storage/StorageDefs.astro';
import '../styles/explorables.css';
import '../styles/relational-design.css';
import '../styles/relational-drafts.css';
import registry from '../../docs/article-work/relational-rewrite-2026-10-19/registry.json';
const { frontmatter } = Astro.props;
const html = await Astro.slots.render('default');
const components = import.meta.glob('../components/explainers/{indexes,storage}/*.astro', { eager: true, import: 'default' });
const pieces: any[] = [];
const marker = /<div\s+([^>]*data-relational-component="[^"]+"[^>]*)>\s*<\/div>/g;
let from = 0;
for (const match of html.matchAll(marker)) {
  pieces.push({ html: html.slice(from, match.index) });
  const attributes = Object.fromEntries([...match[1].matchAll(/data-([\w-]+)="([^"]*)"/g)].map(a => [a[1], a[2].replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')]));
  const name = attributes['relational-component'];
  const component = components[`../components/explainers/${name}.astro`];
  if (!component) throw new Error(`Unknown relational review component: ${name}`);
  delete attributes['relational-component'];
  const props = Object.fromEntries(Object.entries(attributes).map(([key, value]) => [key.replace(/-([a-z])/g, (_, c) => c.toUpperCase()), value === 'true' ? true : value === 'false' ? false : key === 'number' ? Number(value) : value]));
  pieces.push({ component, props });
  from = match.index! + match[0].length;
}
pieces.push({ html: html.slice(from) });
const parent = registry.find(p => p.id === frontmatter.companionOf);
const type = ['Introduction','Deep dive','Worked example','Assessment'].includes(frontmatter.type) ? frontmatter.type : 'Deep dive';
---
<Base title={frontmatter.title} description={frontmatter.description}>
 <article class="visual-essay relational-design relational-draft storage-essay">
  {html.includes('storage/StepFigure') && <StorageDefs />}
  <header class="essay-header">
   <p class="eyebrow">Relational databases · Draft review</p>
   <h1>{frontmatter.title}</h1>
   <TitleLine type={type} version={frontmatter.version} />
   {parent && <p class="draft-parent">Companion to <a href={parent.preview}>{parent.title}</a>.</p>}
  </header>
  <p class="draft-status" data-pagefind-ignore>{frontmatter.status === 'ready-as-draft' ? 'This is a reviewed replacement draft.' : 'This replacement draft is being reviewed.'} <a href="/review/relational/">See the draft collection</a>.</p>
  <ArticleBody depth={3}>{pieces.map(piece => piece.component ? <piece.component {...piece.props} /> : <Fragment set:html={piece.html} />)}</ArticleBody>
 </article>
</Base>
<script>
 for (const figure of document.querySelectorAll<HTMLElement>('[data-step-figure]')) {
  const states = [...figure.querySelectorAll<HTMLElement>('[data-step]')];
  const previous = figure.querySelector<HTMLButtonElement>('[data-step-prev]');
  const next = figure.querySelector<HTMLButtonElement>('[data-step-next]');
  const reset = figure.querySelector<HTMLButtonElement>('[data-step-reset]');
  const output = figure.querySelector<HTMLOutputElement>('[data-step-count]');
  if (!states.length || !previous || !next || !reset || !output) continue;
  let index = 0;
  output.setAttribute('aria-live', 'polite');
  const show = () => {
   states.forEach((state, i) => state.hidden = i !== index);
   previous.disabled = index === 0;
   next.disabled = index === states.length - 1;
   output.textContent = `Step ${index + 1} of ${states.length}`;
  };
  previous.addEventListener('click', () => { index = Math.max(0, index - 1); show(); });
  next.addEventListener('click', () => { index = Math.min(states.length - 1, index + 1); show(); });
  reset.addEventListener('click', () => { index = 0; show(); });
  figure.classList.add('steps-active');
  show();
 }
</script>
