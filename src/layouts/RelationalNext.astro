---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import '../styles/explorables.css';
import '../styles/relational-drafts.css';
import {
  relationalNextArticles,
  relationalNextHome,
  relationalNextAvailable,
  relationalNextAncestors,
  relationalNextChildren,
  type RelationalNextArticle,
} from '../lib/relational-next';

interface Props { article: RelationalNextArticle }
const { article } = Astro.props;
const available = relationalNextAvailable(article.id);
const ancestors = relationalNextAncestors(article);
const children = relationalNextChildren(article);
const completed = relationalNextArticles.filter(entry => relationalNextAvailable(entry.id)).length;
---
<Base title={article.title} description={`New relational collection draft: ${article.title}. Available for editorial review.`}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <article class="visual-essay relational-draft relational-next" data-pagefind-ignore>
    <header class="essay-header">
      <p class="eyebrow">Relational databases · New draft review</p>
      <h1>{article.title}</h1>
      <TitleLine type={article.parent ? 'Deep dive' : 'Introduction'} />
    </header>
    <aside class="draft-status" aria-label="Draft status">
      <p><strong>{available ? 'Draft available' : 'Planned article'}</strong> · {completed} of {relationalNextArticles.length} drafts available.</p>
      <p>This collection is being written and reviewed. Draft availability does not mean review is complete. <a href={relationalNextHome}>See the new draft collection</a>.</p>
      {ancestors.length > 0 && <p class="draft-context">Read in context: {ancestors.map((ancestor, index) => <Fragment>{index > 0 && ' → '}{relationalNextAvailable(ancestor.id) ? <a href={ancestor.href}>{ancestor.title}</a> : <span>{ancestor.title} (planned)</span>}</Fragment>)}.</p>}
    </aside>
    {available ? <slot /> : <div class="planned-opening">
      <p>This article is planned for the new relational collection. Its draft will appear here when it is ready for reading.</p>
      <p>{article.brief}</p>
      <p>The planned sections below are not written yet.</p>
      <ul class="planned-sections">{article.sections.map(section => <li id={section.anchor}>{section.title} <small>Planned section</small></li>)}</ul>
    </div>}
    {children.length > 0 && <section class="draft-reading" aria-labelledby="contextual-reading">
      <h2 id="contextual-reading">{article.parent ? 'Continue into the detail' : 'Read the collection'}</h2>
      <p>{article.parent ? 'This article supplies the starting explanation. Choose a child article when its question becomes useful.' : 'Start with this introduction and read the parent articles before choosing their contextual detail.'} Available drafts are linked; planned articles are marked below.</p>
      <ul class="draft-tree">
        {children.map(child => <li>
          {relationalNextAvailable(child.id) ? <a href={child.href}>{child.title}</a> : <span>{child.title}</span>}
          <small>{relationalNextAvailable(child.id) ? 'Draft available' : 'Planned'}</small>
          {!article.parent && child.children.length > 0 && <ul>
            {relationalNextChildren(child).map(descendant => <li>
              {relationalNextAvailable(descendant.id) ? <a href={descendant.href}>{descendant.title}</a> : <span>{descendant.title}</span>}
              <small>{relationalNextAvailable(descendant.id) ? 'Draft available' : 'Planned'}</small>
            </li>)}
          </ul>}
        </li>)}
      </ul>
    </section>}
    {article.parent && <p class="draft-collection-link"><a href={relationalNextHome}>All articles in the new draft collection →</a></p>}
  </article>
</Base>
<style>
  .draft-status p { margin: .35rem 0; }
  .draft-context { font-size: .85rem; }
  .draft-reading { border-top: 1px solid var(--color-rule); padding-top: 1.5rem; }
  .draft-tree { padding-left: 1.25rem; }
  .draft-tree li { padding: .35rem 0; }
  .draft-tree ul { margin-top: .4rem; padding-left: 1.25rem; }
  .draft-tree small { display: inline-block; margin-left: .7rem; color: var(--color-text-secondary); font: .72rem var(--font-sans); }
  .draft-collection-link { margin-top: 3rem; font-size: .9rem; }
</style>
