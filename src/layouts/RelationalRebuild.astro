---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import AiTextDisclosure from '../components/editorial/AiTextDisclosure.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import RelationalRebuildNavigation from '../components/editorial/RelationalRebuildNavigation.astro';
import RelationalRebuildTree from '../components/editorial/RelationalRebuildTree.astro';
import { relationalRebuildHref, relationalRebuildLinks, relationalRebuildTree, splitRelationalRebuildSources, type RelationalRebuildState, type RelationalRebuildCollection } from '../lib/relational-rebuild';
import '../styles/explorables.css';
interface Props { entry: RelationalRebuildState; entries: RelationalRebuildState[]; collection: RelationalRebuildCollection; landing?: boolean }
const { entry, entries, collection, landing = false } = Astro.props;
const rendered = await Astro.slots.render('default');
const { body, heading, sources, id: sourcesId } = splitRelationalRebuildSources(relationalRebuildLinks(rendered, entries));
const available = entries.filter(item => item.available);
const index = available.findIndex(item => item.key === entry.key);
const previous = index > 0 ? available[index - 1] : undefined;
const next = index >= 0 ? available[index + 1] : available[0];
const children = relationalRebuildTree(entries, entry.key);
const parent = entries.find(item => item.key === entry.parent);
---
<Base title={entry.title} description={entry.description} readingPath="/">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="relational-rebuild" data-pagefind-ignore="all">
    <RelationalRebuildNavigation entry={entry} entries={entries} title={collection.title} compact />
    <article class="visual-essay">
      <header class="essay-header">
        <p class="eyebrow">Relational databases · Draft collection</p>
        <h1>{entry.title}</h1>
        {entry.type !== 'Companion' ? <TitleLine type={entry.type} /> : <div class="essay-meta">
          <span>{parent?.available ? <>Companion to <a href={relationalRebuildHref(parent.slug)}>{parent.title}</a></> : 'Companion'}</span><span data-reading-time></span><AiTextDisclosure inline />
        </div>}
        <p class="draft-status">{landing ? 'This collection is being written. The introduction is planned; available drafts appear in the tree below.' : entry.status === 'reviewed' ? 'Reviewed draft · this collection is not yet published.' : 'Working draft · this collection is not yet published.'}</p>
      </header>
      <ArticleBody><Fragment set:html={body} /></ArticleBody>
      {!landing && children.length > 0 && <nav class="nested-reading" aria-labelledby="nested-reading-title">
        <h2 id="nested-reading-title">Explore this subject</h2>
        <RelationalRebuildTree nodes={children} currentKey={entry.key} currentPath={relationalRebuildHref(entry.slug)} showBrief />
      </nav>}
      <RelationalRebuildNavigation entry={entry} entries={entries} title={collection.title} />
    </article>
    {(previous || next) && <nav class:list={['collection-pager', { single: !previous || !next }]} aria-label="Previous and next in this draft collection">
      {previous && <a class="previous" href={relationalRebuildHref(previous.slug)}><span class="pager-label">Previous</span><span>{previous.title}</span></a>}
      {next && <a class="next" href={relationalRebuildHref(next.slug)}><span class="pager-label">Next</span><span>{next.title}</span></a>}
    </nav>}
    {heading && <details class="article-sources" id={sourcesId}>
      <summary><Fragment set:html={heading} /></summary>
      <div class="source-content"><Fragment set:html={sources} /></div>
    </details>}
  </div>
</Base>
<style>
  .visual-essay .essay-header { margin:1.75rem 0 2rem; }
  .essay-header .eyebrow { font-size:.625rem; letter-spacing:.1em; }
  .draft-status { color:var(--color-text-secondary); font:.8rem/1.6 var(--font-sans); margin:.85rem 0 0; }
  .nested-reading { margin-top:2.5rem; padding-top:1.5rem; border-top:1px solid var(--color-rule); }
  .nested-reading h2 { margin-top:0; padding-top:0; }
  .collection-pager { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:1rem; margin:1.25rem 0 0; font:.9rem/1.5 var(--font-sans); }
  .collection-pager a { display:grid; gap:.2rem; padding:.85rem 1rem; border-radius:.35rem; background:var(--color-surface-alt); text-decoration:none; }
  .collection-pager a:hover { text-decoration:underline; }
  .pager-label { font-size:.65rem; letter-spacing:.06em; text-transform:uppercase; color:var(--color-text-secondary); }
  .previous .pager-label::before { content:'← '; }
  .next { text-align:right; }
  .next .pager-label::after { content:' →'; }
  .single { grid-template-columns:minmax(0,1fr); }
  .article-sources { margin-top:1.25rem; border-top:1px solid var(--color-rule); color:var(--color-text-secondary); font:.85rem/1.7 var(--font-sans); }
  .article-sources summary { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.85rem 0; list-style:none; cursor:pointer; }
  summary::-webkit-details-marker { display:none; }
  .article-sources summary::after { content:''; flex:none; width:.4rem; height:.4rem; margin-right:.15rem; border-right:1.5px solid var(--color-text-secondary); border-bottom:1.5px solid var(--color-text-secondary); transform:rotate(-45deg); }
  details[open] > summary::after { transform:rotate(45deg); }
  summary :global(h2) { display:inline; margin:0; padding:0; color:var(--color-text-secondary); font:500 .85rem/1.5 var(--font-sans); }
  summary:focus-visible, .collection-pager a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  .source-content { max-width:62ch; padding:.5rem 0 .25rem; overflow-wrap:anywhere; }
  .source-content :global(p) { margin:0 0 1.25rem; }
  .source-content :global(ul) { padding-left:1.1rem; }
  .source-content :global(li) { margin-bottom:.85rem; padding-left:.15rem; }
  :global(.relational-rebuild-unavailable small) { font:.75em/1.5 var(--font-sans); color:var(--color-text-secondary); }
  @media(max-width:540px) { .collection-pager { grid-template-columns:minmax(0,1fr); } .next { text-align:left; } }
  @media print { .collection-pager { display:none; } }
</style>
