---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import '../styles/explorables.css';

interface Props { title: string; description: string; type?: string; readingPath?: string; sourcesAtEnd?: boolean }
const { title, description, type = 'Guide', readingPath, sourcesAtEnd = false } = Astro.props;
const html = sourcesAtEnd ? await Astro.slots.render('default') : '';
const sources = html.match(/<h2\b[^>]*>Sources and further reading<\/h2>/i);
if (sourcesAtEnd && !sources) throw new Error('Expected a final Sources and further reading section');
const body = sources ? html.slice(0, sources.index) : html;
const sourceContent = sources ? html.slice(sources.index! + sources[0].length) : '';
---
<Base title={title} description={description} readingPath={readingPath}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <article class="visual-essay" data-pagefind-ignore>
    <header class="essay-header">
      <p class="eyebrow">Skill experiment · Draft for review</p>
      <h1>{title}</h1>
      <TitleLine type={type} />
    </header>
    {sourcesAtEnd ? <ArticleBody><Fragment set:html={body} /></ArticleBody> : <ArticleBody><slot /></ArticleBody>}
    <slot name="collection" />
  </article>
  <Fragment slot="endmatter">
    {sources && <details class="article-sources">
      <summary><Fragment set:html={sources[0]} /></summary>
      <div class="source-content"><Fragment set:html={sourceContent} /></div>
    </details>}
  </Fragment>
</Base>

<style>
  .article-sources { margin-top:2rem; border-block:1px solid var(--color-rule); font:.9rem/1.7 var(--font-sans); }
  summary { padding:1rem 0; cursor:pointer; }
  summary :global(h2) { display:inline; margin:0; font:500 1rem/1.5 var(--font-sans); }
  summary:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  .source-content { padding:.2rem 0 1rem; }
  .source-content :global(li) { margin-bottom:.65rem; }
</style>
