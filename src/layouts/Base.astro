---
import '../styles/global.css';
import ReadingNavigation from '../components/editorial/ReadingNavigation.astro';
import CollectionPager from '../components/editorial/CollectionPager.astro';
import { reading } from '../lib/reading';
import { searchKind } from '../lib/search';
import SearchPanel from '../components/editorial/SearchPanel.astro';
import ThemeSwitcher from '../components/editorial/ThemeSwitcher.astro';
import themeScript from '../scripts/theme.js?raw';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const { title, description = 'Understand how engineering systems work, how to choose between them, and what has changed.', canonical } = Astro.props;
const path = Astro.url.pathname;
const searchEntry = reading.find(entry => entry.href === path);
const active = (href: string) => (path === href ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={themeScript} />
    <title>{title === 'Stay Current' ? title : `${title} — Stay Current`}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {searchEntry && <>
      <meta data-pagefind-meta="title[content]" content={searchEntry.title} />
      <meta data-pagefind-meta="description[content]" content={searchEntry.description} />
      <meta data-pagefind-meta="kind[content]" data-pagefind-filter="Kind[content]" content={searchKind(path)} />
      <meta data-pagefind-meta="subject[content]" data-pagefind-filter="Subject[content]" content={searchEntry.group} />
    </>}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="wordmark" href="/">Stay Current</a>
        <nav aria-label="Site">
          <a href="/" aria-current={active('/')}>Overview</a>
          <a href="/articles/" aria-current={active('/articles/')}>All articles</a>
          <a href="/playgrounds/" aria-current={active('/playgrounds/')}>Playgrounds</a>
          <a href="/learn/databases/choosing/" aria-current={active('/learn/databases/choosing/')}>Databases and storage</a>
          <a href="/learn/drawing-systems/" aria-current={active('/learn/drawing-systems/')}>Drawing systems</a>
        </nav>
        <div class="header-actions">
          <a class="search-link" data-open-search href="/search/" aria-current={active('/search/')} aria-label="Search Stay Current"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><span class="search-label">Search</span></span><kbd data-search-shortcut aria-hidden="true">⌘ K</kbd></a>
          <ThemeSwitcher />
        </div>
      </div>
    </header>
    <main id="main" data-pagefind-body={searchEntry ? true : undefined}>
      {path !== '/search/' && <div data-pagefind-ignore><ReadingNavigation title={title} /></div>}
      <slot />
      <CollectionPager />
    </main>
    {path !== '/search/' && <dialog class="search-dialog" id="global-search" aria-label="Search Stay Current" data-pagefind-ignore>
      <SearchPanel id="quick-search" modal />
    </dialog>}
    <footer class="site-footer">
      <div class="inner">
        <a href="/learn/databases/choosing/">Databases and storage</a> · <a href="/learn/drawing-systems/">Drawing systems</a> · <a href="https://github.com/ryannel/staycurrent">Source</a>
      </div>
    </footer>
  </body>
</html>
