---
import '../styles/global.css';
import ReadingNavigation from '../components/editorial/ReadingNavigation.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const { title, description = 'Understand how engineering systems work, how to choose between them, and what has changed.', canonical } = Astro.props;
const path = Astro.url.pathname;
const active = (href: string) => (path === href ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Stay Current' ? title : `${title} — Stay Current`}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="wordmark" href="/">Stay Current</a>
        <nav aria-label="Site">
          <a href="/" aria-current={active('/')}>Overview</a>
          <a href="/articles/" aria-current={active('/articles/')}>All articles</a>
          <a href="/learn/databases/choosing/" aria-current={active('/learn/databases/choosing/')}>Databases and storage</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <ReadingNavigation title={title} />
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <a href="/learn/databases/choosing/">Databases and storage</a> · <a href="https://github.com/ryannel/staycurrent">Source</a>
      </div>
    </footer>
  </body>
</html>
