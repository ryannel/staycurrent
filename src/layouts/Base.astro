---
import '../styles/global.css';
import Mermaid from '../components/Mermaid.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const { title, description = 'One place to look to stay current on the major topics and fields of software engineering.', canonical } = Astro.props;
const path = Astro.url.pathname;
const active = (href: string) => (path === href ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Stay Current' ? title : `${title} — Stay Current`}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="Stay Current" href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="wordmark" href="/">Stay Current</a>
        <nav aria-label="Site">
          <a href="/changelog/" aria-current={active('/changelog/')}>Changelog</a>
          {' '}
          <a href="/about/" aria-current={active('/about/')}>About</a>
          {' '}
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        Living articles that show their work. <a href="https://github.com/ryannel/staycurrent">Source and evidence on GitHub</a>.
      </div>
    </footer>
    <Mermaid />
  </body>
</html>
