---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import { drawingCollection, drawingHref } from '../lib/drawing-collection';
import '../styles/drawing-systems.css';
// type and version fill the line under the title; TitleLine adds the reading time.
const { title, description, slug, type = 'Drawing guide', version } = Astro.props;
const index = drawingCollection.findIndex(p => p.slug === slug);
const previous = drawingCollection[index - 1];
const next = drawingCollection[index + 1];
---
<Base title={title} description={description}>
  <article class="drawing-article">
    <header>
      <p class="drawing-eyebrow">Drawing systems and processes</p>
      <h1>{title}</h1>
      <TitleLine class="drawing-meta" type={type} version={version} />
    </header>
    <ArticleBody><slot /></ArticleBody>
    <nav class="drawing-next" data-pagefind-ignore aria-label="Continue reading">{previous && <a href={drawingHref(previous.slug)}>← {previous.title}</a>}{next && <a href={drawingHref(next.slug)}>{next.title} →</a>}</nav>
  </article>
</Base>
