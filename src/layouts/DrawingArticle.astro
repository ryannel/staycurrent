---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import '../styles/drawing-systems.css';
// type and version fill the line under the title; TitleLine adds the reading time.
const { title, description, slug, type = 'Deep dive', version } = Astro.props;
---
<Base title={title} description={description}>
  <article class="drawing-article">
    <header>
      <p class="drawing-eyebrow">Drawing systems and processes</p>
      <h1>{title}</h1>
      <TitleLine class="drawing-meta" type={type} version={version} />
    </header>
    <ArticleBody><slot /></ArticleBody>
  </article>
</Base>
