---
import Base from './Base.astro';
import { drawingCollection, drawingHref } from '../lib/drawing-collection';
import '../styles/drawing-systems.css';
// meta: optional facts for the line under the title, such as article type and reading time.
const { title, description, headings, slug, meta = ['Sources checked 16 October 2026'] } = Astro.props;
const index = drawingCollection.findIndex(p => p.slug === slug);
const previous = drawingCollection[index - 1];
const next = drawingCollection[index + 1];
---
<Base title={title} description={description}>
  <article class="drawing-article">
    <header>
      <p class="drawing-eyebrow">Drawing systems and processes</p>
      <h1>{title}</h1>
      <p class="drawing-meta">{meta.join(' · ')}</p>
    </header>
    <details class="drawing-collection" data-pagefind-ignore><summary>The collection · {index + 1} of {drawingCollection.length}</summary><ol>{drawingCollection.map(p => <li><a href={drawingHref(p.slug)} aria-current={p.slug === slug ? 'page' : undefined}>{p.title}</a><span>{p.description}</span></li>)}</ol></details>
    <nav class="drawing-contents" data-pagefind-ignore aria-label="In this article"><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
    <slot />
    <nav class="drawing-next" data-pagefind-ignore aria-label="Continue reading">{previous && <a href={drawingHref(previous.slug)}>← {previous.title}</a>}{next && <a href={drawingHref(next.slug)}>{next.title} →</a>}</nav>
  </article>
</Base>
