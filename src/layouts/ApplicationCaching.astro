---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import AiTextDisclosure from '../components/editorial/AiTextDisclosure.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import { applicationCachingNeighbours, type ApplicationCachingEntry } from '../lib/application-caching';
import '../styles/explorables.css';
import '../styles/application-caching.css';

interface Props { entry: ApplicationCachingEntry; entries: ApplicationCachingEntry[] }
const { entry, entries } = Astro.props;
const { parent, children, previous, next } = applicationCachingNeighbours(entry, entries);
---
<Base title={entry.title} description={entry.description} readingPath="/">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <meta slot="head" data-pagefind-meta="kind[content]" content="Article" />
  <div class="application-caching" data-pagefind-ignore="all">
    <details class="cache-collection">
      <summary>Application caching <span>{entry.title}</span></summary>
      <nav aria-label="Application caching collection">
        <ol>
          {entries.map(item => <li class:list={{ 'cache-nested': item.parent && item.parent !== 'index' }}>
            <a href={item.href} aria-current={item.key === entry.key ? 'page' : undefined}>{item.title}</a>
          </li>)}
        </ol>
      </nav>
    </details>
    <article class="visual-essay cache-article">
      <header class="essay-header">
        <p class="eyebrow">Application caching · Draft collection</p>
        <h1>{entry.title}</h1>
        {entry.type === 'Companion' ? <div class="essay-meta">
          <span>{parent ? <>Companion to <a href={parent.href}>{parent.title}</a></> : 'Companion'}</span>
          <span data-reading-time></span><AiTextDisclosure inline />
        </div> : <TitleLine type={entry.type} />}
        <p class="cache-draft-status">{entry.status === 'reviewed' ? 'Reviewed draft' : 'Working draft'} · awaiting publication approval.</p>
      </header>
      <ArticleBody><slot /></ArticleBody>
    </article>
    {children.length > 0 && entry.key !== 'index' && <nav class="cache-deeper" aria-label="Deeper reading on this subject">
      <p>Explore this subject</p>
      <ul>{children.map(child => <li><a href={child.href}>{child.title}</a><span>{child.description}</span></li>)}</ul>
    </nav>}
    {parent && <p class="cache-parent"><a href={parent.href}>← {parent.key === 'index' ? 'Back to application caching' : `Back to ${parent.title}`}</a></p>}
    {(previous || next) && <nav class="cache-pager" aria-label="Previous and next in this reading path">
      {previous && <a href={previous.href}><span>← Previous</span>{previous.title}</a>}
      {next && <a class="cache-next" href={next.href}><span>Next →</span>{next.title}</a>}
    </nav>}
  </div>
</Base>
