---
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import { cachingArticles, cachingHref } from '../lib/caching-collection';
import '../styles/explorables.css';
import '../styles/caching.css';
interface Props { slug: string }
const { slug } = Astro.props;
const article = cachingArticles.find(a => a.slug === slug)!;
const available = cachingArticles.filter(a => a.published);
---
<Base title={article.title} description={article.description}>
  <article class="visual-essay cache-article">
    <header class="essay-header"><p class="eyebrow">Application caching · Redis</p><h1>{article.title}</h1><TitleLine type="Deep dive" version="Redis 8.2" /></header>
    {available.length > 1 && <details class="cache-switcher" data-pagefind-ignore><summary>Application caching: articles</summary><nav aria-label="Caching collection"><ol>{available.map(a=><li>{a.slug === slug ? <span aria-current="page">{a.title}</span> : <a href={cachingHref(a.slug)}>{a.title}</a>}</li>)}</ol></nav></details>}
    <ArticleBody><slot /></ArticleBody>
  </article>
</Base>
