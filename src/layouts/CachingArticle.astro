---
// Layout for the application caching collection. Article bodies live in
// src/articles/caching/ and are routed by src/pages/learn/databases/caching/[...slug].astro.
// The body's final "Sources and further reading" <h2> moves into a closed
// <details> at the foot. Drafts (draft=true) are marked, kept out of search and
// marked noindex; they only exist under CACHING_DRAFT_PREVIEW=1.
import Base from './Base.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import SwitcherLink from '../components/editorial/SwitcherLink.astro';
import { cachingCollection, cachingHref, cachingTitle, publishedCaching, type CachingEntry } from '../lib/caching-collection';
import { splitRelationalRebuildSources as splitSources } from '../lib/relational-rebuild-sources';
import '../styles/explorables.css';
import '../components/caching/shared/tokens.css';

interface Props {
  entry: CachingEntry;
  /** A planned entry shown under CACHING_DRAFT_PREVIEW=1. */
  draft?: boolean;
  /** Under preview, planned slugs that have a draft file, so the switcher can link them. */
  drafts?: string[];
}
const { entry, draft = false, drafts = [] } = Astro.props;
const path = cachingHref(entry.slug);
const rendered = await Astro.slots.render('default');
const { body, heading, sources, id: sourcesId } = splitSources(rendered);
const published = publishedCaching();
const index = published.findIndex(item => item.slug === entry.slug);
const previous = index > 0 ? published[index - 1] : undefined;
const next = index >= 0 ? published[index + 1] : undefined;
const listTitle = (item: CachingEntry) => (item.slug ? item.title : `${cachingTitle}: introduction`);
---
<Base title={entry.title} description={entry.description} readingPath={path}>
  {draft && <meta slot="head" name="robots" content="noindex, nofollow" />}
  <div class="caching-collection" data-pagefind-ignore={draft ? 'all' : undefined}>
    <details class="caching-switcher" data-pagefind-ignore>
      <summary>{cachingTitle}: articles</summary>
      <nav aria-label="Articles in the application caching collection">
        <ol>{cachingCollection.map(item => {
          const linked = item.status === 'published' || drafts.includes(item.slug);
          const label = item.status === 'published' ? undefined : linked ? 'draft' : 'planned';
          return <li>
            {linked
              ? <SwitcherLink href={cachingHref(item.slug)} path={path}>{listTitle(item)}</SwitcherLink>
              : <span class="planned-title">{listTitle(item)}</span>}
            {label && <span class="status-label"> · {label}</span>}
          </li>;
        })}</ol>
      </nav>
    </details>
    <article class="visual-essay caching-article">
      <header class="essay-header">
        <p class="eyebrow">{cachingTitle}</p>
        <h1>{entry.title}</h1>
        <TitleLine type={entry.type} />
        {draft && <p class="draft-status">Draft, not yet published</p>}
      </header>
      <ArticleBody><Fragment set:html={body} /></ArticleBody>
    </article>
    {(previous || next) && <nav class:list={['collection-pager', { single: !previous || !next }]} data-pagefind-ignore aria-label="Previous and next in application caching">
      {previous && <a class="previous" href={cachingHref(previous.slug)}><span class="pager-label">Previous</span><span>{listTitle(previous)}</span></a>}
      {next && <a class="next" href={cachingHref(next.slug)}><span class="pager-label">Next</span><span>{next.title}</span></a>}
    </nav>}
    {heading && <details class="article-sources" id={sourcesId}>
      <summary><Fragment set:html={heading} /></summary>
      <div class="source-content"><Fragment set:html={sources} /></div>
    </details>}
  </div>
</Base>
<style>
  .visual-essay .essay-header { margin:1.75rem 0 2rem; }
  .essay-header .eyebrow { font-size:.625rem; letter-spacing:.1em; }
  .draft-status { display:inline-block; margin:.85rem 0 0; padding:.2rem .6rem; border:1px dashed var(--color-rule-strong); border-radius:.3rem; color:var(--color-text-secondary); font:.8rem/1.6 var(--font-sans); }
  .caching-switcher { margin:0 0 .5rem; border:1px solid var(--color-rule); border-radius:.4rem; font:.8rem/1.5 var(--font-sans); }
  .caching-switcher summary { display:flex; align-items:center; gap:1rem; padding:.75rem .9rem; list-style:none; cursor:pointer; }
  .caching-switcher summary:hover { background:var(--color-surface-alt); }
  .caching-switcher[open] > summary { border-bottom:1px solid var(--color-rule); }
  .caching-switcher ol { margin:0; padding:.6rem .9rem .75rem 2.2rem; }
  .caching-switcher li { margin:0; padding:.3rem 0; }
  .caching-switcher :global(.switcher-link) { text-decoration:none; }
  .caching-switcher :global(a.switcher-link:hover) { text-decoration:underline; }
  .caching-switcher :global(.switcher-link[aria-current="page"]) { color:var(--color-text); font-weight:500; }
  .caching-switcher :global(.current-marker) { display:inline-block; margin-left:.4rem; padding:.05rem .45rem; border-radius:1rem; background:color-mix(in srgb,var(--color-accent) 10%,transparent); color:var(--color-accent); font-size:.65rem; font-weight:500; }
  .planned-title { color:var(--color-text-secondary); }
  .status-label { color:var(--color-text-secondary); font-size:.72rem; }
  .collection-pager { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:1rem; margin:1.25rem 0 0; font:.9rem/1.5 var(--font-sans); }
  .collection-pager a { display:grid; gap:.2rem; padding:.85rem 1rem; border-radius:.35rem; background:var(--color-surface-alt); text-decoration:none; }
  .collection-pager a:hover { text-decoration:underline; }
  .pager-label { font-size:.65rem; letter-spacing:.06em; text-transform:uppercase; color:var(--color-text-secondary); }
  .previous .pager-label::before { content:'← '; }
  .next { text-align:right; }
  .next .pager-label::after { content:' →'; }
  .single { grid-template-columns:minmax(0,1fr); }
  .article-sources { margin-top:1.25rem; border-top:1px solid var(--color-rule); color:var(--color-text-secondary); font:.85rem/1.7 var(--font-sans); }
  .article-sources summary { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.85rem 0; list-style:none; cursor:pointer; }
  summary::-webkit-details-marker { display:none; }
  summary::after { content:''; flex:none; width:.4rem; height:.4rem; margin-left:auto; margin-right:.15rem; border-right:1.5px solid var(--color-text-secondary); border-bottom:1.5px solid var(--color-text-secondary); transform:rotate(-45deg); }
  details[open] > summary::after { transform:rotate(45deg); }
  summary :global(h2) { display:inline; margin:0; padding:0; color:var(--color-text-secondary); font:500 .85rem/1.5 var(--font-sans); }
  summary:focus-visible, .collection-pager a:focus-visible, .caching-switcher :global(a:focus-visible) { outline:2px solid var(--color-accent); outline-offset:4px; }
  .source-content { max-width:62ch; padding:.5rem 0 .25rem; overflow-wrap:anywhere; }
  .source-content :global(p) { margin:0 0 1.25rem; }
  .source-content :global(ul) { padding-left:1.1rem; }
  .source-content :global(li) { margin-bottom:.85rem; padding-left:.15rem; }
  @media(max-width:540px) { .collection-pager { grid-template-columns:minmax(0,1fr); } .next { text-align:left; } }
  @media print { .collection-pager, .caching-switcher { display:none; } }
</style>
