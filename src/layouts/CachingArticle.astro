---
import Base from './Base.astro';
import ArticleBody from '../components/editorial/ArticleBody.astro';
import TitleLine from '../components/editorial/TitleLine.astro';
import { cachingArticles, cachingHref } from '../lib/caching-collection';
import '../styles/explorables.css';
import '../components/caching/figures.css';
interface Props { slug: string }
const { slug } = Astro.props;
const available = cachingArticles.filter(a => a.published);
const entry = cachingArticles.find(a => a.slug === slug)!;
const index = available.findIndex(a => a.slug === slug);
const previous = available[index - 1];
const next = available[index + 1];
---
<Base title={entry.title} description={entry.description}>
  <article class="visual-essay caching-essay">
    <header class="essay-header">
      <p class="eyebrow">Application caching · Redis</p>
      <h1>{entry.title}</h1>
      <TitleLine type={slug ? 'Deep dive' : 'Introduction'} version="Redis 8.2" />
    </header>
    {available.length > 1 && <details class="cache-collection" data-pagefind-ignore>
      <summary>In this collection · {index + 1} of {available.length} available articles</summary>
      <ol>{available.map(a => <li><a href={cachingHref(a.slug)} aria-current={a.slug === slug ? 'page' : undefined}>{a.title}</a></li>)}</ol>
    </details>}
    <ArticleBody><slot /></ArticleBody>
    {(previous || next) && <nav class="cache-pager" aria-label="Continue the caching collection" data-pagefind-ignore>
      {previous && <a href={cachingHref(previous.slug)}>← {previous.title}</a>}
      {next && <a href={cachingHref(next.slug)}>{next.title} →</a>}
    </nav>}
    <details class="cache-sources"><summary>Sources and further reading</summary><slot name="sources" /></details>
  </article>
</Base>
<style>
 .cache-collection,.cache-sources{border-top:1px solid var(--color-rule);padding:1rem 0;font:.88rem/1.7 var(--font-sans);}
 summary{cursor:pointer;color:var(--color-text-secondary);}
 .cache-collection a[aria-current]{font-weight:700;}
 .cache-sources{margin-top:3rem;}
 .cache-sources :global(li){margin-bottom:.8rem;}
 .cache-pager{display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;border-top:1px solid var(--color-rule);padding:1.5rem 0;margin-top:3rem;font:.9rem/1.6 var(--font-sans);}
</style>
