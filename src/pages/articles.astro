---
import Base from '../layouts/Base.astro';
import { reading } from '../lib/reading';
const groups = [...new Set(reading.map(article => article.group))];
---
<Base title="All articles" description="Find a field guide, explanation or assessment. Browse the available reading or filter by subject.">
  <div class="article-directory">
    <h1>All articles</h1>
    <p>We’re starting with databases and storage. These are the working drafts you can read now; planned outlines are in the <a href="/learn/databases/relational/#collection">relational collection</a>.</p>
    <form role="search" onsubmit="return false" hidden id="article-search">
      <label for="article-query">Find an article</label>
      <div class="search-controls"><input id="article-query" type="search" placeholder="Try schema, normalisation or transactions" autocomplete="off" /><button type="reset">Clear</button></div>
      <p id="article-count" role="status" aria-live="polite" aria-atomic="true">{reading.length} articles</p>
    </form>
    <div id="article-results">
      {groups.map(group => <section data-reading-group>
        <h2>{group}</h2>
        <ul>{reading.filter(article => article.group === group).map(article => <li data-reading-entry data-search={`${article.title} ${article.description} ${article.group} ${article.keywords ?? ''}`}>
          <h3><a href={article.href}>{article.title}</a></h3>
          <p>{article.description}</p>
        </li>)}</ul>
      </section>)}
    </div>
    <p id="no-articles" hidden>No articles match that search. Try a shorter term, or clear the search to see everything.</p>
  </div>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('#article-search')!;
  const input = document.querySelector<HTMLInputElement>('#article-query')!;
  const entries = [...document.querySelectorAll<HTMLElement>('[data-reading-entry]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-reading-group]')];
  const normalise = (text: string) => text.toLowerCase().normalize('NFKD').replace(/\p{Diacritic}/gu, '').replace(/normaliz/g, 'normalis');
  function filter() {
    const terms = normalise(input.value).trim().split(/\s+/).filter(Boolean);
    let count = 0;
    for (const entry of entries) {
      entry.hidden = !terms.every(term => normalise(entry.dataset.search ?? '').includes(term));
      if (!entry.hidden) count++;
    }
    for (const group of groups) group.hidden = !group.querySelector('[data-reading-entry]:not([hidden])');
    document.querySelector('#article-count')!.textContent = `${count} ${count === 1 ? 'article' : 'articles'}${terms.length ? ' found' : ''}`;
    (document.querySelector('#no-articles') as HTMLElement).hidden = count > 0;
  }
  form.hidden = false;
  input.addEventListener('input', filter);
  form.addEventListener('reset', () => { input.value = ''; filter(); input.focus(); });
</script>
<style>
  :global(main:has(.article-directory)) { max-width: 62rem; }
  .article-directory > p { max-width: 42rem; }
  form { margin: 2rem 0; font: .95rem/1.5 var(--font-sans); }
  label { display: block; font-weight: 600; margin-bottom: .6rem; }
  .search-controls { display: flex; gap: .7rem; max-width: 42rem; }
  input { min-width: 0; flex: 1; width: 100%; }
  input, button { font: inherit; padding: .8rem; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-rule-strong); border-radius: .3rem; }
  button { cursor: pointer; }
  button:hover { border-color: var(--color-accent); }
  input:focus-visible, button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  #article-count { color: var(--color-text-secondary); margin: .7rem 0 0; font-size: .85rem; }
  section { border-top: 1px solid var(--color-rule); margin-top: 2rem; }
  h2 { margin: 1.4rem 0; }
  ul { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2.5rem; }
  h3 { font: 500 1rem/1.5 var(--font-sans); margin: 0 0 .4rem; }
  li p { font: .9rem/1.6 var(--font-sans); color: var(--color-text-secondary); margin: 0; }
  [hidden] { display: none !important; }
  @media (max-width: 600px) { ul { grid-template-columns: 1fr; } }
</style>
