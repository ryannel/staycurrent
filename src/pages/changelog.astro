---
import Base from '../layouts/Base.astro';
import { getSiteChangelog, formatDate, isoDate } from '../lib/content';

const entries = await getSiteChangelog();
---
<Base title="Changelog" description="Every new version across every topic, newest first.">
  <h1>Changelog</h1>
  <p>Every new version across every topic, newest first. Each entry says what moved in the field and what it means for practice. The <a href="/rss.xml">RSS feed</a> carries the same entries.</p>
  {entries.map((e) => (
    <section class="entry">
      <h2><a href={`/${e.slug}/changelog/#v${e.version}`}>{e.title} v{e.version}</a> <small class="meta" style="display:inline"><time datetime={isoDate(e.date)}>{formatDate(e.date)}</time></small></h2>
      <Fragment set:html={e.html} />
      <p class="meta"><a href={`/${e.slug}/`}>Read {e.title} →</a></p>
    </section>
  ))}
</Base>
