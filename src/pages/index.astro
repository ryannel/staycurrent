---
import Base from '../layouts/Base.astro';
import { getTopics, groupTopics, formatDate, isoDate, slugOf, type Article } from '../lib/content';

const topics = await getTopics();
const { areas, ungrouped } = groupTopics(topics);

const card = (t: Article) => ({
  slug: slugOf(t.id),
  title: t.data.title,
  stance: t.data.stance,
  version: t.data.version,
  researched: t.data.last_researched,
  core: t.data.core ?? false,
});
---
<Base title="Stay Current">
  <h1>Stay Current</h1>
  <p>One place to look to stay current on the major topics and fields of software engineering. Each topic is a living article with a stance: what to do, what to reject, and why. When the field moves, the article is rewritten and the changelog says what changed and what it means for practice.</p>

  {areas.map((group) => (
    <section aria-label={group.area}>
      <p class="section-label">{group.area}</p>
      <ul class="topic-list">
        {group.hub && <Fragment set:html={''} />}
        {[group.hub, ...group.movements.flatMap((m) => m.topics), ...group.profiles]
          .filter((t): t is Article => Boolean(t))
          .map((t) => {
            const c = card(t);
            const movement = t.data.register === 'foundation' ? t.data.movement : undefined;
            return (
              <li class="topic-card">
                <h2><a href={`/${c.slug}/`}>{c.title}</a>{c.core && <span class="badge"> core</span>}</h2>
                <p class="stance">{c.stance}</p>
                <p class="meta">
                  <span class="badge">v{c.version}</span>
                  <span class="sep" aria-hidden="true">·</span>
                  <span>researched <time datetime={isoDate(c.researched)}>{formatDate(c.researched)}</time></span>
                  {t.data.register && <><span class="sep" aria-hidden="true">·</span><span>{t.data.register}{movement ? ` · ${movement}` : ''}</span></>}
                </p>
              </li>
            );
          })}
      </ul>
    </section>
  ))}

  {ungrouped.length > 0 && (
    <section aria-label="Topics">
      {areas.length > 0 && <p class="section-label">Topics</p>}
      <ul class="topic-list">
        {ungrouped.map((t) => {
          const c = card(t);
          return (
            <li class="topic-card">
              <h2><a href={`/${c.slug}/`}>{c.title}</a></h2>
              <p class="stance">{c.stance}</p>
              <p class="meta">
                <span class="badge">v{c.version}</span>
                <span class="sep" aria-hidden="true">·</span>
                <span>researched <time datetime={isoDate(c.researched)}>{formatDate(c.researched)}</time></span>
              </p>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {topics.length === 0 && <p>No topics yet.</p>}
</Base>
