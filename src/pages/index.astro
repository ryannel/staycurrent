---
import Base from '../layouts/Base.astro';

const planned = [
  { title: 'APIs and service communication', description: 'REST, GraphQL and RPC; designing contracts and keeping services compatible as they change.' },
  { title: 'Messaging and event-driven systems', description: 'Queues and streams; moving work between services, handling duplicates and replaying events.' },
  { title: 'Observability', description: 'Logs, metrics, traces and profiles; understanding what a system is doing and why.' },
  { title: 'AI application engineering', description: 'Retrieval, tools and evaluation; building useful applications around models and understanding their failures.' },
];

const collections = [
  {
    kind: 'An engineering field',
    title: 'Databases and storage',
    href: '/learn/databases/choosing/',
    start: 'Read the field guide',
    summary: 'Keeping an order correct, searching a catalogue and analysing billions of events ask different things of storage. Get to know the main approaches, where they fit, and the design decisions behind them.',
    readingLabel: 'Further reading',
    reading: [
      { href: '/learn/databases/relational/', title: 'Relational databases', description: 'Tables, queries and reliable changes, with a collection of deeper articles.' },
      { href: '/learn/databases/object-storage/', title: 'Object storage', description: 'Objects, application workflows and operating Amazon S3, with guided sandbox lessons.' },
      { href: '/learn/databases/column-stores/', title: 'Column stores', description: 'An illustrated explanation, with experiments you can try.' },
    ],
  },
  {
    kind: 'A practice for every field',
    title: 'Drawing systems and processes',
    href: '/learn/drawing-systems/',
    start: 'Start the collection',
    summary: 'A line between two boxes can mean an API call, a handoff between people or a change of state. Learn which view answers the question you are asking, how to draw it with colleagues at a whiteboard, and how to keep a diagram trustworthy after the meeting ends.',
    readingLabel: 'Places to begin',
    reading: [
      { href: '/learn/drawing-systems/whiteboarding/', title: 'Drawing at the whiteboard', description: 'Turn a conversation into a drawing people can correct, starting in the first five minutes.' },
      { href: '/learn/drawing-systems/architecture/', title: 'Architecture diagrams', description: 'Context, C4 zoom levels, relationships and deployment.' },
      { href: '/images/drawing-systems/whiteboard-reference.html', title: 'Printable shape reference', description: 'Two pages of whiteboard shapes and drawing steps to keep beside you.' },
    ],
  },
];
---
<Base title="Stay Current" description="Understand engineering choices and follow the changes that matter. Field guides, explanations and assessments for working engineers.">
  <div class="overview">
    <header class="intro">
      <p class="eyebrow">A field guide for working engineers</p>
      <h1>Understand the choices.<br />Know when they change.</h1>
      <p class="deck">Engineering keeps moving. Understanding how the systems underneath it work makes it easier to decide what to use—and which new developments deserve your attention.</p>
      <p>Start with a field guide to get your bearings, follow an explanation to learn how something works, or read an assessment of a change that could affect your choices.</p>
    </header>

    <section aria-labelledby="reading-title">
      <h2 id="reading-title">What you can read now</h2>
      <p class="section-note">Two collections are complete. One covers an engineering field in depth. The other teaches a practice you can use in any field: drawing a system so that other people can check it. <a href="/articles/">Browse all articles →</a></p>
      <div class="collections">
        {collections.map(collection => <article class="collection">
          <p class="eyebrow">{collection.kind}</p>
          <h3><a href={collection.href}>{collection.title} <span aria-hidden="true">→</span></a></h3>
          <p>{collection.summary}</p>
          <a class="guide-link" href={collection.href}>{collection.start} <span aria-hidden="true">→</span></a>
          <div class="reading">
            <p>{collection.readingLabel}</p>
            <ul>{collection.reading.map(item => <li><a href={item.href}>{item.title}</a><span>{item.description}</span></li>)}</ul>
          </div>
        </article>)}
      </div>
    </section>

    <section class="practice" aria-labelledby="practice-title">
      <h2 id="practice-title">Learn by trying</h2>
      <p>Our <a href="/playgrounds/">playgrounds</a> let you change an example and inspect the result. Run PostgreSQL in the <a href="/learn/databases/relational/sandbox/">SQL sandbox</a>, or follow requests and recovery in the <a href="/learn/databases/object-storage/sandbox/">object-storage sandbox</a>. Guided lessons give each experiment a starting point and a question to explore.</p>
    </section>

    <section class="planned" aria-labelledby="planned-title">
      <h2 id="planned-title">Other fields we plan to cover</h2>
      <p>These fields will follow. There are no articles to read in them yet.</p>
      <ul>
        {planned.map(field => <li><h3>{field.title}</h3><p>{field.description}</p></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  :global(main:has(.overview)) { max-width: 66rem; }
  .overview { padding: 1.5rem 0; }
  .intro { max-width: 43rem; margin-bottom: 3.5rem; }
  .eyebrow { font-family: var(--font-sans); font-size: .8rem; color: var(--color-text-secondary); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.13; margin: 1rem 0 1.5rem; }
  .deck { font-size: 1.3rem; }
  h2 { margin-bottom: 1.3rem; }
  .section-note { max-width: 43rem; }
  .collections { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 1.8rem; }
  .collection { display: flex; flex-direction: column; border-top: 2px solid var(--color-accent); border-bottom: 1px solid var(--color-rule); padding: 1.6rem 0; }
  .collection h3 { font-size: 1.75rem; line-height: 1.2; margin: .5rem 0 1rem; }
  .guide-link { font-family: var(--font-sans); font-size: 1rem; }
  .reading { margin-top: auto; padding-top: 1.4rem; border-top: 1px solid var(--color-rule); font-family: var(--font-sans); }
  .collection > .guide-link { margin-bottom: 1.8rem; }
  .reading > p { font-size: .85rem; color: var(--color-text-secondary); }
  .reading ul { list-style: none; padding: 0; display: grid; gap: 1.1rem; }
  .reading li { font-size: 1rem; }
  .reading span { display: block; margin-top: .35rem; font-size: .9rem; color: var(--color-text-secondary); }
  .planned ul { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 3rem; }
  .planned,.practice { margin-top: 3rem; }
  .practice p { max-width:43rem; }
  .planned > p { max-width: 43rem; color: var(--color-text-secondary); }
  .planned ul { margin-top: 1.8rem; }
  .planned li { border-top: 1px solid var(--color-rule); padding-top: 1rem; }
  .planned h3 { margin: 0 0 .6rem; }
  .planned li p { font-family: var(--font-sans); font-size: .95rem; color: var(--color-text-secondary); }
  @media (max-width: 860px) { .collections { grid-template-columns: 1fr; gap: 1rem; } }
  @media (max-width: 600px) {
    .overview { padding-top: .5rem; }
    .planned ul { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
