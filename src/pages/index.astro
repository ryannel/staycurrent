---
import Base from '../layouts/Base.astro';

const planned = [
  { title: 'APIs and service communication', description: 'REST, GraphQL and RPC; designing contracts and keeping services compatible as they change.' },
  { title: 'Messaging and event-driven systems', description: 'Queues and streams; moving work between services, handling duplicates and replaying events.' },
  { title: 'Observability', description: 'Logs, metrics, traces and profiles; understanding what a system is doing and why.' },
  { title: 'AI application engineering', description: 'Retrieval, tools and evaluation; building useful applications around models and understanding their failures.' },
];
---
<Base title="Stay Current" description="Understand engineering choices and follow the changes that matter. Field guides, explanations and assessments for working engineers.">
  <div class="overview">
    <header class="intro">
      <p class="eyebrow">A field guide for working engineers</p>
      <h1>Understand the choices.<br />Know when they change.</h1>
      <p class="deck">Engineering keeps moving. Understanding how the systems underneath it work makes it easier to decide what to use—and which new developments deserve your attention.</p>
      <p>Start with a field guide to get your bearings, follow an explanation to learn how something works, or read an assessment of a change that could affect your choices.</p>
    </header>

    <section aria-labelledby="fields-title">
      <h2 id="fields-title">Explore a field</h2>
      <p>Looking for a particular subject? <a href="/articles/">Browse all articles →</a></p>
      <article class="available-field">
        <p class="eyebrow">Our first field · Working drafts</p>
        <h3><a href="/learn/databases/choosing/">Databases and storage <span aria-hidden="true">→</span></a></h3>
        <p>Keeping an order correct, searching a catalogue and analysing billions of events ask different things of storage. Get to know the main approaches, where they fit, and the design decisions behind them.</p>
        <a class="guide-link" href="/learn/databases/choosing/">Read the field guide <span aria-hidden="true">→</span></a>
        <div class="reading">
          <p>Further reading</p>
          <ul>
            <li><a href="/learn/databases/relational/">Relational databases</a><span>Tables, queries and reliable changes, with a collection of deeper articles.</span></li>
            <li><a href="/learn/databases/column-stores/">Column stores</a><span>An illustrated explanation, with experiments you can try.</span></li>
          </ul>
        </div>
      </article>
    </section>

    <section class="planned" aria-labelledby="planned-title">
      <h2 id="planned-title">Other fields we plan to cover</h2>
      <p>We’re developing the database collection first. These fields will follow; there are no articles to read in them yet.</p>
      <ul>
        {planned.map(field => <li><h3>{field.title}</h3><p>{field.description}</p></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  :global(main:has(.overview)) { max-width: 66rem; }
  .overview { padding: 1.5rem 0; }
  .intro { max-width: 43rem; margin-bottom: 3.5rem; }
  .eyebrow { font-family: var(--font-sans); font-size: .8rem; color: var(--color-text-secondary); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.13; margin: 1rem 0 1.5rem; }
  .deck { font-size: 1.3rem; }
  h2 { margin-bottom: 1.3rem; }
  .available-field { border-top: 2px solid var(--color-accent); border-bottom: 1px solid var(--color-rule); padding: 1.6rem 0; }
  .available-field h3 { font-size: 2rem; margin: .5rem 0 1rem; }
  .available-field > p { max-width: 43rem; }
  .guide-link { font-family: var(--font-sans); font-size: 1rem; }
  .reading { margin-top: 1.8rem; padding-top: 1.4rem; border-top: 1px solid var(--color-rule); font-family: var(--font-sans); }
  .reading > p { font-size: .85rem; color: var(--color-text-secondary); }
  .reading ul, .planned ul { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 3rem; }
  .reading li { font-size: 1rem; }
  .reading span { display: block; margin-top: .35rem; font-size: .9rem; color: var(--color-text-secondary); }
  .planned { margin-top: 3rem; }
  .planned > p { max-width: 43rem; color: var(--color-text-secondary); }
  .planned ul { margin-top: 1.8rem; }
  .planned li { border-top: 1px solid var(--color-rule); padding-top: 1rem; }
  .planned h3 { margin: 0 0 .6rem; }
  .planned li p { font-family: var(--font-sans); font-size: .95rem; color: var(--color-text-secondary); }
  @media (max-width: 600px) {
    .overview { padding-top: .5rem; }
    .reading ul, .planned ul { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
