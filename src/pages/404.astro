---
import Base from '../layouts/Base.astro';
import { getTopics, slugOf } from '../lib/content';

const topics = await getTopics();
---
<Base title="Not found">
  <h1>This page doesn't exist.</h1>
  <p>It may have moved when a topic was renamed. The topics that do exist:</p>
  <ul>
    {topics.map((t) => <li><a href={`/${slugOf(t.id)}/`}>{t.data.title}</a></li>)}
  </ul>
</Base>
