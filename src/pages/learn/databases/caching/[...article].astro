import { cachingArticles } from '../../../../lib/caching-collection';
export function getStaticPaths() {
  const modules = import.meta.glob('../../../../articles/caching/*.astro');
  return cachingArticles.filter(a => a.slug && (a.published || process.env.CACHING_DRAFT_PREVIEW === '1') && modules[`../../../../articles/caching/${a.slug}.astro`])
    .map(a => ({ params: { article: a.slug }, props: { slug: a.slug } }));
}
const modules = import.meta.glob('../../../../articles/caching/*.astro');
const { slug } = Astro.props;
const { default: Article } = await modules[`../../../../articles/caching/${slug}.astro`]();
---
<Article />
