---
// Application caching with Redis. Each article body is src/articles/caching/<slug>.astro
// (the introduction is introduction.astro), listed in src/lib/caching-collection.ts.
// Normal builds generate only `published` entries. With CACHING_DRAFT_PREVIEW=1,
// planned entries that have a file render as noindex drafts, and the figure
// toolkit's test bench appears at /learn/databases/caching/toolkit/.
import CachingArticle from '../../../../layouts/CachingArticle.astro';
import { cachingCollection, type CachingEntry } from '../../../../lib/caching-collection';

// getStaticPaths runs in its own scope, so it repeats this small helper.
const fileFor = (slug: string) => `../../../../articles/caching/${slug || 'introduction'}.astro`;

export async function getStaticPaths() {
  const fileFor = (slug: string) => `../../../../articles/caching/${slug || 'introduction'}.astro`;
  const files = import.meta.glob('../../../../articles/caching/*.astro');
  const preview = process.env.CACHING_DRAFT_PREVIEW === '1';
  const has = (slug: string) => fileFor(slug) in files;
  const missing = cachingCollection.filter(entry => entry.status === 'published' && !has(entry.slug));
  if (missing.length) throw new Error(`Published caching entries without an article file: ${missing.map(entry => entry.slug || 'introduction').join(', ')}`);
  const drafts = preview ? cachingCollection.filter(entry => entry.status === 'planned' && has(entry.slug)).map(entry => entry.slug) : [];
  const paths = cachingCollection
    .filter(entry => entry.status === 'published' || drafts.includes(entry.slug))
    .map(entry => ({ params: { slug: entry.slug || undefined }, props: { entry, draft: entry.status !== 'published', drafts } }));
  if (preview) {
    const entry: CachingEntry = {
      slug: 'toolkit', title: 'Caching figure toolkit: test bench', type: 'Deep dive', status: 'planned',
      description: 'A test bench for the shared caching figure toolkit. Not an article.',
    };
    paths.push({ params: { slug: 'toolkit' }, props: { entry, draft: true, drafts, toolkit: true } });
  }
  return paths;
}

interface Props { entry: CachingEntry; draft: boolean; drafts: string[]; toolkit?: boolean }
const { entry, draft, drafts, toolkit = false } = Astro.props;
let Body: any;
// Note: Vite still emits unreferenced client chunks for the bench and any draft
// articles' <script>s in normal builds (as for src/reference-articles); no page links them.
if (toolkit) Body = (await import('../../../../components/caching/shared/demo/ToolkitBench.astro')).default;
else Body = ((await import.meta.glob('../../../../articles/caching/*.astro')[fileFor(entry.slug)]()) as { default: any }).default;
---
<CachingArticle entry={entry} draft={draft} drafts={drafts}><Body /></CachingArticle>
