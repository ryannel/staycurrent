const search = `SELECT product_id, title
FROM choice_products
WHERE terms @@ plainto_tsquery('english', 'blue mug')
ORDER BY product_id;`;
const apply = `INSERT INTO choice_copy (product_id, version, title, active)
VALUES (1, 2, 'Blue mug', false)
ON CONFLICT (product_id) DO UPDATE
SET version = EXCLUDED.version,
    title = EXCLUDED.title,
    active = EXCLUDED.active
WHERE EXCLUDED.version > choice_copy.version;`;
const outbox = relationalDepthChoicesTutorials.find(t => t.id === 'outbox-delivery')!;
