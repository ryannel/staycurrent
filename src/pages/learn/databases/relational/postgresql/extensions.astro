const booking = `CREATE EXTENSION IF NOT EXISTS btree_gist;
CREATE TABLE pg_cap_booking (
  booking_id integer PRIMARY KEY,
  room text NOT NULL,
  during tsrange NOT NULL CHECK (
    NOT isempty(during)
    AND lower(during) IS NOT NULL AND upper(during) IS NOT NULL
    AND isfinite(lower(during)) AND isfinite(upper(during))
  ),
  EXCLUDE USING gist (room WITH =, during WITH &&)
);`;
const temporal = `CREATE TABLE pg_cap_authorisation (
  worker_id integer NOT NULL,
  valid_at daterange NOT NULL,
  PRIMARY KEY (worker_id, valid_at WITHOUT OVERLAPS)
);
CREATE TABLE pg_cap_assignment (
  assignment_id integer PRIMARY KEY,
  worker_id integer NOT NULL,
  during daterange NOT NULL,
  FOREIGN KEY (worker_id, PERIOD during)
    REFERENCES pg_cap_authorisation (worker_id, PERIOD valid_at)
);`;
const spatial = `SELECT v.venue_id,v.name FROM pg_cap_venues v
WHERE v.open_for_booking
  AND ST_DWithin(
    v.location,
    ST_SetSRID(ST_MakePoint(18.0686,59.3293),4326)::geography,
    1000
  )
  AND EXISTS (
    SELECT 1 FROM pg_cap_venue_rooms r
    WHERE r.venue_id=v.venue_id AND r.seats>=8
  )
ORDER BY v.venue_id;`;
const versions = `SELECT name,default_version,installed_version
FROM pg_available_extensions
WHERE name IN ('btree_gist','vector','postgis');

SELECT extname,extversion FROM pg_extension
WHERE extname IN ('btree_gist','vector','postgis');`;
