ON core_documents USING gin (tags);

-- Contains both elements
SELECT id FROM core_documents
WHERE tags @> ARRAY['audit', 'urgent'];

-- Overlaps: contains at least one element
SELECT id FROM core_documents
WHERE tags && ARRAY['audit', 'urgent'];`;
