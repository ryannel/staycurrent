const update=`BEGIN;
EXPLAIN (ANALYZE, WAL, BUFFERS, TIMING OFF)
UPDATE pg_wal_example SET available = 1 WHERE id = 1;
SELECT id, available FROM pg_wal_example;`;
const rollback=`ROLLBACK;
SELECT id, available FROM pg_wal_example;
SELECT pg_wal_lsn_diff(pg_current_wal_insert_lsn(), position) > 0
       AS wal_advanced
FROM pg_wal_marker;`;
const asyncCommit=`BEGIN;
SET LOCAL synchronous_commit = off;
UPDATE page_views SET views = views + 1 WHERE page_id = 42;
COMMIT;`;
const positions=`SELECT pg_current_wal_insert_lsn() AS inserted,
       pg_current_wal_lsn() AS written,
       pg_current_wal_flush_lsn() AS flushed;`;
