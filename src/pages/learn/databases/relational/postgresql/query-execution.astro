const setup=`SET max_parallel_workers_per_gather = 0;
CREATE TABLE core_jobs (
  job_id integer PRIMARY KEY,
  tenant_id integer NOT NULL,
  priority integer NOT NULL,
  payload text NOT NULL
);
INSERT INTO core_jobs
SELECT n,
       CASE WHEN n <= 45000 THEN 0 ELSE 1 + (n % 100) END,
       (n * 37) % 101,
       repeat(md5(n::text), 5)
FROM generate_series(1, 50000) AS n;
CREATE INDEX core_jobs_tenant ON core_jobs (tenant_id);
ANALYZE core_jobs;`;
const prepare=`PREPARE core_tenant(integer) AS
SELECT job_id, payload FROM core_jobs WHERE tenant_id = $1;`;
const custom=`SET plan_cache_mode = force_custom_plan;
EXPLAIN (ANALYZE, BUFFERS) EXECUTE core_tenant(1);
EXPLAIN (ANALYZE, BUFFERS) EXECUTE core_tenant(0);`;
const generic=`SET plan_cache_mode = force_generic_plan;
EXPLAIN (ANALYZE, BUFFERS) EXECUTE core_tenant(1);
EXPLAIN (ANALYZE, BUFFERS) EXECUTE core_tenant(0);
RESET plan_cache_mode;`;
const top=`EXPLAIN (ANALYZE, BUFFERS)
SELECT job_id, priority FROM core_jobs
ORDER BY priority, job_id LIMIT 5;`;
const index=`CREATE INDEX core_jobs_priority ON core_jobs (priority, job_id);`;
const spill=`BEGIN;
SET LOCAL work_mem = '64kB';
EXPLAIN (ANALYZE, BUFFERS)
SELECT job_id, payload FROM core_jobs ORDER BY payload, job_id;
ROLLBACK;`;
