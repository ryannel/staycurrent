const generated = `search tsvector GENERATED ALWAYS AS (
  setweight(to_tsvector('english', title), 'A') ||
  setweight(to_tsvector('english', body), 'D')
) STORED`;
const phraseFields = `SELECT document_id FROM pg_cap_documents
WHERE tenant_id=7 AND published
  AND (to_tsvector('english',title) @@ phraseto_tsquery('english','running shoes')
    OR to_tsvector('english',body) @@ phraseto_tsquery('english','running shoes'))
ORDER BY document_id;`;
const trigram = `CREATE EXTENSION IF NOT EXISTS pg_trgm;
SELECT similarity('runnng','running') AS spelling_similarity,
       similarity('runnng','roads') AS unrelated_similarity;`;
