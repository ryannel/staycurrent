const exact = `SELECT id, embedding <-> '[1,0,0]'::vector AS distance
FROM pg_cap_vector_small
WHERE tenant=7
ORDER BY distance,id LIMIT 2;`;
const hnsw = `CREATE INDEX pg_cap_vector_hnsw
ON pg_cap_vector_scale USING hnsw (embedding vector_l2_ops);`;
const query = `BEGIN;
SET LOCAL hnsw.ef_search=40;
SET LOCAL hnsw.iterative_scan=strict_order;

EXPLAIN (ANALYZE,BUFFERS,TIMING OFF)
SELECT id FROM pg_cap_vector_scale
WHERE tenant=7
ORDER BY embedding <-> (
  SELECT embedding FROM pg_cap_vector_scale WHERE id=123
)
LIMIT 10;
COMMIT;`;
const embeddingUpdate = `UPDATE documents
SET embedding = $1, embedding_revision = $2, embedding_model = $3
WHERE document_id = $4 AND source_revision = $2
RETURNING document_id;`;
