const prepare=`SET plan_cache_mode = force_generic_plan;
PREPARE pg_scale_month(date, date) AS
 SELECT event_id, tenant_id FROM pg_scale_events
 WHERE occurred_on >= $1 AND occurred_on < $2;
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF)
EXECUTE pg_scale_month('2026-10-01', '2026-11-01');`;
const tenantKeys=`CREATE TABLE customers (
 tenant_id integer NOT NULL,
 customer_id integer NOT NULL,
 name text NOT NULL,
 PRIMARY KEY (tenant_id, customer_id)
);
CREATE TABLE orders (
 tenant_id integer NOT NULL,
 order_id integer NOT NULL,
 customer_id integer NOT NULL,
 total integer NOT NULL,
 PRIMARY KEY (tenant_id, order_id),
 FOREIGN KEY (tenant_id, customer_id)
   REFERENCES customers (tenant_id, customer_id)
);`;
const tenantQuery=`SELECT o.order_id, c.name, o.total
FROM orders o JOIN customers c
 ON c.tenant_id = o.tenant_id
 AND c.customer_id = o.customer_id
WHERE o.tenant_id = 7;`;
