const grants = `GRANT USAGE ON SCHEMA ops_access TO ops_shipping;
GRANT SELECT (order_id, status), UPDATE (status)
ON ops_access.orders TO ops_shipping;`;
const policy = `ALTER TABLE ops_access.orders ENABLE ROW LEVEL SECURITY;
CREATE POLICY shipping_tenant ON ops_access.orders TO ops_shipping
USING (tenant_id = 1)
WITH CHECK (tenant_id = 1);`;
const defaults = `-- Run as the role that creates these tables, or an authorised administrator.
ALTER DEFAULT PRIVILEGES FOR ROLE order_owner IN SCHEMA orders
GRANT SELECT ON TABLES TO order_reporting;`;
