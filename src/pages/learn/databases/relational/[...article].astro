---
import RelationalPublishedArticle from '../../../../components/editorial/RelationalPublishedArticle.astro';
import { relationalAliases, relationalArticleHref } from '../../../../lib/relational-collection';
import { relationalPublishedEntries } from '../../../../lib/relational-publication';
export function getStaticPaths() {
  // These four existing explicit routes use the same published article wrapper.
  const explicit = new Set(['postgresql/sharding', 'postgresql/full-text-search', 'postgresql/vector-search', 'postgresql/extensions']);
  return [
    ...relationalPublishedEntries.filter(entry => entry.slug && !explicit.has(entry.slug)).map(entry => ({ params: { article: entry.slug }, props: { entryKey: entry.key } })),
    ...Object.entries(relationalAliases).map(([slug, target]) => ({ params: { article: slug }, props: { redirect: relationalArticleHref(target) } })),
  ];
}
const { entryKey, redirect } = Astro.props;
if (redirect) return Astro.redirect(redirect);
---
<RelationalPublishedArticle entryKey={entryKey} />
