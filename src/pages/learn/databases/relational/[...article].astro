---
import Base from '../../../../layouts/Base.astro';
import { relationalCollection, relationalArticleHref, relationalAliases } from '../../../../lib/relational-collection';
import '../../../../styles/explorables.css';
export function getStaticPaths() {
  const outlines = relationalCollection.flatMap(group => group.articles.filter(article => !article.status).map(article => ({params:{article:article.slug},props:{article,group,redirect:undefined}})));
  const aliases = Object.entries(relationalAliases).map(([slug,target]) => ({params:{article:slug},props:{redirect:relationalArticleHref(target)}}));
  return [...outlines, ...aliases];
}
const {article,group,redirect} = Astro.props;
if (redirect) return Astro.redirect(redirect);
const main = group.articles.find(item => item.slug === group.main);
const others = group.articles.filter(item => item.slug !== article.slug);
---
<Base title={`${article.title} — planned article`} description={`Planned coverage: ${article.description}`}>
  <meta slot="head" name="robots" content="noindex" />
  <article class="visual-essay planned-article">
    <header class="essay-header">
      <p class="eyebrow">Relational databases · Planned article</p>
      <h1>{article.title}</h1>
      <p class="article-status">This article hasn’t been written yet. This outline shows the explanation being planned.</p>
    </header>
    <section aria-labelledby="scope-title">
      <h2 id="scope-title">What this article will cover</h2>
      <p>{article.description}</p>
      <p>{article.scope}</p>
    </section>
    <nav aria-label="Relational collection">
      {main && main.slug !== article.slug && <p><a href={relationalArticleHref(main.slug)}>Main deep dive: {main.title} →</a> {main.status !== 'published' && <small>({main.status === 'draft' ? 'working draft' : 'planned'})</small>}</p>}
      <p><a href={`/learn/databases/relational/#${group.overviewAnchor}`}>Read the introduction →</a></p>
      <p><a href={`/learn/databases/relational/#reading-${group.id}`}>Back to {group.title.toLowerCase()} →</a></p>
      <h2>Related reading</h2>
      <ul>{others.map(item=><li><a href={relationalArticleHref(item.slug)}>{item.title}</a> {item.status !== 'published' && <small>({item.status === 'draft' ? 'working draft' : 'planned'})</small>}</li>)}</ul>
      <p><a href="/learn/databases/relational/#collection">See the full collection →</a></p>
    </nav>
  </article>
</Base>
<style>
  .article-status { font:1rem/1.7 var(--font-sans); color:var(--color-text-secondary); max-width:38rem; }
  nav { margin-top:2.5rem; padding-top:1rem; border-top:1px solid var(--color-rule-strong); }
  nav p,nav li { font-size:1rem; }
  nav h2 { font-size:1.4rem; }
</style>
