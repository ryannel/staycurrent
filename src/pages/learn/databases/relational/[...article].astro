---
import RelationalArticle from '../../../../layouts/RelationalArticle.astro';
import { relationalAliases, relationalArticleHref, relationalPublication } from '../../../../lib/relational-collection';
export function getStaticPaths() {
  const pages = import.meta.glob('../../../../articles/relational/*.md', { eager: true });
  return [
    ...Object.values(pages).filter((page: any) => page.frontmatter.id !== 'RL76').map((page: any) => ({ params: { article: relationalPublication[page.frontmatter.id] }, props: { page } })),
    ...Object.entries(relationalAliases).map(([slug, target]) => ({ params: { article: slug }, props: { redirect: relationalArticleHref(target) } })),
  ];
}
const { page, redirect } = Astro.props;
if (redirect) return Astro.redirect(redirect);
const Content = page.Content;
---
<RelationalArticle frontmatter={page.frontmatter}><Content /></RelationalArticle>
