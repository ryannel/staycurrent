const commands = String.raw`pg_dump --format=custom --file=shop.dump sc_recovery_source
createdb --template=template0 sc_recovery_restore
pg_restore --exit-on-error --single-transaction --no-owner --no-acl \
  --dbname=sc_recovery_restore shop.dump
psql -X --set=ON_ERROR_STOP=1 --dbname=sc_recovery_restore -c 'ANALYZE;'`;
const reconcile = `WITH receipts(request_key, expected_amount) AS (
  VALUES ('req-a', 25.00), ('req-b', 8.00)
)
SELECT r.request_key, r.expected_amount, o.amount AS recovered_amount
FROM receipts AS r
LEFT JOIN orders AS o USING (request_key)
WHERE o.request_key IS NULL
   OR o.amount IS DISTINCT FROM r.expected_amount;`;
