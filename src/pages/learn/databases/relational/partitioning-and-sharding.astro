SELECT order_id, total FROM cap_partition_orders
WHERE tenant_id = 7;`;
const comparison = `WITH differences AS (
  (SELECT * FROM cap_move_source
   EXCEPT SELECT * FROM cap_move_destination)
  UNION ALL
  (SELECT * FROM cap_move_destination
   EXCEPT SELECT * FROM cap_move_source)
)
SELECT count(*) AS differing_rows FROM differences;`;
