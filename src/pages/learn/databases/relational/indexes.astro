const pending = `SELECT order_id, placed_at
FROM index_orders
WHERE status = 'pending'
ORDER BY placed_at DESC
LIMIT 10;`;
const dayIndex = `CREATE INDEX index_orders_day
ON index_orders (((placed_at AT TIME ZONE 'UTC')::date));`;
const day = `SELECT count(*)
FROM index_orders
WHERE (placed_at AT TIME ZONE 'UTC')::date = date '2026-02-01';`;
