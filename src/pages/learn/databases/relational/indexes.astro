const explain = (sql: string) => 'EXPLAIN (ANALYZE, BUFFERS)\n' + sql;
const steps = experimentText.slice(experimentText.indexOf('-- Sequential scan')).trim();
const lookup = `SELECT *
FROM index_orders
WHERE customer_id = 42;`;
const customerIndex = `CREATE INDEX index_orders_customer
ON index_orders (customer_id);`;
const range = `SELECT order_id, customer_id
FROM index_orders
