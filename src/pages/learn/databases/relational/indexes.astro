FROM pg_stat_user_indexes
WHERE relname = 'index_orders';`;
const plan = `Limit (actual rows=10.00 loops=1)
  Buffers: local hit=4
  ->  Index Only Scan using index_orders_cover on index_orders
        (actual rows=10.00 loops=1)
