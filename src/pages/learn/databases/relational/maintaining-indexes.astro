---
import ArticleBody from '../../../../components/editorial/ArticleBody.astro';
import TitleLine from '../../../../components/editorial/TitleLine.astro';
import Base from '../../../../layouts/Base.astro';
import Sql from '../../../../components/explainers/querying/Sql.astro';
import '../../../../styles/explorables.css';
import '../../../../styles/relational-design.css';

const docs = 'https://www.postgresql.org/docs/18/';
const mysql = 'https://dev.mysql.com/doc/refman/8.4/en/';
const sqlite = 'https://www.sqlite.org/';
const mssql = 'https://learn.microsoft.com/en-us/sql/';
const indexes = '/learn/databases/relational/indexes/';
const pgIndexes = '/learn/databases/relational/postgresql/indexes/';

const pgSizes = `-- Size of every index on a table, with how often it has been used
SELECT i.indexrelid::regclass AS index,
       pg_size_pretty(pg_relation_size(i.indexrelid)) AS size,
       s.idx_scan, s.last_idx_scan
FROM pg_index i
JOIN pg_stat_user_indexes s ON s.indexrelid = i.indexrelid
WHERE i.indrelid = 'orders'::regclass
ORDER BY pg_relation_size(i.indexrelid) DESC;`;

const innodbSizes = `-- Pages in each index of one table, from InnoDB's persistent statistics
SELECT index_name, stat_value * @@innodb_page_size AS bytes
FROM mysql.innodb_index_stats
WHERE database_name = 'shop' AND table_name = 'orders'
  AND stat_name = 'size';`;

const mssqlSizes = `-- Pages and page density for each index on a table
SELECT i.name, s.page_count,
       s.avg_page_space_used_in_percent AS density,
       s.avg_fragmentation_in_percent
FROM sys.dm_db_index_physical_stats(
       DB_ID(), OBJECT_ID('dbo.orders'), NULL, NULL, 'SAMPLED') AS s
JOIN sys.indexes AS i
  ON i.object_id = s.object_id AND i.index_id = s.index_id;`;

const sqliteSizes = `-- Pages and how full they are, per table and index (needs the dbstat table)
SELECT name, count(*) AS pages,
       round(avg(100.0 * (pgsize - unused) / pgsize), 1) AS percent_used
FROM dbstat
GROUP BY name
ORDER BY pages DESC;

PRAGMA page_count;       -- pages in the file
PRAGMA freelist_count;   -- pages in the file that hold nothing`;

const innodbRebuild = `-- Rebuilds the table and every index on it, in place; writes continue
ALTER TABLE orders FORCE, ALGORITHM=INPLACE, LOCK=NONE;`;

const mssqlRebuild = `-- Compacts leaf pages in place; always online, can be stopped at any time
ALTER INDEX orders_customer ON dbo.orders REORGANIZE;

-- Builds the index again; ONLINE = ON lets writes continue where the edition allows it
ALTER INDEX orders_customer ON dbo.orders REBUILD WITH (ONLINE = ON);`;

const invalid = `-- PostgreSQL: indexes that queries ignore and writes may still maintain
SELECT c.relname AS index, i.indrelid::regclass AS table_name,
       i.indisvalid, i.indisready
FROM pg_index i
JOIN pg_class c ON c.oid = i.indexrelid
WHERE NOT i.indisvalid;`;

const mssqlUsage = `-- SQL Server: reads and writes per index since the last restart
SELECT i.name, u.user_seeks, u.user_scans, u.user_lookups, u.user_updates
FROM sys.indexes AS i
LEFT JOIN sys.dm_db_index_usage_stats AS u
  ON u.object_id = i.object_id AND u.index_id = i.index_id
 AND u.database_id = DB_ID()
WHERE i.object_id = OBJECT_ID('dbo.orders');`;

const duplicates = `-- Indexes with exactly the same columns, operator classes, ordering and predicate
SELECT indrelid::regclass AS table_name,
       array_agg(indexrelid::regclass ORDER BY indexrelid) AS same_definition,
       bool_or(indisunique) AS one_enforces_a_constraint
FROM pg_index
GROUP BY indrelid, indkey, indclass, indcollation, indoption,
         coalesce(indexprs::text, ''), coalesce(indpred::text, '')
HAVING count(*) > 1;

-- Non-unique indexes whose columns are a leading prefix of another index
SELECT a.indexrelid::regclass AS shorter, b.indexrelid::regclass AS longer
FROM pg_index a
JOIN pg_index b
  ON a.indrelid = b.indrelid AND a.indexrelid <> b.indexrelid
 AND a.indnkeyatts < b.indnkeyatts
 AND (string_to_array(a.indkey::text, ' '))[1:a.indnkeyatts]
   = (string_to_array(b.indkey::text, ' '))[1:a.indnkeyatts]
 AND (string_to_array(a.indclass::text, ' '))[1:a.indnkeyatts]
   = (string_to_array(b.indclass::text, ' '))[1:a.indnkeyatts]
 AND a.indpred IS NOT DISTINCT FROM b.indpred
 AND a.indexprs IS NOT DISTINCT FROM b.indexprs
WHERE NOT a.indisunique AND a.indisvalid;`;

const mysqlRedundant = `SELECT table_name, redundant_index_name, dominant_index_name, sql_drop_index
FROM sys.schema_redundant_indexes;`;

const trialDrop = `-- MySQL: hide the index from the optimizer; it is still kept up to date
ALTER TABLE orders ALTER INDEX orders_customer INVISIBLE;
-- Something got slower? Undo it at once, without a rebuild
ALTER TABLE orders ALTER INDEX orders_customer VISIBLE;

-- SQL Server: disabling deletes the index's data but keeps its definition
ALTER INDEX orders_customer ON dbo.orders DISABLE;
-- Undoing it means building the index again
ALTER INDEX orders_customer ON dbo.orders REBUILD;
-- For a unique index, also re-enable the foreign keys that reference it
ALTER TABLE dbo.order_lines WITH CHECK CHECK CONSTRAINT fk_order_lines_orders;`;

const rollout = `-- 1. Build the replacement beside the old index (PostgreSQL)
CREATE INDEX CONCURRENTLY orders_customer_placed
  ON orders (customer_id, placed_at DESC);

-- 2. Confirm it finished
SELECT indisvalid FROM pg_index
WHERE indexrelid = 'orders_customer_placed'::regclass;

-- 3. Check the queries it is for: EXPLAIN (ANALYZE) and look for the new name

-- 4. After a representative period, compare scans on old and new
SELECT indexrelname, idx_scan, last_idx_scan
FROM pg_stat_user_indexes
WHERE relname = 'orders';

-- 5. Drop the old one without blocking
DROP INDEX CONCURRENTLY orders_customer;`;

const checks = `-- PostgreSQL: AccessShareLock, safe on a live primary or a standby
CREATE EXTENSION IF NOT EXISTS amcheck;
SELECT bt_index_check('orders_pkey', heapallindexed => true);

-- MySQL (InnoDB)
CHECK TABLE orders;

-- SQL Server
DBCC CHECKTABLE ('dbo.orders');

-- SQLite: one row 'ok', or one row per problem
PRAGMA integrity_check;`;
---
<Base title="Maintaining indexes" description="Running a set of indexes over years: why an index stays large after deletes, how to measure it in PostgreSQL 18, InnoDB, SQL Server and SQLite, when a rebuild is worth it and what each engine’s rebuild locks, building on a live table, finding unused and redundant indexes, trial drops and replacing an index safely.">
  <article class="visual-essay relational-design">
    <header class="essay-header"><p class="eyebrow">Databases and storage</p><h1>Maintaining indexes</h1><TitleLine type="Companion" version="PostgreSQL 18, with InnoDB (MySQL 8.4), SQL Server and SQLite comparisons" /></header>
<ArticleBody>

    <p>An index is built once and then lives for years while the table under it changes. Two things drift. An index can end up much larger than the rows it covers, and the set of indexes collects members that nothing uses, duplicates and half-finished builds. This companion to <a href={indexes}>Indexes</a> is about noticing each, choosing the repair, and knowing what the repair locks while it runs.</p>
    <p>The questions are the ones an on-call engineer asks. Why is this index 200 MB for a table with 100,000 live rows? Can it be rebuilt while the shop is taking orders? Which of the thirteen indexes on this table can go? PostgreSQL 18 is the worked example. The measurements come from PostgreSQL 18.6 and SQLite 3.54.0 on one laptop with million-row tables, and show sizes and blocking, not speed. InnoDB and SQL Server are described from their documentation.</p>

    <section aria-labelledby="why"><h2 id="why">Why an index stays large after deletes</h2>
      <p><a href={`${indexes}#deleted-rows`}>Indexes</a> showed the mechanism: a delete frees space inside a page, and a page is released only when it is completely empty. Whether a delete leaves an index sparse depends on how the deleted keys were spread through it.</p>

      <h3 id="empty-or-thin">Pages that empty and pages that thin out</h3>
      <p>Take a table of one million orders with indexes on <code>id</code> (the primary key), <code>customer_id</code> and <code>total</code> (both effectively random). In one copy, delete 90% of the rows at random. In another, delete the oldest 90% by <code>id</code>, as a retention job would. Then run <code>VACUUM</code> on both.</p>
      <div class="table-scroll" role="region" tabindex="0" aria-labelledby="thin-caption">
        <table>
          <caption id="thin-caption">Index state after deleting 90% of one million rows and running <code>VACUUM</code> (PostgreSQL 18.6)</caption>
          <thead><tr><th scope="col">Index</th><th scope="col">Size before and after</th><th scope="col">Leaf pages in use</th><th scope="col">Pages emptied</th><th scope="col">Average leaf density</th></tr></thead>
          <tbody>
            <tr><th scope="row">Primary key, 90% deleted at random</th><td>21 MB, 21 MB</td><td>2,733</td><td>0</td><td>9%</td></tr>
            <tr><th scope="row"><code>customer_id</code>, deleted at random</th><td>7.8 MB, 7.8 MB</td><td>969</td><td>0</td><td>19%</td></tr>
            <tr><th scope="row">Primary key, oldest 90% deleted</th><td>21 MB, 21 MB</td><td>274</td><td>2,467</td><td>90%</td></tr>
            <tr><th scope="row"><code>total</code>, oldest 90% deleted</th><td>30 MB, 30 MB</td><td>3,832</td><td>0</td><td>6.7%</td></tr>
          </tbody>
        </table>
      </div>
      <p>The <code>total</code> index shows the trap. It sat on the same table as the tidy primary key and came out as sparse as the random-delete indexes, because its keys are unrelated to age. Which indexes go sparse depends on how each key relates to whatever decides which rows are deleted. No index file got smaller, but deleting the oldest keys emptied 2,467 primary-key pages, which are available for new entries, so that index is not bloated in the sense that matters.</p>
      <p>Emptied pages come back into use only after a later <code>VACUUM</code>, once no running transaction could still follow a link into them. So one vacuum after a large delete is not the end of the story. <a href={`${pgIndexes}#bloat`}>Indexes in PostgreSQL</a> measures the delay, and the defences PostgreSQL has against update churn.</p>

      <h3 id="engines">InnoDB, SQL Server and SQLite</h3>
      <p>InnoDB marks a deleted record and removes it later in a background purge. When a delete leaves a page less than half full (<code>MERGE_THRESHOLD</code>, 50 by default), it tries to merge the page with a neighbour, so it resists the 10%-full pages above, though its pages still vary between half and fully full. The table is itself an index ordered by primary key, so its sparse pages count too.</p>
      <p>SQL Server releases emptied pages but, like PostgreSQL, doesn’t merge partly full ones until the index is reorganized or rebuilt. SQLite puts emptied pages on a <strong>freelist</strong> and reuses them before growing the file. Deleting 90% of a million rows left the SQLite file at its original 27,705 pages, 23,741 of them on the freelist, and the random-key indexes about 46% full. In every engine the file stays the size of its peak until something rewrites it.</p>
    </section>

    <section aria-labelledby="measure"><h2 id="measure">Measuring size and bloat</h2>
      <p>No engine reports bloat as a number. Each gives you sizes, and most say how full the pages are. The judgement is yours: is this index larger than it needs to be, and will the space come back into use by itself?</p>

      <h3 id="baseline">How large should it be?</h3>
      <p>Divide the index size by the number of live rows. The million-row primary key was 21 MB, about 22 bytes an entry, and after a rebuild the 100,000 surviving rows took 2.2 MB, the same 22 bytes. That ratio is your baseline for an index with that key. A rebuilt PostgreSQL B-tree fills its leaf pages to 90%, and InnoDB fills a rebuilt index to about 15/16.</p>
      <p>Two cheap checks need only sizes. Compare the ratio with a fresh copy, such as a database restored from a logical dump, which builds every index from scratch. And watch growth: an index that keeps growing while the live row count is flat has pages that aren’t being reused.</p>

      <h3 id="measure-pg">PostgreSQL</h3>
      <p><code>pg_relation_size</code> gives the size of an index, and <code>pg_stat_user_indexes</code> how often it has been scanned. Together they put the biggest, least-used indexes first.</p>
      <Sql code={pgSizes} label="List the indexes on a table with size and scan counts" />
      <p>For page density, the <code>pgstattuple</code> extension’s <code>pgstatindex</code> reads the whole index and reports the average leaf density: about 90 for a fresh index, 9 and 19 for the random-delete indexes above. <a href={`${pgIndexes}#bloat`}>Indexes in PostgreSQL</a> shows how to read it.</p>

      <h3 id="measure-innodb">InnoDB</h3>
      <p>InnoDB keeps index sizes in its persistent statistics: the <code>size</code> row of <code>mysql.innodb_index_stats</code> is the index’s page count, refreshed with the statistics. There is no page-density report, so judge by size per live row against a baseline. The table itself appears as <code>PRIMARY</code>.</p>
      <Sql code={innodbSizes} label="List InnoDB index sizes for one table" />

      <h3 id="measure-sqlserver">SQL Server</h3>
      <p><code>sys.dm_db_index_physical_stats</code> reports pages, page density and fragmentation for each index. Density needs the <code>SAMPLED</code> or <code>DETAILED</code> mode.</p>
      <Sql code={mssqlSizes} label="Report page counts and density for each index in SQL Server" />
      <p>Microsoft’s guidance is to look at density before fragmentation. Fragmentation measures how far the pages’ order on disk has drifted from key order, which matters little on solid-state storage. Low density means more pages to read and cache for the same rows.</p>

      <h3 id="measure-sqlite">SQLite</h3>
      <p>The <code>dbstat</code> virtual table gives one row per page with the bytes in use, when SQLite was compiled with <code>SQLITE_ENABLE_DBSTAT_VTAB</code>. <code>PRAGMA freelist_count</code> against <code>page_count</code> says how much of the file is empty.</p>
      <Sql code={sqliteSizes} label="Report page counts and fullness per b-tree in SQLite" />
    </section>

    <section aria-labelledby="rebuild"><h2 id="rebuild">Rebuilding an index</h2>
      <p>A rebuild reads the live entries, sorts them and writes a fresh index with full pages. It is the one operation that returns the space in a thin index, and it costs a full read plus the writes, so the questions are when it is worth it and what it holds up.</p>

      <h3 id="when-rebuild">When a rebuild is worth doing</h3>
      <p>Not on a calendar. A weekly rebuild of every index spends I/O and log volume, and for most indexes changes nothing. Rebuild when you have measured an index at many times its baseline size, the table isn’t about to grow back into it, and the space matters: disk close to full, backups and replicas that copy it, or a working set that no longer fits in memory because of half-empty pages (<a href="/learn/databases/relational/buffer-pool/">The buffer pool</a> shows why that costs reads). A table that is purged and refilled each month already reuses its space, and a rebuild saves nothing.</p>
      <p>Be careful what you credit a rebuild with. A rebuild also refreshes the index’s statistics, from every row, and Microsoft’s maintenance guidance notes that the speed-up people see after a rebuild often comes from those statistics; updating them alone gets the same gain more cheaply. Before scheduling rebuilds because queries got faster after one, try refreshing statistics instead, as <a href="/learn/databases/relational/query-execution/#refresh">When statistics are refreshed</a> describes.</p>

      <h3 id="reindex">PostgreSQL: REINDEX</h3>
      <p>Plain <code>REINDEX</code> blocks writes to the table and most queries on it. <code>REINDEX INDEX CONCURRENTLY</code> builds a second copy while writes continue and swaps it in, so it needs room for both. Rebuilding the randomly emptied indexes above took the four of them from about 72 MB to 8 MB. <a href={`${pgIndexes}#bloat`}>Indexes in PostgreSQL</a> covers the locks, the copy a failed run leaves behind and how to watch a rebuild that is waiting.</p>

      <h3 id="rebuild-innodb">InnoDB: the table is rebuilt, not one index</h3>
      <p>InnoDB has no statement that rebuilds one secondary index. <code>OPTIMIZE TABLE</code> maps to <code>ALTER TABLE ... FORCE</code>, which copies the rows into a new table file in place, with every index. Reads and writes continue, with a brief exclusive metadata lock at the start and the end, and the end waits for older transactions. Tables with a <code>FULLTEXT</code> index fall back to a copy that blocks writes. The <code>ALTER</code> form lets you demand that nothing blocks:</p>
      <Sql code={innodbRebuild} label="Rebuild an InnoDB table and its indexes without blocking writes" />
      <p>With one file per table, the default, the old file’s space goes back to the operating system. To rebuild one index alone, drop and add it in one statement, <code>ALTER TABLE orders DROP INDEX i, ADD INDEX i (...)</code>; two statements would leave a window with no index.</p>

      <h3 id="rebuild-sqlserver">SQL Server: reorganize or rebuild</h3>
      <p>SQL Server offers two operations. <code>REORGANIZE</code> compacts the leaf pages in place, is always online and can be stopped part way without losing its progress. <code>REBUILD</code> builds the index again and updates its statistics; with <code>ONLINE = ON</code> writes continue, but online index operations aren’t available in every edition, so check yours.</p>
      <Sql code={mssqlRebuild} label="Reorganize or rebuild one SQL Server index" />

      <h3 id="rebuild-sqlite">SQLite: REINDEX frees pages, VACUUM shrinks the file</h3>
      <p><code>REINDEX</code> in SQLite rebuilt the customer index from 46% to 99% full, but the file stayed 27,705 pages, with the freed pages on the freelist. Only <code>VACUUM</code> rewrites the file, here from 27,705 pages to 2,674. It holds the single write lock throughout and can need twice the database size in free disk. <code>VACUUM INTO 'file'</code> writes a compacted copy without touching the original.</p>

      <h3 id="rebuild-summary">The rebuild options side by side</h3>
      <div class="table-scroll" role="region" tabindex="0" aria-labelledby="rebuild-caption">
        <table>
          <caption id="rebuild-caption">What each rebuild does to writers and to the disk</caption>
          <thead><tr><th scope="col">Operation</th><th scope="col">What it rebuilds</th><th scope="col">Writes during it</th><th scope="col">Needs</th></tr></thead>
          <tbody>
            <tr><th scope="row">PostgreSQL <code>REINDEX INDEX</code></th><td>One index</td><td>Blocked, and most queries on the table too</td><td>Room for the new copy</td></tr>
            <tr><th scope="row">PostgreSQL <code>REINDEX INDEX CONCURRENTLY</code></th><td>One index</td><td>Allowed; waits for older transactions</td><td>Room for both copies</td></tr>
            <tr><th scope="row">InnoDB <code>ALTER TABLE ... FORCE</code></th><td>Table and all indexes</td><td>Allowed; brief exclusive locks at start and end</td><td>Room for the new file</td></tr>
            <tr><th scope="row">SQL Server <code>REORGANIZE</code></th><td>One index’s leaf pages, in place</td><td>Allowed</td><td>Little extra</td></tr>
            <tr><th scope="row">SQL Server <code>REBUILD</code></th><td>One index</td><td>Blocked, or allowed with <code>ONLINE = ON</code> where the edition offers it</td><td>Room for the new copy</td></tr>
            <tr><th scope="row">SQLite <code>VACUUM</code></th><td>The whole file</td><td>One writer at a time, for the whole run</td><td>Up to twice the file in free disk</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="build"><h2 id="build">Building new indexes safely</h2>
      <p>A new index is a maintenance operation too, and the lock it takes is the first thing to know:</p>
      <ul>
        <li><strong>PostgreSQL:</strong> <code>CREATE INDEX</code> blocks writes until it finishes. <code>CREATE INDEX CONCURRENTLY</code> doesn’t, at the price of a second pass over the table and a wait for older transactions; <a href={`${pgIndexes}#concurrently`}>Indexes in PostgreSQL</a> explains why. Raising <code>maintenance_work_mem</code> for the session speeds the sort.</li>
        <li><strong>InnoDB:</strong> adding a secondary index is in place and allows concurrent writes, without rebuilding the table. It finishes only after transactions that were using the table have ended, and fails if the log of concurrent changes outgrows <code>innodb_online_alter_log_max_size</code>.</li>
        <li><strong>SQL Server:</strong> <code>CREATE INDEX ... WITH (ONLINE = ON)</code> allows writes, in the editions that offer online index operations.</li>
        <li><strong>SQLite:</strong> the build holds the single write lock, so every other writer waits for it.</li>
      </ul>
      <p>In every engine, put a bound on how long the command may wait for its locks, as <a href="/learn/databases/relational/schema-changes/#schema-locks">Schema locks and timeouts</a> describes, because a command stuck behind a long transaction holds up everything queued after it. When you are loading a table, rather than changing a live one, create the indexes after the load, as <a href={`${indexes}#upkeep`}>Building, finding and dropping indexes</a> explains.</p>

      <h3 id="build-replicas">Replicas</h3>
      <p>A build runs on the primary and then reaches each replica. PostgreSQL’s physical standbys replay the write-ahead log it produced, roughly the size of the index. MySQL replicas normally run the same <code>ALTER</code> themselves, so a long build on the primary becomes a long stretch on each replica during which later changes queue. Watch replication delay while a large build runs.</p>
    </section>

    <section aria-labelledby="drop"><h2 id="drop">Finding indexes to remove</h2>
      <p>Every index costs space and write work whether or not any query uses it. There are three kinds to look for, each with its own test, and then the question of how to drop one safely.</p>

      <h3 id="drop-unused">Unused indexes</h3>
      <p>PostgreSQL counts index scans in <code>pg_stat_user_indexes</code> and, since version 16, records <code>last_idx_scan</code>. MySQL’s sys schema lists unused indexes in <code>schema_unused_indexes</code>. SQL Server counts seeks, scans, lookups and updates per index in <code>sys.dm_db_index_usage_stats</code>. SQLite keeps no usage counts. The PostgreSQL query is in <a href="#measure-pg">Measuring size and bloat</a>; the SQL Server one follows.</p>
      <Sql code={mssqlUsage} label="Reads and writes per index in SQL Server" />
      <p>A zero is evidence only if the counters have covered everything the system does:</p>
      <ul>
        <li><strong>Resets.</strong> PostgreSQL resets its counters after an unclean shutdown or point-in-time recovery. MySQL’s and SQL Server’s start empty at every server restart, and SQL Server’s also when a database is detached or shut down. Right after a restart every index looks unused.</li>
        <li><strong>Replicas.</strong> Each replica keeps its own counts, so look at every one that serves reads.</li>
        <li><strong>Rare jobs.</strong> A monthly report or year-end job may use an index nothing else touches.</li>
        <li><strong>Constraints.</strong> An index that enforces a primary key or unique constraint stays however few scans it records, and so does one on a foreign key’s referencing column if parent rows are deleted.</li>
      </ul>
      <p>The opposite advice comes from the same engines. SQL Server’s missing-index suggestions and similar advisers propose indexes from single queries’ estimates. Microsoft calls them a starting point, not a prescription: they don’t order the columns for you, never suggest unique or filtered indexes, and are cleared on restart. Weigh each against the indexes you already have, as <a href={`${indexes}#design`}>Designing an index for a query</a> does.</p>

      <h3 id="drop-duplicate">Duplicate and redundant indexes</h3>
      <p>An index on <code>(customer_id)</code> is redundant beside <code>(customer_id, placed_at)</code>, because the longer index serves a lookup on its leading column, and both cost writes. The first PostgreSQL query below finds exact duplicates, and the second finds non-unique indexes that are a leading prefix of another. If <code>one_enforces_a_constraint</code> is true, keep the unique index and drop its plain twin.</p>
      <Sql code={duplicates} label="Find duplicate and prefix-redundant indexes in PostgreSQL" />
      <p>Both queries ignore two things to check by eye before dropping: <code>INCLUDE</code> columns, which may make the shorter index the one that covers a query, and a descending column, where the prefix doesn’t give the same order. In InnoDB, also check that the shorter index isn’t the one backing a foreign key. MySQL’s <code>sys.schema_redundant_indexes</code> does this search and prints the <code>DROP</code> statement.</p>
      <Sql code={mysqlRedundant} label="List redundant indexes with MySQL's sys schema" />

      <h3 id="drop-invalid">Invalid indexes</h3>
      <p>A PostgreSQL concurrent build or rebuild that stops part way, cancelled by a timeout, a deadlock or a unique violation, leaves an invalid index behind. Queries ignore it, but if <code>indisready</code> is true, writes still maintain it, so it costs every write for nothing.</p>
      <Sql code={invalid} label="Find invalid indexes in PostgreSQL" />
      <p>Drop it with <code>DROP INDEX CONCURRENTLY</code> and run the build again. Check for these after any failed migration, and consider alerting on any row. SQL Server’s equivalent check is for indexes left disabled: <code>is_disabled</code> in <code>sys.indexes</code>.</p>

      <h3 id="drop-safely">Dropping without making things worse</h3>
      <p>A plain <code>DROP INDEX</code> in PostgreSQL takes an exclusive lock on the table, stopping reads and writes until it finishes. <code>DROP INDEX CONCURRENTLY</code> waits for conflicting transactions instead, one index per statement and not inside a transaction block. An index behind a unique or primary-key constraint is dropped with <code>ALTER TABLE ... DROP CONSTRAINT</code>.</p>
      <p>The risk of dropping is a query you forgot. Two engines let you rehearse:</p>
      <Sql code={trialDrop} label="Trial drops in MySQL and SQL Server" />
      <p>A MySQL <strong>invisible</strong> index is ignored by the optimizer but still maintained, so making it visible again is instant. A SQL Server <strong>disabled</strong> index is different: its data is deleted and only its definition kept, so it costs no writes, but undoing it means a full rebuild. Disabling a unique index also disables the foreign keys that reference it, and they stay off after the rebuild until you re-enable them with <code>ALTER TABLE … WITH CHECK CHECK CONSTRAINT</code>. Disabling a clustered index makes the whole table unreadable, so disable only nonclustered indexes. PostgreSQL and SQLite have no equivalent; keep the <code>CREATE INDEX</code> statement and the time and disk to run it again.</p>
    </section>

    <section aria-labelledby="rollout"><h2 id="rollout">Replacing an index in production</h2>
      <p>Changing an index, to add a column, change the order or make it partial, is a build, a check and a drop, in that order, with both indexes present in between. Never drop first: queries that depended on the old index run against the table until the new one exists. In PostgreSQL:</p>
      <Sql code={rollout} label="Build, verify, compare and drop a replacement index" />
      <p>Step 2 matters because a failed concurrent build can look like a finished command to a migration tool that ignores the error. Step 3 is the point of the exercise: read the plans for the queries the new index is for, on production-shaped data. In MySQL, replace step 5 with making the old index invisible, waiting, then dropping it. In SQL Server, build with <code>ONLINE = ON</code> where the edition allows it. In SQLite, create the new index, check the plans with <code>EXPLAIN QUERY PLAN</code>, drop the old one and run <code>PRAGMA optimize</code>.</p>
    </section>

    <section aria-labelledby="integrity"><h2 id="integrity">Checking that an index is sound</h2>
      <p>An index can be wrong without any query reporting it: entries out of order, entries missing for rows that exist. The cause to know about is a change to the rules that sort text. If the operating-system library that supplies collations changes under a text index, as can happen when a replica or restored server runs a different OS version, the stored order stops matching the order the server expects, and lookups quietly miss rows.</p>
      <Sql code={checks} label="Check index integrity in four engines" />
      <p>PostgreSQL’s <code>bt_index_check</code> takes only the lock a <code>SELECT</code> takes and works on a standby; with <code>heapallindexed</code> it also checks that every row has its entry, at several times the cost. A passing check shows only that this test found nothing. InnoDB’s <code>CHECK TABLE</code>, SQL Server’s <code>DBCC CHECKTABLE</code> and SQLite’s <code>PRAGMA integrity_check</code> check structure and entry counts, and can be slow on large tables. When a check finds a bad index, rebuilding it is usually the repair, but treat the cause as the problem: what damaged it once can do so again.</p>
    </section>

