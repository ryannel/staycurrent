---
import Base from '../../../../layouts/Base.astro';
import { sandboxTutorials } from '../../../../lib/sql-sandbox-tutorials';
import { relationalCollection, relationalArticleHref } from '../../../../lib/relational-collection';
const lessonGroups = relationalCollection.map(group => ({ title: group.title, lessons: sandboxTutorials.filter(lesson => group.articles.some(article => lesson.articleHref.split('#')[0] === relationalArticleHref(article.slug))) })).filter(group => group.lessons.length);
const grouped = new Set(lessonGroups.flatMap(group => group.lessons.map(lesson => lesson.id)));
const otherLessons = sandboxTutorials.filter(lesson => !grouped.has(lesson.id));
if (otherLessons.length) lessonGroups.push({ title: 'Explore the foundations', lessons: otherLessons });
---
<Base title="SQL sandbox" description="Run PostgreSQL in your browser with guided lessons on queries, transactions, performance, operations and database internals.">
  <article class="sandbox-page">
    <header class="page-heading"><p class="eyebrow">Playgrounds / PostgreSQL</p><h1>SQL sandbox</h1><p>Try a query. Change it. See what the database does.</p></header>
    <noscript><p>This sandbox needs JavaScript. You can <a href="/learn/databases/relational/practice/">run the SQL practice on your computer</a>.</p></noscript>
    <div class="sandbox" data-sandbox>
      <section class="launch" data-launch aria-label="Start practising">
        <div class="launch-main"><p class="eyebrow" data-launch-label>New to SQL? Start here</p><h2 data-launch-title>From product IDs to an order</h2><p data-preview>Read a shop’s records, join a product name to a purchase and calculate its total.</p><p class="sandbox-note" data-launch-count>4 guided steps · Editable SQL</p><button class="primary" type="button" data-start disabled>Start first lesson →</button></div>
        <div class="launch-free"><h2>Have a query in mind?</h2><p>Explore a small shop database with five tables, or write SQL of your own.</p><button type="button" data-explore disabled>Explore freely →</button><button class="text-button" type="button" data-browse disabled>Browse all {sandboxTutorials.length} lessons →</button></div>
        <p class="launch-note sandbox-note">Nothing to install. SQL runs in this browser tab. Leaving or restarting discards your practice data.</p>
      </section>
      <div class="sandbox-workspace" hidden data-workspace>
        <div class="workspace-bar"><div><p class="eyebrow" data-mode>Guided lesson</p><h2 data-session-title></h2></div><div class="workspace-actions"><button type="button" data-browse>Change lesson</button><button type="button" data-reset>Restart lesson</button></div></div>
        <div class="work-grid">
          <aside class="lesson-column">
            <section class="tutorial-guide" data-guide hidden aria-labelledby="step-title">
              <p class="step-count" data-step-count></p><progress data-progress aria-label="Lesson progress" max="1" value="0"></progress>
              <h3 id="step-title" data-step-title tabindex="-1"></h3><p data-instruction></p>
              <details class="step-outline"><summary>Steps in this lesson</summary><ol data-step-list></ol><p class="sandbox-note">Each step builds on the previous one. Restart the lesson to return to its original data.</p></details>
              <a data-article class="article-link">Read the explanation ↗</a>
              <a data-guide-link class="article-link">Link to this lesson</a>
            </section>
            <section data-free-guide hidden><p class="step-count">Explore freely</p><h3>A small shop, ready to query</h3><p>Run the query to see the products. Then edit it, or load another table below.</p><details class="schema-reference" open><summary>Shop tables</summary><ul>{[
              ['customers', 'customer_id, name'], ['products', 'product_id, name, current_price, sku'], ['orders', 'order_id, customer_id, placed_at'], ['order_lines', 'order_id, line_no, product_id, quantity, unit_price'], ['stock', 'product_id, available']
            ].map(([name, columns]) => <li><button type="button" data-sample={name}>{name}</button><code>{columns}</code></li>)}</ul><p class="sandbox-note">Prices are in EUR. P7 is the Blue mug; three are available. Historical orders are already accounted for.</p></details></section>
          </aside>
          <div class="query-column">
            <section class="sql-editor" aria-labelledby="editor-title"><div class="editor-heading"><h3 id="editor-title">SQL editor</h3><span class="sandbox-note">Ctrl / ⌘ + Enter</span></div><label class="sr-only" for="sandbox-sql">SQL to send to PostgreSQL</label><textarea id="sandbox-sql" data-editor spellcheck="false" autocapitalize="off" autocomplete="off" rows="7">SELECT * FROM products;</textarea>
              <div class="run-bar"><button type="button" class="primary" data-run>Run SQL ▶</button><button type="button" data-stop hidden>Stop &amp; discard database</button><span class="transaction-state" data-transaction>No active database</span></div>
              <p class="sandbox-note editor-note">Run sends everything in the editor. You can change the SQL and run it again.</p>
            </section>
            <p class="session-status" data-status role="status" aria-live="polite">Enable JavaScript to start the database.</p>
            <section class="sandbox-results" aria-labelledby="results-title"><div class="results-heading"><h3 id="results-title" tabindex="-1" data-results-title>Result</h3><div class="result-tools"><button class="text-button" type="button" data-edit-query>Edit SQL ↑</button><button class="text-button" type="button" data-clear hidden>Clear results</button></div></div><p data-empty>Run the SQL above to see its result here.</p><div data-results></div>
              <details class="expected-panel" data-expected-panel hidden><summary>Compare with the lesson</summary><p data-expected></p><p class="sandbox-note" data-edited hidden>You changed the example. Compare your query with the lesson before drawing the same conclusion.</p></details>
              <div class="step-finish"><button type="button" class="primary" data-continue hidden>Next step →</button><div data-complete hidden><h3>Lesson complete</h3><p>You’ve run every step. Try a variation in the editor, revisit the article, or choose another lesson.</p><button type="button" data-browse>Choose another lesson →</button></div></div>
            </section>
            <details class="run-history" data-history-panel hidden><summary data-history-label>Previous runs</summary><div data-history></div></details>
          </div>
        </div>
        <details class="workspace-help"><summary>Database help &amp; session controls</summary><div class="help-grid"><section><h3>Your session</h3><p>One connection stays open between runs. Without explicit transaction commands, PostgreSQL treats everything in one run as one transaction: an error rolls back earlier changes in that batch. Send separate runs to inspect an answer before continuing.</p><p>Restart restores the original shop, clears results and returns a lesson to step one. Leaving or reloading this page also discards the database.</p><button type="button" data-schema>Load current schema query</button><p class="sandbox-note">Loading a query changes the editor; it does not run it.</p></section><section><h3>Reading a response</h3><p><code>SELECT 2</code> means two rows were returned. <code>UPDATE 1</code> means one row matched the update. In <code>INSERT 0 1</code>, the final 1 counts inserted rows. Changes in an open transaction still need <code>COMMIT</code>.</p><p>A failed transaction needs <code>ROLLBACK</code> before another statement can succeed. An error may be the point of a lesson; compare its explanation with the database response.</p></section></div></details>
      </div>
      <p class="entry-message" data-entry-message role="status"></p>
      <dialog class="lesson-dialog" data-chooser aria-labelledby="lessons-title"><div class="chooser-heading"><div><p class="eyebrow">SQL sandbox</p><h2 id="lessons-title">Find a lesson</h2></div><button type="button" data-close aria-label="Close lesson chooser">Close ✕</button></div><p>Choose a question to explore. Starting a lesson creates a fresh database.</p><button type="button" data-free-choice>Explore freely without a lesson →</button><div class="lesson-filters"><label>Search lessons<input type="search" data-search placeholder="Try indexes, joins or recovery" /></label><label>Subject<select data-subject><option value="">All subjects</option>{lessonGroups.map(group=><option value={group.title}>{group.title}</option>)}</select></label></div><p class="sandbox-note" data-lesson-count role="status">{sandboxTutorials.length} lessons</p>
        <div id="lessons" class="lesson-catalogue">{lessonGroups.map(group => <section data-lesson-group={group.title}><h3>{group.title}</h3><ul>{group.lessons.map(lesson => <li data-lesson-card data-search-text={`${lesson.title} ${lesson.description} ${group.title}`.toLowerCase()}><h4>{lesson.title}</h4><p>{lesson.description}</p><div class="lesson-card-actions"><button type="button" data-choose={lesson.id}>Start lesson →</button><span>{lesson.steps.length} steps</span><a href={lesson.articleHref}>Article ↗</a></div></li>)}</ul></section>)}</div><p data-no-lessons hidden>No lessons match. Try another term or choose “All subjects”.</p>
      </dialog>
      <details class="sandbox-limits"><summary>About this playground</summary><p>This is PostgreSQL running locally through <a href="https://pglite.dev/">PGlite</a>, with one connection and disposable data. It supports SQL, not psql’s backslash commands. It does not reproduce separate concurrent connections, network failures or server performance.</p><p>Large results show at most 200 rows and 40 columns per statement, 2,000 characters per cell, 5,000 cells, 250,000 cell characters and 50 responses per run. The editor accepts up to 100,000 characters. The five most recent runs are kept. A run lasting 20 seconds automatically discards its session; you can stop it sooner.</p><p><a href="/learn/databases/relational/practice/">Run PostgreSQL on your own computer →</a></p></details>
    </div>
  </article>
</Base>
<script>import '../../../../lib/sql-sandbox-client';</script>
<style>
  :global(body:has(.sandbox-page) main) { max-width:78rem; }
  :global(body:has(.sandbox-page) .reading-navigation) { margin-bottom:1.25rem; }
  :global(body:has(.sandbox-page) .article-switcher) { display:none; }
  .sandbox-page { font-family:var(--font-sans); --blue:#375f7b; --blue-soft:#e9eff2; --amber:#896b36; }
  :global(:where(:root[data-theme="dark"])) .sandbox-page { --blue:#a4c6de; --blue-soft:#25343e; --amber:#d6ac67; }
@media (prefers-color-scheme: dark) { :global(:where(:root:not([data-theme]))) .sandbox-page { --blue:#a4c6de; --blue-soft:#25343e; --amber:#d6ac67; } }
  .page-heading { margin-bottom:1.7rem; }
  .page-heading h1 { font-family:var(--font-serif); margin:.4rem 0; font-size:2.5rem; }
  .page-heading p { margin:.5rem 0; }
  .sandbox-page:has([data-workspace]:not([hidden])) .page-heading p { display:none; }
  .sandbox-page:has([data-workspace]:not([hidden])) .page-heading h1 { font-size:1.7rem; }
  .sandbox-page:has([data-workspace]:not([hidden])) .page-heading { margin-bottom:1rem; }
  h2 { font-size:1.2rem; line-height:1.4; margin:0 0 .7rem; }
  h3 { font-size:1rem; line-height:1.5; margin:0 0 .6rem; }
  p { line-height:1.6; }
  .launch { display:grid; grid-template-columns:1.35fr 1fr; border:1px solid var(--color-rule); border-radius:6px; overflow:hidden; }
  .launch-main,.launch-free { padding:2rem; }
  .launch-main { background:var(--color-surface-alt); border-top:3px solid var(--blue); }
  .launch-main h2 { font-size:1.55rem; max-width:25rem; }
  .launch-free { border-top:3px solid transparent; }
  .launch-free .text-button { display:block; margin-top:.8rem; }
  .launch-note { grid-column:1/-1; padding:1rem 2rem; margin:0; border-top:1px solid var(--color-rule); }
  button,input,select,textarea { font:inherit; color:var(--color-text); background:var(--color-surface); border:1px solid var(--color-rule-strong); border-radius:4px; }
  button { cursor:pointer; font-size:.85rem; font-weight:500; min-height:44px; padding:.65rem .9rem; }
  button:hover:not(:disabled) { background:var(--color-surface-alt); border-color:var(--blue); }
  button:disabled { opacity:.5; cursor:default; }
  button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible { outline:2px solid var(--blue); outline-offset:3px; }
  .primary { color:var(--color-surface); background:var(--blue); border-color:var(--blue); font-weight:600; }
  .primary:hover:not(:disabled) { background:var(--blue); color:var(--color-surface); filter:brightness(.9); }
  .text-button { background:transparent; border-color:transparent; color:var(--color-accent); padding-inline:.25rem; }
  .sandbox-note { color:var(--color-text-secondary); font-size:.8rem; }
  .workspace-bar { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:1rem 0; border-block:1px solid var(--color-rule); margin-bottom:1.5rem; }
  .workspace-bar .eyebrow { margin:0 0 .3rem; }
  .workspace-bar h2 { margin:0; font-size:1.1rem; }
  .workspace-actions { display:flex; gap:.5rem; flex-shrink:0; }
  .work-grid { display:grid; grid-template-columns:minmax(15rem,1fr) minmax(0,2.15fr); gap:2rem; }
  .lesson-column { min-width:0; padding-right:1.5rem; border-right:1px solid var(--color-rule); }
  .tutorial-guide { position:sticky; top:1rem; }
  .step-count { font-size:.8rem; color:var(--blue); font-weight:600; margin:0 0 .6rem; }
  progress { appearance:none; height:4px; width:100%; border:0; margin:0 0 1.2rem; background:var(--color-rule); color:var(--blue); }
  progress::-webkit-progress-bar { background:var(--color-rule); border-radius:4px; }
  progress::-webkit-progress-value { background:var(--blue); border-radius:4px; }
  progress::-moz-progress-bar { background:var(--blue); }
  [data-step-title] { font-family:var(--font-serif); font-size:1.4rem; line-height:1.3; }
  [data-instruction] { font-size:.95rem; }
  details { margin:1rem 0; }
  summary { cursor:pointer; color:var(--color-accent); line-height:1.5; padding:.3rem 0; }
  .step-outline { font-size:.8rem; margin-top:1.5rem; }
  .step-outline ol { padding-left:1.3rem; }
  .step-outline li { margin:.6rem 0; color:var(--color-text-secondary); }
  .step-outline li[aria-current="step"] { color:var(--blue); font-weight:600; }
  .article-link { display:block; font-size:.8rem; margin:.8rem 0; }
  .editor-heading,.results-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.5rem; margin-bottom:.6rem; }
  .editor-heading h3,.results-heading h3 { margin:0; }
  textarea { display:block; width:100%; box-sizing:border-box; padding:1rem; font:.9rem/1.6 var(--font-mono); tab-size:2; resize:vertical; min-height:12rem; background:var(--color-surface-alt); }
  .run-bar { display:flex; flex-wrap:wrap; align-items:center; gap:.7rem; margin-top:.75rem; }
  .transaction-state { margin-left:auto; font-size:.75rem; color:var(--color-text-secondary); max-width:100%; }
  .transaction-state[data-state="T"] { color:var(--blue); }
  .transaction-state[data-state="E"] { color:var(--amber); font-weight:600; }
  .editor-note { margin:.6rem 0 0; }
  .session-status { font-size:.85rem; min-height:1.5em; padding:.7rem .9rem; margin:1rem 0; background:var(--blue-soft); border-radius:4px; }
  .sandbox-results { border:1px solid var(--color-rule); border-radius:5px; padding:1.1rem; scroll-margin-top:1rem; }
  .sandbox-results [data-empty] { color:var(--color-text-secondary); font-size:.9rem; }
  .result-tools { display:flex; gap:.7rem; }
  .results-heading .text-button { min-height:32px; padding-block:.2rem; font-size:.75rem; }
  .expected-panel { border-top:1px solid var(--color-rule); margin:1rem 0 0; padding-top:.8rem; font-size:.9rem; }
  .step-finish { margin-top:1rem; }
  .step-finish:empty { display:none; }
  [data-complete] { background:var(--blue-soft); padding:1rem; border-radius:4px; font-size:.9rem; }
  [data-complete] h3 { color:var(--blue); }
  .run-history,.workspace-help,.sandbox-limits { font-size:.85rem; }
  .workspace-help { border-block:1px solid var(--color-rule); margin-top:2rem; padding:.6rem 0; }
  .help-grid { display:grid; grid-template-columns:1fr 1fr; gap:2rem; padding:1rem; }
  .schema-reference { font-size:.85rem; }
  .schema-reference ul { list-style:none; padding:0; }
  .schema-reference li { margin:.8rem 0; }
  .schema-reference code { display:block; overflow-wrap:anywhere; font-size:.7rem; margin:.4rem 0; }
  .schema-reference button { font-family:var(--font-mono); padding:.3rem .6rem; }
  .entry-message:empty { display:none; }
  .lesson-dialog { max-width:min(64rem,calc(100vw - 2rem)); max-height:85vh; box-sizing:border-box; width:64rem; padding:1.5rem 2rem; border:1px solid var(--color-rule-strong); border-radius:8px; color:var(--color-text); background:var(--color-surface); }
  .lesson-dialog::backdrop { background:#0009; }
  .chooser-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .chooser-heading .eyebrow { margin:0 0 .3rem; }
  .chooser-heading h2 { margin:0; font-size:1.5rem; }
  .lesson-filters { margin-top:1rem; display:grid; grid-template-columns:1.2fr 1fr; gap:1rem; }
  .lesson-filters label { font-size:.8rem; }
  input,select { display:block; box-sizing:border-box; width:100%; min-height:44px; padding:.6rem; margin-top:.4rem; }
  .lesson-catalogue ul { display:grid; grid-template-columns:1fr 1fr; list-style:none; gap:1rem; padding:0; }
  .lesson-catalogue li { display:flex; flex-direction:column; border:1px solid var(--color-rule); padding:1rem; border-radius:4px; }
  .lesson-catalogue h3 { margin:1.5rem 0 .5rem; }
  .lesson-catalogue h4 { margin:0; font-size:1rem; }
  .lesson-catalogue li p { margin:.6rem 0 1rem; font-size:.85rem; }
  .lesson-card-actions { display:flex; flex-wrap:wrap; gap:.6rem; align-items:center; margin-top:auto; font-size:.75rem; }
  .lesson-card-actions a { margin-left:auto; }
  :global(.sandbox-run h4) { margin:0 0 .6rem; font-size:.85rem; color:var(--color-text-secondary); }
  :global(.sandbox-run pre) { white-space:pre-wrap; overflow-wrap:anywhere; font:.8rem/1.6 var(--font-mono); }
  :global(.sandbox-run details) { font-size:.8rem; }
  :global(.sandbox-output-table) { overflow:auto; max-height:25rem; margin:.8rem 0; }
  :global(.sandbox-output-table table) { border-collapse:collapse; width:100%; font-size:.8rem; }
  :global(.sandbox-output-table td),:global(.sandbox-output-table th) { text-align:left; padding:.5rem .7rem; border-bottom:1px solid var(--color-rule); white-space:pre-wrap; min-width:4rem; max-width:25rem; overflow-wrap:anywhere; }
  :global(.sandbox-output-table th) { background:var(--color-surface-alt); }
  :global(.sandbox-output-plan table) { width:max-content; min-width:100%; }
  :global(.sandbox-output-plan td) { font:.8rem/1.6 var(--font-mono); white-space:pre; overflow-wrap:normal; max-width:none; padding:.08rem .7rem; border-bottom:0; }
  :global(.sandbox-null) { color:var(--color-text-secondary); font-style:italic; }
  :global(.sandbox-error) { border-left:3px solid var(--amber); padding-left:.8rem; }
  :global(.sandbox-tag) { font:.8rem/1.6 var(--font-mono); color:var(--color-text-secondary); }
  :global([data-history] .sandbox-run) { padding:1rem; margin:.8rem 0; border:1px solid var(--color-rule); }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  [hidden] { display:none!important; }
  @media(max-width:800px) { .work-grid { grid-template-columns:minmax(0,1fr); gap:1.5rem; } .lesson-column { border:0; padding:0; } .tutorial-guide { position:static; } .step-outline { margin: .6rem 0; } .article-link { display:inline-block; margin:.3rem 1rem .3rem 0; } .workspace-bar { align-items:flex-start; flex-direction:column; } .workspace-actions { width:100%; } .workspace-actions button { flex:1; } .help-grid { grid-template-columns:1fr; gap:1rem; } }
  @media(max-width:550px) { .page-heading h1 { font-size:2rem; } .launch { grid-template-columns:1fr; } .launch-main,.launch-free { padding:1.3rem; } .launch-note { padding:1rem 1.3rem; } .lesson-dialog { padding:1rem; max-height:90vh; } .lesson-filters,.lesson-catalogue ul { grid-template-columns:1fr; } .transaction-state { margin-left:0; } textarea { font-size:.8rem; padding:.75rem; } .sandbox-results { padding:.8rem; } .editor-heading .sandbox-note { display:none; } }
</style>
