import Base from '../../../../layouts/Base.astro';
import Prediction from '../../../../components/editorial/Prediction.astro';
import Sql from '../../../../components/explainers/querying/Sql.astro';
import ResultTable from '../../../../components/explainers/querying/ResultTable.astro';
import QueryShape from '../../../../components/explainers/querying/QueryShape.astro';
import JoinFanout from '../../../../components/explainers/querying/JoinFanout.astro';
import RDQueryWorkLab from '../../../../components/explainers/querying/RDQueryWorkLab.astro';
import executionExamples from '../../../../../docs/article-work/querying-data-deep-dive/execution.sql?url&no-inline';
import practiceSchema from '../../../../../docs/article-work/designing-data/schema.sql?url&no-inline';
import queryExamples from '../../../../../docs/article-work/querying-transactions/query-results.sql?url&no-inline';
import '../../../../styles/explorables.css';
import '../../../../styles/relational-design.css';
import '../../../../components/explainers/design/schema-sketch.css';
const receiptQuery = `SELECT l.line_no, p.name,
       l.quantity * l.unit_price AS line_total
FROM order_lines AS l
JOIN products AS p ON p.product_id = l.product_id
WHERE l.order_id = 'O13'
ORDER BY l.line_no;`;
const receiptPlan = `Sort (actual rows=2.00 loops=1)
  Sort Key: l.line_no
  -> Nested Loop (actual rows=2.00 loops=1)
       Join Filter: (p.product_id = l.product_id)
       Rows Removed by Join Filter: 1
       -> Seq Scan on order_lines l (actual rows=2.00 loops=1)
            Filter: (order_id = 'O13'::text)
            Rows Removed by Filter: 1
       -> Materialize (actual rows=1.50 loops=2)
            -> Seq Scan on products p (actual rows=2.00 loops=1)`;
const firstQuery = `SELECT order_id, line_no, quantity,
       quantity * unit_price AS line_total
FROM order_lines
WHERE order_id = 'O13'
ORDER BY line_no;`;
const joinQuery = `SELECT l.order_id, l.line_no, p.name,
       l.quantity, l.quantity * l.unit_price AS line_total
FROM order_lines AS l
JOIN products AS p ON p.product_id = l.product_id
ORDER BY l.order_id, l.line_no;`;
const customerJoin = `SELECT c.customer_id, c.name, o.order_id
FROM customers AS c
LEFT JOIN orders AS o ON o.customer_id = c.customer_id
ORDER BY c.customer_id, o.order_id;`;
const onFilter = `SELECT c.customer_id, c.name, o.order_id
FROM filter_customers AS c
LEFT JOIN filter_orders AS o
  ON o.customer_id = c.customer_id
 AND o.placed_at >= '2026-10-04 10:00:00+00'
ORDER BY c.customer_id, o.order_id;`;
const whereFilter = `SELECT c.customer_id, c.name, o.order_id
FROM filter_customers AS c
LEFT JOIN filter_orders AS o ON o.customer_id = c.customer_id
WHERE o.placed_at >= '2026-10-04 10:00:00+00'
ORDER BY c.customer_id, o.order_id;`;
const filterSetup = `CREATE TEMP TABLE filter_customers AS
SELECT * FROM customers;
CREATE TEMP TABLE filter_orders AS
SELECT * FROM orders;

INSERT INTO filter_customers (customer_id, name)
VALUES ('C6', 'Cara');
INSERT INTO filter_orders (order_id, customer_id, placed_at)
VALUES ('O15', 'C6', '2026-10-04 08:00:00+00');`;
const totalsQuery = `SELECT o.order_id,
       COUNT(*) AS joined_rows,
       COUNT(l.line_no) AS line_count,
       SUM(l.quantity * l.unit_price) AS line_total
FROM orders AS o
LEFT JOIN order_lines AS l ON l.order_id = o.order_id
GROUP BY o.order_id
ORDER BY o.order_id;`;
const havingQuery = `SELECT order_id, SUM(quantity * unit_price) AS line_total
FROM order_lines
GROUP BY order_id
HAVING SUM(quantity * unit_price) >= 40
ORDER BY order_id;`;
const fanoutQuery = `SELECT l.line_no, s.shipment_id,
       l.quantity * l.unit_price AS line_total
FROM order_lines AS l
JOIN shipments AS s ON s.order_id = l.order_id
WHERE l.order_id = 'O13'
ORDER BY l.line_no, s.shipment_id;`;
const safeTotals = `WITH line_totals AS (
  SELECT order_id, SUM(quantity * unit_price) AS amount
  FROM order_lines
  GROUP BY order_id
), shipment_counts AS (
  SELECT order_id, COUNT(*) AS shipment_count
  FROM shipments
  GROUP BY order_id
)
SELECT o.order_id, t.amount, s.shipment_count
FROM orders AS o
JOIN line_totals AS t ON t.order_id = o.order_id
JOIN shipment_counts AS s ON s.order_id = o.order_id
WHERE o.order_id = 'O13';`;
const existsQuery = `SELECT o.order_id
FROM orders AS o
WHERE EXISTS (
  SELECT 1
  FROM order_lines AS l
  WHERE l.order_id = o.order_id
    AND l.product_id = 'P7'
)
ORDER BY o.order_id;`;
const noLinesQuery = `SELECT o.order_id
FROM orders AS o
WHERE NOT EXISTS (
  SELECT 1
  FROM order_lines AS l
  WHERE l.order_id = o.order_id
)
ORDER BY o.order_id;`;
const setup = `INSERT INTO customers (customer_id, name)
VALUES ('C5', 'Ben');

-- An order header exists before its lines have been added.
INSERT INTO orders (order_id, customer_id, placed_at)
VALUES ('O14', 'C4', '2026-10-04 11:00:00+00');

CREATE TABLE shipments (
  shipment_id text PRIMARY KEY,
  order_id text NOT NULL REFERENCES orders (order_id)
);
INSERT INTO shipments (shipment_id, order_id)
VALUES ('S1', 'O13'), ('S2', 'O13');`;
---
<Base title="Querying your data" description="Follow SQL from the question to its answer: filters, joins, missing values, summaries, and the execution work that produces the result.">
  <article class="visual-essay relational-design schema-sketches">
    <header class="essay-header">
      <p class="eyebrow">Databases and storage</p>
      <h1>Querying your data</h1>
      <div class="essay-meta"><span>Relational deep dive</span><a href="/learn/databases/relational/">Relational introduction ↗</a><a href="/learn/databases/relational/transaction-boundaries/">Next: Transactions and concurrency →</a></div>
    </header>
    <p>The tables in a relational database are arranged to store information without having to repeat it everywhere. A customer’s details can live in one table, their orders in another, and the contents of each order in a third. That is useful when we change the information, but it rarely matches the way we want to read it. An order history needs details from several tables. A sales report may need totals that are not stored in any table at all.</p>
    <p>A <strong>query</strong> describes the result we want the database to produce from that stored information. We can ask for particular records, combine related records, or calculate summaries. The same tables can support many different questions without needing a new stored copy for each answer.</p>
    <p>SQL is the language we use to express those questions. A <code>SELECT</code> query produces a result with columns and rows, much like a table. The important difference is that we decide what those rows represent. They might be individual purchases, customers who made a purchase, or monthly sales totals. Understanding that choice makes it much easier to write a query and recognise when its answer is wrong.</p>
    <p>We’ll start with a query that reads one table, bring in related information using a <strong>join</strong>, and calculate totals. Then we’ll follow the engine’s work: how it finds matching rows, why two ways of producing the same answer can do different amounts of work, and what an execution plan tells us. The examples use PostgreSQL 18 and the small shop from the <a href="/learn/databases/relational/">relational introduction</a>. We assume you know what tables, columns and keys are; we’ll introduce the SQL as we use it.</p>

    <nav class="query-contents" aria-label="In this deep dive"><p>In this article</p><ol><li><a href="#first-query">A query and its result</a></li><li><a href="#joins">Joins and matching rows</a></li><li><a href="#missing-matches">Missing matches</a></li><li><a href="#aggregation">Grouping and totals</a></li><li><a href="#multiplied-rows">When a join inflates a total</a></li><li><a href="#existence">Asking whether a match exists</a></li><li><a href="#execution">From the answer to the work</a></li><li><a href="#different-work">Different ways to find the same rows</a></li><li><a href="#plan-choice">Why the plan can change</a></li></ol></nav>

    <section id="first-query">
      <h2>A query and its result</h2>
      <p>Our shop has customers, products, orders and order lines. A line is one entry within an order, identified by its order ID and line number. Customer C4, Ada, placed O12 for two Blue mugs at €18 each. Her later order O13 has a mug at €20 and a bowl at €24. The line’s price records the amount agreed for that purchase; the product has a separate current catalogue price.</p>
      <QueryShape />
      <p>To show the amounts on O13, we can read its lines directly:</p>
      <Sql code={firstQuery} label="Select the purchase lines and calculated amounts for order O13" />
      <p><code>FROM</code> names the table. <code>WHERE</code> keeps rows whose condition is true: here, rows whose <code>order_id</code> equals the text value <code>'O13'</code>. Single quotes delimit text values; the column names are unquoted. <code>SELECT</code> chooses the columns and expressions returned. Multiplying quantity by unit price calculates an amount, and <code>AS line_total</code> gives that result column a name.</p>
      <ResultTable caption="O13’s lines; amounts are EUR" columns={['order_id','line_no','quantity','line_total']} rows={ [['O13',1,1,'20.00'],['O13',2,1,'24.00']] } />
      <p><code>ORDER BY line_no</code> puts line 1 before line 2. Without an explicit ordering, SQL does not promise which row arrives first. The final semicolon ends the statement. These clauses describe the answer; they do not prescribe an algorithm that must visit every row in the order the clauses are written.</p>
      <p>The fixed value <code>'O13'</code> makes the example easy to run. In application code, a PostgreSQL parameterised query can instead use <code>WHERE order_id = $1</code>, with the order ID supplied separately through the database driver. Do not concatenate a caller’s value into the SQL text. The driver’s API varies, but the separation keeps a value from becoming part of the command.</p>
      <p>This query leaves the stored records alone. It does not create a <code>line_total</code> column on the table. Calculating the expression again on a later read uses the values visible to that read.</p>
    <p class="example-note">In the browser sandbox, you can <a href="/learn/databases/relational/sandbox/?tutorial=queries">build an order receipt from the shop tables</a>. The guided tutorial starts with its own copy of the shop; it does not load every extension used in this article.</p>
    <p class="example-note">To run the SQL yourself, <a href="/learn/databases/relational/practice/">start the shared practice setup</a>. It explains opening PostgreSQL, loading the files and choosing a fresh database for this article.</p>
      <details class="sql-setup"><summary>Run the examples</summary><p>Use a fresh PostgreSQL practice database for this article, separate from other article extensions. Run the <a href={practiceSchema} download="designing-data.sql">shop schema and records</a> once, then the <a href={queryExamples} download="query-results.sql">extension and queries for this article</a>. In a PostgreSQL query editor, open each file and execute its statements one at a time, in that order, or use SQL script mode such as <code>psql -f</code>. The extension adds Ben, an empty order O14 for Ada, and two shipments for O13. The SQL below is that extension; do not insert it again if you ran the downloaded file.</p><Sql code={setup} label="Additional records and shipments table for the query examples" /></details>
    </section>

    <section id="joins">
      <h2>Joins and matching rows</h2>
      <p>The lines contain product IDs, but a customer needs names. A <strong>join</strong> combines rows whose values satisfy a condition. We match each line’s product ID to the product with that ID:</p>
      <Sql code={joinQuery} label="Join all purchase lines to their product names" />
      <p><code>AS l</code> gives <code>order_lines</code> a short name within this query; <code>AS p</code> does the same for products. The expression <code>p.name</code> means the name from the product side. <code>ON</code> states which pairs match. Plain <code>JOIN</code> means <strong>inner join</strong>: only matching pairs become result rows.</p>
      <ResultTable caption="Each purchase line finds its product" columns={['order_id','line_no','name','quantity','line_total']} rows={ [['O12',1,'Blue mug',2,'36.00'],['O13',1,'Blue mug',1,'20.00'],['O13',2,'Bowl',1,'24.00']] } />
      <p>Line 1 of O12 contains P7. P7 identifies one product, so the line pairs with one Blue mug record. O13’s first line also pairs with P7. The product appears twice in the answer because it was bought on two different lines. Neither the shared product nor either purchase needs to be copied in storage.</p>
      <p>The primary key on <code>products.product_id</code> makes the match unique. The required foreign key on the line makes a match exist. Together they explain why this particular join returns exactly one row per line. A join is not inherently one-to-one: its condition and the data’s rules determine how many matches there can be.</p>
      <p>It helps to name what identifies a result row. Here it is <code>(order_id, line_no)</code>, just as for the source lines. Some people call this the result’s <strong>grain</strong>. If we join from an order to its lines, the order ID repeats as the result becomes one row per line. Removing the line number from <code>SELECT</code> hides that distinction; it does not remove the result rows.</p>
    </section>

    <section id="missing-matches">
      <h2>Missing matches</h2>
      <p>Now we want a customer list with their order IDs, including customers who have never ordered. Alongside O12 and O13, Ada now has order O14, whose header exists but has no lines yet. Our added customer C5, Ben, has no orders.</p>
      <p>An inner join would omit Ben because there is no matching pair. A <strong>left join</strong> retains every row on its left, supplying SQL <code>NULL</code> for the right-hand fields when nothing matches.</p>
      <Sql code={customerJoin} label="Keep customers even when no order matches" />
      <ResultTable caption="Ben remains in the customer list" columns={['customer_id','name','order_id']} rows={ [['C4','Ada','O12'],['C4','Ada','O13'],['C4','Ada','O14'],['C5','Ben','NULL']] } />
      <p>Ben’s result does not describe an order whose ID is missing. It describes a customer with no matching order. O14 is different: its order header exists even though its lines do not. The join cannot infer that an order is complete merely because its row exists.</p>
      <p><code>NULL</code> matters when we filter. Ordinary comparisons with a missing value have an unknown result. <code>WHERE</code> keeps only true, so both false and unknown are excluded. To ask whether a value is missing, use <code>IS NULL</code>, rather than <code>= NULL</code>. For example, <code>WHERE o.order_id IS NULL</code> after this join finds Ben. It works as a missing-match test because real order IDs cannot be null.</p>
      <p>Ada’s orders were placed at 09:00 (O12), 10:00 (O13) and 11:00 (O14), all on 4 October 2026 in UTC. Suppose the customer list should show only orders placed at or after 10:00 that day, but still retain customers with no such orders. There are two ways a customer can have no qualifying order: Ben has never ordered, while another customer might have ordered only earlier.</p>
      <p>For this comparison, we’ll make separate copies called <code>filter_customers</code> and <code>filter_orders</code>, and add C6, Cara, whose only order is O15 at 08:00. These copies let us explore that case without changing the shop records used elsewhere in the article.</p>
      <details class="sql-setup"><summary>Set up the filter comparison</summary><p>After loading the shop and article extension above, run this once in the same database session as the two queries below. <code>CREATE TEMP TABLE … AS SELECT</code> copies the query’s rows into a temporary table, which disappears when the session ends. The download includes this setup; skip it here if you already ran that file in this session.</p><Sql code={filterSetup} label="Make temporary copies and add a customer whose only order is before 10:00 UTC" /></details>
      <p>First put the cutoff in the matching rule:</p>
      <Sql code={onFilter} label="Keep every customer while matching only orders since 10:00 UTC" />
      <ResultTable caption="Cutoff in ON: all three customers remain" columns={['customer_id','name','order_id']} rows={ [['C4','Ada','O13'],['C4','Ada','O14'],['C5','Ben','NULL'],['C6','Cara','NULL']] } />
      <p>Ada now has O13 and O14. The <code>AND</code> requires both the customer match and the time condition. Ben has no orders to match, and Cara’s O15 fails the time condition. The left join supplies each of them with one row containing null order fields.</p>
      <p>Moving the same condition to <code>WHERE</code> asks a different question:</p>
      <Sql code={whereFilter} label="Filter joined results to orders since 10:00 UTC" />
      <ResultTable caption="Cutoff in WHERE: only Ada’s qualifying orders remain" columns={['customer_id','name','order_id']} rows={ [['C4','Ada','O13'],['C4','Ada','O14']] } />
      <p>This drops both Ben and Cara. Ben’s missing placement time makes the comparison unknown. Cara first matches O15, but its 08:00 placement time makes the comparison false; filtering out that row does not create a replacement null row. The distinction is between deciding which orders match and deciding which resulting rows survive. Choose it from what the customer list is meant to include.</p>
    </section>

    <section id="aggregation">
      <h2>Grouping and totals</h2>
      <p>A receipt needs individual lines; an order summary needs one total per order. An <strong>aggregate</strong> combines several input values into one answer. <code>SUM</code> adds them, and <code>COUNT</code> counts rows or present values. <code>GROUP BY</code> specifies which input rows contribute to each group.</p>
      <Sql code={totalsQuery} label="Group joined order lines to show counts and totals per order" />
      <ResultTable caption="Counts expose the unmatched row for empty order O14" columns={['order_id','joined_rows','line_count','line_total']} rows={ [['O12',1,1,'36.00'],['O13',2,2,'44.00'],['O14',1,0,'NULL']] } />
      <p>O13’s two matched rows enter one group. Its line amounts, €20 and €24, sum to €44. O12 has one line worth €36. The output now has one row per order, so an unaggregated line number would not have one unambiguous value to display for O13.</p>
      <p>O14 explains why counting needs care. Its left join produces one row with null line fields. <code>COUNT(*)</code> counts that row; <code>COUNT(l.line_no)</code> counts only present line numbers and returns zero. Real line numbers are non-missing, so that second count measures actual lines. Counting a nullable descriptive field would instead measure how many lines supplied that field.</p>
      <p><code>SUM</code> ignores null inputs, and returns null when there are no non-null inputs to add. If our report defines an empty order’s displayed subtotal as zero, <code>COALESCE(SUM(l.quantity * l.unit_price), 0)</code> uses zero when the sum is null. <code>COALESCE</code> picks the first non-null argument. That display decision still does not make O14 a completed purchase.</p>
      <p>A condition on a group belongs in <code>HAVING</code>. To find orders whose lines total at least €40:</p>
      <Sql code={havingQuery} label="Retain only groups whose purchase amounts total at least 40 EUR" />
      <p>This returns O13 with €44. A <code>WHERE</code> condition filters individual input rows before grouping; <code>HAVING</code> filters the groups. If we first kept only lines worth at least €24, O13’s €20 mug would disappear before the sum, and we would be calculating a different total.</p>
    </section>

    <section id="multiplied-rows">
      <h2>When a join inflates a total</h2>
      <p>The shop also records shipments. O13 has two, S1 and S2; each shipment row refers to the order. A report needs the order’s amount and its shipment count. We might start by joining both collections on their order ID:</p>
      <Sql code={fanoutQuery} label="Inspect every line and shipment pair for order O13" />
      <JoinFanout />
      <p>The query has answered “which line and shipment pairs belong to O13?” There are four. Summing its line amounts gives €88, even though Ada bought €44 of goods. No constraint has failed. The result contains all the combinations requested by the join.</p>
      <p><code>DISTINCT</code> removes equal output rows, but it cannot decide what the report intended to count. The four pairs are distinct because their line numbers or shipment IDs differ. <code>SUM(DISTINCT amount)</code> would happen to give €44 here, but would count two different €20 lines only once. Equal prices do not identify the same purchase.</p>
      <p>For one row per order, calculate each collection’s summary at that level before combining them:</p>
      <Sql code={safeTotals} label="Aggregate lines and shipments separately before joining their per-order summaries" />
      <JoinFanout grouped />
      <p class="example-note">In the <a href="/learn/databases/relational/sandbox/?tutorial=join-totals">join-totals lesson</a>, inspect every line–delivery pair before summing it. Then repair the query, keep an empty order in the result, and test two legitimate lines with equal amounts.</p>
      <p><code>WITH</code> gives a name to a query result used by the rest of the statement. Here, <code>line_totals</code> has at most one row per order because it groups by the order ID. So does <code>shipment_counts</code>. Their join can now pair O13’s one amount with its one shipment count without multiplying either. These names do not create permanent tables.</p>
      <p>This example deliberately selects an order that has both lines and shipments. To list all order headers, use left joins to the summaries, then decide what absent totals and counts should mean. The choice to preserve empty orders is separate from the choice to prevent multiplication.</p>
      <Prediction id="join-variation" title="One more line, one more shipment">
        <p>In a fresh copy of the query example, O13 has its existing €20 mug line and €24 bowl line. Add line 3 for another mug, quantity 1 at €20, and shipment S3 for the same order. If we join lines and shipments by order ID, how many pairs result, and what would a sum over their line amounts report? What should the separate summaries report? Would <code>SUM(DISTINCT amount)</code> repair it?</p>
        <Fragment slot="answer"><p>Three lines match each of three shipments, producing nine pairs. Every line amount occurs three times, so the joined sum is 3 × (€20 + €24 + €20) = €192. The separate summaries correctly report €64 of goods and three shipments, then join as one row for O13.</p><p><code>SUM(DISTINCT amount)</code> reports only €20 + €24 = €44, losing the second €20 purchase line. The repeated amounts belong to different line identities. The shipments do not record which line travelled in each one, so the join cannot infer that association.</p></Fragment>
      </Prediction>
    </section>

    <section id="existence">
      <h2>Checking whether a match exists</h2>
      <p>Sometimes we do not need anything from the matching records. We only want orders that contain P7, the Blue mug. An <code>EXISTS</code> condition asks whether a query finds at least one row:</p>
      <Sql code={existsQuery} label="Find orders with at least one Blue mug line" />
      <p>The inner query refers to the outer order through <code>o.order_id</code>. For each candidate order, it asks whether a line for P7 belongs to it. <code>SELECT 1</code> supplies a constant; its value does not matter to <code>EXISTS</code>, only the presence of a result does. The answer contains O12 and O13, once each.</p>
      <p>If O13 later gets another mug line, it still appears once. The outer query selects orders, and the condition makes a yes-or-no decision about each one. We never create one output row for every matching mug line. A join is appropriate when we need those lines in the answer; an existence test fits when we only need to qualify the order.</p>
      <p>The opposite question finds order headers that still have no lines:</p>
      <Sql code={noLinesQuery} label="Find order headers with no purchase lines" />
      <p>This returns O14. The query is useful as a diagnostic, but it cannot tell us whether O14 is legitimately being assembled or was abandoned after a failure. Interpreting that state requires the application’s rules and <a href="/learn/databases/relational/transaction-boundaries/">transaction boundary</a>.</p>
    </section>

    <section id="checking-results">
      <h2>Checking an answer</h2>
      <p>When a result looks wrong, expose the identities before hiding them in a total. In the shipment query, selecting the line number and shipment ID made the four combinations visible. Looking only at €88 would have left the multiplication unexplained.</p>
      <p>Then follow one familiar record. Does it have no match, one match, or several? Does a filter intentionally remove it? After grouping, which original rows contribute to its total? Small examples with an empty order, two lines, and two related shipments reveal mistakes that a large set of ordinary orders can conceal.</p>
      <p>At this point we know what our query should return. That gives us a way to judge an execution strategy: however it finds the answer, it must preserve the same matches, missing rows and contributions to each total. We can now follow the work without losing sight of what it is for.</p>
    </section>
    <section id="execution">
      <h2>From the answer to the work</h2>
      <p>Return to O13’s receipt. We need its two lines, the matching product names, and each line’s amount, ordered by line number. We have already seen all the parts of this query:</p>
      <Sql code={receiptQuery} label="The receipt whose execution we will follow" />
      <p>One possible method is to read all three purchase lines and keep the two for O13. For each of those, search the products for its ID. Calculate the amount from the line’s quantity and agreed price, then put the two results in line-number order. This produces Blue mug at €20 and Bowl at €24, exactly as before.</p>
      <p>Notice that we can discard O12’s line before looking up its product. For this inner join, that changes the work without changing the answer: O12 could never satisfy the order filter. Earlier, moving a cutoff across a left join changed which customers survived. A database can rearrange work only when the rearrangement preserves the query’s meaning.</p>
      <p>The engine chooses an <strong>execution plan</strong>: a set of operations that will produce the result. A plan might read a whole table, look up selected records through an index, join two streams of rows, or sort an intermediate answer. We can ask PostgreSQL to show those operations by putting <code>EXPLAIN</code> before the query.</p>
      <p>Plain <code>EXPLAIN</code> shows the proposed plan and estimates. <code>EXPLAIN ANALYZE</code> actually runs the statement and adds observed information. For our receipt, use the command below. The options hide estimated costs and timing detail so we can concentrate on rows and repetition.</p>
      <Sql code={'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)\n' + receiptQuery} label="Execute the receipt SELECT and report its plan" />
      <p>Here is the plan observed on our small practice dataset after gathering statistics with <code>ANALYZE products; ANALYZE order_lines;</code>. Buffer and memory details have been omitted from this excerpt. Your database may choose a different route; the result still has to be the same.</p>
      <div class="sql-scroll" tabindex="0" role="region" aria-label="Observed PostgreSQL receipt plan"><pre><code>{receiptPlan}</code></pre></div>
      <p>The indentation shows which operation supplies rows to another. Start with <code>Seq Scan on order_lines</code>. “Seq” means sequential: it scans the table, applying the O13 condition. It returns two rows and removes one. The <code>actual rows</code> value counts rows emitted by this operation, so the two returned rows alone do not tell us that it inspected three.</p>
      <p>The other branch reads the two products. <code>Materialize</code> retains the rows it reads so the join can revisit them without rescanning the product table each time. The <strong>nested loop</strong> takes one line at a time and seeks its matching product in that retained input. Line 1 finds P7; line 2 passes P7 and finds P8. The products’ unique key lets the join stop searching once it has a match.</p>
      <figure class="receipt-trace paper-surface">
        <figcaption><strong>Following O13 through this plan</strong><br />The lines and products arrive through separate branches. The join combines them; sorting supplies the requested order.</figcaption>
        <div class="trace-inputs"><div><strong>Purchase lines</strong><span>O12/1 · O13/1 · O13/2</span><span>Filter order_id = O13</span><b>2 lines continue ↓</b></div><div><strong>Products</strong><span>P7 Blue mug · P8 Bowl</span><span>Read once, retain for reuse</span><b>2 names available ↓</b></div></div>
        <div class="trace-join"><strong>Match each line’s product ID</strong><span>O13/1 + P7 → Blue mug, €20</span><span>O13/2 + P8 → Bowl, €24</span></div>
        <div class="trace-sort">↓ Sort by line number → 2 receipt rows</div>
      </figure>
      <p>The materialized input reports <code>rows=1.50 loops=2</code>. It ran twice, returning one product row on the first pass and two on the second: three in total, averaging 1.5 per pass. Fractional row counts in a repeated operation are averages, not fractions of a record. The nested loop discards the one nonmatching pair, so it emits two rows overall.</p>
      <p>Finally, <code>Sort</code> orders those two rows by <code>l.line_no</code>. It sits at the top because it receives the join’s output. This is a tree of dependencies, not a list to execute from its first printed line downwards.</p>
      <p>Use <a href={executionExamples} download="query-execution.sql">the receipt execution script</a> after the article’s practice setup to reproduce the query and collect your own plan. Remember that <code>EXPLAIN ANALYZE</code> executes its statement: adding it to an <code>UPDATE</code> would perform the update. Here we are observing a read in a practice database.</p>
    </section>

    <section id="different-work">
      <h2>Different ways to find the same rows</h2>
      <p>Our catalogue contains two products. Looking through them again for each receipt line hardly seems troublesome. Imagine instead that the catalogue has 200 products and the receipt has six lines. A simple method that compares every line against every product performs 1,200 ID comparisons. Most of those products are irrelevant to the receipt, but the method keeps considering them.</p>
      <p>We could build a temporary lookup from product ID to product name. Reading the 200 products once fills that lookup; each of the six lines then asks it for the matching ID. A <strong>hash join</strong> uses this kind of arrangement: organise one input by its join key, then use the other input’s keys to find candidate matches. The lookup has a construction and memory cost of its own.</p>
      <p>Try the two approaches below. This is deliberately simpler than the observed PostgreSQL plan: the scanning method always checks the whole catalogue, even after it finds a match. That makes the repeated work visible. Both methods must still produce the same receipt.</p>
      <RDQueryWorkLab />
      <p>Adding unrelated products enlarges the search without enlarging the answer. Adding receipt lines repeats that search. The lookup method separates those two kinds of work: catalogue growth adds entries to build, while receipt growth adds probes. But when there is only one line, the lookup still has to be built. It does not become free just because each later probe is convenient.</p>
      <p>There is a third possibility in our actual shop. The primary key on products already has an <strong>index</strong>, a maintained structure that helps locate a row from its key. A nested-loop plan could use the line’s product ID to search that index, rather than revisit every product. With only a few lines to look up, this can avoid both repeated full scans and building a temporary lookup over the whole catalogue.</p>
      <p>“Nested loop” therefore does not by itself tell us that a plan is wasteful. What matters is what the inner operation does and how often it runs. A few selective index lookups and thousands of full rescans can share that same outer label. Conversely, scanning a tiny products table can cost less than traversing its index and fetching the corresponding records.</p>
      <p>Another strategy, a <strong>merge join</strong>, works with inputs ordered by the matching key. It can advance through both ordered streams, combining matching keys without restarting at the beginning each time. If the inputs are not already in a suitable order, obtaining that order adds work. PostgreSQL chooses among these possibilities using what it knows about the query, the available access paths and the expected data.</p>
    </section>

    <section id="plan-choice">
      <h2>Why the plan can change</h2>
      <p>A receipt and a month’s sales report can join the same tables but require very different amounts of data. A receipt may need two product lookups. A report may touch most lines and products. Repeating a small lookup many times can eventually become more expensive than reading a larger input once. The most useful strategy depends on how much work reaches each stage.</p>
      <p>The number of rows is called <strong>cardinality</strong>. Earlier we used it to catch a correctness problem: two lines and two shipments became four pairs. The planner must also estimate cardinality before running a query, because that affects whether repeated lookups, a hash table, sorting, or a scan are likely to be worthwhile.</p>
      <p>PostgreSQL gathers statistics about tables, including approximate sizes and value distributions. <code>ANALYZE</code> refreshes that information. If a product is unusually popular, assuming every product has equally many purchases can underestimate how many lines will match it. If two conditions are related, treating them as independent can also give a poor estimate. Statistics improve the prediction; they cannot turn it into foreknowledge.</p>
      <p>When looking at a fuller <code>EXPLAIN ANALYZE</code>, compare estimated rows with observed rows at the operation where they begin to diverge. An estimate of two outer rows followed by 20,000 actual rows could explain why a seemingly cheap inner lookup was repeated far more often than expected. The plan’s cost numbers are estimates in planner units, not milliseconds or a bill for the query.</p>
      <p>Grouping and sorting also need work. Our order summary must read the contributing line amounts before it knows each total. An engine might accumulate groups in a hash table, or gather equal keys together and calculate each group in turn. A sort must establish the requested ordering; enough data can exceed the memory available to that operation and require temporary disk work. Returning only a small summary does not imply that little input was processed.</p>
      <p>These observations give us a useful sequence when a query disappoints. First establish that the answer means what we intend. Then inspect how many rows reach each operation, how often an operation repeats, and which access path it uses. A faster route to the inflated €88 shipment total would still be the wrong answer. A correct €44 total gives us a result to preserve as we change the work.</p>
      <p>Reading that answer in several requests introduces another decision: which ordering and continuation rule keep the pages useful while data changes? That is the subject of <a href="/learn/databases/relational/large-results/">Pagination and large results</a>. When the application starts changing related records, <a href="/learn/databases/relational/transaction-boundaries/">Transactions and concurrency</a> develops what must succeed together and what overlapping requests can observe.</p>
    </section>
