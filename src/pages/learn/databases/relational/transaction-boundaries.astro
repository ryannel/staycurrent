    'INSERT INTO order_lines ' +
    '(order_id, line_no, product_id, quantity, unit_price) ' +
    'VALUES ($1, 1, $2, $3, $4)',
    [purchase.orderId, purchase.productId,
     purchase.quantity, purchase.unitPrice]
  );
  await client.query('COMMIT');
  // Only now can the handler report a completed purchase.
}`;
const applicationFailure = `try {
  // ...the same BEGIN, reservation and order insert...
  await client.query(
    'INSERT INTO order_lines ' +
    '(order_id, line_no, product_id, quantity, unit_price) ' +
    'VALUES ($1, 1, $2, $3, $4)',
    ['O14', 'P7', 0, '20.00'] // Deliberate application bug.
  );
  await client.query('COMMIT');
} catch (error) {
  // For the confirmed CHECK rejection in this example:
  await client.query('ROLLBACK');
  throw error; // Tell the caller the purchase did not succeed.
}`;
const stockSetup = `CREATE TABLE stock (
  product_id text PRIMARY KEY REFERENCES products (product_id),
  available integer NOT NULL CHECK (available >= 0)
);
INSERT INTO stock (product_id, available) VALUES ('P7', 3);`;
const reserve = `BEGIN;
UPDATE stock
SET available = available - 2
WHERE product_id = 'P7' AND available >= 2
RETURNING product_id, available;`;
const finish = `-- Continue the transaction opened by BEGIN above.
-- Same connection; run only if the reservation returned one row.
INSERT INTO orders (order_id, customer_id, placed_at)
VALUES ('O14', 'C4', '2026-10-15 11:00:00+00');

INSERT INTO order_lines
  (order_id, line_no, product_id, quantity, unit_price)
VALUES ('O14', 1, 'P7', 2, 20.00);

COMMIT;`;
const failureStart = `BEGIN;
UPDATE stock SET available = available - 2
WHERE product_id = 'P7' AND available >= 2;

INSERT INTO orders (order_id, customer_id, placed_at)
VALUES ('O14', 'C4', '2026-10-15 11:00:00+00');`;
const failureLine = `INSERT INTO order_lines
  (order_id, line_no, product_id, quantity, unit_price)
VALUES ('O14', 1, 'P7', 0, 20.00);`;
const failureRollback = `ROLLBACK;`;
const verify = `SELECT available FROM stock WHERE product_id = 'P7';
SELECT count(*) AS orders FROM orders WHERE order_id = 'O14';
SELECT count(*) AS lines FROM order_lines WHERE order_id = 'O14';`;
const unsafe = `// Inside each handler's open transaction. Deliberately unsafe.
const result = await client.query(
  "SELECT available FROM stock WHERE product_id = $1",
  [purchase.productId]
);
const nextAvailable = result.rows[0].available - 1;
await client.query(
  "UPDATE stock SET available = $1 WHERE product_id = $2",
  [nextAvailable, purchase.productId]
);
// Each handler then inserts its order and line and commits.`;
const guarded = `UPDATE stock
SET available = available - 1
WHERE product_id = 'P7' AND available >= 1
RETURNING product_id, available;`;
const locking = `// Replacement reservation branch, after the handler sends BEGIN.
const result = await client.query(
  'SELECT available FROM stock WHERE product_id = $1 FOR UPDATE',
  [purchase.productId]
);
if (result.rows.length === 0 || result.rows[0].available < 1) {
  await client.query('ROLLBACK');
  // End this attempt and report unavailable stock.
} else {
  await client.query(
    'UPDATE stock SET available = available - 1 WHERE product_id = $1',
    [purchase.productId]
  );
  // Continue with the same handler's order, line and COMMIT calls.
}`;
const snapshotRead = `-- Report connection
BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
SELECT current_price FROM products WHERE product_id = 'P7';
-- 20.00. Pause here while another connection changes the price.

SELECT current_price FROM products WHERE product_id = 'P7';
-- Still 20.00 after the writer below commits.
COMMIT;`;
const snapshotWrite = `-- Writer connection, between the report's SELECT statements
BEGIN;
UPDATE products SET current_price = 22.00
WHERE product_id = 'P7';
COMMIT;`;
const featuredSetup = `CREATE TABLE featured_products (
  product_id text PRIMARY KEY REFERENCES products (product_id),
