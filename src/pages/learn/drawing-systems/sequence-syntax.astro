---
import { Code } from 'astro:components';
import DrawingArticle from '../../../layouts/DrawingArticle.astro';

// A lookup page, so it is written as tables the reader can scan. Every listing
// and table row was rendered on 17 October 2026 with Mermaid 12.2.0 and
// PlantUML 1.2026.9; docs/article-work/sequence-syntax/evidence.md has the record.
const title = 'Sequence diagram syntax: Mermaid, PlantUML and others';
const description = 'Look up how Mermaid and PlantUML write calls, replies, activation, notes and frames, which arrows change meaning between them, what each cannot draw, and where each one renders.';
const sections = [
  [2, 'one-booking-in-both-syntaxes', 'One booking in both syntaxes'],
  [2, 'constructs-side-by-side', 'Constructs side by side'],
  [3, 'participants-notes-and-text', 'Participants, notes and text'],
  [3, 'activation-creation-and-numbering', 'Activation, creation and numbering'],
  [3, 'frames', 'Frames'],
  [2, 'arrows-that-change-meaning', 'Arrows that change meaning between tools'],
  [2, 'what-each-tool-cannot-draw', 'What each tool can’t draw'],
  [3, 'mermaid-cannot', 'In Mermaid'],
  [3, 'plantuml-cannot', 'In PlantUML'],
  [2, 'where-each-one-renders', 'Where each one renders'],
  [3, 'mermaid-versions', 'Mermaid syntax by version'],
  [2, 'd2-and-drawing-by-hand', 'D2 and drawing by hand'],
  [2, 'sources-and-further-reading', 'Sources and further reading'],
] as const;
const headings = sections.map(([depth, slug, text]) => ({ depth, slug, text }));
const h = Object.fromEntries(sections.map(([, slug, text]) => [slug, { id: slug, text }]));
const themes = { light: 'github-light', dark: 'github-dark' } as const;

const seq = '/learn/drawing-systems/sequences/';

const mermaidBooking = `sequenceDiagram
    actor Mina
    participant API as Repair API
    participant Provider as Email provider
    Mina->>+API: POST /repairs
    API-)Provider: POST /emails
    API-->>-Mina: 201 Created: R17
    Note over API,Provider: Nobody waits for this reply`;

const plantumlBooking = `@startuml
actor Mina
participant "Repair API" as API
participant "Email provider" as Provider
Mina -> API ++ : POST /repairs
API ->> Provider : POST /emails
API --> Mina -- : 201 Created: R17
note over API, Provider : No reply within 10 s: outcome unknown
@enduml`;

const d2Booking = `shape: sequence_diagram
mina: Mina
api: Repair API
provider: Email provider

mina -> api: POST /repairs
api -> provider: POST /emails
api -> mina: 201 Created: R17 {style.stroke-dash: 3}
api."Nobody waits for this reply"`;

// [meaning, link into the parent article or empty, Mermaid, PlantUML]
type Row = [string, string, string, string];

const participantRows: Row[] = [
  ['A lifeline with a display name', '#lifelines-and-messages', 'participant API as Repair API', 'participant "Repair API" as API'],
  ['A person', '#actors-notes-and-participants', 'actor Mina', 'actor Mina'],
  ['A database or a queue', '', 'participant DB@{ "type": "database" } (11.11 and later; add as Repair DB from 11.13)', 'database "Repair DB" as DB'],
  ['Lifelines grouped in a labelled box', '', 'box Aqua Our services … end', 'box "Our services" #LightBlue … end box'],
  ['A message from a lifeline to itself', '#actors-notes-and-participants', 'A->>A: Check postcode', 'A -> A : Check postcode'],
  ['A note over one or two lifelines', '#actors-notes-and-participants', 'Note over A,B: text', 'note over A, B : text'],
  ['A note beside a lifeline', '#actors-notes-and-participants', 'Note right of B: text', 'note right of B : text'],
  ['A note attached to the previous message', '', 'none', 'note right : text'],
  ['A line break inside a label', '', 'first<br/>second', 'first\\nsecond'],
  ['A comment', '', '%% text, on its own line', '\' text'],
];

const lifetimeRows: Row[] = [
  ['An activation bar starts as a call arrives', '#replies-and-activation-bars', 'A->>+B: call', 'A -> B ++ : call'],
  ['It ends as the reply leaves', '#replies-and-activation-bars', 'B-->>-A: reply', 'B --> A -- : reply'],
  ['Start and end a bar on their own lines', '#replies-and-activation-bars', 'activate B … deactivate B', 'activate B … deactivate B'],
  ['A reply to whichever call last activated a lifeline', '', 'none', 'return reply'],
  ['Every call activates its receiver', '', 'none', 'autoactivate on'],
  ['A lifeline that starts partway down', '#actors-notes-and-participants', 'create participant Q, on the line before the message that creates it', 'create Q, on the line before the message that creates it'],
  ['A lifeline that ends partway down', '#actors-notes-and-participants', 'destroy Q, on the line before the message that ends it', 'destroy Q, on the line after the message that ends it'],
  ['A number on every arrow, with an optional start and step', '', 'autonumber 10 5', 'autonumber 10 5'],
];

const frameRows: Row[] = [
  ['Alternatives: at most one section runs', '#alt-and-opt', 'alt guard … else guard … end', 'alt guard … else guard … end'],
  ['A step that may not happen', '#alt-and-opt', 'opt guard … end', 'opt guard … end'],
  ['A section that repeats', '#loop', 'loop guard … end', 'loop guard … end'],
  ['Sections with no order between them', '#par', 'par one … and two … end', 'par one … else two … end'],
  ['Leave the enclosing fragment', '#break', 'break guard … end', 'break guard … end'],
  ['A region that no other message may interleave with. Both tools also let you add named cases, which is their own reading', '#critical', 'critical name … option case … end', 'critical name … else case … end'],
  ['A reference to another diagram', '#ref', 'none; use a note across the lifelines', 'ref over A, B : name'],
  ['A frame with only a label, no UML operator', '', 'none', 'group Label [secondary label]'],
  ['A coloured background behind some messages', '', 'rect rgb(200,255,200) … end', 'none'],
];

const arrowRows: [string, string, string, string][] = [
  ['A call: solid line, filled head', '#synchronous-and-asynchronous-messages', '->>', '->'],
  ['A reply: dotted line, head', '#replies-and-activation-bars', '-->>', '-->'],
  ['An asynchronous message: open head', '#synchronous-and-asynchronous-messages', '-)', '->>'],
  ['An asynchronous message, dotted', '', '--)', '-->>'],
  ['A lost message: cross', '#lost-messages-and-timeouts', '-x', '->x'],
  ['The same, dotted', '#lost-messages-and-timeouts', '--x', '-->x'],
  ['A lost message: ends in a filled circle', '#lost-messages-and-timeouts', 'none', '->o'],
  ['A message in both directions', '', '<<->> (11.0 and later)', '<->'],
];

const renderRows: [string, string, string][] = [
  ['GitHub: Markdown files, issues, pull requests, discussions and wikis', 'Renders a fenced mermaid block.', 'Not rendered. GitHub’s documentation lists four diagram syntaxes, and PlantUML isn’t one of them.'],
  ['GitLab', 'Renders a mermaid block. GitLab’s documentation says it supports Mermaid version 11.', 'Renders a plantuml block on GitLab.com. A self-managed GitLab needs an administrator to enable it and a PlantUML server to call.'],
  ['Docusaurus', 'The @docusaurus/theme-mermaid theme, switched on with markdown.mermaid in the site configuration.', 'Not covered by its diagrams documentation.'],
  ['Material for MkDocs', 'A custom fence for mermaid in the superfences setting; no plugin.', 'Not covered by its diagrams documentation.'],
  ['Sphinx', 'The sphinxcontrib-mermaid extension.', 'The sphinxcontrib.plantuml extension, which runs a local PlantUML jar through Java.'],
  ['Asciidoctor', 'Asciidoctor Diagram.', 'Asciidoctor Diagram.'],
  ['Kroki, a service that renders both from text', 'Supported.', 'Supported.'],
  ['Notion', 'Mermaid’s list of integrations marks Notion as supported. Notion’s own help page on code blocks, the one checked, doesn’t mention Mermaid.', 'Not checked.'],
  ['Confluence', 'Not built in as far as this page could confirm. Several third-party apps on the Atlassian Marketplace add Mermaid macros, and Mermaid’s integrations list names some of them.', 'Not checked.'],
  ['Google Docs', 'No built-in support found. Mermaid’s integrations list names a third-party add-on.', 'Not checked.'],
];

const versionRows: [string, string, string, string][] = [
  ['create participant and destroy', '10.3.0', 'Mermaid’s sequence page', 'Parsed and drawn by every 11.x release tried, from 11.1.0.'],
  ['Arrows that point both ways, <<->>', '11.0.0', 'Mermaid’s sequence page', 'Parsed from 11.1.0, the oldest release tried.'],
  ['Participant types, such as participant DB@{ "type": "database" }', '11.11.0', 'The 11.11.0 release notes', 'Rejected by 11.4.0 and 11.4.1; parsed by 11.12.2.'],
  ['An alias after the type, @{ … } as Name', '11.13.0', 'The 11.13.0 release notes', 'Rejected by 11.12.3 and parsed by 11.13.0.'],
  ['Half arrowheads such as -|\\ and central connections such as ->>()', '11.13.0', 'The 11.13.0 release notes', 'The sequence page says 11.12.3. Release 11.12.3 rejected the arrows and drew the central connection as text; 11.13.0 parsed both.'],
  ['A decimal start or step, such as autonumber 1.5 0.5', '11.15.0', 'The 11.15.0 release notes', 'Rejected by 11.14.0 and parsed by 11.15.0. Plain autonumber and whole-number starts are older.'],
  ['A new default theme and look for sequence diagrams', '12.0.0', 'Mermaid’s sequence page', 'Appearance only; the syntax is unchanged.'],
];

const sources: [string, string, string][] = [
  ['https://mermaid.js.org/syntax/sequenceDiagram.html', 'Mermaid, Sequence diagrams', 'every arrow and block, with the versions in which some arrived'],
  ['https://github.com/mermaid-js/mermaid/releases', 'Mermaid releases', 'the release notes that date participant types, half arrows and decimal numbering'],
  ['https://plantuml.com/sequence-diagram', 'PlantUML, Sequence diagram', 'arrows, frames, activation, anchors and every other construct in the tables'],
  ['https://docs.github.com/en/get-started/writing-on-github/working-with-advanced-formatting/creating-diagrams', 'GitHub Docs, Creating diagrams', 'which syntaxes GitHub renders, and the check for its Mermaid version'],
  ['https://docs.gitlab.com/user/markdown/#diagrams-and-flowcharts', 'GitLab Docs, Diagrams and flowcharts', 'Mermaid and PlantUML blocks in GitLab Markdown'],
  ['https://mermaid.js.org/ecosystem/integrations-community.html', 'Mermaid, Community integrations', 'which tools and wikis list Mermaid support, including Notion, Confluence and Google Docs'],
  ['https://d2lang.com/tour/sequence-diagrams/', 'D2, Sequence diagrams', 'the sequence_diagram shape, groups, spans and notes'],
];
---
<DrawingArticle title={title} description={description} headings={headings} slug="sequence-syntax" type="Companion" version="Mermaid 12.2 · PlantUML 1.2026.9">
  <p><a href={seq}>Sequence diagrams</a> teaches what a sequence diagram says and writes every example in Mermaid. This page is for the other moment: you know the picture you want and need the text that draws it, or someone has sent you a PlantUML file and you want to know what its arrows mean.</p>
  <p>Mermaid and PlantUML draw most of the same diagrams from different text. Many constructs line up one for one. Some differ only in spelling, and a few arrows look alike in both tools yet mean different things. Each tool also draws things the other can’t, and where a diagram will render depends on which of them the place supports.</p>
  <p>Syntax changes between releases, so every listing here was rendered on 17 October 2026 with Mermaid 12.2.0 and PlantUML 1.2026.9. GitHub and GitLab run their own copy of Mermaid, which can be older than that one. Where a piece of Mermaid syntax is newer than version 11.0, the table in <a href="#mermaid-versions">Mermaid syntax by version</a> gives the release that introduced it.</p>

  <h2 id={h['one-booking-in-both-syntaxes'].id}>{h['one-booking-in-both-syntaxes'].text}</h2>
  <p>Mina books a repair. The API starts an email request and answers her without waiting for it, so the provider’s reply, when it comes, has no one to receive it. That is the <a href={`${seq}#synchronous-and-asynchronous-messages`}>asynchronous message</a> from the main article, with the fact written down in a note. Both listings draw the same thing: three lifelines, a call that starts an activation bar on the API, an asynchronous message, a reply that ends the bar, and the note.</p>
  <Code code={mermaidBooking} lang="mermaid" themes={themes} />
  <Code code={plantumlBooking} lang="text" themes={themes} />
  <p>A few differences show up already. Mermaid declares a participant’s short name first and its display text after <code>as</code>. PlantUML takes the display text first, in quotes, and the short name after <code>as</code>. Mermaid’s call arrow is <code>{'->>'}</code> and its asynchronous arrow <code>-)</code>. In PlantUML the call is <code>{'->'}</code> and the asynchronous message is <code>{'->>'}</code>. PlantUML wraps a diagram in <code>@startuml</code> and <code>@enduml</code>, except inside a GitLab <code>plantuml</code> block, which adds them.</p>

  <h2 id={h['constructs-side-by-side'].id}>{h['constructs-side-by-side'].text}</h2>
  <p>The first column of each table says what the construct means, in the terms the main article uses, and links to where that article explains it. The mark … stands for the lines inside a block. “None” means the tool has no syntax for it, which the section on <a href="#what-each-tool-cannot-draw">what each tool can’t draw</a> explains further.</p>

  <h3 id={h['participants-notes-and-text'].id}>{h['participants-notes-and-text'].text}</h3>
  <table>
    <thead><tr><th>Meaning</th><th>Mermaid</th><th>PlantUML</th></tr></thead>
    <tbody>{participantRows.map(([meaning, link, m, p]) => <tr><td>{link ? <a href={`${seq}${link}`}>{meaning}</a> : meaning}</td><td><code>{m}</code></td><td><code>{p}</code></td></tr>)}</tbody>
  </table>
  <p>Both tools draw a lifeline for any name that first appears in a message. Declare participants anyway, in the order you want them across the page. PlantUML also has <code>entity</code>, <code>control</code>, <code>boundary</code> and <code>collections</code> shapes, which Mermaid reaches through the same <code>type</code> setting as <code>database</code>.</p>
  <p>Mermaid reads a <code>#</code> in a message as the start of an entity code and cuts the text there. <code>ticket #42</code> comes out as “ticket”, and <code>ticket #35;42</code> keeps the whole label. A semicolon ends a statement, so write <code>#59;</code> inside a label. PlantUML shows both characters as typed.</p>

  <h3 id={h['activation-creation-and-numbering'].id}>{h['activation-creation-and-numbering'].text}</h3>
  <table>
    <thead><tr><th>Meaning</th><th>Mermaid</th><th>PlantUML</th></tr></thead>
    <tbody>{lifetimeRows.map(([meaning, link, m, p]) => <tr><td>{link ? <a href={`${seq}${link}`}>{meaning}</a> : meaning}</td><td><code>{m}</code></td><td><code>{p}</code></td></tr>)}</tbody>
  </table>
  <p>The <code>+</code> and <code>-</code> in Mermaid and the <code>++</code> and <code>--</code> in PlantUML do the same job from opposite sides of the arrow. Mermaid writes them on the arrow itself, and <code>-</code> ends the bar of the lifeline the reply leaves. PlantUML writes them after the target, and <code>--</code> ends the bar of the lifeline the message leaves. Read them as “start a bar on the receiver” and “end the sender’s bar” in either tool.</p>
  <p><code>destroy</code> is the one place where position matters in opposite ways. Mermaid wants it before the message, and PlantUML after it. In both, the lifeline ends at that message.</p>

  <h3 id={h['frames'].id}>{h['frames'].text}</h3>
  <table>
    <thead><tr><th>Meaning</th><th>Mermaid</th><th>PlantUML</th></tr></thead>
    <tbody>{frameRows.map(([meaning, link, m, p]) => <tr><td>{link ? <a href={`${seq}${link}`}>{meaning}</a> : meaning}</td><td><code>{m}</code></td><td><code>{p}</code></td></tr>)}</tbody>
  </table>
  <p>The two tools part ways on <code>par</code> and <code>critical</code>. Mermaid separates parallel sections with <code>and</code> and the cases of a critical region with <code>option</code>. PlantUML uses <code>else</code> for both and reports an error on <code>and</code> or <code>option</code>. A guard is written without square brackets in both tools, and both add them when they draw the frame.</p>

  <h2 id={h['arrows-that-change-meaning'].id}>{h['arrows-that-change-meaning'].text}</h2>
  <p>Translating a diagram by eye is where most mistakes happen. The two tools use the same characters for different arrows, so a diagram that converts without an error can still say something else.</p>
  <table>
    <thead><tr><th>Meaning</th><th>Mermaid</th><th>PlantUML</th></tr></thead>
    <tbody>{arrowRows.map(([meaning, link, m, p]) => <tr><td>{link ? <a href={`${seq}${link}`}>{meaning}</a> : meaning}</td><td><code>{m}</code></td><td><code>{p}</code></td></tr>)}</tbody>
  </table>
  <p>Three traps follow from the table:</p>
  <ul>
    <li>Mermaid’s <code>{'->'}</code> and <code>{'-->'}</code> draw a line with no arrowhead at all. PlantUML’s <code>{'->'}</code> is a call and its <code>{'-->'}</code> is a dotted reply. Copying <code>{'A->B'}</code> from one to the other swaps a call for a bare line, or the reverse.</li>
    <li>Mermaid’s <code>{'->>'}</code> is a call and PlantUML’s <code>{'->>'}</code> is a thin-headed asynchronous message. A call that is pasted across unchanged turns into a message nobody waits for.</li>
    <li>Mermaid marks a lost message with a cross and has no circle. PlantUML has both: <code>{'->x'}</code> for the cross and <code>{'->o'}</code> for the filled circle the main article calls a lost message.</li>
  </ul>
  <p>PlantUML’s default arrowheads are sharp rather than UML’s triangle. Adding <code>skinparam style strictuml</code> to the diagram draws the triangle.</p>

  <h2 id={h['what-each-tool-cannot-draw'].id}>{h['what-each-tool-cannot-draw'].text}</h2>
  <p>Most sequence diagrams stay inside what both tools draw. These lists are for the ones that don’t.</p>

  <h3 id={h['mermaid-cannot'].id}>{h['mermaid-cannot'].text}</h3>
  <p>Mermaid 12.2.0 has no syntax for the following. Where a line looks plausible, Mermaid often accepts it and draws something unintended, so look at the result.</p>
  <ul>
    <li><strong>A <code>ref</code> frame</strong> that stands for another diagram. It is a parse error. The <a href={`${seq}#ref`}>main article’s</a> workaround is a note across the lifelines.</li>
    <li><strong>A found message or a message to the edge of the diagram.</strong> PlantUML writes <code>{'[->'}</code> and <code>{'->]'}</code>. Mermaid reads <code>{'[->>A: text'}</code> as a message from a new participant named “[”.</li>
    <li><strong>A lost message that ends in a circle.</strong> Writing <code>{'A->>oB'}</code> creates a participant called “oB”.</li>
    <li><strong>A delay or a divider</strong>, which PlantUML writes <code>...</code> and <code>== Phase ==</code>. Both are parse errors in Mermaid. <a href={`${seq}#order-gaps-and-time`}>The main article</a> says how to show a wait without them.</li>
    <li><strong>Messages that start together.</strong> PlantUML’s <code>&amp;</code> puts two messages at the same height. Mermaid reads <code>&amp; A</code> as a participant name. <code>par</code> says the order is free, which is a different claim from “at the same moment”.</li>
    <li><strong>A duration marker</strong> between two messages, such as “10 s limit” drawn as a bracket. PlantUML does it with anchors. The main article’s section on <a href={`${seq}#order-gaps-and-time`}>order, gaps and time</a> covers where a limit goes instead.</li>
    <li><strong>A note on a message, <code>return</code> and automatic activation.</strong> These are parse errors or absent; write the reply and the <code>+</code> and <code>-</code> yourself.</li>
  </ul>
  <p>Mermaid also draws half arrowheads and central connections, which this page leaves out because the main article’s diagrams don’t use them. They need 11.13.0 or later.</p>

  <h3 id={h['plantuml-cannot'].id}>{h['plantuml-cannot'].text}</h3>
  <p>PlantUML 1.2026.9 can draw every construct in the tables above except a coloured background behind messages: <code>rect</code> is a parse error. Mermaid also offers menus of links on a participant, and PlantUML’s sequence documentation describes nothing like them.</p>
  <p>The more practical limit is where it runs. PlantUML renders through Java or through a PlantUML server, so a place that only runs JavaScript in the browser can’t draw it. The next section lists the places that can.</p>

  <h2 id={h['where-each-one-renders'].id}>{h['where-each-one-renders'].text}</h2>
  <p>A diagram that doesn’t render is a block of text, so check the place where readers will see it before choosing the tool. The first rows follow each place’s own documentation as of 17 October 2026. The Notion, Confluence and Google Docs rows rest on Mermaid’s list of integrations and a search of the Atlassian Marketplace, because those products’ own documentation either didn’t mention Mermaid or couldn’t be read here. Test a diagram in the page itself before committing to a tool there, and treat a PlantUML answer for those three as unknown.</p>
  <table>
    <thead><tr><th>Place</th><th>Mermaid</th><th>PlantUML</th></tr></thead>
    <tbody>{renderRows.map(([place, m, p]) => <tr><td>{place}</td><td>{m}</td><td>{p}</td></tr>)}</tbody>
  </table>
  <p>Where PlantUML isn’t rendered, the usual answer is to commit the exported image beside the source file, or to generate it in the build. The main article’s <a href="/learn/drawing-systems/maintaining/">Keeping diagrams useful</a> covers keeping source and picture together.</p>
  <p>GitHub doesn’t publish the Mermaid version it uses. Its documentation suggests putting <code>info</code> alone in a fenced <code>mermaid</code> block, which draws the version number. A docs build uses whatever version its plugin installed, so the answer there is in the lock file. Syntax from 11.13.0 onward, listed next, is the part most likely to hit an older renderer.</p>

  <h3 id={h['mermaid-versions'].id}>{h['mermaid-versions'].text}</h3>
  <p>The release is taken from Mermaid’s release notes where they name the change, and from the sequence page where they don’t. The last column records what rendering showed. The releases tried were 11.1.0, 11.4.0, 11.4.1, 11.12.2, 11.12.3, 11.13.0 to 11.17.2 and 12.2.0; a release not on that list was not tried.</p>
  <table>
    <thead><tr><th>Syntax</th><th>First in</th><th>Source</th><th>Rendered check</th></tr></thead>
    <tbody>{versionRows.map(([syntax, version, source, check]) => <tr><td><code>{syntax}</code></td><td>{version}</td><td>{source}</td><td>{check}</td></tr>)}</tbody>
  </table>
  <p>PlantUML’s documentation is for the current release and rarely says when something arrived. It does record one removal: since 1.2025.5 the old <code>skinparam lifelineStrategy solid</code> no longer works, and solid lifelines come from a <code>&lt;style&gt;</code> block. PlantUML also documents <code>!pragma teoz true</code> for <code>&amp;</code>, anchors and nested boxes. 1.2026.9 drew <code>&amp;</code> and anchors without it, but a renderer that is older, such as one bundled with a wiki or an IDE plugin, may need it.</p>

  <h2 id={h['d2-and-drawing-by-hand'].id}>{h['d2-and-drawing-by-hand'].text}</h2>
  <p>D2 draws sequence diagrams too, with no syntax of its own for them. Setting <code>shape: sequence_diagram</code> on a diagram or an object turns the connections inside it into messages, in the order you write them. Children of the diagram share one scope, so <code>api</code> means the same lifeline everywhere. A group is a labelled container for a stretch of messages, and a span, which D2 uses for an activation bar, is an object nested on a lifeline. A note is an object nested on a lifeline with no connection to it. The same booking looks like this:</p>
  <Code code={d2Booking} lang="text" themes={themes} />
  <p>D2 treats a message as an arrow and styles it like any other, as the dashed reply shows. It has no <code>alt</code>, <code>loop</code> or <code>par</code> operators, so a frame is a group with a label you write yourself. Choose it when the rest of your diagrams are already D2 and one of them is a sequence. This page checked it against D2 0.9.0. GitHub doesn’t render D2, but Kroki and Asciidoctor Diagram do.</p>
  <p>Drawing by hand in an editor such as draw.io trades the text source for control over layout, and the main article’s <a href="/learn/drawing-systems/maintaining/">guide to keeping diagrams useful</a> weighs that trade. draw.io’s documentation describes inserting Mermaid source and then editing the shapes it creates. Check how it handles a sequence diagram before relying on it, because this page didn’t.</p>

  <h2 id={h['sources-and-further-reading'].id}>{h['sources-and-further-reading'].text}</h2>
  <ul>
    {sources.map(([href, label, why]) => <li><a href={href}>{label}</a>: {why}.</li>)}
    <li>On this site: <a href={seq}>Sequence diagrams</a>, for what each construct in the tables means and when to draw it, and <a href="/learn/drawing-systems/maintaining/">Keeping diagrams useful</a>, for choosing a tool and keeping its source beside the picture.</li>
  </ul>
</DrawingArticle>
