---
import { Code } from 'astro:components';
import DrawingArticle from '../../../layouts/DrawingArticle.astro';
import SequencePlayer from '../../../components/explainers/sequences/SequencePlayer.astro';

// This article is an Astro page rather than Markdown so it can hold the animations.
const title = 'Drawing asynchronous and event-driven interactions';
const description = 'Draw the broker, acknowledgements and redelivery, fan-out, overtaking, webhooks with correlation ids, flows that last days and sagas with compensation, and see when a state or process view serves better.';
const sections = [
  [2, 'three-questions-for-every-asynchronous-arrow', 'Three questions for every asynchronous arrow'],
  [2, 'the-broker-as-a-participant', 'The broker as a participant'],
  [3, 'queue-or-topic', 'Queue or topic'],
  [2, 'acknowledgement-and-redelivery', 'Acknowledgement and redelivery'],
  [3, 'messages-that-keep-failing', 'Messages that keep failing'],
  [2, 'fan-out-to-several-consumers', 'Fan-out to several consumers'],
  [3, 'competing-consumers-or-subscribers', 'Competing consumers or subscribers'],
  [2, 'ordering-and-overtaking', 'Ordering and overtaking'],
  [2, 'webhooks-and-callbacks', 'Webhooks and callbacks'],
  [3, 'a-callback-is-a-new-message', 'A callback is a new message'],
  [3, 'the-correlation-id', 'The correlation id'],
  [3, 'the-callback-that-arrives-first', 'The callback that arrives first'],
  [3, 'when-no-callback-comes', 'When no callback comes'],
  [2, 'flows-that-last-hours-or-days', 'Flows that last hours or days'],
  [2, 'sagas-and-compensation', 'Sagas and compensation'],
  [3, 'orchestrated-or-choreographed', 'Orchestrated or choreographed'],
  [2, 'which-view-for-a-long-running-workflow', 'Which view for a long-running workflow'],
  [2, 'questions-to-put-to-every-arrow', 'Questions to put to every arrow'],
  [2, 'try-a-completed-repair-event', 'Try a completed-repair event'],
  [2, 'sources-and-further-reading', 'Sources and further reading'],
] as const;
const headings = sections.map(([depth, slug, text]) => ({ depth, slug, text }));
const h = Object.fromEntries(sections.map(([, slug, text]) => [slug, { id: slug, text }]));
const themes = { light: 'github-light', dark: 'github-dark' } as const;

const broker = `sequenceDiagram
    participant API as Repair API
    participant Queue as Email queue
    participant Worker as Notification worker
    API->>Queue: Publish J9
    Queue-->>API: Stored
    Queue-)Worker: Deliver J9
    Worker-)Queue: Ack J9`;

const dualWrite = `sequenceDiagram
    participant API as Repair API
    participant DB as Repair DB
    participant Queue as Email queue
    API->>DB: INSERT booking R17
    DB-->>API: COMMIT ok
    Note over API: A crash here: booking, no email
    API->>Queue: Publish J9
    Queue-->>API: Stored`;

const deadLetter = `sequenceDiagram
    participant Queue as Email queue
    participant Worker as Notification worker
    participant DLQ as Dead-letter queue
    participant Ops as Support team
    Queue-)Worker: Deliver J9
    Note over Worker: Fails
    alt delivered fewer than 5 times
        Queue-)Worker: Deliver J9 (again)
    else fifth delivery failed
        Queue-)DLQ: Move J9
        Ops->>DLQ: Review dead letters daily
    end`;

const redelivery = `sequenceDiagram
    participant Queue as Email queue
    participant Worker as Notification worker
    participant Provider as Email provider
    Queue-)Worker: Deliver J9
    Worker->>Provider: POST /emails
    Provider-->>Worker: 202 Accepted
    Note over Worker: Crashes before the ack
    Note over Queue,Worker: Ack deadline passes
    Queue-)Worker: Deliver J9 (again)
    Worker->>Provider: POST /emails
    Provider-->>Worker: 202 Accepted
    Worker-)Queue: Ack J9`;

const fanout = `sequenceDiagram
    participant Sched as Scheduling
    participant Topic as Repair events
    participant Tech as Technician app
    participant Billing
    Sched->>Topic: Publish Scheduled A5
    Topic-->>Sched: Stored
    par technician app
        Topic-)Tech: Scheduled A5
        Tech-)Topic: Ack
    and billing
        Topic-)Billing: Scheduled A5
        Billing-)Topic: Ack
    end
    Note over Topic,Billing: Subscribers today: technician app, billing
    Note over Topic: Assumes a durable subscription for each`;

const overtaking = `sequenceDiagram
    participant Sched as Scheduling
    participant Topic as Repair events
    participant Billing
    Note over Sched,Topic: No ordering promise (for example SQS standard)
    Sched-)Topic: Moved v2: 14 Oct
    Sched-)Topic: Cancelled v3
    Topic-)Billing: Cancelled v3
    Topic-)Billing: Moved v2: 14 Oct
    Note over Billing: Holds v3, so ignores v2`;

const webhook = `sequenceDiagram
    participant Worker as Notification worker
    participant Provider as Email provider
    participant API as Repair API
    participant DB as Repair DB
    Worker->>Provider: POST /emails (J9)
    Provider-->>Worker: 202 id m-481
    Worker->>DB: Save m-481 on J9
    DB-->>Worker: OK
    Note over Worker,DB: Hours later, the email bounces
    Provider->>API: POST /bounce m-481
    API->>API: Verify signature
    API->>DB: Store bounce m-481
    DB-->>API: OK
    API-->>Provider: 200 OK
    API->>DB: Match stored m-481
    DB-->>API: J9
    API->>DB: J9: bounced
    DB-->>API: OK`;

const confirm = `sequenceDiagram
    participant Mina
    participant API as Repair API
    participant Timer as Scheduler
    API-)Mina: Confirm appointment A5
    API->>Timer: Remind +24 h, release +48 h
    Timer-->>API: Timers stored
    Note over API: Row saved: A5 held until Friday 10:00
    Note over Mina,Timer: 24 hours later
    Timer-)API: Reminder due
    API-)Mina: Reminder: confirm A5
    Note over Mina,Timer: 24 hours later, no reply
    Timer-)API: Release due
    API-)Mina: A5 released
    Note over Mina,Timer: The next morning
    Mina->>API: Confirm A5
    API-->>Mina: 409: A5 released`;

const saga = `sequenceDiagram
    participant Booking
    participant Slots as Scheduling
    participant Parts as Inventory
    participant Billing
    Booking->>Slots: Hold time for A5
    Slots-->>Booking: Held
    Booking->>Parts: Reserve part P3
    Parts-->>Booking: Reserved
    Booking->>Billing: Take deposit
    alt deposit accepted
        Billing-->>Booking: Paid
        Note over Booking: Booking confirmed
    else deposit declined
        Billing-->>Booking: Declined
        Booking->>Parts: Release part P3
        Parts-->>Booking: Released
        Booking->>Slots: Release time for A5
        Slots-->>Booking: Released
    end`;

const choreography = `sequenceDiagram
    participant Slots as Scheduling
    participant Topic as Booking events
    participant Parts as Inventory
    participant Billing
    Slots-)Topic: TimeHeld A5
    Topic-)Parts: TimeHeld A5
    Parts-)Topic: PartReserved P3
    Topic-)Billing: PartReserved P3
    Billing-)Topic: DepositDeclined
    par release the part
        Topic-)Parts: DepositDeclined
    and release the time
        Topic-)Slots: DepositDeclined
    end`;

const practiceAnswer = `sequenceDiagram
    participant Repair as Repair service
    participant Topic as Repair events
    participant Billing
    participant Worker as Notification worker
    participant Parts as Parts system
    Note over Repair,Topic: Per repair order, at least once. Durable subscriptions
    Repair-)Topic: RepairCompleted R17 v1
    par billing
        Topic-)Billing: RepairCompleted R17 v1
        Note over Billing: Skip if R17 already invoiced
        Billing-)Topic: Ack
    and survey
        Topic-)Worker: RepairCompleted R17 v1
        Worker-)Topic: Ack
    and stock
        Topic-)Parts: RepairCompleted R17 v1
        Parts-)Topic: Ack
    end
    Repair-)Topic: NeedsSecondVisit R17 v2
    Topic-)Billing: NeedsSecondVisit R17 v2
    Note over Billing: Keeps the highest version for R17`;

const views: [string, string, string][] = [
  ['In what order do these systems talk, in this case?', 'Sequence diagram', 'It shows one run in order, with who waits and what each side knows.'],
  ['What can happen to this appointment next, whatever happened before, and what must be refused?', 'State diagram', 'A late “Confirm A5” is one missing transition from Released, not another sequence.'],
  ['Who owns the wait, and what work continues while it lasts?', 'Process map with swimlanes', 'Waiting, reminders and cancellation are routes through the work, and lanes name who is responsible.'],
  ['Which systems are involved and who may call whom?', 'Architecture diagram', 'It says nothing about order, which is what keeps it readable.'],
];

const questions: [string, string][] = [
  ['Which arrow is the acknowledgement, and does it come after the work?', 'An ack arrow of its own, positioned after the step it vouches for. If it is missing, the diagram implies delivery is handling.'],
  ['What does the drawing assume about the broker or provider?', 'A note with the product named: durable or not, ordered or not, at least once or at most once.'],
  ['What if it arrives after something sent later?', 'The order received at the consumer, and the ordering the design relies on, such as per appointment.'],
  ['What if it never arrives?', 'A timer, a deadline note or a reconciliation step.'],
  ['Who looks at what failed for good?', 'The dead-letter queue and a named reader, or a note that nobody does yet.'],
  ['What did other readers see in the middle?', 'The held slot, the half-finished booking. Compensation does not erase these.'],
];
---
<DrawingArticle title={title} description={description} headings={headings} slug="async-interactions" version="Mermaid 11">
  <p>The sequence-diagram article draws requests that somebody waits for, or that somebody should have waited for. Plenty of real flows are built so that nobody waits. The API hands Mina’s confirmation email to a queue and answers her at once. The scheduling service announces that an appointment is booked, and other systems react in their own time. An email provider posts a bounce to us two hours after we asked it to send. The arrows for these look like the ones already drawn, but they promise less, and a reader who reads them like a request and its reply gets the flow wrong.</p>
  <p>This article is about drawing those flows so the picture says what is true, and about reading someone else’s picture for what it leaves out. It takes the broker, acknowledgement and redelivery, fan-out, ordering, webhooks, flows that last days and sagas in turn, and ends with when to stop drawing sequences and draw states instead. It doesn’t teach how brokers behave. Delivery guarantees, partitions and consumer groups differ between products and change between versions. Where a drawing depends on one, the article says which question the drawing has to answer and sends you to that product’s documentation.</p>
  <p>The examples continue the repair service from <a href="/learn/drawing-systems/sequences/">Sequence diagrams</a>: Mina’s booking R17, the notification job J9 and the email provider. The scheduling event that reaches the technician app and billing, the 48-hour confirmation window and the booking saga are invented for this article, as are all the names, ids and timings.</p>

  <h2 id={h['three-questions-for-every-asynchronous-arrow'].id}>{h['three-questions-for-every-asynchronous-arrow'].text}</h2>
  <p>A call and its dotted reply tell the reader who knows the outcome and when. An <a href="/learn/drawing-systems/sequences/#synchronous-and-asynchronous-messages">asynchronous message</a> has no reply to carry that. Its open arrowhead says only that the message left the sender and that the sender carried on. Everything else the reader needs has to come from somewhere else in the drawing, and it comes down to three questions.</p>
  <ul>
    <li><strong>Who holds the message while it is in flight?</strong> The sender’s memory, a database row, a broker. If the holder fails, is the message still there?</li>
    <li><strong>How does the sender find out what happened?</strong> By an acknowledgement, by a callback hours later, or never.</li>
    <li><strong>What happens if it doesn’t arrive, or arrives twice?</strong></li>
  </ul>
  <p>Each section below applies these to one part of an asynchronous flow. A drawing can’t prove that a broker delivers a message once, only say which behaviour it relies on. That sentence in a note, with the product named, is worth more than an arrow that lets readers assume.</p>

  <h2 id={h['the-broker-as-a-participant'].id}>{h['the-broker-as-a-participant'].text}</h2>
  <p>Take the notification again, with a queue in place of the polling worker. The API publishes J9 to an email queue, and a worker later receives it. How should the queue appear?</p>
  <p>Sending to a broker can be two things at once. Here the API waits for the broker to say it has taken responsibility for the message: Amazon SQS’s <a href="https://docs.aws.amazon.com/AWSSimpleQueueService/latest/SQSDeveloperGuide/standard-queues.html">documentation</a> says it stores a message redundantly before acknowledging it. Not every client waits. RabbitMQ sends <a href="https://www.rabbitmq.com/docs/confirms">publisher confirms</a> only when the publisher turns them on, and then asynchronously. A Kafka producer batches messages and learns later whether the broker stored them. Whether the send is a call depends on what the sender does next. The delivery to a consumer is asynchronous either way. Draw a send the API waits on as a call with a reply and the delivery as an open arrow, and the reader can see both that the API knows the message is safe and that it doesn’t know when anyone acts on it.</p>
  <Code code={broker} lang="mermaid" themes={themes} />
  <p>The same hop could be one arrow, <code>API-)Worker: Send confirmation email for J9</code>. Choose between them by asking whether anything about the broker would change a reader’s conclusion. Draw it as a lifeline when it acknowledges, keeps messages until they are handled, offers them again, decides who receives a message or decides the order. Draw a direct arrow when the question is about the two services’ conversation and the broker is plumbing. Say once, in a label or a note, that the arrow travels through the queue. Don’t draw both for the same hop in one diagram, because a reader will count two messages.</p>
  <p>A direct arrow makes a claim of its own. It says the message reaches the worker, and nothing about what happens when the worker is down. If that case matters to the discussion, the broker belongs in the picture.</p>
  <p>Publishing also hides a gap that the picture above doesn’t show. If the API stores the booking and then publishes J9 as a separate step, a crash between the two leaves a booking with no email. Publishing first and then storing can send an email for a booking that rolled back. Draw the steps as separate arrows and ask where a crash between any two leaves the data:</p>
  <Code code={dualWrite} lang="mermaid" themes={themes} />
  <p>The <a href="/learn/drawing-systems/sequences/#background-workers-and-the-transactional-outbox">transactional outbox</a> closes the gap by writing the job in the booking’s own transaction, with a relay that reads the table and publishes. A queue doesn’t replace it. It changes who reads the table and where the message waits.</p>

  <h3 id={h['queue-or-topic'].id}>{h['queue-or-topic'].text}</h3>
  <p>Both are one lifeline in a sequence diagram. The whiteboard symbols in <a href="/learn/drawing-systems/vocabulary/#queue-and-pubsub-topic">Queue and pub/sub topic</a> separate them by shape. Here the difference shows in how many arrows leave. A queue hands each message to one of its consumers. A topic hands each message to every subscriber. Put the kind in the lifeline’s name, “Email queue” or “Repair events (topic)”, and let the arrows count. Neither name says how long messages are kept, whether a new subscriber sees old ones or what order is kept. If a discussion turns on one of those, write it in a note.</p>

  <h2 id={h['acknowledgement-and-redelivery'].id}>{h['acknowledgement-and-redelivery'].text}</h2>
  <p>A worker that takes J9 from a queue does three things: receives it, does the work, and tells the queue it is finished. Draw them as three messages. The queue keeps J9 until it hears the third. If the acknowledgement doesn’t come before a deadline, or the worker’s connection closes, the queue offers J9 again. SQS calls the deadline the <a href="https://docs.aws.amazon.com/AWSSimpleQueueService/latest/SQSDeveloperGuide/sqs-visibility-timeout.html">visibility timeout</a>, 30 seconds by default. RabbitMQ <a href="https://www.rabbitmq.com/docs/confirms">requeues</a> a delivery that was never acknowledged when its channel or connection closes.</p>
  <p>Where the acknowledgement sits decides what a crash costs. Play the first case, then the other two.</p>
  <SequencePlayer scenario="ack" n={1} />
  <p>With the acknowledgement after the work, a crash between the email and the acknowledgement leaves the queue believing J9 is unfinished. It delivers J9 again, and the provider sends a second email. This is the picture from the <a href="/learn/drawing-systems/sequences/#background-workers-and-the-transactional-outbox">outbox’s crashed worker</a> with a different holder. A claim that expires and a deadline that passes are the same event, so the same remedy applies: send the idempotency key on every attempt, as in <a href="/learn/drawing-systems/sequences/#retries-and-idempotency-keys">Retries and idempotency keys</a>.</p>
  <p>With the acknowledgement before the work, the crash loses J9. The queue has already removed it, nothing offers it again and no email is sent. Nobody gets a duplicate, and nobody gets the email either. Neither position is free. The usual choice is to acknowledge after the work and make the work safe to repeat, and the point of drawing the acknowledgement as its own arrow is that this choice becomes visible. Diagrams that leave it out imply that the message was handled the moment it was delivered.</p>
  <p>The deadline needs a number in a note too. If the email can take longer than the deadline, the queue offers J9 to a second worker while the first is still sending it, with no crash at all. Brokers usually let a consumer extend the deadline while it works, and SQS documents how in its visibility-timeout page.</p>
  <p>A second delivery doesn’t always need a failure. SQS standard queues are documented as at-least-once, so <a href="https://docs.aws.amazon.com/AWSSimpleQueueService/latest/SQSDeveloperGuide/standard-queues.html">more than one copy of a message might be delivered</a> when nothing has gone wrong. Draw the second delivery when the design has to handle it. The idempotency key covers both causes.</p>
  <p>The acknowledgement takes different forms. In SQS it is a call that deletes the message, so a failed delete also leads to redelivery. In a log such as Kafka the consumer commits an offset that stands for every message before it, so after a crash it resumes from the last commit and replays everything since. Label that arrow for what it covers, such as <code>Commit offset 42 (acks all before it)</code>, and take the exact behaviour from <a href="https://kafka.apache.org/documentation/">Kafka’s documentation</a>.</p>
  <Code code={redelivery} lang="mermaid" themes={themes} />

  <h3 id={h['messages-that-keep-failing'].id}>{h['messages-that-keep-failing'].text}</h3>
  <p>Some messages fail every time: a malformed address, a worker bug on one input. Redelivery then repeats forever. Many brokers can move a message to a dead-letter queue after a set number of deliveries; <a href="https://docs.aws.amazon.com/AWSSimpleQueueService/latest/SQSDeveloperGuide/sqs-visibility-timeout.html">SQS describes its dead-letter queues</a> next to the visibility timeout. Draw that branch once, as an <code>alt</code> after the Nth delivery, with an arrow from the queue to the dead-letter queue, and then name who reads it:</p>
  <Code code={deadLetter} lang="mermaid" themes={themes} />
  <p>A diagram that ends at a dead-letter queue claims that someone looks there. If nobody does, the diagram should say so in a note.</p>

  <h2 id={h['fan-out-to-several-consumers'].id}>{h['fan-out-to-several-consumers'].text}</h2>
  <p>When an appointment is scheduled, the scheduling service publishes one event. The technician app needs it to put the appointment on a route, and billing needs it to raise the deposit invoice. In the drawing, the publisher sends the event once, to the topic. The topic then delivers it to each subscriber as a separate message, with a separate acknowledgement. Start the figure and look at who talks to whom, then switch to <em>Billing is down</em>.</p>
  <SequencePlayer scenario="fanout" n={2} />
  <p>Three claims come out of this drawing, and each is easy to lose by drawing it differently.</p>
  <p>The arrows to the subscribers leave the topic, not the scheduling service. An arrow from scheduling to billing would say scheduling calls billing and knows it exists. The publisher in this design doesn’t. The subscriber list on the page is a record of who listens today. Adding a reporting service adds a lifeline in the next version of the drawing and changes nothing the publisher sends, so keep the list in a note where it can be updated.</p>
  <p>The deliveries are not ordered with respect to each other. Nothing in the diagram says the technician app hears first, and the <code>par</code> frame is how the drawing says so. Setting <em>Billing answers first</em> gives an equally valid history.</p>
  <p>Failure is separate for each subscriber. With billing down, the technician app acknowledges and gets on with its work, and the publisher’s part is finished. What happens to billing’s copy depends on the product and how the subscription is set up. A durable subscription, such as a queue per subscriber, keeps A5’s event until billing returns. A subscriber that isn’t durable simply misses it. The figure assumes the durable kind and the topic pushing the event, and says so in a note. Write the assumption on your own drawing in the same way. The consequence is worth stating on the page: the technician app may act on A5 before billing knows about it. If billing must have the deposit before the appointment is confirmed, this is not a fan-out, and the flow needs a reply from billing. The sagas section below covers it.</p>
  <Code code={fanout} lang="mermaid" themes={themes} />

  <h3 id={h['competing-consumers-or-subscribers'].id}>{h['competing-consumers-or-subscribers'].text}</h3>
  <p>Two workers reading one queue are not the same as two subscribers to one topic. Competing workers share the messages: J9 goes to one of them and J10 may go to the other. Subscribers each get their own copy. Both are two arrows leaving a broker lifeline, so the label has to carry the difference. For workers, draw them as two lifelines, <code>Worker A</code> and <code>Worker B</code>, and add a note, “each job goes to one of them”. For subscribers, name each one and note that each receives every event. Some systems give each subscriber a private queue behind the topic. Draw that queue only if its behaviour, such as holding events while the subscriber is down, is what the discussion is about.</p>

  <h2 id={h['ordering-and-overtaking'].id}>{h['ordering-and-overtaking'].text}</h2>
  <p>The sequence article’s <a href="/learn/drawing-systems/sequences/#order-gaps-and-time">order section</a> gives the two places where a diagram guarantees order: along one lifeline, and from sending a message to receiving it. With asynchronous messages that limit becomes the point of the diagram.</p>
  <p>Mina moves A5 to 14 October, then cancels it. Scheduling publishes <em>Moved</em> (version 2) and then <em>Cancelled</em> (version 3). The first lifeline shows the order in which they were sent. What billing receives is drawn on the billing lifeline. Start with the default, then set billing to check the version.</p>
  <SequencePlayer scenario="overtake" n={3} />
  <p>Billing that applies what arrives ends up with an invoice for a cancelled appointment. Here billing raises or reopens an invoice on any <em>Moved</em> event. The cancellation came first, the move arrived last, and billing treated the move as the latest news. The drawing shows this because the two messages leave the topic in the opposite order to the one they entered. Put a version or sequence number in the labels, as here, or the reader can’t see the overtaking.</p>
  <p>The figure leaves out the acknowledgements of the publishes, to keep attention on delivery. A real diagram for review should have them.</p>
  <p>What order a design can rely on is a fact about the broker and how it is used, so write it in a note. Kafka’s <a href="https://kafka.apache.org/intro">introduction</a> says events with the same key go to the same partition and a consumer reads a partition in the order written. SQS standard queues make a <a href="https://docs.aws.amazon.com/AWSSimpleQueueService/latest/SQSDeveloperGuide/standard-queues.html">best effort</a> only, and the documentation says messages may occasionally arrive out of order. Stripe’s webhooks <a href="https://docs.stripe.com/webhooks">make no ordering promise</a>. So “ordered per appointment id” is a claim about a design, with a product behind it, not a property of the notation.</p>
  <p>Even a per-key order can break. A message that is redelivered after a failure arrives after later ones. Several workers on one queue process messages in parallel, so a later message can finish first although it was delivered second. A consumer that matters should defend itself. It can keep the highest version it has seen, as in the figure, or ignore the event’s content and fetch the current state from its source, which Stripe’s guide suggests for events that arrive out of order.</p>
  <p>The same gap produces the stale read. If a page lists repairs from a table that a consumer updates from events, the page can read before the update. Two remedies are common: poll until the update shows, as in the <a href="/learn/drawing-systems/sequences/#loop">polling loop</a>, or read from the record the write went to. In a drawing, the read and the consumer’s update sit on different lifelines, so nothing orders them. Say which remedy you rely on, or the reader will assume the page always sees the new row.</p>
  <Code code={overtaking} lang="mermaid" themes={themes} />

  <h2 id={h['webhooks-and-callbacks'].id}>{h['webhooks-and-callbacks'].text}</h2>
  <p>The same deferred result can come back in two ways. The API answers <code>202 Accepted</code> and points at a status resource, and the caller either polls it, as in the sequence article’s <a href="/learn/drawing-systems/sequences/#loop">polling loop</a>, or waits for the provider to call back. In the drawing the difference is who sends the last arrow. This section is about the callback.</p>
  <p>A webhook is a request to us made by another system, later, because of something we asked for earlier. The email provider accepts J9 now and reports a bounce hours afterwards. Drawing that as a reply to J9’s request is the most common error in diagrams of these flows, and it is easy to see why it happens, because the two messages concern the same email.</p>

  <h3 id={h['a-callback-is-a-new-message'].id}>{h['a-callback-is-a-new-message'].text}</h3>
  <p>The provider’s <code>202 Accepted</code> is the reply to the worker’s <code>POST /emails</code>, and it came back while the worker was waiting. The bounce is a fresh request from the provider to a different participant, the Repair API’s bounce endpoint, with its own reply. A dotted arrow from the provider back to the worker, labelled “bounced”, would say that the worker was still waiting hours later. It had long since finished.</p>
  <p>Draw the callback as a solid call from the provider to the receiving participant, followed by our reply. That reply, <code>200 OK</code>, means “received”. It doesn’t mean “handled”, and it shouldn’t be drawn after a long chain of work. A message whose sender is outside what you are drawing is a <em>found message</em>, and the sequence article’s <a href="/learn/drawing-systems/sequences/#found-messages-and-timers">section on found messages and timers</a> says when to use one and what to do in Mermaid. Here the provider stays an ordinary lifeline, which also shows that it is somebody else’s system.</p>

  <h3 id={h['the-correlation-id'].id}>{h['the-correlation-id'].text}</h3>
  <p>The only thing that connects the bounce to J9 is an identifier. Three arrows carry it, and a diagram that drops any of them can’t be followed. The provider creates the id, <code>m-481</code>, and returns it in the 202. The worker stores it against J9. The bounce carries it back, and the receiver looks J9 up by it. <a href="https://postmarkapp.com/developer/webhooks/bounce-webhook">Postmark’s bounce webhook</a> works this way: its payload includes the <code>MessageID</code> of the original email. Some providers let you attach your own reference to the request and return it in the callback, and Postmark returns both its <code>MessageID</code> and any <code>Metadata</code> you sent. Where that exists, the id starts on our side and the save step disappears, so check the provider’s documentation before drawing the save.</p>

  <h3 id={h['the-callback-that-arrives-first'].id}>{h['the-callback-that-arrives-first'].text}</h3>
  <p>The worker’s save and the provider’s callback are on different lifelines, so nothing orders them. In the usual case the save wins by hours. Occasionally the email bounces within seconds, and the callback reaches the API before the worker has written <code>m-481</code> down. A diagram drawn for the usual case implies the save always comes first. Play all three.</p>
  <SequencePlayer scenario="webhook" n={4} />
  <p>In the second case the API looks for a job with <code>m-481</code>, finds none and answers 200, as it would for any callback it had handled. The provider has been told the bounce was received and won’t send it again. J9 never learns it bounced.</p>
  <p>The third case stores the bounce as it arrived, answers 200 and matches it later, once the worker has saved the id. The simpler alternative is to answer with a server error so that the provider retries. <a href="https://postmarkapp.com/developer/webhooks/bounce-webhook">Postmark retries</a> on any non-2xx response, and <a href="https://docs.stripe.com/webhooks">Stripe retries in live mode for up to three days</a>. But that leans on the provider’s retry policy, which differs by provider and may not be documented, and Stripe’s guide advises returning a success code quickly and doing the work afterwards. Storing first fits that advice.</p>
  <p>Retries also mean the same callback can arrive twice. Stripe’s guide says to <a href="https://docs.stripe.com/webhooks">track the event ids you have processed</a>, and Postmark suggests a trace-id header. In the drawing, a note on the receiver such as “skip bounce m-481 if already recorded” covers it. Verifying that the callback really came from the provider comes first of all: a self-message on the receiver, “Verify signature”, before it stores or looks up anything. A callback that fails it gets a 4xx and is stored nowhere. Each provider documents how its signature works, and the figure leaves the step out to keep attention on the id.</p>
  <Code code={webhook} lang="mermaid" themes={themes} />

  <h3 id={h['when-no-callback-comes'].id}>{h['when-no-callback-comes'].text}</h3>
  <p>No bounce arrived, and that proves less than it seems. A provider that reports only failures says nothing when the email is delivered, and it says nothing when its own report is lost. J9’s honest status is “sent, delivery unconfirmed”, which a note can say. If the flow needs a positive result, such as a payment confirmed, the missing callback needs a plan: a timer that fires after a day and asks the provider what happened. An absent arrow is the hardest thing in a diagram to notice, so write the plan down. The next section shows how to draw a timer.</p>

  <h2 id={h['flows-that-last-hours-or-days'].id}>{h['flows-that-last-hours-or-days'].text}</h2>
  <p>Suppose the API offers Mina appointment A5 and holds the time for 48 hours. She can confirm at any point. After 24 hours she gets a reminder. After 48 the time is released for someone else. Nothing in the repair service is running during those two days on Mina’s behalf. A diagram of this has to answer three things the short flows never raised.</p>
  <p>First, how long things take. The diagram’s height can’t carry it, as the sequence article’s <a href="/learn/drawing-systems/sequences/#order-gaps-and-time">order section</a> explains, so write the gap in a note across all the lifelines: “24 hours later”. Second, what holds the flow while it waits. The API process may restart a dozen times in two days, so what carries the memory of A5 is a row in a database, “A5 held until Friday 10:00”. Show that write, as an arrow to the database or a note that names the row, as the figure does. Otherwise the reader will assume an object lives in memory for two days. Third, what wakes the flow up. A flow with no caller needs something to start it, and the sequence article’s <a href="/learn/drawing-systems/sequences/#found-messages-and-timers">section on found messages and timers</a> covers the options. Here, draw the clock as a participant. A scheduler, a cron job, a delayed message in a queue or a workflow engine’s timer all send the API a message, “Reminder due”, and it handles that like any other.</p>
  <SequencePlayer scenario="confirm" n={5} />
  <p>Change when Mina replies. A reply within hours cancels both timers, which is an arrow of its own. A reply after the reminder is the same but later. A reply after the release is the case the short diagrams would never include: the time is gone, the API refuses, with a delivered refusal drawn as an ordinary reply, and the reply to Mina is a 409. The time also stayed unavailable to everyone else for the whole 48 hours, which is a cost someone should have agreed to.</p>
  <p>Such a diagram grows quickly, because every wait multiplies the cases. Split it at the waits. One diagram ends with the timers stored, and the next starts with “Reminder due”. The parent article shows how to link them with <a href="/learn/drawing-systems/sequences/#ref">ref</a>. When you find yourself drawing a fourth variant of the same wait, the question has moved from order to which events are allowed in which condition, and the section after the next one explains what to draw instead.</p>
  <Code code={confirm} lang="mermaid" themes={themes} />

  <h2 id={h['sagas-and-compensation'].id}>{h['sagas-and-compensation'].text}</h2>
  <p>Booking an appointment takes three steps in three services: hold a time for the appointment, reserve a part, take the deposit. No single transaction spans them. A <a href="https://microservices.io/patterns/data/saga.html">saga</a> is the usual name for this, a sequence of local transactions, each in one service, where a failure is answered by running <em>compensating</em> steps for the ones already done. Play the first case, then decline the deposit.</p>
  <SequencePlayer scenario="saga" n={6} />
  <p>The forward steps are ordinary calls. The compensation is what the diagram has to be careful with, and it makes four claims.</p>
  <p>It consists of new messages. “Release time for A5” is another request, with its own reply, sent after the failure. Nothing was rolled back. Between the hold and the release, A5’s time was taken and anyone asking for it was refused, which is why the figure’s status line shows <em>held</em> under Scheduling. A rollback would make that period never have happened, and a compensation can’t. Chris Richardson’s saga page lists this lack of isolation as the cost of the approach.</p>
  <p>The order is a choice. Here the steps run in reverse, latest first. The Azure Architecture Center’s <a href="https://learn.microsoft.com/en-us/azure/architecture/patterns/compensating-transaction">compensating transaction pattern</a> notes that the undo steps needn’t run in exactly reverse order, and some may run in parallel. If yours do, draw them in a <code>par</code> frame so that the reader doesn’t infer a sequence.</p>
  <p>Compensation can fail. Pick the third case, where inventory releases the part but its reply is lost. The coordinator has to send it again, and the inventory service has to cope with seeing the release twice. The same pattern says to make each compensating step idempotent and to record progress, so that a crashed coordinator can resume. Which lifeline stores that progress is a question the diagram should answer.</p>
  <p>Some steps can’t be undone. An email that has been sent, a part that has shipped and a legally binding confirmation have no compensation. The pattern recommends defining these points of no return and doing them last. In the diagram, the irreversible step goes after everything that could still fail, and a note marks it.</p>
  <Code code={saga} lang="mermaid" themes={themes} />

  <h3 id={h['orchestrated-or-choreographed'].id}>{h['orchestrated-or-choreographed'].text}</h3>
  <p>The figure is <strong>orchestrated</strong>. One lifeline, the booking service, sends the commands and hears every reply, so the whole story is on one participant. A <strong>choreographed</strong> saga has no such participant. Each service publishes an event and the next service reacts to it, and a failure is another event that several services react to.</p>
  <Code code={choreography} lang="mermaid" themes={themes} />
  <p>Both are legitimate designs, and the drawings show what they cost. In the choreographed version the whole booking exists only as a chain of arrows across four lifelines, and nobody holds it. A sequence diagram is the one place where that chain can be read start to finish, so it becomes the record of the design and needs the care described in <a href="/learn/drawing-systems/maintaining/">Keeping diagrams useful</a>. Mark each diagram as orchestrated or choreographed in its title, so that the reader knows whether to look for a coordinator.</p>

  <h2 id={h['which-view-for-a-long-running-workflow'].id}>{h['which-view-for-a-long-running-workflow'].text}</h2>
  <p>A sequence diagram shows one run, from start to finish, in order. A workflow that lasts two days has many runs: Mina replies early, replies late, never replies, replies twice. Each needs a diagram of its own, and the diagrams repeat most of their content. Other views answer the question the sequence is being stretched to answer.</p>
  <table>
    <thead><tr><th>The question</th><th>Draw</th><th>Why</th></tr></thead>
    <tbody>{views.map(([q, view, why]) => <tr><td>{q}</td><td>{view}</td><td>{why}</td></tr>)}</tbody>
  </table>
  <p>A good rule is to use the sequence diagram for the interaction between systems and the state diagram for the thing those messages change. The confirmation window is a short lifecycle for A5: Offered, Reminded, Confirmed, Released. Each transition is named for the message that causes it, so “Confirm A5” is the event on the arrow into Confirmed. Offered and Reminded accept it, while Released does not. That absent transition is the 409 from the figure, and the state diagram shows it without a new sequence. <a href="/learn/drawing-systems/states/#cancellation-and-starting-work-can-race">Cancellation and starting work can race</a> works through a case where the two views have to agree.</p>
  <p>For waiting, reminders and cancellation as routes through the work, with a person or team responsible at each stage, use a process map. <a href="/learn/drawing-systems/processes/#waiting-reminders-and-cancellation">Waiting, reminders and cancellation</a> draws a timer and a message wait as events attached to the work.</p>
  <p>Then keep the views consistent. If the sequence shows the API accepting “Confirm A5” after the release, one of the drawings is wrong. Don’t keep both as descriptions of the same design.</p>

  <h2 id={h['questions-to-put-to-every-arrow'].id}>{h['questions-to-put-to-every-arrow'].text}</h2>
  <p>The three questions at the start cover one arrow at a time. A review of someone else’s diagram, for a design or an incident, adds what the arrows say together. Ask these as well, and note where the drawing doesn’t answer.</p>
  <table>
    <thead><tr><th>Question</th><th>What the drawing should show</th></tr></thead>
    <tbody>{questions.map(([q, a]) => <tr><td>{q}</td><td>{a}</td></tr>)}</tbody>
  </table>
  <p>A drawing that can’t answer one has found a gap in the design or in the picture. Both are worth finding before the flow is built.</p>

  <h2 id={h['try-a-completed-repair-event'].id}>{h['try-a-completed-repair-event'].text}</h2>
  <p>A technician marks R17 repaired. The repair service publishes <em>RepairCompleted</em> to a topic. Billing raises the final invoice, the notification worker emails Mina a satisfaction survey, and the parts system reorders stock. Draw it as a sequence diagram, then test it against three changes.</p>
  <ol>
    <li>Billing is down for an hour. What does each of the other two do, and what does billing do afterwards?</li>
    <li>The topic delivers <em>RepairCompleted</em> to billing twice. What does billing need to be able to do?</li>
    <li>A minute later the technician corrects the status to <em>Needs a second visit</em>, and the event for that correction reaches billing first.</li>
  </ol>
  <p><strong>Discussion.</strong> The topic delivers to each subscriber separately, so with billing down the survey email goes out and the stock is reordered. Whether billing receives the event when it returns depends on its subscription being durable, so state that assumption in a note. Say in a second note that the survey may reach Mina before her invoice does, and that this is accepted. If it isn’t, billing can’t be a subscriber, and the flow needs a reply from it before anything is sent.</p>
  <p>Billing has to recognise a repeat, usually by the event’s id or by R17 and the event type together, and then raise one invoice. A note on the billing lifeline, “skip if R17 already invoiced”, is enough.</p>
  <p>For the third change, the corrected event and the original are two events about R17, and the correction is the newer. If the correction arrives first and billing then applies <em>RepairCompleted</em>, it invoices a repair that isn’t complete. The fix is the one from the overtaking figure: a version on each event, and billing keeps the highest. Label the arrows <code>v1</code> and <code>v2</code> so that the reader can see which is which. Then ask whether the survey should have gone out at all, which is a question about the design the diagram has just raised.</p>
  <p>One way to draw the answer, with the assumptions written down:</p>
