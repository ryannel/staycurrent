---
import DrawingArticle from '../../../layouts/DrawingArticle.astro';
import { drawingAliases } from '../../../lib/drawing-collection';
export async function getStaticPaths() {
  const modules = import.meta.glob('../../../articles/drawing-systems/*.md', { eager: true });
  const articles = Object.entries(modules).map(([path, page]: [string, any]) => {
    const slug = path.split('/').pop()!.replace('.md', '');
    return { params: { article: slug === 'index' ? undefined : slug }, props: { page, slug: slug === 'index' ? '' : slug, redirect: undefined } };
  });
  const aliases = Object.entries(drawingAliases).map(([slug, target]) => ({ params: { article: slug }, props: { page: undefined, slug, redirect: target } }));
  return [...articles, ...aliases];
}
const { page, slug, redirect } = Astro.props as any;
if (redirect) return Astro.redirect(redirect);
const { Content, frontmatter } = page;
const headings = page.getHeadings();
---
<DrawingArticle title={frontmatter.title} description={frontmatter.description} headings={headings} slug={slug}>
  <Content />
</DrawingArticle>
