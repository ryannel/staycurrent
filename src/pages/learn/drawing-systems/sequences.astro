---
import { Code } from 'astro:components';
import DrawingArticle from '../../../layouts/DrawingArticle.astro';
import SequencePlayer from '../../../components/explainers/sequences/SequencePlayer.astro';

// This article is an Astro page rather than Markdown so it can hold the animations.
const title = 'Sequence diagrams';
const description = 'Lifelines, calls and replies, who waits for whom, background workers, lost messages, retries, and the alt, opt, loop, par, break and ref fragments, followed through one repair booking and written in Mermaid.';
const sections = [
  [2, 'lifelines-and-messages', 'Lifelines and messages'],
  [2, 'replies-and-activation-bars', 'Replies and activation bars'],
  [2, 'synchronous-and-asynchronous-messages', 'Synchronous and asynchronous messages'],
  [2, 'background-workers-and-the-transactional-outbox', 'Background workers and the transactional outbox'],
  [2, 'lost-messages-and-timeouts', 'Lost messages and timeouts'],
  [2, 'retries-and-idempotency-keys', 'Retries and idempotency keys'],
  [2, 'combined-fragments', 'Combined fragments'],
  [3, 'alt-and-opt', 'alt and opt'],
  [3, 'loop', 'loop'],
  [3, 'par', 'par'],
  [3, 'break-and-ref', 'break and ref'],
  [2, 'self-messages-notes-and-participants', 'Self-messages, notes and participants'],
  [2, 'mermaid-syntax-reference', 'Mermaid syntax reference'],
  [2, 'sources-and-further-reading', 'Sources and further reading'],
] as const;
const headings = sections.map(([depth, slug, text]) => ({ depth, slug, text }));
const h = Object.fromEntries(sections.map(([, slug, text]) => [slug, { id: slug, text }]));
const themes = { light: 'github-light', dark: 'github-dark' } as const;

const booking = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    UI->>API: POST /repairs
    API->>DB: INSERT repair request
    DB-->>API: COMMIT ok
    API-->>UI: 201 Created: R17`;

const activations = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    UI->>+API: POST /repairs
    API->>+DB: INSERT repair request
    DB-->>-API: COMMIT ok
    API-->>-UI: 201 Created: R17`;

const asyncSend = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant Provider as Email provider
    UI->>API: POST /repairs
    API-)Provider: POST /emails
    API-->>UI: 201 Created: R17
    Provider-->>API: 202 Accepted
    Note over API: Nobody is waiting for this reply`;

const outbox = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    participant Worker as Notification worker
    participant Provider as Email provider
    UI->>API: POST /repairs
    API->>DB: INSERT request + job J9
    DB-->>API: COMMIT ok
    API-->>UI: 201 Created: R17
    Note over Worker: Next poll, 0.7 s later
    Worker->>DB: Claim a job for 5 min
    DB-->>Worker: Job J9
    Worker->>Provider: POST /emails
    Provider-->>Worker: 202 Accepted
    Worker->>DB: Mark J9 sent
    DB-->>Worker: OK`;

const lost = `sequenceDiagram
    participant Worker as Notification worker
    participant Provider as Email provider
    Worker-xProvider: POST /emails
    Note over Worker: Timeout after 10 s. Outcome unknown.`;

const retry = `sequenceDiagram
    participant Worker as Notification worker
    participant Provider as Email provider
    Worker->>Provider: POST /emails, Idempotency-Key: repair-email-J9
    Provider--xWorker: 202 Accepted
    Note over Worker: Timeout after 10 s. Wait 2 s.
    Worker->>Provider: POST /emails, Idempotency-Key: repair-email-J9
    Note over Provider: Key seen before: return the saved reply
    Provider-->>Worker: 202 Accepted`;

const altOpt = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    UI->>API: POST /repairs
    alt details valid
        Note over API,DB: One transaction, ending at COMMIT
        opt new customer
            API->>DB: INSERT customer
            DB-->>API: OK
        end
        API->>DB: INSERT repair request
        DB-->>API: COMMIT ok
        API-->>UI: 201 Created: R17
    else details invalid
        API-->>UI: 422: postcode missing
    end`;

const loop = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    loop status not scheduled
        UI->>API: GET /repairs/R17
        API->>DB: SELECT status
        DB-->>API: received
        API-->>UI: 200: received
        Note over UI: Wait 2 s
    end`;

const par = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    par repair status
        UI->>API: GET /repairs/R17
        API-->>UI: 200: received
    and free slots
        UI->>API: GET /slots?repair=R17
        API-->>UI: 200: three slots
    end
    Note over UI: Show the page once both replies are in`;

const breakLoop = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    loop up to 30 times
        UI->>API: GET /repairs/R17
        API-->>UI: 200: status
        break status is scheduled
            Note over UI: Show the appointment
        end
        Note over UI: Wait 2 s
    end`;

const ref = `sequenceDiagram
    participant DB as Repair DB
    participant Worker as Notification worker
    participant Provider as Email provider
    Note over DB,Worker: ref: Mina books a repair (writes job J9)
    Worker->>DB: Claim a job for 5 min
    DB-->>Worker: Job J9
    Worker->>Provider: POST /emails
    Provider-->>Worker: 202 Accepted`;

const participants = `sequenceDiagram
    actor Mina
    participant UI as Browser
    participant API as Repair API
    Mina->>UI: Submit the booking form
    UI->>API: POST /repairs
    API->>API: Check postcode
    create participant Quote as Quote renderer
    API->>Quote: Render quote for R17
    destroy Quote
    Quote-->>API: quote.pdf
    API-->>UI: 201 Created: R17
    Note right of API: The renderer exists only for this request`;

const reference: [string, string, string][] = [
  ['participant API as Repair API', 'A lifeline with a display name', 'Each participant, declared left to right'],
  ['actor Mina', 'A lifeline headed by a stick figure', 'A person'],
  ['A->>B: text', 'Solid line, filled arrowhead', 'A call: A waits for the reply'],
  ['B-->>A: text', 'Dotted line, arrowhead', 'A reply'],
  ['A-)B: text', 'Solid line, open arrowhead', 'An asynchronous message: A carries on'],
  ['A-xB: text', 'Solid line ending in a cross', 'A lost or failed message'],
  ['A->>A: text', 'An arrow back to the same lifeline', 'A self-message'],
  ['A->>+B / B-->>-A', 'Starts and ends an activation bar on B', 'Showing who is handling a call'],
  ['Note over A,B: text', 'A note across one or more lifelines', 'Timeouts, waits, assumptions'],
  ['create participant B', 'A lifeline that starts at the next message', 'Something created during the interaction'],
  ['destroy B', 'A lifeline that ends at the next message', 'Something that stops existing'],
  ['alt … else … end', 'A frame with alternative sections', 'At most one path runs'],
  ['opt … end', 'A frame with one section', 'A step that may not happen'],
  ['loop … end', 'A frame that repeats', 'Polling and retries'],
  ['par … and … end', 'A frame with parallel sections', 'Requests that don’t wait for each other'],
  ['break … end', 'A frame that ends the enclosing fragment', 'Leaving a loop early'],
  ['autonumber', 'A number on every arrow', 'Referring to steps in a review'],
];
---
<DrawingArticle title={title} description={description} headings={headings} slug="sequences" version="Mermaid 11">
  <p>A sequence diagram shows the messages that pass between parts of a system during one interaction, in the order they happen. A message might be an HTTP request, a database query or the reply to either. Each part gets a vertical line. Time runs down the page, and each arrow is one message.</p>
  <p>A drawing of boxes and arrows can show that an API talks to a database and to an email provider. A sequence diagram shows which call comes first, which part sits waiting while another works, and what each side knows when a reply never comes back. You reach for one when that order is the question: when you design a request that crosses several services, work out why a page is slow, or decide what should happen if a service never answers.</p>
  <p>Every example here follows one invented repair service. Mina books a dishwasher repair in her browser. A Repair API stores the booking in a PostgreSQL database, Repair DB. A notification worker, a separate process running in the background, later emails her through an external email provider. Each section changes one thing about that booking, from the plain request through timeouts and retries to steps that repeat or run side by side. Each diagram is also written in Mermaid, a text format that GitHub and GitLab render as diagrams.</p>
  <p>The diagrams build to a practical question. Why does sending Mina’s confirmation email inside her booking request make her wait, and how can one retry send her the same email twice?</p>

  <h2 id={h['lifelines-and-messages'].id}>{h['lifelines-and-messages'].text}</h2>
  <p>A <strong>lifeline</strong> is the dashed line running down from each participant’s box at the top of a sequence diagram. A <strong>message</strong> is an arrow from the sender’s lifeline to the receiver’s, labelled with what is asked or answered.</p>
  <p>Press play and watch the order in which the four messages arrive.</p>
  <SequencePlayer scenario="booking" n={1} />
  <p>The API can’t answer the browser until the database has answered the API. Reading down the page gives you that order without reading any code. Left to right carries no meaning. Put whoever starts the interaction on the left, so requests travel right and replies come back left.</p>
  <p>Label each arrow with the operation and the data that matters, such as <code>POST /repairs</code> or <code>201 Created: R17</code>. A label like “data” or “response” hides whether the database is being asked to read, write or confirm something.</p>
  <p>In Mermaid, the same booking takes eight lines:</p>
  <Code code={booking} lang="mermaid" themes={themes} />
  <p><code>participant</code> declares the lifelines from left to right, and <code>as</code> gives each one a readable name. <code>{'->>'}</code> draws a solid arrow for a call, and <code>{'-->>'}</code> a dotted one for its reply.</p>

  <h2 id={h['replies-and-activation-bars'].id}>{h['replies-and-activation-bars'].text}</h2>
  <p><strong>Calls</strong> are the solid arrows in the booking: the sender asks, then waits for the answer. The dotted arrows are the <strong>replies</strong>. Between sending a call and getting its reply, the caller does nothing else for that request. An <strong>activation bar</strong> is a narrow bar on a lifeline that shows when that participant is handling a call.</p>
  <p>The next animation adds activation bars to the booking, plus a hatched bar for waiting. The hatched bar is this article’s addition, not standard notation. It darkens the longer the wait goes on. The status under each name and the clock in the corner give the same information as words and numbers. Watch the browser’s bar while the database works. Then set the database to 3&nbsp;s and watch again.</p>
  <SequencePlayer scenario="waiting" n={2} />
  <p>The browser waits for the whole chain. With a 3-second database write it waits a little over 3 seconds, and the API waits almost as long inside it. The API’s wait is nested inside the browser’s, so each extra second in the database is an extra second for Mina.</p>
  <p>The diagram didn’t get taller. Vertical distance shows order, not elapsed time, so a 5&nbsp;ms write and a 3-second write draw the same picture. When the question is how long something took, write the times in a <strong>note</strong>, a box of text attached to a lifeline, or draw a <a href="/learn/drawing-systems/#decision-tables-timelines-and-causal-loop-diagrams">timeline</a>.</p>
  <p>UML, the standard notation these diagrams come from, calls an activation bar an <em>execution specification</em>. Mermaid draws one only for the participant handling the call, so the hatched waiting bars won’t appear in Mermaid output. A <code>+</code> after a call’s arrow starts a bar on the participant receiving it, and a <code>-</code> after a reply’s arrow ends the bar of the participant sending it:</p>
  <Code code={activations} lang="mermaid" themes={themes} />

  <h2 id={h['synchronous-and-asynchronous-messages'].id}>{h['synchronous-and-asynchronous-messages'].text}</h2>
  <p>Every call so far has been a <strong>synchronous message</strong>: the sender waits for the reply. UML draws it with a filled arrowhead. An <strong>asynchronous message</strong> is one the sender doesn’t wait for. It has an open arrowhead, and the sender carries straight on.</p>
  <p>Suppose the API also sends Mina’s confirmation email before it answers her. The email provider takes 2.5 seconds to reply, an invented figure. Watch the API wait for the provider first. Then switch the API to <em>Doesn’t wait</em> and see when the browser gets its <code>201 Created</code>.</p>
  <SequencePlayer scenario="email" n={3} />
  <p>When the API waits, Mina waits too, for more than 2.5 seconds. If the provider were down, her booking would hang or fail, even though the database had already stored it.</p>
  <p>When the API doesn’t wait, the browser gets its <code>201 Created</code> in about 70&nbsp;ms. The provider’s <code>202 Accepted</code> comes back 2.5 seconds later to an API that has moved on. Nothing is waiting for it. Had that reply been an error, nothing would have handled it. The email would never have been sent, and nobody would know.</p>
  <p>Mermaid writes an asynchronous message with <code>-)</code>:</p>
  <Code code={asyncSend} lang="mermaid" themes={themes} />
  <p>Neither version suits a booking. The first makes Mina wait for an email. The second ignores any error the provider sends back. The repair service moves the email out of the request instead.</p>

  <h2 id={h['background-workers-and-the-transactional-outbox'].id}>{h['background-workers-and-the-transactional-outbox'].text}</h2>
  <p>A <strong>transactional outbox</strong> is a table where a service writes the work it wants done, in the same database transaction as the change that caused it. Here the work is notification job J9. The booking and the job are committed together, or neither is. So there’s never a booking without its email job, or an email job for a booking that failed.</p>
  <p>A <strong>background worker</strong> is a separate process that picks the work up later. It polls: it asks the database for the next job about once a second, and the database never calls it.</p>
  <p>The animation adds the worker and the provider as two more lifelines. Watch when the browser gets R17 compared with when the email goes out.</p>
  <SequencePlayer scenario="outbox" n={4} />
  <p>The browser has R17 after about 70&nbsp;ms. The worker claims J9 on its next poll, 0.7 seconds later, and the email goes out after that. Now set <em>Provider down</em>. The browser’s part of the diagram doesn’t change at all. The worker records that J9 should be tried again in 30 seconds, and the job waits in the database.</p>
  <p>This diagram has two starting points: the browser’s request and the worker’s poll. You can also draw it as two diagrams, split at the database. The first ends with the job written, and the second starts with the worker claiming it. <a href="#break-and-ref">break and ref</a> shows how to link them.</p>
  <Code code={outbox} lang="mermaid" themes={themes} />
  <p>With several workers, each claims a job with a <a href="/learn/databases/relational/transaction-boundaries/#locking-read">locking read</a> that skips jobs another worker holds. Because that lock ends when the claim commits, long before the email goes out, the claim also marks the job taken for five minutes: the “for 5 min” in the diagram.</p>
  <p>The outbox still has a gap. Set <em>Worker crashes</em>. The provider sends the email, and the worker crashes before it marks J9 sent. Five minutes later the claim expires, a worker claims J9 again, and the provider sends a second email. The next two sections show why the worker can’t simply check what happened, and how to stop the duplicate.</p>

  <h2 id={h['lost-messages-and-timeouts'].id}>{h['lost-messages-and-timeouts'].text}</h2>
  <p>A <strong>lost message</strong> is one that is sent but never received. UML draws it as an arrow that ends in a small filled circle instead of at a lifeline.</p>
  <p>Take the worker’s <code>POST /emails</code>. The request can be lost on the way out, or the provider’s reply can be lost on the way back. Or the provider can be slow, and its reply arrives after the worker has stopped listening. To the worker, all three look the same.</p>
  <p>All the worker has is a <strong>timeout</strong>, a limit on how long it waits before giving up. Here the limit is 10 seconds. This animation keeps only the worker and the provider, and adds Mina’s inbox, which the worker can’t see. Try all three cases and watch the worker’s bar and status in each.</p>
  <SequencePlayer scenario="timeout" n={5} />
  <p>The worker’s bar and status are the same every time. It sends, waits 10 seconds and gives up. Mina’s inbox is not the same. When the request is lost, she gets nothing. When the reply is lost, or the provider is slow, she gets the email.</p>
  <p>A timeout records only that 10 seconds passed. It doesn’t say whether the email was sent. Draw it as a note on the caller’s lifeline, such as “Timeout after 10&nbsp;s”. Don’t draw a reply arrow labelled “failed”: nobody sent one.</p>
  <p>Mermaid has no lost-message arrow with a circle. Use the cross arrow, <code>-x</code>, and put the timeout in a note:</p>
  <Code code={lost} lang="mermaid" themes={themes} />
  <p>Library defaults are often far longer than 10 seconds. Node.js’s built-in <code>fetch</code>, which is <a href="https://nodejs.org/api/globals.html#fetch">based on undici</a>, <a href="https://github.com/nodejs/undici/blob/main/docs/docs/api/Client.md">waits up to 300 seconds</a> for a response’s headers, so one stuck email would hold the worker for five minutes. Set the limit yourself, for example with <code>signal: AbortSignal.timeout(10_000)</code>.</p>

  <h2 id={h['retries-and-idempotency-keys'].id}>{h['retries-and-idempotency-keys'].text}</h2>
  <p>A <strong>retry</strong> sends the same request again, unchanged, after a failure or a timeout. For the worker it is the obvious next step. Whether it is safe depends on what happened the first time.</p>
  <p>Start with the reply lost, and count the emails in Mina’s inbox. Then switch the first attempt to <em>Request is lost</em>.</p>
  <SequencePlayer scenario="retry" n={6} />
  <p>When the request was lost, the retry is harmless and Mina gets one email. When the reply was lost, the provider had already sent the email, so the retry sends a second copy. Every retry therefore risks a duplicate, unless the provider can recognise a repeat.</p>
  <p>An operation is <strong>idempotent</strong> if doing it twice has the same effect as doing it once. Sending an email isn’t. An <strong>idempotency key</strong> lets the provider make it idempotent. The worker attaches a key that names the operation, here <code>repair-email-J9</code>, and sends the same key on every attempt. The provider remembers keys it has seen, and a repeat gets the saved reply without a second email. Derive the key from the job, not from the attempt. A new random key on each retry tells the provider that each attempt is a new email.</p>
  <p>Now set <em>Idempotency key</em> to <em>Sent</em> and play both cases again. Mina gets one email in each. The same key closes the outbox’s gap too: the worker that claims J9 after the crash sends <code>repair-email-J9</code> again, and the provider recognises it.</p>
  <p>The key protects only while the provider remembers it. Resend, an email API, <a href="https://resend.com/docs/dashboard/emails/idempotency-keys">keeps keys for 24 hours</a>, so a retry 25 hours later sends a second email.</p>
  <p>Space retries out, too. Wait longer after each failed attempt, and add a random amount, called jitter, so workers don’t all retry at once. Amazon’s guidance on <a href="https://aws.amazon.com/builders-library/timeouts-retries-and-backoff-with-jitter/">timeouts, retries and backoff with jitter</a> recommends both.</p>
  <Code code={retry} lang="mermaid" themes={themes} />

  <h2 id={h['combined-fragments'].id}>{h['combined-fragments'].text}</h2>
  <p>Some messages happen only sometimes, some repeat, and some run side by side. A <strong>combined fragment</strong> is a frame drawn around those messages that says which. The tag in its top-left corner is the operator, which names the kind of frame. A condition in square brackets, the <strong>guard</strong>, says when they run. A dashed line divides a frame into sections, each with its own guard.</p>

  <h3 id={h['alt-and-opt'].id}>{h['alt-and-opt'].text}</h3>
  <p>An <code>alt</code> fragment holds alternatives, and at most one section runs: the one whose guard is true. With an <code>else</code> section, exactly one runs. An <code>opt</code> fragment holds one section, which runs only if its guard is true.</p>
  <p>In the next animation the API checks Mina’s details before it stores anything. Watch which section of the <code>alt</code> runs. Then set <em>Details</em> to <em>Invalid</em>.</p>
  <SequencePlayer scenario="fragments" n={7} />
  <p>The section that doesn’t run stays on the page, faded here, because the diagram describes every path the interaction can take.</p>
  <p>The valid section holds an <code>opt</code> fragment with the guard [new customer]. Mina is a returning customer, so she already has a customer record. The API skips the fragment and inserts only the repair request. Set <em>Customer</em> to <em>New</em>, and the API inserts a customer record first, in the same transaction as the request.</p>
  <p>Write guards that the participant making the choice can check. The API can check “details valid” when the request arrives. It can’t check “email will arrive”, because nothing in the interaction has told it that yet.</p>
  <p>In Mermaid, write the guard after <code>alt</code>, <code>else</code> or <code>opt</code> without brackets. Mermaid adds them when it draws the frame:</p>
  <Code code={altOpt} lang="mermaid" themes={themes} />

  <h3 id={h['loop'].id}>{h['loop'].text}</h3>
  <p>A <strong>loop</strong> fragment repeats the messages inside it while its guard holds. The diagram draws them once.</p>
  <p>After booking, Mina’s page asks for the repair’s status every 2 seconds until a technician is scheduled. Watch the pass counter in the frame’s corner.</p>
  <SequencePlayer scenario="loop" n={8} />
  <p>The same five steps run on every pass, and each pass adds about 2 seconds to the clock. The last wait is wasted. The page already has its answer, but the loop waits before it checks the guard again.</p>
  <p>Now set <em>Never</em>. The guard never becomes false, and nothing in the frame sets a limit, so the page asks forever. Real code needs a cap, such as 30 attempts. <a href="#break-and-ref">break and ref</a> adds the cap and removes the wasted wait.</p>
  <Code code={loop} lang="mermaid" themes={themes} />

  <h3 id={h['par'].id}>{h['par'].text}</h3>
  <p>A <strong>par</strong> fragment holds sections that run independently. Messages from different sections can interleave in any order. Within one section, the order still holds.</p>
  <p>Once Mina has R17, the page loads the repair’s status and the free appointment slots together. Watch both requests leave before either reply returns. Then change which reply comes back first.</p>
  <SequencePlayer scenario="par" n={9} />
  <p>Either order is allowed, and one diagram covers both. <code>par</code> says only that neither section waits for the other. If one request needs the other’s reply, they aren’t parallel. Draw them in order.</p>
  <p>Now set <em>Status never arrives</em>. The slots come back, but the status section never finishes. If the page shows nothing until both replies are in, Mina waits forever. Say that the page needs both in a note after the frame, as below, and give each request its own timeout.</p>
  <Code code={par} lang="mermaid" themes={themes} />

  <h3 id={h['break-and-ref'].id}>{h['break-and-ref'].text}</h3>
  <p>A <strong>break</strong> fragment runs its messages in place of the rest of the enclosing fragment. Inside a loop, it leaves the loop. The polling loop can stop as soon as the status is scheduled, and the cap moves into the loop’s guard:</p>
  <Code code={breakLoop} lang="mermaid" themes={themes} />
  <p>A <strong>ref</strong> fragment, which UML calls an <em>interaction use</em>, stands in for another sequence diagram. It is a frame tagged <code>ref</code> with the other diagram’s name inside. Split the outbox diagram at the database, and the worker’s diagram can start with a <code>ref</code> to the booking. Mermaid has no <code>ref</code>, so use a note across the lifelines instead:</p>
  <Code code={ref} lang="mermaid" themes={themes} />

  <h2 id={h['self-messages-notes-and-participants'].id}>{h['self-messages-notes-and-participants'].text}</h2>
  <p>An <strong>actor</strong> is a participant that is a person. UML and Mermaid draw it as a stick figure. Use one when the interaction starts with someone’s action, such as Mina submitting the booking form.</p>
  <p>A <strong>self-message</strong> is an arrow from a lifeline back to itself. It shows a step a participant takes on its own, such as the API checking a postcode. Draw one only when the reader needs that step.</p>
  <p>A note holds anything that isn’t a message: a timeout, a wait, an assumption. Mermaid places a note <code>over</code> one participant or across two, or to the <code>left of</code> or <code>right of</code> one.</p>
  <p>Some participants exist for only part of an interaction. Since version 10.3, Mermaid writes <code>create participant</code> on the line before the message that creates one, and <code>destroy</code> on the line before the message that ends it. Only a message’s receiver can be created. Either end of a message can be destroyed.</p>
  <Code code={participants} lang="mermaid" themes={themes} />

  <h2 id={h['mermaid-syntax-reference'].id}>{h['mermaid-syntax-reference'].text}</h2>
  <p>Every example above is complete Mermaid, so you can paste it into any editor that renders Mermaid and change it. This table covers the syntax most sequence diagrams need.</p>
  <table>
    <thead><tr><th>Mermaid</th><th>Draws</th><th>Use it for</th></tr></thead>
    <tbody>{reference.map(([syntax, draws, use]) => <tr><td><code>{syntax}</code></td><td>{draws}</td><td>{use}</td></tr>)}</tbody>
  </table>

  <h2 id={h['sources-and-further-reading'].id}>{h['sources-and-further-reading'].text}</h2>
  <ul>
    <li>Mermaid, <a href="https://mermaid.js.org/syntax/sequenceDiagram.html">Sequence diagrams</a>: every arrow, block and option, including <code>critical</code>, <code>rect</code> and <code>box</code>.</li>
    <li>Object Management Group, <a href="https://www.omg.org/spec/UML/2.5.1">Unified Modeling Language 2.5.1</a>, chapter 17, Interactions: the formal definitions of lifelines, messages, execution specifications, combined fragments and interaction uses.</li>
    <li>PostgreSQL documentation, <a href="https://www.postgresql.org/docs/current/sql-select.html#SQL-FOR-UPDATE-SHARE">SELECT: The Locking Clause</a>: <code>FOR UPDATE</code> and <code>SKIP LOCKED</code>.</li>
    <li>undici, <a href="https://github.com/nodejs/undici/blob/main/docs/docs/api/Client.md">Client</a>: the <code>headersTimeout</code> and <code>bodyTimeout</code> defaults.</li>
