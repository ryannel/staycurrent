---
import { Code } from 'astro:components';
import DrawingArticle from '../../../layouts/DrawingArticle.astro';
import SequencePlayer from '../../../components/explainers/sequences/SequencePlayer.astro';

// This article is an Astro page rather than Markdown so it can hold the animations.
const title = 'Sequence diagrams';
const description = 'Lifelines, calls and replies, who waits for whom, background workers, lost messages, nested timeouts, retries, ordering, combined fragments, queues and callbacks, how much to draw and how to review a diagram, followed through one repair booking and written in Mermaid, with PlantUML where Mermaid stops.';
const sections = [
  [2, 'lifelines-and-messages', 'Lifelines and messages'],
  [2, 'replies-and-activation-bars', 'Replies and activation bars'],
  [2, 'synchronous-and-asynchronous-messages', 'Synchronous and asynchronous messages'],
  [2, 'background-workers-and-the-transactional-outbox', 'Background workers and the transactional outbox'],
  [2, 'lost-messages-and-timeouts', 'Lost messages and timeouts'],
  [3, 'found-messages-and-timers', 'Found messages and timers'],
  [3, 'timeouts-inside-timeouts', 'Nested timeouts'],
  [2, 'retries-and-idempotency-keys', 'Retries and idempotency keys'],
  [2, 'order-gaps-and-time', 'Ordering and gaps'],
  [2, 'combined-fragments', 'Combined fragments'],
  [3, 'alt-and-opt', 'alt and opt'],
  [3, 'loop', 'loop'],
  [3, 'par', 'par'],
  [3, 'break', 'break'],
  [3, 'critical', 'critical'],
  [3, 'ref', 'ref'],
  [3, 'rare-operators-and-deep-nesting', 'Rare operators and deep nesting'],
  [2, 'actors-notes-and-participants', 'Actors, self-messages, notes and short-lived participants'],
  [2, 'queues-events-and-callbacks', 'Queues, events and callbacks'],
  [2, 'how-much-to-draw', 'How much to draw'],
  [3, 'one-question-one-level', 'Choosing what to draw'],
  [3, 'making-it-readable', 'Lifeline order, labels and numbering'],
  [2, 'reviewing-a-design', 'Reviewing a design with a sequence diagram'],
  [3, 'keeping-a-diagram-true', 'Keeping a diagram true'],
  [2, 'other-tools', 'Mermaid, PlantUML and what Mermaid can’t draw'],
  [2, 'practise-a-cancellation-race', 'Practise with a cancellation race'],
  [2, 'sources-and-further-reading', 'Sources and further reading'],
] as const;
const headings = sections.map(([depth, slug, text]) => ({ depth, slug, text }));
const h = Object.fromEntries(sections.map(([, slug, text]) => [slug, { id: slug, text }]));
const themes = { light: 'github-light', dark: 'github-dark' } as const;

const booking = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    UI->>API: POST /repairs
    API->>DB: INSERT repair request
    DB-->>API: COMMIT ok
    API-->>UI: 201 Created: R17`;

const activations = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    UI->>+API: POST /repairs
    API->>+DB: INSERT repair request
    DB-->>-API: COMMIT ok
    API-->>-UI: 201 Created: R17`;

const asyncSend = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant Provider as Email provider
    UI->>API: POST /repairs
    API-)Provider: POST /emails
    API-->>UI: 201 Created: R17
    Provider-->>API: 202 Accepted
    Note over API: Nobody is waiting for this reply`;

const outbox = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    participant Worker as Notification worker
    participant Provider as Email provider
    UI->>API: POST /repairs
    API->>DB: INSERT request + job J9
    DB-->>API: COMMIT ok
    API-->>UI: 201 Created: R17
    Note over Worker: Next poll, 0.7 s later
    Worker->>DB: Claim a job for 5 min
    DB-->>Worker: Job J9
    Worker->>Provider: POST /emails
    Provider-->>Worker: 202 Accepted
    Worker->>DB: Mark J9 sent
    DB-->>Worker: OK`;

const lost = `sequenceDiagram
    participant Worker as Notification worker
    participant Provider as Email provider
    Worker-xProvider: POST /emails
    Note over Worker: Timeout after 10 s. Outcome unknown.`;

const retry = `sequenceDiagram
    participant Worker as Notification worker
    participant Provider as Email provider
    Worker->>Provider: POST /emails, Idempotency-Key: repair-email-J9
    Provider--xWorker: 202 Accepted
    Note over Worker: Timeout after 10 s. Wait 2 s.
    Worker->>Provider: POST /emails, Idempotency-Key: repair-email-J9
    Note over Provider: Key seen before: send nothing, return the saved reply
    Provider-->>Worker: 202 Accepted`;

const altOpt = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    UI->>API: POST /repairs
    alt details valid
        Note over API,DB: One transaction, ending at COMMIT
        opt new customer
            API->>DB: INSERT customer
            DB-->>API: OK
        end
        API->>DB: INSERT repair request
        DB-->>API: COMMIT ok
        API-->>UI: 201 Created: R17
    else details invalid
        API-->>UI: 422: postcode missing
    end`;

const loop = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    loop status not scheduled
        UI->>API: GET /repairs/R17
        API->>DB: SELECT status
        DB-->>API: status
        API-->>UI: 200: status
        Note over UI: Wait 2 s
    end`;

const par = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    par repair status
        UI->>API: GET /repairs/R17
        API-->>UI: 200: received
    and free slots
        UI->>API: GET /slots?repair=R17
        API-->>UI: 200: three slots
    end
    Note over UI: Show the page once both replies are in`;

const breakLoop = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    loop up to 30 times
        UI->>API: GET /repairs/R17
        API-->>UI: 200: status
        break status is scheduled
            Note over UI: Show the appointment
        end
        Note over UI: Wait 2 s
    end`;

const ref = `sequenceDiagram
    participant DB as Repair DB
    participant Worker as Notification worker
    participant Provider as Email provider
    Note over DB,Worker: ref: Mina books a repair (writes job J9)
    Worker->>DB: Claim a job for 5 min
    DB-->>Worker: Job J9
    Worker->>Provider: POST /emails
    Provider-->>Worker: 202 Accepted`;

const participants = `sequenceDiagram
    actor Mina
    participant UI as Browser
    participant API as Repair API
    Mina->>UI: Submit the booking form
    UI->>API: POST /repairs
    API->>API: Check postcode
    create participant Quote as Quote renderer
    API->>Quote: Render quote for R17
    destroy Quote
    Quote-->>API: quote.pdf
    API-->>UI: 201 Created: R17
    Note right of API: The renderer exists only for this request`;

const pollCycle = `sequenceDiagram
    participant Worker as Notification worker
    participant DB as Repair DB
    Note over Worker: Poll timer fires
    activate Worker
    Worker->>DB: Claim a job for 5 min
    DB-->>Worker: Job J9
    deactivate Worker`;

const twoWorkers = `sequenceDiagram
    participant DB as Repair DB
    participant A as Worker A
    participant B as Worker B
    A->>DB: Claim a job for 5 min
    B->>DB: Claim a job for 5 min
    DB-->>A: Job J9
    DB-->>B: No job free`;

const nested = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    Note over UI: Gives up after 2 s
    UI->>API: POST /repairs
    API->>DB: INSERT repair request
    Note over UI: Timeout after 2 s. Shows an error.
    DB-->>API: COMMIT ok, at 3 s
    API-->>UI: 201 Created: R17
    Note over UI,API: Nobody is listening. R17 is stored.`;

const reorder = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    participant Worker as Notification worker
    participant Provider as Email provider
    UI->>API: POST /repairs
    API->>DB: INSERT request + job J9
    DB-->>API: COMMIT ok
    Note over Worker: Polls just after the commit
    Worker->>DB: Claim a job for 5 min
    DB-->>Worker: Job J9
    API-->>UI: 201 Created: R17
    Worker->>Provider: POST /emails`;


const race = `sequenceDiagram
    participant Mina as Mina’s browser
    participant Tech as Technician app
    participant A as API instance A
    participant B as API instance B
    participant DB as Repair DB
    par cancel
        Mina->>A: POST /repairs/R42/cancel
        A->>DB: UPDATE status = Cancelled WHERE status = Approved
        DB-->>A: 1 row changed
        A-->>Mina: 200 Cancelled
    and start
        Tech->>B: POST /repairs/R42/start
        B->>DB: UPDATE status = In repair WHERE status = Approved
        DB-->>B: 0 rows changed
        B->>DB: SELECT status
        DB-->>B: Cancelled
        B-->>Tech: 409 Already cancelled
    end
    Note over DB: Check and change are one statement. The other order is equally valid.`;


---
<DrawingArticle title={title} description={description} headings={headings} slug="sequences" version="Mermaid 12">
  <p>A sequence diagram shows the messages that pass between parts of a system during one interaction, in the order they happen. A message might be an HTTP request, a database query or the reply to either. Each part gets a vertical line, and time runs down each line. Each arrow is one message.</p>
  <p>A drawing of boxes and arrows can show that an API talks to a database and to an email provider. A sequence diagram shows which call comes first, which part sits waiting while another works, and what each side knows when a reply never comes back. You reach for one when that order is the question. You might be designing a request that crosses several services, working out why a page is slow, or deciding what should happen if a service never answers.</p>
  <p>The cost is that the arrows draw one path through the interaction. Steps that happen only sometimes, repeat or fail need a frame around them or a diagram of their own, and a drawing that tries to hold every case soon gets too crowded to read.</p>
  <p>Every example here follows one invented repair service. Mina books a dishwasher repair in her browser. A Repair API stores the booking in a PostgreSQL database, Repair DB. A notification worker, a separate process running in the background, later emails her through an external email provider. Each section changes one thing about that booking.</p>

  <h2 id={h['lifelines-and-messages'].id}>{h['lifelines-and-messages'].text}</h2>
  <p>Each part of the system in a sequence diagram is a <strong>participant</strong>, drawn as a named box at the top. A <strong>lifeline</strong> is the dashed line running down from that box. A <strong>message</strong> is an arrow from the sender’s lifeline to the receiver’s, labelled with what is asked or answered.</p>
  <p>Watch the order in which the four messages arrive.</p>
  <SequencePlayer scenario="booking" n={1} />
  <p>The API can’t answer the browser until the database has answered the API. Reading down the page gives you that order without reading any code. Left to right carries no meaning. Put whoever starts the interaction on the left, so requests travel right and replies come back left.</p>
  <p>Most figures here also come written in Mermaid, a text format that GitHub and GitLab render as diagrams. This is Figure 1 in Mermaid:</p>
  <Code code={booking} lang="mermaid" themes={themes} />
  <p>Each <code>participant</code> line declares a lifeline, and <code>as</code> gives it the name shown in its box. The order of those lines sets the order from left to right. <code>{'->>'}</code> draws a call as a solid arrow, and <code>{'-->>'}</code> draws its reply as a dotted one. Later figures keep their Mermaid under <em>Mermaid source</em>, closed until you want to copy it.</p>
  <p>Label each arrow with the operation and the data that matters, such as <code>POST /repairs</code> or <code>201 Created: R17</code>. A label like “data” or “response” hides whether the database is being asked to read, write or confirm something.</p>
  <p>A lifeline stands for a role, not a machine. “Repair API” means whichever copy of the API handles the request, and one lifeline is enough while the story doesn’t depend on which copy that is.</p>
  <p>When it does, give each copy its own lifeline. Two workers that claim the same job, or two API instances that both accept a cancellation, need a lifeline each, or the race has nowhere to appear.</p>

  <h2 id={h['replies-and-activation-bars'].id}>{h['replies-and-activation-bars'].text}</h2>
  <p><strong>Calls</strong> are the solid arrows in the booking: the sender asks, then waits for the answer. The dotted arrows are the <strong>replies</strong>. Between sending a call and getting its reply, the caller does nothing else for that request. An <strong>activation bar</strong> is a narrow bar on a lifeline that shows when that participant is handling a call.</p>
  <p>The next animation adds activation bars to the booking, plus a hatched bar for waiting. The hatched bar is this article’s addition, not standard notation. It darkens the longer the wait goes on. The word under each name says what that participant is doing. Watch the browser’s bar while the database works. Then set the database to 3&nbsp;s and watch again.</p>
  <SequencePlayer scenario="waiting" n={2} source={activations} />
  <p>The browser waits for the whole chain. With a 3-second database write it waits a little over 3 seconds, and the API waits almost as long inside it. The API’s wait is nested inside the browser’s, so each extra second in the database is an extra second for Mina.</p>
  <p>The diagram didn’t get taller. Vertical distance shows order, not elapsed time, so a 5&nbsp;ms write and a 3-second write draw the same picture. When the question is how long something took, write the times in a <strong>note</strong>, a box of text attached to a lifeline, or draw a <a href="/learn/drawing-systems/#decision-tables-timelines-and-causal-loop-diagrams">timeline</a>.</p>
  <p>UML, the standard notation these diagrams come from, calls an activation bar an <em>execution specification</em>. Mermaid has one kind of bar. It draws a bar wherever you ask for one, on any participant, so it can’t tell working from waiting, and the hatched waiting bars won’t appear in Mermaid output.</p>
  <p>In Mermaid, a <code>+</code> after the arrow starts a bar on the receiver, and a <code>-</code> ends the sender’s bar. So the booking’s first message becomes <code class="seq-line">{'UI->>+API: POST /repairs'}</code>, which starts the API’s bar, and its last becomes <code class="seq-line">{'API-->>-UI: 201 Created: R17'}</code>, which ends it. <code>activate</code> and <code>deactivate</code> do the same on lines of their own.</p>
  <p>Not every diagram needs the bars or every reply. Draw a reply when it carries data or a decision, such as <code>201 Created: R17</code> or a <code>422</code>. A bare “OK” that only closes the call can go, as long as nothing in the design hangs on that reply failing to arrive. Draw activation bars when who is blocked is the question, as in this section, and leave them off when it isn’t. Most diagrams later in this article leave them off.</p>

  <h2 id={h['synchronous-and-asynchronous-messages'].id}>{h['synchronous-and-asynchronous-messages'].text}</h2>
  <p>Every call so far has been a <strong>synchronous message</strong>: the sender waits for the reply. UML draws it with a filled arrowhead. An <strong>asynchronous message</strong> is one the sender doesn’t wait for. It has an open arrowhead, and the sender carries straight on.</p>
  <p>The two words describe the sender, not the protocol. A browser’s <code>await fetch(...)</code> is a synchronous message in a diagram, because the code stops until the reply comes, even though JavaScript calls the style asynchronous. An HTTP request whose response nobody reads is an asynchronous message, even though HTTP is a request and response protocol. Label each arrow by what its sender does next.</p>
  <p>Suppose the API also sends Mina’s confirmation email before it answers her. The email provider takes 2.5 seconds to reply, an invented figure. Watch the API wait for the provider first. Then switch the API to <em>Doesn’t wait</em> and see when the browser gets its <code>201 Created</code>.</p>
  <SequencePlayer scenario="email" n={3} />
  <p>When the API waits, Mina waits too, for more than 2.5 seconds. If the provider were down, her booking would hang or fail, even though the database had already stored it.</p>
  <p>When the API doesn’t wait, the browser gets its <code>201 Created</code> in about 70&nbsp;ms. The provider’s <code>202 Accepted</code> comes back 2.5 seconds later to an API that has moved on. Nothing is waiting for it. Had that reply been an error, nothing would have handled it. The email would never have been sent, and nobody would know.</p>
  <p>Mermaid writes an asynchronous message with <code>-)</code>. Here is the <em>Doesn’t wait</em> case with the database left out:</p>
  <Code code={asyncSend} lang="mermaid" themes={themes} />
  <p>Mermaid’s documentation doesn’t promise that <code>{'->>'}</code> means a call. That is the UML reading this article uses.</p>
  <p>Neither version suits a booking. The first makes Mina wait for an email. The second ignores any error the provider sends back. The repair service moves the email out of the request instead.</p>

  <h2 id={h['background-workers-and-the-transactional-outbox'].id}>{h['background-workers-and-the-transactional-outbox'].text}</h2>
  <p>The API now records the email as work to do instead of sending it. It writes notification job J9 to Repair DB in the same transaction as the booking. A separate process, the notification worker, picks the job up later and calls the provider.</p>
  <p>The animation adds the worker and the provider as two more lifelines. Watch when the browser gets R17 compared with when the email goes out.</p>
  <SequencePlayer scenario="outbox" n={4} source={outbox} sourceLabel="Mermaid source, when both work" />
  <p>The browser has R17 after about 70&nbsp;ms. The worker claims J9 on its next poll, 0.7 seconds later, and the email goes out after that.</p>
  <p>The table that holds J9 is a <strong>transactional outbox</strong>: a table where a service writes the work it wants done, in the same database transaction as the change that caused it. The booking and the job are committed together, or neither is. So there’s never a booking without its email job, or an email job for a booking that failed.</p>
  <p>The notification worker is a <strong>background worker</strong>: it runs outside any request, so nobody waits for it. It polls, asking the database for the next job about once a second, and the database never calls it.</p>
  <p>Now set <em>Provider down</em>. The browser’s part of the diagram doesn’t change at all. The worker records that J9 should be tried again in 30 seconds, and the job waits in the database.</p>
  <p>Then set <em>Worker crashes</em>. The provider sends the email, and the worker crashes before it marks J9 sent. Five minutes later the claim expires, a worker claims J9 again, and the provider sends a second email.</p>
  <p>Those five minutes come from how a worker claims a job. With several workers, claiming has to be safe. Each worker claims with a <a href="/learn/databases/relational/transaction-boundaries/#locking-read">locking read</a> (<code>FOR UPDATE SKIP LOCKED</code> in PostgreSQL), which skips any job another worker is claiming at that moment. Draw two workers, and the database gives J9 to only one of them:</p>
  <Code code={twoWorkers} lang="mermaid" themes={themes} />
  <p>The diagram doesn’t decide which worker wins. It says only that exactly one does.</p>
  <p>That lock lasts only until the claim commits, long before the email goes out. So the claim also takes a <strong>lease</strong>: it sets the job’s “taken until” time five minutes ahead, the “for 5 min” in the diagram, and no other worker can claim J9 before then. If the worker dies, the lease runs out and another worker claims J9. That is why J9 was claimed again after the crash. The new worker can’t tell that the email already went, so it sends it again.</p>

  <h2 id={h['lost-messages-and-timeouts'].id}>{h['lost-messages-and-timeouts'].text}</h2>
  <p>A <strong>lost message</strong> is one that is sent but never received. UML draws it as an arrow that ends in a small filled circle instead of at a lifeline.</p>
  <p>Take the worker’s <code>POST /emails</code>. The request can be lost on the way out, or the provider’s reply can be lost on the way back. Or the provider can be slow, and its reply arrives after the worker has stopped listening. To the worker, all three look the same.</p>
  <p>All the worker has is a <strong>timeout</strong>, a limit on how long it waits before giving up. Here the limit is 10 seconds. This animation keeps only the worker and the provider, and adds Mina’s inbox, which the worker can’t see. Try all three cases and watch the worker’s bar and status in each.</p>
  <SequencePlayer scenario="timeout" n={5} />
  <p>The worker’s bar and status are the same every time. It sends, waits 10 seconds and gives up. Mina’s inbox is not the same. When the request is lost, she gets nothing. When the reply is lost, or the provider is slow, she gets the email.</p>
  <p>A timeout records only that 10 seconds passed. It doesn’t say whether the email was sent. Draw it as a note on the caller’s lifeline, such as “Timeout after 10&nbsp;s”. Don’t draw a reply arrow labelled “failed”: nobody sent one.</p>
  <p>An error reply is different. Figure 4’s <em>Provider down</em> case has the provider answering <code>503 Service Unavailable</code>. That is a reply, so draw it as one. Only silence is drawn as a timeout.</p>
  <p>A 5xx still doesn’t prove that nothing was done, because a server can fail after it has acted. The clearest case is a <code>502</code> or <code>504</code> from a gateway in front of the provider: the gateway gave up, and the provider behind it may have finished the work. Check the provider’s documentation before relying on a 5xx.</p>
  <p>Mermaid has no lost-message arrow with a circle. Use the cross arrow, <code>-x</code>, and put the timeout in a note:</p>
  <Code code={lost} lang="mermaid" themes={themes} />
  <p>Library defaults are often far longer than 10 seconds. Node.js’s built-in <code>fetch</code>, which is <a href="https://nodejs.org/api/globals.html#fetch">based on undici</a>, <a href="https://github.com/nodejs/undici/blob/main/docs/docs/api/Client.md">waits up to 300 seconds</a> for a response’s headers, so one stuck email would hold the worker for five minutes. Set the limit yourself, for example with <code>signal: AbortSignal.timeout(10_000)</code>.</p>

  <h3 id={h['found-messages-and-timers'].id}>{h['found-messages-and-timers'].text}</h3>
  <p>A lost message is sent and never arrives. Its mirror is a <strong>found message</strong>: one that arrives from a sender the diagram doesn’t show. UML draws it as an arrow that starts from a filled circle instead of from a lifeline. Mermaid has no form for it. PlantUML writes <code>[{'->'} Worker : Poll timer fires</code>.</p>
  <p>Flows that start by themselves, with no person or caller, can be drawn three ways.</p>
  <p>A timer that fires a poll, as in the outbox, is incidental. Put a note on the worker’s lifeline, such as “Poll timer fires”, and start from there. In Mermaid, follow the note with <code>activate</code>, which starts the worker’s bar without a message, and end the bar with <code>deactivate</code>:</p>
  <Code code={pollCycle} lang="mermaid" themes={themes} />
  <p>When the trigger is something outside your system that you don’t want to draw, such as another company’s request, a found message says so: the message arrives, and who sent it is out of scope. In Mermaid, use the note, or a participant that stands for the outside world.</p>
  <p>Sometimes the timer’s own behaviour is part of the question, because it can be cancelled, rescheduled or fire late. Then give the clock a lifeline of its own, a scheduler, so those arrows have somewhere to start. <a href="/learn/drawing-systems/async-interactions/#flows-that-last-hours-or-days">Flows that last hours or days</a> draws one.</p>

  <h3 id={h['timeouts-inside-timeouts'].id}>{h['timeouts-inside-timeouts'].text}</h3>
  <p>Figure 2 held waits inside waits: the browser waits for the API, and the API waits for the database. Each wait can have its own limit, and the limits have to fit together. If the outer caller gives up before the inner work finishes, the work carries on after nobody is listening.</p>
  <p>Figure 6 is Figure 2’s booking with a 3-second database write and one change: the browser gives up after 2 seconds, as the note at the top of its lifeline says. Watch the browser’s bar and the clock. Then set the database to 500&nbsp;ms.</p>
  <SequencePlayer scenario="nested" n={6} source={nested} sourceLabel="Mermaid source, 3 s write and no API limit" />
  <p>The browser shows Mina an error at 2 seconds. The write commits at 3 seconds, and the API sends <code>201 Created</code> for R17, which no browser is waiting to receive. The booking exists, and Mina was told it failed. She tries again, and now there are two bookings.</p>
  <p>With a 500&nbsp;ms write the limit is still there, but it never fires.</p>

  <p>Each caller’s limit has to be longer than the longest its callee can take, counting the callee’s own waits. The browser waits 2 seconds, so the API should give up on the database sooner, early enough to answer while the browser is still listening. Set the database back to 3&nbsp;s, and set <em>API gives up after</em> to 1.5&nbsp;s.</p>
  <p>The API stops waiting at 1.5 seconds and answers <code>503 Service Unavailable</code>, which reaches the browser inside its 2-second limit. The browser gets an answer instead of silence, and the API, which made the write, notes that the outcome is unknown.</p>
  <p>That doesn’t remove the uncertainty. The API only stops waiting. Nothing tells the database, so the write still commits at 3 seconds, the <code>503</code> turns out to be wrong, and Mina is again told the booking failed when it didn’t. A limit set in the database itself, such as PostgreSQL’s <code>statement_timeout</code>, would roll the write back instead, but the reply saying so can be lost too.</p>

  <p>What makes her second attempt safe is a key on the booking request, like the one on the email in <a href="#retries-and-idempotency-keys">Retries and idempotency keys</a>. The API stores the key with the booking, so a retry with the same key finds R17 and returns it instead of making a second booking.</p>

  <h2 id={h['retries-and-idempotency-keys'].id}>{h['retries-and-idempotency-keys'].text}</h2>
  <p>A <strong>retry</strong> sends the same request again, unchanged, after a failure or a timeout. For the worker it is the obvious next step. Whether it is safe depends on what happened the first time.</p>
  <p>Start with the reply lost, and count the emails in Mina’s inbox. Then switch the first attempt to <em>Request is lost</em>.</p>
  <SequencePlayer scenario="retry" n={7} source={retry} sourceLabel="Mermaid source, reply lost and key sent" />
  <p>When the request was lost, the retry is harmless and Mina gets one email. When the reply was lost, the provider had already sent the email, so the retry sends a second copy. Every retry therefore risks a duplicate, unless the provider can recognise a repeat.</p>
  <p>An operation is <strong>idempotent</strong> if doing it twice has the same effect as doing it once. Sending an email isn’t. An <strong>idempotency key</strong> lets the provider make it idempotent. The worker attaches a key that names the operation, here <code>repair-email-J9</code>, and sends the same key on every attempt. The provider remembers keys it has seen, and a repeat gets the saved reply without a second email.</p>
  <p>Derive the key from the job, not from the attempt. A new random key on each retry tells the provider that each attempt is a new email.</p>
  <p>Now set <em>Idempotency key</em> to <em>Sent</em> and play both cases again. Mina gets one email in each. The same key closes the outbox’s gap too: the worker that claims J9 after the crash sends <code>repair-email-J9</code> again, and the provider recognises it.</p>
  <p>The key protects only while the provider remembers it. Resend, an email API, <a href="https://resend.com/docs/dashboard/emails/idempotency-keys">keeps keys for 24 hours</a>, so a retry 25 hours later sends a second email.</p>
  <p>Space retries out, too. Wait longer after each failed attempt, which is called <strong>backoff</strong>, and add a random amount, called jitter, so workers don’t all retry at once. Amazon’s guidance on <a href="https://aws.amazon.com/builders-library/timeouts-retries-and-backoff-with-jitter/">timeouts, retries and backoff with jitter</a> recommends both.</p>
  <p>A drawing doesn’t have to show every attempt. Draw them out when what differs between attempts is the point, as Figure 7 does with the key sent: the second attempt carries the same key as the first. When the retry is policy, write a loop labelled “up to 3 attempts”, or a note such as “Retried up to 3 times with backoff”, and keep the picture for what you want discussed.</p>
  <p>Retries also stack. An HTTP client that retries three times inside a worker that retries three times, inside a queue that redelivers three times, can make 27 attempts at the provider. Draw a layer’s retries when they multiply like this, and leave them out when they don’t.</p>

  <h2 id={h['order-gaps-and-time'].id}>{h['order-gaps-and-time'].text}</h2>
  <p>Reading down a lifeline gives a firm order. So does each message: it is sent before it is received. Those two rules are all a sequence diagram promises. Two events on different lifelines that no chain of messages connects have no order between them, even though one is drawn higher on the page.</p>
  <p>Take the outbox diagram. The API sends <code>201 Created</code> after the commit, and the worker claims J9 after the commit too, but nothing links the two. Figure 8 redraws the start of Figure 4 with one change: the worker polls just after the commit instead of 0.7 seconds later. Watch when the browser gets R17. Then switch the poll back to <em>0.7 s later</em> and watch which rows move.</p>
  <SequencePlayer scenario="order" n={8} source={reorder} sourceLabel="Mermaid source, for the early poll" />
  <p>With the early poll, the worker claims J9 before the browser has R17, and it could send the email before then too. Switching the poll moves only two things, the <code>201</code> and the worker’s poll, which trade rows. Every lifeline reads the same from top to bottom in both drawings, and every message is still sent before it is received.</p>
  <p>So the two drawings describe the same interaction. Figure 4 drew the <code>201</code> first, but nothing in the diagram promises that order. Here the order doesn’t matter, because R17 is stored from the commit onward: if the email reaches Mina before her browser shows R17, the booking it confirms already exists.</p>
  <p>When a design does depend on one of these orders, the diagram needs a message that makes it so, or a note that admits nothing guarantees it. This is also why <a href="#par">par</a> exists: it says openly that the order between its sections is open.</p>
  <p>As Figure 2 showed, a diagram has no scale, so a gap of two days looks the same as a gap of two milliseconds. Mark a long gap in words. Mermaid has no delay marker, so put a note across every lifeline, such as <code>Note over UI,Provider: Two days later</code>. PlantUML has <code>...Two days later...</code> and <code>== heading ==</code> dividers. Write deadlines and durations in notes too, such as “reply within 2&nbsp;s”, rather than in UML’s formal duration constraints, which few readers know.</p>
  <p>Messages can also overtake each other: two sent in one order and delivered in the other. A plain arrow can’t show that, and <a href="/learn/drawing-systems/async-interactions/">Drawing asynchronous and event-driven interactions</a> covers how to draw it.</p>

  <h2 id={h['combined-fragments'].id}>{h['combined-fragments'].text}</h2>
  <p>Some messages happen only sometimes, some repeat, and some run side by side. A <strong>combined fragment</strong> is a frame drawn around those messages that says which.</p>

  <h3 id={h['alt-and-opt'].id}>{h['alt-and-opt'].text}</h3>
  <p>The first two kinds of frame choose which messages run. In the next animation the API checks Mina’s details before it stores anything, and a frame around the rest of the booking holds what happens in each case. Watch which part of the frame runs. Then set <em>Details</em> to <em>Invalid</em>.</p>
  <SequencePlayer scenario="fragments" n={9} source={altOpt} />
  <p>The tag in the frame’s top-left corner, <code>alt</code>, is the <strong>operator</strong>, which names the kind of frame. An <code>alt</code> frame holds alternatives. The dashed line divides it into <strong>sections</strong>, and the condition in square brackets at the top of each, such as [details valid], is that section’s <strong>guard</strong>. It says when the section runs.</p>
  <p>At most one section of an <code>alt</code> runs, one whose guard is true. A guard of [else] is true when no other guard is. The section that doesn’t run stays on the page, faded here, because the frame describes both paths.</p>
  <p>The valid section holds a smaller frame, an <code>opt</code> fragment. It has one section, which runs only if its guard is true. Here the guard is [new customer], and Mina is a returning customer, so she already has a customer record. The API skips the fragment and inserts only the repair request. Set <em>Customer</em> to <em>New</em>, and the API inserts a customer record first, in the same transaction as the request.</p>
  <p>Write guards that the participant making the choice can check. The API can check “details valid” when the request arrives. It can’t check “email will arrive”, because nothing in the interaction has told it that yet.</p>
  <p>In Mermaid, write the guard after <code>alt</code>, <code>else</code> or <code>opt</code> without brackets, as Figure 9’s source does. Mermaid adds them when it draws the frame.</p>

  <h3 id={h['loop'].id}>{h['loop'].text}</h3>
  <p>A <strong>loop</strong> fragment repeats the messages inside it while its guard holds. The diagram draws them once.</p>
  <p>After booking, Mina’s page asks for the repair’s status every 2 seconds until a technician is scheduled. Watch the pass counter in the frame’s corner.</p>
  <SequencePlayer scenario="loop" n={10} source={loop} />
  <p>The same five steps run on every pass, and each pass adds about 2 seconds to the clock. The last wait is wasted. The page already has its answer, but the loop waits before it checks the guard again.</p>
  <p>Now set <em>Never</em>. The guard never becomes false, and nothing in the frame sets a limit, so the page asks forever. Real code needs a cap, such as 30 attempts. A cap in the guard stops the endless loop, and a <a href="#break">break</a> stops the wasted wait.</p>
  <p>UML writes a loop’s bounds in its tag: <code>loop(1, 30)</code> means at least once and at most 30 times, and you will meet that form in UML tools and in diagrams drawn by others. Mermaid has no bound syntax, so put the cap in the label, as the listing under <a href="#break">break</a> does.</p>
  <p>Not every repetition needs a frame. The outbox diagram draws one pass of the worker’s poll. The polling repeats, but that is the worker’s business and not part of the booking, so a note such as “Polls about once a second” says it without a loop frame. Draw a loop when the repetition is part of the question, as Mina’s status checks are here.</p>

  <h3 id={h['par'].id}>{h['par'].text}</h3>
  <p>A <strong>par</strong> fragment holds sections that run independently. Messages from different sections can interleave in any order. Within one section, the order still holds.</p>
  <p>Once Mina has R17, the page loads the repair’s status and the free appointment slots together. Watch both requests leave before either reply returns. Then change which reply comes back first.</p>
  <SequencePlayer scenario="par" n={11} source={par} sourceLabel="Mermaid source, when both replies arrive" />
  <p>Either order is allowed, and one diagram covers both. <code>par</code> says only that neither section waits for the other. If one request needs the other’s reply, they aren’t parallel. Draw them in order.</p>
  <p>Now set <em>Status never arrives</em>. The slots come back, but the status section never finishes. If the page shows nothing until both replies are in, Mina waits forever. Say in a note after the frame that the page needs both replies, as the figure does when both arrive, and give each request its own timeout.</p>

  <h3 id={h['break'].id}>{h['break'].text}</h3>
  <p>A <strong>break</strong> fragment runs its messages in place of the rest of the enclosing fragment. Inside a loop, it leaves the loop. The polling loop can stop as soon as the status is scheduled, and the cap moves into the loop’s guard:</p>
  <Code code={breakLoop} lang="mermaid" themes={themes} />
  <p>Now the loop ends at the first reply that says scheduled, without waiting another 2 seconds, and it never runs more than 30 times.</p>

  <h3 id={h['critical'].id}>{h['critical'].text}</h3>
  <p>A <strong>critical</strong> fragment marks a region that other messages can’t interleave with. In UML, no other event on the lifelines it covers can fall between its first and last message. It says something about order, and nothing about databases.</p>
  <p>Its natural place is inside a <code>par</code>, whose sections may otherwise interleave anywhere. UML’s own example is a switchboard operator who handles ordinary calls in parallel but forwards an emergency call before doing anything else. Service-level diagrams rarely need that. Few services handle one message at a time, and a database doesn’t: in the two-worker listing, Worker B’s claim reaches Repair DB between Worker A’s claim and its reply.</p>
  <p>It is also the most misread operator. Engineers often draw it around a database transaction, but a transaction is about isolation and commit, and the fragment promises neither. Where you mean a transaction, a note says it more plainly, as the <code>alt</code> example did with “One transaction, ending at COMMIT”.</p>
  <p>Mermaid’s documentation gives <code>critical</code> a second reading: something that must happen, with <code>option</code> sections for what to do if it fails. UML gives a critical region no such sections. It only forbids interleaving, so when you meet a <code>critical</code> frame with options, ask which reading its author meant.</p>

  <h3 id={h['ref'].id}>{h['ref'].text}</h3>
  <p>A <strong>ref</strong> fragment, which UML calls an <em>interaction use</em>, stands in for another sequence diagram. It is a frame tagged <code>ref</code> with the other diagram’s name inside, and it is the main way to split a diagram that has grown too big. The outbox diagram has two starting points, the browser’s request and the worker’s poll. Split it at the database, and the worker’s diagram can start with a <code>ref</code> to the booking. Mermaid has no <code>ref</code>, so use a note across the lifelines instead:</p>
  <Code code={ref} lang="mermaid" themes={themes} />
  <p>PlantUML draws the real frame with <code>ref over DB, Worker : Mina books a repair (writes job J9)</code>. Figure 12, under <a href="#how-much-to-draw">How much to draw</a>, shows a diagram split this way.</p>

  <h3 id={h['rare-operators-and-deep-nesting'].id}>{h['rare-operators-and-deep-nesting'].text}</h3>
  <p>UML defines more operators than these: <code>seq</code>, <code>strict</code>, <code>neg</code>, <code>assert</code>, <code>ignore</code> and <code>consider</code>. They matter mostly in formal specifications. You may meet <code>neg</code> in a review, where it marks a sequence that must never happen.</p>
  <p>Fragments also nest, and a few levels in they stop helping. When <code>alt</code> branches each hold a screenful of messages, or a loop sits inside a <code>par</code> inside an <code>alt</code>, the diagram holds several scenarios. Split it, as <a href="#how-much-to-draw">How much to draw</a> describes.</p>

  <h2 id={h['actors-notes-and-participants'].id}>{h['actors-notes-and-participants'].text}</h2>
  <p>An <strong>actor</strong> is a participant that is a person. UML and Mermaid draw it as a stick figure. Use one when the interaction starts with someone’s action, such as Mina submitting the booking form.</p>
  <p>A <strong>self-message</strong> is an arrow from a lifeline back to itself. It shows a step a participant takes on its own, such as the API checking a postcode. Draw one only when the reader needs that step.</p>
  <p>A note holds anything that isn’t a message: a timeout, a wait, an assumption. Mermaid places a note <code>over</code> one participant or across two, or to the <code>left of</code> or <code>right of</code> one.</p>
  <p>Some participants exist for only part of an interaction. Mermaid writes <code>create participant</code> on the line before the message that creates one, and <code>destroy</code> on the line before the message that ends it. Only a message’s receiver can be created. Either end of a message can be destroyed.</p>
  <Code code={participants} lang="mermaid" themes={themes} />
  <p>A participant can also carry a symbol that says what it is. PlantUML has keywords for <code>database</code>, <code>queue</code>, <code>boundary</code>, <code>control</code>, <code>entity</code> and <code>collections</code>. Mermaid sets them with a JSON-style configuration such as <code>participant Q@{`{ "type" : "queue" }`}</code>, which only newer releases accept (the syntax companion gives the version). A symbol only helps the reader recognise the participant. Like the queue shape in the <a href="/learn/drawing-systems/vocabulary/#queue-and-pubsub-topic">whiteboard shape vocabulary</a>, it says nothing about how a queue delivers.</p>
  <p>A <strong>box</strong> groups participants: by service, by owner, or by which side of a trust boundary they sit on. It answers questions such as which of these calls cross into the provider’s systems. Mermaid writes <code>box LightBlue Our systems</code> before the participants and <code>end</code> after them, and doesn’t support hex colours. PlantUML writes <code>box "Our systems" #LightBlue</code> and <code>end box</code>. A boundary can mean ownership, execution location or trust, so write which one you mean, as the <a href="/learn/drawing-systems/layout/">layout article</a> advises for any boundary.</p>

  <h2 id={h['queues-events-and-callbacks'].id}>{h['queues-events-and-callbacks'].text}</h2>
  <p>Moving work off the request path doesn’t have to mean polling a table. The API can publish a message to a queue. And an answer can come back much later as a <strong>callback</strong>: the email provider calls the repair service, usually through a webhook, to report a bounce days after it accepted the email.</p>
  <p>Publishing to a queue can be both a call and an asynchronous message. If the sender waits for the message broker to confirm it has stored the message, that part is a call, and delivery to whoever consumes it is still an asynchronous message.</p>
  <p>Two things change in the drawing. A queue gets a lifeline of its own when its acknowledgement, retention or redelivery affects the outcome, and a plain asynchronous arrow when it only carries the message. And a callback is a new message from the other side, tied to the original by an id, not a dotted reply to a call that finished long ago.</p>
  <p>Each of those has its own consequences: the broker as a participant, redelivery, fan-out and webhooks. They are the subject of <a href="/learn/drawing-systems/async-interactions/">Drawing asynchronous and event-driven interactions</a>, which covers what a drawing claims rather than how any broker behaves.</p>

  <h2 id={h['how-much-to-draw'].id}>{h['how-much-to-draw'].text}</h2>
  <p>Each diagram should answer one question. “What does Mina wait for?” and “What happens to the email when the provider is down?” are two questions. They share the API and the database, and little else. A diagram that tries to answer both ends up too crowded to answer either.</p>

  <h3 id={h['one-question-one-level'].id}>{h['one-question-one-level'].text}</h3>
  <p>Choose the question first, then draw only the lifelines and messages that change its answer. A gateway that forwards every request unchanged, a token check that always passes, logging, a cache that only saves time and a client library’s internal retries can all stay off the page. A question about gateway timeouts needs the gateway.</p>
  <p>Keep to one level of detail. Lifelines can be services, or they can be objects inside one service, but a diagram that mixes the two says little about either. A diagram with a lifeline per class goes stale fastest, because every refactor changes it. Generate it from the code or don’t draw it. C4, a set of zoom levels for architecture diagrams, makes the same point about its code level, as the <a href="/learn/drawing-systems/architecture/">architecture article</a> explains.</p>
  <p>Draw the happy path first, the run where everything works, then one diagram for each failure that matters, rather than one diagram whose <code>alt</code> branches hold them all. This article does that: each failure has its own figure.</p>
  <p>Figure 12 shows the same facts twice. Start with <em>Everything in one</em>, then switch to the two focused diagrams.</p>
  <SequencePlayer scenario="scope" n={12} />
  <p>The single diagram has seven lifelines, an <code>alt</code> for a bad token and thirteen messages on the valid path. It holds two jobs with different timing, a request and a worker’s poll, so neither stands out. Each focused diagram fits a phone screen and answers its own question. A <code>ref</code> frame joins them. The gateway and the auth service dropped out because neither question depends on them.</p>

  <h3 id={h['making-it-readable'].id}>{h['making-it-readable'].text}</h3>
  <p>Order the lifelines so that most arrows travel between neighbours. An arrow that skips over lifelines crosses their activation bars and is hard to follow. External systems usually go on the right, as the email provider does in the outbox diagram.</p>
  <p>Keep labels short. In Mermaid a long label widens the whole diagram, and <code>&lt;br/&gt;</code> breaks a label or a note over two lines.</p>
  <p>Number the steps when the diagram will be discussed: <code>autonumber</code> puts a number on every arrow, so a reviewer can say “step 7 has no timeout”. Add notes sparingly: a note on every arrow turns the diagram into prose. <code>rect rgb(240, 240, 240)</code> shades a region, such as the one transaction, but never let colour carry meaning alone. The <a href="/learn/drawing-systems/layout/">layout article</a> covers the general principles for labels, colour and splitting that dense drawings share.</p>

  <h2 id={h['reviewing-a-design'].id}>{h['reviewing-a-design'].text}</h2>
  <p>A sequence diagram is something you review: your own before you share it, someone else’s before you build from it. Put these questions to it:</p>
  <ul>
    <li>Who is waiting at each point, and for how long in the worst case?</li>
    <li>Does every call that can hang have a timeout, and is each caller’s limit longer than what its callee can take?</li>
    <li>What does each participant know after a timeout? Silence is a note on the caller, not a reply labelled “failed”.</li>
    <li>For every asynchronous message, who notices if it fails?</li>
    <li>Which arrows can be retried, and what makes a repeat safe?</li>
    <li>Where does a crash between two arrows leave the data?</li>
    <li>Can the participant that makes each choice check its guard?</li>
    <li>Which events are drawn in an order that nothing guarantees? Does any section of a <code>par</code> need another section’s reply?</li>
    <li>Is a <code>critical</code> frame standing in for a transaction? A note says that more plainly.</li>
    <li>Is a callback drawn as a new message, tied to the original by an id, rather than as a reply to a call that finished long ago?</li>
    <li>Is every arrow a message, and are the lifelines all at one level? “Uses” arrows and data flow belong on an architecture diagram, and classes don’t belong beside services.</li>
    <li>Does the diagram agree with the request’s state lifecycle, the statuses it may move through, as drawn in <a href="/learn/drawing-systems/states/">States and lifecycles</a>?</li>
  </ul>
  <p>Try three of them on the outbox diagram. Who notices if the email fails? The worker, which records that J9 should be tried again in 30 seconds. The browser never learns of it. Where does a crash between two arrows leave the data? Between the provider’s <code>202</code> and “Mark J9 sent”, the email is out and J9 is unmarked, so the claim expires and a second email goes unless the key stops it. Which events are drawn in an order nothing guarantees? The browser’s <code>201</code> and the worker’s claim.</p>
  <p>To reconstruct an incident, start from evidence rather than the design. Logs and distributed traces record which calls were actually made and how long each took. A trace’s waterfall view is a <a href="/learn/drawing-systems/#decision-tables-timelines-and-causal-loop-diagrams">timeline</a> of one request, not a sequence diagram, but it tells you which messages to draw and what the diagram leaves out, which is the real time. Draw what happened, then compare it with the design diagram to see where the two disagree.</p>

  <h3 id={h['keeping-a-diagram-true'].id}>{h['keeping-a-diagram-true'].text}</h3>
  <p>The <a href="/learn/drawing-systems/maintaining/">maintaining article</a> covers owners, review when the system changes, and labelling a drawing as current or proposed. For a sequence diagram, what makes it stale is a call added or removed, a timeout or retry policy changed, or work moved between synchronous and asynchronous. Renaming a function doesn’t. Keep the Mermaid source next to the code that implements the flow, and when a reviewer doubts the diagram, compare it with a trace of the real flow.</p>

  <h2 id={h['other-tools'].id}>{h['other-tools'].text}</h2>
  <p>Every listing in this article, including those under <em>Mermaid source</em>, is complete Mermaid, so you can paste it into any editor that renders Mermaid and change it. Each one parses on Mermaid 11.4.1 and 12.2.0.</p>
  <p>Mermaid can’t draw everything this article has described, such as a <code>ref</code> frame, a found message or a delay marker, and PlantUML can. <a href="/learn/drawing-systems/sequence-syntax/">Sequence diagram syntax: Mermaid, PlantUML and others</a> sets out the syntax of both, the arrows whose meaning differs between them, what each can’t draw and where each renders. The <a href="/learn/drawing-systems/maintaining/">maintaining article</a> helps choose a tool and pin its version.</p>

  <h2 id={h['practise-a-cancellation-race'].id}>{h['practise-a-cancellation-race'].text}</h2>
  <p>R42 is Approved. At almost the same moment, Mina cancels it in her browser and a technician starts the repair in an app. Two instances of the Repair API handle the two requests, and both use Repair DB. Draw one sequence diagram of this. Decide which participants need lifelines, what each person is told, and what the database does when both requests want to change the same row. Write down what Mina and the technician each see before you read on.</p>
  <details>
    <summary>Discussion</summary>
    <p>The diagram needs five lifelines: Mina’s browser, the technician app, API instance A, API instance B and Repair DB. One API lifeline would look as though a single place handled the requests one at a time, and the race would vanish.</p>
    <p>The tempting drawing has each instance select the status, see Approved, then update it. That draws both updates succeeding. The check and the change are separate messages, and nothing orders one instance’s select against the other’s update, as the <a href="#order-gaps-and-time">order section</a> explained. The repair is a single message that checks and changes together, <code>UPDATE ... WHERE status = 'Approved'</code>, with the database reporting how many rows changed. One request gets one row and succeeds. The other gets none. That tells its instance only that R42 was not Approved, not why, so the instance reads the status again before it answers <code>409</code> with the reason.</p>
    <Code code={race} lang="mermaid" themes={themes} />
    <p>The listing lets the cancellation win. The start winning instead is an equally valid drawing, and the diagram can’t say which will happen, only that exactly one does. The <code>par</code> frame says neither request waits for the other. A note carries the rule that the check and change are one statement, which avoids drawing it as <code>critical</code> and having it read as a transaction. Compare the result with the <a href="/learn/drawing-systems/states/#cancellation-and-starting-work-can-race">lifecycle for R42</a>: either order ends Cancelled or In repair, and never both. The technician must also wait for the success reply before starting the physical repair. Otherwise the record and reality can disagree.</p>
  </details>

