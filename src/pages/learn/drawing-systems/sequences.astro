---
import { Code } from 'astro:components';
import DrawingArticle from '../../../layouts/DrawingArticle.astro';
import SequencePlayer from '../../../components/explainers/sequences/SequencePlayer.astro';

// This article is an Astro page rather than Markdown so it can hold the animations.
const title = 'Sequence diagrams';
const description = 'Lifelines, calls and replies, who waits for whom, lost messages, retries, and the alt, opt, loop and par fragments, followed through one repair booking and written in Mermaid.';
const sections = [
  ['lifelines-and-messages', 'Lifelines and messages'],
  ['replies-and-activation-bars', 'Replies and activation bars'],
  ['synchronous-and-asynchronous-messages', 'Synchronous and asynchronous messages'],
  ['transactional-outbox', 'Transactional outbox'],
  ['lost-messages-and-timeouts', 'Lost messages and timeouts'],
  ['retries-and-idempotency-keys', 'Retries and idempotency keys'],
  ['combined-fragments-alt-and-opt', 'Combined fragments: alt and opt'],
  ['loop-fragments', 'Loop fragments'],
  ['parallel-fragments', 'Parallel fragments'],
  ['mermaid-syntax-reference', 'Mermaid syntax reference'],
] as const;
const headings = sections.map(([slug, text]) => ({ depth: 2, slug, text }));
const h = Object.fromEntries(sections.map(([slug, text]) => [slug, { id: slug, text }]));
const themes = { light: 'github-light', dark: 'github-dark' } as const;

const booking = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    UI->>API: POST /repairs
    API->>DB: INSERT repair request
    DB-->>API: COMMIT ok
    API-->>UI: 201 Created: R17`;

const activations = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    UI->>+API: POST /repairs
    API->>+DB: INSERT repair request
    DB-->>-API: COMMIT ok
    API-->>-UI: 201 Created: R17`;

const asyncSend = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant Provider as Email provider
    UI->>API: POST /repairs
    API-)Provider: POST /emails
    API-->>UI: 201 Created: R17
    Provider-->>API: 202 Accepted
    Note over API: Nobody is waiting for this reply`;

const outbox = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    participant Worker as Notification worker
    participant Provider as Email provider
    UI->>API: POST /repairs
    API->>DB: INSERT request + job J9
    DB-->>API: COMMIT ok
    API-->>UI: 201: R17
    Note over Worker: Next poll, under a second later
    Worker->>DB: Claim next job
    DB-->>Worker: Job J9
    Worker->>Provider: POST /emails
    Provider-->>Worker: 202 Accepted
    Worker->>DB: Mark J9 sent
    DB-->>Worker: OK`;

const lost = `sequenceDiagram
    participant Worker as Notification worker
    participant Provider as Email provider
    Worker-xProvider: POST /emails
    Note over Worker: Timeout after 10 s. Outcome unknown.`;

const retry = `sequenceDiagram
    participant Worker as Notification worker
    participant Provider as Email provider
    Worker->>Provider: POST /emails, Idempotency-Key: J9
    Note over Worker: Timeout after 10 s
    Worker->>Provider: POST /emails, Idempotency-Key: J9
    Note over Provider: Key J9 seen before: return the saved reply
    Provider-->>Worker: 202 Accepted`;

const altOpt = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    UI->>API: POST /repairs
    alt details valid
        opt new customer
            API->>DB: INSERT customer
            DB-->>API: OK
        end
        API->>DB: INSERT repair request
        DB-->>API: COMMIT ok
        API-->>UI: 201 Created: R17
    else details invalid
        API-->>UI: 422: postcode missing
    end`;

const loop = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    participant DB as Repair DB
    loop while status is not scheduled
        UI->>API: GET /repairs/R17
        API->>DB: SELECT status
        DB-->>API: received
        API-->>UI: 200: received
        Note over UI: Wait 2 s
    end`;

const par = `sequenceDiagram
    participant UI as Browser
    participant API as Repair API
    par repair status
        UI->>API: GET /repairs/R17
        API-->>UI: 200: received
    and free slots
        UI->>API: GET /slots?repair=R17
        API-->>UI: 200: three slots
    end`;

const reference: [string, string, string][] = [
  ['participant API as Repair API', 'A lifeline with a display name', 'Each participant, declared left to right'],
  ['actor Mina', 'A lifeline headed by a stick figure', 'A person'],
  ['A->>B: text', 'Solid line, filled arrowhead', 'A call: A waits for the reply'],
  ['B-->>A: text', 'Dotted line, arrowhead', 'A reply'],
  ['A-)B: text', 'Solid line, open arrowhead', 'An asynchronous message: A carries on'],
  ['A-xB: text', 'Solid line ending in a cross', 'A lost or failed message'],
  ['A->>+B / B-->>-A', 'Starts and ends an activation bar on B', 'Showing who is handling a call'],
  ['Note over A: text', 'A note on a lifeline', 'Timeouts, waits, assumptions'],
  ['alt … else … end', 'A frame with alternative sections', 'Exactly one path runs'],
  ['opt … end', 'A frame with one section', 'A step that may not happen'],
  ['loop … end', 'A frame that repeats', 'Polling and retries'],
  ['par … and … end', 'A frame with parallel sections', 'Requests that don’t wait for each other'],
  ['break … end', 'A frame that leaves the interaction', 'A path that ends early, such as a rejected request'],
  ['autonumber', 'A number on every arrow', 'Referring to steps in a review'],
];
---
<DrawingArticle title={title} description={description} headings={headings} slug="sequences">
  <p>A sequence diagram shows the messages that pass between parts of a system during one interaction, in the order they happen. Each part gets a vertical line. Time runs down the page, and each arrow is one message.</p>
  <p>It answers questions an architecture diagram leaves open. Which message comes first? Who is waiting, and for how long? What happens when a reply never arrives?</p>
  <p>Every example here follows one invented repair service. Mina books a dishwasher repair in her browser. A Repair API stores the booking in a PostgreSQL database, Repair DB. A notification worker later emails her through an external email provider. The animations reuse these parts, and each section changes one thing.</p>

  <h2 id={h['lifelines-and-messages'].id}>{h['lifelines-and-messages'].text}</h2>
  <p>A <strong>lifeline</strong> is the dashed line running down from each participant’s box at the top of a sequence diagram. A <strong>message</strong> is an arrow from the sender’s lifeline to the receiver’s, labelled with what is asked or answered.</p>
  <p>Press play and watch the order in which the four messages arrive.</p>
  <SequencePlayer scenario="booking" n={1} />
  <p>The API can’t answer the browser until the database has answered the API. Reading down the page gives you that order without reading any code. Left to right carries no meaning. Put whoever starts the interaction on the left, so requests travel right and replies come back left.</p>
  <p>Label each arrow with the operation and the data that matters, such as <code>POST /repairs</code> or <code>201 Created: R17</code>. A label like “data” or “response” hides whether the database is being asked to read, write or confirm something.</p>
  <p>Mermaid is a text format for diagrams, and GitHub and GitLab render it inside Markdown. The same booking takes eight lines:</p>
  <Code code={booking} lang="mermaid" themes={themes} />
  <p><code>participant</code> declares the lifelines from left to right, and <code>as</code> gives each one a readable name. <code>{'->>'}</code> draws a solid arrow and <code>{'-->>'}</code> a dotted one.</p>

  <h2 id={h['replies-and-activation-bars'].id}>{h['replies-and-activation-bars'].text}</h2>
  <p>An <strong>activation bar</strong> is a narrow bar on a lifeline that shows when that participant is handling a call. <strong>Calls</strong> are the solid arrows in the booking: the sender asks, then waits for the answer. The dotted arrows are the <strong>replies</strong>. Between sending a call and getting its reply, the caller does nothing else for that request.</p>
  <p>The next animation adds activation bars to the booking. A solid bar shows a participant handling a call. A hatched bar shows it waiting for a reply, and it darkens the longer the wait goes on. The words under each name and the clock above say the same thing in text. Watch the browser’s bar while the database works. Then set the database to 3&nbsp;s and watch again.</p>
  <SequencePlayer scenario="waiting" n={2} />
  <p>The browser waits for the whole chain. With a 3-second database write it waits a little over 3 seconds, and the API waits almost as long inside it. The API’s wait is nested inside the browser’s, so each extra second in the database is an extra second for Mina.</p>
  <p>UML’s formal name for an activation bar is <em>execution specification</em>. Mermaid draws a bar only on the participant handling a call. The hatched waiting bars are this article’s addition.</p>
  <p>The diagram also didn’t get taller. Vertical distance shows order, not elapsed time, so a 5&nbsp;ms write and a 3-second write draw the same picture. When the question is how long something took, write the times in notes or draw a <a href="/learn/drawing-systems/#decision-tables-timelines-and-causal-loop-diagrams">timeline</a>.</p>
  <p>In Mermaid, a <code>+</code> after the arrow starts a bar on the receiver, and a <code>-</code> ends the sender’s bar:</p>
  <Code code={activations} lang="mermaid" themes={themes} />

  <h2 id={h['synchronous-and-asynchronous-messages'].id}>{h['synchronous-and-asynchronous-messages'].text}</h2>
  <p>A <strong>synchronous message</strong> is one whose sender waits for the reply. UML draws it with a filled arrowhead, and every call so far has been one. An <strong>asynchronous message</strong> is one the sender doesn’t wait for. It has an open arrowhead, and the sender carries straight on.</p>
  <p>Suppose the API also sends Mina’s confirmation email before it answers her. The email provider takes 2.5 seconds to reply, an invented figure. Watch the API wait for the provider first. Then switch the call to <em>Doesn’t wait</em> and see when the browser gets its <code>201 Created</code>.</p>
  <SequencePlayer scenario="email" n={3} />
  <p>When the API waits, Mina waits too, for more than 2.5 seconds. If the provider were down, her booking would hang or fail, even though the database had already stored it.</p>
  <p>When the API doesn’t wait, the browser gets its <code>201 Created</code> in about 70&nbsp;ms. The provider’s <code>202 Accepted</code> comes back 2.5 seconds later to an API that has moved on. Nothing is waiting for it. Had that reply been an error, nothing would have handled it, and the email would have been lost without anyone knowing.</p>
  <p>Mermaid writes an asynchronous message with <code>-)</code>:</p>
  <Code code={asyncSend} lang="mermaid" themes={themes} />
  <p>Neither version suits a booking. The first makes Mina wait for an email. The second ignores any error the provider sends back. The repair service moves the email out of the request instead.</p>

  <h2 id={h['transactional-outbox'].id}>{h['transactional-outbox'].text}</h2>
  <p>A <strong>transactional outbox</strong> is a table where a service writes the work it wants done, in the same database transaction as the change that caused it. A separate process picks the work up later. Here the work is notification job J9, and the separate process is the notification worker. The booking and the job are committed together, or neither is.</p>
  <p>The animation adds the worker and the provider as two more lifelines. Watch when the browser gets R17 compared with when the email goes out. Then turn on <em>Email provider is down</em>.</p>
  <SequencePlayer scenario="outbox" n={4} />
  <p>The browser has R17 after about 70&nbsp;ms. The worker claims J9 around 0.7 seconds later, on its next poll. With the provider down, the browser’s part of the diagram doesn’t change at all. The worker records that J9 should be tried again in 30 seconds, and the job waits in the database.</p>
  <p>The worker starts every exchange it takes part in. The database never calls the worker; the worker asks it for the next job. In PostgreSQL a worker usually claims a job with <code>SELECT … FOR UPDATE SKIP LOCKED</code>. <code>FOR UPDATE</code> locks the row, so two workers can’t claim the same job. <code>SKIP LOCKED</code> makes a worker pass over jobs another worker has locked instead of waiting for them. The <a href="https://www.postgresql.org/docs/current/sql-select.html#SQL-FOR-UPDATE-SHARE">PostgreSQL documentation</a> describes it as a way to “avoid lock contention with multiple consumers accessing a queue-like table”.</p>
  <p>This diagram has two starting points: the browser’s request and the worker’s poll. You can also draw it as two diagrams, split at the database. That works if the first diagram shows the job being written and the second starts by reading it.</p>
  <Code code={outbox} lang="mermaid" themes={themes} />
  <p>The outbox has a cost. A worker can send the email and then fail to record that it did, so the same job can be sent twice. Chris Richardson’s <a href="https://microservices.io/patterns/data/transactional-outbox.html">description of the pattern</a> says consumers must handle duplicates for this reason. The next two sections show how a duplicate happens and how to prevent it.</p>

  <h2 id={h['lost-messages-and-timeouts'].id}>{h['lost-messages-and-timeouts'].text}</h2>
  <p>A <strong>lost message</strong> is one that is sent but never received. UML draws it as an arrow that ends in a small filled circle instead of at a lifeline. A request can be lost on the way out, or its reply can be lost on the way back. A third case looks the same to the sender: the provider is slow, and its reply arrives after the sender has stopped listening.</p>
  <p>The worker can’t tell these cases apart. All it has is a <strong>timeout</strong>, a limit on how long it waits before giving up. Here the limit is 10 seconds. This animation keeps only the worker and the provider, and adds Mina’s inbox, which the worker can’t see. Try all three cases and watch the worker’s bar and status in each.</p>
  <SequencePlayer scenario="timeout" n={5} />
  <p>The worker’s bar and status are the same every time. It sends, waits 10 seconds and gives up. Mina’s inbox is not the same. When the request is lost, she gets nothing. When the reply is lost, or the provider is slow, she gets the email.</p>
  <p>A timeout records only that 10 seconds passed. It doesn’t say whether the email was sent. Draw it as a note on the caller’s lifeline, such as “Timeout after 10&nbsp;s”. Don’t draw a reply arrow labelled “failed”: nobody sent one.</p>
  <p>Set the timeout yourself. Node.js’s built-in <code>fetch</code> is <a href="https://nodejs.org/api/globals.html#fetch">based on undici</a>, whose <code>headersTimeout</code> and <code>bodyTimeout</code> <a href="https://github.com/nodejs/undici/blob/main/docs/docs/api/Client.md">both default to 300 seconds</a>. A worker that waits five minutes for each stuck email falls far behind. Pass <code>signal: AbortSignal.timeout(10_000)</code> to <code>fetch</code>, or give it an undici dispatcher with shorter timeouts.</p>
  <p>Mermaid has no lost-message arrow with a circle. Use the cross arrow, <code>-x</code>, and put the timeout in a note:</p>
  <Code code={lost} lang="mermaid" themes={themes} />

  <h2 id={h['retries-and-idempotency-keys'].id}>{h['retries-and-idempotency-keys'].text}</h2>
  <p>A <strong>retry</strong> sends the same request again, unchanged, after a failure or a timeout. For the worker it is the obvious next step. Whether it is safe depends on what happened the first time.</p>
  <p>Start with the reply lost and no key, and count the emails in Mina’s inbox. Switch the first attempt to <em>Request is lost</em>. Then turn on the idempotency key and try both again.</p>
  <SequencePlayer scenario="retry" n={6} />
  <p>When the request was lost, the retry is harmless and Mina gets one email. When the reply was lost, the provider had already sent the email, so the retry sends a second copy. The worker can’t tell these two cases apart, so every retry risks a duplicate unless the provider can recognise a repeat.</p>
  <p>An operation is <strong>idempotent</strong> if doing it twice has the same effect as doing it once. Sending an email isn’t. An <strong>idempotency key</strong> makes it so. The worker attaches a key that names the operation, here J9, and sends the same key on every attempt. The provider remembers keys it has seen, and a repeat gets the saved reply without a second email.</p>
  <p>Real APIs work this way. Resend, an email API, accepts an <code>Idempotency-Key</code> header and <a href="https://resend.com/docs/dashboard/emails/idempotency-keys">keeps keys for 24 hours</a>. Stripe <a href="https://docs.stripe.com/api/idempotent_requests">does the same for payments</a> and keeps keys for at least 24 hours. Both reject a repeated key sent with a different request body. Derive the key from the job, not from the attempt. A new random key on each retry tells the provider that each attempt is a new email.</p>
  <p>The key protects only while the provider remembers it. A retry 25 hours later, after Resend has forgotten the key, sends a second email.</p>
  <Code code={retry} lang="mermaid" themes={themes} />
  <p>Space retries out, too. If every worker retries the moment an outage ends, the retries can cause the next one. Amazon’s guidance on <a href="https://aws.amazon.com/builders-library/timeouts-retries-and-backoff-with-jitter/">timeouts, retries and backoff</a> is to wait longer after each failure and add a random amount, called jitter.</p>

  <h2 id={h['combined-fragments-alt-and-opt'].id}>{h['combined-fragments-alt-and-opt'].text}</h2>
  <p>A <strong>combined fragment</strong> is a frame drawn around part of a sequence diagram. The tag in its top-left corner is the operator, which says how the messages inside run. A condition in square brackets, the <strong>guard</strong>, says when they run.</p>
  <p>The two most common operators are <code>alt</code> and <code>opt</code>. An <code>alt</code> fragment holds alternatives, and at most one section runs: the one whose guard is true. With an <code>else</code> section, exactly one runs. An <code>opt</code> fragment holds one section, which runs only if its guard is true.</p>
  <p>In the next animation the API checks Mina’s details before it stores anything. Toggle the two conditions and watch which messages run.</p>
  <SequencePlayer scenario="fragments" n={7} />
  <p>Only one section of the <code>alt</code> runs for any one booking. The other stays on the page, faded here, because the diagram describes every path the interaction can take. The <code>opt</code> frame runs for a new customer and is skipped for a returning one.</p>
  <p>Write guards that the participant at that point can check. The API can check “details valid” when the request arrives. It can’t check “email will arrive”, because nothing in the interaction has told it that yet.</p>
  <Code code={altOpt} lang="mermaid" themes={themes} />
  <p>Write the guard after <code>alt</code>, <code>else</code> or <code>opt</code> without brackets. Mermaid adds the square brackets when it draws the frame.</p>

  <h2 id={h['loop-fragments'].id}>{h['loop-fragments'].text}</h2>
  <p>A <strong>loop</strong> fragment repeats the messages inside it while its guard holds. The diagram draws them once.</p>
  <p>After booking, Mina’s page asks for the repair’s status every 2 seconds until a technician is scheduled. Watch the pass counter in the frame’s corner. Then change the pass on which the status becomes “scheduled”.</p>
  <SequencePlayer scenario="loop" n={8} />
  <p>The same four arrows run on every pass, and each pass before the last adds about 2 seconds to the clock. The frame doesn’t say how often to ask, so the wait goes in a note inside the loop. Nothing in it sets a limit either. If the repair is never scheduled, the page asks forever, so real code needs a cap, such as 30 attempts.</p>
  <Code code={loop} lang="mermaid" themes={themes} />

  <h2 id={h['parallel-fragments'].id}>{h['parallel-fragments'].text}</h2>
  <p>A <strong>par</strong> fragment holds sections that run independently. Messages from different sections can interleave in any order. Within one section, the order still holds.</p>
  <p>Once Mina has R17, the page loads the repair’s status and the free appointment slots together. Watch both requests leave before either reply returns. Then change which reply comes back first.</p>
  <SequencePlayer scenario="par" n={9} />
  <p>Either order is allowed, and one diagram covers both. <code>par</code> doesn’t promise separate threads, or that the requests arrive at the same instant. It says only that neither section waits for the other. If the page needs both answers before it shows anything, say so after the frame. If one request needs data from the other’s reply, they aren’t parallel; draw them in order.</p>
  <Code code={par} lang="mermaid" themes={themes} />

  <h2 id={h['mermaid-syntax-reference'].id}>{h['mermaid-syntax-reference'].text}</h2>
  <p>Every example above is complete Mermaid, so you can paste it into any editor that renders Mermaid and change it. This table covers the syntax most sequence diagrams need.</p>
  <table>
    <thead><tr><th>Mermaid</th><th>Draws</th><th>Use it for</th></tr></thead>
    <tbody>{reference.map(([syntax, draws, use]) => <tr><td><code>{syntax}</code></td><td>{draws}</td><td>{use}</td></tr>)}</tbody>
  </table>
  <p>The <a href="https://mermaid.js.org/syntax/sequenceDiagram.html">Mermaid sequence diagram reference</a> lists every arrow and block, including <code>critical</code> and <code>rect</code>. To show how a repair request’s own status changes over time, draw a <a href="/learn/drawing-systems/states/">state diagram</a>.</p>
</DrawingArticle>
