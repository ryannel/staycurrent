---
// Third trial route (21 October 2026): articles regenerated with skills at 005ab6f,
// shown beside the live drafts at /review/relational-next/ for comparison.
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import RelationalNext from '../../../layouts/RelationalNext.astro';
import { relationalNextArticles } from '../../../lib/relational-next';

export function getStaticPaths() {
  const fragments = import.meta.glob<AstroComponentFactory>('../../../articles/relational-trial-3/*.astro', { eager: true, import: 'default' });
  const slugs: Record<string, string | undefined> = { a00: undefined, a03: 'transactions' };
  return Object.entries(slugs)
    .filter(([id]) => fragments[`../../../articles/relational-trial-3/${id}.astro`])
    .map(([id, slug]) => ({
      params: { article: slug },
      props: { article: relationalNextArticles.find(entry => entry.id === id)!, Content: fragments[`../../../articles/relational-trial-3/${id}.astro`] },
    }));
}

const { article, Content } = Astro.props;
---
<RelationalNext article={article}>
  <Content />
</RelationalNext>
