---
export function getStaticPaths() {
  if (process.env.STAYCURRENT_REFERENCE_PREVIEW !== '1' && process.env.RELATIONAL_DRAFT_PREVIEW !== '1') return [];
  const references = import.meta.glob('../../../reference-articles/*.astro', { eager: true, import: 'default' });
  return Object.entries(references).map(([file, Component]) => ({ params: { article: file.split('/').pop()!.replace('.astro', '') }, props: { Component } }));
}
const { Component } = Astro.props;
---
<Component />
