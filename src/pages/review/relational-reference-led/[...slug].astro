---
import SkillTrial from '../../../layouts/SkillTrial.astro';

export function getStaticPaths() {
  if (process.env.RELATIONAL_DRAFT_PREVIEW !== '1') return [];
  const fragments = import.meta.glob('../../../articles/relational-reference-led/*.astro', {
    eager: true,
    import: 'default',
  });
  const Component = fragments['../../../articles/relational-reference-led/opening.astro'];
  return Component ? [{ params: { slug: undefined }, props: { Component } }] : [];
}
const { Component } = Astro.props;
---
<SkillTrial title="Relational databases" description="A fresh opening written with the fixed references leading the prose and figures.">
  <Component />
</SkillTrial>
