---
import Base from '../../../../layouts/Base.astro';
import StorageDefs from '../../../../components/explainers/storage/StorageDefs.astro';
import '../../../../styles/explorables.css';
import '../../../../styles/relational-design.css';
import '../../../../styles/relational-drafts.css';

export function getStaticPaths() {
  if (process.env.RELATIONAL_DRAFT_PREVIEW !== '1') return [];
  const sources = import.meta.glob('../../../../articles/relational/*.md', { eager: true, query: '?raw', import: 'default' });
  const paths: any[] = [];
  for (const [file, source] of Object.entries(sources)) {
    const article = file.match(/\/(rl\d+)\.md$/)![1];
    let index = 0;
    for (const match of String(source).matchAll(/<div\s+([^>]*data-relational-component="[^"]+"[^>]*)>\s*<\/div>/g)) {
      const attributes = Object.fromEntries([...match[1].matchAll(/data-([\w-]+)="([^"]*)"/g)].map(a => [a[1], a[2].replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')]));
      const name = attributes['relational-component'];
      delete attributes['relational-component'];
      const props = Object.fromEntries(Object.entries(attributes).map(([key, value]) => [key.replace(/-([a-z])/g, (_, c) => c.toUpperCase()), value === 'true' ? true : value === 'false' ? false : key === 'number' ? Number(value) : value]));
      paths.push({ params: { tool: `${article}-${++index}` }, props: { name, componentProps: props } });
    }
  }
  return paths;
}

const { name, componentProps } = Astro.props;
const components = import.meta.glob('../../../../components/explainers/{indexes,storage,relational-design-tools,relational-operation-tools,relational-product-tools}/*.astro', { eager: true, import: 'default' });
const Component = components[`../../../../components/explainers/${name}.astro`];
if (!Component) throw new Error(`Unknown review model: ${name}`);
---
<Base title="Model review">
  <article class="visual-essay relational-design relational-draft storage-essay model-review">
    <h1>Model review</h1>
    {name.startsWith('storage/') && <StorageDefs />}
    <Component {...componentProps} />
  </article>
</Base>
<style>
  .model-review { max-width: var(--essay-width, 52rem); margin: 2rem auto; padding: 0 1.25rem; }
  h1 { font: 500 1.2rem/1.4 var(--font-sans); margin-bottom: 1.5rem; }
</style>
