---
import Base from '../../../layouts/Base.astro';
import RelationalDraft from '../../../layouts/RelationalDraft.astro';
import TitleLine from '../../../components/editorial/TitleLine.astro';
import registry from '../../../../docs/article-work/relational-rewrite-2026-10-19/registry.json';

export function getStaticPaths() {
  if (process.env.RELATIONAL_DRAFT_PREVIEW !== '1') return [];
  const drafts = import.meta.glob('../../../drafts/relational/*.md', { eager: true });
  return [
    { params: { article: undefined }, props: { page: null } },
    ...Object.values(drafts).map((page: any) => ({
      params: { article: page.frontmatter.id.toLowerCase() }, props: { page },
    })),
  ];
}
const { page } = Astro.props;
const Content = page?.Content;
const drafts = import.meta.glob('../../../drafts/relational/*.md', { eager: true });
const present = new Set(Object.values(drafts).map((p: any) => p.frontmatter.id));
const groups = [...new Set(registry.map(p => p.group))];
const journeys = [
 {name: 'Build a new application', ids: ['RL76','RL77','RL78','RL79','RL81','RL84','RL85','RL90','RL93','RL104'], branches: [{name:'PostgreSQL',ids:['RL110']},{name:'CockroachDB',ids:['RL123','RL124']}]},
 {name: 'Explain a wrong result', ids: ['RL81','RL78','RL82','RL83'], branches: []},
 {name: 'Repair a slow endpoint', ids: ['RL87','RL86','RL102'], branches: [{name:'PostgreSQL',ids:['RL113']},{name:'CockroachDB',ids:['RL126']}]},
 {name: 'Protect concurrent work', ids: ['RL79','RL90','RL91','RL93','RL94'], branches: [{name:'Distributed transactions and CockroachDB',ids:['RL106','RL124']}]},
 {name: 'Recover accepted work', ids: ['RL95','RL96'], branches: [{name:'PostgreSQL',ids:['RL115','RL116']},{name:'CockroachDB',ids:['RL129']}]},
 {name: 'Keep a service available', ids: ['RL97','RL98'], branches: [{name:'PostgreSQL physical replicas',ids:['RL117']},{name:'CockroachDB cluster operation',ids:['RL128']}]},
 {name: 'Change an application schema', ids: ['RL100'], branches: [{name:'PostgreSQL',ids:['RL119']},{name:'CockroachDB',ids:['RL130']}]},
 {name: 'Upgrade an installed version', ids: [], branches: [{name:'PostgreSQL',ids:['RL122']},{name:'CockroachDB',ids:['RL131']}]},
 {name: 'Move the application to another installation', ids: [], branches: [{name:'PostgreSQL native routes',ids:['RL122']},{name:'Moving to CockroachDB',ids:['RL132']}]},
 {name: 'Decide whether to distribute', ids: ['RL105','RL106','RL107','RL108','RL109'], branches: [{name:'CockroachDB implementation',ids:['RL123','RL124','RL125','RL127','RL128']}]},
 {name: 'Investigate an incident', ids: ['RL103'], branches: [{name:'PostgreSQL',ids:['RL120']},{name:'CockroachDB',ids:['RL128']}]},
];
---
{page ? <RelationalDraft frontmatter={page.frontmatter}><Content /></RelationalDraft> :
 <Base title="Relational collection: draft review" description="The revised relational collection, in a separate review build.">
  <article class="visual-essay relational-review-directory">
   <header class="essay-header"><p class="eyebrow">Draft review · Relational databases</p><h1>Relational collection: draft review</h1><TitleLine type="Introduction" /></header>
   <p>This build contains replacement drafts for the revised relational collection. The published collection remains separate. Start with the introduction, follow a reader question, or choose a native implementation branch.</p>
   <p>Each article identifies its practical setting. A model exposes its stated rules; a native worksheet records what ran on an actual server. Draft review status belongs to the accompanying work record.</p>
   <h2>Choose a reading path</h2>
   <p>These are starting points for a task. Take the implementation branch you use; the whole shelf is not a prerequisite. The SQL examples share familiar identifiers, but use independent fixtures: start each article in its own <a href="/review/relational/evidence/relational-fixtures.md">disposable database</a> unless it explicitly continues an earlier setup.</p>
   {journeys.map(journey => <section><h3>{journey.name}</h3>{journey.ids.length > 0 && <ol>{journey.ids.map(id => registry.find(p => p.id === id)).filter(p => p && present.has(p.id)).map(p => <li><a href={p!.preview}>{p!.title}</a></li>)}</ol>}{journey.branches.length > 0 && <p>Choose the implementation you use:</p>}{journey.branches.map(branch => <div><p><strong>{branch.name}</strong></p><ul>{branch.ids.map(id => registry.find(p => p.id === id)).filter(p => p && present.has(p.id)).map(p => <li><a href={p!.preview}>{p!.title}</a></li>)}</ul></div>)}</section>)}
   <h2>Browse the collection</h2>
   {groups.map(group => <section><h3>{group}</h3><ul>{registry.filter(p => p.group === group && present.has(p.id)).map(p => <li><a href={p.preview}>{p.title}</a></li>)}</ul></section>)}
   <h2>Sources and further reading</h2>
   <p><a href="/learn/databases/relational/">The published relational collection</a> remains available while this replacement is reviewed.</p>
  </article>
 </Base>}
