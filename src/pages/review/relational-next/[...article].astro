---
import RelationalNext from '../../../layouts/RelationalNext.astro';
import { relationalNextArticles, relationalNextContent } from '../../../lib/relational-next';

export function getStaticPaths() {
  return relationalNextArticles.map(article => ({
    params: { article: article.slug || undefined },
    props: { article },
  }));
}

const { article } = Astro.props;
const Content = relationalNextContent(article.id);
---
<RelationalNext article={article}>
  {Content && <Content />}
</RelationalNext>
