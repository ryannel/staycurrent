---
import MissFigure from '../../../components/application-caching/cache-misses/MissFigure.astro';
import ThemeSwitcher from '../../../components/editorial/ThemeSwitcher.astro';
import themeScript from '../../../scripts/theme.js?raw';
import '../../../styles/global.css';
import '../../../styles/explorables.css';
import '../../../styles/application-caching.css';

export function getStaticPaths() {
  return process.env.STAYCURRENT_FIGURE_PREVIEW === '1'
    ? [{ params: { article: 'cache-misses' } }]
    : [];
}

// Match the published article's order; use its actual components and captions.
const figures = ['stampede', 'sharedLoad', 'lease', 'refresh', 'recovery'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Handling cache misses — Figures-only preview</title>
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <header class="site-header"><div class="inner"><span>Figures-only preview</span><ThemeSwitcher /></div></header>
    <main id="main" data-pagefind-ignore="all">
      <article class="visual-essay cache-article">
        <header class="essay-header"><h1>Handling cache misses</h1></header>
        {figures.map((kind, index) => <MissFigure kind={kind} number={index + 1} figuresOnly />)}
      </article>
    </main>
  </body>
</html>
