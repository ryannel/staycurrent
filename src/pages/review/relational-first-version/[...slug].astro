---
import SkillTrial from '../../../layouts/SkillTrial.astro';
import RelationalReadingMap from '../../../components/editorial/RelationalReadingMap.astro';
import { relationalHome } from '../../../lib/reading';

export function getStaticPaths() {
  if (process.env.RELATIONAL_FIRST_VERSION_PREVIEW !== '1') return [];
  const fragments = import.meta.glob('../../../articles/relational-first-version/*.astro', {
    eager: true,
    import: 'default',
  });
  const Component = fragments['../../../articles/relational-first-version/introduction.astro'];
  return Component ? [
    { params: { slug: undefined }, props: { Component, isolated: false } },
    { params: { slug: 'figures' }, props: { Component, isolated: true } },
  ] : [];
}
const { Component, isolated } = Astro.props;
---
<SkillTrial title={isolated ? 'Relational databases — figures' : 'Relational databases'} description="A fresh introduction to relational databases." readingPath={isolated ? undefined : relationalHome}>
  {isolated ? <div class="isolated-figures"><Component /></div> : <Component />}
  <Fragment slot="collection">{!isolated && <RelationalReadingMap path={relationalHome} showReadingPaths={false} />}</Fragment>
</SkillTrial>

<style is:global>
  .isolated-figures :is(p, h2, h3, h4, nav, aside):not(figure *) { display: none; }
  .isolated-figures .essay-sources { display: none; }
</style>
