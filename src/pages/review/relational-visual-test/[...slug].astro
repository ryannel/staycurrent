---
import SkillTrial from '../../../layouts/SkillTrial.astro';

export function getStaticPaths() {
  if (process.env.RELATIONAL_DRAFT_PREVIEW !== '1') return [];
  const fragments = import.meta.glob('../../../articles/relational-visual-test/*.astro', {
    eager: true,
    import: 'default',
  });
  const Component = fragments['../../../articles/relational-visual-test/opening.astro'];
  return Component ? [{ params: { slug: undefined }, props: { Component } }] : [];
}
const { Component } = Astro.props;
---
<SkillTrial title="Relational databases" description="A fresh opening about tables and following an order to its customer.">
  <Component />
</SkillTrial>
