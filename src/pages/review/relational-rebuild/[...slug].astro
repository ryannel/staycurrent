---
import RelationalRebuild from '../../../layouts/RelationalRebuild.astro';
import { relationalRebuildCollection, relationalRebuildFileKey, relationalRebuildHrefFor, relationalRebuildStates } from '../../../lib/relational-rebuild';

export function getStaticPaths() {
  if (process.env.RELATIONAL_REBUILD_PREVIEW !== '1') return [];
  const fragments = import.meta.glob('../../../articles/relational-rebuild/*.astro', { eager: true, import: 'default' });
  const metaFiles = import.meta.glob('../../../articles/relational-rebuild/*.meta.json', { eager: true, import: 'default' });
  const components = Object.fromEntries(Object.entries(fragments).flatMap(([path, component]) => {
    const key = relationalRebuildFileKey(path);
    return key ? [[key, component]] : [];
  }));
  const metadata = Object.fromEntries(Object.entries(metaFiles).flatMap(([path, meta]) => {
    const key = relationalRebuildFileKey(path);
    return key ? [[key, meta]] : [];
  }));
  const entries = relationalRebuildStates(Object.keys(components), metadata);
  const paths = entries.filter(entry => entry.available).map(entry => ({
    params: { slug: entry.slug || undefined },
    props: { Component: components[entry.key], entry, entries, collection: relationalRebuildCollection, landing: false },
  }));
  const root = entries.find(entry => entry.parent === null)!;
  if (!root.available) paths.unshift({ params: { slug: undefined }, props: {
    Component: undefined, entry: root, entries, collection: relationalRebuildCollection, landing: true,
  } });
  return paths;
}
const { Component, entry, entries, collection, landing } = Astro.props;
const hrefFor = (key: string) => relationalRebuildHrefFor(key, entries);
---
<RelationalRebuild entry={entry} entries={entries} collection={collection} landing={landing}>
  {Component && <Component entry={entry} entries={entries} collection={collection} hrefFor={hrefFor} />}
</RelationalRebuild>
