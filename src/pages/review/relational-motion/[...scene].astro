---
import Base from '../../../layouts/Base.astro';
import MotionFigure from '../../../components/relational-motion/MotionFigure.astro';
import '../../../styles/explorables.css';
export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const modules = import.meta.glob('../../../components/relational-motion/{foundations,postgresql,distributed}/*.mjs', {eager:true});
  return Object.entries(modules).flatMap(([file, module]) => {
    const collection = file.split('/relational-motion/')[1].replace('.mjs','');
    return Object.entries((module as any).scenes ?? {}).map(([kind,scene]) => ({params:{scene:`${collection}/${kind}`},props:{collection,kind,scene}}));
  });
}
const {collection,kind,scene} = Astro.props;
const variants = scene.choices
  ? scene.choices.reduce((values,choice)=>values.flatMap(parts=>choice.options.map(option=>[...parts,option.value])),[[]]).map(parts=>parts.join(':'))
  : scene.actions?.map(action=>action.value) ?? [scene.defaultVariant ?? 'story'];
---
<Base title={`Motion study · ${scene.title}`} readingPath="/">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <article class="visual-essay" data-pagefind-ignore="all">
    <h1>Motion study</h1>
    <MotionFigure collection={collection} kind={kind} />
    <details class="storyboards"><summary>Review still frames</summary>
      {variants.map(variant=><section><h2>{variant}</h2>{[0,.25,.5,.75,1].map(t=><figure class="relational-motion"><figcaption>{Math.round(t*100)}%</figcaption><div set:html={scene.render(t,variant)} /></figure>)}</section>)}
    </details>
  </article>
</Base>
