---
// Pilot rewrites of published caching articles, written with the November 2026 skills.
// Preview only: APPLICATION_CACHING_DRAFT_PREVIEW=1 pnpm build (or dev), then
// /review/application-caching/pilot/<article>/. Normal builds produce no pages here,
// and the live article sources in src/articles/application-caching/ are untouched.
import ApplicationCaching from '../../../../layouts/ApplicationCaching.astro';
import { applicationCachingEntries, applicationCachingFileKey, applicationCachingHref } from '../../../../lib/application-caching';

export function getStaticPaths() {
  if (process.env.APPLICATION_CACHING_DRAFT_PREVIEW !== '1') return [];
  const pilots = import.meta.glob('../../../../articles/application-caching-pilot/*.astro', { eager: true, import: 'default' });
  const live = import.meta.glob('../../../../articles/application-caching/*.astro', { eager: true, import: 'default' });
  const metaFiles = import.meta.glob('../../../../articles/application-caching/*.meta.json', { eager: true, import: 'default' });
  const metadata = Object.fromEntries(Object.entries(metaFiles).map(([file, meta]) => [applicationCachingFileKey(file), meta]));
  const entries = applicationCachingEntries(Object.keys(live).map(applicationCachingFileKey), metadata);
  return Object.entries(pilots).map(([file, Component]) => {
    const key = applicationCachingFileKey(file);
    const entry = entries.find(item => item.key === key);
    if (!entry) throw new Error(`Pilot ${key} has no published caching article to stand beside`);
    return { params: { slug: key }, props: { Component, entry, entries } };
  });
}

const { Component, entry, entries } = Astro.props;
---
<ApplicationCaching entry={entry} entries={entries}>
  <Component entry={entry} entries={entries} hrefFor={applicationCachingHref} />
</ApplicationCaching>
