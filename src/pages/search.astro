---
import Base from '../layouts/Base.astro';
import SearchPanel from '../components/editorial/SearchPanel.astro';
---
<Base title="Search" description="Find an explanation, guide or playground in the Stay Current library.">
  <div class="search-page">
    <header class="search-page-heading">
      <p class="search-eyebrow">The Stay Current library</p>
      <h1>What would you like to understand?</h1>
      <p>Find an explanation. Explore a technology. Try an idea for yourself.</p>
    </header>
    <SearchPanel />
    <p class="search-page-note">Search the full text, or use quotes to find a phrase.</p>
  </div>
</Base>
<style>
  :global(main:has(.search-page)) { max-width: 54rem; padding-top: clamp(2rem, 6vh, 5rem); min-height: calc(100dvh - 160px); }
  .search-page-heading { margin-bottom: 30px; }
  .search-eyebrow { color: var(--color-accent); font: 550 .72rem/1.5 var(--font-sans); letter-spacing: .04em; margin: 0 0 12px; }
  .search-page-heading h1 { font: 550 clamp(1.8rem, 4vw, 2.6rem)/1.15 var(--font-sans); letter-spacing: -.045em; margin: 0 0 14px; max-width: 39rem; }
  .search-page-heading > p:last-child { font: .9rem/1.6 var(--font-sans); color: var(--color-text-secondary); margin: 0; }
  .search-page-note { text-align: center; color: var(--color-text-secondary); font: .72rem/1.5 var(--font-sans); margin: 20px 0 0; }
  @media (max-width: 600px) {
    :global(main:has(.search-page)) { padding: 30px 12px 40px; }
    .search-page-heading { padding: 0 4px; margin-bottom: 24px; }
    .search-page-heading h1 { max-width: 20rem; }
  }
</style>
