---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Provenance from '../../../components/Provenance.astro';
import { getTopics, getTopic, getVersions, getVersion, formatDate, isoDate, slugOf } from '../../../lib/content';

export async function getStaticPaths() {
  const topics = await getTopics();
  const paths = [];
  for (const t of topics) {
    const slug = slugOf(t.id);
    for (const v of await getVersions(slug)) paths.push({ params: { slug, n: String(v.version) } });
  }
  return paths;
}

const { slug, n } = Astro.params;
const version = Number(n);
const topic = await getTopic(slug);
const current = topic.data.version;
const snapshot = await getVersion(slug, version);
if (!snapshot) throw new Error(`no snapshot at topics/${slug}/versions/v${n}/article.md`);
const { Content } = await render(snapshot);
const isCurrent = version === current;
const currentCut = (await getVersions(slug)).find((v) => v.version === current)?.cut;
const articleHref = `/${slug}/`;
---
<Base title={`${topic.data.title} v${version}`} canonical={isCurrent ? new URL(articleHref, Astro.site).href : undefined}>
  {isCurrent ? (
    <Fragment slot="head"><meta http-equiv="refresh" content={`0; url=${articleHref}`} /></Fragment>
  ) : null}
  {isCurrent ? (
    <p>v{version} is the current version. <a href={articleHref}>Read current →</a></p>
  ) : (
    <>
      <p class="archived-banner">
        You're reading <strong>v{version}</strong>, cut <time datetime={isoDate(snapshot.data.cut)}>{formatDate(snapshot.data.cut)}</time>.
        The current version is <strong>v{current}</strong>{currentCut && <>, updated <time datetime={isoDate(currentCut)}>{formatDate(currentCut)}</time></>}.
        {' '}<a href={articleHref}>Read current →</a>
      </p>
      <article>
        <Content />
      </article>
      <Provenance slug={slug} version={version} />
    </>
  )}
</Base>
