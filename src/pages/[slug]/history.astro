---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getTopics, getTopic, getVersions, getChangelog, getResearchLog, formatDate, isoDate, slugOf } from '../../lib/content';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map((t) => ({ params: { slug: slugOf(t.id) } }));
}

const { slug } = Astro.params;
const topic = await getTopic(slug);
const versions = await getVersions(slug);
const changelog = await getChangelog(slug);
const stanceOf = (n: number) => changelog.find((e) => e.version === n)?.stance ?? null;
const log = await getResearchLog(slug);
const rendered = log ? await render(log) : null;
const current = topic.data.version;
---
<Base title={`${topic.data.title} — History`} description={`Every version of ${topic.data.title}, with its cut date and stance.`}>
  <p class="meta"><a href={`/${slug}/`}>← {topic.data.title}</a></p>
  <h1>{topic.data.title} — History</h1>
  <table>
    <thead>
      <tr><th scope="col">Version</th><th scope="col">Cut</th><th scope="col">Stance</th><th scope="col"></th></tr>
    </thead>
    <tbody>
      {versions.map((v) => (
        <tr>
          <td>
            <a class:list={['badge', { archived: v.version !== current }]} href={`/${slug}/v/${v.version}/`}>v{v.version}</a>
            {' '}{v.version === current ? 'current' : 'archived'}
          </td>
          <td><time datetime={isoDate(v.cut)}>{formatDate(v.cut)}</time></td>
          <td>{stanceOf(v.version) ?? '—'}</td>
          <td><a href={`/${slug}/changelog/#v${v.version}`}>changelog</a></td>
        </tr>
      ))}
    </tbody>
  </table>
  {rendered && (
    <section aria-labelledby="research-log">
      <p class="section-label" id="research-log">Research log</p>
      <p>Every run is recorded here, including the ones that changed nothing.</p>
      <div class="provenance research-log"><rendered.Content /></div>
    </section>
  )}
</Base>
