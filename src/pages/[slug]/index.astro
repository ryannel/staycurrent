---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import Provenance from '../../components/Provenance.astro';
import { getTopics, getTopic, slugOf } from '../../lib/content';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map((t) => ({ params: { slug: slugOf(t.id) } }));
}

const { slug } = Astro.params;
const topic = await getTopic(slug);
const { Content } = await render(topic);
const { title, stance, version, last_researched, prereqs, area, register } = topic.data;
const topics = await getTopics();
const prereqTopics = (prereqs ?? []).map((p) => topics.find((t) => slugOf(t.id) === p)).filter(Boolean);
const hub = area && register !== 'hub' ? topics.find((t) => t.data.area === area && t.data.register === 'hub') : undefined;
---
<Base title={title} description={stance}>
  <TrustHeader slug={slug} version={version} lastResearched={last_researched} />
  {(hub || prereqTopics.length > 0) && (
    <p class="reading-rail">
      {hub && <>Part of <a href={`/${slugOf(hub.id)}/`}>{hub.data.title}</a>. </>}
      {prereqTopics.length > 0 && (
        <>Read first: {prereqTopics.map((p, i) => <><a href={`/${slugOf(p!.id)}/`}>{p!.data.title}</a>{i < prereqTopics.length - 1 ? ', ' : ''}</>)}.</>
      )}
    </p>
  )}
  <article>
    <Content />
  </article>
  <Provenance slug={slug} version={version} />
</Base>
