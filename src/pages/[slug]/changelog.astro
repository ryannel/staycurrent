---
import Base from '../../layouts/Base.astro';
import { getTopics, getTopic, getChangelog, formatDate, isoDate, slugOf } from '../../lib/content';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map((t) => ({ params: { slug: slugOf(t.id) } }));
}

const { slug } = Astro.params;
const topic = await getTopic(slug);
const entries = await getChangelog(slug);
---
<Base title={`${topic.data.title} — Changelog`} description={`What changed in ${topic.data.title}, version by version.`}>
  <p class="meta"><a href={`/${slug}/`}>← {topic.data.title}</a></p>
  <h1>{topic.data.title} — Changelog</h1>
  <p>Each entry stands alone: what moved in the field, and what it means for practice. A reader current on the previous version can stop here.</p>
  {entries.map((e) => (
    <section class="entry" id={`v${e.version}`}>
      <h2><a href={`#v${e.version}`}>v{e.version}</a> <small class="meta" style="display:inline"><time datetime={isoDate(e.date)}>{formatDate(e.date)}</time></small></h2>
      <Fragment set:html={e.html} />
      <p class="meta"><a href={`/${slug}/v/${e.version}/`}>Read v{e.version} as cut</a></p>
    </section>
  ))}
</Base>
